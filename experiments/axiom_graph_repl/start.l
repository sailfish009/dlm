;;; Atomic axioms → MLIR-shaped axiom dependency graph → subset selection.
(define p1 (s-template-synthesize *train-facts* *train-pos* *neg* 20000))
(define t1 (p-close *train-facts* (s-rec-rules p1) 20000))
(define self (l-filter (lambda (f) (equal (l-pred (l-fact-atom f)) 'isa)) t1))
(define p2 (s-template-synthesize *train-facts* (l-append *train-pos* (l-map l-fact-atom self)) *neg* 20000))
(define axs (a-from-program "A" p2 (list "web:selfsup") (s-rec-support p2)))
(define g (ag-from-axioms axs))
(define ags (ag-select g *train-facts* *train-pos* *neg* 20000))
(define asel (a-select axs *train-facts* *train-pos* *neg* 20000))
(define qs (list (l-atom 'isa (list 'dog 'living-thing))
                 (l-atom 'isa (list 'sparrow 'living-thing))
                 (l-atom 'isa (list 'plant 'living-thing))))
(define rules (ag-rules-for (l-nth ags 1) g))
(define held (let ((n 0)) (list-do q qs (if (equal (l-nth (p-prove *web-edges* rules q 20000) 1) 'proof) (set n (+ n 1)))) n))
(print "AG nodes=" (l-len (ag-nodes g)) " check=" (ag-check g) " deps=" (ag-check-deps g) "\n")
(print "AG SEL " (l-nth ags 1) " COV " (l-nth ags 2) "\n")
(print "A SEL " (l-nth asel 1) " SAME " (if (equal (l-nth ags 1) (l-nth asel 1)) "yes" "no") "\n")
(print "HELD " held "/3\n")
(print "done-axiom-graph\n")

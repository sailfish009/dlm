;;; Explicit finite goals plus explicit source fixtures, one native learning loop.
(dlm 'demo)
(dlm 'search 'nd-ucb)
(dlm 'goal '(contract87 setx88 (x y) (bool 1) () (var x) (x)))
(dlm 'goal '(contract87 sety88 (x y) (bool 1) () (var y) (y)))
(dlm 'goal '(contract87 both88 (x y) (bool 1) () (and (var x) (var y)) (x y)))
(dlm 'curriculum 'mixed)
(dlm 'relation-budget 4)
(times-do 12 (d77-tick))
(assert (= (dlm-length (a77-defs *dlm-model*)) 3) "three native relation definitions")
(assert (= (dlm-length (dlm-nth *c87-library* 1)) 3) "three checked procedures")
(assert (equal (dlm-nth (dlm-nth (c87-module *c87-library* 'both88) 1) 4)
               '((call setx88) (call sety88))) "recursive verified reuse")
(assert (= (dlm-nth (contracts 'check-library) 1) 'verified) "library recheck")
(assert (d77-snapshot? (d77-pack *dlm-model* *dlm-round* *dlm-events*)) "joint replay validation")
(dump (dlm 'curriculum)) (print "\n")

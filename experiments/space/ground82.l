;;; Native prototype: observation provenance, certified support, layout ablation.
(define g (g82-new '((p 0))))
(set g (g82-evidence g 'e "sensor/example" 'explicit-observation "caller-digest" "example-time"))
(set g (g82-observe g 'a '(pred p ()) 'e))
(define proof (dlm-nth (sq-search '(problem classical-prop-v1 ((p 0))
  (sequent classical-prop-v1 ((pred p ())) ((pred p ())))) 100 'fixed) 2))
(set g (g82-derive g 'b '(pred p ()) '(a) proof))
(set g (g82-place g 'a '(0 0 0)))
(set g (g82-place g 'b '(20 0 0)))
(dump (list 'before (g82-query g '(pred p ()) '(0 0 0) 2 false)
  'layout-cost (g82-cost g 'b '(20 0 0)))) (print "\n")
(define original g)
(set g (g82-relax g 'b 20))
(assert (equal (dlm-nth original 3) (dlm-nth g 3)) "semantic graph invariant")
(dump (list 'after (g82-query g '(pred p ()) '(0 0 0) 2 false)
  'position (s79-at (dlm-nth g 4) 'b)
  'layout-cost (g82-cost g 'b (s79-at (dlm-nth g 4) 'b)))) (print "\n")
(dump (list 'complete-before (g82-query original '(pred p ()) '(0 0 0) 2 true)
  'complete-after (g82-query g '(pred p ()) '(0 0 0) 2 true))) (print "\n")
(set g (g82-retract g 'e))
(dump (list 'after-retraction (g82-active? g 'a) (g82-active? g 'b))) (print "\n")

;;; Explicit finite Boolean specification; no hidden input axioms or SMT.
(define setflag87 '(contract87 setflag (flag ready) (bool 1) () (var flag) (flag)))
(dump (contracts 'learn setflag87)) (print "\n")
(define reuse87 '(contract87 reusable (flag ready) (bool 1) () (var flag) (flag)))
(dump (contracts 'learn reuse87)) (print "\n")
(dump (contracts 'learn '(contract87 setready (flag ready) (bool 1) () (var ready) (ready)))) (print "\n")
(dump (contracts 'learn '(contract87 both (flag ready) (bool 1) () (and (var flag) (var ready)) (flag ready)))) (print "\n")
(define bad87 '(contract87 missing_else (flag ready) (bool 1)
 ((if (var ready) ((assign flag (bool 1))) ())) (var flag) (flag)))
(dump (contracts 'verify bad87)) (print "\n")
(define toggle87 '(contract87 toggle (flag ready) (bool 1)
 ((if (var flag) ((assign flag (bool 0))) ((assign flag (bool 1)))))
 (and (eq (var flag) (not (old flag))) (eq (var ready) (old ready))) (flag)))
(define result87 (contracts 'verify toggle87))
(dump (list 'toggle-status (car result87))) (print "\n")
(dump (list 'library-size (dlm-length (dlm-nth (contracts 'library) 1)))) (print "\n")

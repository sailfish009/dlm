;;; -*- mode: lisp; coding: us-ascii -*-
;;; Fixed operating-rule probe. No labels, neural oracle, or performance gate.
(define probe-source '(problem classical-prop-v1 ((p 0) (q 0))
  (sequent classical-prop-v1 ((pred p ())) ((and (pred p ()) (pred p ()))))))
(define probe (e79-transition (s79-new) (list 'study 'source probe-source)))
(set probe (s79-proof-job probe 'subscriber probe-source))
(define probe-prefix (s79-run probe 6))
(dump (list 'shared-root (= (dlm-nth (s79-job probe-prefix 'source) 4)
                           (dlm-nth (s79-job probe-prefix 'subscriber) 4))
            'partial-ticks (dlm-nth probe-prefix 10))) (print "\n")
(set probe (s79-run probe-prefix 1000))
(dump (list 'learned 'patterns (dlm-length (dlm-nth probe 8)) 'definitions (dlm-nth probe 12))) (print "\n")
(set probe (s79-proof-job probe 'transfer
 '(problem classical-prop-v1 ((r 0) (s 0))
   (sequent classical-prop-v1 ((pred r ()))
     ((and (and (pred r ()) (pred r ())) (imp (pred s ()) (pred s ()))))))))
(set probe (s79-run probe 1000))
(dump (list 'transfer 'status (dlm-nth (s79-job probe 'transfer) 3) 'reuse-hits (dlm-nth (dlm-nth probe 11) 3))) (print "\n")
(set probe (s79-run (d79-use probe 'named-module "motif79-0" '((pred p ()))) 1000))
(dump (list 'named-definition-used (dlm-nth (s79-job probe 'named-module) 5))) (print "\n")
(set probe (s79-run (i79-interpolate probe 'interface '((p 0) (q 0))
 '(and (pred p ()) (pred q ())) '(pred q ())) 2000))
(dump (list 'proof-interface (dlm-nth (s79-job probe 'interface) 5))) (print "\n")
(set probe (s79-run (i79-beth probe 'explicit '((p 0) (q 0))
 '(and (imp (pred p ()) (pred q ())) (imp (pred q ()) (pred p ()))) '(pred p ())) 4000))
(dump (list 'beth-status (dlm-nth (dlm-nth (s79-job probe 'explicit) 5) 1))) (print "\n")
(set probe (s79-run (d79-use probe 'beth-module 'explicit '((pred q ()))) 2000))
(dump (list 'beth-definition-used (dlm-nth (dlm-nth (s79-job probe 'beth-module) 5) 1))) (print "\n")
(dump (list 'final 'ticks (dlm-nth probe 10) 'units (dlm-nth probe 9)
  'stats-created-shared-expanded-reused-checked-notified (dlm-nth probe 11))) (print "\n")

;;; Synthesize a recursive program from one long positive and base edges only.
(define facts (list
  (l-fact "t0" (l-atom 'parent (list "a" "b")))
  (l-fact "t1" (l-atom 'parent (list "b" "c")))
  (l-fact "t2" (l-atom 'parent (list "c" "d")))
  (l-fact "t3" (l-atom 'parent (list "d" "e")))))
(define pos (list (l-atom 'ancestor (list "a" "e"))))
(define neg (list (l-atom 'ancestor (list "e" "a"))))
(define prog (s-template-synthesize facts pos neg 20000))
(print "PROGRAM " (if (s-rec-program? prog) "template" prog) " rules=" (if (s-rec-program? prog) (l-len (s-rec-rules prog)) 0) " support=" (if (s-rec-program? prog) (s-rec-support prog) ()) "\n")
(print "COVERAGE " (s-coverage facts (s-rec-rules prog) pos 20000) "/1\n")
(print "NEGATIVE " (if (s-conflict? facts (s-rec-rules prog) neg 20000) "conflict" "clean") "\n")
(define held (list (l-fact "h0" (l-atom 'parent (list "f" "g")))
                   (l-fact "h1" (l-atom 'parent (list "g" "h")))
                   (l-fact "h2" (l-atom 'parent (list "h" "i")))
                   (l-fact "h3" (l-atom 'parent (list "i" "j")))))
(print "HELD " (if (l-lookup (l-atom 'ancestor (list "f" "j")) (p-close held (s-rec-rules prog) 20000)) "proof" "fail") "\n")
(define seed-only (list (s-rule (car (s-seed-base-candidates facts (car pos))))))
(print "SEED ONLY HELD " (if (l-lookup (l-atom 'ancestor (list "f" "j")) (p-close held seed-only 20000)) "proof" "fail") "\n")
(print "FROZEN " (if (l-lookup (l-atom 'ancestor (list "f" "j")) (p-close held () 20000)) "proof" "fail") "\n")
(print "done-template\n")

;;; Goal-directed proof vs full closure on independent chains.
(define-function gp-chain (prefix n)
  (if (= n 0) ()
    (l-append (gp-chain prefix (- n 1))
      (list (l-fact (concat-strings prefix (number->string n))
              (l-atom 'parent (list (concat-strings prefix (number->string (- n 1)))
                                    (concat-strings prefix (number->string n)))))))))
(define-function gp-facts (n)
  (if (= n 0) ()
    (l-append (gp-facts (- n 1))
      (gp-chain (concat-strings "c" (number->string n) "-") 5))))
(define rules (list
  (l-rule (l-atom 'ancestor (list (l-var 'x) (l-var 'z)))
          (list (l-atom 'parent (list (l-var 'x) (l-var 'z)))))
  (l-rule (l-atom 'ancestor (list (l-var 'x) (l-var 'z)))
          (list (l-atom 'parent (list (l-var 'x) (l-var 'y)))
                (l-atom 'ancestor (list (l-var 'y) (l-var 'z)))))))
(define goal (l-atom 'ancestor (list "c1-0" "c1-4")))
(define f1 (gp-facts 1))
(define f5 (gp-facts 5))
(define f20 (gp-facts 20))
(define c1 (l-close f1 rules 20000))
(p-clear-proof-cache)
(define p1 (p-prove f1 rules goal 20000))
(define c5 (l-close f5 rules 20000))
(p-clear-proof-cache)
(define p5 (p-prove f5 rules goal 20000))
(define c20 (l-close f20 rules 20000))
(p-clear-proof-cache)
(define p20 (p-prove f20 rules goal 20000))
(print "N=1 closure=" (l-nth c1 2) " prove=" (l-nth p1 3) " scans=" (l-nth p1 4) " status=" (l-nth p1 1) "\n")
(print "N=5 closure=" (l-nth c5 2) " prove=" (l-nth p5 3) " scans=" (l-nth p5 4) " status=" (l-nth p5 1) "\n")
(print "N=20 closure=" (l-nth c20 2) " prove=" (l-nth p20 3) " scans=" (l-nth p20 4) " status=" (l-nth p20 1) "\n")
(print "CHECK1 " (if (p-proof-check f1 rules goal (l-nth p1 2)) "ok" "fail") "\n")
(print "CHECK20 " (if (p-proof-check f20 rules goal (l-nth p20 2)) "ok" "fail") "\n")
(print "done-goal-proof\n")

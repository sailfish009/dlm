;;; proof-DAG credit / frontier curriculum in the Maru REPL.
(define x (list 'var 'x)) (define y (list 'var 'y)) (define z (list 'var 'z))
(define seed (l-rule (l-atom 'ancestor (list x z)) (list (l-atom 'parent (list x z)))))
(define rec (l-rule (l-atom 'ancestor (list x z))
  (list (l-atom 'parent (list x y)) (l-atom 'ancestor (list y z)))))
(define pc (l-rule (l-atom 'path (list x z))
  (list (l-atom 'hop1 (list x y)) (l-atom 'hop2 (list y z)))))
(define p-rec (list seed rec))
(define p-comp (list pc))
(define f1 (list (l-fact "t0" (l-atom 'parent (list "a" "b")))
                 (l-fact "t1" (l-atom 'parent (list "b" "c")))))
(define f2 (list (l-fact "u0" (l-atom 'hop1 (list "r" "s")))
                 (l-fact "u1" (l-atom 'hop2 (list "s" "t")))))
(define f3 (list (l-fact "v0" (l-atom 'parent (list "d" "e")))
                 (l-fact "v1" (l-atom 'parent (list "e" "f")))))
(define g1 (l-atom 'ancestor (list "a" "c")))
(define g2 (l-atom 'path (list "r" "t")))
(define g3 (l-atom 'ancestor (list "d" "f")))
(define active (list p-rec))
(define-function rules-of (programs)
  (let ((out ())) (list-do p programs (set out (l-append out p))) out))
(print "ROUND 1 active=1\n")
(define pr1 (p-proof f1 (rules-of active) g1 20000))
(print "PROOF1 nodes=" (if pr1 1 0) " essential=" (p-essential-rules f1 (rules-of active) g1 20000) "\n")
(print "FRONTIER2 " (p-frontier f2 (rules-of active) g2 20000) "\n")
(set active (l-append active (list p-comp)))
(print "ROUND 2 active=2\n")
(define pr2 (p-proof f2 (rules-of active) g2 20000))
(print "PROOF2 nodes=" (if pr2 1 0) " essential=" (p-essential-rules f2 (rules-of active) g2 20000) "\n")
(define pr3 (p-proof f3 (rules-of active) g3 20000))
(print "PROOF3 nodes=" (if pr3 1 0) " essential=" (p-essential-rules f3 (rules-of active) g3 20000) "\n")
(print "FRONTIER_FROZEN " (p-frontier f2 () g2 20000) "\n")
(print "done-proof\n")

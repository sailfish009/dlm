(define *proof-input* (read *standard-input*))
(assert (= (read *standard-input*) +end+) "trailing proof request data")
(assert (and (sq-shape? *proof-input* 6) (= (car *proof-input*) 'proof-request-v1)
             (string? (dlm-nth *proof-input* 4))) "invalid proof request")
(if (dlm-nth *proof-input* 1) (assert (sq-store? (dlm-nth *proof-input* 1)) "old proof store invalid"))
(define *proof-result* (sq-search (dlm-nth *proof-input* 2) (dlm-nth *proof-input* 3) 'fixed))
(define *proof-store* (list 'proof-store-v1 'g3c76-v1 (dlm-nth *proof-input* 2)
  (list 'search 'fixed (dlm-nth *proof-input* 3)) *proof-result* (dlm-nth *proof-input* 4) (dlm-nth *proof-input* 5)))
(assert (sq-store? *proof-store*) "proof request rejected")
(dump *proof-store*)
(print "\n")

;;; lab.l — web-schema-derived synthetic deduction dataset + learner evaluation.
(define-function wtext-id (x) (l-nth x 1))
(define-function wtext-text (x) (l-nth x 3))
(define-function parse-all (xs out)
  (if (not xs) out
      (let ((r (nl-parse (wtext-text (car xs)))))
        (parse-all (cdr xs)
          (if (or (equal (nl-kind r) 'nl-fact) (equal (nl-kind r) 'nl-rule))
              (l-append out (list r)) out)))))
(define *web-records* (parse-all *web-text* ()))
(define *web-kb* (nl-build *web-records*))
(define *web-facts* (car *web-kb*))
(define *web-rules* (car (cdr *web-kb*)))

;; Synthetic dataset: same web-derived schema (binary isa), new entities.
(define-function fact (id a b) (l-fact id (l-atom 'isa (list a b))))
(define train-facts
  (list (fact "t1" 's0 's1) (fact "t2" 's1 's2) (fact "t3" 's2 's3)
        (fact "t4" 's0 's4) (fact "t5" 's4 's3)))
(define test-facts
  (list (fact "u1" 'x0 'x1) (fact "u2" 'x1 'x2) (fact "u3" 'x2 'x3)
        (fact "u4" 'x0 'x4) (fact "u5" 'x4 'x5) (fact "u6" 'x5 'x3)))
(define train-pos (list (l-atom 'isa (list 's0 's3))))
(define test-pos (list (l-atom 'isa (list 'x0 'x3)) (l-atom 'isa (list 'x0 'x5))))
(define neg (list (l-atom 'isa (list 'x3 'x0))))
(define-function p3 (facts rules q)
  (let ((pr (p-prove facts rules q 20000)))
    (if (and (equal (l-nth pr 1) 'proof)
             (p-proof-check facts rules q (l-nth pr 2))) 1 0)))
(define-function c3 (facts rules qs n ok)
  (if qs (c3 facts rules (cdr qs) (+ n 1) (+ ok (p3 facts rules (car qs)))) (list n ok)))
(define before (c3 test-facts () test-pos 0 0))
(define cand (s-trans-synthesize train-facts (car train-pos) () neg 20000))
(define learned (if (equal cand '(none)) () (list (s-rule cand))))
(define after (c3 test-facts learned test-pos 0 0))
(define negok (p3 test-facts learned (car neg)))
;; Content scramble: rename relation in synthetic facts; same structure.
(define-function scr-fact (f)
  (let ((a (l-fact-atom f))) (l-fact (l-fact-id f) (l-atom 'scr (l-args a)))))
(define-function scr-goal (g) (l-atom 'scr (l-args g)))
(define-function scr-rule (r)
  (l-rule (l-atom 'scr (l-args (l-head r)))
          (l-map (lambda (a) (l-atom 'scr (l-args a))) (l-body r))))
(define scr (c3 (l-map scr-fact test-facts) (l-map scr-rule learned) test-pos 0 0))
(print "WEB TEXT " (l-len *web-text*) " RECORDS " (l-len *web-records*) " WEB-FACTS " (l-len *web-facts*) " WEB-RULES " (l-len *web-rules*) "\n")
(print "SCHEMA isa/2 SYNTH-TRAIN " (l-len train-facts) " SYNTH-TEST " (l-len test-facts) "\n")
(print "BASELINE " (car (cdr before)) "/" (car before) " LEARNED " (l-len learned) "\n")
(print "AFTER " (car (cdr after)) "/" (car after) " NEG " negok " (want 0) SCRAMBLE " (car (cdr scr)) "/" (car scr) "\n")
(print "done-web-synthetic-deductive\n")

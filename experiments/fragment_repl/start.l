;;; Fragment decomposition + assembly + fixed-data matching in the Maru REPL.
(define x (list 'var 'x)) (define y (list 'var 'y)) (define z (list 'var 'z))
(define head (l-atom 'R (list x z)))
(define f1 (f-fragment "seed" head (list (l-atom 'P (list x z)))))
(define f2 (f-fragment "left" head (list (l-atom 'P (list x y)))))
(define f3 (f-fragment "right" head (list (l-atom 'R (list y z)))))
(define f4 (f-fragment "q" head (list (l-atom 'Q (list y z)))))
(define f5 (f-fragment "reverse" head (list (l-atom 'P (list z x)))))
(define frags (list f1 f2 f3 f4 f5))
(define t-seed (a-template "seed" head (f-body f1)))
(define t-rec (a-combine "rec" f2 f3))
(define t-comp (a-combine "comp" f2 f4))
(define t-rev (a-template "rev" head (f-body f5)))
(define templates (list t-seed t-rec t-comp t-rev))
(define programs (list
  (a-program-from-templates "p-seed" (list t-seed))
  (a-program-from-templates "p-rec" (list t-seed t-rec))
  (a-program-from-templates "p-comp" (list t-comp))
  (a-program-from-templates "p-rev" (list t-rev))))
(print "FRAGMENTS " (l-len frags) " TEMPLATES " (l-len templates) " PROGRAMS " (l-len programs) "\n")
(list-do t templates
  (print "TEMPLATE " (a-template-id t) " head=" (l-pred (a-template-head t))
         " body=" (l-len (a-template-body t)) "\n"))
(define t1 (m-task "ancestor"
  (list (l-atom 'parent (list "a" "b")) (l-atom 'parent (list "b" "c")))
  (list (l-atom 'ancestor (list "a" "c"))) (list (l-atom 'ancestor (list "c" "a")))
  (list (list 'R 'ancestor) (list 'P 'parent))))
(define t2 (m-task "reaches"
  (list (l-atom 'manages (list "j" "k")) (l-atom 'manages (list "k" "l")))
  (list (l-atom 'reaches (list "j" "l"))) (list (l-atom 'reaches (list "l" "j")))
  (list (list 'R 'reaches) (list 'P 'manages))))
(define t3 (m-task "path"
  (list (l-atom 'hop1 (list "r" "s")) (l-atom 'hop2 (list "s" "t")))
  (list (l-atom 'path (list "r" "t"))) (list (l-atom 'path (list "t" "r")))
  (list (list 'R 'path) (list 'P 'hop1) (list 'Q 'hop2))))
(define t4 (m-task "inside"
  (list (l-atom 'contains (list "u" "v")) (l-atom 'contains (list "v" "w")))
  (list (l-atom 'inside (list "u" "w"))) (list (l-atom 'inside (list "w" "u")))
  (list (list 'R 'inside) (list 'P 'contains))))
(define summary (m-run (list t1 t2 t3 t4) programs))
(dump summary) (print "\n")
(list-do t (list t1 t2 t3 t4)
  (let ((e (m-eval t ())))
    (print "FROZEN " (m-name t) " covered=" (l-nth e 0) "/" (l-nth e 1) " conflict=" (l-nth e 2) "\n")))
(define all-ids (l-map a-program-id programs))
(list-do t (list t1 t2 t3 t4)
  (let ((e (m-eval t (m-active-rules t programs all-ids))))
    (print "ALL " (m-name t) " covered=" (l-nth e 0) "/" (l-nth e 1)
           " conflict=" (l-nth e 2) "\n")))
(print "done-fragment\n")

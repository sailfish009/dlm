;;; Web fixture with a universal rule → basis → English query answer.
(define recs (w-to-records *web-observations*))
(define kb (nl-build recs))
(define facts (car kb))
(define basis (nl-basis recs))
(define rules (b-active-rules basis))
(define q1 (nl-answer-with facts rules "Is a dog a living thing?"))
(define q2 (nl-answer-with facts rules "Is a living thing a dog?"))
(print "OBS " (l-len *web-observations*) "\n")
(print "BASIS " (l-len rules) " rules\n")
(print "Q1 " (l-nth q1 1) " " (l-nth q1 3) "\n")
(print "Q2 " (l-nth q2 1) " " (l-nth q2 3) "\n")
(print "SOURCE " (w-url (car *web-observations*)) "\n")
(print "done-web-rule\n")

;;; Data → learned rule programs → accumulated basis axioms → proof.
(define e1 (list (l-fact "e0" (l-atom 'edge (list "a" "b")))
                 (l-fact "e1" (l-atom 'edge (list "b" "c")))
                 (l-fact "e2" (l-atom 'edge (list "c" "d")))))
(define rpos (list (l-atom 'reach (list "a" "d"))))
(define rp (s-template-synthesize e1 rpos () 20000))
(define hf (list (l-fact "h0" (l-atom 'hop1 (list "r" "s")))
                 (l-fact "h1" (l-atom 'hop2 (list "s" "t")))))
(define hpos (list (l-atom 'path (list "r" "t"))))
(define hneg (list (l-atom 'path (list "t" "r"))))
(define hp (s-pair-synthesize hf hpos hneg 20000))
(define b0 (b-add () "A" (s-rec-rules rp) (list "source-1") (s-rec-support rp)))
(define b1 (b-add b0 "B" (s-rec-rules hp) (list "source-2") (s-rec-support hp)))
(define b2 (b-activate b1 "A"))
(define b3 (b-activate b2 "B"))
(define tf (l-append e1 hf))
(define g1 (l-atom 'reach (list "a" "d")))
(define g2 (l-atom 'path (list "r" "t")))
(print "A status=" (b-status (b-find "A" b3)) " rules=" (b-active-rules b3) "\n")
(print "A proof=" (l-nth (p-prove tf (b-active-rules b3) g1 20000) 1) "\n")
(print "B proof=" (l-nth (p-prove tf (b-active-rules b3) g2 20000) 1) "\n")
(define b4 (b-deactivate b3 "B"))
(print "B OFF path=" (l-nth (p-prove tf (b-active-rules b4) g2 20000) 1) " reach=" (l-nth (p-prove tf (b-active-rules b4) g1 20000) 1) "\n")
(define b5 (b-rollback b4 "B"))
(print "B ROLLBACK status=" (b-status (b-find "B" b5)) " path=" (l-nth (p-prove tf (b-active-rules b5) g2 20000) 1) "\n")
(print "done-basis\n")

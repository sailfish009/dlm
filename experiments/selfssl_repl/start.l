;;; Three-round recursive self-supervision on actual web subclass facts.
(define facts *train-facts*)
(define pos *train-pos*)
(define neg *neg*)
(define basis ())
(define i 0)
(while (< i 3)
  (set i (+ i 1))
  (define r (ssl-round facts pos neg basis i))
  (set basis (car r))
  (set pos (l-nth r 1))
  (print "ROUND " i " pos=" (l-len pos) " new=" (l-len (l-nth r 2)) " rules=" (l-nth r 3) "\n"))
(define rules (b-active-rules basis))
(define qs (list (l-atom 'isa (list 'dog 'living-thing))
                 (l-atom 'isa (list 'sparrow 'living-thing))
                 (l-atom 'isa (list 'plant 'living-thing))))
(define held (let ((n 0)) (list-do q qs (if (equal (l-nth (p-prove *web-edges* rules q 20000) 1) 'proof) (set n (+ n 1)))) n))
(define negp (l-nth (p-prove *web-edges* rules (l-atom 'isa (list 'living-thing 'dog)) 20000) 1))
(print "FINAL pos=" (l-len pos) " rules=" (l-len rules) " HELD " held "/3 NEG " negp "\n")
(print "done-selfssl\n")

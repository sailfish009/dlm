;;; Actual web edges → self-supervised path labels → recursive rule → held-out proof.
(define p1 (s-template-synthesize *train-facts* *train-pos* *neg* 20000))
(define b1 (b-activate (b-add () "R1" (s-rec-rules p1) (list "web:selfsup") (s-rec-support p1)) "R1"))
(define r1 (b-active-rules b1))
(define t1 (p-close *train-facts* r1 20000))
(define self (l-filter (lambda (f) (equal (l-pred (l-fact-atom f)) 'isa)) t1))
(define selfpos (l-map l-fact-atom self))
(define p2 (s-template-synthesize *train-facts* (l-append *train-pos* selfpos) *neg* 20000))
(define b2 (b-activate (b-add () "R2" (s-rec-rules p2) (list "web:selfsup") (s-rec-support p2)) "R2"))
(define r2 (b-active-rules b2))
(define qs (list (l-atom 'isa (list 'dog 'living-thing))
                 (l-atom 'isa (list 'sparrow 'living-thing))
                 (l-atom 'isa (list 'plant 'living-thing))))
(define held (let ((n 0)) (list-do q qs (if (equal (l-nth (p-prove *web-edges* r2 q 20000) 1) 'proof) (set n (+ n 1)))) n))
(define neg (l-nth (p-prove *web-edges* r2 (l-atom 'isa (list 'living-thing 'dog)) 20000) 1))
(print "WEB pages=7 edges=" (l-len *web-edges*) " train=" (l-len *train-facts*) "\n")
(print "POS " (l-len *train-pos*) " SELF " (l-len selfpos) "\n")
(print "RULES1 " (l-len r1) " RULES2 " (l-len r2) "\n")
(print "HELD " held "/3 NEG " neg "\n")
(print "SOURCES " (l-nth *web-sources* 0) "\n")
(print "done-web-recursive\n")

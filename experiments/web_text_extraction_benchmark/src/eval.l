;;; eval.l — evaluator-only gold, metrics, and Maru proof gate.
(define-function key-of (x) (list (l-nth x 1) (l-nth x 2) (l-nth x 3)))
(define-function gold-has? (e g)
  (if (not g) ()
      (if (equal (list (l-nth e 1) (l-nth e 2) (l-nth e 3))
                 (list (l-nth (car g) 1) (l-nth (car g) 2) (l-nth (car g) 3)))
          (not ()) (gold-has? e (cdr g)))))
(define-function count-tp (es g n)
  (if (not es) n (count-tp (cdr es) g (+ n (if (gold-has? (car es) g) 1 0)))))
(define-function count-fp (es g n)
  (if (not es) n (count-fp (cdr es) g (+ n (if (gold-has? (car es) g) 0 1)))))
(define-function count-fn (g es n)
  (if (not g) n (count-fn (cdr g) es (+ n (if (gold-has? (car g) es) 0 1)))))
(define tp (count-tp *extracted* *gold* 0))
(define fp (count-fp *extracted* *gold* 0))
(define fn (count-fn *gold* *extracted* 0))
(define *records* (l-map (lambda (e) (list (l-nth e 1) (l-nth e 2) (l-nth e 3) "")) *extracted*))
(define *kb* (nl-build *records*))
(define *facts* (car *kb*))
(define *rules* (car (cdr *kb*)))
(define q (l-atom 'isa (list 'handwritten-digit 'image)))
(define pr (p-prove *facts* *rules* q 20000))
(define ok (if (and (equal (l-nth pr 1) 'proof) (p-proof-check *facts* *rules* q (l-nth pr 2))) 'proof 'fail))
(print "TEXT " (l-len *web-text*) " EXTRACTED " (l-len *extracted*) "\n")
(print "TP " tp " FP " fp " FN " fn "\n")
(print "PRECISION " tp "/" (+ tp fp) " RECALL " tp "/" (+ tp fn) "\n")
(print "GATE FACTS " (l-len *facts*) " RULES " (l-len *rules*) " PROOF " ok "\n")
(print "GOLD-FIELDS-IN-INPUT false\n")
(print "done-web-text-extraction\n")

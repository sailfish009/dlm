;;; Dependency-aware proof cache: reuse, unrelated additions, used-fact removal.
(define-function gc-chain (prefix n)
  (if (= n 0) ()
    (l-append (gc-chain prefix (- n 1))
      (list (l-fact (concat-strings prefix (number->string n))
              (l-atom 'parent (list (concat-strings prefix (number->string (- n 1)))
                                    (concat-strings prefix (number->string n)))))))))
(define-function gc-facts (n)
  (if (= n 0) ()
    (l-append (gc-facts (- n 1))
      (gc-chain (concat-strings "c" (number->string n) "-") 5))))
(define rules (list
  (l-rule (l-atom 'ancestor (list (l-var 'x) (l-var 'z)))
          (list (l-atom 'parent (list (l-var 'x) (l-var 'z)))))
  (l-rule (l-atom 'ancestor (list (l-var 'x) (l-var 'z)))
          (list (l-atom 'parent (list (l-var 'x) (l-var 'y)))
                (l-atom 'ancestor (list (l-var 'y) (l-var 'z)))))))
(define goal (l-atom 'ancestor (list "c1-0" "c1-4")))
(define f20 (gc-facts 20))
(p-clear-proof-cache)
(define p1 (p-prove f20 rules goal 20000))
(define p2 (p-prove f20 rules goal 20000))
(define extra (l-fact "extra" (l-atom 'parent (list "q" "r"))))
(define p3 (p-prove (l-append f20 (list extra)) rules goal 20000))
(define missing (l-filter (lambda (f) (not (equal "c1-2" (l-fact-id f)))) f20))
(define p4 (p-prove missing rules goal 20000))
(print "FIRST status=" (l-nth p1 1) " probes=" (l-nth p1 3) "\n")
(print "CACHED status=" (l-nth p2 1) " probes=" (l-nth p2 3) " scans=" (l-nth p2 4) "\n")
(print "UNRELATED status=" (l-nth p3 1) " probes=" (l-nth p3 3) "\n")
(print "REMOVED status=" (l-nth p4 1) "\n")
(print "CHECK " (if (p-proof-check f20 rules goal (l-nth p2 2)) "ok" "fail") "\n")
(print "done-proof-cache\n")

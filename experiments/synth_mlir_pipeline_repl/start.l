;;; MLIR-shaped pipeline: automatic search selection + proof gate.
(define ufacts (list
  (l-fact "u0" (l-atom 'parent (list "a" "b")))
  (l-fact "u1" (l-atom 'parent (list "b" "c")))
  (l-fact "u2" (l-atom 'parent (list "c" "d")))
  (l-fact "u3" (l-atom 'parent (list "d" "e")))
  (l-fact "u4" (l-atom 'parent (list "e" "f")))
  (l-fact "u5" (l-atom 'parent (list "f" "g")))))
(define upos (list (l-atom 'ancestor (list "a" "g"))))
(define uneg (list (l-atom 'ancestor (list "a" "c"))
                   (l-atom 'ancestor (list "a" "e"))
                   (l-atom 'ancestor (list "a" "f"))))
(define uheld (list (l-fact "h0" (l-atom 'parent (list "h" "i")))
                    (l-fact "h1" (l-atom 'parent (list "i" "j")))
                    (l-fact "h2" (l-atom 'parent (list "j" "k")))
                    (l-fact "h3" (l-atom 'parent (list "k" "l")))
                    (l-fact "h4" (l-atom 'parent (list "l" "m")))
                    (l-fact "h5" (l-atom 'parent (list "m" "n")))))
(define umod (ml-module "stride-pipeline"
  (list
    (ml-op 'synth-search (list "s3" 'stride ufacts upos uneg 4 20000))
    (ml-op 'synth-proof (list "hp" "s3" uheld (l-atom 'ancestor (list "h" "n")) 20000))
    (ml-op 'synth-proof (list "hn" "s3" uheld (l-atom 'ancestor (list "h" "l")) 20000)))))
(define ur (ml-run umod))
(define us (ml-synth-result "s3"))
(define udirect (s-stride-synthesize ufacts upos uneg 4 20000))
(print "MLIR search stride program=" (if us "yes" "no") " rules=" (if us (l-len (s-rec-rules (l-nth us 1))) 0) " coverage=" (if us (l-nth us 2) 0) "/1 conflict=" (if us (l-nth us 3) 'none) "\n")
(print "SAME stride " (if (and us (equal (s-rec-rules (l-nth us 1)) (s-rec-rules udirect))) "yes" "no") "\n")
(print "PROOF stride pos=" (l-nth (ml-proof-result "hp") 1) " neg=" (l-nth (ml-proof-result "hn") 1) "\n")
(print "MLIR result synth=" (l-nth ur 14) " proof=" (l-nth ur 16) "\n")

(define vfacts (list
  (l-fact "v0" (l-atom 'up (list "a" "b")))
  (l-fact "v1" (l-atom 'down (list "b" "c")))
  (l-fact "v2" (l-atom 'up (list "c" "d")))
  (l-fact "v3" (l-atom 'down (list "d" "e")))
  (l-fact "v4" (l-atom 'up (list "e" "f")))
  (l-fact "v5" (l-atom 'down (list "f" "g")))))
(define vpos (list (l-atom 'reach (list "a" "g"))))
(define vneg (list (l-atom 'reach (list "a" "d"))
                   (l-atom 'reach (list "a" "f"))))
(define vheld (list (l-fact "w0" (l-atom 'up (list "h" "i")))
                    (l-fact "w1" (l-atom 'down (list "i" "j")))
                    (l-fact "w2" (l-atom 'up (list "j" "k")))
                    (l-fact "w3" (l-atom 'down (list "k" "l")))
                    (l-fact "w4" (l-atom 'up (list "l" "m")))
                    (l-fact "w5" (l-atom 'down (list "m" "n")))))
(define vmod (ml-module "pair-pipeline"
  (list
    (ml-op 'synth-search (list "pp" 'pair vfacts vpos vneg 4 20000))
    (ml-op 'synth-proof (list "vp" "pp" vheld (l-atom 'reach (list "h" "n")) 20000))
    (ml-op 'synth-proof (list "vn" "pp" vheld (l-atom 'reach (list "h" "k")) 20000)))))
(define vr (ml-run vmod))
(define vs (ml-synth-result "pp"))
(define vdirect (s-pair-synthesize vfacts vpos vneg 20000))
(print "MLIR search pair program=" (if vs "yes" "no") " rules=" (if vs (l-len (s-rec-rules (l-nth vs 1))) 0) " coverage=" (if vs (l-nth vs 2) 0) "/1 conflict=" (if vs (l-nth vs 3) 'none) "\n")
(print "SAME pair " (if (and vs (equal (s-rec-rules (l-nth vs 1)) (s-rec-rules vdirect))) "yes" "no") "\n")
(print "PROOF pair pos=" (l-nth (ml-proof-result "vp") 1) " neg=" (l-nth (ml-proof-result "vn") 1) "\n")
(print "MLIR result synth=" (l-nth vr 14) " proof=" (l-nth vr 16) "\n")
(print "done-mlir-pipeline\n")

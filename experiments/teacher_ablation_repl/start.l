;;; Teacher-behavior ablation: learned vs frozen vs reversed rule.
(define facts (list
  (l-fact "s0" (l-atom 'subclass (list 'cat 'mammal)))
  (l-fact "s1" (l-atom 'subclass (list 'mammal 'animal)))
  (l-fact "s2" (l-atom 'subclass (list 'animal 'living-thing)))
  (l-fact "s3" (l-atom 'subclass (list 'dog 'mammal)))
  (l-fact "s4" (l-atom 'subclass (list 'sparrow 'bird)))
  (l-fact "s5" (l-atom 'subclass (list 'bird 'animal)))))
(define pos (list (l-atom 'isa (list 'cat 'living-thing))))
(define neg (list (l-atom 'isa (list 'living-thing 'cat))))
(define prog (s-template-synthesize facts pos neg 20000))
(define learned (b-active-rules (b-activate (b-add () "L" (s-rec-rules prog) (list "teacher") (s-rec-support prog)) "L")))
(define x (l-var 'x)) (define z (l-var 'z))
(define wrong (list (l-rule (l-atom 'isa (list x z)) (list (l-atom 'subclass (list z x))))))
(define qs (list
  (list "sparrow-living" (l-atom 'isa (list 'sparrow 'living-thing)))
  (list "dog-living" (l-atom 'isa (list 'dog 'living-thing)))
  (list "cat-animal" (l-atom 'isa (list 'cat 'animal)))
  (list "reverse" (l-atom 'isa (list 'living-thing 'cat)))))
(define-function arm-count (arm rules)
  (let ((n 0))
    (list-do q qs
      (if (equal (l-nth (p-prove facts rules (l-nth q 1) 20000) 1) 'proof)
        (set n (+ n 1))))
    n))
(print "LEARNED " (arm-count 'learned learned) "/4\n")
(print "FROZEN " (arm-count 'frozen ()) "/4\n")
(print "WRONG " (arm-count 'wrong wrong) "/4\n")
(print "done-ablation\n")

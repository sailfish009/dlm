(require "experiments/composition95/driver.l")
(set i95-emit (lambda (x) ()))
(define input95-file (file-open-read "experiments/composition95/input-example.sexp"))
(define example95 (read (file-stream input95-file)))
(file-close input95-file)
(i95-prepare example95)
(define-function report95 (x) (dump x) (print "\n"))
(define context95 (dlm-nth (car (dlm-nth example95 7)) 2))
(define c-channel95 (dlm-nth (dlm-nth example95 5) 1))
(define d-channel95 (dlm-nth (dlm-nth example95 6) 1))
(define historical95 (basis91 'model))
(define snapshot95 (basis91 'snapshot))
(report95 (list 'same-library95 (basis91 'typed-profile) 'standalone-eml-owner *e93-state*))
(report95 (list 'learned-output-port95 (dlm-nth (b91-module (dlm-nth historical95 3) 6) 4)))
(set *c95-stats* '(metrics95 0 0 0 0))
(define answer95 (basis91 'typed-query d-channel95 context95 200000))
(assert (= (dlm-nth answer95 1) 'complete))
(report95 (list 'application95 (dlm-nth answer95 1) (dlm-length (dlm-nth answer95 3)) *c95-stats*
  (dlm-nth (dlm-nth (car (dlm-nth answer95 3)) 3) 4)))
(define missing95 (s79-field context95 4 ()))
(report95 (list 'missing95 (basis91 'typed-query c-channel95 missing95 200000)))
(report95 (list 'budget95 (basis91 'typed-query d-channel95 context95 0)))
(define worker95 c95-worker)
(set c95-worker (lambda (model m context raw fuel) (list 'work95 'complete () fuel)))
(define omitted95 (basis91 'typed-query c-channel95 context95 200000))
(assert (= (car omitted95) 'rejected95))
(report95 (list 'omitted-worker95 omitted95))
(set c95-worker worker95)
(define before-d95 (b91-replay '(r s) (s79-reverse (cdr (s79-reverse (dlm-nth snapshot95 4))))))
(define d-proposal95 (dlm-nth (b91-last (dlm-nth snapshot95 4)) 1))
(define claim95 (dlm-nth d-proposal95 3))
(define bad95 (s79-field d-proposal95 3 (s79-field claim95 6 (cons '(z93 0 0) (cdr (dlm-nth claim95 6))))))
(assert (not (c95-check-proposal before-d95 bad95)))
(report95 (list 'forged-formation95 'rejected (equal snapshot95 (basis91 'snapshot))))
(define channel95 (car (dlm-nth (dlm-nth *b91-state* 8) 3)))
(define targets95 (dlm-nth channel95 6))
(assert (= (car (basis91 'observe-values c-channel95 (dlm-nth channel95 3) (dlm-nth channel95 5)
  (cons (s79-field (car targets95) 3 '(z93 99000000 0)) (cdr targets95)))) 'committed91))
(report95 (list 'counterexample95
  (basis91 'typed-query c-channel95 context95 200000)
  (basis91 'typed-query d-channel95 context95 200000)
  'definitions (dlm-length (dlm-nth *b91-state* 4))
  'historical-status (dlm-nth (basis91 'typed-infer historical95 d-channel95 context95 200000) 1)))
(assert (= (car (basis91 'observe-values c-channel95 (dlm-nth channel95 3) (dlm-nth channel95 5) targets95)) 'committed91))
(report95 (list 'restored95 (dlm-nth (basis91 'typed-query d-channel95 context95 200000) 1)
  'same-definition-count (= (dlm-nth historical95 5) (dlm-nth (basis91 'model) 5))
  'changed-core (not (equal historical95 (basis91 'model)))))
(assert (= (car (basis91 'retract-values 'calibration95 "nalpha")) 'committed91))
(report95 (list 'definition-vs-application95
  'c-status (dlm-nth (basis91 'typed-query c-channel95 context95 200000) 1)
  'd-status (dlm-nth (basis91 'typed-query d-channel95 context95 200000) 1)))
(report95 (list 'replay95 (b91-snapshot? (basis91 'snapshot))))

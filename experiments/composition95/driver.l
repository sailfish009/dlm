;;; Data-only CPU experiment orchestration; all learning uses Basis91's owner.
(define-function i95-emit (x) (dump x) (print "\n"))
(define-function i95-frame? (f sig)
  (and (sq-shape? f 6) (= (car f) 'frame95) (b91-name? (dlm-nth f 1)) (b91-name? (dlm-nth f 2))
    (b91-facts? (dlm-nth f 3) sig) (c95-measures? (dlm-nth f 4)) (c95-targets? (dlm-nth f 5))))
(define-function i95-input? (x)
  (and (sq-shape? x 12) (= (car x) 'composition-input95) (= (dlm-nth x 1) 1)
    (b90-names? (dlm-nth x 2) 4) (dlm-nth x 2) (b91-facts? (dlm-nth x 3) (dlm-nth x 2))
    (dlm-proper? (dlm-nth x 4) 4)
    (let ((ok true) (seen ())) (list-do c (dlm-nth x 4)
      (if (and (sq-shape? c 4) (= (car c) 'calibration-input95) (b91-name? (dlm-nth c 1))
          (e93-arity? (dlm-nth c 2)) (e93-rows? (dlm-nth c 3) (dlm-nth c 2))
          (not (dlm-member? (dlm-nth c 1) seen))) (set seen (cons (dlm-nth c 1) seen)) (set ok false))) ok)
    (i95-frame? (dlm-nth x 5) (dlm-nth x 2)) (i95-frame? (dlm-nth x 6) (dlm-nth x 2))
    (not (equal (dlm-nth (dlm-nth x 5) 1) (dlm-nth (dlm-nth x 6) 1)))
    (not (equal (dlm-nth (dlm-nth x 5) 2) (dlm-nth (dlm-nth x 6) 2)))
    (dlm-proper? (dlm-nth x 7) 256)
    (let ((ok true) (seen ())) (list-do q (dlm-nth x 7)
      (if (and (sq-shape? q 3) (= (car q) 'typed-query95)
          (dlm-member? (dlm-nth q 1) (list (dlm-nth (dlm-nth x 5) 1) (dlm-nth (dlm-nth x 6) 1)))
          (c95-context? (dlm-nth q 2) (dlm-nth x 2))
          (not (dlm-member? (list (dlm-nth q 1) (dlm-nth (dlm-nth q 2) 1)) seen)))
        (set seen (cons (list (dlm-nth q 1) (dlm-nth (dlm-nth q 2) 1)) seen)) (set ok false))) ok)
    (dlm-member? (dlm-nth x 8) '(shared95 logical95 no-relational95 no-numeric95 no-output95))
    (e93-branch? (dlm-nth x 9)) (e93-int? (dlm-nth x 10) 1 3) (b91-fuel? (dlm-nth x 11))))
(define-function i95-observe (f)
  (assert (= (car (basis91 'observe (dlm-nth f 2) (dlm-nth f 3))) 'committed91) "frame facts")
  (assert (= (car (basis91 'observe-values (dlm-nth f 1) (dlm-nth f 2) (dlm-nth f 4) (dlm-nth f 5))) 'committed91) "frame values"))
(define-function i95-compose (f cost fuel)
  (let ((p (basis91 'typed-proposal (dlm-nth f 1) cost fuel)))
    (if (= (car p) 'proposal95)
      (assert (= (car (b91-commit (list 'compose95 p))) 'committed91) "joint typed admission")) p))
(define-function i95-prepare (input)
  (assert (i95-input? input) "invalid composition95 input")
  (let ((arm (dlm-nth input 8)) (branch (dlm-nth input 9)) (cost (dlm-nth input 10)) (fuel (dlm-nth input 11)))
    (set *c95-output-reuse* (not (= arm 'no-output95)))
    (basis91 'init (dlm-nth input 2))
    (assert (= (car (basis91 'observe 'initial95 (dlm-nth input 3))) 'committed91) "initial observation")
    (if (not (= arm 'no-relational95))
      (begin
        (assert (= (car (basis91 'interpret-controlled 'initial95 fuel 'adaptive92)) 'committed91) "existing interpretation")
        (assert (= (car (basis91 'learn)) 'committed91) "existing relation formation")
        (if (not (= arm 'logical95))
          (assert (= (car (basis91 'encode 1 'eml94 branch)) 'committed91) "same relational basis codec"))))
    (assert (= (car (basis91 'types branch)) 'committed91) "typed facet in existing owner")
    (list-do c (dlm-nth input 4)
      (assert (= (car (basis91 'calibrate (dlm-nth c 1) (dlm-nth c 2) (dlm-nth c 3))) 'committed91) "numeric observations")
      (if (not (= arm 'no-numeric95))
        (assert (= (car (basis91 'learn-numeric (dlm-nth c 1) cost fuel)) 'committed91) "native numeric structure learning")))
    (i95-observe (dlm-nth input 5))
    (i95-emit (list 'formation-c95 (i95-compose (dlm-nth input 5) cost fuel)))
    (i95-emit (list 'model-after-c95 (basis91 'model)))
    (i95-observe (dlm-nth input 6))
    (i95-emit (list 'formation-d95 (i95-compose (dlm-nth input 6) cost fuel)))
    (i95-emit (list 'profile95 (basis91 'typed-profile)))))
(define-function i95-run (input)
  (i95-prepare input)
  (let* ((model (basis91 'model)) (frozen (basis91 'snapshot))
         (standalone (s79-field (s79-field model 2 ()) 4 ())) (fuel (dlm-nth input 11)))
    (i95-emit (list 'standalone-model95 standalone))
    (list-do q (dlm-nth input 7)
      (set *c95-stats* '(metrics95 0 0 0 0))
      (i95-emit (list 'query-result95 (dlm-nth q 1) (dlm-nth (dlm-nth q 2) 1)
        (basis91 'typed-infer standalone (dlm-nth q 1) (dlm-nth q 2) fuel) *c95-stats*)))
    (i95-emit (list 'checks95 (b91-model? standalone) (b91-snapshot? frozen)
      (equal frozen (basis91 'snapshot)) (not (dlm-nth standalone 2)) (not (dlm-nth standalone 4))))))

;;; Three-fact chain synthesis from a frontier.
(define facts (list
  (l-fact "a0" (l-atom 'hop1 (list "a" "b")))
  (l-fact "a1" (l-atom 'hop2 (list "b" "c")))
  (l-fact "a2" (l-atom 'hop3 (list "c" "d")))
  (l-fact "b0" (l-atom 'hop1 (list "e" "f")))
  (l-fact "b1" (l-atom 'hop2 (list "f" "g")))
  (l-fact "b2" (l-atom 'hop3 (list "g" "h")))))
(define pos (list (l-atom 'path (list "a" "d")) (l-atom 'path (list "e" "h"))))
(define neg (list (l-atom 'path (list "d" "a"))))
(define c2 (s-candidates facts (car pos)))
(define c3 (s-chain3-candidates facts (car pos)))
(print "TWO_FACT_CANDIDATES " (l-len c2) "\n")
(print "THREE_FACT_CANDIDATES " (l-len c3) "\n")
(define synth (s-chain-synthesize facts pos neg () 20000))
(print "SYNTH " (if (equal (car synth) 'synth107) "rule" synth) " support=" (if (equal (car synth) 'synth107) (s-support synth) ()) "\n")
(define rules (if (equal (car synth) 'synth107) (list (s-rule synth)) ()))
(print "COVERAGE " (s-coverage facts rules pos 20000) "/2\n")
(print "NEGATIVE " (if (s-conflict? facts rules neg 20000) "conflict" "clean") "\n")
(define held (list (l-fact "h0" (l-atom 'hop1 (list "i" "j")))
                   (l-fact "h1" (l-atom 'hop2 (list "j" "k")))
                   (l-fact "h2" (l-atom 'hop3 (list "k" "l")))))
(print "HELD " (if (l-lookup (l-atom 'path (list "i" "l")) (p-close held rules 20000)) "proof" "fail") "\n")
(print "FROZEN " (if (l-lookup (l-atom 'path (list "i" "l")) (p-close held () 20000)) "proof" "fail") "\n")
(print "done-chain\n")

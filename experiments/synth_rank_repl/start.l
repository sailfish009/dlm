;;; Candidate ranking for frontier-driven synthesis.
(define x (list 'var 'x)) (define y (list 'var 'y)) (define z (list 'var 'z))
(define seed (l-rule (l-atom 'ancestor (list x z)) (list (l-atom 'parent (list x z)))))
(define rec (l-rule (l-atom 'ancestor (list x z)) (list (l-atom 'parent (list x y)) (l-atom 'ancestor (list y z)))))
(define p-rec (list seed rec))
(define facts (list
  (l-fact "alt0" (l-atom 'alt1 (list "r" "u")))
  (l-fact "alt1" (l-atom 'alt2 (list "u" "t")))
  (l-fact "h0" (l-atom 'hop1 (list "r" "s")))
  (l-fact "h1" (l-atom 'hop2 (list "s" "t")))
  (l-fact "h2" (l-atom 'hop1 (list "v" "w")))
  (l-fact "h3" (l-atom 'hop2 (list "w" "p")))))
(define pos (list (l-atom 'path (list "r" "t")) (l-atom 'path (list "v" "p"))))
(define neg (list (l-atom 'path (list "t" "r"))))
(define first (s-synthesize facts (car pos) p-rec neg 20000))
(define ranked (s-ranked-synthesize facts pos neg p-rec 20000))
(print "FIRST " (if (equal (car first) 'synth107) (l-pred (l-nth (s-rule first) 2)) first) "\n")
(print "RANKED " (if (equal (car ranked) 'synth107) (l-pred (l-nth (s-rule ranked) 2)) ranked) "\n")
(define rf (if (equal (car ranked) 'synth107) (l-append p-rec (list (s-rule ranked))) p-rec))
(define ff (if (equal (car first) 'synth107) (l-append p-rec (list (s-rule first))) p-rec))
(print "RANKED COVERAGE " (s-coverage facts rf pos 20000) "/2\n")
(print "FIRST COVERAGE " (s-coverage facts ff pos 20000) "/2\n")
(define held (list (l-fact "h4" (l-atom 'hop1 (list "j" "k")))
                   (l-fact "h5" (l-atom 'hop2 (list "k" "l")))))
(print "HELD RANKED " (if (l-lookup (l-atom 'path (list "j" "l")) (p-close held rf 20000)) "proof" "fail") "\n")
(print "FROZEN " (if (l-lookup (l-atom 'path (list "j" "l")) (p-close held p-rec 20000)) "proof" "fail") "\n")
(print "done-rank\n")

;;; graph_variants.l — structural topology probes (not executable kernels).
(define sx (mg-value "sx" "tokens" "sinput"))
(define so (mg-value "so" "tokens" "shared"))
(define sg (mg-graph
  (list sx so)
  (list (mg-node "sinput" "input" () (list "sx") (list))
        (mg-node "shared" "repeat-block" (list "sx") (list "so") (list (list 'loops 6))))
  (list (mg-edge "sx" "shared" 0))))
(define gx (mg-value "gx" "tokens" "ginput"))
(define gg (mg-value "gg" "gate" "gate"))
(define go (mg-value "go" "tokens" "gout"))
(define ggraph (mg-graph
  (list gx gg go)
  (list (mg-node "ginput" "input" () (list "gx") (list))
        (mg-node "gate" "sigmoid-gate" (list "gx") (list "gg") (list))
        (mg-node "gout" "residual" (list "gx" "gg") (list "go") (list)))
  (list (mg-edge "gx" "gate" 0) (mg-edge "gx" "gout" 0) (mg-edge "gg" "gout" 1))))
(define px (mg-value "px" "proof" "pinput"))
(define pc (mg-value "pc" "candidate" "candidate"))
(define pp (mg-value "pp" "proof" "proof"))
(define pr (mg-value "pr" "credit" "credit"))
(define pgraph (mg-graph
  (list px pc pp pr)
  (list (mg-node "pinput" "input" () (list "px") (list))
        (mg-node "candidate" "candidate" (list "px") (list "pc") (list))
        (mg-node "proof" "kernel-proof" (list "pc") (list "pp") (list))
        (mg-node "credit" "path-credit" (list "pp") (list "pr") (list)))
  (list (mg-edge "px" "candidate" 0) (mg-edge "pc" "proof" 0) (mg-edge "pp" "credit" 0))))
(print "G-SHARED " (mg-check sg) " NODES " (l-len (mg-nodes sg)) " TOPO " (mg-topo sg) "\n")
(print "G-GATED " (mg-check ggraph) " NODES " (l-len (mg-nodes ggraph)) " TOPO " (mg-topo ggraph) "\n")
(print "G-PROOF " (mg-check pgraph) " NODES " (l-len (mg-nodes pgraph)) " TOPO " (mg-topo pgraph) "\n")
(print "done-graph-variants\n")

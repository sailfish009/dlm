;;; graph.l — explicit computation graph for one DT transformer block.
(define x (mg-value "x" "tokens" "input"))
(define q (mg-value "q" "tokens" "matmul-q"))
(define k (mg-value "k" "tokens" "matmul-k"))
(define v (mg-value "v" "tokens" "matmul-v"))
(define s (mg-value "s" "scores" "attention-score"))
(define p (mg-value "p" "weights" "softmax"))
(define a (mg-value "a" "tokens" "weighted-value"))
(define m (mg-value "m" "tokens" "out-projection"))
(define r (mg-value "r" "tokens" "residual-1"))
(define n1 (mg-value "n1" "tokens" "layernorm-1"))
(define f1 (mg-value "f1" "features" "ffn-1"))
(define f2 (mg-value "f2" "tokens" "ffn-2"))
(define r2 (mg-value "r2" "tokens" "residual-2"))
(define out (mg-value "out" "tokens" "layernorm-2"))
(define g
  (mg-graph
    (list x q k v s p a m r n1 f1 f2 r2 out)
    (list
      (mg-node "input" "input" () (list "x") (list))
      (mg-node "matmul-q" "matmul" (list "x") (list "q") (list))
      (mg-node "matmul-k" "matmul" (list "x") (list "k") (list))
      (mg-node "matmul-v" "matmul" (list "x") (list "v") (list))
      (mg-node "attention-score" "dot" (list "q" "k") (list "s") (list))
      (mg-node "softmax" "softmax" (list "s") (list "p") (list))
      (mg-node "weighted-value" "weighted-sum" (list "p" "v") (list "a") (list))
      (mg-node "out-projection" "matmul" (list "a") (list "m") (list))
      (mg-node "residual-1" "add" (list "x" "m") (list "r") (list))
      (mg-node "layernorm-1" "layernorm" (list "r") (list "n1") (list))
      (mg-node "ffn-1" "matmul" (list "n1") (list "f1") (list))
      (mg-node "ffn-2" "matmul" (list "f1") (list "f2") (list))
      (mg-node "residual-2" "add" (list "n1" "f2") (list "r2") (list))
      (mg-node "layernorm-2" "layernorm" (list "r2") (list "out") (list)))
    (list
      (mg-edge "x" "matmul-q" 0) (mg-edge "x" "matmul-k" 0) (mg-edge "x" "matmul-v" 0)
      (mg-edge "q" "attention-score" 0) (mg-edge "k" "attention-score" 1)
      (mg-edge "s" "softmax" 0) (mg-edge "p" "weighted-value" 0) (mg-edge "v" "weighted-value" 1)
      (mg-edge "a" "out-projection" 0) (mg-edge "x" "residual-1" 0) (mg-edge "m" "residual-1" 1)
      (mg-edge "r" "layernorm-1" 0) (mg-edge "n1" "ffn-1" 0) (mg-edge "f1" "ffn-2" 0)
      (mg-edge "n1" "residual-2" 0) (mg-edge "f2" "residual-2" 1) (mg-edge "r2" "layernorm-2" 0))))
(print "GRAPH " (mg-check g) " NODES " (l-len (mg-nodes g)) " EDGES " (l-len (mg-edges g)) "\n")
(print "CSE " (l-len (mg-nodes (mg-cse g))) " DCE " (l-len (mg-nodes (mg-dce g (list "layernorm-2")))) "\n")
(print "TOPO " (mg-topo g) "\n")
(print "done-graph\n")

;;; -*- mode: lisp; coding: us-ascii -*-
(define-function f78-result (m)
  (let ((answers (dlm-nth m 4)))
    (if answers
        (let ((a (car answers)))
          (list 'result (if (= (dlm-nth a 2) 'proof) 'proved 'countermodel)
                (dlm-nth a 3) (dlm-nth m 6)))
      (list 'result 'incomplete () (dlm-nth m 6)))))
(define-function f78-classification (pos neg)
  (let ((p (f78-result pos)) (n (f78-result neg)))
    (list 'classification
      (if (and (= (dlm-nth p 1) 'proved) (= (dlm-nth n 1) 'proved)) 'CONFLICT
        (if (= (dlm-nth p 1) 'proved) 'PROVED
          (if (= (dlm-nth n 1) 'proved) 'DISPROVED
            (if (and (= (dlm-nth p 1) 'countermodel) (= (dlm-nth n 1) 'countermodel)) 'UNKNOWN 'incomplete)))) p n)))
(define-function f78-negative (problem)
  (list 'problem 'classical-prop-v1 (dlm-nth problem 2)
    (sq-sequent (sq-left (dlm-nth problem 3)) (list (list 'not (car (sq-right (dlm-nth problem 3))))))))
(define-function f78-learn-machine (lib m)
  (list-do a (dlm-nth m 4)
    (if (= (dlm-nth a 2) 'proof)
        (set lib (p78-admit lib (dlm-nth (dlm-nth m 2) 1) (dlm-nth a 3))))) lib)
(define-function f78-emit (split arm pass id pos neg)
  (let ((c (f78-classification pos neg)))
    (dump (list 'fld78-result split arm pass id (dlm-nth c 1)
      (dlm-nth pos 6) (dlm-nth neg 6)
      (if (and (dlm-nth pos 4) (= (dlm-nth pos 6) 1)) 1 0)
      (if (and (dlm-nth neg 4) (= (dlm-nth neg 6) 1)) 1 0))) (print "\n")))
(define-function f78-run (batch)
  (assert (and (sq-shape? batch 6) (= (car batch) 'fld78-run-v1)) "expected fld78 input-only batch")
  (let ((train (dlm-nth batch 1)) (validation (dlm-nth batch 2)) (test (dlm-nth batch 3))
        (budget (dlm-nth batch 4)) (passes (dlm-nth batch 5)) (library ()) (jobs ()) (cold-jobs ()) (pass 1))
    (assert (and (is <long> budget) (> budget 0) (<= budget 1000)
                 (is <long> passes) (> passes 0) (<= passes 10)) "bounded FLD settings")
    (while (<= pass passes)
      (let ((next ()))
        (list-do row train
          (let* ((id (car row)) (problem (dlm-nth row 1)) (prior (dlm-assoc id jobs))
                 (pos (n78-run (if prior (dlm-nth prior 1) (n78-proof problem library)) budget))
                 (neg (n78-run (if prior (dlm-nth prior 2) (n78-proof (f78-negative problem) library)) budget)))
            (set library (f78-learn-machine (f78-learn-machine library pos) neg))
            (set next (dlm-append next (list (list id pos neg))))
            (f78-emit 'train 'learned pass id pos neg)))
        (set jobs next))
      (let ((next ()))
        (list-do row train
          (let* ((id (car row)) (problem (dlm-nth row 1)) (prior (dlm-assoc id cold-jobs))
                 (pos (n78-run (if prior (dlm-nth prior 1) (n78-proof problem ())) budget))
                 (neg (n78-run (if prior (dlm-nth prior 2) (n78-proof (f78-negative problem) ())) budget)))
            (set next (dlm-append next (list (list id pos neg))))
            (f78-emit 'train 'cold pass id pos neg)))
        (set cold-jobs next))
      (set pass (+ pass 1)))
    (dump (list 'fld78-library library)) (print "\n")
    (dump (list 'fld78-training-state jobs)) (print "\n")
    (list-do split (list (list 'validation validation) (list 'test test))
      (list-do arm '(cold learned)
        (list-do row (dlm-nth split 1)
          (let* ((problem (dlm-nth row 1)) (lib (if (= arm 'learned) library ()))
                 (pos (n78-run (n78-proof problem lib) budget))
                 (neg (n78-run (n78-proof (f78-negative problem) lib) budget)))
            (f78-emit (car split) arm 0 (car row) pos neg)))))))
(define *f78-request* (read *standard-input*))
(assert (= (read *standard-input*) +end+) "trailing FLD data")
(f78-run *f78-request*)

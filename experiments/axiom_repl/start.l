;;; Learned program → atomic axioms → subset search → held-out proof.
(define p1 (s-template-synthesize *train-facts* *train-pos* *neg* 20000))
(define t1 (p-close *train-facts* (s-rec-rules p1) 20000))
(define self (l-filter (lambda (f) (equal (l-pred (l-fact-atom f)) 'isa)) t1))
(define p2 (s-template-synthesize *train-facts* (l-append *train-pos* (l-map l-fact-atom self)) *neg* 20000))
(define axs (a-from-program "A" p2 (list "web:selfsup") (s-rec-support p2)))
(define sel (a-select axs *train-facts* *train-pos* *neg* 20000))
(define closed (l-filter (lambda (s) (a-closed? s axs)) (a-subsets (l-map a-id axs))))
(define qs (list (l-atom 'isa (list 'dog 'living-thing))
                 (l-atom 'isa (list 'sparrow 'living-thing))
                 (l-atom 'isa (list 'plant 'living-thing))))
(define held (let ((n 0)) (list-do q qs (if (equal (l-nth (p-prove *web-edges* (a-rules-for (l-nth sel 1) axs) q 20000) 1) 'proof) (set n (+ n 1)))) n))
(print "AX " (l-len axs) " SUBSETS " (l-len (a-subsets (l-map a-id axs))) " CLOSED " (l-len closed) "\n")
(print "SEL " (l-nth sel 1) " COV " (l-nth sel 2) "\n")
(print "HELD " held "/3\n")
(print "done-axiom\n")

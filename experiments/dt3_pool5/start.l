;;; E27: five-axiom actual verifier pool (batch subset API).
(define vx (l-var 'x))
(define r0 (l-rule (l-atom 'isa (list vx 'mammal)) (list (l-atom 'subclass (list vx 'mammal)))))
(define r1 (l-rule (l-atom 'isa (list vx 'animal)) (list (l-atom 'isa (list vx 'mammal)))))
(define r2 (l-rule (l-atom 'isa (list vx 'living-thing)) (list (l-atom 'isa (list vx 'animal)))))
(define d1 (l-rule (l-atom 'isa (list vx 'animal)) (list (l-atom 'subclass (list vx 'bird)))))
(define d2 (l-rule (l-atom 'isa (list vx 'mammal)) (list (l-atom 'subclass (list vx 'cat)))))
(define axs ())
(set axs (a-add axs "A-0" r0 (list "target") (list "s0") ()))
(set axs (a-add axs "A-1" r1 (list "target") (list "s1") (list "A-0")))
(set axs (a-add axs "A-2" r2 (list "target") (list "s2") (list "A-1")))
(set axs (a-add axs "A-3" d1 (list "decoy") (list "d1") ()))
(set axs (a-add axs "A-4" d2 (list "decoy") (list "d2") ()))
(define vgoal (l-atom 'isa (list 'dog 'living-thing)))
(define-function eval-subset (ids)
  (let ((rules (a-rules-for ids axs)))
    (list ids (l-len rules) (l-nth (p-prove *web-edges* rules vgoal 20000) 1))))
(define-function eval-subsets (sets)
  (list-do s sets
    (let ((r (eval-subset s)))
      (print "POOL5 ids=" (l-nth r 0) " rules=" (l-nth r 1) " proof=" (l-nth r 2) "\n"))))
(eval-subsets (a-subsets (list "A-0" "A-1" "A-2" "A-3" "A-4")))
(print "done-pool5\n")
;;; Unseen entity bindings against the same five-axiom pool.
(define-function eval-goal (g)
  (let ((r (p-prove *web-edges* (a-rules-for (list "A-0" "A-1" "A-2") axs) g 20000)))
    (print "GOAL5 " g " proof=" (l-nth r 1) "\n")))
(eval-goal (l-atom 'isa (list 'cat 'living-thing)))
(eval-goal (l-atom 'isa (list 'sparrow 'living-thing)))
(eval-goal (l-atom 'isa (list 'plant 'living-thing)))
(print "done-goal5\n")
;;; Alternative proof subset: sparrow needs A-2 + A-3, not A-0 + A-1 + A-2.
(define sgoal (l-atom 'isa (list 'sparrow 'living-thing)))
(define-function eval-subset-g (g ids)
  (let ((rules (a-rules-for ids axs)))
    (list ids (l-nth (p-prove *web-edges* rules g 20000) 1))))
(define-function eval-subsets-g (g sets)
  (list-do s sets
    (let ((r (eval-subset-g g s)))
      (print "SPOOL5 ids=" (l-nth r 0) " proof=" (l-nth r 1) "\n"))))
(eval-subsets-g sgoal (a-subsets (list "A-0" "A-1" "A-2" "A-3" "A-4")))
(print "done-spool5\n")

;;; Two-predicate block synthesis on alternating edges.
(define facts (list
  (l-fact "v0" (l-atom 'up (list "a" "b")))
  (l-fact "v1" (l-atom 'down (list "b" "c")))
  (l-fact "v2" (l-atom 'up (list "c" "d")))
  (l-fact "v3" (l-atom 'down (list "d" "e")))
  (l-fact "v4" (l-atom 'up (list "e" "f")))
  (l-fact "v5" (l-atom 'down (list "f" "g")))))
(define pos (list (l-atom 'reach (list "a" "g"))))
(define neg (list (l-atom 'reach (list "a" "d"))
                  (l-atom 'reach (list "a" "f"))))
(define single (s-stride-synthesize facts pos neg 3 20000))
(print "SINGLE coverage=" (if (s-rec-program? single) (s-coverage facts (s-rec-rules single) pos 20000) 0) "\n")
(define prog (s-pair-synthesize facts pos neg 20000))
(print "PROGRAM " (if (s-rec-program? prog) "pair" prog) " rules=" (if (s-rec-program? prog) (l-len (s-rec-rules prog)) 0) " support=" (if (s-rec-program? prog) (s-rec-support prog) ()) "\n")
(print "COVERAGE " (s-coverage facts (s-rec-rules prog) pos 20000) "/1\n")
(print "NEGATIVE " (if (s-conflict? facts (s-rec-rules prog) neg 20000) "conflict" "clean") "\n")
(define held (list (l-fact "w0" (l-atom 'up (list "h" "i")))
                   (l-fact "w1" (l-atom 'down (list "i" "j")))
                   (l-fact "w2" (l-atom 'up (list "j" "k")))
                   (l-fact "w3" (l-atom 'down (list "k" "l")))
                   (l-fact "w4" (l-atom 'up (list "l" "m")))
                   (l-fact "w5" (l-atom 'down (list "m" "n")))))
(print "HELD " (if (l-lookup (l-atom 'reach (list "h" "n")) (p-close held (s-rec-rules prog) 20000)) "proof" "fail") "\n")
(print "HELD NEG " (if (l-lookup (l-atom 'reach (list "h" "k")) (p-close held (s-rec-rules prog) 20000)) "proof" "fail") "\n")
(define seed-only (list (s-rule (car (s-pair-seed-candidates facts (car pos))))))
(print "SEED ONLY HELD " (if (l-lookup (l-atom 'reach (list "h" "n")) (p-close held seed-only 20000)) "proof" "fail") "\n")
(print "FROZEN " (if (l-lookup (l-atom 'reach (list "h" "n")) (p-close held () 20000)) "proof" "fail") "\n")
(print "done-pair\n")

;;; pst_debug.l — stage-by-stage dump for case 0 (compare with `pst --dump-forward`)
(define-function pst-pv-loop (xs) (if xs (begin (print " " (car xs)) (pst-pv-loop (cdr xs))) ()))
(define-function pst-pv (name xs) (print name) (pst-pv-loop xs) (print "\n"))
(define-function pst-debug (case)
  (let* ((state (l-nth case 1))
         (cf (l-nth case 2))
         (live (map (lambda (x) (v-add (v-add (mat-vec pst-Wc x) pst-bc) pst-tc)) cf))
         (h0 (cons (v-add (v-add (mat-vec pst-Ws state) pst-bs) pst-ts) live))
         (ln1 (map (lambda (x) (layernorm x pst-g1_0 pst-be1_0)) h0))
         (qkv (map (lambda (x) (v-add (mat-vec pst-Wqkv0 x) pst-bqkv0)) ln1))
         (ao (map (lambda (qi) (pst-attn-token qi qkv)) qkv))
         (h1 (map (lambda (a o) (v-add a (v-add (mat-vec pst-Wo0 o) pst-bo0))) h0 ao))
         (ln2 (map (lambda (x) (layernorm x pst-g2_0 pst-be2_0)) h1))
         (act (map (lambda (x) (pst-gelu-vec (v-add (mat-vec pst-W1_0 x) pst-b1_0))) ln2))
         (h2 (map (lambda (a f) (v-add a (v-add (mat-vec pst-W2_0 f) pst-b2_0))) h1 act))
         (sc (pst-score case)))
    (pst-pv "ETH0" (car h0))
    (pst-pv "LN1_0" (car ln1))
    (pst-pv "QKV0" (car qkv))
    (let* ((q0 (pst-q (car qkv) 0))
           (sc0 (map (lambda (kt) (fx-mul pst-SCALE (v-dot q0 (pst-k kt 0)))) qkv))
           (w0 (v-softmax sc0)))
      (pst-pv "SC0H0" sc0)
      (pst-pv "ATT0H0" w0))
    (pst-pv "AO0" (car ao))
    (pst-pv "H1_0" (car h1))
    (pst-pv "ACT0" (car act))
    (pst-pv "H2_0" (car h2))
    (pst-pv "SCORE" sc)))
(pst-debug (car pst-cases))

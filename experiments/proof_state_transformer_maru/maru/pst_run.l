;;; pst_run.l — run the exported inference cases and check parity with the C lab.
(define *pst-total* 0)
(define *pst-ok* 0)
(define *pst-maxerr* 0)

(define-function pst-run (cases)
  (if (not cases) ()
    (let* ((c (car cases))
           (sc (pst-score c))
           (exp-pick (l-nth c 3))
           (exp-sc (l-nth c 4))
           (pick (pst-argmax sc))
           (err (pst-maxabs sc exp-sc)))
      (set *pst-total* (+ *pst-total* 1))
      (if (= pick exp-pick) (set *pst-ok* (+ *pst-ok* 1)))
      (if (> err *pst-maxerr*) (set *pst-maxerr* err))
      (print "PST-CASE pick=" pick " c_pick=" exp-pick " maxerr_q16=" err "\n")
      (pst-run (cdr cases)))))

(pst-run pst-cases)
(print "MARU-PST picks=" *pst-ok* "/" *pst-total* " maxerr_q16=" *pst-maxerr* "\n")
(if (and (= *pst-ok* *pst-total*) (< *pst-maxerr* 3277))
    (print "MARU-PST-PARITY-PASS\n")
    (print "MARU-PST-PARITY-FAIL\n"))
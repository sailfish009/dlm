;;; pst_infer.l — Maru Q16 inference for the native proof-state set transformer.
;;; Load order: boot.l logic.l infer.l deduce.l proof.l  maru/fx.l maru/exp_table.l
;;;              out/pst_data.l  maru/pst_infer.l
;;; The weights and the evaluation cases are generated by `pst --export-maru`.
;;; This file never decides truth: it ranks candidate rules; the kernel closure
;;; decides success (see the C lab's policy evaluation).

(define pst-DH (/ pst-D pst-NH))
(define pst-SCALE (fx-div 65536 (fx-sqrt (* pst-DH 65536))))

(define-function pst-take (xs n)
  (if (or (= n 0) (not xs)) () (cons (car xs) (pst-take (cdr xs) (- n 1)))))
(define-function pst-drop (xs n)
  (if (or (= n 0) (not xs)) xs (pst-drop (cdr xs) (- n 1))))
(define-function pst-slice (xs off n) (pst-take (pst-drop xs off) n))
(define-function pst-flat2 (a b)
  (if (not a) b (cons (car a) (pst-flat2 (cdr a) b))))

(define-function pst-q (tok hh) (pst-slice tok (* hh pst-DH) pst-DH))
(define-function pst-k (tok hh) (pst-slice tok (+ pst-D (* hh pst-DH)) pst-DH))
(define-function pst-v (tok hh) (pst-slice tok (+ (* 2 pst-D) (* hh pst-DH)) pst-DH))

;;; tanh and GELU in Q16 (same formulas as the C trainer)
(define-function pst-tanh (u)
  (let* ((neg (< u 0))
         (a (if neg (- 0 u) u))
         (e (fx-exp (- 0 (* 2 a))))
         (t (fx-div (- 65536 e) (+ 65536 e))))
    (if neg (- 0 t) t)))
(define-function pst-gelu (x)
  (let* ((x3 (fx-mul (fx-mul x x) x))
         (inner (+ x (fx-mul 2931 x3)))
         (u (fx-mul 52299 inner))
         (t (pst-tanh u)))
    (fx-mul (fx-mul 32768 x) (+ 65536 t))))
(define-function pst-gelu-vec (xs) (map pst-gelu xs))

(define-function pst-argmax-loop (xs i bi bv)
  (if (not xs) bi
    (let ((v (car xs)))
      (if (> v bv) (pst-argmax-loop (cdr xs) (+ i 1) i v)
                   (pst-argmax-loop (cdr xs) (+ i 1) bi bv)))))
(define-function pst-argmax (xs) (pst-argmax-loop (cdr xs) 1 0 (car xs)))
(define-function pst-maxabs (a b)
  (if (not a) 0
    (let ((d (if (> (car a) (car b)) (- (car a) (car b)) (- (car b) (car a)))))
      (let ((r (pst-maxabs (cdr a) (cdr b)))) (if (> d r) d r)))))

(define-function pst-wsum (tokens ws hh acc)
  (if (not tokens) acc
    (pst-wsum (cdr tokens) (cdr ws) hh
      (v-add acc (v-scale (pst-v (car tokens) hh) (car ws))))))

(define-function pst-head-out (qi tokens hh)
  (let* ((qh (pst-q qi hh))
         (scores (map (lambda (kt) (fx-mul pst-SCALE (v-dot qh (pst-k kt hh)))) tokens))
         (w (v-softmax scores)))
    (pst-wsum tokens w hh (map (lambda (x) 0) (pst-v qi hh)))))

(define-function pst-attn-token (qi tokens)
  (pst-flat2 (pst-head-out qi tokens 0)
    (pst-flat2 (pst-head-out qi tokens 1)
      (pst-flat2 (pst-head-out qi tokens 2)
                 (pst-head-out qi tokens 3)))))

;;; one transformer block over the token list (state token first, then candidates)
(define-function pst-layer (h Wqkv bqkv Wo bo g1 be1 W1 b1 W2 b2 g2 be2)
  (let* ((ln1 (map (lambda (x) (layernorm x g1 be1)) h))
         (qkv (map (lambda (x) (v-add (mat-vec Wqkv x) bqkv)) ln1))
         (ao (map (lambda (qi) (pst-attn-token qi qkv)) qkv))
         (h1 (map (lambda (a o) (v-add a (v-add (mat-vec Wo o) bo))) h ao))
         (ln2 (map (lambda (x) (layernorm x g2 be2)) h1))
         (act (map (lambda (x) (pst-gelu-vec (v-add (mat-vec W1 x) b1))) ln2))
         (h2 (map (lambda (a f) (v-add a (v-add (mat-vec W2 f) b2))) h1 act)))
    h2))

(define-function pst-score (case)
  (let* ((nlive (l-nth case 0))
         (state (l-nth case 1))
         (cf (l-nth case 2))
         (live (map (lambda (x) (v-add (v-add (mat-vec pst-Wc x) pst-bc) pst-tc)) cf))
         (h0 (cons (v-add (v-add (mat-vec pst-Ws state) pst-bs) pst-ts) live))
         (h1 (pst-layer h0 pst-Wqkv0 pst-bqkv0 pst-Wo0 pst-bo0
                        pst-g1_0 pst-be1_0 pst-W1_0 pst-b1_0 pst-W2_0 pst-b2_0
                        pst-g2_0 pst-be2_0))
         (h2 (pst-layer h1 pst-Wqkv1 pst-bqkv1 pst-Wo1 pst-bo1
                        pst-g1_1 pst-be1_1 pst-W1_1 pst-b1_1 pst-W2_1 pst-b2_1
                        pst-g2_1 pst-be2_1))
         (lnf (map (lambda (x) (layernorm x pst-gf pst-bef)) h2))
         (cand (cdr lnf))
         (wrow (car pst-Wout))
         (bout (car pst-bout)))
    (map (lambda (x) (+ (v-dot wrow x) bout)) cand)))


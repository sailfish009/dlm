(require "experiments/web96/driver.l")
(define data96 (read *standard-input*))
(assert (= (read *standard-input*) +end+) "trailing interventions")
(assert (and (sq-shape? data96 3) (= (car data96) 'intervention-input96)))
(define p96 (dlm-nth data96 1))
(define changed96 (dlm-nth data96 2))
(assert (w96-packet? p96)) (assert (w96-packet? changed96))
(set i96-emit (lambda (x) ()))
(define-function note96 (name x) (dump (list name x)) (print "\n"))
(define goal96 '((country-subregion96 0 1) (subregion-region96 1 2) (region-global96 2 3)))
(i96-prepare p96 'logical96)
(define old96 (basis91 'model))
(define token96 (basis91 'web-token))
(define snapshot96 (basis91 'snapshot))
(note96 'formed96 (dlm-nth *b91-state* 4))
(note96 'original96 (basis91 'web-query "web-row96:020" goal96 200000 'adaptive92))
(note96 'duplicate96 (basis91 'web-import p96 token96))
(note96 'omitted-extraction96 (basis91 'web-import (s79-field p96 7 (s79-field (dlm-nth p96 7) 4 ())) token96))
(note96 'failed-ingress-unchanged96 (equal snapshot96 (basis91 'snapshot)))
(define execute96 a92-execute)
(set a92-execute (lambda (op ep lib scope envs r) (a92-computed 'complete () r)))
(note96 'omitted-query96 (basis91 'web-query "web-row96:020" goal96 200000 'adaptive92))
(set a92-execute execute96)
(note96 'tiny-budget96 (basis91 'web-query "web-row96:020" goal96 1 'adaptive92))
(note96 'withdraw96 (basis91 'web-retract token96))
(note96 'inactive96 (basis91 'web-query "web-row96:020" goal96 200000 'adaptive92))
(note96 'historical96 (w96-infer old96 p96 "web-row96:020" goal96 200000 'adaptive92))
(note96 'restore96 (basis91 'web-import p96 (basis91 'web-token)))
(note96 'stale-token96 (basis91 'web-retract token96))
(note96 'restored96 (basis91 'web-query "web-row96:020" goal96 200000 'adaptive92))
;;; This is an explicitly synthetic local perturbation, NOT an upstream update.
(note96 'counterfactual-import96 (basis91 'web-import changed96 (basis91 'web-token)))
(note96 'stale-document96 (w96-infer (basis91 'model) p96 "web-row96:020" goal96 200000 'adaptive92))
(note96 'counterfactual-answer96 (basis91 'web-query "web-row96:020" goal96 200000 'adaptive92))
(note96 'definitions-preserved96 (= (dlm-length (dlm-nth *b91-state* 4)) 2))
(note96 'counterfactual-replay96 (b91-snapshot? (basis91 'snapshot)))
(note96 'actual-source-restored96 (basis91 'web-import p96 (basis91 'web-token)))
(note96 'final96 (basis91 'web-query "web-row96:020" goal96 200000 'adaptive92))
(note96 'final-replay96 (b91-snapshot? (basis91 'snapshot)))
;;; Do not claim impossibility from the staged no-prefix arm: one extra ordinary
;;; formation step recovers B2 using the same raw observations and learned B1.
(i96-prepare p96 'no-prefix96)
(note96 'delayed-before96 (dlm-nth *b91-state* 4))
(note96 'delayed-extra-learn96 (basis91 'learn))
(note96 'delayed-after96 (dlm-nth *b91-state* 4))
(note96 'delayed-replay96 (b91-snapshot? (basis91 'snapshot)))

;;; Fresh-process application from a compact admitted core + source query bytes.
;;; No training events, support tables or discovery are supplied.
(require "experiments/web96/driver.l")
(define input96 (read *standard-input*))
(assert (= (read *standard-input*) +end+) "trailing standalone input")
(assert (and (sq-shape? input96 3) (= (car input96) 'standalone-input96)))
(define model96 (dlm-nth input96 1))
(define packet96 (dlm-nth input96 2))
(assert (b91-model? model96))
(assert (not (dlm-nth model96 2))) (assert (not (dlm-nth model96 4)))
(assert (not *w96-verified*))
(set *b91-state* ()) (set *e93-state* ())
(set b91-replay (lambda args '(disabled96 replay)))
(set b91-propose (lambda args '(disabled96 formation)))
(set b91-candidates (lambda args '(disabled96 candidates)))
(set b91-interpret (lambda args '(disabled96 interpretation)))
(set e93-search (lambda args '(disabled96 numeric-search)))
(define count96 0)
(list-do view (dlm-nth (dlm-nth packet96 7) 4)
  (list-do pattern (i96-patterns)
    (list-do policy '(adaptive92 raw96)
      (i96-emit (list 'query96 (dlm-nth view 1) pattern policy
        (w96-infer model96 packet96 (dlm-nth view 1) pattern 200000 policy)))
      (set count96 (+ count96 1)))))
(assert (not *b91-state*)) (assert (not *e93-state*))
(i96-emit (list 'standalone-done96 count96 'no-training-archive 'no-learner 'fresh-verification))

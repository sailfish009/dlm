;;; Data-only real-web experiment; all formation uses the existing Basis91 API.
(define-function i96-emit (x) (dump x) (print "\n"))
(define-function i96-committed (x) (assert (= (car x) 'committed91) "web96 transition failed" x) x)
(define-function i96-learn (arm)
  (i96-committed (if (= arm 'eml96) (basis91 'learn 'eml94 'principal93) (basis91 'learn))))
(define-function i96-prepare (p arm)
  (assert (dlm-member? arm '(logical96 eml96 no-prefix96 no-formation96 no-extraction96)))
  (basis91 'init *w96-predicates*)
  (if (= arm 'no-extraction96)
    (let ((bad (basis91 'web-import (s79-field p 7 ()) 'missing96)))
      (assert (= (car bad) 'rejected91)) (i96-emit (list 'ingress96 bad)))
    (begin
      (i96-emit (list 'ingress96 (i96-committed (basis91 'web-import p 'missing96))))
      (if (not (= arm 'no-formation96))
        (begin
          (if (not (= arm 'no-prefix96))
            (begin (i96-committed (basis91 'interpret "web-train96" 200000)) (i96-learn arm)))
          (i96-committed (basis91 'interpret-controlled "web-next96" 200000 'adaptive92)) (i96-learn arm))))))
(define-function i96-patterns ()
  '(((country-subregion96 0 1) (subregion-region96 1 2))
    ((country-subregion96 0 1) (subregion-region96 1 2) (region-global96 2 3))))
(define-function i96-run (input)
  (assert (and (sq-shape? input 5) (= (car input) 'web-run96)
    (e93-int? (dlm-nth input 3) 1 512) (dlm-proper? (dlm-nth input 4) 5) (dlm-nth input 4)) "bad web96 experiment envelope")
  (let ((p (dlm-nth input 1)) (arm (dlm-nth input 2)) (limit (dlm-nth input 3)) (policies (dlm-nth input 4)))
    (assert (w96-packet? p) "bad web96 data packet")
    (list-do policy policies (assert (or (= policy 'raw96) (a92-policy? policy))))
    (i96-prepare p arm)
    (let* ((full (basis91 'model)) (model (s79-field (s79-field full 2 ()) 4 ()))
           (count 0) (snapshot (basis91 'snapshot)))
      (i96-emit (list 'replay96 (b91-snapshot? snapshot)))
      (i96-emit (list 'model96 model))
      (i96-emit (list 'summary96 arm (dlm-length (dlm-nth *b91-state* 4))
        (b91-work-size (dlm-nth *b91-state* 5)) (dlm-length (dlm-nth *b91-state* 6))
        (dlm-nth (dlm-nth p 7) 6) (dlm-length (dlm-nth (dlm-nth p 7) 5))))
      ;; Core-only application: remove live owner, replay, observation archives,
      ;; candidate formation and numeric learner. Source bytes remain query data.
      (set *b91-state* ()) (set *e93-state* ())
      (set b91-replay (lambda (a b) '(disabled96 replay)))
      (set b91-propose (lambda (s) '(disabled96 formation)))
      (set b91-candidates (lambda (s) '(disabled96 candidates)))
      (set e93-search (lambda args '(disabled96 numeric-search)))
      (list-do view (dlm-nth (dlm-nth p 7) 4)
        (if (< count limit)
          (begin
            (list-do pattern (i96-patterns)
              (list-do policy policies
                (i96-emit (list 'query96 (dlm-nth view 1) pattern policy
                  (w96-infer model p (dlm-nth view 1) pattern 200000 policy)))))
            (set count (+ count 1)))))
      (assert (equal model (s79-field (s79-field full 2 ()) 4 ())) "frozen core changed")
      (assert (not *b91-state*))
      (i96-emit (list 'done96 count 'frozen-core 'no-live-owner)))))

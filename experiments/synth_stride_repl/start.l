;;; Infer a stride-3 program from one long positive and odd-distance negatives.
(define facts (list
  (l-fact "u0" (l-atom 'parent (list "a" "b")))
  (l-fact "u1" (l-atom 'parent (list "b" "c")))
  (l-fact "u2" (l-atom 'parent (list "c" "d")))
  (l-fact "u3" (l-atom 'parent (list "d" "e")))
  (l-fact "u4" (l-atom 'parent (list "e" "f")))
  (l-fact "u5" (l-atom 'parent (list "f" "g")))))
(define pos (list (l-atom 'ancestor (list "a" "g"))))
(define neg (list (l-atom 'ancestor (list "a" "c"))
                  (l-atom 'ancestor (list "a" "e"))
                  (l-atom 'ancestor (list "a" "f"))))
(define p1 (s-stride-synthesize facts pos neg 1 20000))
(define p2 (s-stride-synthesize facts pos neg 2 20000))
(define prog (s-stride-synthesize facts pos neg 4 20000))
(print "ONE " (if (s-rec-program? p1) "program" "none") " conflict=" (if (s-rec-program? p1) (if (s-conflict? facts (s-rec-rules p1) neg 20000) "yes" "no") "n/a") "\n")
(print "TWO " (if (s-rec-program? p2) "program" "none") " conflict=" (if (s-rec-program? p2) (if (s-conflict? facts (s-rec-rules p2) neg 20000) "yes" "no") "n/a") "\n")
(print "PROGRAM stride=" (if (s-rec-program? prog) (l-len (l-body (l-nth (s-rec-rules prog) 0))) 0) " rules=" (if (s-rec-program? prog) (l-len (s-rec-rules prog)) 0) " support=" (if (s-rec-program? prog) (s-rec-support prog) ()) "\n")
(print "RULES " (if (s-rec-program? prog) (s-rec-rules prog) ()) "\n")
(print "COVERAGE " (s-coverage facts (s-rec-rules prog) pos 20000) "/1\n")
(print "NEGATIVE " (if (s-conflict? facts (s-rec-rules prog) neg 20000) "conflict" "clean") "\n")
(define held (list (l-fact "h0" (l-atom 'parent (list "h" "i")))
                   (l-fact "h1" (l-atom 'parent (list "i" "j")))
                   (l-fact "h2" (l-atom 'parent (list "j" "k")))
                   (l-fact "h3" (l-atom 'parent (list "k" "l")))
                   (l-fact "h4" (l-atom 'parent (list "l" "m")))
                   (l-fact "h5" (l-atom 'parent (list "m" "n")))))
(print "HELD " (if (l-lookup (l-atom 'ancestor (list "h" "n")) (p-close held (s-rec-rules prog) 20000)) "proof" "fail") "\n")
(print "HELD NEG " (if (l-lookup (l-atom 'ancestor (list "h" "l")) (p-close held (s-rec-rules prog) 20000)) "proof" "fail") "\n")
(define seed-only (list (s-rule (car (s-seedk-candidates facts (car pos) 3)))))
(print "SEED ONLY HELD " (if (l-lookup (l-atom 'ancestor (list "h" "n")) (p-close held seed-only 20000)) "proof" "fail") "\n")
(print "FROZEN " (if (l-lookup (l-atom 'ancestor (list "h" "n")) (p-close held () 20000)) "proof" "fail") "\n")
(print "done-stride\n")

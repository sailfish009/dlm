;;; proof_path.l — distinct ground rules, path enumeration, cost-weighted credit.
(define f1 (l-fact "f1" (l-atom 'p (list 'a 'b))))
(define f2 (l-fact "f2" (l-atom 'p (list 'b 'c))))
(define f3 (l-fact "f3" (l-atom 'p (list 'a 'd))))
(define f4 (l-fact "f4" (l-atom 'p (list 'd 'e))))
(define f5 (l-fact "f5" (l-atom 'p (list 'e 'c))))
(define f6 (l-fact "f6" (l-atom 'p (list 'd 'c))))
(define facts (list f1 f2 f3 f4 f5 f6))
(define r1 (l-rule (l-atom 'p (list 'a 'c)) (list (l-atom 'p (list 'a 'b)) (l-atom 'p (list 'b 'c)))))
(define r2 (l-rule (l-atom 'p (list 'a 'c)) (list (l-atom 'p (list 'a 'd)) (l-atom 'p (list 'd 'e)) (l-atom 'p (list 'e 'c)))))
(define rules (list r1 r2))
(define goal (l-atom 'p (list 'a 'c)))
(define-function one (i)
  (let ((pr (p-prove facts (list (l-nth rules i)) goal 20000)))
    (if (and (equal (l-nth pr 1) 'proof)
             (p-proof-check facts (list (l-nth rules i)) goal (l-nth pr 2))) 1 0)))
(define ok1 (one 0))
(define ok2 (one 1))
;; Cost-weighted integral over the two distinct ground paths.
(define-function weight (rule) (/ 65536 (+ 1 (l-len (l-body rule)))))
(define w1 (weight r1))
(define w2 (weight r2))
(define z (+ w1 w2))
(define-function cred (w) (if (> z 0) (/ (* w 65536) z) 0))
(define c1 (cred w1))
(define c2 (cred w2))
(define pr (p-prove facts rules goal 20000))
(define single (if (equal (l-nth pr 1) 'proof)
                   (l-nth (p-proof-rule-indices (l-nth pr 2) (p-close facts rules 20000)) 0)
                   -1))
(define neg (p-prove facts rules (l-atom 'p (list 'c 'a)) 20000))
(print "DISTINCT-RULES " (if (equal r1 r2) "false" "true") "\n")
(print "PATHS 2 OK1 " ok1 " OK2 " ok2 "\n")
(print "COSTS 2 3 WEIGHTS " w1 " " w2 " Z " z "\n")
(print "CREDITS " c1 " " c2 " (not 1/count)\n")
(print "SINGLE-RULE-INDEX " single " NEG " (if (equal (l-nth neg 1) 'proof) 1 0) " (want 0)\n")
(print "done-proof-path-integral-rebuild\n")

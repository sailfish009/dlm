;;; Four-fact chain synthesis with bounded length search.
(define facts (list
  (l-fact "a0" (l-atom 'hop1 (list "a" "b")))
  (l-fact "a1" (l-atom 'hop2 (list "b" "c")))
  (l-fact "a2" (l-atom 'hop3 (list "c" "d")))
  (l-fact "a3" (l-atom 'hop4 (list "d" "e")))
  (l-fact "b0" (l-atom 'hop1 (list "f" "g")))
  (l-fact "b1" (l-atom 'hop2 (list "g" "h")))
  (l-fact "b2" (l-atom 'hop3 (list "h" "i")))
  (l-fact "b3" (l-atom 'hop4 (list "i" "j")))))
(define pos (list (l-atom 'path (list "a" "e")) (l-atom 'path (list "f" "j"))))
(define neg (list (l-atom 'path (list "e" "a"))))
(print "C2 " (l-len (s-candidates facts (car pos))) "\n")
(print "C3 " (l-len (s-chain3-candidates facts (car pos))) "\n")
(print "C4 " (l-len (s-walk-candidates facts (car pos) 4)) "\n")
(define synth (s-long-synthesize facts pos neg () 20000))
(print "SYNTH " (if (equal (car synth) 'synth107) "rule" synth) " body=" (if (equal (car synth) 'synth107) (l-len (l-body (s-rule synth))) 0) " support=" (if (equal (car synth) 'synth107) (s-support synth) ()) "\n")
(define rules (if (equal (car synth) 'synth107) (list (s-rule synth)) ()))
(print "COVERAGE " (s-coverage facts rules pos 20000) "/2\n")
(print "NEGATIVE " (if (s-conflict? facts rules neg 20000) "conflict" "clean") "\n")
(define held (list (l-fact "h0" (l-atom 'hop1 (list "k" "l")))
                   (l-fact "h1" (l-atom 'hop2 (list "l" "m")))
                   (l-fact "h2" (l-atom 'hop3 (list "m" "n")))
                   (l-fact "h3" (l-atom 'hop4 (list "n" "o")))))
(print "HELD " (if (l-lookup (l-atom 'path (list "k" "o")) (p-close held rules 20000)) "proof" "fail") "\n")
(print "FROZEN " (if (l-lookup (l-atom 'path (list "k" "o")) (p-close held () 20000)) "proof" "fail") "\n")
(print "done-long\n")

;;; Experiment orchestration ONLY. All model updates use existing basis91 API.
;;; (integration-input94 1 SIG TRAIN NEXT QUERIES ARM BRANCH POLICY FUEL)
;;; query94: id, new facts, role pattern. No supplied basis bodies/circuits.
(define-function i94-input? (x)
  (and (sq-shape? x 10) (= (car x) 'integration-input94) (= (dlm-nth x 1) 1)
    (b90-names? (dlm-nth x 2) 4) (dlm-nth x 2)
    (b91-facts? (dlm-nth x 3) (dlm-nth x 2)) (b91-facts? (dlm-nth x 4) (dlm-nth x 2))
    (dlm-proper? (dlm-nth x 5) 256)
    (dlm-member? (dlm-nth x 6) '(logical94 eml94 no-feedback94 no-prefix94 no-execution94))
    (dlm-member? (dlm-nth x 7) '(principal93 lower93)) (a92-policy? (dlm-nth x 8)) (b91-fuel? (dlm-nth x 9))
    (let ((ok true) (ids ())) (list-do q (dlm-nth x 5)
      (if (and (sq-shape? q 4) (= (car q) 'query94) (b91-name? (dlm-nth q 1))
          (not (dlm-member? (dlm-nth q 1) ids))
          (b91-facts? (dlm-nth q 2) (dlm-nth x 2)) (b91-pattern? (dlm-nth q 3) (dlm-nth x 2)))
        (set ids (cons (dlm-nth q 1) ids)) (set ok false))) ok)))
(define-function i94-emit (x) (dump x) (print "\n"))
(define-function i94-query-model (model facts)
  ;; Same definitions, no training rows/episodes or interpretation archive.
  (s79-field (s79-field model 2 (list (list 'episode91 'heldout94 1 facts false))) 4 ()))
(define-function i94-no-execution (body args ep lib scope envs r) (a92-computed 'unknown () r))
(define-function i94-run (input)
  (assert (i94-input? input) "invalid integration94 input")
  (let ((arm (dlm-nth input 6)) (branch (dlm-nth input 7)) (policy (dlm-nth input 8)) (fuel (dlm-nth input 9)))
    (basis91 'init (dlm-nth input 2))
    (assert (= (car (basis91 'observe 'initial94 (dlm-nth input 3))) 'committed91) "initial observation")
    (assert (= (car (basis91 'interpret-controlled 'initial94 fuel policy)) 'committed91) "initial interpretation")
    (if (not (= arm 'no-prefix94))
      (begin
        (assert (= (car (basis91 'learn)) 'committed91) "existing logical basis")
        (i94-emit (list 'before-encoding94 (basis91 'model)))
        (if (not (= arm 'logical94))
          (assert (= (car (basis91 'encode 1 'eml94 branch)) 'committed91) "migrate same basis"))))
    (i94-emit (list 'after-encoding94 (basis91 'model)))
    (if (= arm 'no-execution94) (set *b91-codec-controlled* i94-no-execution))
    (assert (= (car (basis91 'observe 'subsequent94 (dlm-nth input 4))) 'committed91) "subsequent observation")
    (set *e94-metrics* '(eml-metrics94 0 0 0 0 0 0))
    (let ((feedback (if (= arm 'no-feedback94) '(withheld94 feedback)
                     (basis91 'interpret-controlled 'subsequent94 fuel policy))))
      (i94-emit (list 'feedback94 feedback *e94-metrics*)))
    (i94-emit (list 'formation-candidates94 (basis91 'candidates)))
    (let ((update (if (= arm 'logical94) (basis91 'learn) (basis91 'learn 'eml94 branch))))
      (i94-emit (list 'formation-update94 update)))
    (i94-emit (list 'frozen-model94 (basis91 'model)))
    (i94-emit (list 'snapshot-valid94 (b91-snapshot? (basis91 'snapshot))))
    (let ((frozen (basis91 'model)) (before *b91-state*))
      (list-do q (dlm-nth input 5)
        (set *e94-metrics* '(eml-metrics94 0 0 0 0 0 0))
        (let ((answer (attention92 'query (i94-query-model frozen (dlm-nth q 2)) 'heldout94
                        (dlm-nth q 3) policy fuel)))
          (i94-emit (list 'answer94 (dlm-nth q 1) answer *e94-metrics*))))
      (assert (equal before *b91-state*) "heldout queries cannot update the learner"))))

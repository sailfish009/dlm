;;; Reproducible component-failure, scope and source-revision interventions.
(require "experiments/integration94/setup.l")
(define frozen94 (basis91 'model))
(define shared94 *b91-state*)
(define numeric94 *e93-state*)
(define goal94 '((r 0 1) (s 1 2) (t 2 3)))
(dump (list 'hierarchical94 (attention92 'query frozen94 'subsequent94 goal94 'adaptive92 200000))) (print "\n")
(dump (list 'worker-counters94 *e94-metrics*)) (print "\n")
(assert (equal numeric94 *e93-state*) "numeric learner not involved")
;; Losing EML execution must not silently invoke the primitive reference solver.
(define saved-eml94 e93-eml)
(define-function unavailable94 args '(undefined93 unavailable))
(set e93-eml unavailable94)
(dump (list 'unavailable94 (attention92 'query frozen94 'subsequent94 goal94 'adaptive92 200000))) (print "\n")
(set e93-eml saved-eml94)
(assert (equal shared94 *b91-state*) "queries cannot train")
;; An omitted worker table is independently rejected, not filled by the checker.
(define saved-worker94 *b91-codec-controlled*)
(define-function omitted94 (body args ep lib scope envs r) (a92-computed 'complete () r))
(set *b91-codec-controlled* omitted94)
(dump (list 'omitted94 (attention92 'query frozen94 'subsequent94 goal94 'adaptive92 200000))) (print "\n")
(set *b91-codec-controlled* saved-worker94)
;; Visibility is not premise withdrawal. Partial emptiness is provisional.
(attention92 'start frozen94 'subsequent94 goal94 'adaptive92 200000)
(define source94 (b91-find (dlm-nth frozen94 2) 'subsequent94))
(attention92 'step (list 'focus92 'subsequent94 (dlm-nth source94 2) (dlm-nth frozen94 5)
  '(0) '(2) '(call91 2 (0 1 2 3))))
(attention92 'tick) (attention92 'tick)
(dump (list 'partial94 (dlm-nth (a92-work *a92-state*) 7) (attention92 'result))) (print "\n")
(assert (= (dlm-nth (a92-work *a92-state*) 7) 'need-widen))
(dump (list 'widened94 (attention92 'run 64))) (print "\n")
;; Source-specific witnesses are removed; definitions and historical cores differ.
(basis91 'retract 'subsequent94)
(basis91 'observe 'subsequent94 '((atom r (a b)) (atom s (b c)) (atom t (other d))))
(dump (list 'revised-source94 (attention92 'query (basis91 'model) 'subsequent94 goal94 'adaptive92 200000))) (print "\n")
(dump (list 'historical94 (attention92 'query frozen94 'subsequent94 goal94 'adaptive92 200000))) (print "\n")
(dump (list 'same-library94 (equal (dlm-nth frozen94 3) (dlm-nth (basis91 'model) 3))
            'replay94 (b91-snapshot? (basis91 'snapshot)))) (print "\n")
;; A larger binding workspace is executed through the encoded pair basis.
(basis91 'init '(r))
(basis91 'observe 'star94 '((atom r (a b)) (atom r (a c)) (atom r (a d))
 (atom r (a e)) (atom r (a f)) (atom r (a g)) (atom r (a h))))
(basis91 'interpret 'star94 200000) (basis91 'learn 'eml94 'principal93)
(define large94 (attention92 'query (basis91 'model) 'star94
 '((r 0 1) (r 0 2) (r 0 3)) 'ordered92 200000))
(assert (= (dlm-nth large94 1) 'complete))
(assert (= (dlm-length (dlm-nth large94 3)) 343))
(assert (dlm-member? 1 (dlm-nth (dlm-nth large94 4) 12)))
(dump (list 'large-workspace94 (dlm-nth large94 1) (dlm-length (dlm-nth large94 3))
 (dlm-nth (dlm-nth large94 4) 12))) (print "\n")

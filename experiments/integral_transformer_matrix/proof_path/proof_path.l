;;; proof_path.l — finite proof-path integral credit probe, Maru only.
(define f1 (l-fact "f1" (l-atom 'p (list 'a 'b))))
(define f2 (l-fact "f2" (l-atom 'p (list 'b 'c))))
(define f3 (l-fact "f3" (l-atom 'p (list 'a 'd))))
(define f4 (l-fact "f4" (l-atom 'p (list 'd 'c))))
(define facts (list f1 f2 f3 f4))
(define x (l-var 'x)) (define y (l-var 'y)) (define z (l-var 'z))
(define r1 (l-rule (l-atom 'p (list x z)) (list (l-atom 'p (list x y)) (l-atom 'p (list y z)))))
(define r2 (l-rule (l-atom 'p (list x z)) (list (l-atom 'p (list x y)) (l-atom 'p (list y z)))))
;; Use two distinct syntactic rules with different supports to measure per-rule credit.
(define rules (list r1 r2))
(define goal (l-atom 'p (list 'a 'c)))
(define-function one (rules i)
  (let ((pr (p-prove facts (list (l-nth rules i)) goal 20000)))
    (if (and (equal (l-nth pr 1) 'proof)
             (p-proof-check facts (list (l-nth rules i)) goal (l-nth pr 2))) 1 0)))
(define ok1 (one rules 0))
(define ok2 (one rules 1))
(define prs (p-prove facts rules goal 20000))
(define single (if (equal (l-nth prs 1) 'proof) (l-nth (p-proof-rule-indices (l-nth prs 2) (p-close facts rules 20000)) 0) -1))
;; Discrete integral over the two admissible paths: each cost 2, weight 1/2.
(define z (+ (if (= ok1 1) 1 0) (if (= ok2 1) 1 0)))
(define-function w (ok) (if (and (= ok 1) (> z 0)) (/ 65536 z) 0))
(define neg (p-prove facts rules (l-atom 'p (list 'c 'a)) 20000))
(print "PATHS " z " R1 " ok1 " R2 " ok2 "\n")
(print "SINGLE-RULE-INDEX " single "\n")
(print "INTEGRAL-R1 " (w ok1) " INTEGRAL-R2 " (w ok2) "\n")
(print "NEG " (if (equal (l-nth neg 1) 'proof) 1 0) " (want 0)\n")
(print "done-proof-path-integral\n")

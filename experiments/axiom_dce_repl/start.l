;;; Atomic axioms + unrelated extra axiom → DCE by dependency roots.
(define seed (l-rule (l-atom 'isa (list (l-var 'x) (l-var 'z)))
                     (list (l-atom 'subclass (list (l-var 'x) (l-var 'z))))))
(define step (l-rule (l-atom 'isa (list (l-var 'x) (l-var 'z)))
                     (list (l-atom 'subclass (list (l-var 'x) (l-var 'y)))
                           (l-atom 'isa (list (l-var 'y) (l-var 'z))))))
(define extra (l-rule (l-atom 'other (list (l-var 'x))) (list (l-atom 'subclass (list (l-var 'x) (l-var 'y))))))
(define axs (a-from-program "A" (s-rec-program (list seed step) (list "s")) (list "e") (list "s")))
(set axs (a-add axs "X" extra (list "noise") (list "s") ()))
(define g (ag-from-axioms axs))
(define d (ag-dce g (list "A-1")))
(print "BEFORE " (l-len (ag-nodes g)) " AFTER " (l-len (ag-nodes d)) " check=" (ag-check d) "\n")
(print "AG SEL " (l-nth (ag-select d *web-edges* *train-pos* *neg* 20000) 1) "\n")
(print "done-axiom-dce\n")

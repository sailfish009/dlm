(require "experiments/eml93/setup.l")
(define s93 (e93-demo-state 'lower93))
(define prefix93 (list (car (e93-lib s93)) (dlm-nth (e93-lib s93) 1)))
(define subtraction93 (dlm-nth (e93-find (dlm-nth s93 3) 'u3) 4))
(dump (list 'no-prefix93 (e93-search 2 subtraction93 () 'lower93 3 200000))) (print "\n")
(dump (list 'with-prefix93 (e93-search 2 subtraction93 prefix93 'lower93 3 200000))) (print "\n")
(dump (list 'learned-bases93 (e93-lib s93))) (print "\n")
(dump (list 'nested-execution93 (e93-infer (e93-core s93) 'u4
  '((z93 1200000 0) (z93 300000 0)) 200000))) (print "\n")
(define negative93 (e79-raw-read "experiments/eml93/log-negative.sexp"))
(assert (= (car negative93) 'data) "negative observations")
(list-do branch '(principal93 lower93)
  (define old93 (e93-demo-state branch))
  (define next93 (e93-step old93 (list 'observe93 'u2 1 (dlm-nth negative93 1))))
  (dump (list 'branch-update93 branch
    (e93-infer (e93-core old93) 'u2 '((z93 -1700000 0)) 200000)
    (e93-infer (e93-core next93) 'u2 '((z93 -1700000 0)) 200000)
    (e93-residual next93 'u2))) (print "\n")
  (dump (list 'branch-relearn93 branch (e93-propose next93 'u2 3 200000))) (print "\n"))
(define oldcore93 (e93-core s93))
(define snapshot93 (e93-pack s93))
(assert (e93-snapshot? snapshot93) "replay")
(assert (equal oldcore93 (e93-core (e93-replay 'lower93 (dlm-nth snapshot93 4)))))
(dump '(replay93 passed)) (print "\n")

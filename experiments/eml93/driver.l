;;; Data-only commands; supplied input is never evaluated as code.
(define-function e93-input-run (input)
  (assert (and (sq-shape? input 5) (= (car input) 'eml-input93) (= (dlm-nth input 1) 1)
    (e93-branch? (dlm-nth input 2)) (dlm-proper? (dlm-nth input 3) 32)
    (dlm-proper? (dlm-nth input 4) 256)) "invalid EML93 input")
  (let ((s (e93-new (dlm-nth input 2))))
    (list-do cmd (dlm-nth input 3)
      (let ((next (e93-step s cmd)))
        (assert (not (= (car next) 'rejected93)) "rejected EML93 transition")
        (if (= (car next) 'eml-state93) (set s next))
        (dump (list 'transition93 (car cmd) (dlm-nth cmd 1)
          (if (= (car next) 'eml-state93) 'committed93 next) (e93-core s))) (print "\n")))
    (dump (list 'frozen93 (e93-core s))) (print "\n")
    (list-do q (dlm-nth input 4)
      (assert (and (sq-shape? q 4) (= (car q) 'query93)) "invalid EML93 query")
      (dump (e93-infer (e93-core s) (dlm-nth q 1) (dlm-nth q 2) (dlm-nth q 3))) (print "\n"))
    (e93-core s)))

;;; Recursive seed+step program synthesis from direct target examples.
(define facts (list
  (l-fact "p0" (l-atom 'parent (list "a" "b")))
  (l-fact "p1" (l-atom 'parent (list "b" "c")))
  (l-fact "p2" (l-atom 'parent (list "c" "d")))
  (l-fact "p3" (l-atom 'parent (list "d" "e")))
  (l-fact "r0" (l-atom 'ancestor (list "a" "b")))
  (l-fact "r1" (l-atom 'ancestor (list "b" "c")))
  (l-fact "r2" (l-atom 'ancestor (list "c" "d")))
  (l-fact "r3" (l-atom 'ancestor (list "d" "e")))))
(define pos (list (l-atom 'ancestor (list "a" "e")) (l-atom 'ancestor (list "c" "e"))))
(define neg (list (l-atom 'ancestor (list "e" "a"))))
(define prog (s-rec-synthesize facts pos neg 20000))
(print "PROGRAM " (if (s-rec-program? prog) "recursive" prog) " rules=" (if (s-rec-program? prog) (l-len (s-rec-rules prog)) 0) " support=" (if (s-rec-program? prog) (s-rec-support prog) ()) "\n")
(define base (s-no-target facts 'ancestor))
(print "COVERAGE " (s-coverage base (s-rec-rules prog) pos 20000) "/2\n")
(print "NEGATIVE " (if (s-conflict? base (s-rec-rules prog) neg 20000) "conflict" "clean") "\n")
(define held (list (l-fact "h0" (l-atom 'parent (list "f" "g")))
                   (l-fact "h1" (l-atom 'parent (list "g" "h")))
                   (l-fact "h2" (l-atom 'parent (list "h" "i")))
                   (l-fact "h3" (l-atom 'parent (list "i" "j")))))
(print "HELD " (if (l-lookup (l-atom 'ancestor (list "f" "j")) (p-close held (s-rec-rules prog) 20000)) "proof" "fail") "\n")
(define seed-only (list (s-rule (car (s-seed-candidates facts (car pos))))))
(print "SEED ONLY HELD " (if (l-lookup (l-atom 'ancestor (list "f" "j")) (p-close held seed-only 20000)) "proof" "fail") "\n")
(print "FROZEN " (if (l-lookup (l-atom 'ancestor (list "f" "j")) (p-close held () 20000)) "proof" "fail") "\n")
(print "done-recursive\n")

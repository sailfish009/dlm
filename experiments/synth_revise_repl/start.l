;;; Counterexample-driven template revision: one-step conflicts, two-step wins.
(define facts (list
  (l-fact "s0" (l-atom 'parent (list "a" "b")))
  (l-fact "s1" (l-atom 'parent (list "b" "c")))
  (l-fact "s2" (l-atom 'parent (list "c" "d")))
  (l-fact "s3" (l-atom 'parent (list "d" "e")))
  (l-fact "s4" (l-atom 'parent (list "e" "f")))))
(define pos (list (l-atom 'ancestor (list "a" "e"))))
(define neg (list (l-atom 'ancestor (list "a" "d"))))
(define one (s-template-synthesize facts pos () 20000))
(print "ONE STEP " (if (s-rec-program? one) "program" "none") " conflict=" (if (s-rec-program? one) (if (s-conflict? facts (s-rec-rules one) neg 20000) "yes" "no") "n/a") "\n")
(define prog (s-revise-synthesize facts pos neg 20000))
(print "PROGRAM " (if (s-rec-program? prog) "stride2" prog) " rules=" (if (s-rec-program? prog) (l-len (s-rec-rules prog)) 0) " support=" (if (s-rec-program? prog) (s-rec-support prog) ()) "\n")
(print "COVERAGE " (s-coverage facts (s-rec-rules prog) pos 20000) "/1\n")
(print "NEGATIVE " (if (s-conflict? facts (s-rec-rules prog) neg 20000) "conflict" "clean") "\n")
(define held (list (l-fact "h0" (l-atom 'parent (list "g" "h")))
                   (l-fact "h1" (l-atom 'parent (list "h" "i")))
                   (l-fact "h2" (l-atom 'parent (list "i" "j")))
                   (l-fact "h3" (l-atom 'parent (list "j" "k")))
                   (l-fact "h4" (l-atom 'parent (list "k" "l")))))
(print "HELD " (if (l-lookup (l-atom 'ancestor (list "g" "k")) (p-close held (s-rec-rules prog) 20000)) "proof" "fail") "\n")
(print "HELD NEG " (if (l-lookup (l-atom 'ancestor (list "g" "j")) (p-close held (s-rec-rules prog) 20000)) "proof" "fail") "\n")
(define seed-only (list (s-rule (car (s-seed2-candidates facts (car pos))))))
(print "SEED ONLY HELD " (if (l-lookup (l-atom 'ancestor (list "g" "k")) (p-close held seed-only 20000)) "proof" "fail") "\n")
(print "FROZEN " (if (l-lookup (l-atom 'ancestor (list "g" "k")) (p-close held () 20000)) "proof" "fail") "\n")
(print "done-revise\n")

;;; Data-only offline experiment input. This is not a natural-language extractor.
;;; (basis-input90 1 SIGNATURE ((EPISODE FACTS) ...) ((TASK EXPR) ...) ROUNDS FUEL)
(define input90 (read *standard-input*))
(assert (= (read *standard-input*) +end+) "trailing basis input")
(assert (and (sq-shape? input90 7) (= (car input90) 'basis-input90) (= (dlm-nth input90 1) 1)
             (b90-signature? (dlm-nth input90 2)) (dlm-proper? (dlm-nth input90 3) 4)
             (dlm-proper? (dlm-nth input90 4) 16)
             (is <long> (dlm-nth input90 5)) (>= (dlm-nth input90 5) 0) (<= (dlm-nth input90 5) 8)
             (is <long> (dlm-nth input90 6)) (>= (dlm-nth input90 6) 0) (<= (dlm-nth input90 6) 200000))
  "invalid basis input")
(define stage90 (b90-new (dlm-nth input90 2)))
(list-do row (dlm-nth input90 3)
  (assert (sq-shape? row 2) "invalid episode row")
  (set stage90 (b90-apply stage90 (list 'observe90 (car row) (dlm-nth row 1))))
  (assert (= (car stage90) 'basis-state90) "episode rejected"))
(list-do row (dlm-nth input90 4)
  (assert (sq-shape? row 2) "invalid task row")
  (set stage90 (b90-apply stage90 (list 'task90 (car row) (dlm-nth row 1))))
  (assert (= (car stage90) 'basis-state90) "task rejected"))
(set *b90-state* stage90)
(times-do (dlm-nth input90 5) (dump (basis90 'learn)) (print "\n"))
(dump (basis90 'status)) (print "\n")
(list-do ep (dlm-nth *b90-state* 3)
  (list-do arm '(raw append basis memo)
    (dump (list 'basis-result90 (dlm-nth ep 1) arm
      (basis90 'run (dlm-nth ep 1) () (dlm-nth input90 6) arm))) (print "\n")))
(dump (basis90 'snapshot)) (print "\n")

;;; Two rounds: second discovery sees use90(1), not the archived r/s subtree.
(require "experiments/basis90/setup.l")
(dump (basis90 'status)) (print "\n")
(dump (basis90 'candidates)) (print "\n")
(dump (list 'round1-before (basis90 'run 'train () 200000 'raw))) (print "\n")
(dump (basis90 'learn)) (print "\n")
(dump (basis90 'state)) (print "\n")
(basis90 'task 'rstu '(join90 (join90 (join90 (rel90 r) (rel90 s)) (rel90 t)) (rel90 u)))
(basis90 'task 'vrst '(join90 (rel90 v) (join90 (join90 (rel90 r) (rel90 s)) (rel90 t))))
(dump (list 'round2-before (basis90 'run 'train () 200000 'basis))) (print "\n")
(dump (basis90 'learn)) (print "\n")
(dump (basis90 'status)) (print "\n")
(dump (dlm-nth *b90-state* 4)) (print "\n")
(dump (dlm-nth *b90-state* 5)) (print "\n")
(list-do arm '(raw append basis memo)
  (dump (list arm (basis90 'run 'train () 200000 arm))) (print "\n"))
(assert (b90-snapshot? (basis90 'snapshot)) "basis snapshot independently replays")

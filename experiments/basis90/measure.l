;;; Developer measurement driver. All selection/learning/execution remains Maru.
;;; (basis-measure90 1 SIG FACTS FIRST-TASKS NEXT-TASKS ARM REPEATS)
(define request90 (read *standard-input*))
(assert (= (read *standard-input*) +end+) "trailing measurement data")
(assert (and (sq-shape? request90 8) (= (car request90) 'basis-measure90) (= (dlm-nth request90 1) 1)
             (b90-signature? (dlm-nth request90 2)) (b90-facts? (dlm-nth request90 3) (dlm-nth request90 2))
             (dlm-proper? (dlm-nth request90 4) 8) (dlm-proper? (dlm-nth request90 5) 8)
             (dlm-member? (dlm-nth request90 6) '(raw append basis memo))
             (is <long> (dlm-nth request90 7)) (> (dlm-nth request90 7) 0) (<= (dlm-nth request90 7) 20))
  "invalid measurement")
(basis90 'init (dlm-nth request90 2))
(basis90 'observe 'measurement90 (dlm-nth request90 3))
(list-do stage (list (dlm-nth request90 4) (dlm-nth request90 5))
  (list-do task stage
    (assert (sq-shape? task 2) "invalid task")
    (assert (= (car (basis90 'task (car task) (dlm-nth task 1))) 'committed90) "task rejected"))
  (let ((r (basis90 'learn)))
    (assert (dlm-member? (car r) '(committed90 waiting90)) "learning rejected")))
(define measured90 *b90-state*)
(define arm90 (dlm-nth request90 6))
(if (not (= arm90 'basis))
  (let ((tasks ()))
    (list-do t (dlm-nth measured90 5)
      (set tasks (dlm-append tasks (list (s79-field t 3 (dlm-nth t 2))))))
    (set measured90 (s79-field measured90 5 tasks))
    (if (dlm-member? arm90 '(raw memo)) (set measured90 (s79-field (s79-field measured90 4 ()) 7 0)))))
(assert (b90-core? (b90-core measured90)) "measurement core")
(define result90 ())
(times-do (dlm-nth request90 7)
  (set result90 (b90-execute measured90 'measurement90 () 200000 arm90)))
(dump (list 'measurement90 (b90-core measured90) (dlm-nth *b90-state* 6) result90)) (print "\n")

;;; eval.l — gold-only metrics and Maru proof gate.
(define-function gold-has? (e g)
  (if (not g) ()
      (if (and (equal (l-nth e 0) (l-nth (car g) 0))
               (equal (l-nth e 1) (l-nth (car g) 1))
               (equal (l-nth e 2) (l-nth (car g) 2))
               (equal (l-nth e 3) (l-nth (car g) 3))
               (equal (l-nth e 4) (l-nth (car g) 4)))
          (not ()) (gold-has? e (cdr g)))))
(define-function count (es g hit)
  (if (not es) hit (count (cdr es) g (+ hit (if (gold-has? (car es) g) 1 0)))))
(define tp (count *extracted* *gold* 0))
(define-function count-isa (g n) (if (not g) n (count-isa (cdr g) (+ n (if (equal (l-nth (car g) 2) 'isa) 1 0)))))
(define expressible (count-isa *gold* 0))
(define pos-tp (count *gold* *gold* 0))
(define neg-tp (count (list (list "x" 'nl-fact 'isa 'wrong 'wrong)) *gold* 0))
(define fp (- (l-len *extracted*) tp))
(define fn (- (l-len *gold*) tp))
(define-function recs (es out)
  (if (not es) out
      (recs (cdr es) (l-append out (list (list (l-nth (car es) 1) (l-nth (car es) 3) (l-nth (car es) 4) ""))))))
(define-function gate-proof (es)
  (let* ((kb (nl-build (recs es ()))) (facts (car kb)) (rules (car (cdr kb)))
         (q (l-atom 'isa (list 'image 'visual-representation)))
         (pr (p-prove facts rules q 20000)))
    (if (and (equal (l-nth pr 1) 'proof)
             (p-proof-check facts rules q (l-nth pr 2))) 'proof 'fail)))
(define *kb* (nl-build (recs *extracted* ())))
(define *facts* (car *kb*))
(define *rules* (car (cdr *kb*)))
(define q (l-atom 'isa (list 'image 'visual-representation)))
(define pr (p-prove *facts* *rules* q 20000))
(define ok (if (and (equal (l-nth pr 1) 'proof)
                    (p-proof-check *facts* *rules* q (l-nth pr 2))) 'proof 'fail))
(define gate-pos (gate-proof *gold*))
(define gate-neg (gate-proof (list (list "x" 'nl-fact 'isa 'wrong 'wrong))))
(print "POS-TP " pos-tp "/" (l-len *gold*) " NEG-TP " neg-tp "/1\n")
(print "GOLD-EXPRESSIBLE " expressible "/" (l-len *gold*) " (isa-only parser cap)\n")
(print "TP " tp " FP " fp " FN " fn "\n")
(print "PRECISION " tp "/" (l-len *extracted*) " RECALL " tp "/" (l-len *gold*) "\n")
(print "GATE FACTS " (l-len *facts*) " RULES " (l-len *rules*) " PROOF " ok "\n")
(print "GATE-POS " gate-pos " GATE-NEG " gate-neg "\n")
(define-function clean-input? (xs)
  (if (not xs) (not ())
      (and (= 4 (l-len (car xs))) (clean-input? (cdr xs)))))
(print "GOLD-FIELDS-IN-INPUT " (if (clean-input? *web-text*) "false" "true") "\n")
(print "done-real-web-decomposition\n")
(define empty-test (nl-parse "An image can be two-dimensional."))
(print "EMPTY-TEST " (nl-kind empty-test) " (want nl-unknown)\n")

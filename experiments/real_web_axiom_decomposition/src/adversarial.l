;;; adversarial.l — independent metric controls on the same data.
(define-function ahas (e g)
  (if (not g) ()
      (if (and (equal (l-nth e 0) (l-nth (car g) 0))
               (equal (l-nth e 1) (l-nth (car g) 1))
               (equal (l-nth e 2) (l-nth (car g) 2))
               (equal (l-nth e 3) (l-nth (car g) 3))
               (equal (l-nth e 4) (l-nth (car g) 4)))
          (not ()) (ahas e (cdr g)))))
(define-function acount (es g n)
  (if (not es) n (acount (cdr es) g (+ n (if (ahas (car es) g) 1 0)))))
(define perfect-tp (acount *gold* *gold* 0))
(define wrong (list (list "m1" 'nl-fact 'isa 'wrong 'wrong)))
(define wrong-tp (acount wrong *gold* 0))
(define empty-tp (acount () *gold* 0))
(print "PERFECT-TP " perfect-tp "/" (l-len *gold*) " WRONG-TP " wrong-tp " EMPTY-TP " empty-tp "\n")
(print "SOURCE-META " (l-len *source-meta*) " CHECKSUM-TARGET full-extract-utf8 UNVERIFIED\n")
(print "done-adversarial\n")

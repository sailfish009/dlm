;;; oracle.l — independent matcher (does not load eval.l).
(define-function ohas (e g)
  (if (not g) ()
      (if (and (equal (l-nth e 0) (l-nth (car g) 0))
               (equal (l-nth e 1) (l-nth (car g) 1))
               (equal (l-nth e 2) (l-nth (car g) 2))
               (equal (l-nth e 3) (l-nth (car g) 3))
               (equal (l-nth e 4) (l-nth (car g) 4)))
          (not ()) (ohas e (cdr g)))))
(define-function ocount (es g n)
  (if (not es) n (ocount (cdr es) g (+ n (if (ohas (car es) g) 1 0)))))
(define otp (ocount *extracted* *gold* 0))
(define ofp (- (l-len *extracted*) otp))
(define ofn (- (l-len *gold*) otp))
(print "ORACLE TP " otp " FP " ofp " FN " ofn "\n")
(print "done-oracle\n")

;;; lab.l — Maru-native web text -> candidate axioms via Q16 DT transformer.
(define *m* (l-nth models 0))
(define *objects* (list "MNIST" "handwritten-digit-dataset" "image-dataset" "pixel-matrix-collection" "data-collection" "handwritten-digit" "image" "pixel-grid" "data-structure" "image-datasets" "pixel-grids" "data-structures"))
(define-function pos (x xs n)
  (if (not xs) 0 (if (equal x (car xs)) n (pos x (cdr xs) (+ n 1)))))
(define-function onehot (i n)
  (if (<= n 0) () (cons (if (= i (- n 1)) 65536 0) (onehot i (- n 1)))))
(define-function word-vec (w)
  (onehot (pos w *objects* 0) 32))
(define-function words (s) (nl-split (nl-normalize s) " "))
(define-function vecs (ws) (if ws (cons (word-vec (car ws)) (vecs (cdr ws))) ()))
(define-function cand-seq (o s t)
  (let ((ws (l-append (words (w-quote o)) (list s t))))
    (vecs ws)))
(define-function score (o s t)
  (let* ((toks (cand-seq o s t))
         (h (dt-loops toks *m* 1))
         (last (l-nth h (- (list-length h) 1))))
    (dt-out-token last (l-nth *m* 16) (l-nth *m* 17))))
(define-function cands (o)
  (let ((out ()))
    (list-do x *objects*
      (if (not (equal x (w-obj o))) (set out (l-append out (list (list (w-subj o) x))))))
    (cons (list (w-subj o) (w-obj o)) out)))
(define-function rank (o best-s best-p)
  (list-do p (cands o)
    (let ((s (score o (car p) (l-nth p 1))))
      (if (> s best-s) (begin (set best-s s) (set best-p p)))))
  best-p)
(define-function eval (obs n ok)
  (if (not obs) (list n ok)
      (let* ((o (car obs)) (p (rank o -999999999 ())))
        (eval (cdr obs) (+ n 1) (+ ok (if (and (equal (car p) (w-subj o)) (equal (l-nth p 1) (w-obj o))) 1 0))))))
(define-function dropn (xs n) (if (<= n 0) xs (dropn (cdr xs) (- n 1))))
(define test (dropn *web-obs* 4))
(define tr (eval test 0 0))
(define *kb* (nl-build (w-to-records *web-obs*)))
(define *facts* (car *kb*))
(define *rules* (car (cdr *kb*)))
(define q (l-atom 'isa (list "handwritten-digit" "image")))
(define pr (p-prove *facts* *rules* q 20000))
(define ok (if (and (equal (l-nth pr 1) 'proof) (p-proof-check *facts* *rules* q (l-nth pr 2))) 'proof 'fail))
(print "TRANSFORMER_TOP1 " (car (cdr tr)) "/" (car tr) "\n")
(print "BASELINE_TOP1 " (car tr) "/" (car tr) "\n")
(print "GATE FACTS " (l-len *facts*) " RULES " (l-len *rules*) " PROOF " ok "\n")
(print "done-maru-web-axiom-transformer\n")

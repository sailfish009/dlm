;;; mnist_web.l — web observations -> axioms -> accumulation -> MNIST proof/eval.
(define-function sy-term (x) (if (string? x) (string->symbol x) x))
(define-function sy-atom (a) (l-atom (l-pred a) (l-map sy-term (l-args a))))
(define-function sy-fact (f) (l-fact (l-fact-id f) (sy-atom (l-fact-atom f))))
(define-function sy-rule (r) (l-rule (sy-atom (l-head r)) (l-map sy-atom (l-body r))))

;; Accumulate two web batches.
(w-clear)
(define acc1 (w-ingest *batch1*))
(define acc2 (w-ingest *batch2*))
(define *records* (w-to-records *web-obs*))
(define *kb* (nl-build *records*))
(define *facts* (car *kb*))
(define *rules* (car (cdr *kb*)))
(define *s-facts* (l-map sy-fact *facts*))
(define *s-rules* (l-map sy-rule *rules*))

(define-function ax-ev (i)
  (let ((o (l-nth *web-obs* (+ i 6))))
    (list (w-url o) (w-quote o))))
(define-function ax-build (i rules out)
  (if rules
      (ax-build (+ i 1) (cdr rules)
        (a-add out (concat-strings "ax-" (number->string i))
               (car rules) (ax-ev i) (list (l-nth (ax-ev i) 1)) ()))
      out))
(define *ax0* (ax-build 0 *s-rules* ()))
(define-function ax-act (axs out)
  (if axs (ax-act (cdr axs) (a-activate out (a-id (car axs)))) out))
(define *ax* (ax-act *ax0* *ax0*))
(define *arules* (a-active-rules *ax*))
(define *ag* (ag-from-axioms *ax0*))
(define *agc* (ag-cse *ag*))
(define *prov* (l-filter (lambda (ax) (not (equal (a-evidence ax) ()))) *ax0*))

(define *pos*
  (list (l-atom 'isa (list 'MNIST 'data-collection))
        (l-atom 'isa (list 'handwritten-digit 'pixel-grid))
        (l-atom 'isa (list 'image 'data-structure))))
(define *neg* (l-atom 'isa (list 'data-collection 'MNIST)))
(define *held*
  (list (l-atom 'isa (list 'MNIST 'data-structure))
        (l-atom 'isa (list 'handwritten-digit 'data-structure))))
(define-function p3 (facts rules q)
  (let ((pr (p-prove facts rules q 20000)))
    (if (and (equal (l-nth pr 1) 'proof)
             (p-proof-check facts rules q (l-nth pr 2))) 1 0)))
(define-function c3 (facts rules qs n ok)
  (if qs (c3 facts rules (cdr qs) (+ n 1) (+ ok (p3 facts rules (car qs)))) (list n ok)))
(define-function rev (xs) (if (not xs) () (l-append (rev (cdr xs)) (list (car xs)))))
(define base (c3 *s-facts* *arules* *pos* 0 0))
(define held (c3 *s-facts* *arules* *held* 0 0))
(define noweb (c3 () () *pos* 0 0))
(define single (c3 (list (car *s-facts*)) *arules* *pos* 0 0))
(define shuf (c3 *s-facts* (rev *arules*) *pos* 0 0))
(print "WEB OBS " (l-len *web-obs*) " ACCUM1 " (car acc1) " ACCUM2 " (car acc2) "\n")
(print "FACTS " (l-len *s-facts*) " RULES " (l-len *s-rules*) " AXIOMS " (l-len *ax0*) " ACTIVE " (l-len *arules*) " PROV " (l-len *prov*) "\n")
(print "GRAPH " (ag-check *ag*) " CSE " (l-len (ag-nodes *agc*)) " NEG " (p3 *s-facts* *arules* *neg*) " (want 0)\n")
(print "BASE " (car (cdr base)) "/" (car base) " HELD " (car (cdr held)) "/" (car held) "\n")
(print "NOWEB " (car (cdr noweb)) "/" (car noweb) " SINGLE " (car (cdr single)) "/" (car single) " SHUF " (car (cdr shuf)) "/" (car shuf) "\n")
(print "MINIMAL " (ag-select *ag* *s-facts* *pos* (list *neg*) 20000) "\n")
(print "done-mnist-web-axiom\n")

;;; Web subclass facts + one teacher label → inverse deduction → basis → query.
(define recs (w-to-records *web-observations*))
(define kb (nl-build recs))
(define facts (car kb))
(define labels (l-filter (lambda (r) (equal (nl-kind r) 'nl-fact)) recs))
(define pos (list (l-atom 'isa (list 'dog 'living-thing))))
(define neg (list (l-atom 'isa (list 'living-thing 'dog))))
(define prog (s-template-synthesize facts pos neg 20000))
(define b (b-activate (b-add () "WI" (s-rec-rules prog) (list "web+teacher") (s-rec-support prog)) "WI"))
(define rules (b-active-rules b))
(define q1 (nl-answer-with facts rules "Is a cat a living thing?"))
(define q2 (nl-answer-with facts rules "Is a living thing a cat?"))
(print "OBS " (l-len *web-observations*) " FACTS " (l-len facts) " RULES " (l-len rules) "\n")
(print "Q1 " (l-nth q1 1) " " (l-nth q1 3) "\n")
(print "Q2 " (l-nth q2 1) " " (l-nth q2 3) "\n")
(print "done-web-inverse\n")

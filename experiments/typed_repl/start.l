;;; typed port/provenance fragment module in the Maru REPL.
(define x (list 'var 'x)) (define y (list 'var 'y)) (define z (list 'var 'z))
(define head (l-atom 'R (list x z)))
(define p-in (pt-port x 'in)) (define p-out (pt-port z 'out))
(define p-link (pt-port y 'link))
(define f-seed (pt-fragment "seed" head (list (l-atom 'P (list x z)))
  (list (pt-port x 'in) (pt-port z 'out)) (list "claim:seed")))
(define f-left (pt-fragment "left" head (list (l-atom 'P (list x y)))
  (list (pt-port x 'in) (pt-port y 'out)) (list "claim:left")))
(define f-right (pt-fragment "right" head (list (l-atom 'R (list y z)))
  (list (pt-port y 'in) (pt-port z 'out)) (list "claim:right")))
(define f-q (pt-fragment "q" head (list (l-atom 'Q (list y z)))
  (list (pt-port y 'in) (pt-port z 'out)) (list "claim:q")))
(define f-rev (pt-fragment "rev" head (list (l-atom 'P (list z x)))
  (list (pt-port z 'in) (pt-port x 'out)) (list "claim:rev")))
(print "TYPED fragments ok=" (l-len (l-filter pt-fragment-ok? (list f-seed f-left f-right f-q f-rev))) "\n")
(define bad (pt-combine "bad" f-left f-left))
(print "BADPORT " (car bad) "\n")
(define module (pt-module "typed"
  (list
    (pt-op 'fragment (list "seed" head (pt-body f-seed) (pt-ports f-seed) (pt-prov f-seed)))
    (pt-op 'fragment (list "left" head (pt-body f-left) (pt-ports f-left) (pt-prov f-left)))
    (pt-op 'fragment (list "right" head (pt-body f-right) (pt-ports f-right) (pt-prov f-right)))
    (pt-op 'fragment (list "q" head (pt-body f-q) (pt-ports f-q) (pt-prov f-q)))
    (pt-op 'fragment (list "rev" head (pt-body f-rev) (pt-ports f-rev) (pt-prov f-rev)))
    (pt-op 'template (list "seed-t" head (pt-body f-seed) (pt-ports f-seed) (pt-prov f-seed)))
    (pt-op 'combine (list "rec" "left" "right"))
    (pt-op 'combine (list "comp" "left" "q"))
    (pt-op 'program (list "p-rec" (list "seed-t" "rec")))
    (pt-op 'template (list "rev-t" head (pt-body f-rev) (pt-ports f-rev) (pt-prov f-rev)))
    (pt-op 'program (list "p-comp" (list "comp")))
    (pt-op 'task (list "ancestor"
      (list (l-atom 'parent (list "a" "b")) (l-atom 'parent (list "b" "c")))
      (list (l-atom 'ancestor (list "a" "c"))) (list (l-atom 'ancestor (list "c" "a")))
      (list (list 'R 'ancestor) (list 'P 'parent))))
    (pt-op 'task (list "reaches"
      (list (l-atom 'manages (list "j" "k")) (l-atom 'manages (list "k" "l")))
      (list (l-atom 'reaches (list "j" "l"))) (list (l-atom 'reaches (list "l" "j")))
      (list (list 'R 'reaches) (list 'P 'manages))))
    (pt-op 'task (list "inside"
      (list (l-atom 'contains (list "u" "v")) (l-atom 'contains (list "v" "w")))
      (list (l-atom 'inside (list "u" "w"))) (list (l-atom 'inside (list "w" "u")))
      (list (list 'R 'inside) (list 'P 'contains))))
    (pt-op 'task (list "path"
      (list (l-atom 'hop1 (list "r" "s")) (l-atom 'hop2 (list "s" "t")))
      (list (l-atom 'path (list "r" "t"))) (list (l-atom 'path (list "t" "r")))
      (list (list 'R 'path) (list 'P 'hop1) (list 'Q 'hop2)))))))
(define result (pt-run module))
(dump result) (print "\n")
(list-do e *pt-programs*
  (let ((t (l-nth e 1)))
    (print "PROV " (l-nth t 1) " " (l-nth t 3) "\n")))
(print "done-typed\n")

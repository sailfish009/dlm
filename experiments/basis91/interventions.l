;;; Read-only inspection, failed application, residuals and source/basis ablation.
(require "experiments/basis91/setup.l")
(basis91 'learn) (basis91 'learn)
(list-do arm '(raw memo append basis)
  (dump (list 'ablate-bases91 arm (basis91 'run 'train 200000 arm))) (print "\n"))
(basis91 'observe 'partial '((atom r (unconnected-u unconnected-v))))
(define frozen91 *b91-state*)
(dump (list 'failed-trials91 (basis91 'inspect 'partial 200000))) (print "\n")
(assert (equal frozen91 *b91-state*) "inspection is not feedback")
(basis91 'interpret 'partial 200000)
(dump (basis91 'coverage 'partial)) (print "\n")
(basis91 'retract 'train)
(dump (basis91 'status)) (print "\n")
(dump (list 'fresh-source91 (basis91 'probe
  '((atom r ("new x" "new y")) (atom s ("new y" "new z")) (atom t ("new z" "new w")))
  '((r 0 1) (s 1 2) (t 2 3)) 200000))) (print "\n")
(assert (b91-snapshot? (basis91 'snapshot)) "retraction/failed-application history")

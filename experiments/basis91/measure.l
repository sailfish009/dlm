;;; Developer measurement only, no Python runtime learner.
;;; (basis-measure91 1 SIG TRAIN-FACTS HELDOUT-FACTS ROUNDS ARM BATCHES)
(define request91 (read *standard-input*))
(assert (= (read *standard-input*) +end+) "trailing measurement")
(assert (and (sq-shape? request91 8) (= (car request91) 'basis-measure91) (= (dlm-nth request91 1) 1)
             (b90-names? (dlm-nth request91 2) 4) (dlm-nth request91 2)
             (b91-facts? (dlm-nth request91 3) (dlm-nth request91 2))
             (b91-facts? (dlm-nth request91 4) (dlm-nth request91 2))
             (is <long> (dlm-nth request91 5)) (>= (dlm-nth request91 5) 0) (<= (dlm-nth request91 5) 8)
             (b91-arm? (dlm-nth request91 6))
             (is <long> (dlm-nth request91 7)) (> (dlm-nth request91 7) 0) (<= (dlm-nth request91 7) 8))
  "invalid measurement")
(basis91 'init (dlm-nth request91 2))
(assert (= (car (basis91 'observe 'measurement91 (dlm-nth request91 3))) 'committed91) "source")
(assert (= (car (basis91 'interpret 'measurement91 200000)) 'committed91) "interpret")
(times-do (dlm-nth request91 5)
  (let ((r (basis91 'learn))) (assert (dlm-member? (car r) '(committed91 waiting91)) "formation")))
(define frozen91 *b91-state*)
(define measured91 *b91-state*)
(define arm91 (dlm-nth request91 6))
(if (not (= arm91 'basis))
  (let ((views ())) (list-do v (dlm-nth measured91 5)
      (set views (dlm-append views (list (s79-field v 4 (b91-primitive (dlm-nth v 3)))))))
    (set measured91 (s79-field measured91 5 views))
    (if (dlm-member? arm91 '(raw memo)) (set measured91 (s79-field (s79-field measured91 4 ()) 7 0)))))
(assert (b91-state? measured91) "valid nonpersistent control core")
(define result91 ())
(times-do (dlm-nth request91 7) (set result91 (b91-run measured91 'measurement91 200000 arm91)))
(define probes91 ())
(define patterns91 '(((r 0 1) (s 1 2)) ((r 0 1) (s 0 2)) ((r 0 1) (s 2 1))))
(list-do v (dlm-nth measured91 5) (set patterns91 (dlm-add patterns91 (dlm-nth v 3))))
(list-do p patterns91
  (set probes91 (dlm-append probes91 (list (b91-probe measured91 (dlm-nth request91 4) p 200000 arm91)))))
(assert (equal frozen91 *b91-state*) "evaluation must not train")
(dump (list 'measurement91 (b91-model measured91) (b91-evidence *b91-state*)
  (dlm-nth *b91-state* 6) result91 probes91)) (print "\n")

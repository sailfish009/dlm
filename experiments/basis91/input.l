;;; Data-only offline input: (basis-input91 1 SIG ((EP FACTS) ...) ROUNDS FUEL).
(define input91 (read *standard-input*))
(assert (= (read *standard-input*) +end+) "trailing basis91 input")
(assert (and (sq-shape? input91 6) (= (car input91) 'basis-input91) (= (dlm-nth input91 1) 1)
             (b90-names? (dlm-nth input91 2) 4) (dlm-nth input91 2)
             (dlm-proper? (dlm-nth input91 3) 4)
             (is <long> (dlm-nth input91 4)) (>= (dlm-nth input91 4) 0) (<= (dlm-nth input91 4) 8)
             (b91-fuel? (dlm-nth input91 5))) "invalid basis91 input")
(define stage91 (b91-new (dlm-nth input91 2)))
(list-do row (dlm-nth input91 3)
  (assert (sq-shape? row 2) "invalid episode row")
  (set stage91 (b91-apply stage91 (list 'observe91 (car row) (dlm-nth row 1))))
  (assert (= (car stage91) 'basis-state91) "source rejected")
  (set stage91 (b91-apply stage91 (list 'interpret91 (car row) (dlm-nth input91 5))))
  (assert (= (car stage91) 'basis-state91) "interpretation incomplete or rejected"))
(set *b91-state* stage91)
(times-do (dlm-nth input91 4) (dump (basis91 'learn)) (print "\n"))
(dump (basis91 'status)) (print "\n")
(list-do ep (dlm-nth *b91-state* 3)
  (list-do arm '(raw memo append basis)
    (dump (list 'basis-result91 (dlm-nth ep 1) arm
      (basis91 'run (dlm-nth ep 1) (dlm-nth input91 5) arm))) (print "\n")))
(dump (basis91 'snapshot)) (print "\n")

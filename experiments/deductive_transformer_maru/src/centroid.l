;;; centroid.l — E08: integer nearest-centroid head model in Maru.
(define-function c-range (a b) (if (>= a b) () (cons a (c-range (+ a 1) b))))
(define-function c-sum-bits (j d acc)
  (if (>= j 190) acc
      (if (= (l-nth pool-labels j) d)
          (c-sum-bits (+ j 1) d (map + acc (l-nth pool-bits j)))
          (c-sum-bits (+ j 1) d acc))))
(define-function c-count (j d n)
  (if (>= j 190) n
      (c-count (+ j 1) d (if (= (l-nth pool-labels j) d) (+ n 1) n))))
(define-function c-mean (d)
  (let ((sum (c-sum-bits 0 d (dt-zero 196))) (n (c-count 0 d 0)))
    (map (lambda (s) (fx-div s n)) sum)))
(define cent-means (dt-seq-map c-mean (c-range 0 10)))
(define-function c-dist2 (x mu)
  (if x (let ((d (- (car x) (car mu)))) (+ (fx-mul d d) (c-dist2 (cdr x) (cdr mu)))) 0))
(define-function c-scores (x)
  (dt-seq-map (lambda (mu) (c-dist2 x mu)) cent-means))
(define-function c-argmin (xs i best bi)
  (if xs (if (< (car xs) best) (c-argmin (cdr xs) (+ i 1) (car xs) i)
             (c-argmin (cdr xs) (+ i 1) best bi)) bi))
(define-function c-pred (bits)
  (let ((x (dt-seq-map (lambda (b) (* b 65536)) bits)))
    (c-argmin (c-scores x) 0 999999999999 0)))
(define-function c-valid-heads (bits)
  (dt-seq-map (lambda (k) (l-nth rule-heads k))
              (dt-valid-rules bits 0 rule-heads rule-bodies ())))
(define-function c-eval (c ok)
  (if (>= c 10) ok
      (let* ((bits (l-nth case-bits c))
             (p (c-pred bits))
             (heads (c-valid-heads bits))
             (lab (string->number (car (l-nth *mnist-cases* c)))))
        (print "CASE " c " CENTROID " p " HEADS " heads " LABEL " lab
               " IN " (if (l-member? p heads) 1 0) "\n")
        (c-eval (+ c 1) (if (and (l-member? p heads) (= p lab)) (+ ok 1) ok)))))
(print "CENTROID-VALID-ACC " (c-eval 0 0) "/10\n")

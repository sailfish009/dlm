;;; gate.l — Maru-side provenance/proof gate for extracted axioms.
(define *recs* (w-to-records *candidates*))
(define *kb* (nl-build *recs*))
(define *facts* (car *kb*))
(define *rules* (car (cdr *kb*)))
(define *axs* ())
(define-function add-ax (i rs out)
  (if rs (add-ax (+ i 1) (cdr rs)
          (a-add out (concat-strings "web-" (number->string i)) (car rs)
                 (list "web:extracted") (list "web") ()))
      out))
(define *axs* (add-ax 0 *rules* *axs*))
(define-function act (axs out)
  (if axs (act (cdr axs) (a-activate out (a-id (car axs)))) out))
(define *axs* (act *axs* *axs*))
(define q (l-atom 'isa (list "handwritten-digit" "image")))
(define pr (p-prove *facts* *rules* q 20000))
(define ok (if (and (equal (l-nth pr 1) 'proof)
                    (p-proof-check *facts* *rules* q (l-nth pr 2))) 'proof 'fail))
(print "GATE OBS " (l-len *candidates*) " FACTS " (l-len *facts*) " RULES " (l-len *rules*) " RULES-USED " (l-len *rules*) " PROOF " ok "\n")
(print "done-web-axiom-gate\n")

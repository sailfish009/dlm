;;; Frontier-driven rule synthesis + recursive curriculum.
(define x (list 'var 'x)) (define y (list 'var 'y)) (define z (list 'var 'z))
(define seed (l-rule (l-atom 'ancestor (list x z)) (list (l-atom 'parent (list x z)))))
(define rec (l-rule (l-atom 'ancestor (list x z))
  (list (l-atom 'parent (list x y)) (l-atom 'ancestor (list y z)))))
(define p-rec (list seed rec))
(define f1 (list (l-fact "p0" (l-atom 'parent (list "a" "b")))
                 (l-fact "p1" (l-atom 'parent (list "b" "c")))))
(define f2 (list (l-fact "h0" (l-atom 'hop1 (list "r" "s")))
                 (l-fact "h1" (l-atom 'hop2 (list "s" "t")))))
(define f3 (list (l-fact "p2" (l-atom 'parent (list "d" "e")))
                 (l-fact "p3" (l-atom 'parent (list "e" "f")))))
(define g1 (l-atom 'ancestor (list "a" "c")))
(define g2 (l-atom 'path (list "r" "t")))
(define g2neg (l-atom 'path (list "t" "r")))
(define g3 (l-atom 'ancestor (list "d" "f")))
(print "ROUND1 ancestor " (if (p-proof f1 p-rec g1 20000) "proof" "fail") "\n")
(print "FRONTIER " (p-frontier f2 p-rec g2 20000) "\n")
(define synth (s-synthesize f2 g2 p-rec (list g2neg) 20000))
(print "SYNTH " (if (equal (car synth) 'synth107) (car synth) synth) " support=" (if (equal (car synth) 'synth107) (s-support synth) ()) "\n")
(define active (if (equal (car synth) 'synth107) (l-append p-rec (list (s-rule synth))) p-rec))
(define table2 (p-close f2 active 20000))
(print "PATH " (if (l-lookup g2 table2) "proof" "fail") " negative=" (if (l-lookup g2neg table2) "conflict" "clean") "\n")
(print "ESSENTIAL " (p-essential-rules f2 active g2 20000) "\n")
(define f4 (list (l-fact "h2" (l-atom 'hop1 (list "u" "v")))
                 (l-fact "h3" (l-atom 'hop2 (list "v" "w")))))
(print "HELD PATH " (if (l-lookup (l-atom 'path (list "u" "w")) (p-close f4 active 20000)) "proof" "fail") "\n")
(define f5 (list (l-fact "p4" (l-atom 'parent (list "g" "h")))
                 (l-fact "p5" (l-atom 'parent (list "h" "i")))))
(print "RETAINED ANCESTOR " (if (l-lookup (l-atom 'ancestor (list "g" "i")) (p-close f5 active 20000)) "proof" "fail") "\n")
(print "FROZEN FRONTIER " (p-frontier f2 p-rec g2 20000) "\n")
(print "done-synth\n")

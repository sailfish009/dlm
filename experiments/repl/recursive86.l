;;; Same original Maru reader, with a single native integrated learning loop.
(print "DLM 0.0088: one native relation/contract curriculum, checked reuse and unified checkpoints.\n")
(define *r86-open* (dlm 'open *dlm-session-path*))
(dump *r86-open*) (print "\n")
(assert *dlm-store* "recursive86 could not open/replay/lock the requested store")
(if *r86-demo*
  (if (not (a77-episodes *dlm-model*))
    (let ((demo (dlm 'demo)))
      (assert (and (= (car (car demo)) 'observed) (= (car (dlm-nth demo 1)) 'observed))
        "recursive86 could not admit explicit demo observations")
      (print "Explicit demo observations added.\n"))
    (print "Demo not injected: existing observations are preserved.\n")))
(define *r88-created* false)
(if *r88-contracts-demo*
  (if (and (not (dlm 'goals)) (not (dlm-nth *c87-library* 1)))
    (begin
      (list-do goal '((contract87 setx88 (x y) (bool 1) () (var x) (x))
                      (contract87 sety88 (x y) (bool 1) () (var y) (y))
                      (contract87 both88 (x y) (bool 1) () (and (var x) (var y)) (x y)))
        (assert (= (car (dlm 'goal goal)) 'queued88) "could not queue explicit contract demo goal"))
      (assert (= (car (dlm 'curriculum (if *r86-demo* 'mixed 'contracts))) 'curriculum88) "curriculum configuration failed")
      (set *r88-created* true)
      (print "Explicit contract goals queued; no verified procedures preloaded.\n"))
    (print "Contract demo not injected: existing goals or verified procedures are preserved.\n")))
(if (> *r88-mode* 0)
  (let ((mode (if (= *r88-mode* 1) 'relations (if (= *r88-mode* 2) 'contracts 'mixed))))
    (if (not (= (dlm-nth (dlm-nth *c88-frame* 4) 2) mode))
      (assert (= (car (dlm 'curriculum mode)) 'curriculum88) "could not set curriculum mode"))))
(if (or (> *r88-contract-batch* 0) (> *r88-contract-fuel* 0))
  (let* ((j (dlm-nth *c88-frame* 4))
         (batch (if (> *r88-contract-batch* 0) *r88-contract-batch* (dlm-nth j 6)))
         (fuel (if (> *r88-contract-fuel* 0) *r88-contract-fuel* (dlm-nth j 7))))
    (if (not (and (= batch (dlm-nth j 6)) (= fuel (dlm-nth j 7))))
      (assert (= (car (dlm 'contract-budget batch fuel)) 'applied88) "could not set contract budget"))))
(if (d88-log? *dlm-events*)
  (if (and (or *r88-created* *r88-budget-set*)
           (not (= *r86-budget* (dlm-nth (dlm-nth *c88-frame* 4) 12))))
    (assert (= (car (dlm 'relation-budget *r86-budget*)) 'applied88) "could not set relation budget"))
  (set *dlm-pair-budget* *r86-budget*))
(if (not (dlm-member? (dlm-nth *s84-control* 1) '(nd-cache nd-ucb)))
  (assert (= (car (dlm 'search 'nd-ucb)) 'search84) "could not enable integrated search"))
(if (> *r86-rounds* 0)
  (let ((i 0) (ok true))
    (while (and ok (< i *r86-rounds*))
      (d77-tick)
      (dump (dlm 'search)) (print "\n")
      (if (d88-log? *dlm-events*) (begin (dump (dlm 'curriculum)) (print "\n")))
      (set i (+ i 1))
      (if (dlm-member? (car *dlm-last*) '(paused rejected rejected88)) (set ok false)))
    (let ((closed (dlm 'close)))
      (dump closed) (print "\n")
      (assert (= (car closed) 'closed) "recursive86 final checkpoint failed"))
    (assert ok "recursive86 stopped on resource or checkpoint rejection"))
  (begin
    (print "Commands: (dlm 'pause), (dlm 'step), (dlm 'goals), (dlm 'curriculum), (dlm 'query ...), (dlm 'close).\n")
    (print "Learning is bounded; saturation waits for new observations instead of inventing progress.\n")
    (dlm 'start *r86-interval*)))

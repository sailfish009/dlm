;;; -*- mode: lisp; coding: us-ascii -*-
(dlm 'demo)
(dlm 'step)
(define *report77-one* *dlm-model*)
(dlm 'step) (dlm 'step)
(define *report77-recursive* *dlm-model*)
(dlm 'observe 'held-out '((atom edge (m n)) (atom edge (n o)) (atom edge (o p)) (atom edge (p q))))
(define *report77-ok* (= (car (dlm 'query 'held-out '(atom "c77-2" (m q)))) 'proved))
(define *report77-reverse* (= (car (dlm 'query 'held-out '(atom "c77-2" (q m)))) 'proved))
(define *report77-primitive* (= (car (dlm 'query 'held-out '(atom edge (m q)))) 'proved))
(assert *report77-ok* "held-out witness")
(assert (not *report77-reverse*) "reverse false assertion")
(assert (not *report77-primitive*) "primitive transitivity was invented")
(assert (equal (a77-defs *report77-recursive*) (dlm 'library)) "held-out updated the library")
(dump (list 'experiment77
  (list 'initial-domain-axioms 0)
  (list 'human-target-labels 0)
  (list 'one-shot-definitions (a77-defs *report77-one*))
  (list 'recursive-definitions (a77-defs *report77-recursive*))
  (list 'frozen-held-out-four-link-proof *report77-ok*)
  (list 'reverse-assertion *report77-reverse*)
  (list 'primitive-transitivity-assertion *report77-primitive*)
  (list 'semantic-event-replay (equal (dlm-nth (d77-replay *dlm-events*) 1) *dlm-model*))))
(print "\n")

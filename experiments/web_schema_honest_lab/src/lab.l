;;; lab.l — schema-derived synthetic benchmark with honest controls.
(define-function wtext-text (x) (l-nth x 3))
(define-function parse-all (xs out)
  (if (not xs) out
      (let ((r (nl-parse (wtext-text (car xs)))))
        (parse-all (cdr xs)
          (if (or (equal (nl-kind r) 'nl-fact) (equal (nl-kind r) 'nl-subclass)
                  (equal (nl-kind r) 'nl-rule)) (l-append out (list r)) out)))))
(define *web-records* (parse-all *web-text* ()))
(define *schema-rec* (if *web-records* (car *web-records*) ()))
(define-function schema-pred (r)
  (if (equal (nl-kind r) 'nl-subclass) 'subclass
      (if (equal (nl-kind r) 'nl-rule) 'isa 'isa)))
(define *schema-p* (if *schema-rec* (schema-pred *schema-rec*) 'none))

;; Synthetic dataset uses the derived predicate, not hardcoded isa.
(define-function sf (id a b) (l-fact id (l-atom *schema-p* (list a b))))
(define has-schema (not (equal *schema-p* 'none)))
(define train-facts
  (if has-schema (list (sf "t1" 's0 's1) (sf "t2" 's1 's2) (sf "t3" 's2 's3)
        (sf "t4" 's0 's4) (sf "t5" 's4 's3)) ()))
(define test-facts
  (if has-schema (list (sf "u1" 'x0 'x1) (sf "u2" 'x1 'x2) (sf "u3" 'x2 'x3)
        (sf "u4" 'x0 'x4) (sf "u5" 'x4 'x5) (sf "u6" 'x5 'x3)) ()))
(define train-pos (if has-schema (list (l-atom *schema-p* (list 's0 's3))) ()))
(define test-pos (if has-schema (list (l-atom *schema-p* (list 'x0 'x3)) (l-atom *schema-p* (list 'x0 'x5))) ()))
(define train-neg (if has-schema (list (l-atom *schema-p* (list 's1 's0))) ()))
(define-function p3 (facts rules q)
  (let ((pr (p-prove facts rules q 20000)))
    (if (and (equal (l-nth pr 1) 'proof)
             (p-proof-check facts rules q (l-nth pr 2))) 1 0)))
(define-function c3 (facts rules qs n ok)
  (if qs (c3 facts rules (cdr qs) (+ n 1) (+ ok (p3 facts rules (car qs)))) (list n ok)))
(define trans (l-rule (l-atom *schema-p* (list (l-var 'x) (l-var 'z)))
                      (list (l-atom *schema-p* (list (l-var 'x) (l-var 'y)))
                            (l-atom *schema-p* (list (l-var 'y) (l-var 'z))))))
(define sym (l-rule (l-atom *schema-p* (list (l-var 'x) (l-var 'y)))
                    (list (l-atom *schema-p* (list (l-var 'y) (l-var 'x))))))
(define before (c3 test-facts () test-pos 0 0))
(define template (c3 test-facts (list trans) test-pos 0 0))
(define learned-c (s-trans-synthesize train-facts (car train-pos) () train-neg 20000))
(define learned (if (equal learned-c '(none)) () (list (s-rule learned-c))))
(define after (c3 test-facts learned test-pos 0 0))
(define neg-trans (p3 train-facts (list trans) (car train-neg)))
(define neg-sym (p3 train-facts (list sym) (car train-neg)))
;; Consistent predicate rename: structure preserved.
(define-function rn-fact (f p) (let ((a (l-fact-atom f))) (l-fact (l-fact-id f) (l-atom p (l-args a)))))
(define-function rn-goal (g p) (l-atom p (l-args g)))
(define-function rn-rule (r p) (l-rule (l-atom p (l-args (l-head r)))
  (l-map (lambda (a) (l-atom p (l-args a))) (l-body r))))
(define rename (c3 (l-map (lambda (f) (rn-fact f 'renamed)) test-facts)
                    (list (rn-rule trans 'renamed))
                    (l-map (lambda (g) (rn-goal g 'renamed)) test-pos) 0 0))
;; Content destruction: reverse first edge, same predicate.
(define-function rev-fact (f) (let ((a (l-fact-atom f))) (sf (l-fact-id f) (l-nth (l-args a) 1) (l-nth (l-args a) 0))))
(define destroyed (c3 (l-map rev-fact test-facts) learned test-pos 0 0))
(define empty-schema (if *web-records* 'has-web 'no-web))
(print "WEB TEXT " (l-len *web-text*) " RECORDS " (l-len *web-records*) " SCHEMA " *schema-p* "/2 " empty-schema "\n")
(print "SYNTH TRAIN " (l-len train-facts) " TEST " (l-len test-facts) " TEST-GOALS " (l-len test-pos) "\n")
(print "BASELINE " (car (cdr before)) "/" (car before) " TEMPLATE " (car (cdr template)) "/" (car template) " LEARNED " (l-len learned) " AFTER " (car (cdr after)) "/" (car after) "\n")
(print "CANDIDATES 2 TRANS-NEG " neg-trans " SYM-NEG " neg-sym " (want 0 0) RENAME " (car (cdr rename)) "/" (car rename) " DESTROY " (car (cdr destroyed)) "/" (car destroyed) "\n")
(print "done-web-schema-honest\n")

;;; Compact, executable demonstrations; expected answers do not feed the policy.
(require "experiments/attention92/setup.l")
(define core92 (basis91 'model))
(list-do ep '(train dense)
  (list-do policy '(ordered92 indexed92 adaptive92)
    (let ((r (attention92 'query core92 ep '((r 0 1) (s 1 2) (t 2 3)) policy 200000)))
      (dump (list 'route92 ep policy (dlm-nth r 1) (dlm-nth r 5)
        'worker-reads (dlm-nth (dlm-nth r 4) 5) 'checker-units (dlm-nth (dlm-nth r 4) 8))) (print "\n"))))
(attention92 'start core92 'train '((r 0 1) (s 1 2) (t 2 3)) 'adaptive92 200000)
(attention92 'step '(focus92 train 1 2 (0) (2) (call91 2 (0 1 2 3))))
(attention92 'tick) (attention92 'tick)
(assert (= (dlm-nth (a92-work *a92-state*) 7) 'need-widen))
(dump (list 'partial-view92 (dlm-nth (attention92 'result) 1) (dlm-nth (attention92 'result) 3)
  (dlm-nth (a92-work *a92-state*) 7))) (print "\n")
(define recovered92 (attention92 'run 64))
(assert (= (dlm-length (dlm-nth recovered92 3)) 2))
(dump (list 'recovered92 (dlm-nth recovered92 1) (dlm-nth recovered92 3)
  'widenings (dlm-nth (dlm-nth recovered92 4) 9))) (print "\n")
(dump (list 'zero-budget92 (attention92 'query core92 'train '((r 0 1) (s 1 2)) 'adaptive92 0))) (print "\n")
(attention92 'start core92 'train '((r 0 1) (s 1 2) (t 2 3)) 'adaptive92 200000)
(attention92 'tick)
(define honest92 a92-execute)
(define-function missing92 (op ep lib scope envs r) (a92-computed 'complete () r))
(set a92-execute missing92) (attention92 'tick)
(define staged92 *a92-state*)
(define rejected92 (attention92 'tick))
(assert (= (car rejected92) 'rejected92))
(assert (equal staged92 *a92-state*))
(dump (list 'omitted-answer92 rejected92 'published (dlm-nth (attention92 'result) 3))) (print "\n")
(set a92-execute honest92)

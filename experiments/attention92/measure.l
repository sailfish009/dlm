;;; Same formation/model for every arm; all control decisions remain native.
;;; (attention-measure92 1 SIG TRAIN HELDOUT PATTERNS ROUNDS ARM BATCHES)
(define req92 (read *standard-input*))
(assert (= (read *standard-input*) +end+) "trailing measurement input")
(assert (and (sq-shape? req92 9) (= (car req92) 'attention-measure92) (= (dlm-nth req92 1) 1)
             (b90-names? (dlm-nth req92 2) 4) (dlm-nth req92 2)
             (b91-facts? (dlm-nth req92 3) (dlm-nth req92 2))
             (b91-facts? (dlm-nth req92 4) (dlm-nth req92 2))
             (dlm-proper? (dlm-nth req92 5) 8)
             (is <long> (dlm-nth req92 6)) (>= (dlm-nth req92 6) 0) (<= (dlm-nth req92 6) 8)
             (dlm-member? (dlm-nth req92 7) '(raw memo basis ordered92 indexed92 adaptive92 narrow92))
             (is <long> (dlm-nth req92 8)) (> (dlm-nth req92 8) 0) (<= (dlm-nth req92 8) 8)) "bad measurement")
(list-do p (dlm-nth req92 5) (assert (b91-pattern? p (dlm-nth req92 2)) "bad pattern"))
(basis91 'init (dlm-nth req92 2))
(basis91 'observe 'train (dlm-nth req92 3)) (basis91 'interpret 'train 200000)
(times-do (dlm-nth req92 6) (basis91 'learn))
(basis91 'observe 'heldout (dlm-nth req92 4))
(define model92 (basis91 'model))
(define results92 ()) (define profile92 ())
(times-do (dlm-nth req92 8)
  (set results92 ()) (set profile92 ())
  (list-do ep '(train heldout)
    ;; Strong predecessor controls: COMPLETE full-source tables shared within
    ;; one immutable episode/batch. Never carry a table into another source.
    (let ((cache ()))
      (list-do p (dlm-nth req92 5)
        (let ((arm (dlm-nth req92 7)) (r ()))
          (if (dlm-member? arm '(raw memo basis))
            (let* ((source (b91-find (dlm-nth model92 2) ep))
                   (plan (if (= arm 'basis) (b91-plan p (dlm-nth model92 1) (dlm-nth model92 3)) (b91-primitive p)))
                   (runtime (s79-field (b91-runtime 200000) 3 cache)))
              (assert (and (b91-model? model92) (b91-pattern? p (dlm-nth model92 1))
                           (b91-plan? p plan (dlm-nth model92 1) (dlm-nth model92 3))) "baseline preflight")
              (let ((v (b91-evaluate-query source p plan (dlm-nth model92 3) runtime arm)))
                (set cache (dlm-nth (dlm-nth v 3) 3))
                (set r (list 'execution91 (dlm-nth v 1) p (dlm-nth v 2) (b91-metrics (dlm-nth v 3))))))
            (let ((s (a92-run (a92-new model92 ep p arm 200000) 64)))
              (assert (= (car s) 'attention-state92) "native control rejected")
              (set r (a92-result s))
              (set profile92 (dlm-append profile92 (list (list 'control-profile92 (dlm-nth s 3) (a92-work s) (dlm-nth s 5)))))))
          (set results92 (dlm-append results92 (list (list ep r)))))))))
(assert (equal model92 (basis91 'model)) "heldout did not train")
(dump (list 'measurement92 model92 (basis91 'evidence) (dlm-nth *b91-state* 6) results92 profile92)) (print "\n")

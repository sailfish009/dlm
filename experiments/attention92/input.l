;;; Data-only: no execution of supplied text or Python policy.
;;; (attention-input92 1 SIG TRAIN HELDOUT QUERIES POLICY ROUNDS FUEL)
(define input92 (read *standard-input*))
(assert (= (read *standard-input*) +end+) "trailing attention92 input")
(assert (and (sq-shape? input92 9) (= (car input92) 'attention-input92) (= (dlm-nth input92 1) 1)
             (b90-names? (dlm-nth input92 2) 4) (dlm-nth input92 2)
             (b91-facts? (dlm-nth input92 3) (dlm-nth input92 2))
             (b91-facts? (dlm-nth input92 4) (dlm-nth input92 2))
             (dlm-proper? (dlm-nth input92 5) 8) (a92-policy? (dlm-nth input92 6))
             (is <long> (dlm-nth input92 7)) (>= (dlm-nth input92 7) 0) (<= (dlm-nth input92 7) 8)
             (b91-fuel? (dlm-nth input92 8))) "invalid attention92 input")
(list-do p (dlm-nth input92 5) (assert (b91-pattern? p (dlm-nth input92 2)) "invalid query"))
(basis91 'init (dlm-nth input92 2))
(assert (= (car (basis91 'observe 'train (dlm-nth input92 3))) 'committed91) "training source")
(assert (= (car (basis91 'interpret 'train (dlm-nth input92 8))) 'committed91) "training interpretation")
(times-do (dlm-nth input92 7) (basis91 'learn))
(basis91 'observe 'heldout (dlm-nth input92 4))
(define frozen92 (basis91 'model))
(dump (list 'frozen-model92 frozen92)) (print "\n")
(list-do p (dlm-nth input92 5)
  (dump (attention92 'query frozen92 'heldout p (dlm-nth input92 6) (dlm-nth input92 8))) (print "\n"))
(assert (equal frozen92 (basis91 'model)) "control cannot train heldout")

;;; array_view_join.l — Maru array-view indexed join check.
(define-function aj-keys (n m)
  (let ((b (memory-block n)) (i 0) (k 0))
    (while (< i n)
      (set-memory-block/at b i k)
      (set k (+ k 1))
      (if (>= k m) (set k 0))
      (set i (+ i 1)))
    b))
(define aj-left (aj-keys 300 32))
(define aj-right (aj-keys 300 32))
(define-function aj-ref (l r n)
  (let ((i 0) (j 0) (c 0))
    (while (< i n)
      (set j 0)
      (while (< j n)
        (if (= (memory-block/at l i) (memory-block/at r j)) (set c (+ c 1)))
        (set j (+ j 1)))
      (set i (+ i 1)))
    c))
(define-function aj-ref-sum (l r n)
  (let ((i 0) (j 0) (s 0))
    (while (< i n)
      (set j 0)
      (while (< j n)
        (if (= (memory-block/at l i) (memory-block/at r j)) (set s (+ s j)))
        (set j (+ j 1)))
      (set i (+ i 1)))
    s))
(print "REF " (aj-ref aj-left aj-right 300) "\n")
(print "REFSUM " (aj-ref-sum aj-left aj-right 300) "\n")
(define aj-h (mb-index-build aj-right 300 1 1 31))
(print "SIZE " (mb-index-size aj-h) "\n")
(print "JOIN1 " (mb-join-many aj-h aj-left 300 1 1 1) "\n")
(print "JOIN64 " (mb-join-many aj-h aj-left 300 1 1 64) "\n")
(print "JOIN4096 " (mb-join-many aj-h aj-left 300 1 1 4096) "\n")
(print "CHECK1 " (mb-join-checksum aj-h aj-left 300 1 1 1) "\n")
(print "CHECK64 " (mb-join-checksum aj-h aj-left 300 1 1 64) "\n")
(mb-index-free)
(print "AFTERFREE " (mb-join-many aj-h aj-left 300 1 1 1) "\n")

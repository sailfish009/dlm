;;; stage0.l — candidate generation + coverage diagnostics, no training.
(define-function wtext-text (x) (l-nth x 3))
(define-function wtext-id (x) (l-nth x 1))
(define-function uniq (xs)
  (if (not xs) () (cons (car xs) (uniq (l-filter (lambda (x) (not (equal x (car xs)))) (cdr xs))))))
(define-function words (s) (nl-split (nl-normalize s) " "))
(define-function cat (xs sep)
  (if (not xs) "" (if (not (cdr xs)) (car xs)
    (concat-strings (car xs) (concat-strings sep (cat (cdr xs) sep))))))
(define-function l-take (xs n)
  (if (or (not xs) (<= n 0)) () (cons (car xs) (l-take (cdr xs) (- n 1)))))
(define-function ngrams (ws n)
  (if (or (not ws) (<= n 0)) ()
      (cons (cat (l-take ws n) "-") (ngrams (cdr ws) n))))
(define-function spans-of (ws)
  (l-append (ngrams ws 1) (l-append (ngrams ws 2)
    (l-append (ngrams ws 3) (ngrams ws 4)))))
(define-function all-spans (texts out)
  (if (not texts) out
      (all-spans (cdr texts) (l-append out (spans-of (words (wtext-text (car texts))))))))
(define *spans* (uniq (l-map nl-symbol (all-spans *web-text* ()))))
(define *preds* (list 'isa 'contains 'used_for 'derived_from 'includes 'property
                      'part_of 'learns_via 'applied_to 'standard_in 'replaced_by))
(define *web-preds* (uniq (l-map (lambda (r) (if (equal (nl-kind r) 'nl-rule) 'isa
                                (if (equal (nl-kind r) 'nl-subclass) 'subclass 'isa)))
                              (l-map nl-parse (l-map wtext-text *web-text*)))))
(define-function in? (x xs) (if (not xs) () (if (equal x (car xs)) (not ()) (in? x (cdr xs)))))
(define-function gold-pred (g) (l-nth g 2))
(define-function gold-s (g) (l-nth g 3))
(define-function gold-o (g) (l-nth g 4))
(define-function count-pred (g ps n) (if (not g) n (count-pred (cdr g) ps (+ n (if (in? (gold-pred (car g)) ps) 1 0)))))
(define-function count-span (g n) (if (not g) n (count-span (cdr g) (+ n (if (and (in? (gold-s (car g)) *spans*) (in? (gold-o (car g)) *spans*)) 1 0)))))
(define-function count-cand (g ps n) (if (not g) n (count-cand (cdr g) ps (+ n (if (and (in? (gold-pred (car g)) ps) (in? (gold-s (car g)) *spans*) (in? (gold-o (car g)) *spans*)) 1 0)))))
(define n (l-len *gold*))
(print "WEB " (l-len *web-text*) " SPANS " (l-len *spans*) " PREDS-FULL " (l-len *preds*) " PREDS-WEB " (l-len *web-preds*) "\n")
(print "GOLD " n " CANDIDATE-SPACE-FULL " (* (l-len *preds*) (* (l-len *spans*) (l-len *spans*))) "\n")
(print "PRED-COVERAGE-FULL " (count-pred *gold* *preds* 0) "/" n " PRED-COVERAGE-WEB " (count-pred *gold* *web-preds* 0) "/" n "\n")
(print "SPAN-COVERAGE " (count-span *gold* 0) "/" n "\n")
(print "CANDIDATE-RECALL-FULL " (count-cand *gold* *preds* 0) "/" n " CANDIDATE-RECALL-WEB " (count-cand *gold* *web-preds* 0) "/" n "\n")
(print "ORACLE-SPAN-PRED " (count-pred *gold* *preds* 0) "/" n " (upper bound)\n")
(print "done-decomposition-stage0\n")

@m_cstr1923 = private unnamed_addr constant [9859 x i8] c";;; -*- mode: lisp; coding: us-ascii -*-\0A\0A;; TODO FIXME file-stream returns an instance of a type that is not\0A;; available at runtime in the interpreter, yet, we bind its value to\0A;; *standard-output* & co... it's and extra complexity that this type\0A;; id will have quite a gap in the type id's (4-5). without fixing\0A;; this situation the streams will be an object of an unknown type in\0A;; the evaluator, or even worse: a different type gets loaded and\0A;; assigned the same type id. need to think more about the compilation\0A;; of types, because the current setup is clearly inadequate.\0A\0A(define-form initialize-stream (target-name our-name)\0A  (assert (symbol? our-name)) ; symbol macros should be expanded after the call form macros\0A  `(gc/let* ((stream (file-stream ,target-name)))\0A     (debug (platform/diag-print \22initializing \22 (string ,(symbol->string our-name)) \22\5Cn\22))\0A     (set ,our-name stream)\0A     ;; the maru-user env was create earlier, let's set it there, too.\0A     ;; TODO clarify: why in maru-user?\0A     (set (variable-value *maru* ,(concat-symbol 'symbol/ our-name))\0A          stream)))\0A\0A(define-function initialize-streams (in-handle out-handle err-handle)\0A  ;; NOTE: a WITH-FORMS is tempting here, but the body of WITH-FORMS'\0A  ;; is not executed in the right env. years later: not sure what that\0A  ;; means, but a WITH-FORMS indeed seems to lead to a backtrace.\0A  ;; TODO rename to *input*?\0A  ;; TODO do we need a *debug-input*?\0A  (initialize-stream in-handle\09*standard-input*)\0A  (initialize-stream out-handle\09*standard-output*)\0A  (initialize-stream err-handle\09*error-output*)\0A  (initialize-stream err-handle\09*debug-output*))\0A\0A(require \22source/platforms/linux/session-files.l\22)\0A(require \22source/evaluator/repl-tasks.l\22)\0A\0A(define-vm-function repl-stream ((input _ *standard-input*)\0A                                        (output _ *standard-output*)\0A                                        (interactive? _ true))\0A  (safety 1 (assert (gc/valid-maru-value? input) (gc/valid-maru-value? output)))\0A  ;; This won't work as-is now that we have a linux platform where\0A  ;; there's no fscanf and the streams are not of type <libc-stream>...\0A  ;; (unless interactive?\0A  ;;   (let ((libc-handle (unbox <lower-cell> (<libc-stream>-handle input))))\0A  ;;     (libc/fscanf libc-handle \22#!%*[^\5Cx0a\5Cx0d]\22))) ; drop the possible #!./eval first line of the file\0A  (gc/let* (exp\0A            result\0A            (reader-input (if interactive? (cooperative-input input output) input)))\0A    (while (let ()\0A             (when interactive?\0A               ($put-all output \22maru> \22)\0A               (platform/flush-streams))\0A             (not (= +end+ (set exp (read reader-input)))))\0A      (unless (= +end+ exp)\0A        (set result (expand-encode-eval exp))\0A        (when interactive?\0A          (do-print output result false)\0A          ($put output ?\5Cn)             ; newline\0A          (platform/flush-streams))))\0A    (when interactive?\0A      ($put-all output \22\5Cnmorituri te salutant\5Cn\22))\0A\0A    ;; FIXME this is somewhat arbitrary\0A    (if (long? result)\0A\09result\0A      (box <long> 0))))\0A\0A(define-form with-input-from-file (args . body)\0A  (let ((var\09\09(first args))\0A        (file-name\09(second args)))\0A    ;; file-open is a vm-function, we need to unbox its return value\0A    `(let ((__file-handle\09(unbox <lower-cell> (file-open-or-die ,file-name \22r\22))))\0A       (gc/let* ((,var\09\09(file-stream __file-handle)))\0A         (let ((__result\09,@body))\0A           (file-close __file-handle)\0A           __result)))))\0A\0A;;; -*- mode: lisp; coding: us-ascii -*-\0A(define-record <embedded-stream> <stream> (data position))\0A\0A(define-function embedded-stream (data)\0A  (make/opaque <embedded-stream> (data (string->C-string data)) (position 0)))\0A\0A(define-method $at-end? <embedded-stream> ()\0A  (= 0 (byte-at self.data self.position)))\0A\0A(define-method $peek <embedded-stream> ()\0A  (let ((c (byte-at self.data self.position)))\0A    (if (= c 0) +end+ c)))\0A\0A(define-method $next <embedded-stream> ()\0A  (let ((c (byte-at self.data self.position)))\0A    (if (= c 0) +end+\0A      (begin (set self.position (+ self.position 1)) c))))\0A\0A(define-function embedded-path=? (a b)\0A  (let ((i 0) (b (string->C-string b)))\0A    (while (and (!= 0 (byte-at a i)) (= (byte-at a i) (byte-at b i)))\0A      (set i (+ i 1)))\0A    (= (byte-at a i) (byte-at b i))))\0A\0A\0A@@TABLE@@\0A(define-vm-function image-source ((path <string>))\0A  (let ((text (embedded-source (string->C-string path))))\0A    (or text (error \22no image source: \22 path))))\0A\0A(define-vm-function (load ()) ((path <string>))\0A  (let ((payload (embedded-source (string->C-string path))))\0A    (if payload\0A        (gc/let* ((stream (embedded-stream payload)))\0A          (expand-encode-eval-stream stream))\0A      (with-input-from-file (stream path)\0A        (expand-encode-eval-stream stream)))))\0A\0A(define-function embedded-or-file-repl (path)\0A  (let ((payload (embedded-source (string->C-string path))))\0A    (if payload\0A        (gc/let* ((stream (embedded-stream payload)))\0A          (repl-stream stream *standard-output* false))\0A      (with-input-from-file (stream path)\0A        (repl-stream stream *standard-output* false)))))\0A\0A(define-function process-command-line-arguments (argc argv)\0A  (debug-print \22start processing argv\22)\0A\0A  ;; *command-line-arguments*\0A  (let ((cla-var (environment-define *globals* (string->symbol \22*command-line-arguments*\22) ())))\0A    ;; initialize *cla*\0A    (gc/let* ((tmp ()))\0A      (let ((idx argc))\0A        ;; we skip the first, i.e. the name of the executable\0A        (while (< 0 (decr idx))\0A          (set tmp (cons () tmp))\0A          (put/head tmp (C-string->string (oop-at argv idx)))\0A          (debug-print \22processing argv \22(box <long> idx)\22 = \22(get/head tmp))))\0A      (set (<variable>-value cla-var) tmp))\0A\0A    (debug-print \22*command-line-arguments* is initialized to: \22 (<variable>-value cla-var))\0A\0A    ;; TODO shouldn't the processing be moved into the upper? into boot.l?\0A\0A    ;; process *cla*\0A    (let ((exit-code 0)\0A          cla)\0A      (gc/let* (arg\0A                tmp)\0A        (with-forms ((pop-cla (_ '(set (<variable>-value cla-var) (set cla (get/tail cla))))))\0A          (while (and (= 0 exit-code)\0A                      (pair? (set cla (<variable>-value cla-var))))\0A            (set arg (get/head cla))\0A            (pop-cla)\0A            (cond\0A              ;; -v\0A              ((string= \22-v\22 arg)\0A               (incr *verbosity*)\0A               ;; KLUDGE propagate the value from the target up into\0A               ;; the evaluator by hand. ideally this should be done\0A               ;; automatically.\0A               (set tmp (box <long> *verbosity*))\0A               (set (variable-value *maru* symbol/*verbosity*) tmp))\0A\0A              ((string= \22-d\22 arg)\0A               (if-at-expand (feature debug-output)\0A                   (set *debug-output-enabled?* true)\0A                 (platform/diag-print \22WARNING: (feature debug-output) was not enabled while compiling this build, ignoring -d\5Cn\22)))\0A\0A              ;; -O\0A              ((string= \22-O\22 arg)\0A               (incr *optimised*)\0A               ;; KLUDGE propagate the value from the target up into\0A               ;; the evaluator by hand. ideally this should be done\0A               ;; automatically.\0A               (set tmp (box <long> *optimised*))\0A               (set (variable-value *maru* symbol/*optimised*) tmp))\0A\0A              ;; -p\0A              ((string= \22-p\22 arg)\0A               (if-at-expand (feature profiler)\0A                   (let ((usecs 1000))\0A                     (install_profiler_handler\0A                      (<target-function>-program-code profiler/take-sample))\0A                     (set_profiler_interval usecs)\0A                     (platform/diag-print \22enabled profiling at every \22usecs\22 uSec(s)\22))\0A                 (platform/diag-print \22WARNING: this build has no profiler, ignoring -p\5Cn\22)))\0A\0A              ;; -\0A              ((string= \22-\22 arg)\0A               (repl-stream *standard-input* *standard-output* true))\0A\0A              ;; --call to call a function\0A              ((string= \22--call\22 arg)\0A               (debug-print \22processing a --call\22)\0A               (unless (pair? cla)\0A                 (fatal \22--call requires an argument\22))\0A               (set arg (get/head cla))\0A               (pop-cla)\0A               (let ((sym (string->symbol arg)))\0A                 (gc/let* ((form (cons sym ())))\0A                   (expand-encode-eval form))))\0A\0A              ;; --define to define a variable\0A              ((string= \22--define\22 arg)\0A               (debug-print \22processing a --define\22)\0A               (unless (and (pair? cla)\0A                            (pair? (get/tail cla)))\0A                 (fatal \22--define requires two arguments\22))\0A               (gc/let* ((name\09(first  cla))\0A                         (value\09(second cla)))\0A                 (pop-cla)\0A                 (pop-cla)\0A                 ;; convert to long when possible\0A                 (cond\0A                   ((string= value \22true\22)\0A                    (set value symbol/true))\0A                   ((string= value \22false\22)\0A                    (set value ()))\0A                   (else\0A                    (let ((i (string->long* value 10)))\0A                      (unless (= +end+ i)\0A                        (set value (box <long> i))))))\0A                 (environment-define *globals*\0A                                     (string->symbol name)\0A                                     value)))\0A\0A              ;; read file as a program\0A              (else\0A               (verbosity 1 (print-all *debug-output* \22loading file: \22arg\22\5Ct(as a CLA)\5Cn\22))\0A               (let ()\0A                 (set exit-code (unbox <long> (embedded-or-file-repl arg)))\0A                 (when (or (<= 2 *verbosity*)\0A                           (not (= 0 exit-code)))\0A                   (print-all *debug-output* \22exit-code of file \22arg\22: \22(box <long> exit-code)\22\5Cn\22))))))))\0A\0A      exit-code)))\0A\00"

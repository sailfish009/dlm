t ()))\0A                          (set *globals* *slave-env*)\0A                          (set result (apply thunk runtime-args))\0A                          (set *globals* prev-globals)\0A                          result)))))\0A    ;; NOTE we define the form into the target env, because we want to\0A    ;; redefine the meaning of stuff like ERROR only in the target\0A    ;; env, not on its syntax-level (the slave module).\0A    `(define ,name ,form)))\0A\0A;; TODO the body of WITH-FORMS is executed in the target env, but it's used\0A;; here and there (e.g. disable %ACCESSOR-TYPECHECK locally), so we can't just do this:\0A;; (define-form with-forms args\0A;;   (error \22with-forms is not yet supported in the kernel code: \22args))\0A\0A(assert (not (= define-form (eval-in-slave 'define-form))))\0A\0A;; FIXME what's going on here? true should be resolved to the variable in slave, not in target\0A;; (define-form test123 ()\0A;;   true)\0A;; (assert (not (= 1 (test123))))\0A\0A;; hide DEFINE-CONSTANT in the target env with one that defines the constant into the slave env.\0A;; this way constants will be available inside the form bodies, too.\0A(define-form define-constant (name value-form)\0A  ;; NOTE as per the custom DEFINE-FORM above, we are expanded/encoded in the slave env,\0A  ;; but at runtime we're run in the target env.\0A  (let* ((value\09\09(eval value-form))\0A         (form-obj\09(eval `(form () (lambda _ ',value))))\0A         (definer-form\09`(define ,name ',form-obj)))\0A    (eval definer-form)     ; this way it will define into *slave-env* due to using the custom define-form above\0A    ()))\0A\0A(safety 1\0A  (define-form %im-a-test () (+ 1 41)))\0A(safety 1\0A  ;; (assert (not (find-local-variable *globals* '%im-a-test)))\0A  (assert (defined? '%im-a-test *slave-env*))\0A  (assert (= 42 (%im-a-test))))\0A\0A;; redefine DEFINE-RECORD so that it defines into the slave env (sometimes forms, i.e. constant\0A;; want to access types, e.g. <header> in gc.l).\0A(define-form define-record args\0A  (eval `(define-record ,@args)) ; this way it will define into *slave-env*\0A  ())\0A\0A;; install stubs for the +special-forms+, and also for some primitive functions,\0A;; so that any accidental use of them will result in an early and useful error message.\0A(list-do name '(return address-of byte-at set-byte-at\0A                arithmethic-shift-left arithmethic-shift-right\0A                stack-pointer-on-entry\0A                C-string                ; zero terminated C string\0A                ;;C-call ; calls the pointer in the first arg using the C calling convention on the rest of the args\0A                ;; nothing should call these before their target version gets defined:\0A                eval cons list car cdr form)\0A  (environment-define *globals* name (fixed (lambda args (eval-in-slave `(error ',name\22 encountered in interpreted code with args \22',args))))))\0A\0A;; NOTE that this must be defined here if we want to provide\0A;; BITWISE-SHIFT as a higher level API for left/right arithmetic shift\0A;; supported by the compiler (e.g. in the compiler tests). the machine\0A;; code instructions ignore signs, and in general ignore values larger\0A;; than the maximum shift that makes sense.\0A(define-function %bitwise-shift (value shift)\0A  (cond\0A    ((<= target/cell-size/bits shift)\0A     0)\0A    ((<= shift (- target/cell-size/bits))\0A     (if (< value 0) -1 0))\0A    ((< 0 shift)\0A     (arithmethic-shift-left value shift))\0A    ((< shift 0)\0A     (arithmethic-shift-right value (- shift)))\0A    (else value)))\0A\0A(define-form bitwise-shift (value shift)\0A  (typecase shift\0A    (<long>\09(cond\0A                  ((<= target/cell-size/bits shift)\0A                   0)\0A                  ((<= shift (- target/cell-size/bits))\0A                   (if (< value 0) -1 0))\0A                  ((< 0 shift)\0A                   `(arithmethic-shift-left ,value ,shift))\0A                  ((< shift 0)\0A                   `(arithmethic-shift-right ,value ,(- shift)))\0A                  (else value)))\0A    (else\09`(%bitwise-shift ,value ,shift))))\0A\0A;; install stubs for the *special-operators*\0A;; (list-do name '()\0A;;   ;; they need to be <target-function>'s (why?)\0A;;   (eval `(define ,name error) *target-env*))\0A\0A(switch-to-host-env)\0A\0A;; the *globals* of the slave-module is the env that holds the target's definitions\0A(define-function eval-in-target (form)\0A  (eval form *target-env*))\0A\0A(define-form target-value (form)\0A  `(eval-in-target ',form))\0A\0A(assert (= 1 (target-value true)))\0A(assert (= 0 (target-value false)))\0A\00"

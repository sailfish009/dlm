l (string ,(symbol->string zeroed-name)) \22: called with object of type \22 (type-of obj))))\0A         (if (gc/read-only-object? obj)\0A             (safety 3 (or (and (is ,type-name obj) (not (,getter-name obj (,length-name obj)))) (fatal (string ,(symbol->string zeroed-name)) \22: an ensure-zero-terminated function was called on a read-only object that is not zero terminated\22)))\0A           (let ((size (,length-name obj)))\0A             (,setter-name obj size 0)\0A             ;; reset back the length\0A             (set (slot-value ,type-name size obj) (box <long> size))))\0A         obj))))\0A\0A(define-vector-accessors <array>\09array-\09\09true\09oop-at\09\09copy-oops\09platform/move-oops\09target/cell-size/bytes)\0A(define-vector-accessors <string>\09string-\09\09()\09byte-at\09\09copy-bytes\09platform/move-bytes\091)\0A\0A(when-at-expand (feature memory-block)\0A  ;; FIXME: if these two when-at-expand's are merged, then a set form\0A  ;; transform (expand/encode/etc) happens differently and it fails to\0A  ;; load.\0A  (define-vector-accessors <memory-block>\09memory-block/\09()\09byte-at\09\09copy-bytes\09platform/move-bytes\091))\0A\0A(when-at-expand (feature memory-block)\0A\0A;; TODO decide where the DEFINE-VM-FUNCTION should be and make it uniform\0A(define-vm-function memory-block ((capacity <long> 0))\0A  (make <memory-block>\0A    (size\09(box <long> 0))\0A    (elements\09(when (> capacity 0)\0A                  (allocate-data capacity)))))\0A\0A(define-vm-function memory-block->lower/function ((array <memory-block>))\0A  (make <target-function>\0A    (program-code\09(slot-value <memory-block> elements array))))\0A\0A(define-vm-function (memory-block/length ()) ((array <memory-block>))\0A  (box <long> (memory-block/length array)))\0A\0A;; memory-block/at accessor is byte sized, and byte indexed\0A(define-vm-function (memory-block/at ()) ((array <memory-block>) (byteindex <long>))\0A  (box <long> (memory-block/at array byteindex)))\0A\0A(define-
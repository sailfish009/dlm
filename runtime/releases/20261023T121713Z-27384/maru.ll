prefix\09\09\22set-\22)\0A        (fn-name-str\09(<symbol>-name fn-name)))\0A    (gc/let* ((setter-name-str (string (+ (string-length fn-name-str)\0A                                          (string-length prefix)))))\0A      (string-append-all setter-name-str prefix)\0A      (string-append-all setter-name-str fn-name-str)\0A      (gc/let* ((setter-name (string->symbol setter-name-str)))\0A        (when (maybe-object-in-env env setter-name ())\0A          setter-name)))))\0A\0A(define-function maybe-fn-name-from-expr (expr)\0A  (when (pair? expr)\0A    (let ((fn-name (get/head expr)))\0A      (when (symbol? fn-name)\0A        fn-name))))\0A\0A(define-function attempt-set-convert (place value env one-step?)\0A  (let ((fn-name (maybe-fn-name-from-expr place)))\0A    (when fn-name\0A      ;; it's a set form such as: (set (fn-name a b c) new-value). let's try to convert it to\0A      ;; (set-fn-name a b c new-value) if set-fn-name is defined.\0A      (awhen (setter-name-for fn-name env)\0A        ;; TODO? the value should be inserted as the first arg to not disrupt &rest parsing\0A        (gc/let* ((args (get/tail place))\0A                  (last (cons value ())))\0A          (set args (expand-all args env one-step?))\0A          (set args (concat-list args last))\0A          (cons it args))))))\0A\0A(define-function expand/pair (exp env one-step? -call-frame-)\0A  (gc/let* ((head (expand (get/head exp) env one-step?)))\0A    (debug-print \22expand/pair on head \22head)\0A    (when-at-expand (feature backtrace)\0A      (unless (= head (get/head exp))\0A        (set (<call-frame>-callee\09\09-call-frame-) head))\0A      (set (<call-frame>-arguments\09\09-call-frame-) exp))\0A    (let (expander)\0A      ;; TODO use switch\0A      (cond\0A        ((= head symbol/let)\0A         ;; TODO use a collecting macro to simplify this\0A         (gc/let* ((new-bindings ()))\0A           (let ((bindings (cadr exp))\0A                 new-bindings/last)\0A             (list-do entry bindings\0A               (let (var-name)\0A                 (gc/let* (var-init-prog)\0A                   (if (pair? entry)\0A                       (let ()\0A                         (set var-name\09\09(get/head entry))\0A                         (set var-init-prog\09(expand-all (get/tail entry) env one-step?)))\0A                     (set var-name\09entry)\0A                     (set var-init-prog\09(cons () ())))\0A                   (when (maybe-form-in-env/symbol env var-name)\0A                     ;; TODO add infra for compiler warnings\0A                     (warn \22LET binding for '\22var-name\22' while it also has a binding for a symbol form\5Cn\22))\0A                   (gc/let* ((new-entry (cons var-name var-init-prog)))\0A                     (set new-bindings/last (if new-bindings\0A                                                (put/tail new-bindings/last (cons new-entry ()))\0A                                              (set new-bindings (cons new-entry ())))))))))\0A           (gc/let* ((tmp (expand-all (cddr exp) env one-step?))) ; the body\0A             (set tmp (cons new-bindings tmp))\0A             (set tmp (cons symbol/let tmp))\0A             tmp)))\0A\0A        ((= head symbol/quote)\0A         (cons symbol/quote (get/tail exp)))\0A\0A        ((= head symbol/set)\0A         (safety 1 (assert (and (cddr exp) (not (cdddr exp))) \22illegal set form: \22 exp))\0A         (debug-print \22expand/set on form \22exp)\0A         ;; try to set-transform (set (place-accessor ...) value) forms while expanding. try \22more abstract\22 set-foo forms first,\0A         ;; and only recursively expand the body if they are not defined.\0A         ;; this setup allows defining e.g. a SET-SLOT-VALUE form to override its behavior. the old way was to first expand\0A         ;; the body, i.e. a (SLOT-VALUE ...) form into an (OOP-AT ...) form, and only then attempt to set-convert it to SET-OOP-AT.\0A         (let ((vanilla-place\09(second exp)))\0A           (
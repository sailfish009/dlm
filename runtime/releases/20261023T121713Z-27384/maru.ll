@m_cstr1727 = private unnamed_addr constant [3137 x i8] c";;; -*- mode: lisp; coding: us-ascii -*-\0A\0A;; this is very similar in effect to read-time evaluation in CL, aka #.(foo)\0A(define-form eval-at-expand (form)\0A  (eval form *env*))\0A\0A(define-form if-at-expand (cond true-form . false-forms)\0A  (if (eval cond *env*)\0A      true-form\0A    (if (and false-forms\0A             (cdr false-forms))\0A        `(let () ,@false-forms)\0A      (car false-forms))))\0A\0A(define-form when-at-expand (cond . true-forms)\0A  (if (eval cond *env*)\0A      (if (and true-forms\0A               (cdr true-forms))\0A          `(let ()\0A             ,@true-forms)\0A        (car true-forms))))\0A\0A(define-form when (test . body)\0A  `(if ,test (let () ,@body)))\0A\0A(define-form unless (test . body)\0A  `(if ,test () ,@body))\0A\0A(define-form awhen (test . body)\0A  `(let (it)\0A     ;; this allows SETting IT from inside TEST\0A     (when (set it ,test)\0A       ,@body)))\0A\0A(define-form aif (test true-form . false-forms)\0A  `(let (it)\0A     (set it ,test)\0A     (if it\0A         ,true-form\0A       ,@false-forms)))\0A\0A;;; cond\0A\0A(define-function %maybe-progn (prog)\0A  (if (cdr prog)\0A      (cons 'let (cons '() prog))\0A    (car prog)))\0A\0A(define-function %cond (clauses)\0A  (if (pair? clauses)\0A      (let* ((clause (car clauses))\0A             (test   (car clause))\0A             (body   (cdr clause)))\0A        (if (= 'else test)\0A            (%maybe-progn body)\0A          (if (= '=> (car body)) ; scheme syntax to funcall the body\0A              `(let ((_ ,test))\0A                 (if _\0A                     (,(%maybe-progn (cdr body)) _)\0A                   ,(%cond (cdr clauses))))\0A            `(if ,test\0A                 ,(%maybe-progn body)\0A               ,(%cond (cdr clauses))))))))\0A\0A(define-form cond clauses (%cond clauses))\0A\0A;;; case\0A\0A(define-function self-evaluating-value? (x) ()) ; forward\0A\0A(define-function %case-test (v
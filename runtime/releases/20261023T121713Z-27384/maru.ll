tore\0A  ;; unboxed values in it. not sure if this is ideologically the right\0A  ;; way, because the upper can get hold of unboxed values using the\0A  ;; accessors.\0A  (make/opaque <fd-stream>\0A    (fd\09\09\09fd)\0A    (peeked-value\09-1)))\0A\0A(define-function %ensure-peeked (stream)\0A  (or (<= 0 (<fd-stream>-peeked-value stream))\0A      (let* ((fd\09(<fd-stream>-fd stream))\0A             (char\090)\0A             (rc\09(syscall linux/SYS_read fd (address-of char) 1)))\0A        (set (<fd-stream>-peeked-value stream)\0A             (if (= 1 rc)\0A                 char\0A               -1)))))\0A\0A;; Linux x86-64 pollfd is { int fd; short events; short revents; }.\0A;; Keep readiness separate from the reader so partial forms use the same parser.\0A(define-constant linux/repl-SYS-poll 7)\0A(define-constant linux/repl-POLLIN 1)\0A(define-function platform/input-ready? (stream milliseconds)\0A  (if (is <fd-stream> stream)\0A      (if (<= 0 (<fd-stream>-peeked-value stream)) true\0A        (let ((descriptor (bitwise-or (<fd-stream>-fd stream)\0A                           (bitwise-shift linux/repl-POLLIN 32))) (rc 0))\0A          (while (= (- linux/EINTR)\0A                    (set rc (syscall linux/repl-SYS-poll (address-of descriptor) 1 milliseconds))))\0A          (when (< rc 0) (error \22poll: input readiness failed\22))\0A          (> rc 0)))\0A    true))\0A\0A(define-method $at-end? <fd-stream> ()\0A  (%ensure-peeked self)\0A  (< self.peeked-value 0))\0A\0A(define-method $peek <fd-stream> ()\0A  (%ensure-peeked self)\0A  (if (<= 0 self.peeked-value)\0A      self.peeked-value\0A    +end+))\0A\0A(define-method $next <fd-stream> ()\0A  (%ensure-peeked self)\0A  (if (<= 0 self.peeked-value)\0A      (let ((res self.peeked-value))\0A        (set self.peeked-value -1)\0A        res)\0A    +end+))\0A\0A(define-method $put <fd-stream> (u/char)\0A  ;; TODO endianness? think this through...\0A  (unless (= 1 (posix/write self.fd (address-of u/char) 1))\0A    (error \
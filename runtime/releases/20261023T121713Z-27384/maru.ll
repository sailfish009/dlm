@m_cstr1887 = private unnamed_addr constant [3020 x i8] c";;; -*- mode: lisp; coding: us-ascii -*-\0A;;;\0A;;; selector: functions that dispatch on the type of the first argument, aka single dispatch\0A;;;\0A\0A;; FIXME the slave's slectors cannot be applied in the host while\0A;; bootstrapping. this leads to e.g. ASSERT not working properly in\0A;; macros, because the host cannot apply the slave's DO-PRINT.\0A\0A(define-record <selector> () (name methods default))\0A\0A;; TODO the printing subsystem requires <selector>\0A;; (define-print-method <selector>\0A;;   (print-all -stream- \22<selector:\22self.name\22>\22))\0A\0A(define-function selector/lookup-effective-method (methods self)\0A  (let ((method ())\0A        (probe  (type-of self)))\0A    (while (and (not (set method (array-at methods (<type>-id probe))))\0A                (set probe (and (is <record> probe)\0A                                (<record>-super probe)))))\0A    ;; we could do something like this for a simple method cache,\0A    ;; but this would need some mechanism for invalidation\0A    ;; when records get (re)defined.\0A    ;; (when method\0A    ;;   (set (array-at methods type) method))\0A    method))\0A\0A(define-apply <selector> (self . arguments)\0A  (apply\0A   (or (selector/lookup-effective-method (<selector>-methods self)\0A                                         (car arguments))\0A       (<selector>-default self))\0A   arguments))\0A\0A(define-function selector (name default)\0A  (make <selector>\0A    (name      name)\0A    (methods   (array))\0A    (default   default)))\0A\0A(define-function selector/add-method (self type method)\0A  (when-at-expand (and (feature track-expr-names)\0A                       (not bootstrapping?))\0A    ;; expr's (lambdas) are instantiated by the host, so let's not assume anything about their object layout.\0A    (when (and (expr? method)\0A               (not (<expr>-name method)))\0A      (set (<expr>-name method)\0A           (concat-symbols (name-of-type type) '. (<selector>-name self)))))\0A  (set-array-at (<selector>-methods self) (<type>-id type) method))\0A\0A(define-form define-selector (name . default)\0A  (assert (symbol? name) \22define-selector: name is not a symbol\22)\0A  (let ((var (defined? name)))\0A    (if var\0A        (if (is <selector> (<variable>-value var))\0A            `(quote ,(<variable>-value var))\0A          (error name\22 is already defined as non-selector: \22 (<variable>-value var)))\0A      (unless default\0A        (set default `(args (error \22selector '\22',name\0A                                   \22' has no method for \22(type-name-of (car args))\0A                                   \22: \22(cons (car args) (map type-name-of (cdr args)))))))\0A      `(define ,name (selector ',name (lambda ,@default))))))\0A\0A(define-selector add-method)\0A\0A(selector/add-method add-method <selector>\0A  (lambda (self type body)\0A    (selector/add-method self type body)))\0A\0A(define-form define-method (selector type args . body)\0A  (or (defined? selector) (eval `(define-selector ,selector) *env*))\0A  `(add-method ,selector ,type\0A               (lambda (self ,@args)\0A                 (with-instance-accessors self ,type\0A                   ,@body))))\0A\00"

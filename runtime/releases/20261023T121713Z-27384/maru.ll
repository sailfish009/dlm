@m_cstr1803 = private unnamed_addr constant [8404 x i8] c";;; -*- mode: lisp; coding: us-ascii -*-\0A\0A;; TODO FIXME file-stream returns an instance of a type that is not\0A;; available at runtime in the interpreter, yet, we bind its value to\0A;; *standard-output* & co... it's and extra complexity that this type\0A;; id will have quite a gap in the type id's (4-5). without fixing\0A;; this situation the streams will be an object of an unknown type in\0A;; the evaluator, or even worse: a different type gets loaded and\0A;; assigned the same type id. need to think more about the compilation\0A;; of types, because the current setup is clearly inadequate.\0A\0A(define-form initialize-stream (target-name our-name)\0A  (assert (symbol? our-name)) ; symbol macros should be expanded after the call form macros\0A  `(gc/let* ((stream (file-stream ,target-name)))\0A     (debug (platform/diag-print \22initializing \22 (string ,(symbol->string our-name)) \22\5Cn\22))\0A     (set ,our-name stream)\0A     ;; the maru-user env was create earlier, let's set it there, too.\0A     ;; TODO clarify: why in maru-user?\0A     (set (variable-value *maru* ,(concat-symbol 'symbol/ our-name))\0A          stream)))\0A\0A(define-function initialize-streams (in-handle out-handle err-handle)\0A  ;; NOTE: a WITH-FORMS is tempting here, but the body of WITH-FORMS'\0A  ;; is not executed in the right env. years later: not sure what that\0A  ;; means, but a WITH-FORMS indeed seems to lead to a backtrace.\0A  ;; TODO rename to *input*?\0A  ;; TODO do we need a *debug-input*?\0A  (initialize-stream in-handle\09*standard-input*)\0A  (initialize-stream out-handle\09*standard-output*)\0A  (initialize-stream err-handle\09*error-output*)\0A  (initialize-stream err-handle\09*debug-output*))\0A\0A(require \22source/platforms/linux/session-files.l\22)\0A(require \22source/evaluator/repl-tasks.l\22)\0A\0A(define-vm-function repl-stream ((input _ *standard-input*)\0A                                        (out
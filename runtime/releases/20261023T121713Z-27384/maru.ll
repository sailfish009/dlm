@m_cstr1907 = private unnamed_addr constant [6283 x i8] c";;; -*- mode: lisp; coding: us-ascii -*-\0A;;; Explicit finite-domain nondeterminism; no implicit evaluator continuations.\0A(define-function symbolic-nth (xs n)\0A  (if (= n 0) (car xs) (symbolic-nth (cdr xs) (- n 1))))\0A\0A(define-function symbolic-length (xs)\0A  (if xs (+ 1 (symbolic-length (cdr xs))) 0))\0A\0A(define-function symbolic-append (xs ys)\0A  (if xs (cons (car xs) (symbolic-append (cdr xs) ys)) ys))\0A\0A(define-function symbolic-member? (x xs)\0A  (and xs (or (equal x (car xs)) (symbolic-member? x (cdr xs)))))\0A\0A(define-function symbolic-add (xs x)\0A  (if (symbolic-member? x xs) xs (symbolic-append xs (list x))))\0A\0A(define-function symbolic-union (xs ys)\0A  (if ys (symbolic-union (symbolic-add xs (car ys)) (cdr ys)) xs))\0A\0A(define-function symbolic-intersection (xs ys)\0A  (if xs\0A      (if (symbolic-member? (car xs) ys)\0A          (cons (car xs) (symbolic-intersection (cdr xs) ys))\0A        (symbolic-intersection (cdr xs) ys))\0A    ()))\0A\0A(define-function symbolic-difference (xs ys)\0A  (if xs\0A      (if (symbolic-member? (car xs) ys)\0A          (symbolic-difference (cdr xs) ys)\0A        (cons (car xs) (symbolic-difference (cdr xs) ys)))\0A    ()))\0A\0A(define-function symbolic-assoc (key xs)\0A  (if xs\0A      (if (equal key (car (car xs))) (car xs)\0A        (symbolic-assoc key (cdr xs)))\0A    ()))\0A\0A;;; -*- mode: lisp; coding: us-ascii -*-\0A;;; Finite domains: ((NAME (VALUE ...)) ...).\0A;;; Constraint: (neq LEFT RIGHT), or (table LEFT RIGHT ((VALUE VALUE) ...)).\0A;;; No external Screamer code/dependency. Branch domains are immutable lists.\0A(define-function csp-domain (domains name)\0A  (symbolic-nth (symbolic-assoc name domains) 1))\0A\0A(define-function csp-relation? (constraint left right)\0A  (if (= (car constraint) 'neq) (not (equal left right))\0A    (if (= (car constraint) 'table)\0A        (symbolic-member? (list left right) (symbolic-nth constraint 3))\0A      (error \22CSP: unknown relation\22))))\0A\0A;;; Arc support for one value. Return (SUPPORTED RELATION-CHECKS).\0A(define-function csp-supported (name value domains constraints)\0A  (let ((valid true) (checks 0))\0A    (list-do c constraints\0A      (let ((left (symbolic-nth c 1)) (right (symbolic-nth c 2)))\0A        (when (or (equal name left) (equal name right))\0A          (let ((supported false)\0A                (other (if (equal name left) right left)))\0A            (list-do v (csp-domain domains other)\0A              (set checks (+ checks 1))\0A              (if (and (or (not (equal left right)) (equal value v))\0A                       (if (equal name left) (csp-relation? c value v)\0A                         (csp-relation? c v value)))\0A                  (set supported true)))\0A            (if (not supported) (set valid false))))))\0A    (list valid checks)))\0A\0A(define-function csp-empty? (domains)\0A  (and domains (or (not (symbolic-nth (car domains) 1)) (csp-empty? (cdr domains)))))\0A\0A;;; Arc-consistency fixpoint. No assertion of a solution from local consistency.\0A;;; Result: (DOMAINS CHECKS REMOVED).\0A(define-function csp-propagate (domains constraints)\0A  (let ((current domains) (changed true) (checks 0) (removed 0))\0A    (while (and changed (not (csp-empty? current)))\0A      (let ((next ()))\0A        (list-do entry current\0A          (let ((kept ()))\0A            (list-do value (symbolic-nth entry 1)\0A              (let ((support (csp-supported (car entry) value current constraints)))\0A                (set checks (+ checks (symbolic-nth support 1)))\0A                (if (car support) (set kept (symbolic-append kept (list value)))\0A                  (set removed (+ removed 1)))))\0A            (set next (symbolic-append next (list (list (car entry) kept))))))\0A        (set changed (not (equal next current)))\0A        (set current next)))\0A    (list current checks removed)))\0A\0A(define-function csp-variable (domains mrv)\0A  (let ((best ()) (size 0))\0A    (list-do entry domains\0A      (let ((n (symbolic-length (symbolic-nth entry 1))))\0A        (when (> n 1)\0A          (if (or (not best) (and mrv (< n size)))\0A              (begin (set best (car entry)) (set size n))))))\0A    best))\0A\0A(define-function csp-bind (domains name value)\0A  (if domains\0A      (cons (if (equal name (car (car domains))) (list name (list value)) (car domains))\0A            (csp-bind (cdr domains) name value))\0A    ()))\0A\0A(define-function csp-valid? (domains constraints)\0A  (let ((valid true))\0A    (list-do c constraints\0A      (if (not (csp-relation? c (car (csp-domain domains (symbolic-nth c 1)))\0A                              (car (csp-domain domains (symbolic-nth c 2)))))\0A          (set valid false)))\0A    valid))\0A\0A;;; Enumerate ALL solutions for an honest same-answer-set comparison.\0A;;; Budget counts agenda expansions, not propagation relation checks.\0A;;; Result: (csp-result STATUS SOLUTIONS NODES RELATION-CHECKS PRUNED-VALUES).\0A;;; complete with no solutions means unsatisfiable within this finite model;\0A;;; incomplete with no solutions does NOT mean unsatisfiable.\0A(define-function symbolic-choose (domains name)\0A  (let ((branches ()))\0A    (list-do value (csp-domain domains name)\0A      (set branches (symbolic-append branches (list (csp-bind domains name value)))))\0A    branches))\0A\0A(define-function csp-solve (domains constraints budget mode)\0A  (let ((agenda (list domains)) (solutions ()) (nodes 0) (checks 0) (pruned 0))\0A    (while (and agenda (< nodes budget))\0A      (let* ((raw (car agenda))\0A             (prop (if (= mode 'dfs) (list raw 0 0)\0A                     (csp-propagate raw constraints)))\0A             (current (car prop)))\0A        (set agenda (cdr agenda))\0A        (set nodes (+ nodes 1))\0A        (set checks (+ checks (symbolic-nth prop 1)))\0A        (set pruned (+ pruned (symbolic-nth prop 2)))\0A        (unless (csp-empty? current)\0A          (let ((name (csp-variable current (= mode 'propagate-mrv))))\0A            (if name\0A                (set agenda (symbolic-append (symbolic-choose current name) agenda))\0A              (begin\0A                (set checks (+ checks (symbolic-length constraints)))\0A                (if (csp-valid? current constraints)\0A                    (set solutions (symbolic-add solutions current)))))))))\0A    (list 'csp-result (if agenda 'incomplete 'complete) solutions nodes checks pruned)))\0A\0A(define-function symbolic-solutions (domains constraints budget)\0A  (csp-solve domains constraints budget 'propagate-mrv))\0A\00"

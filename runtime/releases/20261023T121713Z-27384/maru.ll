@m_cstr1883 = private unnamed_addr constant [4574 x i8] c";;; -*- mode: lisp; coding: us-ascii -*-\0A\0A(define-selector do-print (self stream)\0A  (print-all stream \22[\22(type-name-of self)\22 \22(type-id-of self)\22]\22))\0A\0A(define-selector do-dump (self stream)\0A  ;; FIXME this seems recursive\0A  (dump-all stream self))\0A\0A(define-form define-print-method (type . body)\0A  `(define-method do-print ,type (-stream-)\0A     ,@body))\0A\0A(define-function print-all (stream . args)\0A  (while (pair? args)\0A    (do-print (pop args) stream)))\0A\0A(define-function dump-all (stream . args)\0A  (while (pair? args)\0A    (do-dump (pop args) stream)))\0A\0A(define-function print args\0A  (let ((l args))\0A    (while (pair? l)\0A      (do-print (pop l) *standard-output*)))\0A  (car args))\0A\0A(define-function dump args\0A  (let ((l args))\0A    (while (pair? l)\0A      (do-dump (pop l) *standard-output*))\0A    (car args)))\0A\0A(define-function println args\0A  (apply print-all (cons *standard-output* args))\0A  (do-print \22\5Cn\22 *standard-output*)\0A  (car args))\0A\0A(define-function dumpln args\0A  (apply dump-all (cons *standard-output* args))\0A  (do-print \22\5Cn\22 *standard-output*)\0A  (car args))\0A\0A(define-function %print-list (stream lst separator storing?)\0A  (primitive/print-all stream \22(\22)\0A  (let ((first-time?\09true)\0A        (cell\09\09lst))\0A    (while (pair? cell)\0A      (if first-time?\0A          (set first-time? false)\0A        (primitive/print-all stream separator))\0A      ((if storing? do-dump do-print) (car cell) stream)\0A      (set cell (cdr cell)))\0A    (when cell\0A      (print-all stream \22 . \22 cell))\0A    (primitive/print-all stream \22)\22)))\0A\0A(define-function print-list (lst . etc)\0A  (let ((separator (or (pop etc) \22 \22))\0A        (stream    (or (pop etc) *standard-output*)))\0A    (%print-list stream lst separator false)))\0A\0A(with-forms ((redirect (types `(let ()\0A                                 ,@(map (lambda (type)\0A                                          `(define-print-method ,type\0A                                             (primitive/print-all -stream- self)))\0A                                        types)))))\0A  ;; by default redirect the printing of these types to the do-print primfn of the evaluator.\0A  ;; TODO i removed  <target-function> from here; what are the negative consequences?\0A  (redirect <undefined> <string> <symbol> <long> <array> <variable>))\0A\0A(with-forms ((redirect (types `(let ()\0A                                 ,@(map (lambda (type)\0A                                          `(define-method do-dump ,type (stream)\0A                                             (primitive/dump-all stream self)))\0A                                        types)))))\0A  ;; by default redirect the dumping of these types to the do-print primfn of the evaluator.\0A  (redirect <undefined> <string> <symbol> <long> <array>))\0A\0A(define-print-method <fixed>\09(print-all -stream- \22<fixed \22self.function\22>\22))\0A(define-print-method <selector>\09(print-all -stream- \22<selector \22self.name\22>\22))\0A(define-print-method <expr>\09(print-all -stream- \22<expr \22(or (when-at-expand (feature track-expr-names) self.name) \22?\22)\22 \22self.parameters\22>\22))\0A(define-print-method <env>\09(print-all -stream- \22<env \22(or (when-at-expand (feature debug-info) self.name) \22?\22)\22 Lv\22self.level\22,Off\22self.offset\22,#\22(array-length self.bindings)\22>\22))\0A(define-print-method <type>\09(print-all -stream- \22<\22(<type>-name self)\22 \22(<type>-id self)\22>\22))\0A(define-print-method <pair>\09(%print-list -stream- self \22 \22 false))\0A(define-print-method <lower-cell> (print-all -stream- \220x\22(number->string (lower-cell->long self) 16)))\0A(when-at-expand (feature track-expr-names)\0A  (define-print-method <target-function> (print-all -stream- \22<target-function \22self.name\22>\22)))\0A\0A(define-method do-dump <pair> (
      object-canary\0A                      debug-info))))\0A\0A;;;\0A;;; Utils\0A;;;\0A\0A;; TODO this is naive, should also deal with varargs explicitly instead of just returning nil\0A(define-function expr-n-required-parameters (op)\0A  (let ((params\09\09(<expr>-parameters op))\0A        (n-params\09()))\0A    (cond\0A      ((not params))                   ; (lambda () ...)\0A      ((symbol? params))               ; (lambda args ...)\0A      ((pair? params)\0A       (set n-params 1)\0A       (while (pair? (set params (rest params)))\0A         (incr n-params))\0A       (when (symbol? params)          ; (lambda (arg1 . rest) ...)\0A         (set n-params ())))\0A      (else\0A       (error \22expr-n-required-parameters: error parsing <expr> \22 op \22, parameters \22 params)))\0A    n-params))\0A\00"

@m_cstr1855 = private unnamed_addr constant [3272 x i8] c";;; -*- mode: lisp; coding: us-ascii -*-\0A\0A;;; https://blog.packagecloud.io/eng/2016/04/05/the-definitive-guide-to-linux-system-calls/\0A;;; https://en.wikibooks.org/wiki/X86_Assembly/Interfacing_with_Linux\0A\0A(define-instruction LINUX-SYSCALL (false 1 true)\0A  ;; TODO does this properly communicate to LLVM which registers get overwritten?\0A  ((pair)\0A   (print \22\09\22$reg1\22 = call %oop asm sideeffect \5C\22\22) ; sideffect means: never optimize away\0A   (let ((args $1)\0A         instr\0A         input-regs\0A         output\0A         clobbers)\0A     (case (slave-value target/arch)\0A       (IA-32\0A        ;; at most 6 args passed in regs. the rest should be spilled\0A        ;; to the stack, but we don't support that.\0A        (set instr\09\22int\09$$0x80\22)\0A        (set input-regs\09+linux/syscall/argument-registers/IA-32+)\0A        ;; https://stackoverflow.com/questions/47983371/why-do-x86-64-linux-system-calls-modify-rcx-and-what-does-the-value-mean\0A        ;; https://refspecs.linuxfoundation.org/elf/x86_64-abi-0.99.pdf\0A        ;; On IA-32 \22A\22 means the edx:eax pair used together to\0A        ;; represent a 64-bit quantity. (i don't think we need that?)\0A        ;;(set output \22A\22)\0A        ;; NOTE: seems like +{eax} is not a good input-output spec on x86,\0A        ;; i can't make it compile.\0A        (set output\09\22={eax}\22)\0A        (set clobbers\09+linux/syscall/clobbered-registers/IA-32+))\0A       (x86-64\0A        (set instr\09\22syscall\22)\0A        (set input-regs\09+linux/syscall/argument-registers/x86_64+)\0A        (set output\09\22={rax}\22)\0A        (set clobbers\09+linux/syscall/clobbered-registers/x86_64+))\0A       (aarch64\0A        (set instr\09\22svc #0\22)\0A        (set input-regs +linux/syscall/argument-registers/aarch64+)\0A        ;; first arg is the syscall number in x8, cdr is the first actual arg to the syscall.\0A        ;; + prefix me
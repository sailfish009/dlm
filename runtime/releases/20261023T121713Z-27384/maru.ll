@m_cstr1791 = private unnamed_addr constant [5492 x i8] c";;; -*- mode: lisp; coding: us-ascii -*-\0A;;;\0A;;; These are the definitions the platform API can use.\0A;;;\0A;;; Various examples of platforms:\0A;;;   libc\0A;;;   metacircular: eval.exe running the code in eval.l\0A;;;   raspberry-pi: running directly on an ARM board\0A;;;   linux: static binary using direct syscalls\0A;;;\0A;;; A platform needs to provide the following API:\0A;;;  - strings\0A;;;  - integers\0A;;;  - memory\0A;;;    - provide chunk(s) of memory for our GC\0A;;;    - moving, copying, comparing oops, bytes\0A;;;  - basic input/output\0A;;;  - bridge execution into and out of our universe;\0A;;;    e.g. main() and exit() in the case of libc.\0A\0A(eval-in-slave '(set (feature emit-with-object-headers) true))\0A\0A(define-constant +maximum-call-stack-depth+\0910000) ; to detect infinite recursion before the info gets lost into a sigsegv...\0A\0A;; we can't have a function in the target for print-all, because\0A;; there's no support for &rest args yet in the compiler.\0A(define-form print-all (stream . objs)\0A  `(let ()\0A     ,@(map (lambda (obj)\0A              `(do-print ,stream ,obj false))\0A            objs)))\0A\0A;; TODO use print-to-string eventually to generate the default assertion message, or add support for list literals in the compiler\0A;;(define-form assert\09\09prog ())\0A(define-form assert\09\09(test . args)\09`(or ,test (error ,@(or args (list \22kernel assertion failed\22)))))\0A\0A(define-form to-upper-boolean (form)\0A  `(and ,form symbol/true))\0A\0A;;;\0A;;; override slot access with a specialized getter and setter\0A;;; for the possibility of implementing e.g. read/write barriers.\0A;;;\0A;;; the customized slot-value is used for accessing heap objects\0A;;; that have a <header>. on high enough safety level all slot access\0A;;; is typechecked at runtime.\0A;;;\0A;;; \22one of the reasons for having all accesses to object fields go\0A;;; through get() and set() was to make it ridiculously easy to add\0A;;; read and write barriers\22 - Piumarta (NOTE: that get/set has been\0A;;; replaced by the [set-]slot-value macro choke-points below)\0A;;;\0A;;; ----------------------------------------------------------------\0A\0A(define-form slot-value (type-name slot-name object)\0A  (let* ((type\09\09(eval type-name *env*))\0A         (slot-index\09(record/slot-index type slot-name)))\0A    `(oop-at ,(if (feature typecheck-slot-access)\0A                  `(%accessor-typecheck ,(<type>-slave-id type) ,object)\0A                object)\0A             ,slot-index)))\0A\0A(define-form set-slot-value (type-name slot-name object value)\0A  (let* ((type\09\09(eval type-name *env*))\0A         (slot-index\09(record/slot-index type slot-name)))\0A    `(set (oop-at ,(if (feature typecheck-slot-access)\0A                       `(%accessor-typecheck ,(<type>-slave-id type) ,object)\0A                     object)\0A                  ,slot-index)\0A          ,value)))\0A\0A;;;\0A;;; forward definitions, so that the variables get created early enough for building the graph\0A;;; ----------------------------------------------------------------\0A(define-form define-forwards names\0A  `(let ()\0A     ,@(map (lambda (name) (list 'define name))\0A            names)))\0A\0A(define-forwards\0A    *globals* *maru* *symbols*\0A\0A    *expanders-var* *encoders-var* *evaluators-var* *applicators-var*\0A\0A    fixed-primitive-function/quote\0A    fixed-primitive-function/lambda\0A    fixed-primitive-function/let\0A    fixed-primitive-function/define\0A    fixed-primitive-function/set\0A\0A    +end+ ; a unique value that cannot ever be read from any source file; it will be initialized at startup to an uninterned symbol.\0A\0A    ;; and finally, these are the names of our own functions. we need to resolve some circular references this way.\0A    print-backtrace capture-well-known-globals\0A    print println read encode expand eval string->symbol %accessor-typecheck\0A    abort %string->C-string long->string/emit\0A\0A    symbol/*standard-input* symbol/*standard-output* symbol/*error-output* symbol/*debug-output*\0A\0A    ;; and some of these are here to hide the host's primfns, otherwise those primfn's will be referenced by the\0A    ;; bodies of our impl functions below, leading to primfns reaching the compiler.\0A    environment-define defined? variable-value set-variable-value\0A\0A    ;; KLUDGE to ease load order constraints\0A    main/common\0A    )\0A\0A(define *call-stack-index*\090)\0A(when-at-expand (feature backtrace)\0A  (define *call-stack*\09\090))\0A\0A;; this installs symbol macros that get/set the value from/to the\0A;; interpreter's global state, namely the maru module's global\0A;; variables.\0A(define-symbol-form *standard-input*  '(variable-value *maru* symbol/*standard-input*))\0A(define-symbol-form *standard-output* '(variable-value *maru* symbol/*standard-output*))\0A(define-symbol-form *error-output*    '(variable-value *maru* symbol/*error-output*))\0A(define-symbol-form *debug-output*    '(variable-value *maru* symbol/*debug-output*))\0A\0A;; TODO this is dog slow, we cannot use it as-is to replace *verbosity*\0A;; (define-symbol-form *verbosity*       '(variable-value *maru* symbol/*verbosity*))\0A;; (define-symbol-form *optimised*       '(variable-value *maru* symbol/*optimised*))\0A\0A;; TODO this is fast, but this way *verbosity* in the vm and in the target is not in sync automatically.\0A;; ideally, these variables could be in a super-module, and the codebase would't even have a global-variable?\0A;; TODO (define-vm-variable *verbosity* <long> 0)\0A(define *verbosity* 0)\0A(define *optimised* 0)\0A\0A(define-form error args\0A  (error \22ERROR referenced too early while loading the target definitions; args: \22 args))\0A\0A(load \22source/math-min.l\22)\0A\00"

@m_cstr1687 = private unnamed_addr constant [2731 x i8] c";;; -*- mode: lisp; coding: us-ascii -*-\0A;;;\0A;;; This file is loaded when the host VM is ready, basically right\0A;;; after it has loaded its own boot.l\0A\0A(set-working-directory *slave-directory*)\0A\0A(define *host-env* *globals*)\0A\0A;; *slave-env* will be the direct parent of *target-env* (i.e. lookup is delegated to it).\0A;; you can think of *slave-env* as the syntax-module of the target: all macros,\0A;; constants, and any meta-level stuff are evaluated in that environment.\0A;; *target-env* will be set up later in emit-early.l.\0A(let ((slave-env (environment *maru*)))\0A  (assert (= 0 (<env>-level slave-env)))\0A  (when-at-expand (feature debug-info)\0A    (set (<env>-name slave-env) \22slave\22))\0A  (define *slave-env* slave-env)\0A  (environment-define *slave-env* 'switch-to-host-env\0A                      (lambda ()\0A                        (verbosity 2 (warn \22---> host env\5Cn\22))\0A                        (set *globals* *host-env*)))\0A  (set *globals* *slave-env*)\0A  ;; NOTE this toplevel form is encoded into the host env. the previous\0A  ;; switch-to-slave-env happens at runtime, i.e. it has no effect on the\0A  ;; encode phase. hence the seemingly superfluous use of eval below.\0A  (eval `(define *host-env* ,*host-env*) *slave-env*))\0A\0A;; NOTE: we are in the slave module now, and the following forms will be read/interned into the slave.\0A;; NOTE: the slave module doesn't have boot.l loaded at this point, we only have the primitives.\0A\0A;; The variable bootstrapping? denotes that the process is underway in which a host loads a slave into an isolated module,\0A;; and then compiles the definitions to the target (does the level-shift).\0A(define bootstrapping? true)\0A\0A;; The variable evolving? denotes that the host running the bootstrapping process is\0A;; the previous stage, i.e. an earlier version of us. It will be set in host-extras.l\0A;; if it gets loaded.\0A(define evolving? ())\0A\0A(define eval-in-host (lambda (form)\0A                       (eval form *host-env*)))\0A\0A;; a convoluted way to build (assert (is <target-function> load)) without LIST\0A;; TODO is this crucial still? i guess it was a rage-add after debugging something nasty...\0A;;(eval-in-host ((lambda args args) 'assert ((lambda args args) 'is '<target-function> load)))\0A\0A(switch-to-host-env)\0A\0A(assert (= *host-env* (eval '*host-env* *slave-env*)))\0A\0A(assert (= (eval '*host-env* *host-env*) (eval '*host-env* *slave-env*)))\0A\0A(define-function switch-to-slave-env ()\0A  (verbosity 2 (warn \22---> slave env\5Cn\22))\0A  (set *globals* *slave-env*))\0A\0A(define-function eval-in-slave (form)\0A  (eval form *slave-env*))\0A\0A(define-form slave-value (form)\0A  `(eval-in-slave ',form))\0A\0A(when-at-expand (feature debug-info)\0A  ;; maru-user is the host\0A  (assert (= \22maru-user\22 (<env>-name *globals*))))\0A\00"

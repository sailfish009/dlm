@m_cstr1915 = private unnamed_addr constant [1718 x i8] c";;; -*- mode: lisp; coding: us-ascii -*-\0A(require \22source/files.l\22)\0A(require \22image/manifest.l\22)\0A\0A(define-function image-write (stream text)\0A  (for (i 0 (string-length text))\0A    (file-write-byte-or-die (string-at text i) stream)))\0A\0A(define-function image-quote (stream text)\0A  (file-write-byte-or-die ?\5C\22 stream)\0A  (for (i 0 (string-length text))\0A    (let ((c (string-at text i)))\0A      (if (or (= c ?\5C\22) (= c ?\5C\5C))\0A          (file-write-byte-or-die ?\5C\5C stream))\0A      (file-write-byte-or-die c stream)))\0A  (file-write-byte-or-die ?\5C\22 stream))\0A\0A(define-function image-marker? (text pos marker)\0A  (let ((same true) (n (string-length marker)))\0A    (if (> (+ pos n) (string-length text)) false\0A      (begin\0A        (for (j 0 n)\0A          (if (!= (string-at text (+ pos j)) (string-at marker j))\0A              (set same false)))\0A        same))))\0A\0A(define-function image-table (stream)\0A  (image-write stream \22(define-function embedded-source (path)\5Cn  (cond\5Cn\22)\0A  (list-do path *image-files*\0A    (image-write stream \22    ((embedded-path=? path \22)\0A    (image-quote stream path)\0A    (image-write stream \22) \22)\0A    (image-quote stream (image-source path))\0A    (image-write stream \22)\5Cn\22))\0A  (image-write stream \22    (else 0)))\5Cn\22))\0A\0A(let ((template (image-source \22image/vm-template.l\22))\0A      (marker \22@@TABLE@@\22)\0A      (out (file-open-or-die \22candidate-vm.l\22 \22w\22))\0A      (i 0))\0A  (while (< i (string-length template))\0A    (if (image-marker? template i marker)\0A        (begin (image-table out) (set i (+ i (string-length marker))))\0A      (begin (file-write-byte-or-die (string-at template i) out)\0A             (set i (+ i 1)))))\0A  (file-close-or-die out))\0A(println \22Generated candidate-vm.l from embedded sources using Maru\22)\0A\00"

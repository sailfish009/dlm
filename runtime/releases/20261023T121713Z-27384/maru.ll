@m_cstr1843 = private unnamed_addr constant [12534 x i8] c";;; -*- mode: lisp; coding: us-ascii -*-\0A\0A(set (feature platform/linux) true)\0A(set (feature platform/posix) true)\0A\0A(require \22source/platforms/platform-c-based.l\22)\0A\0A;; It's tempting to just include the posix cgrov values, but even\0A;; though they mostly overlap, there's no guarantee that they are\0A;; the same.\0A;; (require-cgrov \22source/platforms/posix/posix\22)\0A\0A(require-cgrov \22source/platforms/linux/linux\22)\0A\0A;; Internally we define a posix API, so we need to define\0A;; some posix/foo constants.\0A(define-constant posix/O_WRONLY linux/O_WRONLY)\0A(define-constant posix/O_CREAT  linux/O_CREAT)\0A(define-constant posix/O_TRUNC  linux/O_TRUNC)\0A\0A(define main) ; forward\0A\0A;; define some llvm intrinsics as FFI calls\0A;; https://llvm.org/docs/LangRef.html#llvm-memcpy-intrinsic\0A;; (define-C-functions ()\0A;;   (void llvm.memcpy.p0i8.p0i8.i32 (* * int int))\0A;;   )\0A;; TODO turned off because this requires linking to something that defines memcpy. apparently llvm doesn't emit its own code for these.\0A;; (if (= (host-value *compiler-backend*) \22llvm\22)\0A;;     (define-form copy-oops (from to wordcount)\0A;;       ;; TODO add align: https://llvm.org/docs/LangRef.html#attr-align\0A;;       `(llvm.memcpy.p0i8.p0i8.i32 ,to ,from (words-to-bytes ,wordcount) 1)))\0A\0A;; this is a placeholder object in the target on which we can register\0A;; a special-form later. theoretically, this could be any object\0A;; (including nil), but we leave a recognizable trace for better\0A;; potential error messages.\0A(define syscall\0A  (fixed (lambda args\0A           (print \22syscall encountered in interpreted code with args \22 args \22\5Cn\22)\0A           (abort))))\0A\0A;; NOTE: cannot be a function, because the syscall special form cannot be applied\0A;; NOTE: the assert wrapper must be defined later when ERROR is set up\0A(define-form syscall* args\0A  `(%syscall-rc-assert ,(first args) (syscall ,@args)))\0A\0A;;;\0A;;; Platform API implementation when running on top of the Linux kernel.\0A;;;\0A(define-function platform/flush-streams ()\0A  ;; there's no need to flush fd's on linux. fsync straight out\0A  ;; returns an error when called on a terminal or pipe.\0A  ;; (syscall* linux/SYS_fsync linux/STDOUT_FILENO)\0A  ;; (syscall* linux/SYS_fsync linux/STDERR_FILENO)\0A  )\0A\0A;; NOTE copy means it may not overlap. move means they may overlap.\0A\0A;; TODO these two are exported into the evaluator to provide the same api in interpreted code. how shall this be?\0A(define-function copy-oops (from to wordcount)\0A  (for (i 0 wordcount)\0A    (set (oop-at to   i)\0A         (oop-at from i))))\0A\0A(define-function copy-bytes (from to count)\0A  (for (i 0 count)\0A    (set (byte-at to   i)\0A         (byte-at from i))))\0A\0A(define-function platform/move-oops (from to wordcount)\0A  (cond\0A    ((< to from)\0A     (for (i 0 wordcount)\0A       (set (oop-at to   i)\0A            (oop-at from i))))\0A    ((< from to)\0A     (for (i (- wordcount 1) -1 -1)\0A       (set (oop-at to   i)\0A            (oop-at from i))))))\0A\0A(define-function platform/move-bytes (from to count)\0A  (cond\0A    ((< to from)\0A     (for (i 0 count)\0A       (set (byte-at to   i)\0A            (byte-at from i))))\0A    ((< from to)\0A     (for (i (- count 1) -1 -1)\0A       (set (byte-at to   i)\0A            (byte-at from i))))))\0A\0A(define-function platform/clear-cells (from cell-count)\0A;; TODO this is still rather high in the profiler. maybe introduce\0A;; backend specific compiler macros, and then add an x86 asm\0A;; impelmentation?\0A  (for (i 0 cell-count)\0A    (set (oop-at from i) 0)))\0A\0A(define-form platform/diag-print-string (str)\0A  (typecase str\0A    (<string> ; i.e. we can calculate the string length at expand time\0A     `(syscall linux/SYS_write linux/STDERR_FILENO\0A                     (string->C-string ,str) ,(string-length str)))\0A    (else\0A     ;; FIXME why do i need the eval?\0A     `(let ((cstr ,(if (eval '(feature emit-with-object-headers))\0A                       `(string->C-string ,str)\0A                     str)))\0A        (syscall linux/SYS_write linux/STDERR_FILENO cstr (C-string-length cstr))))))\0A\0A(define-function platform/diag-print-char (char)\0A  ;; TODO endianness?\0A  (syscall linux/SYS_write linux/STDERR_FILENO (address-of char) 1)\0A  char)\0A\0A;; needs to be a form; the compiler doesn't yet support . rest args\0A(define-function platform/halt (exit-code)\0A  (syscall linux/SYS_exit exit-code))\0A\0A(define *initial-break* 0)\0A(define *current-break* 0)\0A\0A(define-function platform/acquire-memory/via-brk (size)\0A  ;; https://gist.github.com/nikAizuddin/f4132721126257ec4345\0A  (unless *initial-break*\0A    (set *current-break* (set *initial-break* (syscall linux/SYS_brk 0)))\0A    ;; TODO too early, ASSERT and ERROR is not functional at this point\0A    ;;(assert (< 0 *current-break*))\0A    )\0A  (let ((new-break\09(syscall linux/SYS_brk (+ *current-break* size)))\0A        (result\09\09*current-break*))\0A    (when (= new-break *current-break*)\0A      (platform/diag-print \22SYS_brk failed, aborting\22)\0A      (platform/halt 39))\0A    (set *current-break* new-break)\0A    ;; KLUDGE we make all allocated memory executable.\0A    ;; `make test-elf` generates machine code and wants to call it...\0A    (syscall linux/SYS_mprotect *initial-break*\0A             (- *current-break* *initial-break*)\0A             (+ (+ linux/PROT_READ linux/PROT_WRITE)\0A                linux/PROT_EXEC))\0A    result))\0A\0A;; KLUDGE whose only role is to keep gc/read-only-object?\0A;; working. it requires the heap to lie above the static image,\0A;; but mmap(0) picks from the top of the address space, which on\0A;; 32-bit targets lies above 2^31, i.e. it compares negative against\0A;; the image. hence the hint: right above the image (the program\0A;; break), grown as we allocate. it's a delme...\0A(define *mmap-hint* 0)\0A\0A;; the kernel hands us the page size in the auxv; parsed in _start\0A(define *kernel-page-size* 0)\0A\0A;; i386 doesn't have SYS_mmap (its old variant takes a pointer to an\0A;; arg struct), only SYS_mmap2, whose offset argument counts in units\0A;; of 4096 bytes. we always pass 0 as the offset, so they are\0A;; equivalent here.\0A(define-constant linux/SYS_mmap*\0A  (case target/arch\0A    (IA-32\09'linux/SYS_mmap2)\0A    (else\09'linux/SYS_mmap)))\0A\0A(define-function platform/acquire-memory/via-mmap (size)\0A  ;; KLUDGE we make all allocated memory executable.\0A  ;; `make test-elf` generates machine code and wants to call it...\0A  ;;\0A  ;; We don't let the kernel choose the address (it would map us into\0A  ;; its mmap area, which can lie below our static image, e.g. under\0A  ;; qemu-user with a guest ld.so), but hand out consecutive chunks\0A  ;; starting right above the binary's break. this way all heap memory\0A  ;; stays above the static image, keeping the invariant of\0A  ;; gc/read-only-object? intact. MAP_FIXED_NOREPLACE ensures that we\0A  ;; don't clobber anything that might have been mapped there in the\0A  ;; meantime (needs linux 4.17+).\0A  (unless *mmap-hint*\0A    (set *mmap-hint* (align-address-up (syscall linux/SYS_brk 0)\0A                                       *kernel-page-size*)))\0A  (set size (align-address-up size *kernel-page-size*))\0A  (let ((result\09(syscall linux/SYS_mmap*\0A                         *mmap-hint*\09\09\09; addr\0A                         size\09\09\09\09; length\0A                         (+ (+ linux/PROT_READ linux/PROT_WRITE)\0A                            linux/PROT_EXEC)\0A                         (+ (+ linux/MAP_PRIVATE linux/MAP_ANONYMOUS)\0A                            linux/MAP_FIXED_NOREPLACE)\0A                         -1\09\09\09\09; fd\0A                         0)))\09\09\09\09; offset\0A    ;; NOTE the raw syscall returns -errno on failure (libc's\0A    ;; MAP_FAILED == -1 doesn't apply here).\0A    (when (< result 0)\0A      (platform/diag-print \22SYS_mmap failed, aborting\22)\0A      (platform/halt 40))\0A    (set *mmap-hint* (+ *mmap-hint* size))\0A    result))\0A\0A(define-function platform/acquire-memory (size)\0A  ;; the brk based allocator remains the default: it grows the heap\0A  ;; right above the binary's static image, which keeps the assumption\0A  ;; of gc/read-only-object? (all heap memory lies above the static\0A  ;; image) true even in environments where the mmap area is not (see\0A  ;; via-mmap's comment). swap the call below to try the mmap based\0A  ;; allocator.\0A  (platform/acquire-memory/via-brk size))\0A\0A(eval-in-host '(load \22source/platforms/linux/syscall.l\22))\0A\0A;; https://clang.llvm.org/docs/UsersManual.html#freestanding-builds\0A\0A;; let's declare a memset function because clang -O can emit\0A;; references to it (and memcpy and memmove) even with `clang\0A;; -nostdlib -nostartfiles -ffreestanding -Wl,-Bstatic`.\0A\0A;; So even if your handwritten code never mentions strlen, LLVM might:\0A;;   - Recognize an strlen impl in the IR and turn it to an strlen call.\0A;;   - Emit a call to strlen (libc function) during lowering to\0A;;     AArch64 assembly/object code.\0A(eval-in-host\0A '(define *llvm-platform-specific-prelude*\0A   \22\0Adefine weak dso_local ptr @memset(ptr %dst, i32 %val, %word %len) {\0Aentry:\0A  %end = getelementptr i8, ptr %dst, %word %len\0A  %val8 = trunc i32 %val to i8\0A  br label %loop\0A\0Aloop:\0A  %cur = phi ptr [ %dst, %entry ], [ %next, %store ]\0A  %done = icmp eq ptr %cur, %end\0A  br i1 %done, label %exit, label %store\0A\0Astore:\0A  store i8 %val8, ptr %cur\0A  %next = getelementptr i8, ptr %cur, %word 1\0A  br label %loop\0A\0Aexit:\0A  ret ptr %dst\0A}\0A\0Adefine weak dso_local i64 @strlen(ptr %str) {\0Aentry:\0A  br label %loop\0A\0Aloop:\0A  ; %cur starts as %str, then advances by 1 each iteration\0A  %cur = phi ptr [ %str, %entry ], [ %next, %loop ]\0A\0A  %ch = load i8, ptr %cur\0A  %zero = icmp eq i8 %ch, 0\0A  %next = getelementptr i8, ptr %cur, i64 1\0A  br i1 %zero, label %exit, label %loop\0A\0Aexit:\0A  %endptr = phi ptr [ %cur, %loop ]\0A  %start = ptrtoint ptr %str to i64\0A  %end   = ptrtoint ptr %endptr to i64\0A  %len   = sub i64 %end, %start\0A  ret i64 %len\0A}\0A\22))\0A\0A;; aka `extern char **environ` in libc land\0A(define %envp)\0A\0A;; the API we use\0A(define-function posix/envp ()\0A  %envp)\0A\0A;; auxv is (a_type a_val) machine-word pairs, terminated by an AT_NULL pair\0A(define-function %parse-kernel-page-size (auxv)\0A  (let ((i 0))\0A    (until (= (oop-at auxv i) linux/AT_NULL)\0A      (when (= (oop-at auxv i) linux/AT_PAGESZ)\0A        (set *kernel-page-size* (oop-at auxv (+ i 1))))\0A      (incr i 2))\0A    (unless (< 0 *kernel-page-size*)\0A      (platform/diag-print \22AT_PAGESZ not found in the auxv, aborting\22)\0A      (platform/halt 41))))\0A\0A;; https://www.muppetlabs.com/~breadbox/software/tiny/teensy.html\0A;; http://www.dbp-consulting.com/tutorials/debugging/linuxProgramStartup.html\0A;; https://0xax.gitbooks.io/linux-insides/content/Misc/linux-misc-4.html\0A;; https://stackoverflow.com/questions/50260855/how-get-arguments-value-using-inline-assembly-in-c-without-glibc\0A;; i386: https://sourceware.org/git/?p=glibc.git;a=blob;f=sysdeps/i386/start.S;h=91035fa83fb7ee38a0ca5834ba1d215b4a7f78e8;hb=HEAD\0A;; x86_64: https://sourceware.org/git/?p=glibc.git;a=blob;f=sysdeps/x86_64/start.S;h=354d2e6ec78f0eaf9ab0f8ed665c2e5499388df0;hb=HEAD\0A;; argc and argv position on the stack: https://briancallahan.net/blog/20200808.html\0A;;\0A;; auxv, ELF auxiliary vector: contains information about the memory page size, metadata from the ELF file, etc\0A;;   https://amit.prasad.me/blog/before-main\0A;;   How programs get run: ELF binaries\0A;;   https://lwn.net/Articles/631631/\0A(define-function _start ()\0A  ;; too early for this: (debug (platform/diag-print \22_start is alive\5Cn\22))\0A\0A  ;; Stack layout, High memory\0A  ;; +---------------------+\0A  ;; | auxv[0].a_type = 0  | ; some AT_NULL nonsense, #defined as 0\0A  ;; | auxv[0].a_val = 0   |\0A  ;; +---------------------+\0A  ;; | ...                 |\0A  ;; +---------------------+\0A  ;; | auxv[0].a_type      |\0A  ;; | auxv[0].a_val       |\0A  ;; +---------------------+\0A  ;; | NULL                |\0A  ;; +---------------------+\0A  ;; | ...                 |\0A  ;; +---------------------+\0A  ;; | envp pointers       | key=value strings\0A  ;; +---------------------+\0A  ;; | NULL                |\0A  ;; +---------------------+\0A  ;; | ... (argc times)    |\0A  ;; +---------------------+\0A  ;; | argv[0]             |\0A  ;; +---------------------+\0A  ;; | argc (int)          | <-- stack pointer points to argc\0A  ;; +---------------------+\0A  ;; Lower memory\0A\0A  (let* ((sp (stack-pointer-on-entry))\0A         (argc (oop-at sp 0))\0A         (argv (+ sp (words-to-bytes 1)))\0A         (envp (+ argv (words-to-bytes (+ argc 1)))))\0A    (set %envp envp)\0A    ;; the auxv follows the envp array's NULL terminator\0A    (let ((cursor envp))\0A      (until (= 0 (oop-at cursor 0))\0A        (set cursor (+ cursor (words-to-bytes 1))))\0A      (%parse-kernel-page-size (+ cursor (words-to-bytes 1))))\0A    (syscall linux/SYS_exit (main argc argv))))\0A\00"

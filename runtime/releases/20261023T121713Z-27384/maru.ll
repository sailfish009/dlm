@m_cstr1847 = private unnamed_addr constant [1357 x i8] c";;; -*- mode: lisp; coding: us-ascii -*-\0A;;; Small POSIX file operations for native, transactional session snapshots.\0A;;; Constants are Linux x86-64 syscall ABI values, not libc dependencies.\0A(define-constant linux/session-SYS-flock 73)\0A(define-constant linux/session-SYS-rename 82)\0A(define-constant linux/session-SYS-unlink 87)\0A(define-constant linux/session-LOCK-EX-NB 6)\0A\0A;; () means ENOENT only; other failures are negative errno values.\0A(define-vm-function file-open-read ((path <string>))\0A  (let ((fd (posix/open (string->C-string path) linux/O_RDONLY posix/default-file-mode)))\0A    (if (>= fd 0) (box <lower-cell> fd)\0A      (if (= fd (- linux/ENOENT)) () (box <long> fd)))))\0A\0A(define-vm-function file-lock ((path <string>))\0A  (let ((fd (posix/open (string->C-string path)\0A                       (bitwise-or linux/O_RDWR linux/O_CREAT) posix/default-file-mode)))\0A    (if (< fd 0) ()\0A      (if (= 0 (syscall linux/session-SYS-flock fd linux/session-LOCK-EX-NB))\0A          (box <lower-cell> fd)\0A        (begin (posix/close fd) ())))))\0A\0A(define-vm-function file-replace ((from <string>) (to <string>))\0A  (to-upper-boolean (= 0 (syscall linux/session-SYS-rename\0A    (string->C-string from) (string->C-string to)))))\0A\0A(define-vm-function file-remove ((path <string>))\0A  (to-upper-boolean (= 0 (syscall linux/session-SYS-unlink (string->C-string path)))))\0A\00"

n equal (a b)\0A  (or (= a b)\0A      (and (pair? a)\0A           (pair? b)\0A           (equal-lists a b))))\0A\0A;;; math\0A\0A(define-form incr (lval . options)\09`(set ,lval (+ ,lval ,(or (car options) 1))))\0A(define-form decr (lval . options)\09`(set ,lval (- ,lval ,(or (car options) 1))))\0A\0A(define-function max (a . rest)\09(list-do b rest (set a (if (> b a) b a))) a)\0A(define-function min (a . rest)\09(list-do b rest (set a (if (< b a) b a))) a)\0A(define-function sum (a . rest)\09(list-do b rest (incr a b)) a)\0A(define-function zero? (val) (= 0 val))\0A\0A(require \22source/sequences-basic.l\22)\0A\0A;;; configuration\0A\0A(define-form feature (name)\0A  ;; TODO make this nicer/simpler\0A  (let ((feature-name (concat-symbol 'feature/ name)))\0A    `(when (defined? ',feature-name) (eval ',feature-name))))\0A\0A(define-form set-feature (name value-form)\0A  (let ((var-name (concat-symbol 'feature/ name))\0A        (value (eval value-form *env*)))\0A    (assert (symbol? var-name))\0A    ;; this is effectively a DEFINE-SYMBOL-FORM\0A    `(environment-define *globals* ',var-name ,(form () (lambda _ value)))))\0A\0A(define-form when-feature (feature . true-forms)\0A  `(when-at-expand (feature ,feature)\0A     ,@true-forms))\0A\0A(define-form if-feature (feature true-form . false-forms)\0A  `(if-at-expand (feature ,feature)\0A       ,true-form\0A     ,@false-forms))\0A\0A(set (feature profiler)\09\09\09(when (defined? 'feature/profiler/build)\0A                                          (eval 'feature/profiler/build)))\0A(set (feature profiler/cumulative)\09true) ; walk the stack and increment everyone found\0A(set (feature debug-info)\09\09true)\0A(set (feature track-expr-names)\09\09(or (feature debug-info) (feature profiler)))\0A(set (feature typecheck-slot-access)\09(or (<= 3 *safety*)\0A                                            (and (<= 2 *safety*) (<= *optimised* 0))))\0A(set (feature debug-output)\09\09(or () (<= 3 *safety*)))\0A\0A(require \22source/
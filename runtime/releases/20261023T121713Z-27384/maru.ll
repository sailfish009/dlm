tion list-reverse (lst)\0A  (let ((result ()))\0A    (while (pair? lst)\0A      (push result (pop lst)))\0A    result))\0A\0A(define-function list-reverse! (head)\0A  (let ((curr head)\0A        (prev ())\0A        (next ()))\0A    (while curr\0A      (set next (cdr curr))\0A      (set (cdr curr) prev)\0A      (set prev curr)\0A      (set curr next))\0A    prev))\0A\0A(define-function list-find-if (predicate lst)\0A  (let (result)\0A    (while (and lst (not result))\0A      (when (predicate (car lst))\0A        (set result (car lst)))\0A      (set lst (cdr lst)))\0A    result))\0A\0A(define-function map1 (function list)\0A  (let ((head (cons)))\0A    (let ((tail head))\0A      (while (pair? list)\0A        (set tail (set (cdr tail) (cons (function (car list)) ())))\0A        (set list (cdr list))))\0A    (cdr head)))\0A\0A(define-function mapN (function lists)\0A  (and (pair? (car lists))\0A       (cons (apply function (map1 car lists))\0A             (mapN function (map1 cdr lists)))))\0A\0A(define-function map (function . lists)\0A  (if (pair? (cdr lists))\0A      (mapN function lists)\0A    (map1 function (car lists))))\0A\0A(define-function map-with (function list a)\0A  (if (pair? list)\0A      (let ((head (function (car list) a)))\0A        (cons head (map-with function (cdr list) a)))))\0A\00"

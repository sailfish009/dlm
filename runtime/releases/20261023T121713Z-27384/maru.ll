@m_cstr1851 = private unnamed_addr constant [6443 x i8] c";;; -*- mode: lisp; coding: us-ascii -*-\0A\0A(require \22source/streams-min.l\22)\0A\0A;; TODO not sure whether this technique of (address-of char) is\0A;; digestable for LLVM. it's a KLUDGE anyway...\0A\0A;; An internally used posix/foo API.\0A(define-function posix/open (path flags mode)\0A  (syscall linux/SYS_openat linux/AT_FDCWD path\0A           flags mode))\0A\0A(define-function posix/close (fd)\0A  (syscall* linux/SYS_close fd))\0A\0A(define-function posix/read-byte (fd)\0A  (let ((byte 0)\0A        rc)\0A    ;; man 2 read\0A    (while (= (- linux/EINTR)\0A              (set rc (syscall linux/SYS_read fd (address-of byte) 1)))\0A      ;; then try again\0A      )\0A    (case rc\0A      (0\09-1)\0A      (1\09byte)\0A      (else\09(- rc)))))\0A\0A(define-function posix/write (fd buf length)\0A  (let (rc)\0A    (while (= (- linux/EINTR)\0A              (set rc (syscall linux/SYS_write fd buf length)))\0A      ;; then try again\0A      )\0A    rc))\0A\0A;;;\0A;;; files\0A;;;\0A\0A;; TODO reaname these to file/open?\0A(define-vm-function file-open ((path <string>) (mode <string>))\0A  (let ((fd (posix/open (string->C-string path)\0A                        (cond\0A                          ((or (not mode)\0A                               (string= mode \22r\22))\0A                           linux/O_RDONLY)\0A                          ((string= mode \22rw\22)\0A                           (bitwise-or linux/O_RDWR\0A                                       (bitwise-or linux/O_CREAT\0A                                                   linux/O_TRUNC)))\0A                          ((string= mode \22w\22)\0A                           (bitwise-or linux/O_WRONLY\0A                                       (bitwise-or linux/O_CREAT\0A                                                   linux/O_TRUNC)))\0A                          (else\0A                           (error \22file-open: unexpected mode \22mode\22 while opening
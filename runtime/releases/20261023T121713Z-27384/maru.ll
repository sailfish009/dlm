@m_cstr1795 = private unnamed_addr constant [18194 x i8] c";;; -*- mode: lisp; coding: us-ascii -*-\0A\0A(require \22source/conversion-min.l\22)\0A\0A;; NOTE: not all of them are in this file.\0A\0A(define-vm-function (define () fixed) ((variable <variable>) value-form)\0A  (let ((value (eval value-form -ctx-)))\0A    (set (<variable>-value variable) value)\0A    ;; maybe set the <expr>'s name slot\0A    (when-at-expand (feature track-expr-names)\0A      (let ((tmp value))\0A        (when (is <form> tmp)\0A          (set tmp (<form>-function tmp)))\0A        (when (and (is <expr> tmp)\0A                   (not (<expr>-name tmp)))\0A          (set (<expr>-name tmp) (<variable>-name variable)))))\0A    value))\0A\0A;; TODO ideally, but it needs a gc/let*:(define-vm-function (eval ()) (form (env <env> (environment *globals* 1 0)))\0A(define-vm-function (eval ()) _\0A  (let ((env (if (cdr -args-) ; let's fail early when called with nil env\0A                 (cadr -args-)\0A               *globals*)))\0A    (let ((toplevel-env?\09(= 0 (unbox <long> (<env>-level env))))\0A          (prev-globals\09*globals*)\0A          result)\0A      (when toplevel-env?\0A        (set-current-globals env))\0A      (set result (gc/let* ((child-env (environment env 1 0)))\0A                    ;; TODO resolve this naming anomaly somehow\0A                    (expand-encode-eval* (car -args-) child-env)))\0A      (when toplevel-env?\0A        (set-current-globals prev-globals))\0A      result)))\0A\0A(define-vm-function (lambda () fixed) ((env <env>) parameters . body)\0A  (assert (or (not parameters) (is <variable> parameters) (pair? parameters)) \22lambda vm-function: parameters is of wrong type: \22 parameters)\0A  (expr parameters body env -ctx-))\0A\0A(define-vm-function (let () fixed) (env bindings . body)\0A  (let ((locals (<context>-bindings -ctx-)))\0A    (gc/let* (tmp)\0A      (list-do binding bindings\0A        (when (pair? binding)\0A          (let ((var  (get/head binding))\0
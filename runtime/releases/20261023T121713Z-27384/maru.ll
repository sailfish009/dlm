@m_cstr1911 = private unnamed_addr constant [24014 x i8] c";;; -*- mode: lisp; coding: us-ascii -*-\0A\0A;;;\0A;;; types\0A;;;\0A;;;\0A;;; type-id-of: returns the type-id that the target VM is working with,\0A;;; i.e. the \22level-shifted name\22 of the type (an integer).\0A;;;\0A;;; type-of: returns a maru record holding the metadata for that type\0A;;; (i.e. its name, type-id, etc).\0A;;;\0A;;; the <foo> global definitions are also holding full maru type objects.\0A\0A(define-form is (type obj)\0A  ;; TODO use subtype? because this ignores inheritance\0A  `(= ,type (type-of ,obj)))\0A\0A(assert (not (= 'not-yet-bootstrapped type-of)))\0A\0A(define type-id-of type-of) ; we will replace type-of later\0A(define type-of 'not-yet-bootstrapped)\0A\0A(define %first-type-id\09\091) ; i.e. the first allocated type will be 1 (so that we can assert for non-zero type in the gc)\0A(define %last-type-id\09\09(- %first-type-id 1))\0A(define %types\09\09\09(array 16))\0A\0A(define-form types-do (var . body)\0A  `(for (__i__ %first-type-id %last-type-id)\0A     (let ((,var (array-at %types __i__)))\0A       ,@body)))\0A\0A(if-at-expand bootstrapping?\0A    (let ()\0A      ;; integrate with the host vm's type machinery to instantiate slave objects\0A      ;; in the framework of the host while we are being bootstrapped.\0A      (define-function allocate-type-id ()\0A        (eval-in-host '(allocate-type-id)))\0A\0A      (define-function allocate-type-id/slave ()\0A        (incr %last-type-id))\0A\0A      (define %type-id-map/host->slave (array 16)))\0A\0A  (define-function allocate-type-id ()\0A    (incr %last-type-id)))\0A\0A(define-function %make-accessor-forms (type-name slot-names slot-index raw-slot-access?)\0A  (when slot-names\0A    (cons (let* ((slot-name (car slot-names))\0A                 (accessor-name (concat-symbol type-name (concat-symbol '- slot-name))))\0A            (if raw-slot-access?\0A                `(define-form ,accessor-name (obj)\0A                   (list 'oop-at obj ,slot-index))\0A              `(define-form ,accessor-name (obj)\0A                 (list 'slot-value ',type-name ',slot-name obj))))\0A          (%make-accessor-forms type-name (cdr slot-names) (+ 1 slot-index) raw-slot-access?))))\0A\0A(define <type>)\0A(define <record>)\0A\0A(if-at-expand bootstrapping?\0A    (let ()\0A      ;; if we want to e.g. use the host's multimethods on the slave's types\0A      ;; (for example in the compiler) while we are being bootstrapped, then\0A      ;; we need to \22bind\22 the slave's <type> and <record> to their\0A      ;; respective versions in the host.\0A      (define type-id-of-<type>\09\09(eval-in-host '(<type>-id <type>)))\0A      (define type-id-of-<record>\09(eval-in-host '(<type>-id <record>)))\0A      (define slots-of-<type>\09\09(eval-in-host '(<record>-direct-slots <type>)))\0A      (define slots-of-<record>\09\09(eval-in-host '(<record>-direct-slots <record>))))\0A\0A  (define type-id-of-<type>\09\09(allocate-type-id))\0A  (define type-id-of-<record>\09\09(allocate-type-id))\0A  (define slots-of-<type>\09\09'(id name))\0A  (define slots-of-<record>\09\09'(super direct-slots effective-slots)))\0A\0A;; define temporary, non-typechecking accessors for <type> and <record>\0A(eval `(let ()\0A         ,@(%make-accessor-forms\09'<type>\09\09slots-of-<type>\09\090\09\09\09\09true)\0A         ,@(%make-accessor-forms\09'<record>\09slots-of-<record>\09(list-length slots-of-<type>)\09true)))\0A\0A(assert <type>-name)\0A\0A(if-at-expand bootstrapping?\0A;;;\0A;;; bootstrap is happening, i.e. <type> and <record> is mapped into the slave from the host in early.l\0A;;;\0A    (let ()\0A      (set <type>\09\09(eval-in-host '<type>))\0A      (set <record>\09\09(eval-in-host '<record>))\0A\0A      (let ((slave-id (allocate-type-id/slave)))\0A        (set (array-at %type-id-map/host->slave (<type>-id <type>)) slave-id)\0A        (set (array-at %types slave-id) <type>))\0A\0A      (let ((slave-id (allocate-type-id/slave)))\0A        (set (array-at %type-id-map/host->slave (<type>-id <record>)) slave-id)\0A        (set (array-at %types slave-id) <record>))\0A\0A      (define-function <type>-slave-id (type)\0A        (let* ((type-id  (<type>-id type))\0A               (slave-id (array-at %type-id-map/host->slave type-id)))\0A          (assert slave-id \22no host->slave mapping exists for host type-id: \22 type-id \22?!\22)\0A          slave-id))\0A\0A      (define-function register-type (type)\0A        ;; while bootstrapping we instantiate types in the host (so that we can use e.g. method dispatch),\0A        ;; and keep an additional host-id->slave-id map.\0A        (let ((slave-id\09(allocate-type-id/slave))\0A              (host-id\09(<type>-id type)))\0A          (verbosity 3 (warn \22register-type: \22type\22, \22host-id\22 -> \22slave-id\22\5Cn\22))\0A          (set (array-at %type-id-map/host->slave host-id) slave-id)\0A          (set (array-at %types slave-id) type)\0A          (eval-in-host `(register-type ',type))))\0A\0A      (define-function type-object-for-id (host-id)\0A        (or (array-at %types (let ((slave-id (array-at %type-id-map/host->slave host-id)))\0A                               ;; we could make this smarter and only do the remap when there's an entry...\0A                               ;; but do we want to? wouldn't that hide some nasty bugs?\0A                               (assert slave-id \22type-object-for-id: no host->slave mapping exists for host type-id: \22host-id\22, type: \22(array-at %types host-id))\0A                               slave-id))\0A            (error \22type-object-for-id has failed for type id \22host-id\22, known types are: \22%types))))\0A;;;\0A;;; we are not being bootstrapped, therefore we need to instantiate <type> and <record> ourselves\0A;;;\0A  (define-function register-type (type)\0A    (set (array-at %types (<type>-id type)) type))\0A\0A  (define-function type-object-for-id (type-id)\0A    (or (array-at %types type-id)\0A        (error \22type-object-for-id has failed for type id \22type-id\22, known types are: \22%types)))\0A\0A  (define-function %bootstrap-type (type-name type-id type-type-id slot-count)\0A    (let ((type-obj (allocate type-type-id slot-count)))\0A      (set (<type>-id\09type-obj)\09type-id)\0A      (set (<type>-name\09type-obj)\09type-name)\0A      (register-type type-obj)\0A      type-obj))\0A\0A  (define-function %bootstrap-record (type-name type-id super direct-slots)\0A    (let ((type-obj (%bootstrap-type type-name type-id type-id-of-<record> (+ (list-length slots-of-<type>)\0A                                                                              (list-length slots-of-<record>)))))\0A      (set (<record>-super\09\09type-obj)\09\09super)\0A      (set (<record>-direct-slots\09type-obj)\09\09direct-slots)\0A      (set (<record>-effective-slots\09type-obj)\09\09'not-yet-bootstrapped)\0A      type-obj))\0A\0A  (set <type>\09(%bootstrap-record '<type>\09\09type-id-of-<type>\09()\09slots-of-<type>))\0A  (set <record>\09(%bootstrap-record '<record>\09\09type-id-of-<record>\09<type>\09slots-of-<record>)))\0A\0A(assert (and <type> <record>))\0A(assert (= (<type>-id <type>) %first-type-id))\0A(assert (= (<type>-id <record>) (+ %first-type-id 1)))\0A\0A(assert (= (type-object-for-id (<type>-id <type>)) <type>))\0A(assert (= (type-object-for-id (<type>-id <record>)) <record>))\0A\0A(verbosity 2\0A  (warn \22<type> is instantiated: \22\09<type>\09\09\22, id: \22\09(<type>-id <type>)\22\5Cn\22)\0A  (warn \22<record> is instantiated: \22\09<record>\09\22, id: \22\09(<type>-id <record>)\22\5Cn\22))\0A\0A(assert (= 'not-yet-bootstrapped type-of))\0A\0A(define-function type-of (obj)\0A  (type-object-for-id (type-id-of obj)))\0A\0A(assert (not (= 'not-yet-bootstrapped type-of)))\0A(assert (= (type-of <type>) <record>))\0A(assert (= (type-of <record>) <record>))\0A\0A(define-function name-of-type (type)\0A  (<type>-name type))\0A\0A(define-function type-name-of (obj)\0A  (name-of-type (type-of obj)))\0A\0A(define subtype?) ; forward\0A\0A(define-function record-inherits-from? (type super)\0A  (and type\0A       (or (= type super)\0A           (and (subtype? (type-of type) <record>)\0A                (record-inherits-from? (<record>-super type) super)))))\0A\0A(define-function subtype? (subtype supertype)\0A  (assert (and subtype supertype))\0A  (or (= subtype supertype)\0A      (record-inherits-from? subtype supertype)))\0A\0A(assert (subtype? (type-of <type>) <record>))\0A(assert (subtype? <record> <type>))\0A(assert (not (subtype? <type> <record>)))\0A\0A(define-function sanity-check-record-slots (record slots)\0A  (let ((f slots))\0A    (while (pair? f)\0A      (unless (symbol? (car f))\0A        (error \22slot is not symbol?: \22(car f)))\0A      (when (member? (car f) (cdr f))\0A        (error \22slot '\22(car f)\22' multiply-defined in record: \22record\22 \22slots))\0A      (set f (cdr f)))))\0A\0A(define-function %record/compute-effective-slots (type)\0A  (and type\0A       (subtype? (type-of type) <record>)\0A       (concat-list (%record/compute-effective-slots (<record>-super type))\0A                    (<record>-direct-slots type))))\0A\0A(define-function record/compute-effective-slots (type)\0A  ;;(print \22record/compute-effective-slots for type \22 (<type>-name type) \22 of type \22 (<type>-name (type-of type)) \22 ?= <record>\22 (= type <record>) \22\5Cn\22) ; TODO delme\0A  (assert (subtype? (type-of type) <record>) \22record/compute-effective-slots called with a non-record type \22 type)\0A  (let ((slots (%record/compute-effective-slots type)))\0A    (sanity-check-record-slots type slots)\0A    slots))\0A\0A(when-at-expand (not bootstrapping?)\0A  (set (<record>-effective-slots <type>)\09(record/compute-effective-slots <type>))\0A  (set (<record>-effective-slots <record>)\09(record/compute-effective-slots <record>)))\0A\0A(assert (equal slots-of-<type> (<record>-effective-slots <type>)))\0A(assert (equal (concat-list slots-of-<type> slots-of-<record>) (<record>-effective-slots <record>)))\0A\0A(define-function record/effective-slot-count (type)\0A  (list-length (<record>-effective-slots type)))\0A\0A(define-function record/slot-index (type slot-name)\0A  (assert (is <record> type))\0A  (let ((i 0)\0A        (list (<record>-effective-slots type)))\0A    (while (and (pair? list)\0A                (not (= slot-name (car list))))\0A      (set list (cdr list))\0A      (incr i))\0A    (or (and (pair? list)\0A             i)\0A        (error \22record-slot-index has failed for type \22type\22, slot-name \22slot-name))))\0A\0A;; now that <type> and <record> is instantiated, we can implement type checking in the accessors.\0A;; let's also redefine the basic accessors that we have defined earlier.\0A(define-function %accessor-typecheck (expected-type-id slot-name object)\0A  (unless (= (type-id-of object) expected-type-id)\0A    (let ((expected-type (type-object-for-id expected-type-id))\0A          (actual-type (type-of object)))\0A      (unless (subtype? actual-type expected-type)\0A        ;; (warn \22about to process an %accessor-typecheck failure, which may fail to properly print the error output\5Cnslot name is \22slot-name\22, expected-type-id is \22expected-type-id\22, object's actual type id is \22(type-id-of object)\22\5Cn\22)\0A        (error \22type check failed for record slot accessor: expected type \22expected-type\22, slot name \22slot-name\22, got \22 actual-type))))\0A  object)\0A\0A;; slot-value is a \22choke-point\22 that we can override while loading and expanding\0A;; the level-shifted code. see compile-begin for more details, or compiled peg parsers\0A;; that inhibit the expansion of slot-value while generating the maru code.\0A(define-form slot-value (type-name slot-name object)\0A  (let* ((type (eval type-name *env*))\0A         (slot-index (record/slot-index type slot-name)))\0A    `(oop-at\0A      ,(if (feature typecheck-slot-access)\0A           `(%accessor-typecheck ,(<type>-id type) ',slot-name ,object)\0A         object)\0A      ,slot-index)))\0A\0A;; sometimes (see e.g. compiled peg parsers) we prevent slot-value to get expanded to keep\0A;; the generated code a little less fragile to changes in the object layout. in those\0A;; situations, at a later time, when the generated code is expanded, we may\0A;; encounter set-slot-value forms, so let's provide them, too.\0A(define-form set-slot-value (type-name slot-name object value)\0A  (let* ((type (eval type-name *env*))\0A         (slot-index (record/slot-index type slot-name)))\0A    `(set-oop-at\0A      ,(if (feature typecheck-slot-access)\0A           `(%accessor-typecheck ,(<type>-id type) ',slot-name ,object)\0A         object)\0A      ,slot-index\0A      ,value)))\0A\0A(define-function type/slot-count-of-instances (type)\0A  (cond\0A    ((subtype? (type-of type) <record>)\09(record/effective-slot-count type))\0A    ((subtype? (type-of type) <type>)\090)\0A    (else\09\09\09\09(error \22type/slot-count-of-instances: called with something unexpected: \22 type))))\0A\0A(define-function %make-record-accessors (type raw-slot-access?)\0A  (assert (subtype? (type-of type) <record>) \22%make-record-accessors called with a non-record type \22 type)\0A  (%make-accessor-forms (<type>-name type)\0A                        (<record>-direct-slots type)\0A                        (or (and (<record>-super type)\0A                                 (subtype? (<record>-super type) <record>)\0A                                 (record/effective-slot-count (<record>-super type)))\0A                            0)\0A                        raw-slot-access?))\0A\0A;; redefine the preliminary bootstrap accessors with full featured ones\0A(eval `(let ()\0A         ,@(%make-record-accessors <type> false)\0A         ,@(%make-record-accessors <record> false)))\0A\0A(verbosity 2 (warn \22type registry is alive\5Cn\22))\0A\0A;;; at this point the type registry is bootstrapped, containing two types: <type> and <record>\0A\0A(assert (= (type-of <type>)\09<record>))\0A(assert (= (type-of <record>)\09<record>))\0A\0A(assert (= 2 (list-length (<record>-effective-slots <type>))))\0A(assert (= (+ 3 (list-length (<record>-effective-slots <type>))) (list-length (<record>-effective-slots <record>))))\0A\0A(define-function new-type-instance (name type)\0A  (assert (subtype? type <type>))\0A  (let ((id (allocate-type-id))\0A        (result (allocate (<type>-id type) (type/slot-count-of-instances type))))\0A    (verbosity 3 (warn \22new <type> instance: \22 name \22, id: \22 id\22\5Cn\22))\0A    (set (<type>-name\09result) name)\0A    (set (<type>-id\09result) id)\0A    (register-type result)\0A    result))\0A\0A(define-function new-<type> (name)\0A  (new-type-instance name <type>))\0A\0A(define-form define-type (name)\0A  (let ((type (new-<type> name)))\0A    ;; TODO we want this to be defined already when the upcoming forms get expanded. but it feels like a kludge...\0A    (eval `(define ,name ,type))\0A    `(define ,name ,type)))\0A\0A(define-function new-<record> (name super slots)\0A  (assert (or (not super) (and (not (pair? super)) (subtype? (type-of super) <type>))))\0A  (let ((type (new-type-instance name <record>)))\0A    (set (<record>-super\09\09type) super)\0A    (set (<record>-direct-slots\09\09type) slots)\0A    (set (<record>-effective-slots\09type) (record/compute-effective-slots type))\0A    type))\0A\0A;; args: name super slots . props\0A(define-form define-record (name . rest)\0A  (let ((super (pop rest))\0A        (slots (pop rest))\0A        (props rest))\0A    (set slots (map-with expand slots *env*))\0A    (set slots (list-remove () slots))\0A    (let ((record-type\09\09(new-<record> name (eval super) slots))\0A          (raw-slot-access?\09false))\0A      (list-do prop props\0A        (case prop\0A          (raw-slot-access\09(set raw-slot-access? true))\0A          (else\09\09\09(error \22define-record: unexpected property \22prop))))\0A      ;; so that it's already available at expand time...\0A      (eval `(define ,name ,record-type))\0A      ;; ...and at runtime.\0A      `(let ((type-obj ,record-type))\0A         (define ,name type-obj)\0A         ,@(%make-record-accessors record-type raw-slot-access?)\0A         type-obj))))\0A\0A;;; immediate type (i.e. a word with some tag bits)\0A\0A(define-record <immediate-type> <type> (tag-value tag-width))\0A\0A(define-function new-<immediate-type> (name tag-value tag-width)\0A  (let ((type (new-type-instance name <immediate-type>)))\0A    (set (<immediate-type>-tag-value\09type) tag-value)\0A    (set (<immediate-type>-tag-width\09type) tag-width)\0A    type))\0A\0A(define-form define-immediate (name tag-value tag-width)\0A  `(define ,name ,(new-<immediate-type> name (eval tag-value) (eval tag-width))))\0A\0A;;; boxed type (i.e. a full object with a header)\0A\0A(define-record <boxed-type> <type>\0A  ;; NOTE: it's possible to allocate heap objects of any length and\0A  ;; then set whatever type we want on them. so, it's possible to\0A  ;; e.g. allocate a large opaque object, put <symbol> as its type,\0A  ;; and memcpy an arbitrary long cstring into the object payload.\0A\0A  ;; TODO this ONE-WORD? thing is silly. either rename to\0A  ;; SINGLE-WORD?, or come up with some alternative that generalizes\0A  ;; better. how could (box <some-boxed-type> payload) work when the\0A  ;; payload is not a single word, but something longer that needs to\0A  ;; be memcpy'd into the object's body? maybe payload should then be\0A  ;; a lisp <array> whose elements get copied?\0A  (one-word?))\0A\0A(define-function new-<boxed-type> (name one-word?)\0A  (let ((type (new-type-instance name <boxed-type>)))\0A    (set (<boxed-type>-one-word? type) one-word?)\0A    type))\0A\0A;; TODO rename to define-boxed-cell, or maybe define-boxed-cell-type\0A(define-form define-boxed-word (name)\0A  `(define ,name ,(new-<boxed-type> name true)))\0A\0A(define-form define-boxed (name)\0A  `(define ,name ,(new-<boxed-type> name false)))\0A\0A;;; classes\0A\0A(define-form define-class (name basis fields)\0A  ;; TODO source-level compatibility. decide whether to delme.\0A  ;; TODO accessor regression: there used to be <peg>-result, now there's only a <parser>-result (inheritance)\0A  `(define-record ,name ,basis ,fields))\0A\0A;;; field accesors\0A\0A(define-function make-instance-accessors (var-name type-name slots)\0A  (when (pair? slots)\0A    (cons `(,(concat-symbols var-name '. (car slots))\0A             ()\0A             ((_)\0A              `(slot-value ,type-name ,(car slots) ,var-name)))\0A          (make-instance-accessors var-name type-name (cdr slots)))))\0A\0A;; Bind symbol macros for each slot on VAR-NAME.SLOT-NAME.  TODO is\0A;; this really what we want? instead of e.g. binding the slot names as\0A;; local variables?\0A(define-form with-instance-accessors (var-name type-name . body)\0A  (let ((accessors\09())\0A        (super\09\09(eval type-name *env*)))\0A    (while (is <record> super)\0A      (list-do accessor (make-instance-accessors var-name\0A                                                 (<type>-name super)\0A                                                 (<record>-direct-slots super))\0A        (push accessors accessor))\0A      (set super (<record>-super super)))\0A    `(with-forms ,accessors\0A       ,@body)))\0A\0A;;; constructors\0A\0A(define-form new (type-name . inits)\0A  (let* ((i -1)\0A         (type (eval type-name *env*))\0A         (allocate-form `(allocate ,(<type>-id type) ,(type/slot-count-of-instances type))))\0A    ;; TODO singletons for types whose instances have no slots?\0A    (if inits\0A        `(let ((_self_ ,allocate-form))\0A           ;; TODO the usefulness of this is questionable... delme and rename make to new?\0A           ,@(map (lambda (_init_)\0A                    (list 'set-oop-at '_self_ (incr i) _init_))\0A                  inits)\0A           _self_)\0A      allocate-form)))\0A\0A(define-form new* (type . inits)\0A  ;; this one doesn't need to know the type at expand-time\0A  (let ((i -1))\0A    `(let* ((_type_ ,type)\0A            (_self_ (allocate (<type>-id _type_)\0A                              (type/slot-count-of-instances _type_))))\0A       ,@(map (lambda (_init_) (list 'set-oop-at '_self_ (set i (+ i 1)) _init_)) inits)\0A       _self_)))\0A\0A(define-function %make-make-inits (env prefix inits)\0A  (when inits\0A    (let ((entry (first inits)))\0A      (when (= (first entry) 'when-at-expand) ; well, if we look at it as a DSL... or is it a KLUDGE?\0A        (set entry (expand entry env)))\0A      (when entry\0A        (cons `(set ,(concat-symbol prefix (first entry)) ,(second entry))\0A              (%make-make-inits env prefix (cdr inits)))))))\0A\0A(define-form make (type . inits)\0A  `(let ((self (new ,type)))\0A     (with-instance-accessors self ,type\0A       ,@(%make-make-inits *env* 'self. inits)\0A       self)))\0A\0A;;; built-in types\0A\0A;; NOTE the vm-functions provided by the eval executable assume\0A;; a certain memory layout for the built-in types.\0A;; what actually happens is encoded in the executable, and if you change any of these\0A;; then you need to bootstrap to reflect the changes in the next executable.\0A;; types are represented in the target as successive integers.\0A\0A;; NOTE these type definitions also encode the object layout in the\0A;; target, which may or may not be a good idea. maybe there should be\0A;; separate define-object-layout forms in the target code for that?\0A\0A;; TODO type objects and their accessors should be serialized into the\0A;; compiled binary and this should be wrapped in a big (when-at-expand\0A;; bootstrapping? ...). this would also reflect the fact that editing\0A;; these and bringing it out of sync with the level-shifted binary is\0A;; not an option without grave consequences. such a setup would\0A;; hopefully also simplify the bootstrapping dance above.\0A(define-type\09\09<data>)\09\09\09\09\09; some blob; used for stuff like the elements of <string> and <array>\0A\0A(define-immediate\09<undefined>\09\090 ())\09\09; nil tag-width means that it's an entire word of a well-known value; in this case zero\0A(if-at-expand true\0A  (define-immediate\09<long>\09\09\091 1)\0A  (define-boxed-word\09<long>))\09\09\09\09; provides a full-word integer, but bootstrap is about 25% slower\0A(define-record\09\09<fixed>\09\09\09() (function))\0A;;(define-boxed\09\09<symbol>)\09\09\09\09; a cstr is inline into the object's body\0A(define-record\09\09<symbol>\09\09() (name))\0A\0A(define-record\09\09<array>\09\09\09() (size elements)) ; an array of oop's\0A(define-record\09\09<memory-block>\09\09() (size elements)) ; an array of raw bytes\0A(define-record\09\09<string>\09\09() (size elements))\0A;; TODO rename body to program-code, or maybe machine-code is better\0A;; TODO harmonize name with <target-function>, but how? <function> and <t/function>\0A(define-record\09\09<expr>\09\09\09() (parameters body env ctx\0A                                                     (when-at-expand (feature track-expr-names)\09name)\0A                                                     (when-at-expand (feature profiler)\09\09profiler-counter)))\0A(define-record\09\09<form>\09\09\09() (function symbol))\09; these are expander lambda's\0A(define-record\09\09<variable>\09\09() (name value env index))\0A(define-record\09\09<env>\09\09\09() (parent level offset bindings stable\0A                                                     (when-at-expand (feature debug-info)\09\09name)))\0A(define-record\09\09<context>\09\09() (home env bindings callee))\0A(define-record\09\09<pair>\09\09\09() (head tail))\0A\0A;; a heap object with a function pointer, and optionally a name.\0A;; TODO rename to <lower-function>\0A(define-record <target-function> ()\0A  (program-code\0A   (when-at-expand (feature track-expr-names)\09name)\0A   (when-at-expand (feature profiler)\09\09profiler-counter)))\0A\0A;; a word/cell/pointer in the lower realm, boxed, so that it can be\0A;; stored in the maru heap.\0A(define-boxed-word <lower-cell>)\0A\0A(define-boxed-word <cell-64>)\0A\0A;; TODO why are some of these here, and some are vm-functions? unify one way or another!\0A;;(define-function undefined?\09(obj)\09(= <undefined>\09(type-of obj)))\0A(define-function long?\09\09(obj)\09(= <long>\09(type-of obj)))\0A(define-function expr?\09\09(obj)\09(= <expr>\09(type-of obj)))\0A(define-function variable?\09(obj)\09(= <variable>\09(type-of obj)))\0A\0A(when-at-expand bootstrapping?\0A  ;; host-slave leakage: let's map the following host types to their\0A  ;; respective slave equivalents, so that calling the slave's TYPE-OF\0A  ;; on one of their instances will return the slave type object\0A  ;; instead of that of the host's. this is mainly needed to\0A  ;; seamlessly interact with the data returned by the host's reader\0A  ;; while we are inside the slave; e.g. to be able to install\0A  ;; <selector> methods on these types in the slave, and expect them\0A  ;; to be called when e.g. DO-PRINT is called in the slave on some\0A  ;; source code returned by the host's reader.\0A  (list-do entry\0A           `((\22\22\09,<string>)\0A             (42\09,<long>)\0A             (t\09\09,<symbol>)\0A             ((1)\09,<pair>)\0A             (()\09,<undefined>)\0A             )\0A    (apply (lambda (instance type)\0A             (set (array-at %type-id-map/host->slave (type-id-of instance))\0A                  (<type>-slave-id type))\0A             (assert (= (type-of instance) type)))\0A           entry))\0A  (verbosity 2\0A    (warn \22host->slave type mapping:\5Cn\22)\0A    (types-do type\0A      (let ((id (<type>-id type)))\0A        (warn \22  \22type\22: \22 id \22 -> \22(array-at %type-id-map/host->slave id)\22\5Cn\22)))))\0A\00"

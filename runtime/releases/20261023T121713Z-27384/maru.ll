@m_cstr1787 = private unnamed_addr constant [5894 x i8] c";;; -*- mode: lisp; coding: us-ascii -*-\0A\0A;; NOTE this hides the one in source/types.l with a specialized\0A;; version for the target code.\0A\0A(define-form make (type-name . inits)\0A  (let ((type (eval type-name *env*)))\0A    `(gc/let* ((self (allocate ,(<type>-slave-id type)\0A                               ,(type/slot-count-of-instances type))))\0A       (with-instance-accessors self ,type-name\0A         ,@(%make-make-inits *env* 'self. inits)\0A         self))))\0A\0A;; TODO this should be done cleaner/nicer than a single-use macro\0A(define-form define-type-of ()\0A  (let ((conds-early\09())\0A        (conds-late\09()))\0A    (types-do type\0A      (when (is <immediate-type> type)\0A        (let* ((tag-value\09(<immediate-type>-tag-value type))\0A               (tag-width\09(<immediate-type>-tag-width type)))\0A          (if tag-width\0A              (let ((tag-mask (bitwise-not (- (bitwise-shift 1 tag-width)))))\0A                (push conds-late `((= ,tag-value (bitwise-and ptr ,tag-mask)) ,(<type>-name type))))\0A            (push conds-early `((= ,tag-value ptr) ,(<type>-name type)))))))\0A    `(define-function type-of (ptr)\0A       (cond\0A         ,@conds-early\0A         ;; strictly speaking, this should be a full OOP? call, but\0A         ;; that would include an unnecessary nil check\0A         ((aligned-to-oop? ptr)\0A\09  (let ((header (gc/header-of ptr)))\0A            (safety 3 (or (gc/valid-header-canary? header) (fatal \22type-of: encountered an untagged pointer: \22 (pointer ptr))))\0A            (safety 2 (or (gc/live-chunk? header) (fatal \22type-of: attempt to access dead object: \22 (pointer ptr))))\0A            (<header>-type header)))\0A         ,@conds-late\0A         (else (fatal \22type-of: encountered something unidentifiable: \22 (pointer ptr)))))))\0A\0A(define-type-of)\0A\0A(when-at-expand (feature optimize-speed)\0A  (define-form is (type-name obj)\0A    (let ((type (eval type-name *env*)))\0A      (cond\0A        ((is <record> type) ; NOTE: IS in the form bodies will resolve to the one in *slave-env*, regardless of our new definition of IS in the target module\0A         ;; TODO this ignores inheritance\0A         `(let ((__obj__ ,obj))\0A            (and (oop? __obj__)\0A                 (= ,(<type>-slave-id type)\0A                    (<header>-type (gc/header-of __obj__))))))\0A        ((is <immediate-type> type)\0A         (let* ((tag-value\09(<immediate-type>-tag-value type))\0A                (tag-width\09(<immediate-type>-tag-width type)))\0A           (if tag-width\0A               (let ((tag-mask (bitwise-not (- (bitwise-shift 1 tag-width)))))\0A                 `(= ,tag-value (bitwise-and ,obj ,tag-mask)))\0A             `(= ,tag-value ,obj))))\0A        (else\0A         `(= ,type-name (type-of ,obj)))))))\0A\0A(define-function %allocate-boxed-word (type-id payload)\0A  (let ((obj (gc/allocate-opaque type-id (words-to-bytes 1))))\0A    (set (oop-at obj 0) payload)\0A    obj))\0A\0A(define-form box (type-name payload)\0A  (let ((type (eval type-name)))\0A    (cond\0A      ((is <boxed-type> type)\0A       (assert (<boxed-type>-one-word? (eval type-name)) \22cannot know how to allocate a boxed type that is not one-word?\22)\0A       `(%allocate-boxed-word ,type-name ,payload))\0A      ((is <immediate-type> type)\0A       ;; TODO error when overflow\0A       `(bitwise-or (bitwise-shift ,payload ,(<immediate-type>-tag-width type))\0A                    ,(<immediate-type>-tag-value type)))\0A      (else\0A       (error \22box: don't know how to deal with \22type)))))\0A\0A(define-form unbox (type-name obj)\0A  (let ((type (eval type-name)))\0A    (cond\0A      ((is <boxed-type> type)\0A       (if (<boxed-type>-one-word? type)\0A           `(oop-at ,(if (feature typecheck-slot-access)\0A                         `(%accessor-typecheck ,(<type>-slave-id type) ,obj)\0A                       obj)\0A                    0)\0A         ;; then we just return its address, the payload is right there inlined\0A         (if (feature typecheck-slot-access)\0A             `(%accessor-typecheck ,(<type>-slave-id type) ,obj)\0A           obj)))\0A\0A      ((is <immediate-type> type)\0A       (if (< *safety* 2)\0A           `(bitwise-shift ,obj ,(- (<immediate-type>-tag-width <long>)))\0A         `(let ((__obj__ ,obj))\0A            (assert (is ,type-name __obj__))\0A            (bitwise-shift __obj__ ,(- (<immediate-type>-tag-width <long>))))))\0A\0A      (else\0A       (error \22unbox: don't know how to deal with \22type)))))\0A\0A(eval-in-slave\0A ;; \22export\22 these up into the syntax level, because the compiler\0A ;; wants to call them for e.g. dumping strings, and eval-in-target\0A ;; wouldn't work from there, because the target has non-evaluatable\0A ;; definitions for stuff like bitwise-shift and <long>.\0A `(let ()\0A    (define box\09\09,box)\0A    (define unbox\09,unbox)))\0A\0A;; shorthands (and optimizations)\0A(if-at-expand (feature optimize-space)\0A    (let ()\0A      (define-function long?\09(obj)\09(is <long>\09obj))\0A      (define-function pair?\09(obj)\09(is <pair>\09obj))\0A      (define-function string?\09(obj)\09(is <string>\09obj))\0A      (define-function symbol?\09(obj)\09(is <symbol>\09obj))\0A      (define-function array?\09(obj)\09(is <array>\09obj)))\0A  (define-form long?\09\09(obj)\09`(is <long>\09,obj))\0A  (define-form pair?\09\09(obj)\09`(is <pair>\09,obj))\0A  (define-form string?\09\09(obj)\09`(is <string>\09,obj))\0A  (define-form symbol?\09\09(obj)\09`(is <symbol>\09,obj))\0A  (define-form array?\09\09(obj)\09`(is <array>\09,obj)))\0A\0A;; TODO explain why these are needed, and how they are faster than the\0A;; accessor... or just get rid of them.\0A(define-form get/head\09\09(obj)\09\09(if (< *safety* 2)\09\09`(oop-at ,obj ,(record/slot-index <pair> 'head))\09`(<pair>-head ,obj)))\0A(define-form put/head\09\09(obj val)\09(if (< *safety* 2)\09    `(set-oop-at
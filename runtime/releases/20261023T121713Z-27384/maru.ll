@m_cstr1783 = private unnamed_addr constant [1621 x i8] c";;; -*- mode: lisp; coding: us-ascii -*-\0A;;; Opt-in, cooperative tasks in the EXISTING reader. No second parser or REPL.\0A;;; Task data live in the normal global environment and are traced by the GC.\0A(define-function repl-task-value (name)\0A  (maybe-variable-value *globals* (string->symbol name)))\0A\0A(define-vm-function repl-idle-task (expression (milliseconds <long> 1000))\0A  (unless (or (not expression) (pair? expression))\0A    (error \22repl-idle-task: expected an expression or ()\22))\0A  (unless (and (<= 20 milliseconds) (<= milliseconds 60000))\0A    (error \22repl-idle-task: interval must be 20..60000 ms\22))\0A  (set-variable-value *globals* (string->symbol \22*repl-task-interval*\22) (box <long> milliseconds))\0A  (set-variable-value *globals* (string->symbol \22*repl-task-expression*\22) expression)\0A  expression)\0A\0A(define-record <cooperative-input> <stream> (input output))\0A\0A(define-function cooperative-input (input output)\0A  (make <cooperative-input> (input input) (output output)))\0A\0A(define-method $peek <cooperative-input> ()\0A  (gc/let* ((task (repl-task-value \22*repl-task-expression*\22)))\0A    (while (not (platform/input-ready? self.input\0A                  (if task (unbox <long> (repl-task-value \22*repl-task-interval*\22)) -1)))\0A      (when task\0A        ($put self.output ?\5Cn)\0A        (expand-encode-eval task)\0A        ($put-all self.output \22maru> \22)\0A        (platform/flush-streams))\0A      (set task (repl-task-value \22*repl-task-expression*\22))))\0A  ($peek self.input))\0A\0A(define-method $next <cooperative-input> ()\0A  ($peek self)\0A  ($next self.input))\0A\0A(define-method $at-end? <cooperative-input> ()\0A  (= +end+ ($peek self)))\0A\00"

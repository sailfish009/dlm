;;; -*- mode: lisp; coding: us-ascii -*-
(define *s79-p* '(problem classical-prop-v1 ((p 0) (q 0))
  (sequent classical-prop-v1 ((pred p ())) ((and (pred p ()) (pred p ()))))))
(define *s79-a* (s79-proof-job (s79-new) 'a *s79-p*))
(set *s79-a* (s79-proof-job *s79-a* 'b *s79-p*))
(assert (= (dlm-nth (s79-job *s79-a* 'a) 4) (dlm-nth (s79-job *s79-a* 'b) 4)) "root subscribers share obligation")
(define *s79-done* (s79-run *s79-a* 500))
(assert (= (dlm-nth (dlm-nth (s79-job *s79-done* 'a) 5) 1) 'proved) "event AND proof")
(assert (equal *s79-done* (s79-run (s79-run *s79-a* 7) 493)) "event slice equivalence")
(assert (> (dlm-nth (dlm-nth *s79-done* 11) 1) 0) "repeated child shared")
(define *s79-studied* (e79-transition (s79-new) (list 'study 'study *s79-p*)))
(set *s79-studied* (s79-run *s79-studied* 1000))
(assert (dlm-nth *s79-studied* 8) "study learns actual subproofs")
(assert (dlm-nth *s79-studied* 12) "study names compound formula structure")
(define *s79-renamed* '(problem classical-prop-v1 ((r 0) (s 0))
  (sequent classical-prop-v1 ((pred r ())) ((and (and (pred r ()) (pred r ())) (imp (pred s ()) (pred s ())))))))
(define *s79-reused* (s79-run (s79-proof-job *s79-studied* 'transfer *s79-renamed*) 1000))
(assert (= (dlm-nth (dlm-nth (s79-job *s79-reused* 'transfer) 5) 1) 'proved) "new outer goal solved")
(assert (> (dlm-nth (dlm-nth *s79-reused* 11) 3) 0) "learned partial module used inside new goal")
(define *s79-program* (s79-program-job (s79-new) 'choices
 '((choose (((assume (pred p ()))
             (ask (problem classical-prop-v1 ((p 0)) (sequent classical-prop-v1 () ((pred p ())))))
             (bind x a) (suspend evidence) (accept first))
            ((bind x b) (require x a) (accept wrong)))))))
(set *s79-program* (s79-run *s79-program* 500))
(assert (not (= (dlm-nth (s79-job *s79-program* 'choices) 3) 'done)) "suspended successful branch retained")
(set *s79-program* (s79-run (s79-program-resume *s79-program* 'choices false) 500))
(assert (equal (dlm-nth (s79-job *s79-program* 'choices) 5)
  '(provisional first (context78 ((x a)) ((pred p ())) ()))) "Screamer context and G3 ask cooperate")
(define *s79-i* (s79-run (i79-interpolate (s79-new) 'i '((p 0) (q 0))
  '(and (pred p ()) (pred q ())) '(pred q ())) 1000))
(assert (= (dlm-nth (dlm-nth (s79-job *s79-i* 'i) 5) 1) 'verified) "proof-driven interpolation")
(define *s79-b* (s79-run (i79-beth (s79-new) 'beth '((p 0) (q 0))
 '(and (imp (pred p ()) (pred q ())) (imp (pred q ()) (pred p ()))) '(pred p ())) 5000))
(assert (= (dlm-nth (dlm-nth (s79-job *s79-b* 'beth) 5) 1) 'verified) "Beth on same event engine")
(set *s79-b* (s79-run (d79-use *s79-b* 'use 'beth '((pred q ()))) 5000))
(assert (= (dlm-nth (dlm-nth (s79-job *s79-b* 'use) 5) 1) 'proved) "Beth definition reused under its theory")
(define *s79-fresh* (d79-define (s79-new) 'pair '((p 0) (q 0)) '(and (pred p ()) (pred q ()))))
(set *s79-fresh* (s79-run (d79-use *s79-fresh* 'apply 'pair '((pred p ()) (pred q ()))) 1000))
(assert (= (dlm-nth (dlm-nth (s79-job *s79-fresh* 'apply) 5) 1) 'proved) "fresh definition explicit and unfolded certificates")
(define *s79-no-fact* (s79-run (d79-use (d79-define (s79-new) 'd '((p 0)) '(pred p ())) 'empty 'd ()) 500))
(assert (= (dlm-nth (dlm-nth (s79-job *s79-no-fact* 'empty) 5) 1) 'not-proved) "definition naming asserts no fact")
(define *s79-wide-left* (list '(and (pred p ()) (pred q ()))))
(times-do 255 (set *s79-wide-left* (dlm-append *s79-wide-left* (list '(top)))))
(define *s79-wide* (s79-run (s79-proof-job (s79-new) 'wide
  (list 'problem 'classical-prop-v1 '((p 0) (q 0)) (sq-sequent *s79-wide-left* '((pred q ()))))) 1000))
(assert (and (not (dlm-nth (s79-job *s79-wide* 'wide) 5))
             (= (dlm-nth (s79-job *s79-wide* 'wide) 3) 'waiting)) "context capacity is incomplete, never countermodel")
(assert (not (e79-snapshot? '(space-session79 1 (space79) ((run 2))))) "unreplayed graph rejected")
(print "SPACE79: event sharing, G3, branches, partial learning, proof interpolation and Beth passed\n")

;;; -*- mode: lisp; coding: us-ascii -*-
(let* ((domains '((x (a b)) (y (a b))))
       (constraints '((neq x y)))
       (left (csp-bind domains 'x 'a))
       (right (csp-bind domains 'x 'b))
       (result (csp-solve domains constraints 100 'propagate-mrv)))
  (csp-check (equal domains '((x (a b)) (y (a b)))) "branching preserves input domains")
  (csp-check (and (equal (csp-domain left 'x) '(a))
                  (equal (csp-domain right 'x) '(b))) "sibling choices isolated")
  (csp-check (= (dlm-length (dlm-nth result 2)) 2) "backtracking enumerates alternatives")
  (csp-check (= (dlm-nth (csp-solve domains constraints 0 'dfs) 1) 'incomplete)
             "budget exhaustion is not unsatisfiable"))
(let* ((p (dlm-nth *csp-problems* 1))
       (result (csp-solve (dlm-nth p 1) (dlm-nth p 2) 100 'propagate-mrv)))
  (csp-check (and (= (dlm-nth result 1) 'complete) (not (dlm-nth result 2)))
             "exhausted inconsistent problem has no solution"))
(let* ((p (dlm-nth *csp-problems* 2))
       (result (csp-solve (dlm-nth p 1) (dlm-nth p 2) 100 'propagate-mrv)))
  (csp-check (= (dlm-length (dlm-nth result 2)) 2)
             "ambiguous role candidates retained, not asserted as unique"))

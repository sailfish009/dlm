;;; -*- mode: lisp; coding: us-ascii -*-
(define-function sl-check (condition label)
  (assert condition label)
  (print "PASS " label "\n"))
;;; -*- mode: lisp; coding: us-ascii -*-
(sl-check (= (dlm-nth (sl-coverage *sl-initial* *sl-heldout*) 1) 0)
           "empty model has no domain axioms")
(sl-check (= (dlm-nth (sl-coverage *sl-round1* *sl-heldout*) 1) 8)
           "one round learns first relational composition")
(sl-check (= (dlm-nth (sl-coverage *sl-round2* *sl-heldout*) 1) 14)
           "recursive round enables dependent rule on unseen structures")
(sl-check (= (dlm-nth (sl-coverage *sl-round2* *sl-heldout*) 3) 0)
           "no heldout explicit counterobservations derived")
(sl-check (= (dlm-length (dlm-nth *sl-round2* 3)) 2)
           "two variable-general rules learned without supplied domain axioms")
(sl-check (equal (dlm-nth *sl-round2* 3) (dlm-nth *sl-round3* 3))
           "saturated round does not invent evidence")
(sl-check (equal *sl-round3* (sl-replay *sl-training* (dlm-nth *sl-round3* 4)))
           "experience replay reconstructs graph and theory")
(sl-check (equal (dlm-nth *sl-initial* 3) ()) "candidate evaluation leaves parent unchanged")
(let* ((r (car (dlm-nth *sl-round2* 3)))
       (e (car *sl-training*))
       (a (car (dlm-nth e 3)))
       (conflict (dlm-episode 'counter-observation (dlm-nth e 2) () (list a)))
       (next (sl-observe *sl-round2* conflict)))
  (sl-check (not (dlm-nth next 3)) "new counterevidence retracts conflicting theory")
  (sl-check (equal next (sl-replay *sl-training* (dlm-nth next 4)))
             "retraction is replayable"))
(sl-check (equal (dlm-nth (symbolic-solutions '((x (a b))) '((neq x x)) 10) 2) ())
           "self inequality cannot obtain support from a different value")
(sl-check (= (dlm-length (symbolic-choose '((x (a b))) 'x)) 2)
           "Maru choice operator exposes isolated alternatives")

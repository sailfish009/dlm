;;; -*- mode: lisp; coding: us-ascii -*-
(define-function a77-check (x label) (assert x label) (print "PASS " label "\n"))
(a77-check (a77-valid? (a77-new)) "axiom space starts without domain axioms")
(dlm 'demo)
(define *a77-baseline* *dlm-model*)
(a77-check (= (car (dlm 'query 'demo-a '(atom "c77-0" (a c)))) 'not-derived) "no invented relation before discovery")
(dlm 'step)
(a77-check (= (dlm-length (dlm 'library)) 1) "one conservative definition admitted in one step")
(a77-check (= (car (dlm 'query 'demo-a '(atom "c77-0" (a c)))) 'proved) "defined relation has independently verified witness")
(a77-check (= (car (dlm 'query 'demo-a '(atom edge (a c)))) 'not-derived) "definition does not assert primitive transitivity")
(a77-check (= (car (dlm 'query 'demo-a '(atom "c77-0" (u w)))) 'not-derived) "source contexts never leak between episodes")
(dlm 'step) (dlm 'step)
(a77-check (= (dlm-length (dlm 'library)) 3) "recursive rounds reuse earlier definitions")
(a77-check (a77-find (dlm-nth (dlm-nth (dlm-nth (dlm 'library) 2) 3) 1) (dlm 'library)) "depth-four definition actually references a learned predicate")
(a77-check (= (car (dlm 'query 'demo-a '(atom "c77-2" (a e)))) 'proved) "recursive abstraction proves a longer path")
(a77-check (= (car (dlm 'query 'demo-a '(atom "c77-2" (e a)))) 'not-derived) "directed path order preserved")
(a77-check (a77-valid? *dlm-model*) "stored library reconstructs from primitive path schemas")
(a77-check (equal (dlm-nth (d77-replay *dlm-events*) 1) *dlm-model*) "admission history replays the current library")
(define *a77-frozen* *dlm-model*)
(dlm 'observe 'held-out '((atom edge (m n)) (atom edge (n o)) (atom edge (o p)) (atom edge (p q))))
(a77-check (equal (a77-defs *a77-frozen*) (dlm 'library)) "held-out transfer does not update definitions")
(a77-check (= (car (dlm 'query 'held-out '(atom "c77-2" (m q)))) 'proved) "learned operators transfer to unseen entity names")
(dlm 'retract 'demo-a)
(a77-check (= (car (dlm 'query 'demo-a '(atom "c77-2" (a e)))) 'unknown-episode) "source retraction removes its claims")
(a77-check (= (car (dlm 'query 'demo-b '(atom "c77-2" (u y)))) 'proved) "independent source survives retraction")
(a77-check (a77-valid? *dlm-model*) "definitions remain valid language extensions after retraction")
(a77-check (equal (dlm-nth (d77-replay *dlm-events*) 1) *dlm-model*) "retraction replay preserves definitions without stale claims")
(a77-check (= (car (dlm 'observe 'demo-b '((atom edge (z z))))) 'rejected) "observation IDs cannot change payload")
(a77-check (= (car (dlm 'observe 'self-output '((atom "c77-0" (a c))))) 'rejected) "own derived output cannot be admitted as raw evidence")
(a77-check (= (car (dlm 'observe 'bad '((atom edge (a))))) 'rejected) "binary relation type enforced")
(a77-check (= (car (dlm 'observe 'free '((atom edge ((var x) b))))) 'rejected) "free input variables rejected")
(define *a77-bad* '(axiom-space77 1 () ((definition77 a (b b) (compose b b)) (definition77 b (a a) (compose a a)))))
(a77-check (not (a77-valid? *a77-bad*)) "cyclic or forward definition references refused")
(a77-check (not (a77-valid? '(axiom-space77 1 () ((definition77 c (edge wrong) (compose edge edge)))))) "forged flattened definition refused")
(a77-check (not (a77-valid? '(axiom-space77 99 () ()))) "unknown library version refused")
(a77-check (not (a77-valid? '(axiom-space77 1 ((episode77 a ((atom edge . bad)))) ()))) "malformed source list refused")
(define *a77-bounded* (a77-step *a77-baseline* 0 1))
(a77-check (= (car *a77-bounded*) 'incomplete) "candidate budget exhaustion is not saturation")
(define *a77-resumed* (a77-step *a77-baseline* (dlm-nth *a77-bounded* 2) 100))
(a77-check (= (car *a77-resumed*) 'learned) "bounded candidate enumeration resumes")
(dlm 'reset)
(a77-check (= (dlm-length (dlm 'library)) 0) "reset does not seed domain rules")
(dlm 'step) (dlm 'step)
(a77-check (= (car *dlm-last*) 'waiting) "saturation stays live without manufacturing updates")
(dlm 'observe 'new '((atom link (a b)) (atom link (b c)) (atom link (d e)) (atom link (e f))))
(dlm 'step)
(a77-check (= (car *dlm-last*) 'learned) "new observations reactivate a saturated learner")
(a77-check (= (car (dlm 'bogus)) 'rejected) "unknown REPL command rejected")
(a77-check (= (car (dlm 'query)) 'rejected) "REPL command arity checked")
(dlm 'reset)

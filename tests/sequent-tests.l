(define-function sq-check (x label) (assert x label) (print "PASS " label "\n"))
(define *sq-p* '(pred p ()))
(define *sq-q* '(pred q ()))
(define *sq-sig* '((p 0) (q 0)))
(define *sq-demo-problem* (list 'problem 'classical-prop-v1 *sq-sig*
  (sq-sequent (list *sq-p* (list 'imp *sq-p* *sq-q*)) (list *sq-q*))))
(define *sq-demo* (sq-search *sq-demo-problem* 100 'fixed))
(sq-check (= (dlm-nth *sq-demo* 1) 'proved) "G3c modus ponens")
(sq-check (= (sq-verify (dlm-nth *sq-demo* 2) (dlm-nth *sq-demo-problem* 3) *sq-sig* 100) 'verified) "independent DAG check")
(sq-check (= (dlm-nth (sq-classify *sq-sig* () *sq-p* 100) 1) 'UNKNOWN) "two countermodels establish UNKNOWN")
(sq-check (= (dlm-nth (sq-classify *sq-sig* (list (list 'not *sq-p*)) *sq-p* 100) 1) 'DISPROVED) "negative proof not positive countermodel")
(sq-check (= (dlm-nth (sq-classify *sq-sig* (list *sq-p* (list 'not *sq-p*)) *sq-q* 100) 1) 'CONFLICT) "classical explosion is scoped and explicit")
(define-function sq-test-replace (xs i x)
  (if (= i 0) (cons x (cdr xs)) (cons (car xs) (sq-test-replace (cdr xs) (- i 1) x))))
(define *sq-rule-cases* '(
 (init ((pred p ())) ((pred p ())))
 (bottom-left ((bottom)) ((pred q ())))
 (top-right () ((top)))
 (top-left ((top)) ((imp (pred p ()) (pred p ()))) )
 (bottom-right () ((bottom) (imp (pred p ()) (pred p ()))))
 (not-left ((not (pred p ())) (pred p ())) ((bottom)))
 (not-right () ((not (and (pred p ()) (not (pred p ()))))))
 (and-left ((and (pred p ()) (pred q ()))) ((pred p ())))
 (and-right ((pred p ()) (pred q ())) ((and (pred p ()) (pred q ()))))
 (or-left ((or (pred p ()) (pred q ()))) ((or (pred q ()) (pred p ()))))
 (or-right ((pred p ())) ((or (pred p ()) (pred q ()))))
 (imp-left ((pred p ()) (imp (pred p ()) (pred q ()))) ((pred q ())))
 (imp-right () ((imp (pred p ()) (pred p ()))))))
(list-do case *sq-rule-cases*
  (let ((root (sq-sequent (dlm-nth case 1) (dlm-nth case 2))))
    (let ((r (sq-search (list 'problem 'classical-prop-v1 *sq-sig* root) 100 'fixed)) (seen ()) (i 0))
      (sq-check (= (dlm-nth r 1) 'proved) (car case))
      (let ((cert (dlm-nth r 2)))
        (list-do node (dlm-nth cert 3)
          (set seen (cons (dlm-nth node 3) seen))
          (list-do change (list (list 3 'forged-rule) (list 4 '(left 999))
                               (list 6 '(999)) (list 6 (list (dlm-nth node 1)))
                               (list 2 (sq-sequent (list *sq-q*) (list *sq-p*))))
            (let ((bad (sq-test-replace cert 3 (sq-test-replace (dlm-nth cert 3) i
                         (sq-test-replace node (car change) (dlm-nth change 1))))))
              (assert (= (sq-verify bad root *sq-sig* 1000) 'invalid-input) "forgery accepted")))
          (if (dlm-nth node 6)
              (assert (= (sq-verify (sq-test-replace cert 3 (sq-test-replace (dlm-nth cert 3) i
                  (sq-test-replace node 6 (cdr (dlm-nth node 6))))) root *sq-sig* 1000) 'invalid-input)
                "missing AND obligation accepted"))
          (set i (+ i 1)))
        (sq-check (dlm-member? (car case) seen) "required G3c rule exercised")
        (sq-check (= (sq-verify cert root *sq-sig* 0) 'incomplete) "verification budget is incomplete")
        (sq-check (= (sq-verify (sq-test-replace cert 3 (cons (car (dlm-nth cert 3)) (dlm-nth cert 3))) root *sq-sig* 100) 'invalid-input)
          "duplicate certificate IDs refused")))))
(define *sq-shared-root* '(sequent classical-prop-v1 ((pred p ())) ((and (pred p ()) (pred p ())))))
(define *sq-shared-cert* '(certificate classical-prop-v1 1 (
 (proof-node 0 (sequent classical-prop-v1 ((pred p ())) ((pred p ()))) init (both 0 0) () ())
 (proof-node 1 (sequent classical-prop-v1 ((pred p ())) ((and (pred p ()) (pred p ())))) and-right (right 0) () (0 0)))))
(sq-check (= (sq-verify *sq-shared-cert* *sq-shared-root* *sq-sig* 10) 'verified) "DAG shares one checked premise in two AND slots")
(sq-check (= (dlm-nth (sq-search *sq-demo-problem* 0 'fixed) 1) 'incomplete) "search exhaustion not UNKNOWN")
(sq-check (= (dlm-nth (sq-classify *sq-sig* () (list 'or *sq-p* (list 'not *sq-p*)) 100) 1) 'PROVED) "classical excluded middle")
(sq-check (= (dlm-nth (sq-classify *sq-sig* (list (list 'not (list 'not *sq-p*))) *sq-p* 100) 1) 'PROVED) "classical double negation elimination")
(sq-check (not (sq-formula? 'classical-prop-v1 '(exists x (pred p ((var x)))) '((p 1)))) "quantified input never flattened to an atom")
(sq-check (not (sq-formula? 'classical-prop-v1 '(pred p ((fun f ()))) '((p 1)))) "function terms explicitly unsupported")
(sq-check (not (sq-formula? 'classical-prop-v1 '(pred p ((var x))) '((p 1)))) "free variables never implicitly closed")
(sq-check (not (sq-formula? 'horn75 *sq-p* *sq-sig*)) "logic profile cannot silently change")
(sq-check (= (sq-verify (sq-test-replace *sq-shared-cert* 1 'horn75) *sq-shared-root* *sq-sig* 100) 'invalid-input) "cross-profile certificate rejected")
(sq-check (not (sq-check-countermodel *sq-demo-problem* '(model (((pred p ()) yes))))) "incomplete model refused")
(sq-check (not (sq-formula? 'classical-prop-v1 '(pred p . q) *sq-sig*)) "improper AST rejected")
(sq-check (not (sq-formula? 'classical-prop-v1 '(pred p ()) '((p 0) (p 1)))) "signature identity/arity conflict refused")

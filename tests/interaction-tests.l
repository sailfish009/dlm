;;; -*- mode: lisp; coding: us-ascii -*-
(define-function interaction-check (test name)
  (if test (println "PASS: " name) (error "FAIL: " name)))
(let ((cold (interaction-evaluate *interaction-cold* *interaction-held-tasks* 'learned))
      (random (interaction-evaluate *interaction-cold* *interaction-held-tasks* 'random))
      (trained (interaction-evaluate *interaction-trained* *interaction-held-tasks* 'learned))
      (scrambled (interaction-evaluate *interaction-trained* *interaction-held-tasks* 'scrambled)))
  (interaction-check (> (dlm-nth *interaction-trained* 3) 0) "execution feedback changes weights")
  (interaction-check (> (dlm-nth trained 2) (dlm-nth cold 2)) "beats frozen cold controller")
  (interaction-check (> (dlm-nth trained 2) (dlm-nth random 2)) "beats random controller")
  (interaction-check (> (dlm-nth trained 2) (dlm-nth scrambled 2)) "action intervention changes success")
  (interaction-check (= (dlm-nth trained 2) (dlm-nth trained 3)) "new values and longer lists generalize"))
(interaction-check (= (dlm-nth (interaction-rollout *interaction-trained* '(u v) 'v 0 'learned 1) 1)
                      'incomplete) "zero action budget is incomplete")
(interaction-check (= (dlm-nth (interaction-rollout *interaction-trained* '(u v) 'missing 4 'learned 1) 1)
                      'failed) "unreachable goal is not fabricated")
(interaction-check (equal (interaction-execute '(u v) 'v 'tail) '(running (v)))
                   "tail executes Maru primitive")
(interaction-check (= (car (interaction-execute '(u v) 'v 'assert-goal)) 'failed)
                   "forbidden action cannot return goal")

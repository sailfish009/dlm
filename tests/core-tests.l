;;; counterexample-driven stride-2 revision (0.0168)
(define vf (list (l-fact "vp0" (l-atom 'parent (list "a" "b")))
                 (l-fact "vp1" (l-atom 'parent (list "b" "c")))
                 (l-fact "vp2" (l-atom 'parent (list "c" "d")))

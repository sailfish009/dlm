  (and (s-rec-program? vprog)
       (= 2 (l-len (s-rec-rules vprog)))
       (= 1 (s-coverage vf (s-rec-rules vprog) vpos 20000))
       (not (s-conflict? vf (s-rec-rules vprog) vneg 20000))))

;;; -*- mode: lisp; coding: us-ascii -*-
(define-function dlm-demo ()
  (let* ((x (dlm-var 'x)) (y (dlm-var 'y)) (z (dlm-var 'z))
         (facts (list (dlm-atom 'edge 'a 'b) (dlm-atom 'edge 'b 'c)))
         (r (dlm-rule (dlm-atom 'reach x z)
                      (dlm-atom 'edge x y) (dlm-atom 'edge y z)))
         (target (dlm-atom 'reach 'a 'c))
         (proof (dlm-prove facts (list r) target))
         (episode (dlm-episode 'demo facts (list target) (list (dlm-atom 'reach 'c 'a)))))
    (println "closure: " (dlm-closure facts (list r)))
    (println "proof verified: " (dlm-verify-proof proof facts (list r)))
    (println "absent rule rejected: " (not (dlm-verify-proof proof facts ())))
    (println "verdict: " (dlm-evaluate r (list episode) ()))
    (println "learn: " (dlm-learn-round (list episode) ()
                         (dlm-execute-programs facts (list target)) 64))))

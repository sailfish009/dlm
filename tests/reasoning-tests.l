;;; -*- mode: lisp; coding: us-ascii -*-
(define *n78-example*
  '(problem classical-prop-v1 ((p 0) (q 0))
     (sequent classical-prop-v1 ((imp (pred p ()) (pred q ())) (pred p ())) ((pred q ())))))
(define *n78-full* (n78-run (n78-proof *n78-example* ()) 200))
(assert (= (dlm-nth (car (dlm-nth *n78-full* 4)) 2) 'proof) "ND proof")
(assert (equal (n78-run (n78-run (n78-proof *n78-example* ()) 3) 197) *n78-full*) "slice invariance")
(define *p78-learned* (p78-learn *n78-example* (dlm-nth (car (dlm-nth *n78-full* 4)) 3)))
(assert (p78-valid? *p78-learned*) "checked generalized pattern")
(define *n78-renamed*
  '(problem classical-prop-v1 ((r 1) (s 0))
     (sequent classical-prop-v1 ((imp (pred r ((const z))) (pred s ())) (pred r ((const z)))) ((pred s ())))))
(define *n78-reused* (n78-run (n78-proof *n78-renamed* (list *p78-learned*)) 1))
(assert (dlm-nth *n78-reused* 4) "unseen predicates/arity/objects reuse")
(assert (not (p78-find (list *p78-learned*)
  '(problem classical-prop-v1 ((p 0) (q 0))
     (sequent classical-prop-v1 ((imp (pred p ()) (pred q ()))) ((pred q ())))))) "no assumption erasure")
(define *n78-partial* (n78-run (n78-proof
  '(problem classical-prop-v1 ((p 0) (q 0))
     (sequent classical-prop-v1 ((pred p ())) ((and (pred p ()) (pred q ()))))) ()) 200))
(assert (= (dlm-nth (car (dlm-nth *n78-partial* 4)) 2) 'countermodel) "AND not OR")
(define *n78-local* (n78-run (n78-program
 '((choose (((assume provisional) (define-local concept bad) (bind x a) (require x b))
            ((bind x b) (bind x b) (bind x b) (bind x b) (accept result)))))) 50))
(assert (= (dlm-nth *n78-local* 5) 1) "failed branch")
(assert (equal (dlm-nth (car (dlm-nth *n78-local* 4)) 4) '(context78 ((x b)) () ())) "no context leak")
(define *n78-suspended* (n78-run (n78-program '((bind x a) (suspend evidence) (require x a) (accept done))) 50))
(assert (and (not (n78-ready? *n78-suspended*)) (not (dlm-nth *n78-suspended* 4))
             (= (dlm-nth *n78-suspended* 5) 0)) "suspension not failure")
(assert (dlm-nth (n78-run (n78-resume *n78-suspended*) 50) 4) "resume continuation")
(assert (not (dlm-nth (n78-run (n78-proof *n78-example* ()) 0) 4)) "zero budget incomplete")
(define *n78-wide-left* (list '(and (pred p ()) (pred q ()))) )
(times-do 255 (set *n78-wide-left* (dlm-append *n78-wide-left* (list '(top)))))
(define *n78-wide* (n78-run (n78-proof
  (list 'problem 'classical-prop-v1 '((p 0) (q 0))
        (sq-sequent *n78-wide-left* '((pred q ())))) ()) 3000))
(assert (and (not (dlm-nth *n78-wide* 4)) (= (dlm-nth *n78-wide* 5) 0)
             (not (n78-ready? *n78-wide*))) "context limit is suspended, not logical failure")
(define *b78-theory* '(and (imp (pred p ()) (pred q ())) (imp (pred q ()) (pred p ()))))
(define *b78-good* (b78-beth '((p 0) (q 0)) *b78-theory* '(pred p ()) 1000))
(assert (= (dlm-nth *b78-good* 1) 'verified) "Beth uniqueness and both directions")
(assert (equal (dlm-nth *b78-good* 3) '(pred q ())) "P-free definition")
(assert (= (dlm-nth (b78-beth '((p 0) (q 0)) '(or (pred p ()) (pred q ())) '(pred p ()) 1000) 1)
           'not-certified) "nonunique not a definition")
(assert (equal (b78-beth '((p 0)) '(and (pred p ()) (not (pred p ()))) '(pred p ()) 1000)
               '(beth78 rejected inconsistent-theory)) "no vacuous Beth")
(assert (= (dlm-nth (b78-craig '((p 0) (q 0)) '(and (pred p ()) (pred q ())) '(pred q ()) 1000) 1)
           'verified) "Craig both directions")
(assert (= (dlm-nth (b78-craig '((p 0) (q 0)) '(pred p ()) '(pred q ()) 1000) 1)
           'not-certified) "invalid implication")
(assert (not (r78-snapshot? '(reasoning-session78 1 (state78 () ()) ((run 5))))) "forged state")
(print "ND78, proof patterns, Beth/Craig: passed\n")

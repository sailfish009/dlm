;;; -*- mode: lisp; coding: us-ascii -*-
(define-function gr-check (condition label)
  (assert condition label)
  (print "PASS " label "\n"))
(define *gr-target* (dlm-atom 'reach 'a 'd))
(gr-check (equal (gr-closure (gr-new)) ()) "graph starts without domain axioms")
(gr-check (= (dlm-nth (gr-query *gr-demo* *gr-target*) 1) 'entailed) "indexed graph derives multihop claim")
(gr-check (= (dlm-length (gr-supports-for *gr-demo* *gr-target*)) 2) "shared claim retains both derivation alternatives")
(gr-check (dlm-verify-proof (dlm-nth (gr-query *gr-demo* *gr-target*) 3)
                           (gr-facts *gr-demo*) (gr-rules *gr-demo*))
          "graph witness accepted by independent Horn verifier")
(gr-check (and (not (dlm-difference (gr-closure *gr-demo*) (dlm-closure (gr-facts *gr-demo*) (gr-rules *gr-demo*))))
               (not (dlm-difference (dlm-closure (gr-facts *gr-demo*) (gr-rules *gr-demo*)) (gr-closure *gr-demo*))))
          "indexed closure agrees with existing full-scan kernel")
(gr-check (= (dlm-nth (gr-query *gr-demo* (dlm-atom 'likes 'a 'd)) 1) 'unknown)
          "graph path alone does not authorize predicate transitivity")
(gr-check (= (dlm-length (dlm-nth (gr-paths *gr-demo* 'a 'd '(edge) 4 100 10) 2)) 2)
          "bounded BFS preserves two directed path candidates")
(gr-check (= (dlm-nth (gr-paths *gr-demo* 'a 'd '(edge) 0 100 10) 1) 'incomplete)
          "path depth exhaustion is not no-path proof")
(gr-check (= (dlm-nth (gr-paths *gr-demo* 'a 'd '(edge) 4 0 10) 1) 'incomplete)
          "path expansion exhaustion is explicit")
(gr-check (= (dlm-length (gr-candidates (dlm-atom 'edge 'a *gr-y*) ()
  (list (dlm-nth *gr-demo* 7) (dlm-nth *gr-demo* 8)))) 2)
  "argument index filters unrelated relation rows")
(gr-check (gr-dependents *gr-demo* (dlm-nth (gr-find (dlm-nth *gr-demo* 4) 'claim (dlm-atom 'edge 'a 'b)) 1))
          "proof dependency edges reference shared premise ids")
(define *gr-duplicate* (gr-apply *gr-demo*
  '(observe (observation duplicate-ab positive (atom edge (a b)) (provenance independent-record () observed))) 20))
(gr-check (= (dlm-length (gr-supports-for *gr-duplicate* (dlm-atom 'edge 'a 'b))) 2)
          "identical claim shares a node but retains separate observation records")
(gr-check (= (dlm-nth (gr-query (gr-apply *gr-duplicate* '(retract-observation o0) 20)
                              (dlm-atom 'edge 'a 'b)) 1) 'entailed)
          "withdrawing one source preserves another source of the same claim")
(define *gr-ret1* (gr-apply *gr-demo* '(retract-observation o0) 20))
(define *gr-ret2* (gr-apply *gr-ret1* '(retract-observation o2) 20))
(gr-check (= (dlm-nth (gr-query *gr-ret1* *gr-target*) 1) 'entailed) "retraction preserves surviving alternative proof")
(gr-check (= (dlm-length (gr-supports-for *gr-ret1* *gr-target*)) 1) "invalidated alternative removed")
(gr-check (= (dlm-nth (gr-query *gr-ret2* *gr-target*) 1) 'unknown) "last supporting path removal retracts conclusion")
(gr-check (equal (gr-find (dlm-nth *gr-demo* 4) 'claim *gr-target*)
                 (gr-find (dlm-nth *gr-ret2* 4) 'claim *gr-target*)) "inactive claim id remains stable after retraction")
(gr-check (= (dlm-length (gr-supports-for *gr-demo* *gr-target*)) 2) "immutable sibling graph retains old support")
(gr-check (equal *gr-ret2* (gr-verify-state *gr-ret2*)) "graph history deterministically rebuilds indexes and inactive ids")
(define *gr-negative* (gr-apply *gr-demo*
  (list 'observe (list 'observation 'negative1 'negative *gr-target* '(provenance doc-negative (span 0 10) observed))) 20))
(gr-check (= (dlm-nth (gr-query *gr-negative* *gr-target*) 1) 'conflict) "conflicting evidence retained without confidence winner")
(gr-check (= (dlm-nth (gr-query *gr-negative* (dlm-atom 'unrelated 'a)) 1) 'unknown) "contradiction does not cause logical explosion")
(gr-check (= (dlm-nth (gr-query (gr-apply *gr-negative* '(retract-rule r1) 20) *gr-target*) 1) 'contradicted)
          "explicit negative evidence differs from missing positive proof")
(gr-check (= (car (gr-admit-rule (gr-apply *gr-negative* '(retract-rule r1) 20)
  (list 'rule-record 'again *gr-chain-rule* '(provenance learner () learned)) 20)) 'graph-error)
  "candidate rule blocked by explicit counterevidence")
(gr-check (= (car (gr-apply *gr-demo*
  (list 'observe (list 'observation 'bad 'positive (dlm-atom 'edge 'a) '(provenance doc () observed))) 20)) 'graph-error)
  "predicate arity mismatch rejected atomically")
(gr-check (= (car (gr-apply *gr-demo*
  (list 'observe (list 'observation 'o0 'positive (dlm-atom 'edge 'z 'z) '(provenance doc () observed))) 20)) 'graph-error)
  "observation identity cannot silently change payload")
(gr-check (= (car (gr-apply *gr-demo*
  (list 'observe (list 'observation 'webdoc 'positive (dlm-atom 'edge 'z 'z) '(provenance doc () acquired))) 20)) 'graph-error)
  "acquired status is not accepted as an observed premise")
(gr-check (= (car (gr-apply (gr-apply *gr-negative* '(retract-rule r1) 20)
  (list 'rule (list 'rule-record 'bypass *gr-chain-rule* '(provenance learner () learned))) 20)) 'graph-error)
  "transition and replay cannot bypass learned-rule counterevidence gate")
(gr-check (= (car (gr-apply *gr-demo* (list 'rule
  (list 'rule-record 'unsafe (dlm-rule (dlm-atom 'reach *gr-x* *gr-z*)
    (dlm-atom 'edge *gr-x* *gr-y*)) '(provenance learner () learned))) 20)) 'graph-error)
  "unsafe rule variables rejected before graph execution")
(define *gr-short* (gr-apply *gr-demo* '(recompute closure) 0))
(gr-check (= (dlm-nth (gr-query *gr-short* *gr-target*) 1) 'incomplete) "incomplete closure never reports unknown as exhaustive")
(gr-check (= (dlm-nth (gr-query *gr-short* (dlm-atom 'edge 'a 'b)) 1) 'entailed) "budget exhaustion preserves valid observed proof")
(define *gr-cycle* (gr-from-episode (dlm-episode 'cycle (list (dlm-atom 'p 'a)) () ())
  (list (dlm-rule (dlm-atom 'q *gr-x*) (dlm-atom 'p *gr-x*))
        (dlm-rule (dlm-atom 'p *gr-x*) (dlm-atom 'q *gr-x*))) 20))
(gr-check (= (dlm-nth (gr-query *gr-cycle* (dlm-atom 'q 'a)) 1) 'entailed) "cyclic support graph yields finite acyclic witness")
(gr-check (not (gr-closure (gr-apply *gr-cycle* '(retract-observation o0) 20)))
          "unsupported cycle cannot survive seed retraction")

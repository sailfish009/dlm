pe))))\n    (verbosity 3 (warn \"new <type> instance: \" name \", id: \" id\"\\n\"))\n    (set (<type>-name\tresult) name)\n    (set (<type>-id\tresult) id)\n    (register-type result)\n    result))\n\n(define-function new-<type> (name)\n  (new-type-instance name <type>))\n\n(define-form define-type (name)\n  (let ((type (new-<type> name)))\n    ;; TODO we want this to be defined already when the upcoming forms get expanded. but it feels like a kludge...\n    (eval `(define ,name ,type))\n    `(define ,name ,type)))\n\n(define-function new-<record> (name super slots)\n  (assert (or (not super) (and (not (pair? super)) (subtype? (type-of super) <type>))))\n  (let ((type (new-type-instance name <record>)))\n    (set (<record>-super\t\ttype) super)\n    (set (<record>-direct-slots\t\ttype) slots)\n    (set (<record>-effective-slots\ttype) (record/compute-effective-slots type))\n    type))\n\n;; args: name super slots . props\n(define-form define-record (name . rest)\n  (let ((super (pop rest))\n        (slots (pop rest))\n        (props rest))\n    (set slots (map-with expand slots *env*))\n    (set slots (list-remove () slots))\n    (let ((record-type\t\t(new-<record> name (eval super) slots))\n          (raw-slot-access?\tfalse))\n      (list-do prop props\n        (case prop\n          (raw-slot-access\t(set raw-slot-access? true))\n          (else\t\t\t(error \"define-record: unexpected property \"prop))))\n      ;; so that it's already available at expand time...\n      (eval `(define ,name ,record-type))\n      ;; ...and at runtime.\n      `(let ((type-obj ,record-type))\n         (define ,name type-obj)\n         ,@(%make-record-accessors record-type raw-slot-access?)\n         type-obj))))\n\n;;; immediate type (i.e. a word with some tag bits)\n\n(define-record <immediate-type> <type> (tag-value tag-width))\n\n(define-function new-<immediate-type> (name tag-value tag-width)\n  (let ((type (new-type-instance name <immediate-type>)))\n    (set (<immediate-type>-tag-value\ttype) tag-value)\n    (set (<immediate-type>-tag-width\ttype) tag-width)\n    type))\n\n(define-form define-immediate (name tag-value tag-width)\n  `(define ,name ,(new-<immediate-type> name (eval tag-value) (eval tag-width))))\n\n;;; boxed type (i.e. a full object with a header)\n\n(define-record <boxed-type> <type>\n  ;; NOTE: it's possible to allocate heap objects of any length and\n  ;; then set whatever type we want on them. so, it's possible to\n  ;; e.g. allocate a large opaque object, put <symbol> as its type,\n  ;; and memcpy an arbitrary long cstring into the object payload.\n\n  ;; TODO this ONE-WORD? thing is silly. either rename to\n  ;; SINGLE-WORD?, or come up with some alternative that generalizes\n  ;; better. how could (box <some-boxed-type> payload) work when the\n  ;; payload is not a single word, but something longer that needs to\n  ;; be memcpy'd into the object's body? maybe payload should then be\n  ;; a lisp <array> whose elements get copied?\n  (one-word?))\n\n(define-function new-<boxed-type> (name one-word?)\n  (let ((type (new-type-instance name <boxed-type>)))\n    (set (<boxed-type>-one-word? type) one-word?)\n    type))\n\n;; TODO rename to define-boxed-cell, or maybe define-boxed-cell-type\n(define-form define-boxed-word (name)\n  `(define ,name ,(new-<boxed-type> name true)))\n\n(define-form define-boxed (name)\n  `(define ,name ,(new-<boxed-type> name false)))\n\n;;; classes\n\n(define-form define-class (name basis fields)\n  ;; TODO source-level compatibility. decide whether to delme.\n  ;; TODO accessor regression: there used to be <peg>-result, now there's only a <parser>-result (inheritance)\n  `(define-record ,name ,basis ,fields))\n\n;;; field accesors\n\n(define-function make-instance-accessors (var-name type-name slots)\n  (when (pair? slots)\n    (cons `(,(concat-symbols var-name '. (car slots))\n             ()\n             ((_)\n              `(slot-value ,type-name ,(car slots) ,var-name)))\n          (make-instance-accessors var-name type-name (cdr slots)))))\n\n;; Bind symbol macros for each slot on VAR-NAME.SLOT-NAME.  TODO is\n;; this really what we want? instead of e.g. binding the slot names as\n;; local variables?\n(define-form with-instance-accessors (var-name type-name . body)\n  (let ((accessors\t())\n        (super\t\t(eval type-name *env*)))\n    (while (is <record> super)\n      (list-do accessor (make-instance-accessors var-name\n                                                 (<type>-name super)\n                                                 (<record>-direct-slots super))\n        (push accessors accessor))\n      (set super (<record>-super super)))\n    `(with-forms ,accessors\n       ,@body)))\n\n;;; constructors\n\n(define-form new (type-name . inits)\n  (let* ((i -1)\n         (type (eval type-name *env*))\n         (allocate-form `(allocate ,(<type>-id type) ,(type/slot-count-of-instances type))))\n    ;; TODO singletons for types whose instances have no slots?\n    (if inits\n        `(let ((_self_ ,allocate-form))\n           ;; TODO the usefulness of this is questionable... delme and rename make to new?\n           ,@(map (lambda (_init_)\n                    (list 'set-oop-at '_self_ (incr i) _init_))\n                  inits)\n           _self_)\n      allocate-form)))\n\n(define-form new* (type . inits)\n  ;; this one doesn't need to know the type at expand-time\n  (let ((i -1))\n    `(let* ((_type_ ,type)\n            (_self_ (allocate (<type>-id _type_)\n                              (type/slot-count-of-instances _type_))))\n       ,@(map (lambda (_init_) (list 'set-oop-at '_self_ (set i (+ i 1)) _init_)) inits)\n       _self_)))\n\n(define-function %make-make-inits (env prefix inits)\n  (when inits\n    (let ((entry (first inits)))\n      (when (= (first entry) 'when-at-expand) ; well, if we look at it as a DSL... or is it a KLUDGE?\n        (set entry (expand entry env)))\n      (when entry\n        (cons `(set ,(concat-symbol prefix (first entry)) ,(second entry))\n              (%make-make-inits env prefix (cdr inits)))))))\n\n(define-form make (type . inits)\n  `(let ((self (new ,type)))\n     (with-instance-accessors self ,type\n       ,@(%make-make-inits *env* 'self. inits)\n       self)))\n\n;;; built-in types\n\n;; NOTE the vm-functions provided by the eval executable assume\n;; a certain memory layout for the built-in types.\n;; what actually happens is encoded in the executable, and if you change any of these\n;; then you need to bootstrap to reflect the changes in the next executable.\n;; types are represented in the target as successive integers.\n\n;; NOTE these type definitions also encode the object layout in the\n;; target, which may or may not be a good idea. maybe there should be\n;; separate define-object-layout forms in the target code for that?\n\n;; TODO type objects and their accessors should be serialized into the\n;; compiled binary and this should be wrapped in a big (when-at-expand\n;; bootstrapping? ...). this would also reflect the fact that editing\n;; these and bringing it out of sync with the level-shifted binary is\n;; not an option without grave consequences. such a setup would\n;; hopefully also simplify the bootstrapping dance above.\n(define-type\t\t<data>)\t\t\t\t\t; some blob; used for stuff like the elements of <string> and <array>\n\n(define-immediate\t<undefined>\t\t0 ())\t\t; nil tag-width means that it's an entire word of a well-known value; in this case zero\n(if-at-expand true\n  (define-immediate\t<long>\t\t\t1 1)\n  (define-boxed-word\t<long>))\t\t\t\t; provides a full-word integer, but bootstrap is about 25% slower\n(define-record\t\t<fixed>\t\t\t() (function))\n;;(define-boxed\t\t<symbol>)\t\t\t\t; a cstr is inline into the object's body\n(define-record\t\t<symbol>\t\t() (name))\n\n(define-record\t\t<array>\t\t\t() (size elements)) ; an array of oop's\n(define-record\t\t<memory-block>\t\t() (size elements)) ; an array of raw bytes\n(define-record\t\t<string>\t\t() (size elements))\n;; TODO rename body to program-code, or maybe machine-code is better\n;; TODO harmonize name with <target-function>, but how? <function> and <t/function>\n(define-record\t\t<expr>\t\t\t() (parameters body env ctx\n                                                     (when-at-expand (feature track-expr-names)\tname)\n                                                     (when-at-expand (feature profiler)\t\tprofiler-counter)))\n(define-record\t\t<form>\t\t\t() (function symbol))\t; these are expander lambda's\n(define-record\t\t<variable>\t\t() (name value env index))\n(define-record\t\t<env>\t\t\t() (parent level offset bindings stable\n                                                     (when-at-expand (feature debug-info)\t\tname)))\n(define-record\t\t<context>\t\t() (home env bindings callee))\n(define-record\t\t<pair>\t\t\t() (head tail))\n\n;; a heap object with a function pointer, and optionally a name.\n;; TODO rename to <lower-function>\n(define-record <target-function> ()\n  (program-code\n   (when-at-expand (feature track-expr-names)\tname)\n   (when-at-expand (feature profiler)\t\tprofiler-counter)))\n\n;; a word/cell/pointer in the lower realm, boxed, so that it can be\n;; stored in the maru heap.\n(define-boxed-word <lower-cell>)\n\n(define-boxed-word <cell-64>)\n\n;; TODO why are some of these here, and some are vm-functions? unify one way or another!\n;;(define-function undefined?\t(obj)\t(= <undefined>\t(type-of obj)))\n(define-function long?\t\t(obj)\t(= <long>\t(type-of obj)))\n(define-function expr?\t\t(obj)\t(= <expr>\t(type-of obj)))\n(define-function variable?\t(obj)\t(= <variable>\t(type-of obj)))\n\n(when-at-expand bootstrapping?\n  ;; host-slave leakage: let's map the following host types to their\n  ;; respective slave equivalents, so that calling the slave's TYPE-OF\n  ;; on one of their instances will return the slave type object\n  ;; instead of that of the host's. this is mainly needed to\n  ;; seamlessly interact with the data returned by the host's reader\n  ;; while we are inside the slave; e.g. to be able to install\n  ;; <selector> methods on these types in the slave, and expect them\n  ;; to be called when e.g. DO-PRINT is called in the slave on some\n  ;; source code returned by the host's reader.\n  (list-do entry\n           `((\"\"\t,<string>)\n             (42\t,<long>)\n             (t\t\t,<symbol>)\n             ((1)\t,<pair>)\n             (()\t,<undefined>)\n             )\n    (apply (lambda (instance type)\n             (set (array-at %type-id-map/host->slave (type-id-of instance))\n                  (<type>-slave-id type))\n             (assert (= (type-of instance) type)))\n           entry))\n  (verbosity 2\n    (warn \"host->slave type mapping:\\n\")\n    (types-do type\n      (let ((id (<type>-id type)))\n        (warn \"  \"type\": \" id \" -> \"(array-at %type-id-map/host->slave id)\"\\n\")))))\n")
    (else 0)))

(define-vm-function (load ()) ((path <string>))
  (let ((payload (embedded-source (string->C-string path))))
    (if payload
        (gc/let* ((stream (embedded-stream payload)))
          (expand-encode-eval-stream stream))
      (with-input-from-file (stream path)
        (expand-encode-eval-stream stream)))))

(define-function embedded-or-file-repl (path)
  (let ((payload (embedded-source (string->C-string path))))
    (if payload
        (gc/let* ((stream (embedded-stream payload)))
          (repl-stream stream *standard-output* false))
      (with-input-from-file (stream path)
        (repl-stream stream *standard-output* false)))))

(define-function process-command-line-arguments (argc argv)
  (debug-print "start processing argv")

  ;; *command-line-arguments*
  (let ((cla-var (environment-define *globals* (string->symbol "*command-line-arguments*") ())))
    ;; initialize *cla*
    (gc/let* ((tmp ()))
      (let ((idx argc))
        ;; we skip the first, i.e. the name of the executable
        (while (< 0 (decr idx))
          (set tmp (cons () tmp))
          (put/head tmp (C-string->string (oop-at argv idx)))
          (debug-print "processing argv "(box <long> idx)" = "(get/head tmp))))
      (set (<variable>-value cla-var) tmp))

    (debug-print "*command-line-arguments* is initialized to: " (<variable>-value cla-var))

    ;; TODO shouldn't the processing be moved into the upper? into boot.l?

    ;; process *cla*
    (let ((exit-code 0)
          cla)
      (gc/let* (arg
                tmp)
        (with-forms ((pop-cla (_ '(set (<variable>-value cla-var) (set cla (get/tail cla))))))
          (while (and (= 0 exit-code)
                      (pair? (set cla (<variable>-value cla-var))))
            (set arg (get/head cla))
            (pop-cla)
            (cond
              ;; -v
              ((string= "-v" arg)
               (incr *verbosity*)
               ;; KLUDGE propagate the value from the target up into
               ;; the evaluator by hand. ideally this should be done
               ;; automatically.
               (set tmp (box <long> *verbosity*))
               (set (variable-value *maru* symbol/*verbosity*) tmp))

              ((string= "-d" arg)
               (if-at-expand (feature debug-output)
                   (set *debug-output-enabled?* true)
                 (platform/diag-print "WARNING: (feature debug-output) was not enabled while compiling this build, ignoring -d\n")))

              ;; -O
              ((string= "-O" arg)
               (incr *optimised*)
               ;; KLUDGE propagate the value from the target up into
               ;; the evaluator by hand. ideally this should be done
               ;; automatically.
               (set tmp (box <long> *optimised*))
               (set (variable-value *maru* symbol/*optimised*) tmp))

              ;; -p
              ((string= "-p" arg)
               (if-at-expand (feature profiler)
                   (let ((usecs 1000))
                     (install_profiler_handler
                      (<target-function>-program-code profiler/take-sample))
                     (set_profiler_interval usecs)
                     (platform/diag-print "enabled profiling at every "usecs" uSec(s)"))
                 (platform/diag-print "WARNING: this build has no profiler, ignoring -p\n")))

              ;; -
              ((string= "-" arg)
               (repl-stream *standard-input* *standard-output* true))

              ;; --call to call a function
              ((string= "--call" arg)
               (debug-print "processing a --call")
               (unless (pair? cla)
                 (fatal "--call requires an argument"))
               (set arg (get/head cla))
               (pop-cla)
               (let ((sym (string->symbol arg)))
                 (gc/let* ((form (cons sym ())))
                   (expand-encode-eval form))))

              ;; --define to define a variable
              ((string= "--define" arg)
               (debug-print "processing a --define")
               (unless (and (pair? cla)
                            (pair? (get/tail cla)))
                 (fatal "--define requires two arguments"))
               (gc/let* ((name	(first  cla))
                         (value	(second cla)))
                 (pop-cla)
                 (pop-cla)
                 ;; convert to long when possible
                 (cond
                   ((string= value "true")
                    (set value symbol/true))
                   ((string= value "false")
                    (set value ()))
                   (else
                    (let ((i (string->long* value 10)))
                      (unless (= +end+ i)
                        (set value (box <long> i))))))
                 (environment-define *globals*
                                     (string->symbol name)
                                     value)))

              ;; read file as a program
              (else
               (verbosity 1 (print-all *debug-output* "loading file: "arg"\t(as a CLA)\n"))
               (let ()
                 (set exit-code (unbox <long> (embedded-or-file-repl arg)))
                 (when (or (<= 2 *verbosity*)
                           (not (= 0 exit-code)))
                   (print-all *debug-output* "exit-code of file "arg": "(box <long> exit-code)"\n"))))))))

      exit-code)))

    ((embedded-path=? path "source/platforms/linux/linux.l") ";;; -*- mode: lisp; coding: us-ascii -*-\n\n(set (feature platform/linux) true)\n(set (feature platform/posix) true)\n\n(require \"source/platforms/platform-c-based.l\")\n\n;; It's tempting to just include the posix cgrov values, but even\n;; though they mostly overlap, there's no guarantee that they are\n;; the same.\n;; (require-cgrov \"source/platforms/posix/posix\")\n\n(require-cgrov \"source/platforms/linux/linux\")\n\n;; Internally we define a posix API, so we need to define\n;; some posix/foo constants.\n(define-constant posix/O_WRONLY linux/O_WRONLY)\n(define-constant posix/O_CREAT  linux/O_CREAT)\n(define-constant posix/O_TRUNC  linux/O_TRUNC)\n\n(define main) ; forward\n\n;; define some llvm intrinsics as FFI calls\n;; https://llvm.org/docs/LangRef.html#llvm-memcpy-intrinsic\n;; (define-C-functions ()\n;;   (void llvm.memcpy.p0i8.p0i8.i32 (* * int int))\n;;   )\n;; TODO turned off because this requires linking to something that defines memcpy. apparently llvm doesn't emit its own code for these.\n;; (if (= (host-value *compiler-backend*) \"llvm\")\n;;     (define-form copy-oops (from to wordcount)\n;;       ;; TODO add align: https://llvm.org/docs/LangRef.html#attr-align\n;;       `(llvm.memcpy.p0i8.p0i8.i32 ,to ,from (words-to-bytes ,wordcount) 1)))\n\n;; this is a placeholder object in the target on which we can register\n;; a special-form later. theoretically, this could be any object\n;; (including nil), but we leave a recognizable trace for better\n;; potential error messages.\n(define syscall\n  (fixed (lambda args\n           (print \"syscall encountered in interpreted code with args \" args \"\\n\")\n           (abort))))\n\n;; NOTE: cannot be a function, because the syscall special form cannot be applied\n;; NOTE: the assert wrapper must be defined later when ERROR is set up\n(define-form syscall* args\n  `(%syscall-rc-assert ,(first args) (syscall ,@args)))\n\n;;;\n;;; Platform API implementation when running on top of the Linux kernel.\n;;;\n(define-function platform/flush-streams ()\n  ;; there's no need to flush fd's on linux. fsync straight out\n  ;; returns an error when called on a terminal or pipe.\n  ;; (syscall* linux/SYS_fsync linux/STDOUT_FILENO)\n  ;; (syscall* linux/SYS_fsync linux/STDERR_FILENO)\n  )\n\n;; NOTE copy means it may not overlap. move means they may overlap.\n\n;; TODO these two are exported into the evaluator to provide the same api in interpreted code. how shall this be?\n(define-function copy-oops (from to wordcount)\n  (for (i 0 wordcount)\n    (set (oop-at to   i)\n         (oop-at from i))))\n\n(define-function copy-bytes (from to count)\n  (for (i 0 count)\n    (set (byte-at to   i)\n         (byte-at from i))))\n\n(define-function platform/move-oops (from to wordcount)\n  (cond\n    ((< to from)\n     (for (i 0 wordcount)\n       (set (oop-at to   i)\n            (oop-at from i))))\n    ((< from to)\n     (for (i (- wordcount 1) -1 -1)\n       (set (oop-at to   i)\n            (oop-at from i))))))\n\n(define-function platform/move-bytes (from to count)\n  (cond\n    ((< to from)\n     (for (i 0 count)\n       (set (byte-at to   i)\n            (byte-at from i))))\n    ((< from to)\n     (for (i (- count 1) -1 -1)\n       (set (byte-at to   i)\n            (byte-at from i))))))\n\n(define-function platform/clear-cells (from cell-count)\n;; TODO this is still rather high in the profiler. maybe introduce\n;; backend specific compiler macros, and then add an x86 asm\n;; impelmentation?\n  (for (i 0 cell-count)\n    (set (oop-at from i) 0)))\n\n(define-form platform/diag-print-string (str)\n  (typecase str\n    (<string> ; i.e. we can calculate the string length at expand time\n     `(syscall linux/SYS_write linux/STDERR_FILENO\n                     (string->C-string ,str) ,(string-length str)))\n    (else\n     ;; FIXME why do i need the eval?\n     `(let ((cstr ,(if (eval '(feature emit-with-object-headers))\n                       `(string->C-string ,str)\n                     str)))\n        (syscall linux/SYS_write linux/STDERR_FILENO cstr (C-string-length cstr))))))\n\n(define-function platform/diag-print-char (char)\n  ;; TODO endianness?\n  (syscall linux/SYS_write linux/STDERR_FILENO (address-of char) 1)\n  char)\n\n;; needs to be a form; the compiler doesn't yet support . rest args\n(define-function platform/halt (exit-code)\n  (syscall linux/SYS_exit exit-code))\n\n(define *initial-break* 0)\n(define *current-break* 0)\n\n(define-function platform/acquire-memory/via-brk (size)\n  ;; https://gist.github.com/nikAizuddin/f4132721126257ec4345\n  (unless *initial-break*\n    (set *current-break* (set *initial-break* (syscall linux/SYS_brk 0)))\n    ;; TODO too early, ASSERT and ERROR is not functional at this point\n    ;;(assert (< 0 *current-break*))\n    )\n  (let ((new-break\t(syscall linux/SYS_brk (+ *current-break* size)))\n        (result\t\t*current-break*))\n    (when (= new-break *current-break*)\n      (platform/diag-print \"SYS_brk failed, aborting\")\n      (platform/halt 39))\n    (set *current-break* new-break)\n    ;; KLUDGE we make all allocated memory executable.\n    ;; `make test-elf` generates machine code and wants to call it...\n    (syscall linux/SYS_mprotect *initial-break*\n             (- *current-break* *initial-break*)\n             (+ (+ linux/PROT_READ linux/PROT_WRITE)\n                linux/PROT_EXEC))\n    result))\n\n;; KLUDGE whose only role is to keep gc/read-only-object?\n;; working. it requires the heap to lie above the static image,\n;; but mmap(0) picks from the top of the address space, which on\n;; 32-bit targets lies above 2^31, i.e. it compares negative against\n;; the image. hence the hint: right above the image (the program\n;; break), grown as we allocate. it's a delme...\n(define *mmap-hint* 0)\n\n;; the kernel hands us the page size in the auxv; parsed in _start\n(define *kernel-page-size* 0)\n\n;; i386 doesn't have SYS_mmap (its old variant takes a pointer to an\n;; arg struct), only SYS_mmap2, whose offset argument counts in units\n;; of 4096 bytes. we always pass 0 as the offset, so they are\n;; equivalent here.\n(define-constant linux/SYS_mmap*\n  (case target/arch\n    (IA-32\t'linux/SYS_mmap2)\n    (else\t'linux/SYS_mmap)))\n\n(define-function platform/acquire-memory/via-mmap (size)\n  ;; KLUDGE we make all allocated memory executable.\n  ;; `make test-elf` generates machine code and wants to call it...\n  ;;\n  ;; We don't let the kernel choose the address (it would map us into\n  ;; its mmap area, which can lie below our static image, e.g. under\n  ;; qemu-user with a guest ld.so), but hand out consecutive chunks\n  ;; starting right above the binary's break. this way all heap memory\n  ;; stays above the static image, keeping the invariant of\n  ;; gc/read-only-object? intact. MAP_FIXED_NOREPLACE ensures that we\n  ;; don't clobber anything that might have been mapped there in the\n  ;; meantime (needs linux 4.17+).\n  (unless *mmap-hint*\n    (set *mmap-hint* (align-address-up (syscall linux/SYS_brk 0)\n                                       *kernel-page-size*)))\n  (set size (align-address-up size *kernel-page-size*))\n  (let ((result\t(syscall linux/SYS_mmap*\n                         *mmap-hint*\t\t\t; addr\n                         size\t\t\t\t; length\n                         (+ (+ linux/PROT_READ linux/PROT_WRITE)\n                            linux/PROT_EXEC)\n                         (+ (+ linux/MAP_PRIVATE linux/MAP_ANONYMOUS)\n                            linux/MAP_FIXED_NOREPLACE)\n                         -1\t\t\t\t; fd\n                         0)))\t\t\t\t; offset\n    ;; NOTE the raw syscall returns -errno on failure (libc's\n    ;; MAP_FAILED == -1 doesn't apply here).\n    (when (< result 0)\n      (platform/diag-print \"SYS_mmap failed, aborting\")\n      (platform/halt 40))\n    (set *mmap-hint* (+ *mmap-hint* size))\n    result))\n\n(define-function platform/acquire-memory (size)\n  ;; the brk based allocator remains the default: it grows the heap\n  ;; right above the binary's static image, which keeps the assumption\n  ;; of gc/read-only-object? (all heap memory lies above the static\n  ;; image) true even in environments where the mmap area is not (see\n  ;; via-mmap's comment). swap the call below to try the mmap based\n  ;; allocator.\n  (platform/acquire-memory/via-brk size))\n\n(eval-in-host '(load \"source/platforms/linux/syscall.l\"))\n\n;; https://clang.llvm.org/docs/UsersManual.html#freestanding-builds\n\n;; let's declare a memset function because clang -O can emit\n;; references to it (and memcpy and memmove) even with `clang\n;; -nostdlib -nostartfiles -ffreestanding -Wl,-Bstatic`.\n\n;; So even if your handwritten code never mentions strlen, LLVM might:\n;;   - Recognize an strlen impl in the IR and turn it to an strlen call.\n;;   - Emit a call to strlen (libc function) during lowering to\n;;     AArch64 assembly/object code.\n(eval-in-host\n '(define *llvm-platform-specific-prelude*\n   \"\ndefine weak dso_local ptr @memset(ptr %dst, i32 %val, %word %len) {\nentry:\n  %end = getelementptr i8, ptr %dst, %word %len\n  %val8 = trunc i32 %val to i8\n  br label %loop\n\nloop:\n  %cur = phi ptr [ %dst, %entry ], [ %next, %store ]\n  %done = icmp eq ptr %cur, %end\n  br i1 %done, label %exit, label %store\n\nstore:\n  store i8 %val8, ptr %cur\n  %next = getelementptr i8, ptr %cur, %word 1\n  br label %loop\n\nexit:\n  ret ptr %dst\n}\n\ndefine weak dso_local i64 @strlen(ptr %str) {\nentry:\n  br label %loop\n\nloop:\n  ; %cur starts as %str, then advances by 1 each iteration\n  %cur = phi ptr [ %str, %entry ], [ %next, %loop ]\n\n  %ch = load i8, ptr %cur\n  %zero = icmp eq i8 %ch, 0\n  %next = getelementptr i8, ptr %cur, i64 1\n  br i1 %zero, label %exit, label %loop\n\nexit:\n  %endptr = phi ptr [ %cur, %loop ]\n  %start = ptrtoint ptr %str to i64\n  %end   = ptrtoint ptr %endptr to i64\n  %len   = sub i64 %end, %start\n  ret i64 %len\n}\n\"))\n\n;; aka `extern char **environ` in libc land\n(define %envp)\n\n;; the API we use\n(define-function posix/envp ()\n  %envp)\n\n;; auxv is (a_type a_val) machine-word pairs, terminated by an AT_NULL pair\n(define-function %parse-kernel-page-size (auxv)\n  (let ((i 0))\n    (until (= (oop-at auxv i) linux/AT_NULL)\n      (when (= (oop-at auxv i) linux/AT_PAGESZ)\n        (set *kernel-page-size* (oop-at auxv (+ i 1))))\n      (incr i 2))\n    (unless (< 0 *kernel-page-size*)\n      (platform/diag-print \"AT_PAGESZ not found in the auxv, aborting\")\n      (platform/halt 41))))\n\n;; https://www.muppetlabs.com/~breadbox/software/tiny/teensy.html\n;; http://www.dbp-consulting.com/tutorials/debugging/linuxProgramStartup.html\n;; https://0xax.gitbooks.io/linux-insides/content/Misc/linux-misc-4.html\n;; https://stackoverflow.com/questions/50260855/how-get-arguments-value-using-inline-assembly-in-c-without-glibc\n;; i386: https://sourceware.org/git/?p=glibc.git;a=blob;f=sysdeps/i386/start.S;h=91035fa83fb7ee38a0ca5834ba1d215b4a7f78e8;hb=HEAD\n;; x86_64: https://sourceware.org/git/?p=glibc.git;a=blob;f=sysdeps/x86_64/start.S;h=354d2e6ec78f0eaf9ab0f8ed665c2e5499388df0;hb=HEAD\n;; argc and argv position on the stack: https://briancallahan.net/blog/20200808.html\n;;\n;; auxv, ELF auxiliary vector: contains information about the memory page size, metadata from the ELF file, etc\n;;   https://amit.prasad.me/blog/before-main\n;;   How programs get run: ELF binaries\n;;   https://lwn.net/Articles/631631/\n(define-function _start ()\n  ;; too early for this: (debug (platform/diag-print \"_start is alive\\n\"))\n\n  ;; Stack layout, High memory\n  ;; +---------------------+\n  ;; | auxv[0].a_type = 0  | ; some AT_NULL nonsense, #defined as 0\n  ;; | auxv[0].a_val = 0   |\n  ;; +---------------------+\n  ;; | ...                 |\n  ;; +---------------------+\n  ;; | auxv[0].a_type      |\n  ;; | auxv[0].a_val       |\n  ;; +---------------------+\n  ;; | NULL                |\n  ;; +---------------------+\n  ;; | ...                 |\n  ;; +---------------------+\n  ;; | envp pointers       | key=value strings\n  ;; +---------------------+\n  ;; | NULL                |\n  ;; +---------------------+\n  ;; | ... (argc times)    |\n  ;; +---------------------+\n  ;; | argv[0]             |\n  ;; +---------------------+\n  ;; | argc (int)          | <-- stack pointer points to argc\n  ;; +---------------------+\n  ;; Lower memory\n\n  (let* ((sp (stack-pointer-on-entry))\n         (argc (oop-at sp 0))\n         (argv (+ sp (words-to-bytes 1)))\n         (envp (+ argv (words-to-bytes (+ argc 1)))))\n    (set %envp envp)\n    ;; the auxv follows the envp array's NULL terminator\n    (let ((cursor envp))\n      (until (= 0 (oop-at cursor 0))\n        (set cursor (+ cursor (words-to-bytes 1))))\n      (%parse-kernel-page-size (+ cursor (words-to-bytes 1))))\n    (syscall linux/SYS_exit (main argc argv))))\n")
    ((embedded-path=? path "source/platforms/linux/streams.l") ";;; -*- mode: lisp; coding: us-ascii -*-\n\n(require \"source/streams-min.l\")\n\n;; TODO not sure whether this technique of (address-of char) is\n;; digestable for LLVM. it's a KLUDGE anyway...\n\n;; An internally used posix/foo API.\n(define-function posix/open (path flags mode)\n  (syscall linux/SYS_openat linux/AT_FDCWD path\n           flags mode))\n\n(define-function posix/close (fd)\n  (syscall* linux/SYS_close fd))\n\n(define-function posix/read-byte (fd)\n  (let ((byte 0)\n        rc)\n    ;; man 2 read\n    (while (= (- linux/EINTR)\n              (set rc (syscall linux/SYS_read fd (address-of byte) 1)))\n      ;; then try again\n      )\n    (case rc\n      (0\t-1)\n      (1\tbyte)\n      (else\t(- rc)))))\n\n(define-function posix/write (fd buf length)\n  (let (rc)\n    (while (= (- linux/EINTR)\n              (set rc (syscall linux/SYS_write fd buf length)))\n      ;; then try again\n      )\n    rc))\n\n;;;\n;;; files\n;;;\n\n;; TODO reaname these to file/open?\n(define-vm-function file-open ((path <string>) (mode <string>))\n  (let ((fd (posix/open (string->C-string path)\n                        (cond\n                          ((or (not mode)\n                               (string= mode \"r\"))\n                           linux/O_RDONLY)\n                          ((string= mode \"rw\")\n                           (bitwise-or linux/O_RDWR\n                                       (bitwise-or linux/O_CREAT\n                                                   linux/O_TRUNC)))\n                          ((string= mode \"w\")\n                           (bitwise-or linux/O_WRONLY\n                                       (bitwise-or linux/O_CREAT\n                                                   linux/O_TRUNC)))\n                          (else\n                           (error \"file-open: unexpected mode \"mode\" while opening \"path)))\n                        posix/default-file-mode)))\n    (when (<= 0 fd)\n      (debug (platform/diag-print \"file-open will box fd \"(long fd)\"\\n\"))\n      (box <lower-cell> fd))))\n\n(define-vm-function file-close ((fd <lower-cell>))\n  (to-upper-boolean\n   (= 0 (syscall linux/SYS_close fd))))\n\n(define-vm-function file-read-byte ((fd <lower-cell>))\n  (let ((char 0)\n        result)\n    ;; man 2 read\n    (while (begin\n             (set result (syscall linux/SYS_read fd (address-of char) 1))\n             (= result (- linux/EINTR)))\n      ;; then try again\n      )\n    (if (= 1 result)\n        (box <long> char)\n      ;; TODO EAGAIN=EWOULDBLOCK, EINTR and stuff\n      ;;(error \"file-read-byte: syscall returned with error\")\n      ())))\n\n(define-vm-function file-write-byte ((char <long>) (fd <lower-cell>))\n  ;; TODO endianness? think this through...\n  (to-upper-boolean\n   (= 1 (posix/write fd (address-of char) 1))))\n\n;; (define-vm-function file-flush ((fd <lower-cell>))\n;;   (unless (= 0 (syscall linux/SYS_fsync fd))\n;;     (error \"file-flush: linux/SYS_fsync returned an error\")))\n\n;; FIXME groveler limitation\n(define-constant linux/sizeof-statx 256)\n\n(define-vm-function file-modification-time ((path <string>))\n  ;; TODO use stack allocation\n  (let ((st (allocate-data linux/sizeof-statx)))\n    (syscall* linux/SYS_statx linux/AT_FDCWD (string->C-string path) 0\n              linux/STATX_BASIC_STATS st)\n    ;; KLUDGE FIXME this should be groveled\n    ;; 0x70 is st.stx_mtime.tv_sec, the value is i64\n    (box <long> (cell-at st 0x70))))\n\n;;;\n;;; <fd-stream> used in the lower (i.e. only the vm-function's need to\n;;; box return values, the rest is called within the lower)\n;;;\n\n(define-record <fd-stream> <stream>\n  (fd\n   peeked-value))\n\n(define-vm-function file-stream ((fd <lower-cell>))\n  ;; when the entire object is an opaque, then we can freely store\n  ;; unboxed values in it. not sure if this is ideologically the right\n  ;; way, because the upper can get hold of unboxed values using the\n  ;; accessors.\n  (make/opaque <fd-stream>\n    (fd\t\t\tfd)\n    (peeked-value\t-1)))\n\n(define-function %ensure-peeked (stream)\n  (or (<= 0 (<fd-stream>-peeked-value stream))\n      (let* ((fd\t(<fd-stream>-fd stream))\n             (char\t0)\n             (rc\t(syscall linux/SYS_read fd (address-of char) 1)))\n        (set (<fd-stream>-peeked-value stream)\n             (if (= 1 rc)\n                 char\n               -1)))))\n\n(define-method $at-end? <fd-stream> ()\n  (%ensure-peeked self)\n  (< self.peeked-value 0))\n\n(define-method $peek <fd-stream> ()\n  (%ensure-peeked self)\n  (if (<= 0 self.peeked-value)\n      self.peeked-value\n    +end+))\n\n(define-method $next <fd-stream> ()\n  (%ensure-peeked self)\n  (if (<= 0 self.peeked-value)\n      (let ((res self.peeked-value))\n        (set self.peeked-value -1)\n        res)\n    +end+))\n\n(define-method $put <fd-stream> (u/char)\n  ;; TODO endianness? think this through...\n  (unless (= 1 (posix/write self.fd (address-of u/char) 1))\n    (error \"<fd-stream> $put: write failed\"))\n  u/char)\n\n(define-function %put-all (fd buf size)\n  (let ((rc (posix/write fd buf size)))\n    (unless (= rc size)\n      (debug (platform/diag-print \"<fd-stream> $put-all: write returned with \"(long rc)\"\\n\"))\n      ;; TODO deal with EAGAIN and stuff...\n      (error \"<fd-stream> $put-all: write failed\"))))\n\n;; TODO implemenet inheritance on compiled selectors\n(define-method $put-all <fd-stream> (obj)\n  (typecase obj\n    (<string>\n     (%put-all self.fd (string->C-string obj) (string-length obj)))\n    (when-at-expand (feature memory-block)\n      (<memory-block>\n       (%put-all self.fd (slot-value <memory-block> elements obj) (memory-block/length obj))))\n    (else\n     (error \"<fd-stream> $put-all: unexpected elements: \" obj)))\n  obj)\n\n;; (define-method $close <fd-stream> ()\n;;   (syscall* linux/SYS_close self.fd))\n\n(require \"source/streams-min-late.l\")\n")
    ((embedded-path=? path "source/platforms/linux/syscall-llvm.l") ";;; -*- mode: lisp; coding: us-ascii -*-\n\n;;; https://blog.packagecloud.io/eng/2016/04/05/the-definitive-guide-to-linux-system-calls/\n;;; https://en.wikibooks.org/wiki/X86_Assembly/Interfacing_with_Linux\n\n(define-instruction LINUX-SYSCALL (false 1 true)\n  ;; TODO does this properly communicate to LLVM which registers get overwritten?\n  ((pair)\n   (print \"\t\"$reg1\" = call %oop asm sideeffect \\\"\") ; sideffect means: never optimize away\n   (let ((args $1)\n         instr\n         input-regs\n         output\n         clobbers)\n     (case (slave-value target/arch)\n       (IA-32\n        ;; at most 6 args passed in regs. the rest should be spilled\n        ;; to the stack, but we don't support that.\n        (set instr\t\"int\t$$0x80\")\n        (set input-regs\t+linux/syscall/argument-registers/IA-32+)\n        ;; https://stackoverflow.com/questions/47983371/why-do-x86-64-linux-system-calls-modify-rcx-and-what-does-the-value-mean\n        ;; https://refspecs.linuxfoundation.org/elf/x86_64-abi-0.99.pdf\n        ;; On IA-32 \"A\" means the edx:eax pair used together to\n        ;; represent a 64-bit quantity. (i don't think we need that?)\n        ;;(set output \"A\")\n        ;; NOTE: seems like +{eax} is not a good input-output spec on x86,\n        ;; i can't make it compile.\n        (set output\t\"={eax}\")\n        (set clobbers\t+linux/syscall/clobbered-registers/IA-32+))\n       (x86-64\n        (set instr\t\"syscall\")\n        (set input-regs\t+linux/syscall/argument-registers/x86_64+)\n        (set output\t\"={rax}\")\n        (set clobbers\t+linux/syscall/clobbered-registers/x86_64+))\n       (aarch64\n        (set instr\t\"svc #0\")\n        (set input-regs +linux/syscall/argument-registers/aarch64+)\n        ;; first arg is the syscall number in x8, cdr is the first actual arg to the syscall.\n        ;; + prefix means it's both input and output reg.\n        ;; TODO ? (set output\t(if (cdr args) \"+{x0}\" \"={x0}\"))\n        (set output\t\"={x0}\")\n        (set clobbers\t+linux/syscall/clobbered-registers/aarch64+))\n       (else\n        (error \"LLVM LINUX-SYSCALL instruction is not implemented for target/arch \"(slave-value target/arch))))\n\n     ;; limit input-regs to the number of args\n     (let ((regs input-regs))\n       (set input-regs ())\n       (list-do arg args\n         (push input-regs (pop regs)))\n       (set input-regs (list-reverse! input-regs)))\n\n     (println instr\"\\\",\")\n     (print \"\t\\\"\"output)\n     (map (lambda (_ reg)\n            (assert reg)   ; this will fail for more args than regs.\n            (print \", {\"reg\"}\"))\n          args input-regs)\n     (while clobbers\n       (print \",~{\"(pop clobbers)\"}\"))\n     ;; ~{memory} indicates that the assembly writes to arbitrary undeclared memory\n     ;; locations - not only the memory pointed to by a declared indirect output.\n     (print \",~{memory}\\\"\\n\t(\")\n     (emit/comma-separated-%oops args)\n     (println \")\"))))\n\n(define-function compile/syscall (expr -c-)\n  (let ((args\t\t(cdr expr))\n        (arg-locs\t()))\n    (while args\n      (comp (pop args))\n      (push arg-locs (<compiler>-current-value -c-)))\n    (gen LINUX-SYSCALL (list-reverse! arg-locs))))\n\n(set *special-forms*\n     (concat-list *special-forms*\n                  (list (cons (target-value syscall)\n                              compile/syscall))))\n")
    ((embedded-path=? path "source/platforms/linux/syscall.l") ";;; -*- mode: lisp; coding: us-ascii -*-\n\n;; these must remain here becuase they are also used by the llvm backend\n(define-constant +linux/syscall/argument-registers/IA-32+\n    `(quote ,(map symbol->string '(eax ebx ecx edx esi edi ebp))))\n\n(define-constant +linux/syscall/clobbered-registers/IA-32+\n    `(quote ,(map symbol->string '(ebx ecx edx esi edi ebp))))\n\n(define-constant +linux/syscall/argument-registers/x86_64+\n    `(quote ,(map symbol->string '(rax rdi rsi rdx r10 r8 r9))))\n(define-constant +linux/syscall/clobbered-registers/x86_64+\n    `(quote ,(map symbol->string '(rdi rsi rdx r10 r8 r9 rcx r11))))\n\n(define-constant +linux/syscall/argument-registers/aarch64+\n    `(quote ,(map symbol->string '(x8 x0 x1 x2 x3 x4 x5))))\n;; AArch64 syscall number goes into x8, args in x0-x7, return in x0, x1 (?)\n;; x6 x7 are not clobbered according to man 2 syscall\n(define-constant +linux/syscall/clobbered-registers/aarch64+\n    `(quote ,(map symbol->string '(x1 x2 x3 x4 x5 x8 x16 x17))))\n\n(load (concat-strings \"source/platforms/linux/syscall-\" *compiler-backend* \".l\"))\n")
    ((embedded-path=? path "source/platforms/linux/vm-functions.l") ";;; -*- mode: lisp; coding: us-ascii -*-\n\n(define-form WIFEXITED   (status) `(= 0 (bitwise-and ,status 0x7f)))\n(define-form WEXITSTATUS (status) `(bitwise-and (bitwise-shift ,status -8) 0xff))\n(define-form WIFSIGNALED (status) `(>= (+ 1 (bitwise-and ,status 0x7f)) 2))\n(define-form WTERMSIG    (status) `(bitwise-and ,status 0x7f))\n\n;; NOTE these are here because BOX and other VM stuff is not yet\n;; available in linux.l\n(define-function posix/waitpid (pid options)\n  (let ((status 0)\n        result)\n    (while (= (- linux/EINTR)\n              (set result (syscall linux/SYS_wait4 pid (address-of status) options 0)))\n      ;; keep trying\n      )\n    (if (< result 0)\n        (fatal \"waitpid returned with \"result)\n      (cond\n        ((WIFEXITED status)\t(WEXITSTATUS status))\n        ((WIFSIGNALED status)\t(+ 128 (WTERMSIG status)))\n        (else\t\t\t-1)))))\n\n(define-function posix/spawn-program (path argv envp stdout-fd stderr-fd)\n  ;; (debug (platform/diag-print \"posix/spawn-program is about to spawn '\"(string path)\"'\\n\"))\n  (let ((pid (syscall linux/SYS_clone linux/SIGCHLD 0)))\n    (if (= 0 pid)\n        (begin\n          (when (< 0 stdout-fd)\n            (syscall* linux/SYS_dup3 stdout-fd linux/STDOUT_FILENO 0)\n            (syscall* linux/SYS_close stdout-fd))\n          (when (< 0 stderr-fd)\n            (syscall* linux/SYS_dup3 stderr-fd linux/STDERR_FILENO 0)\n            (syscall* linux/SYS_close stderr-fd))\n          (syscall* linux/SYS_execve path argv envp)\n          (syscall linux/SYS_exit 127))\n      ;; (debug (platform/diag-print \"child spawned\\n\"))\n      pid)))\n\n(define-form posix/pipe (ptr)\n  `(syscall* linux/SYS_pipe2 ,ptr 0))\n\n(define-vm-function working-directory ()\n  (gc/let* ((buffer (allocate-data linux/PATH_MAX)))\n    (let ((len (syscall* linux/SYS_getcwd buffer linux/PATH_MAX)))\n      ;; len contains the terminating zero byte\n      (C-string->string* buffer (- len 1)))))\n\n(define-vm-function set-working-directory ((path <string>))\n  (verbosity 1 (print-all *debug-output* \"changing working directory to: \"path\"\\n\"))\n  (syscall* linux/SYS_chdir (string->C-string path)))\n\n;;\n;; !!!\n;;\n;; The raw system call interface on x86-64 and some other\n;; architectures (including sh, tile, and alpha) is:\n;;\n;;     long clone(unsigned long flags, void *stack,\n;;                int *parent_tid, int *child_tid,\n;;                unsigned long tls);\n;;\n;; On x86-32, and several other common architectures (including score,\n;; ARM, ARM 64, PA-RISC, arc, Power PC, xtensa, and MIPS), the order\n;; of the last two arguments is reversed:\n;;\n;;     long clone(unsigned long flags, void *stack,\n;;               int *parent_tid, unsigned long tls,\n;;               int *child_tid);\n\n;; (define-vm-function fork ((flags <long> linux/SIGCHLD))\n;;   (box <long> (syscall* linux/SYS_clone flags 0 0 0 0 0)))\n\n;; (define-vm-function execve ((path <string>))\n;;   (let* ((argv 0)\n;;          (envp 0)\n;;          (result (syscall linux/SYS_execve\n;;                                 (<string>-elements path)\n;;                                 (address-of argv)\n;;                                 (address-of envp))))\n;;     ;; result is -errno\n;;     (fatal \"execve returned with \"result)))\n\n;; (define-vm-function waitpid ((pid <long>))\n;;   (let (status)\n;;     (syscall* linux/SYS_wait4 pid (address-of status) 0 0)\n;;     (box <long> status)))\n")
    ((embedded-path=? path "source/platforms/load-platform.l") ";;; -*- mode: lisp; coding: us-ascii -*-\n\n;; this must happen early, before loading the compiler\n;; TODO add [platform]-early.l files?\n(eval-in-slave `(set (feature cffi)\n                     ,(or (= target/platform \"libc\")\n                          (= target/platform \"posix\"))))\n\n(load \"source/compiler/target.l\")\n\n;; The ET_REL c-obj emission (for the C toolchain) is the default on\n;; the C-based platforms. The CLI key arrives as a string into the\n;; host env through --define and overrides the platform default. Kept\n;; as a string: the dispatch sites compare with (string =).\n;;\n;; TODO don't define such things into the llvm backend...\n(eval-in-slave `(define elf-emission-type\n                  ,(or (and (defined? 'elf-emission-type)\n                            elf-emission-type)\n                       (if (or (= target/platform \"libc\")\n                               (= target/platform \"posix\"))\n                           \"c-obj\"\n                         \"standalone\"))))\n\n(eval-in-slave `(set (feature relocatable-elf)\n                     ,(or (= target/platform \"libc\")\n                          (= target/platform \"posix\")\n                          (= elf-emission-type \"c-obj\"))))\n\n(require (concat-strings \"source/compiler/emit-\" *compiler-backend* \".l\"))\n\n(switch-to-target-env)\n\n(load (host-value (concat-strings \"source/platforms/\"target/platform\"/\"target/platform\".l\")))\n")
    ((embedded-path=? path "source/platforms/platform-c-based.l") ";;; -*- mode: lisp; coding: us-ascii -*-\n;;;\n;;; Common defs needed by all C based platforms.\n\n(require \"source/platforms/platform-common.l\")\n\n;; A simple toplevel REQUIRE would mean it's a call to require that\n;; should be compiled to the target. What we need is the cgrov\n;; definitions to be available in the slave to be used while loading\n;; the code.\n(eval-in-slave '(require \"source/c/cgrov.l\"))\n\n(begin-for-syntax\n\n(define-function mangle-for-C (str)\n  (with-forms ((putnext ((c) `(string-append mangled ,c))))\n    (let* ((mangled (string))\n           (write-char (lambda (c)\n                         )))\n      (string-do c str\n        (if (or (= ?/ c)\n                (= ?- c))\n            (putnext ?_)\n          (putnext c)))\n      mangled)))\n\n) ; begin-for-syntax\n\n;;;\n;;; API visible in the target\n;;;\n\n;; NOTE C-string is a compiler special form to emit a constant c\n;; string in the read-only data segment.\n\n(define-form define-C-function (maru-name return-type foreign-name parameter-types)\n  (let ((ff (eval-in-host `(C-function ',return-type ,(symbol->string foreign-name) ',parameter-types))))\n    `(define ,maru-name ,ff)))\n\n(define-form define-C-functions (prefixes . entries)\n  (let ((maru-prefix\t(first  (ensure-list prefixes)))\n        (foreign-prefix\t(second (ensure-list prefixes))))\n    `(let ()\n       ,@(map (lambda (entry)\n                (let* ((return-type\t\t(first entry))\n                       (base-name\t\t(second entry))\n                       (mangled-base-name\t(mangle-for-C (symbol->string base-name)))\n                       (param-types\t\t(third entry))\n                       (foreign-name\t\t(concat-symbol (or foreign-prefix \"\")\n                                                               mangled-base-name))\n                       (maru-name\t\t(concat-symbol (or maru-prefix \"\") base-name)))\n                  `(define-C-function ,maru-name ,return-type ,foreign-name ,param-types)))\n              entries))))\n\n(define-form define-C-variable (maru-name foreign-name type . attributes)\n  (let ((fv (eval-in-host `(C-variable ,(symbol->string foreign-name)\n                                       ',type ,@attributes))))\n    `(define ,maru-name ,fv)))\n\n(define-form string->C-string (obj)\n  ;; OPTIMIZATION: use the C-string compiler special form to emit cstrings when\n  ;; literals are immediately passed to string->C-string. ideally it\n  ;; should be done by some compiler macro like facility.\n  (cond\n    ((is <string> obj)\n     `(C-string ,obj))\n    ;; FIXME WTF is going on here? can't use (feature\n    ;; emit-with-object-headers) directly, because it evaluates to\n    ;; false. but how? only the slave env should have that variable\n    ;; defined, and it's true while compiling eval.l\n    ((eval '(feature emit-with-object-headers))\n      `(%string->C-string ,obj))\n    (else obj)))\n\n;; NOTE libc.l may choose to replace this with libc/strlen\n(define-function C-string-length (cstr)\n  (let ((i 0))\n    (while (char-at cstr i)\n      (incr i))\n    i))\n")
    ((embedded-path=? path "source/platforms/platform-common.l") ";;; -*- mode: lisp; coding: us-ascii -*-\n;;;\n;;; Common defs for all platforms.\n\n;; 420 is \"rw-r--r--\"\n(define-constant posix/default-file-mode 420)\n\n(define-form align-address-up (var page-size)\n  `(bitwise-and (+ ,var (- ,page-size 1))\n                (- ,page-size)))\n\n(define-form align-address-down (var page-size)\n  `(bitwise-and ,var (- ,page-size)))\n\n(define-form platform/diag-print forms\n  ;; print arguments as diagnotic output. argument expressions can be\n  ;; wrapped into STRING, POINTER, LONG, which is the default when omitted.\n  ;; e.g.: (platform/diag-print \"literal\" (string form2) (pointer form3)\n  ;; (long form4) form5 ...).\n  `(let ()\n     ,@(map (lambda (form)\n              (cond\n                ;; maybe, eventually, evaluate DEFINE-CONSTANTs...\n                ;; ((and (symbol? form)\n                ;;       (defined? form *env*)\n                ;;       (is <form> (variable-value *env* form)))\n                ;;  `(platform/diag-print-string ,(eval form *env*) 10 platform/diag-print-char))\n                ((string? form)\n                 `(platform/diag-print-string ,form))\n                ((and (pair? form)\n                      (= 'string (first form)))\n                 `(platform/diag-print-string ,(second form)))\n                ((and (pair? form)\n                      (= 'pointer (first form)))\n                 `(let ()\n                    (platform/diag-print-string \"0x\")\n                    ;; TODO properly deal with negative numbers\n                    (long->string/emit ,(second form) 16 platform/diag-print-char)))\n                ((and (pair? form)\n                      (= 'long (first form)))\n                 `(long->string/emit ,(second form) 10 platform/diag-print-char))\n                (else\n                 `(long->string/emit ,form 10 platform/diag-print-char))))\n            forms)))\n")
    ((embedded-path=? path "source/platforms/run-compiler.l") ";;; -*- mode: lisp; coding: us-ascii -*-\n\n;; this whole file is just a load-order KLUDGE waiting to be cleaned up...\n\n;; This loads the emit-*-objects.l files that redefine a couple of\n;; functions to emit literals as valid GC objects.\n(when (feature emit-with-object-headers)\n  (eval-in-host\n   '(case *compiler-backend*\n     ((\"x86\" \"arm\")\n      (load \"source/compiler/emit-objects.l\"))\n     (else\n      (load (concat-strings \"source/compiler/emit-objects-\"*compiler-backend*\".l\"))))))\n\n;; write out a .dep file that contains a list of the\n;; dependencies. used/read by build.l.\n(eval-in-host\n `(let ((output-file (pop *command-line-arguments*)))\n    (run-compiler ,*target-env* output-file)\n    (with-open-stream (stream (concat-string output-file \".dep\") \"w\")\n      (dump-all  stream (concat-list ',*load-history* *load-history*))\n      (print-all stream \"\\n\"))))\n\n;;;\n;;; This prints LoC statistics\n;;;\n\n;; TODO currently it takes an extra 3 seconds with the LLVM backend,\n;; and a lot more when compiled with the x86 backend.\n(when (and () (and bootstrapping?\n                   (not evolving?)))\n  ;; let's take a snapshot before we load more files\n  (let ((host-files (host-value *load-history*)))\n\n    (eval-in-host\n     '(let ()\n       (require \"source/sequences.l\")\n       (require \"source/streams.l\")\n       (require \"source/ansiterm.l\")\n       ))\n\n    (eval-in-host\n     `(let ((host-files ',host-files)\n            (slave-files (slave-value *load-history*)))\n        (let ((print-it\n                (lambda (env-name file-list suffix)\n                  (let ((loc (foldr + 0 (map count-maru-loc file-list))))\n                    (print-all *debug-output* env-name \" env loaded \"\n                               (list-length file-list) \" files, \"\n                               term/FG-GREEN term/BOLD loc term/RESET\" LoC \"\n                               suffix \"\\n\")\n                    loc))))\n          (print-it \"Host\"  host-files  \"(the compiler)\")\n          (print-it \"Slave\" slave-files \"(the next eval)\")\n          (print-all *debug-output* \"Host: \"  host-files  \"\\n\")\n          (print-all *debug-output* \"Slave: \" slave-files \"\\n\")\n          ))))\n  ())\n")
    ((embedded-path=? path "source/printing.l") ";;; -*- mode: lisp; coding: us-ascii -*-\n\n(define-selector do-print (self stream)\n  (print-all stream \"[\"(type-name-of self)\" \"(type-id-of self)\"]\"))\n\n(define-selector do-dump (self stream)\n  ;; FIXME this seems recursive\n  (dump-all stream self))\n\n(define-form define-print-method (type . body)\n  `(define-method do-print ,type (-stream-)\n     ,@body))\n\n(define-function print-all (stream . args)\n  (while (pair? args)\n    (do-print (pop args) stream)))\n\n(define-function dump-all (stream . args)\n  (while (pair? args)\n    (do-dump (pop args) stream)))\n\n(define-function print args\n  (let ((l args))\n    (while (pair? l)\n      (do-print (pop l) *standard-output*)))\n  (car args))\n\n(define-function dump args\n  (let ((l args))\n    (while (pair? l)\n      (do-dump (pop l) *standard-output*))\n    (car args)))\n\n(define-function println args\n  (apply print-all (cons *standard-output* args))\n  (do-print \"\\n\" *standard-output*)\n  (car args))\n\n(define-function dumpln args\n  (apply dump-all (cons *standard-output* args))\n  (do-print \"\\n\" *standard-output*)\n  (car args))\n\n(define-function %print-list (stream lst separator storing?)\n  (primitive/print-all stream \"(\")\n  (let ((first-time?\ttrue)\n        (cell\t\tlst))\n    (while (pair? cell)\n      (if first-time?\n          (set first-time? false)\n        (primitive/print-all stream separator))\n      ((if storing? do-dump do-print) (car cell) stream)\n      (set cell (cdr cell)))\n    (when cell\n      (print-all stream \" . \" cell))\n    (primitive/print-all stream \")\")))\n\n(define-function print-list (lst . etc)\n  (let ((separator (or (pop etc) \" \"))\n        (stream    (or (pop etc) *standard-output*)))\n    (%print-list stream lst separator false)))\n\n(with-forms ((redirect (types `(let ()\n                                 ,@(map (lambda (type)\n                                          `(define-print-method ,type\n                                             (primitive/print-all -stream- self)))\n                                        types)))))\n  ;; by default redirect the printing of these types to the do-print primfn of the evaluator.\n  ;; TODO i removed  <target-function> from here; what are the negative consequences?\n  (redirect <undefined> <string> <symbol> <long> <array> <variable>))\n\n(with-forms ((redirect (types `(let ()\n                                 ,@(map (lambda (type)\n                                          `(define-method do-dump ,type (stream)\n                                             (primitive/dump-all stream self)))\n                                        types)))))\n  ;; by default redirect the dumping of these types to the do-print primfn of the evaluator.\n  (redirect <undefined> <string> <symbol> <long> <array>))\n\n(define-print-method <fixed>\t(print-all -stream- \"<fixed \"self.function\">\"))\n(define-print-method <selector>\t(print-all -stream- \"<selector \"self.name\">\"))\n(define-print-method <expr>\t(print-all -stream- \"<expr \"(or (when-at-expand (feature track-expr-names) self.name) \"?\")\" \"self.parameters\">\"))\n(define-print-method <env>\t(print-all -stream- \"<env \"(or (when-at-expand (feature debug-info) self.name) \"?\")\" Lv\"self.level\",Off\"self.offset\",#\"(array-length self.bindings)\">\"))\n(define-print-method <type>\t(print-all -stream- \"<\"(<type>-name self)\" \"(<type>-id self)\">\"))\n(define-print-method <pair>\t(%print-list -stream- self \" \" false))\n(define-print-method <lower-cell> (print-all -stream- \"0x\"(number->string (lower-cell->long self) 16)))\n(when-at-expand (feature track-expr-names)\n  (define-print-method <target-function> (print-all -stream- \"<target-function \"self.name\">\")))\n\n(define-method do-dump <pair> (stream)\n  (%print-list stream self \" \" true))\n\n(define-print-method <array>\n  (primitive/print-all -stream- \"Array(\")\n  (for (i 0 (array-length self))\n    (when (< 0 i)\n      (primitive/print-all -stream- \" \"))\n    (do-print (array-at self i) -stream-))\n  (primitive/print-all -stream- \")\"))\n\n;; (define-function dump-until (target arg)\n;;   (let ((found (= target arg)))\n;;     (if (pair? arg)\n;;         (let ()\n;;           (print \"(\")\n;;           (while arg\n;;             (if (pair? arg)\n;;                 (if (dump-until target (car arg))\n;;                     (let ()\n;;                       (if (cdr arg) (print \" ...\"))\n;;                       (set found true)\n;;                       (set arg ())))\n;;               (let ()\n;;                 (print \". \")\n;;                 (dump-until target arg)))\n;;             (if (set arg (cdr arg))\n;;                 (print \" \")))\n;;           (print \")\"))\n;;       (dump arg))\n;;     found))\n")
    ((embedded-path=? path "source/selector.l") ";;; -*- mode: lisp; coding: us-ascii -*-\n;;;\n;;; selector: functions that dispatch on the type of the first argument, aka single dispatch\n;;;\n\n;; FIXME the slave's slectors cannot be applied in the host while\n;; bootstrapping. this leads to e.g. ASSERT not working properly in\n;; macros, because the host cannot apply the slave's DO-PRINT.\n\n(define-record <selector> () (name methods default))\n\n;; TODO the printing subsystem requires <selector>\n;; (define-print-method <selector>\n;;   (print-all -stream- \"<selector:\"self.name\">\"))\n\n(define-function selector/lookup-effective-method (methods self)\n  (let ((method ())\n        (probe  (type-of self)))\n    (while (and (not (set method (array-at methods (<type>-id probe))))\n                (set probe (and (is <record> probe)\n                                (<record>-super probe)))))\n    ;; we could do something like this for a simple method cache,\n    ;; but this would need some mechanism for invalidation\n    ;; when records get (re)defined.\n    ;; (when method\n    ;;   (set (array-at methods type) method))\n    method))\n\n(define-apply <selector> (self . arguments)\n  (apply\n   (or (selector/lookup-effective-method (<selector>-methods self)\n                                         (car arguments))\n       (<selector>-default self))\n   arguments))\n\n(define-function selector (name default)\n  (make <selector>\n    (name      name)\n    (methods   (array))\n    (default   default)))\n\n(define-function selector/add-method (self type method)\n  (when-at-expand (and (feature track-expr-names)\n                       (not bootstrapping?))\n    ;; expr's (lambdas) are instantiated by the host, so let's not assume anything about their object layout.\n    (when (and (expr? method)\n               (not (<expr>-name method)))\n      (set (<expr>-name method)\n           (concat-symbols (name-of-type type) '. (<selector>-name self)))))\n  (set-array-at (<selector>-methods self) (<type>-id type) method))\n\n(define-form define-selector (name . default)\n  (assert (symbol? name) \"define-selector: name is not a symbol\")\n  (let ((var (defined? name)))\n    (if var\n        (if (is <selector> (<variable>-value var))\n            `(quote ,(<variable>-value var))\n          (error name\" is already defined as non-selector: \" (<variable>-value var)))\n      (unless default\n        (set default `(args (error \"selector '\"',name\n                                   \"' has no method for \"(type-name-of (car args))\n                                   \": \"(cons (car args) (map type-name-of (cdr args)))))))\n      `(define ,name (selector ',name (lambda ,@default))))))\n\n(define-selector add-method)\n\n(selector/add-method add-method <selector>\n  (lambda (self type body)\n    (selector/add-method self type body)))\n\n(define-form define-method (selector type args . body)\n  (or (defined? selector) (eval `(define-selector ,selector) *env*))\n  `(add-method ,selector ,type\n               (lambda (self ,@args)\n                 (with-instance-accessors self ,type\n                   ,@body))))\n")

;;; Native policy proposes scopes/operators from goal, bindings and marginal
;;; index counts. No answer labels, heldout results, Python or neural scoring.
(define-function a92-options (remaining lib)
  (let ((out (b91-primitive remaining)))
    (list-do m (b91-relations lib) (list-do e (b91-embeds (dlm-nth m 2) remaining ())
      (set out (dlm-add out (list 'call91 (dlm-nth m 1)
        (b91-args (dlm-nth e 1) (b91-arity (dlm-nth m 2)))))))) out))
;;; Estimate = (sum marginal sizes + product marginal sizes) / atoms^2.
;;; This deliberately crude cost proxy is not truth or a learned world law.
(define-function a92-estimate (atoms envs index)
  (let ((cost 0) (probes 0)) (list-do env envs
    (let ((sum 0) (product 1)) (list-do a atoms
      (let ((n (dlm-length (a92-lookup index a env))))
        (set sum (+ sum n)) (set product (* product n)) (set probes (+ probes 1))))
      (set cost (+ cost (+ sum product)))))
    (list cost (* (dlm-length atoms) (dlm-length atoms)) probes)))
(define-function a92-choice (s)
  (let* ((ctx (dlm-nth s 2)) (model (dlm-nth ctx 1)) (lib (dlm-nth model 3))
         (ep (a92-episode ctx)) (w (a92-work s)) (p (dlm-nth w 1))
         (policy (dlm-nth ctx 4)) (best ()) (score ()) (probes 0))
    (if (dlm-member? policy '(ordered92 indexed92))
      (set best (car (b91-plan p (dlm-nth model 1) lib)))
      (list-do op (a92-options p lib)
        (let ((one (a92-estimate (a92-op-atoms op ctx) (dlm-nth w 3) (dlm-nth s 3))))
          (set probes (+ probes (dlm-nth one 2)))
          (if (or (not best) (< (* (car one) (dlm-nth score 1)) (* (car score) (dlm-nth one 1)))
                  (and (= (* (car one) (dlm-nth score 1)) (* (car score) (dlm-nth one 1)))
                       (> (dlm-nth one 1) (dlm-nth score 1))))
            (begin (set best op) (set score one))))))
    (let ((ids (if (= policy 'ordered92) (b91-range (dlm-length (dlm-nth ep 3)))
                 (a92-visible-ids (a92-op-atoms best ctx) (dlm-nth w 3) (dlm-nth s 3)))))
      (if (= policy 'narrow92) (set ids (if ids (list (car ids)) ())))
      (list 'choice92 (list 'focus92 (dlm-nth ep 1) (dlm-nth ep 2) (dlm-nth model 5)
          ids (if (= (car best) 'call91) (list (dlm-nth best 1)) ()) best)
        (+ probes (if (= policy 'ordered92) 0
          (* (dlm-length (dlm-nth w 3)) (dlm-length (a92-op-atoms best ctx)))))))))
(define-function a92-focus? (cmd s)
  (let* ((ctx (dlm-nth s 2)) (model (dlm-nth ctx 1)) (ep (a92-episode ctx)) (w (a92-work s)))
    (and (sq-shape? cmd 7) (= (car cmd) 'focus92)
      (equal (dlm-nth cmd 1) (dlm-nth ep 1)) (equal (dlm-nth cmd 2) (dlm-nth ep 2))
      (equal (dlm-nth cmd 3) (dlm-nth model 5))
      (dlm-member? (dlm-nth w 7) '(ready focused)) (< (dlm-length (dlm-nth w 5)) 4)
      (a92-ids? (dlm-nth cmd 4) (b91-range (dlm-length (dlm-nth ep 3))) 8)
      (a92-ids? (dlm-nth cmd 5) (a92-basis-ids (dlm-nth model 3)) 8)
      (a92-op-eligible? (dlm-nth cmd 6) (dlm-nth w 1) ctx)
      (or (= (car (dlm-nth cmd 6)) 'fact91)
          (dlm-member? (dlm-nth (dlm-nth cmd 6) 1) (dlm-nth cmd 5))))))
(define-function a92-focus-work (w cmd lib)
  (let ((frame (list 'frame92 (dlm-nth w 4) (dlm-nth w 6) (dlm-nth w 7))))
    (set w (s79-field w 5 (cons frame (dlm-nth w 5))))
    (set w (s79-field w 4 (list 'scope92 (dlm-nth cmd 4) (a92-dependencies (dlm-nth cmd 5) lib))))
    (set w (s79-field w 6 (list 'intent92 (dlm-nth cmd 6)))) (a92-phase w 'focused)))
(define-function a92-next (s)
  (let ((w (a92-work s)))
    (cond
      ((dlm-member? (dlm-nth w 7) '(complete unknown)) '(halt92))
      ((and (= (dlm-nth w 7) 'ready) (not (dlm-nth w 1)))
        (if (dlm-nth w 5) '(restore92) '(finish92)))
      ((= (dlm-nth w 7) 'ready) '(choose92))
      ((= (dlm-nth w 7) 'focused) '(apply92))
      ((= (dlm-nth w 7) 'applied) '(local92))
      ((= (dlm-nth w 7) 'need-widen) '(widen92))
      ((= (dlm-nth w 7) 'local) '(restore92))
      (else '(halt92)))))

;;; -*- mode: lisp; coding: us-ascii -*-
;;; Propositional Maehara annotations: partition1 |- I and I,partition2 |- .
;;; Neither model enumeration nor an energy threshold constructs I here.
(define-function i79-colors (node lc rc)
  (let* ((rule (dlm-nth node 3)) (pos (dlm-nth node 4)) (left? (= (car pos) 'left))
         (i (dlm-nth pos 1)) (origin (dlm-nth (if left? lc rc) i))
         (l (if left? (sq-remove lc i) lc)) (r (if left? rc (sq-remove rc i))))
    (cond
      ((or (= rule 'top-left) (= rule 'bottom-right)) (list (list l r)))
      ((= rule 'not-left) (list (list l (dlm-append r (list origin)))))
      ((= rule 'not-right) (list (list (dlm-append l (list origin)) r)))
      ((= rule 'and-left) (list (list (dlm-append l (list origin origin)) r)))
      ((= rule 'or-right) (list (list l (dlm-append r (list origin origin)))))
      ((= rule 'imp-right) (list (list (dlm-append l (list origin)) (dlm-append r (list origin)))))
      ((= rule 'and-right) (list (list l (dlm-append r (list origin))) (list l (dlm-append r (list origin)))))
      ((= rule 'or-left) (list (list (dlm-append l (list origin)) r) (list (dlm-append l (list origin)) r)))
      ((= rule 'imp-left) (list (list l (dlm-append r (list origin))) (list (dlm-append l (list origin)) r)))
      (else ()))))
(define-function i79-leaf (node lc rc)
  (let ((rule (dlm-nth node 3)) (pos (dlm-nth node 4)))
    (if (= rule 'init)
        (let ((a (dlm-nth lc (dlm-nth pos 1))) (b (dlm-nth rc (dlm-nth pos 2)))
              (atom (dlm-nth (sq-left (dlm-nth node 2)) (dlm-nth pos 1))))
          (if (= a b) (if (= a 1) '(bottom) '(top))
            (if (= a 1) atom (list 'not atom))))
      (if (= (dlm-nth (if (= (car pos) 'left) lc rc) (dlm-nth pos 1)) 1) '(bottom) '(top)))))
(define-function i79-annotation-step (state)
  (let ((nodes (car state)) (tasks (dlm-nth state 1)) (values (dlm-nth state 2)) (memo (dlm-nth state 3)))
    (if (not tasks) state
      (let* ((task (car tasks)) (op (car task)))
        (set tasks (cdr tasks))
        (if (= op 'visit)
            (let* ((id (dlm-nth task 1)) (lc (dlm-nth task 2)) (rc (dlm-nth task 3))
                   (key (list id lc rc)) (known (dlm-assoc key memo)))
              (if known
                  (set values (cons (dlm-nth known 1) values))
                (let* ((node (s79-at nodes id)) (children (dlm-nth node 6)))
                  (if (not children)
                      (let ((value (i79-leaf node lc rc)))
                        (set memo (s79-put memo key value))
                        (set values (cons value values)))
                    (let* ((colors (i79-colors node lc rc)) (work ()) (k 0) (pos (dlm-nth node 4))
                           (origin (dlm-nth (if (= (car pos) 'left) lc rc) (dlm-nth pos 1))))
                      (list-do child children
                        (let ((c (dlm-nth colors k)))
                          (set work (dlm-append work (list (list 'visit child (car c) (dlm-nth c 1))))))
                        (set k (+ k 1)))
                      (set tasks (dlm-append work (cons
                        (list 'combine (dlm-length children) (if (= origin 1) 'or 'and) id lc rc)
                        tasks))))))))
          (let ((count (dlm-nth task 1)) (parts ()))
            (while (> count 0) (set parts (cons (car values) parts))
              (set values (cdr values)) (set count (- count 1)))
            (let ((value (if (= (dlm-length parts) 1) (car parts)
                           (list (dlm-nth task 2) (car parts) (dlm-nth parts 1)))))
              (set memo (s79-put memo (list (dlm-nth task 3) (dlm-nth task 4) (dlm-nth task 5)) value))
              (set values (cons value values)))))
        (list nodes tasks values memo)))))
(define-function i79-annotation (cert)
  (let ((nodes ())) (list-do n (dlm-nth cert 3) (set nodes (cons (list (dlm-nth n 1) n) nodes)))
    (list nodes (list (list 'visit (dlm-nth cert 2) '(1) '(2))) () ())))
(define-function i79-small? (sig fs)
  (and (sq-signature? sig) (< (dlm-length sig) 999) (sq-formulas? fs sig) (<= (dlm-length (sq-context-atoms fs)) 6)
    (let ((ok true)) (list-do a (sq-context-atoms fs) (if (dlm-nth a 2) (set ok false))) ok)))
(define-function i79-child-job (s meta sig left right)
  (let ((name (concat-strings "internal79-" (number->string meta) "-" (number->string (dlm-length (dlm-nth s 7))))))
    (while (s79-job s name) (set name (concat-strings name "-fresh")))
    (let ((next (s79-proof-job s name (list 'problem 'classical-prop-v1 sig (sq-sequent left right)))))
      (if (= (car next) 'rejected)
          (let* ((u (s79-unit s meta)) (job (car (dlm-nth u 5))))
            (list (s79-job-done (s79-unit-field s meta 4 'failed) job
                    (list 'internal79 'rejected next)) ()))
        (list (s79-watch next name meta) name)))))
(define-function i79-create (s name kind config)
  (if (or (not (sq-name? name)) (s79-job s name)) '(rejected job-name)
    (let ((r (s79-create s kind '(meta) (list name 'start config () ()))))
      (set s (car r))
      (if (not (dlm-nth r 1)) '(rejected unit-capacity)
        (let ((id (car (dlm-nth r 1))))
          (set s (s79-job-put s (list 'job79 name kind 'waiting id () config)))
          (s79-send s (list 'meta id)))))))
(define-function i79-interpolate (s name sig a b)
  (if (not (i79-small? sig (list a b))) '(rejected bounded-nullary-propositional)
    (i79-create s name 'interpolate (list sig a b))))
(define-function i79-stage (s id stage subs payload)
  (let ((d (dlm-nth (s79-unit s id) 5)))
    (s79-unit-field s id 5 (list (car d) stage (dlm-nth d 2) subs payload))))
(define-function i79-done (s id result)
  (let ((name (car (dlm-nth (s79-unit s id) 5))))
    (s79-job-done (s79-finish s id 'done result) name result)))
(define-function i79-subdone? (s names)
  (let ((yes true)) (list-do name names (if (not (= (dlm-nth (s79-job s name) 3) 'done)) (set yes false))) yes))
(define-function i79-subresult (s name) (dlm-nth (s79-job s name) 5))
(define-function i79-all-proved? (s names)
  (let ((yes true)) (list-do name names
    (if (not (= (dlm-nth (i79-subresult s name) 1) 'proved)) (set yes false))) yes))
(define-function i79-interpolate-step (s id)
  (let* ((u (s79-unit s id)) (d (dlm-nth u 5)) (stage (dlm-nth d 1))
         (config (dlm-nth d 2)) (sig (car config)) (a (dlm-nth config 1)) (b (dlm-nth config 2))
         (subs (dlm-nth d 3)) (payload (dlm-nth d 4)))
    (cond
      ((= stage 'start)
        (let ((r (i79-child-job s id sig (list a) (list b))))
          (if (not (dlm-nth r 1)) (car r)
            (i79-stage (car r) id 'search (list (dlm-nth r 1)) ()))))
      ((= stage 'search)
        (if (not (i79-subdone? s subs)) s
          (if (not (i79-all-proved? s subs)) (i79-done s id (list 'interpolant79 'not-entailed (i79-subresult s (car subs))))
            (let* ((cert (dlm-nth (i79-subresult s (car subs)) 2)) (annotation (i79-annotation cert)))
              (s79-send (i79-stage s id 'annotate subs annotation) (list 'meta id))))))
      ((= stage 'annotate)
        (if (dlm-nth payload 1)
            (s79-send (i79-stage s id stage subs (i79-annotation-step payload)) (list 'meta id))
          (let* ((candidate (car (dlm-nth payload 2)))
                 (shared (dlm-difference (sq-atoms a) (dlm-difference (sq-atoms a) (sq-atoms b)))))
            (if (or (not (sq-formula? 'classical-prop-v1 candidate sig)) (dlm-difference (sq-atoms candidate) shared))
                (i79-done s id '(interpolant79 incomplete annotation-limit))
              (let* ((r1 (i79-child-job s id sig (list a) (list candidate)))
                     (r2 (i79-child-job (car r1) id sig (list candidate) (list b))))
                (i79-stage (car r2) id 'verify (list (dlm-nth r1 1) (dlm-nth r2 1))
                  (list candidate (dlm-nth (i79-subresult s (car subs)) 2))))))))
      ((= stage 'verify)
        (if (not (i79-subdone? s subs)) s
          (i79-done s id (list 'interpolant79 (if (i79-all-proved? s subs) 'verified 'invalid-annotation)
            (car payload) (dlm-nth payload 1) (i79-subresult s (car subs)) (i79-subresult s (dlm-nth subs 1))))))
      (else s))))
(define-function i79-beth (s name sig theory target)
  (if (not (and (b78-small? sig (list theory target)) (not (dlm-assoc name (dlm-nth s 12)))
                (< (dlm-length sig) 998)
                (< (dlm-length (dlm-nth s 12)) s79-definition-limit) (= (car target) 'pred) (not (dlm-nth target 2))))
      '(rejected bounded-beth)
    (i79-create s name 'beth (list sig theory target))))
(define-function i79-beth-step (s id)
  (let* ((d (dlm-nth (s79-unit s id) 5)) (name (car d)) (stage (dlm-nth d 1))
         (config (dlm-nth d 2)) (sig (car config)) (theory (dlm-nth config 1)) (p (dlm-nth config 2))
         (subs (dlm-nth d 3)) (payload (dlm-nth d 4)))
    (cond
      ((= stage 'start)
        (let ((fresh-name "beth79-fresh") (n 0))
          (while (dlm-assoc fresh-name sig)
            (set n (+ n 1)) (set fresh-name (concat-strings "beth79-fresh-" (number->string n))))
          (let* ((fresh (list 'pred fresh-name ())) (extended (dlm-append sig (list (list fresh-name 0))))
                 (renamed (p78-replace theory (list (list p fresh))))
                 (r1 (i79-child-job s id sig (list theory) '((bottom)))))
            (if (not (dlm-nth r1 1)) (car r1)
              (let ((r2 (i79-child-job (car r1) id extended (list theory renamed)
                          (list (list 'and (list 'imp p fresh) (list 'imp fresh p))))))
                (if (not (dlm-nth r2 1)) (car r2)
                  (i79-stage (car r2) id 'unique (list (dlm-nth r1 1) (dlm-nth r2 1))
                    (list extended renamed fresh))))))))
      ((= stage 'unique)
        (if (not (i79-subdone? s subs)) s
          (if (= (dlm-nth (i79-subresult s (car subs)) 1) 'proved)
              (i79-done s id '(beth79 rejected inconsistent-theory))
            (if (not (= (dlm-nth (i79-subresult s (dlm-nth subs 1)) 1) 'proved))
                (i79-done s id (list 'beth79 'not-defined (i79-subresult s (dlm-nth subs 1))))
              (let ((child (s79-free-name s (concat-strings "beth79-interpolate-" (number->string id)))))
                (set s (i79-interpolate s child (car payload) (list 'and theory p)
                  (list 'imp (dlm-nth payload 1) (dlm-nth payload 2))))
                (set s (s79-watch s child id))
                (i79-stage s id 'extract (list child) (list (i79-subresult s (dlm-nth subs 1))
                  (i79-subresult s (car subs)))))))))
      ((= stage 'extract)
        (if (not (i79-subdone? s subs)) s
          (let* ((r (i79-subresult s (car subs))) (candidate (dlm-nth r 2)))
            (if (not (= (dlm-nth r 1) 'verified)) (i79-done s id (list 'beth79 'incomplete r))
              (let ((r1 (i79-child-job s id sig (list theory p) (list candidate))))
                (if (not (dlm-nth r1 1)) (car r1)
                  (let ((r2 (i79-child-job (car r1) id sig (list theory candidate) (list p))))
                    (if (not (dlm-nth r2 1)) (car r2)
                      (i79-stage (car r2) id 'verify (list (dlm-nth r1 1) (dlm-nth r2 1))
                        (list candidate payload r))))))))))
      ((= stage 'verify)
        (if (not (i79-subdone? s subs)) s
          (if (not (i79-all-proved? s subs)) (i79-done s id '(beth79 incomplete definition-check))
            (if (or (>= (dlm-length (dlm-nth s 12)) s79-definition-limit)
                    (dlm-assoc name (dlm-nth s 12)))
                (i79-done s id '(beth79 incomplete capacity))
              (let ((definition (list 'definition79 name sig p (car payload) theory 'beth
                      (list payload (i79-subresult s (car subs)) (i79-subresult s (dlm-nth subs 1))))))
                (set s (s79-field s 12 (s79-put (dlm-nth s 12) name definition)))
                (i79-done s id (list 'beth79 'verified definition)))))))
      (else s))))
;;; Learning is an explicit multi-event task over actual solved sub-obligations.
(define d79-auto-name ())
(define-function i79-learn (s name proof-name)
  (let ((j (s79-job s proof-name)))
    (if (not (and j (= (dlm-nth j 2) 'proof) (= (dlm-nth j 3) 'done)
                  (= (dlm-nth (dlm-nth j 5) 1) 'proved))) '(rejected completed-proof-required)
      (i79-create s name 'learn (list (dlm-nth j 4))))))
(define-function i79-learn-step (s id)
  (let* ((d (dlm-nth (s79-unit s id) 5)) (stage (dlm-nth d 1))
         (todo (if (= stage 'start) (dlm-nth d 2) (dlm-nth d 3)))
         (seen (if (= stage 'start) () (dlm-nth d 4))))
    (if (not todo) (i79-done s id (list 'learned79 'patterns (dlm-length (dlm-nth s 8))))
      (let* ((node (car todo)) (u (s79-unit s node)))
        (set todo (cdr todo))
        (if (not (dlm-member? node seen))
            (begin
              (set seen (cons node seen))
              (if (and (= (dlm-nth u 2) 'prove) (= (dlm-nth u 4) 'proved))
                  (let* ((data (dlm-nth u 5)) (cert (s79-certificate s node))
                         (lib (p78-admit (dlm-nth s 8) (list 'problem 'classical-prop-v1 (car data) (dlm-nth data 1)) cert)))
                    (if (not (equal lib (dlm-nth s 8)))
                        (begin
                          (set s (s79-field s 8 lib))
                          (set s (s79-field s 2 (+ (dlm-nth s 2) 1)))
                          (set s (s79-field s 13 (cons (list (dlm-nth s 2) lib) (dlm-nth s 13))))))
                    (set s (d79-auto-name s (car (dlm-nth u 5)) (dlm-nth (dlm-nth u 5) 1)))
                    (let ((r (dlm-nth u 8)))
                      (if (= (car r) 'via)
                          (set todo (dlm-append (dlm-nth (s79-unit s (dlm-nth r 1)) 6) todo))))))))
        (s79-send (i79-stage s id 'learn todo seen) (list 'meta id))))))
(set s79-meta-step (lambda (s id)
  (let ((u (s79-unit s id)))
    (if (= (dlm-nth u 4) 'done) s
      (cond
        ((= (dlm-nth u 2) 'interpolate) (i79-interpolate-step s id))
        ((= (dlm-nth u 2) 'beth) (i79-beth-step s id))
        ((= (dlm-nth u 2) 'learn) (i79-learn-step s id))
        (else s))))))

;;; -*- mode: lisp; coding: us-ascii -*-
;;; The (dlm 'COMMAND ...) API avoids shadowing legacy dlm-step/status/observe.
;;; Maru owns scheduling; this module owns model and learning semantics.
(define *dlm-model* (a77-new))
(define *dlm-round* 0)
(define *dlm-events* ())
(define *dlm-cursor* 0)
(define *dlm-running* false)
(define *dlm-saturated* false)
(define *dlm-store* ())
(define *dlm-lock* ())
(define *dlm-pair-budget* 200)
(define *dlm-last* '(ready))

(define-function d77-status ()
  (list 'dlm77 (if *dlm-running* 'running 'paused) 'round *dlm-round*
        'episodes (dlm-length (a77-episodes *dlm-model*))
        'definitions (dlm-length (a77-defs *dlm-model*)) 'cursor *dlm-cursor*
        'last *dlm-last* 'store *dlm-store*))
(define-function d77-library () (a77-defs *dlm-model*))
(define-function d77-save ()
  (if (not *dlm-store*) (list 'not-attached)
    (if (d77-checkpoint *dlm-store* (list 'dlm-session77 1 *dlm-model* *dlm-round* *dlm-events*))
        (list 'saved *dlm-store*) (list 'rejected 'checkpoint))))
(define-function d77-pause ()
  (repl-idle-task ()) (set *dlm-running* false) (list 'paused))
(define-function d77-stop ()
  (d77-pause)
  (if *dlm-store* (d77-save) (list 'paused 'in-memory)))
(define-function d77-close ()
  (let ((r (d77-stop)))
    (if (and *dlm-store* (not (= (car r) 'saved))) r
      (begin (if *dlm-lock* (file-close *dlm-lock*))
        (set *dlm-lock* ()) (set *dlm-store* ()) (list 'closed)))))
(define-function d77-open (path)
  (if (not (string? path)) (list 'rejected 'path)
    (if *dlm-store* (list 'rejected 'close-current-store-first)
      (let ((lock (file-lock (concat-strings path ".lock"))))
        (if (not lock) (list 'rejected 'locked-or-path-unavailable)
          (let ((r (d77-read path)))
            (if (= (car r) 'rejected) (begin (file-close lock) r)
              (if (and (= (car r) 'loaded) (not (equal *dlm-model* (a77-new)))
                       (not (equal *dlm-model* (dlm-nth (dlm-nth r 1) 2))))
                  (begin (file-close lock) (list 'rejected 'reset-before-restore))
                (begin (d77-pause)
                  (if (= (car r) 'loaded)
                      (begin (set *dlm-model* (dlm-nth (dlm-nth r 1) 2))
                             (set *dlm-round* (dlm-nth (dlm-nth r 1) 3))
                             (set *dlm-events* (dlm-nth (dlm-nth r 1) 4))))
                  (set *dlm-cursor* 0) (set *dlm-saturated* false)
                  (set *dlm-store* path) (set *dlm-lock* lock)
                  (set *dlm-last* (list 'restored (car r))) (d77-status))))))))))
(define-function d77-commit (next event)
  (let ((events (if (= (car event) 'reset) ()
                  (if (equal next *dlm-model*) *dlm-events* (dlm-append *dlm-events* (list event))))))
    (if (not (and (a77-valid? next) (dlm-proper? events 256))) (list 'rejected 'invalid-transition-or-event-limit)
      (if (and *dlm-store*
               (not (d77-checkpoint *dlm-store* (list 'dlm-session77 1 next *dlm-round* events))))
          (begin (d77-pause) (list 'rejected 'checkpoint))
        (begin (set *dlm-model* next) (set *dlm-events* events)
               (set *dlm-cursor* 0) (set *dlm-saturated* false) (list 'committed))))))
(define-function d77-observe (id facts)
  (let ((r (a77-observe *dlm-model* id facts)))
    (if (= (car r) 'observed)
        (let ((commit (d77-commit (dlm-nth r 1) (list 'observe id facts))))
          (set *dlm-last* (if (= (car commit) 'committed) (list 'observed id) commit))
          *dlm-last*) r)))
(define-function d77-retract (id)
  (if (not (a77-name? id)) (list 'rejected 'source-id)
    (let ((r (d77-commit (a77-retract *dlm-model* id) (list 'retract id))))
      (set *dlm-last* (if (= (car r) 'committed) (list 'retracted id) r)) *dlm-last*)))
(define-function d77-reset ()
  (d77-pause)
  (let ((old-round *dlm-round*))
    (set *dlm-round* 0)
    (let ((r (d77-commit (a77-new) '(reset))))
      (if (= (car r) 'committed) (set *dlm-last* '(reset)) (set *dlm-round* old-round)) r)))
(define-function d77-step ()
  (set *dlm-round* (+ *dlm-round* 1))
  (let ((r (if *dlm-saturated* (list 'waiting *dlm-model* 0 0)
             (a77-step *dlm-model* *dlm-cursor* *dlm-pair-budget*))))
    (if (or (= (car r) 'saturated) (= (car r) 'capacity)) (set *dlm-saturated* true))
    (set *dlm-cursor* (dlm-nth r 2))
    (if (= (car r) 'learned)
        (let ((commit (d77-commit (dlm-nth r 1) (list 'define (dlm-nth r 4)))))
          (set *dlm-last* (if (= (car commit) 'committed)
                              (list 'learned (dlm-nth r 4) 'instances (dlm-nth r 5) 'pair-checks (dlm-nth r 3)) commit)))
      (set *dlm-last* (list (car r) 'pair-checks (dlm-nth r 3))))
    (list 'round *dlm-round* *dlm-last*)))
(define-function d77-tick ()
  (let ((r (d77-step)))
    (print "[DLM round " *dlm-round* "] ")
    (if (= (car *dlm-last*) 'learned)
        (let* ((d (dlm-nth *dlm-last* 1)) (op (dlm-nth d 3)))
          (print "Defined " (dlm-nth d 1) " by composing " (dlm-nth op 1) " then " (dlm-nth op 2)
                 "; primitive path " (dlm-nth d 2) "; checked " (dlm-nth *dlm-last* 3)
                 " source instances.\n"))
      (if (= (car *dlm-last*) 'saturated)
          (print "No new reusable definition in the current bounded grammar; waiting for evidence.\n")
        (if (= (car *dlm-last*) 'incomplete)
            (print "Search budget exhausted; continuing from cursor " *dlm-cursor* ".\n")
          (if (= (car *dlm-last*) 'waiting)
              (print "Still waiting for new evidence; no learning update.\n")
            (print "No admission: " *dlm-last* ".\n"))))) r))
(define-function d77-start milliseconds
  (let ((interval (if milliseconds (car milliseconds) 1000)))
    (if (not (and (is <long> interval) (>= interval 20) (<= interval 60000)))
        (list 'rejected 'interval)
      (begin (repl-idle-task '(d77-tick) interval) (set *dlm-running* true) (d77-status)))))
(define-function d77-query (episode goal) (a77-query *dlm-model* episode goal))
(define-function d77-help ()
  (print "DLM77 commands in the existing Maru REPL:\n"
    " (dlm 'open \"path.sexp\")  attach/replay a locked data-only snapshot\n"
    " (dlm 'observe 'id '((atom edge (a b)) ...))\n"
    " (dlm 'start 1000)         learn while the existing reader waits\n"
    " (dlm 'pause) (dlm 'step) (dlm 'status) (dlm 'library)\n"
    " (dlm 'query 'id '(atom \"c77-0\" (a c)))\n"
    " (dlm 'retract 'id) (dlm 'save) (dlm 'stop) (dlm 'close)\n"
    " (dlm 'demo) loads explicit source fixtures, not domain axioms.\n")
  (list 'commands-listed))
(define-function d77-demo ()
  (let ((a (d77-observe 'demo-a '((atom edge (a b)) (atom edge (b c)) (atom edge (c d)) (atom edge (d e)))))
        (b (d77-observe 'demo-b '((atom edge (u v)) (atom edge (v w)) (atom edge (w x)) (atom edge (x y))))))
    (list a b)))

(define-function dlm args
  (let ((op (car args)) (rest (cdr args)) (n (dlm-length (cdr args))))
    (cond
      ((and (= op 'status) (= n 0)) (d77-status))
      ((and (= op 'library) (= n 0)) (d77-library))
      ((and (= op 'save) (= n 0)) (d77-save))
      ((and (= op 'pause) (= n 0)) (d77-pause))
      ((and (= op 'stop) (= n 0)) (d77-stop))
      ((and (= op 'close) (= n 0)) (d77-close))
      ((and (= op 'open) (= n 1)) (d77-open (car rest)))
      ((and (= op 'observe) (= n 2)) (d77-observe (car rest) (dlm-nth rest 1)))
      ((and (= op 'retract) (= n 1)) (d77-retract (car rest)))
      ((and (= op 'reset) (= n 0)) (d77-reset))
      ((and (= op 'step) (= n 0)) (d77-step))
      ((and (= op 'start) (<= n 1)) (apply d77-start rest))
      ((and (= op 'query) (= n 2)) (d77-query (car rest) (dlm-nth rest 1)))
      ((and (= op 'demo) (= n 0)) (d77-demo))
      ((or (not args) (and (= op 'help) (= n 0))) (d77-help))
      (else (list 'rejected 'command-or-arity)))))

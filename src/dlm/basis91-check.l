;;; Independent admission/witness checks. No planner, enumerator or matcher calls.
;;; Every variable role remains visible: reorder conjunctions, never project away
;;; a shared variable or silently change its binding. Definitions are prefix checked.
(define-function b91-witness? (p row ep)
  (and (sq-shape? row 3) (= (car row) 'match91)
       (dlm-proper? (dlm-nth row 1) 4) (= (dlm-length (dlm-nth row 1)) (b91-arity p))
       (dlm-proper? (dlm-nth row 2) 3) (= (dlm-length (dlm-nth row 2)) (dlm-length p))
    (let ((ok true) (values (dlm-nth row 1)) (ids (dlm-nth row 2)) (facts (dlm-nth ep 3)))
      (list-do x values (if (not (b91-name? x)) (set ok false)))
      (list-do a p
        (let ((i (car ids)))
          (if (not (and ok (is <long> i) (>= i 0) (< i (dlm-length facts))
                     (equal (dlm-nth facts i)
                       (list 'atom (car a) (list (dlm-nth values (dlm-nth a 1)) (dlm-nth values (dlm-nth a 2)))))))
            (set ok false)))
        (set ids (cdr ids))) ok)))
(define-function b91-rows? (p rows ep)
  (and (dlm-proper? rows 512)
    (let ((ok true) (seen ())) (list-do row rows
      (if (and (b91-witness? p row ep) (not (dlm-member? (dlm-nth row 1) seen)))
        (set seen (cons (dlm-nth row 1) seen)) (set ok false))) ok)))
(define-function b91-core? (core)
  (and (sq-shape? core 6) (= (car core) 'basis-core91)
       (b90-names? (dlm-nth core 1) 4) (dlm-nth core 1)
       (b91-library? (dlm-nth core 3) (dlm-nth core 1))
       (is <long> (dlm-nth core 5)) (= (dlm-nth core 5) (dlm-length (dlm-nth core 3)))
       (dlm-proper? (dlm-nth core 2) 4) (dlm-proper? (dlm-nth core 4) 368)
    (let ((ok true) (ids ()) (sig (dlm-nth core 1)) (eps (dlm-nth core 2)) (keys ()))
      (list-do ep eps
        (if (and (sq-shape? ep 5) (= (car ep) 'episode91) (b91-name? (dlm-nth ep 1))
                 (not (dlm-member? (dlm-nth ep 1) ids)) (is <long> (dlm-nth ep 2))
                 (> (dlm-nth ep 2) 0) (<= (dlm-nth ep 2) 32)
                 (b91-facts? (dlm-nth ep 3) sig) (or (equal (dlm-nth ep 4) true) (not (dlm-nth ep 4))))
          (set ids (cons (dlm-nth ep 1) ids)) (set ok false)))
      (if ok (list-do v (dlm-nth core 4)
        (if (not (and (sq-shape? v 6) (= (car v) 'reading91) (b91-name? (dlm-nth v 1)))) (set ok false)
          (let ((ep (b91-find eps (dlm-nth v 1))) (p (dlm-nth v 3)))
            (if (and ep (dlm-nth ep 4) (= (dlm-nth v 2) (dlm-nth ep 2))
                     (b91-pattern? p sig) (>= (dlm-length p) 2) (equal p (b91-canonical p sig))
                     (not (dlm-member? (list (dlm-nth v 1) p) keys))
                     (b91-plan? p (dlm-nth v 4) sig (dlm-nth core 3))
                     (dlm-nth v 5) (b91-rows? p (dlm-nth v 5) ep))
              (set keys (cons (list (dlm-nth v 1) p) keys)) (set ok false)))))) ok)))
;;; Runtime core check: no training evidence, support counters or audit needed.
;;; This checks meaning of definitions/plans, not provenance/authenticity of a file.
(define-function b91-model? (model)
  (and (sq-shape? model 6) (= (car model) 'execution-core91)
       (b91-core? (list 'basis-core91 (dlm-nth model 1) (dlm-nth model 2)
                        (dlm-nth model 3) () (dlm-nth model 5)))
       (dlm-proper? (dlm-nth model 4) 368)
    (let ((ok true) (keys ()))
      (list-do v (dlm-nth model 4)
        (if (not (and (sq-shape? v 5) (= (car v) 'reading91) (b91-name? (dlm-nth v 1)))) (set ok false)
          (let ((ep (b91-find (dlm-nth model 2) (dlm-nth v 1))) (p (dlm-nth v 3)))
            (if (and ep (dlm-nth ep 4) (= (dlm-nth ep 2) (dlm-nth v 2))
                     (b91-pattern? p (dlm-nth model 1)) (>= (dlm-length p) 2)
                     (equal p (b91-canonical p (dlm-nth model 1)))
                     (not (dlm-member? (list (dlm-nth v 1) p) keys))
                     (b91-plan? p (dlm-nth v 4) (dlm-nth model 1) (dlm-nth model 3)))
              (set keys (cons (list (dlm-nth v 1) p) keys)) (set ok false))))) ok)))
(define-function b91-state? (s)
  (and (sq-shape? s 8) (= (car s) 'basis-state91) (= (dlm-nth s 1) 1)
       (dlm-proper? (dlm-nth s 6) 32) (b91-core? (b91-core s))))
(define-function b91-insert (x xs)
  (if (not xs) (list x) (if (< x (car xs)) (cons x xs) (cons (car xs) (b91-insert x (cdr xs))))))
(define-function b91-fact-key (ids)
  (let ((out ())) (list-do i ids (if (not (dlm-member? i out)) (set out (b91-insert i out)))) out))
;;; Count distinct source applications, not repeated interpretations or automorphisms.
(define-function b91-support (p readings)
  (let ((keys ())) (list-do v readings
    (if (equal p (dlm-nth v 3))
      (list-do row (dlm-nth v 5)
        (let ((facts (b91-fact-key (dlm-nth row 2))))
          (if (= (dlm-length facts) (dlm-length p))
            (set keys (dlm-add keys (list (dlm-nth v 1) (dlm-nth v 2) facts))))))))
    (dlm-length keys)))
(define-function b91-calls (plan id)
  (let ((n 0)) (list-do op plan
    (if (and (= (car op) 'call91) (= (dlm-nth op 1) id)) (set n (+ n 1)))) n))
(define-function b91-check-learn (s module rewrites)
  (if (not (b91-state? s)) '(rejected91 state)
    (let* ((sig (dlm-nth s 2)) (lib (dlm-append (dlm-nth s 4) (list module)))
           (readings (dlm-nth s 5)) (next ()) (ok true) (uses 0))
      (if (not (and (b91-library? lib sig) (equal (dlm-nth module 2) (b91-canonical (dlm-nth module 2) sig))
                    (= (dlm-length (dlm-nth module 3)) 2)
                    (>= (b91-support (dlm-nth module 2) readings) 2)
                    (dlm-proper? rewrites 368) (= (dlm-length readings) (dlm-length rewrites))))
        '(rejected91 definition-or-support)
        (begin
          (list-do v readings
            (let ((r (car rewrites)))
              (if (and (sq-shape? r 6) (= (car r) 'rewrite91)
                       (equal (dlm-nth r 1) (dlm-nth v 1)) (equal (dlm-nth r 2) (dlm-nth v 2))
                       (equal (dlm-nth r 3) (dlm-nth v 3)) (equal (dlm-nth r 4) (dlm-nth v 4))
                       (b91-plan? (dlm-nth v 3) (dlm-nth r 5) sig lib))
                (begin (set next (dlm-append next (list (s79-field v 4 (dlm-nth r 5)))))
                  (set uses (+ uses (* (dlm-length (dlm-nth v 5)) (b91-calls (dlm-nth r 5) (dlm-nth module 1))))))
                (set ok false)))
            (set rewrites (cdr rewrites)))
          (if (and ok (>= uses 2) (< (b91-work-size next) (b91-work-size readings)))
            (list 'checked91 lib next) '(rejected91 rewrite-or-no-replacement)))))))

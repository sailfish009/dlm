;;; Independent experimental API; does not mutate dlm/space/contracts globals.
;;; Core and justification audit have separate snapshot fields. They are not yet
;;; separate blob files. Untrusted restore independently replays the audit.
(define-function b90-pack (s) (list 'basis-session90 1 (b90-core s) (dlm-nth s 6)))
(define-function b90-snapshot? (x)
  (and (sq-shape? x 4) (= (car x) 'basis-session90) (= (dlm-nth x 1) 1)
       (b90-core? (dlm-nth x 2)) (dlm-proper? (dlm-nth x 3) 64)
       (let ((s (b90-replay (dlm-nth (dlm-nth x 2) 1) (dlm-nth x 3))))
         (and (= (car s) 'basis-state90) (equal (b90-core s) (dlm-nth x 2))))))
(define *b90-state* (b90-new '(edge)))
(define *b90-path* ())
(define *b90-lock* ())
(define *b90-expected* '(missing))
(define-function b90-checkpoint (path snapshot expected)
  (if (not (and (b90-snapshot? snapshot) (equal (e79-raw-read path) expected))) false
    (let ((tmp (concat-strings path ".next")) (ok true))
      (set ok (and (d77-write tmp snapshot) (equal (e79-raw-read tmp) (list 'data snapshot))))
      (if (and ok (= (car expected) 'data))
        (let ((prior (concat-strings path ".previous.next")))
          (set ok (and (d77-write prior (dlm-nth expected 1))
                       (equal (e79-raw-read prior) expected)
                       (file-replace prior (concat-strings path ".previous"))))))
      (if ok (set ok (and (equal (e79-raw-read path) expected) (file-replace tmp path))))
      (if (not ok) (file-remove tmp)) ok)))
(define-function b90-summary ()
  (let ((s *b90-state*))
    (list 'basis90 'epoch (dlm-nth s 7) 'episodes (dlm-length (dlm-nth s 3))
      'tasks (dlm-length (dlm-nth s 5)) 'basis-count (dlm-length (dlm-nth s 4))
      'work-nodes (b90-work-size (dlm-nth s 5)) 'basis-body-nodes (b90-basis-size (dlm-nth s 4))
      'events (dlm-length (dlm-nth s 6)) 'store *b90-path*)))
(define-function b90-commit (event)
  (let ((next (b90-apply *b90-state* event)))
    (if (= (car next) 'rejected90) next
      (let ((snapshot (b90-pack next)))
        (if (and *b90-path* (not (b90-checkpoint *b90-path* snapshot *b90-expected*)))
          '(rejected90 checkpoint)
          (begin (set *b90-state* next)
            (if *b90-path* (set *b90-expected* (list 'data snapshot)))
            (list 'committed90 (car event) 'epoch (dlm-nth next 7))))))))
(define-function b90-save ()
  (if (not *b90-path*) '(rejected90 not-attached)
    (let ((snapshot (b90-pack *b90-state*)))
      (if (b90-checkpoint *b90-path* snapshot *b90-expected*)
        (begin (set *b90-expected* (list 'data snapshot)) '(saved90)) '(rejected90 checkpoint)))))
(define-function b90-open (path)
  (if (not (and (string? path) (not (equal path "")) (not *b90-path*))) '(rejected90 path-or-close-first)
    (let ((lock (file-lock (concat-strings path ".lock"))))
      (if (not lock) '(rejected90 locked-or-path)
        (let ((old (e79-raw-read path)) (incoming ()) (ok true))
          (cond
            ((= (car old) 'missing) (set incoming *b90-state*))
            ((and (= (car old) 'data) (b90-snapshot? (dlm-nth old 1)))
              (set incoming (b90-replay (dlm-nth (dlm-nth (dlm-nth old 1) 2) 1) (dlm-nth (dlm-nth old 1) 3)))
              (if (and (dlm-nth *b90-state* 6) (not (equal incoming *b90-state*))) (set ok false)))
            (else (set ok false)))
          (if (not ok) (begin (file-close lock) '(rejected90 snapshot-or-reset-first))
            (begin (set *b90-state* incoming) (set *b90-lock* lock)
                   (set *b90-path* path) (set *b90-expected* old) (b90-summary))))))))
(define-function b90-close ()
  (if (not *b90-path*) '(closed90)
    (let ((r (b90-save)))
      (if (not (= (car r) 'saved90)) r
        (begin (file-close *b90-lock*) (set *b90-lock* ()) (set *b90-path* ())
               (set *b90-expected* '(missing)) '(closed90))))))
(define-function basis90 args
  (let ((op (car args)) (rest (cdr args)) (n (dlm-length (cdr args))))
    (cond
      ((and (= op 'init) (= n 1) (not *b90-path*))
        (let ((s (b90-new (car rest)))) (if (= (car s) 'rejected90) s
          (begin (set *b90-state* s) (b90-summary)))))
      ((and (= op 'open) (= n 1)) (b90-open (car rest)))
      ((and (= op 'save) (= n 0)) (b90-save))
      ((and (= op 'close) (= n 0)) (b90-close))
      ((and (= op 'state) (= n 0)) *b90-state*)
      ((and (= op 'status) (= n 0)) (b90-summary))
      ((and (= op 'snapshot) (= n 0)) (b90-pack *b90-state*))
      ((and (= op 'candidates) (= n 0)) (b90-candidates *b90-state*))
      ((and (= op 'proposal) (= n 0)) (b90-propose *b90-state*))
      ((and (= op 'learn) (= n 0))
        (if (>= (dlm-length (dlm-nth *b90-state* 6)) 64) '(rejected90 event-capacity)
          (let ((p (b90-propose *b90-state*)))
            (if (= (car p) 'learn90) (b90-commit p) p))))
      ((and (= op 'observe) (= n 2)) (b90-commit (cons 'observe90 rest)))
      ((and (= op 'retract) (= n 1)) (b90-commit (cons 'retract90 rest)))
      ((and (= op 'task) (= n 2)) (b90-commit (cons 'task90 rest)))
      ((and (= op 'run) (or (= n 3) (= n 4)))
        (b90-execute *b90-state* (car rest) (dlm-nth rest 1) (dlm-nth rest 2)
          (if (= n 4) (dlm-nth rest 3) 'basis)))
      ((and (= op 'query) (or (= n 3) (= n 4)))
        (b90-query *b90-state* (car rest) (dlm-nth rest 1) (dlm-nth rest 2)
          (if (= n 4) (dlm-nth rest 3) 'basis)))
      (else '(rejected90 command-or-arity)))))

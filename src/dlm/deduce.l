;;; deduce.l — fixed-data / fixed-axiom deductive matching.
(define-function d-task (name facts pos neg) (list 'task name facts pos neg))
(define-function d-task? (t)
  (and (l-shape? t 5) (equal (car t) 'task) (l-name? (l-nth t 1))
       (l-list? (l-nth t 2)) (l-list? (l-nth t 3)) (l-list? (l-nth t 4))
       (not (l-any? (lambda (a) (not (l-ground-atom? a))) (l-nth t 2)))
       (not (l-any? (lambda (a) (not (l-ground-atom? a))) (l-nth t 3)))
       (not (l-any? (lambda (a) (not (l-ground-atom? a))) (l-nth t 4)))))
(define-function d-name (t) (l-nth t 1))
(define-function d-facts (t) (l-nth t 2))
(define-function d-pos (t) (l-nth t 3))
(define-function d-neg (t) (l-nth t 4))
(define-function d-axiom (id rules) (list 'axiom id rules))
(define-function d-axiom? (a)
  (and (l-shape? a 3) (equal (car a) 'axiom) (l-name? (l-nth a 1))
       (l-list? (l-nth a 2))
       (not (l-any? (lambda (r) (not (l-rule? r))) (l-nth a 2)))))
(define-function d-axiom-id (a) (l-nth a 1))
(define-function d-axiom-rules (a) (l-nth a 2))
(define-function d-find (lib id)
  (let ((out ())) (list-do a lib (if (equal id (d-axiom-id a)) (set out a))) out))
(define-function d-rules (lib ids)
  (let ((out ()))
    (list-do id ids
      (let ((a (d-find lib id)))
        (if a (set out (l-append out (d-axiom-rules a))))))
    out))
(define-function d-fact-records (t)
  (let ((out ()) (i 0))
    (list-do a (d-facts t)
      (set out (l-append out (list (l-fact (concat-strings "t" (number->string i)) a))))
      (set i (+ i 1)))
    out))
(define-function d-covered (atoms table)
  (let ((n 0)) (list-do a atoms (if (l-lookup a table) (set n (+ n 1)))) n))
(define-function d-eval (t rules budget)
  (let* ((c (l-close (d-fact-records t) rules budget)) (table (l-nth c 1)))
    (list (d-covered (d-pos t) table)
          (l-len (d-pos t))
          (d-covered (d-neg t) table))))
(define-function d-select (t lib active budget)
  (let* ((base (d-eval t (d-rules lib active) budget))
         (bc (l-nth base 0)) (bt (l-nth base 1)) (bf (l-nth base 2)))
    (if (and (= bc bt) (= bf 0))
      (list 'kept active bc bt bf)
      (let ((best ()) (best-c bc) (best-f bf))
        (list-do a lib
          (let ((id (d-axiom-id a)))
            (if (not (l-member? id active))
              (let ((e (d-eval t (d-rules lib (l-append active (list id))) budget)))
                (if (and (= (l-nth e 2) 0) (> (l-nth e 0) best-c))
                  (begin (set best id) (set best-c (l-nth e 0)) (set best-f (l-nth e 2))))))))
        (if best
          (list 'selected (l-append active (list best)) best-c bt best-f)
          (list 'failed active bc bt bf))))))
(define-function d-run (tasks lib budget)
  (let ((active ()) (solved 0))
    (list-do t tasks
      (let* ((r (d-select t lib active budget))
             (na (l-nth r 1)) (c (l-nth r 2)) (tot (l-nth r 3)) (f (l-nth r 4)))
        (set active na)
        (if (and (= c tot) (= f 0)) (set solved (+ solved 1)))
        (print "DEDUCE " (d-name t) " active=" (l-len active)
               " covered=" c "/" tot " conflict=" f " result=" (car r) "\n")))
    (list 'summary 'tasks (l-len tasks) 'solved solved 'active active)))

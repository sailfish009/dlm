;;; A representation codec INSIDE Basis91, not an independent model/learner.
;;; encoded91: format branch leaf-plan EML-only straight-line circuit.
;;; Finite-source predicate membership is encoded false=1, true=2 (never log 0).
;;; Product of n such inputs is 2^k; accept iff k=n. It asserts no world negation.
;;; Fixed compiler + exhaustive finite bit certificates; NOT empirical law fitting.
(define *e94-certificates* ())
(define *e94-circuits* ())
;;; Diagnostic worker counters only; not learned state or replay authority.
;;; evaluations EML-nodes accepted rejected ground-calls candidates.
(define *e94-metrics* '(eml-metrics94 0 0 0 0 0 0))
(define-function e94-count (i n)
  (set *e94-metrics* (s79-field *e94-metrics* i (+ (dlm-nth *e94-metrics* i) n))))
(define-function e94-exp-term (x) (list 'eml93 x 'one93))
(define-function e94-log-term (x)
  (list 'eml93 'one93 (list 'eml93 (list 'eml93 'one93 x) 'one93)))
(define-function e94-sub-term (x y)
  (list 'eml93 (e94-log-term x) (e94-exp-term y)))
;;; Add u+v as c-((c-u)-v), c=E(1,1). Used ONLY for log inputs in [0,ln 4].
;;; Every first subtraction operand remains positive on this finite domain.
(define-function e94-add-term (u v)
  (let ((c (list 'eml93 'one93 'one93)))
    (e94-sub-term c (e94-sub-term (e94-sub-term c u) v))))
(define-function e94-product-term (a b)
  (e94-exp-term (e94-add-term (e94-log-term a) (e94-log-term b))))
;;; Hash-cons by structural equality into topological EML nodes. No runtime
;;; multiply/log/exp constructors: the executor executes ONLY E(a,b).
(define-function e94-intern (term nodes)
  (if (or (equal term 'one93) (= (car term) 'x93)) (list 'built94 term nodes)
    (let* ((a (e94-intern (dlm-nth term 1) nodes))
           (b (e94-intern (dlm-nth term 2) (dlm-nth a 2)))
           (node (list 'eml93 (dlm-nth a 1) (dlm-nth b 1)))
           (all (dlm-nth b 2)) (index 0) (found ()))
      (list-do old all
        (if (and (not found) (equal old node)) (set found (list index)))
        (set index (+ index 1)))
      (if found (list 'built94 (list 'wire94 (car found)) all)
        (list 'built94 (list 'wire94 (dlm-length all)) (dlm-append all (list node)))))))
(define-function e94-circuit (n)
  (let ((cached (dlm-assoc n *e94-circuits*)))
    (if cached (dlm-nth cached 1)
      (let ((term '(x93 0)) (i 1))
        (while (< i n) (set term (e94-product-term term (list 'x93 i))) (set i (+ i 1)))
        (let* ((built (e94-intern term ())) (code (list 'circuit94 (dlm-nth built 2) (dlm-nth built 1))))
          (set *e94-circuits* (dlm-append *e94-circuits* (list (list n code)))) code)))))
(define-function e94-ref? (x inputs prefix)
  (or (equal x 'one93)
    (and (sq-shape? x 2) (is <long> (dlm-nth x 1)) (>= (dlm-nth x 1) 0)
      (or (and (= (car x) 'x93) (< (dlm-nth x 1) inputs))
          (and (= (car x) 'wire94) (< (dlm-nth x 1) prefix))))))
(define-function e94-code? (code inputs)
  (and (sq-shape? code 3) (= (car code) 'circuit94)
       (dlm-proper? (dlm-nth code 1) 96)
    (let ((i 0) (ok true))
      (list-do node (dlm-nth code 1)
        (if (not (and (sq-shape? node 3) (= (car node) 'eml93)
          (e94-ref? (dlm-nth node 1) inputs i) (e94-ref? (dlm-nth node 2) inputs i))) (set ok false))
        (set i (+ i 1)))
      (and ok (e94-ref? (dlm-nth code 2) inputs i)))))
(define-function e94-resolve (ref inputs values)
  (cond ((equal ref 'one93) '(z93 1000000 0))
    ((= (car ref) 'x93) (dlm-nth inputs (dlm-nth ref 1)))
    (else (dlm-nth values (dlm-nth ref 1)))))
(define-function e94-power (n)
  (let ((value 1)) (while (> n 0) (set value (* value 2)) (set n (- n 1))) value))
;;; Pure evaluator result: status, accepted?, raw value, remaining fuel, EML units.
;;; Decode ONLY values close to an allowed finite codeword; otherwise unknown.
(define-function e94-eval-code (code inputs branch fuel meter)
  (let ((values ()) (status 'complete) (used 0) (value ()) (valid false) (accept false))
    (list-do node (dlm-nth code 1)
      (if (= status 'complete)
        (if (= fuel 0) (set status 'unknown)
          (let ((v (e93-eml (e94-resolve (dlm-nth node 1) inputs values)
                           (e94-resolve (dlm-nth node 2) inputs values) branch)))
            (set fuel (- fuel 1)) (set used (+ used 1))
            (if (e93-z? v) (set values (dlm-append values (list v))) (set status 'unknown))))))
    (if (= status 'complete)
      (begin
        (set value (e94-resolve (dlm-nth code 2) inputs values))
        (list-do k (b91-range (+ 1 (dlm-length inputs)))
          (if (e93-close? value (list 'z93 (* 1000000 (e94-power k)) 0) 2000)
            (begin (set valid true) (if (= k (dlm-length inputs)) (set accept true)))))
        (if (not valid) (set status 'unknown))))
    (if meter
      (begin (e94-count 1 1) (e94-count 2 used)
        (if (= status 'complete) (e94-count (if accept 3 4) 1))))
    (list 'circuit-value94 status accept value fuel used)))
(define-function e94-bit-inputs (n)
  (if (= n 0) (list ())
    (let ((out ())) (list-do rest (e94-bit-inputs (- n 1))
      (set out (dlm-append out (list (cons '(z93 1000000 0) rest) (cons '(z93 2000000 0) rest))))) out)))
(define-function e94-certified? (n code branch)
  (let ((key (list n code branch)))
    (if (dlm-member? key *e94-certificates*) true
      (let ((ok true))
        ;; Exhaustive over the ENTIRE finite Boolean input domain, not samples.
        (list-do inputs (e94-bit-inputs n)
          (let ((expected true) (v (e94-eval-code code inputs branch 200000 false)))
            (list-do x inputs (if (not (equal x '(z93 2000000 0))) (set expected false)))
            (if (not (and (= (dlm-nth v 1) 'complete) (equal (dlm-nth v 2) expected))) (set ok false))))
        (if ok (set *e94-certificates* (dlm-append *e94-certificates* (list key)))) ok))))
(define-function e94-read-body (body)
  (if (not (and (sq-shape? body 5) (= (car body) 'encoded91) (= (dlm-nth body 1) 'eml94)
       (dlm-member? (dlm-nth body 2) '(principal93 lower93))
       (dlm-nth body 3) (dlm-proper? (dlm-nth body 3) 3))) ()
    (let* ((ops (dlm-nth body 3)) (n (dlm-length ops)) (code (dlm-nth body 4)))
      (if (and (e94-code? code n) (equal code (e94-circuit n)) (e94-certified? n code (dlm-nth body 2))) ops ()))))
(define-function e94-encode (ops format branch)
  (if (not (and (= format 'eml94) (dlm-member? branch '(principal93 lower93))
                ops (dlm-proper? ops 3))) ()
    (let ((body (list 'encoded91 'eml94 branch ops (e94-circuit (dlm-length ops)))))
      (if (e94-read-body body) body ()))))
(set *b91-codec-read* e94-read-body)
(set *b91-codec-encode* e94-encode)

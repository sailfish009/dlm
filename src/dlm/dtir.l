;;; dtir.l — MLIR-shaped deduction-transformer proof-state dialect.
;;; It represents selection + verifier boundary; truth stays with proof.l.
(define-function dt-op (kind args) (list 'mdop kind args))
(define-function dt-op? (x)
  (and (l-shape? x 3) (equal (car x) 'mdop) (l-name? (l-nth x 1))
       (l-list? (l-nth x 2))))
(define-function dt-module (name ops) (list 'mdmodule name ops))
(define-function dt-module? (m)
  (and (l-shape? m 3) (equal (car m) 'mdmodule) (l-name? (l-nth m 1))
       (l-list? (l-nth m 2))
       (not (l-any? (lambda (o) (not (dt-op? o))) (l-nth m 2)))))
(define-function dt-name (m) (l-nth m 1))
(define-function dt-ops (m) (l-nth m 2))
(define-function dt-find (kind ops)
  (let ((hit (l-filter (lambda (o) (equal kind (l-nth o 1))) ops)))
    (if hit (l-nth (car hit) 2) ())))
(define-function dt-check (m)
  (if (not (dt-module? m)) '(rejected107 dt-module)
    (if (dt-find 'verify (dt-ops m)) 'ok '(rejected107 dt-verifier-missing))))
(define-function dt-run (m)
  (if (not (equal (dt-check m) 'ok)) (dt-check m)
    (let* ((ops (dt-ops m))
           (facts (dt-find 'facts ops))
           (axs (dt-find 'axioms ops))
           (pos (dt-find 'pos ops))
           (neg (dt-find 'neg ops))
           (query-facts (dt-find 'query-facts ops))
           (goal (dt-find 'goal ops))
           (sel (a-select axs facts pos neg 20000))
           (rules (if (equal (car sel) 'asel) (a-rules-for (l-nth sel 1) axs) ()))
           (pr (if rules (p-prove query-facts rules goal 20000) (list 'presult 'fail () 0 0))))
      (list 'dt-result (dt-name m)
            (if (equal (car sel) 'asel) (l-nth sel 1) ())
            (if (equal (car sel) 'asel) (l-nth sel 2) 0)
            (l-nth pr 1)))))

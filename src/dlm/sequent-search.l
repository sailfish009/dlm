;;; Deterministic cut-free G3c. Budget counts visited obligations, NOT primitives.
;;; All rules are invertible: every generated child is required (AND).
(define *sq-remaining* 0)
(define *sq-nodes* ())
(define *sq-next* 0)
(define *sq-root-atoms* ())
(define-function sq-find-initial (s)
  (let ((out ()) (i 0))
    (list-do a (sq-left s)
      (let ((j 0)) (list-do b (sq-right s)
        (if (and (not out) (= (car a) 'pred) (equal a b)) (set out (list 'both i j)))
        (set j (+ j 1)))) (set i (+ i 1))) out))
(define-function sq-find-tag (xs tag)
  (let ((out ()) (i 0))
    (list-do f xs (if (and (not out) (= (car f) tag)) (set out (list i))) (set i (+ i 1))) out))
(define-function sq-compound (xs)
  (let ((out ()) (i 0))
    (list-do f xs
      (if (and (not out) (not (= (car f) 'pred))) (set out (list i)))
      (set i (+ i 1))) out))
(define-function sq-expand-left (s i)
  (let ((f (dlm-nth (sq-left s) i)) (g (sq-remove (sq-left s) i)) (d (sq-right s)) (pos (list 'left i)))
    (let ((tag (car f)) (a (dlm-nth f 1)) (b (dlm-nth f 2)))
      (if (= tag 'top) (list 'top-left pos (list (sq-sequent g d)))
        (if (= tag 'not) (list 'not-left pos (list (sq-sequent g (dlm-append d (list a)))))
          (if (= tag 'and) (list 'and-left pos (list (sq-sequent (dlm-append g (list a b)) d)))
            (if (= tag 'or) (list 'or-left pos (list (sq-sequent (dlm-append g (list a)) d) (sq-sequent (dlm-append g (list b)) d)))
              (list 'imp-left pos (list (sq-sequent g (dlm-append d (list a))) (sq-sequent (dlm-append g (list b)) d))))))))))
(define-function sq-expand-right (s i)
  (let ((f (dlm-nth (sq-right s) i)) (g (sq-left s)) (d (sq-remove (sq-right s) i)) (pos (list 'right i)))
    (let ((tag (car f)) (a (dlm-nth f 1)) (b (dlm-nth f 2)))
      (if (= tag 'bottom) (list 'bottom-right pos (list (sq-sequent g d)))
        (if (= tag 'not) (list 'not-right pos (list (sq-sequent (dlm-append g (list a)) d)))
          (if (= tag 'and) (list 'and-right pos (list (sq-sequent g (dlm-append d (list a))) (sq-sequent g (dlm-append d (list b)))))
            (if (= tag 'or) (list 'or-right pos (list (sq-sequent g (dlm-append d (list a b)))))
              (list 'imp-right pos (list (sq-sequent (dlm-append g (list a)) (dlm-append d (list b))))))))))))
(define-function sq-choice (s)
  (let ((initial (sq-find-initial s)) (bot (sq-find-tag (sq-left s) 'bottom))
        (top (sq-find-tag (sq-right s) 'top))
        (lc (sq-compound (sq-left s))) (rc (sq-compound (sq-right s))))
    (if initial (list 'init initial ())
      (if bot (list 'bottom-left (list 'left (car bot)) ())
        (if top (list 'top-right (list 'right (car top)) ())
          (if lc (sq-expand-left s (car lc))
            (if rc (sq-expand-right s (car rc)) ())))))))
(define sq-visit ())
(define-function sq-visit-children (children)
  (if children
      (let ((r (sq-visit (car children))))
        (if (= (car r) 'proved)
            (let ((rest (sq-visit-children (cdr children))))
              (if (= (car rest) 'proved) (list 'proved (cons (dlm-nth r 1) (dlm-nth rest 1))) rest)) r))
    (list 'proved ())))
(set sq-visit (lambda (s)
  (if (<= *sq-remaining* 0) (list 'incomplete ())
    (begin (set *sq-remaining* (- *sq-remaining* 1))
      (let ((action (sq-choice s)))
        (if action
            (let ((r (sq-visit-children (dlm-nth action 2))))
              (if (= (car r) 'proved)
                  (let ((id *sq-next*))
                    (set *sq-next* (+ id 1))
                    (set *sq-nodes* (dlm-append *sq-nodes* (list
                      (list 'proof-node id s (car action) (dlm-nth action 1) () (dlm-nth r 1)))))
                    (list 'proved id)) r))
          (let ((values ()))
            (list-do atom *sq-root-atoms*
              (set values (dlm-append values (list (list atom (if (dlm-member? atom (sq-left s)) 'yes 'no))))))
            (list 'countermodel (list 'model values)))))))))
(define-function sq-search (problem budget policy)
  (if (not (and (sq-problem? problem) (is <long> budget) (>= budget 0) (<= budget 9000)))
      (list 'result 'invalid-input () 0)
    (if (not (= policy 'fixed)) (list 'result 'unsupported () 0)
      (begin
        (set *sq-remaining* budget) (set *sq-nodes* ()) (set *sq-next* 0)
        (set *sq-root-atoms* (dlm-union (sq-context-atoms (sq-left (dlm-nth problem 3)))
                                           (sq-context-atoms (sq-right (dlm-nth problem 3)))))
        (let ((r (sq-visit (dlm-nth problem 3))))
          (if (= (car r) 'proved)
              (let ((cert (list 'certificate 'classical-prop-v1 (dlm-nth r 1) *sq-nodes*)))
                (assert (= (sq-verify cert (dlm-nth problem 3) (dlm-nth problem 2) 10000) 'verified) "search produced invalid certificate")
                (list 'result 'proved cert (- budget *sq-remaining*)))
            (if (= (car r) 'countermodel)
                (begin (assert (sq-check-countermodel problem (dlm-nth r 1)) "search produced invalid countermodel")
                       (list 'result 'countermodel (dlm-nth r 1) (- budget *sq-remaining*)))
              (list 'result 'incomplete () (- budget *sq-remaining*)))))))))
;;; Two independent directions. A countermodel to A is NOT a proof of not A.
(define-function sq-classify (sig left goal budget)
  (let ((pos (sq-search (list 'problem 'classical-prop-v1 sig (sq-sequent left (list goal))) budget 'fixed))
        (neg (sq-search (list 'problem 'classical-prop-v1 sig (sq-sequent left (list (list 'not goal)))) budget 'fixed)))
    (list 'classification
      (if (and (= (dlm-nth pos 1) 'proved) (= (dlm-nth neg 1) 'proved)) 'CONFLICT
        (if (= (dlm-nth pos 1) 'proved) 'PROVED
          (if (= (dlm-nth neg 1) 'proved) 'DISPROVED
            (if (and (= (dlm-nth pos 1) 'countermodel) (= (dlm-nth neg 1) 'countermodel)) 'UNKNOWN
              (if (or (= (dlm-nth pos 1) 'invalid-input) (= (dlm-nth neg 1) 'invalid-input)) 'invalid-input 'incomplete))))) pos neg)))

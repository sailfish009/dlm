;;; -*- mode: lisp; coding: us-ascii -*-
(define s79-on-job-done (lambda (s name) s))
(define-function s79-job-done (s name result)
  (let ((j (s79-job s name)))
    (set j (s79-field (s79-field j 3 'done) 5 result))
    (set s (s79-job-put s j))
    (list-do waiter (dlm-nth j 7) (set s (s79-send s (list 'meta waiter))))
    (s79-on-job-done s name)))
(define-function s79-watch (s name id)
  (let ((j (s79-job s name)))
    (set s (s79-job-put s (s79-field j 7 (cons id (dlm-nth j 7)))))
    (if (= (dlm-nth j 3) 'done) (s79-send s (list 'meta id)) s)))
(define-function s79-check-fail (s id reason)
  (let* ((u (s79-unit s id)) (purpose (dlm-nth (dlm-nth u 5) 3))
         (next (s79-finish s id 'failed reason)))
    (if (= (car purpose) 'reuse)
        (s79-finish next (dlm-nth purpose 1) 'failed (list 'check-failed reason))
      (if (and (= (car purpose) 'job) (s79-job next (dlm-nth purpose 1)))
          (s79-job-done next (dlm-nth purpose 1) (list 'result 'failed reason)) next))))
(define-function s79-check-step (s id)
  (let* ((u (s79-unit s id)) (d (dlm-nth u 5)) (sig (car d)) (root (dlm-nth d 1))
         (cert (dlm-nth d 2)) (purpose (dlm-nth d 3)) (todo (dlm-nth d 4)) (prior (dlm-nth d 5)))
    (if (not (= (dlm-nth u 4) 'ready)) s
      (if todo
          (let ((n (car todo)))
            (if (not (and (sq-node? n sig) (not (dlm-assoc (dlm-nth n 1) prior)) (sq-check-step n prior)))
                (s79-check-fail s id '(invalid-certificate))
              (begin
                (set s (s79-stat s 4))
                (set d (s79-field (s79-field d 4 (cdr todo)) 5
                  (cons (list (dlm-nth n 1) (dlm-nth n 2)) prior)))
                (set s (s79-unit-field s id 5 d)) (s79-send s (list 'check id)))))
        (if (not (equal (s79-at prior (dlm-nth cert 2)) root)) (s79-check-fail s id '(invalid-root))
          (begin
            (set s (s79-finish s id 'done '(verified)))
            (if (= (car purpose) 'reuse)
                (s79-finish (s79-stat s 3) (dlm-nth purpose 1) 'proved (list 'reuse (dlm-nth purpose 2)))
              (s79-job-done s (dlm-nth purpose 1) (list 'result 'proved cert)))))))))
(define-function s79-job-wake (s name source)
  (let ((j (s79-job s name)) (u (s79-unit s source)))
    (if (not (= (dlm-nth j 3) 'waiting)) s
      (if (= (dlm-nth u 4) 'countermodel)
          (s79-job-done s name (list 'result 'countermodel (dlm-nth u 8)))
        (if (= (dlm-nth u 4) 'proved)
            (let* ((cert (s79-certificate s source)) (d (dlm-nth u 5))
                   (r (s79-check-create s (car d) (dlm-nth d 1) cert (list 'job name))))
              (set s (car r))
              (s79-job-put s (s79-field j 3 (if (dlm-nth r 1) 'checking 'suspended)))) s)))))
(define-function s79-program? (tasks fuel)
  (and (> fuel 0) (dlm-proper? tasks 256)
    (let ((ok true)) (list-do t tasks
      (if (not (and (pair? t) (dlm-proper? t 3)
        (cond
          ((= (car t) 'choose) (and (sq-shape? t 2) (dlm-nth t 1) (dlm-proper? (dlm-nth t 1) 16)
            (let ((valid true)) (list-do alt (dlm-nth t 1)
              (if (not (s79-program? alt (- fuel 1))) (set valid false))) valid)))
          ((= (car t) 'ask) (and (sq-shape? t 2) (sq-problem? (dlm-nth t 1))))
          ((or (= (car t) 'assume) (= (car t) 'accept) (= (car t) 'fail) (= (car t) 'suspend)) (sq-shape? t 2))
          ((or (= (car t) 'bind) (= (car t) 'require) (= (car t) 'define-local))
            (and (sq-shape? t 3) (sq-name? (dlm-nth t 1))))
          (else false)))) (set ok false))) ok)))
(define-function s79-program-branch (s name tasks context parent)
  (let* ((r (s79-create s 'program (list 'branch (dlm-nth s 9) parent) (list name tasks context)))
         (ids (dlm-nth r 1)))
    (set s (car r))
    (if ids
        (let* ((id (car ids)) (j (s79-job s name)))
          (set s (s79-job-put s (s79-field j 4 (cons id (dlm-nth j 4)))))
          (set s (s79-send s (list 'program id)))))
    (list s ids)))
(define-function s79-program-job (s name tasks)
  (if (not (and (sq-name? name) (not (s79-job s name)) (s79-program? tasks 16))) '(rejected program-job)
    (begin
      (set s (s79-job-put s (list 'job79 name 'program 'waiting () () tasks)))
      (car (s79-program-branch s name tasks '(context78 () () ()) ())))))
(define-function s79-program-live? (status)
  (or (= status 'ready) (= status 'waiting) (= status 'suspended) (= status 'alternative)))
(define-function s79-program-fail (s id reason)
  (let* ((u (s79-unit s id)) (name (car (dlm-nth u 5))) (j (s79-job s name)) (live false))
    (set s (s79-finish s id 'failed (list 'failed reason)))
    (list-do b (dlm-nth j 4)
      (if (s79-program-live? (dlm-nth (s79-unit s b) 4)) (set live true)))
    (if (not live) (s79-job-put s (s79-field j 3 'exhausted)) s)))
(define-function s79-program-step (s id)
  (let* ((u (s79-unit s id)) (d (dlm-nth u 5)) (name (car d)) (tasks (dlm-nth d 1))
         (ctx (dlm-nth d 2)) (j (s79-job s name)))
    (if (not (= (dlm-nth u 4) 'ready)) s
      (if (= (dlm-nth j 3) 'done) (s79-unit-field s id 4 'alternative)
        (if (not tasks)
            (s79-job-done (s79-finish s id 'done (list 'provisional () ctx)) name (list 'provisional () ctx))
          (let* ((t (car tasks)) (op (car t)) (arg (dlm-nth t 1)) (continue true))
            (set tasks (cdr tasks))
            (cond
              ((= op 'choose)
                (if (> (+ (dlm-nth s 9) (dlm-length arg)) s79-unit-limit)
                    (begin (set tasks (cons t tasks)) (set continue false) (set s (s79-unit-field s id 4 'suspended)))
                  (begin
                    (set continue false) (set s (s79-unit-field s id 4 'failed))
                    (list-do alt arg
                      (set s (car (s79-program-branch s name (dlm-append alt tasks) ctx id)))))))
              ((= op 'assume) (set ctx (n78-context (dlm-nth ctx 1) (cons arg (dlm-nth ctx 2)) (dlm-nth ctx 3))))
              ((or (= op 'bind) (= op 'define-local))
                (let* ((index (if (= op 'bind) 1 3)) (old (dlm-assoc arg (dlm-nth ctx index))))
                  (if (and old (not (equal (dlm-nth old 1) (dlm-nth t 2))))
                      (begin (set continue false) (set s (s79-program-fail s id 'inconsistent-binding)))
                    (if (not old) (set ctx (s79-field ctx index (cons (list arg (dlm-nth t 2)) (dlm-nth ctx index))))))))
              ((= op 'require)
                (let ((old (dlm-assoc arg (dlm-nth ctx 1))))
                  (if (not (and old (equal (dlm-nth old 1) (dlm-nth t 2))))
                      (begin (set continue false) (set s (s79-program-fail s id 'require))))))
              ((= op 'suspend) (set continue false) (set s (s79-unit-field s id 4 'suspended)))
              ((= op 'fail) (set continue false) (set s (s79-program-fail s id arg)))
              ((= op 'accept)
                (set continue false)
                (set s (s79-finish s id 'done (list 'provisional arg ctx)))
                (set s (s79-job-done s name (list 'provisional arg ctx))))
              ((= op 'ask)
                (let* ((sig (dlm-nth arg 2)) (oldroot (dlm-nth arg 3))
                       (root (sq-sequent (dlm-append (sq-left oldroot) (dlm-nth ctx 2)) (sq-right oldroot))))
                  (set continue false)
                  (if (not (sq-sequent? root sig)) (set s (s79-program-fail s id 'invalid-assumptions))
                    (let ((r (s79-request s sig root (dlm-nth u 3))))
                      (set s (car r))
                      (if (not (dlm-nth r 1)) (begin (set tasks (cons t tasks)) (set s (s79-unit-field s id 4 'suspended)))
                        (begin
                          (set s (s79-unit-field s id 4 'waiting))
                          (set s (s79-unit-field s id 6 (dlm-nth r 1)))
                          (set s (s79-subscribe s (car (dlm-nth r 1)) (list 'unit id)))))))))
              (else (set continue false) (set s (s79-program-fail s id 'instruction))))
            (set s (s79-unit-field s id 5 (list name tasks ctx)))
            (if continue (s79-send s (list 'program id)) s)))))))
(define-function s79-program-wake (s id source)
  (let ((u (s79-unit s id)) (child (s79-unit s source)))
    (if (not (= (dlm-nth u 4) 'waiting)) s
      (if (= (dlm-nth child 4) 'proved)
          (s79-send (s79-unit-field s id 4 'ready) (list 'program id))
        (if (= (dlm-nth child 4) 'countermodel) (s79-program-fail s id 'countermodel) s)))))
(define-function s79-program-resume (s name next?)
  (let* ((j (s79-job s name)) (ids ()))
    (if (not (and j (= (dlm-nth j 2) 'program))) '(rejected program-job)
      (begin
        (list-do id (dlm-nth j 4)
          (let ((status (dlm-nth (s79-unit s id) 4)))
            (if (or (= status 'suspended) (and next? (= status 'alternative)))
                (set ids (cons id ids)))))
        (if (not ids)
            (if next? (s79-job-put s (s79-field j 3 'exhausted)) s)
          (begin
            (if next? (set s (s79-job-put s (s79-field (s79-field j 3 'waiting) 5 ()))))
            (list-do id (s79-reverse ids)
              (set s (s79-unit-field s id 4 'ready))
              (set s (s79-send s (list 'program id))))
            s))))))
(define s79-meta-step ())
(define-function s79-step (s)
  (if (not (or (dlm-nth s 5) (dlm-nth s 6))) s
    (begin
      (if (not (dlm-nth s 5))
          (begin (set s (s79-field s 5 (s79-reverse (dlm-nth s 6)))) (set s (s79-field s 6 ()))))
      (let* ((event (car (dlm-nth s 5))) (op (car event)) (id (dlm-nth event 1)))
        (set s (s79-field s 5 (cdr (dlm-nth s 5))))
        (set s (s79-field s 10 (+ (dlm-nth s 10) 1)))
        (cond
          ((= op 'expand) (s79-expand s id))
          ((= op 'rule) (s79-rule-start s id))
          ((= op 'poll) (s79-rule-poll s id))
          ((= op 'check) (s79-check-step s id))
          ((= op 'program) (s79-program-step s id))
          ((= op 'meta) (s79-meta-step s id))
          ((= op 'wake)
            (set s (s79-stat s 5))
            (if (= (car id) 'job) (s79-job-wake s (dlm-nth id 1) (dlm-nth event 2))
              (let* ((target (dlm-nth id 1)) (u (s79-unit s target)))
                (cond
                  ((= (dlm-nth u 2) 'prove) (s79-prove-wake s target (dlm-nth event 2)))
                  ((= (dlm-nth u 2) 'rule) (s79-rule-poll s target))
                  ((= (dlm-nth u 2) 'program) (s79-program-wake s target (dlm-nth event 2)))
                  (else s)))))
          (else s))))))
(define-function s79-run (s budget)
  (if (not (and (= (car s) 'space79) (is <long> budget) (>= budget 0) (<= budget 20000))) '(rejected budget)
    (begin (while (and (> budget 0) (< (dlm-nth s 9) s79-unit-reserve-start) (or (dlm-nth s 5) (dlm-nth s 6)))
      (set s (s79-step s)) (set budget (- budget 1))) s)))

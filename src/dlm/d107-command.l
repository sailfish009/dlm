;;; d104-command.l — the single entry point. `dlm` keeps the historical name.
;;; Every command validates arity, types and lists before touching state, so a
;;; malformed argument is a rejection rather than a native fault.

(define *p107-state* (p107-new))
(define *p107-store* ())
(define *p107-session-lock* ())
(define *p107-disk-digest* 'missing)
(define *p107-budget* 20000)
(define *p107-last* '(ready))

(define-function p107-summary ()
  (list 'dlm107 'epoch (p107-epoch *p107-state*)
        'observations (p107-len (p107-obs-list *p107-state*))
        'interpreted (p107-len (p107-int-list *p107-state*))
        'events (p107-len (p107-events *p107-state*))
        'rules (p107-len *p107-rules*) 'definitions (p107-len (p107-defs-of *p107-state*))
        'store *p107-store* 'disk-digest *p107-disk-digest* 'last *p107-last*))

;;; durability boundary: write before publishing, and refuse if the file moved on
(define-function p107-publish (next)
  (if (not *p107-store*)
    (begin (set *p107-state* next) (set *p107-last* (list 'state (p107-epoch next))) true)
    (let ((r (p107-save *p107-store* next *p107-disk-digest*)))
      (if (= (car r) 'saved107)
        (begin (set *p107-state* next) (set *p107-disk-digest* (p107-nth r 1))
               (set *p107-last* (list 'state (p107-epoch next))) true)
        (begin (set *p107-last* r) false)))))

(define-function p107-observe (args)
  (if (not (p107-shape? args 5)) '(rejected107 observe-arity)
    (let ((r (p107-transition *p107-state*
               (list 'obs107 (p107-nth args 0) (p107-nth args 1) (p107-nth args 2)
                     (p107-nth args 3) (p107-nth args 4)))))
      (if (not (= (car r) 'applied))
        (begin (set *p107-last* r) r)
        (let ((next (p107-nth r 1)))
          (if (p107-publish next)
            (begin (set *p107-last* (list 'observed (p107-nth args 0))) (p107-summary))
            *p107-last*))))))

(define-function p107-attach (path s)
  (let ((lock (file-lock (concat-strings path ".session"))))
    (if (not lock) '(rejected107 session-locked)
      (let ((r (p107-save path s 'missing)))
        (if (not (= (car r) 'saved107))
          (begin (file-close lock) (set *p107-last* r) r)
          (begin (set *p107-session-lock* lock) (set *p107-store* path)
                 (set *p107-state* s) (set *p107-disk-digest* (p107-nth r 1))
                 (set *p107-last* '(attached)) (p107-summary)))))))

(define-function p107-open (path)
  (if (not (p107-store? path)) '(rejected107 path)
    (if *p107-store* '(rejected107 already-attached)
    (let ((lock (file-lock (concat-strings path ".session"))))
      (if (not lock) '(rejected107 session-locked)
        (let ((r (p107-load path)))
          (cond
            ((= (car r) 'loaded)
              (begin (set *p107-session-lock* lock) (set *p107-store* path)
                     (set *p107-state* (p107-nth r 1))
                     (set *p107-disk-digest* (p107-nth r 2))
                     (set *p107-last* '(reopened)) (p107-summary)))
            ((equal r '(missing))
              (file-close lock)
              (p107-attach path (p107-new)))
            (else (file-close lock) (set *p107-last* r) r))))))))

(define-function p107-detach ()
  (if (not *p107-store*) '(closed107)
    (let ((r (p107-save *p107-store* *p107-state* *p107-disk-digest*)))
      (if *p107-session-lock* (file-close *p107-session-lock*))
      (set *p107-session-lock* ())
      (if (= (car r) 'saved107)
        (begin (set *p107-disk-digest* (p107-nth r 1)) (set *p107-store* ()) '(closed107))
        (begin (set *p107-store* ()) (set *p107-last* r) r)))))

(define-function p107-step-once ()
  (let ((r (p107-step *p107-state* *p107-budget*)))
    (cond
      ((= (car r) 'worked)
        (let ((next (p107-nth r 1)) (i (p107-nth r 2)))
          (if (p107-publish next)
            (begin (set *p107-last* (list 'interpreted (p107-nth i 1) 'status (p107-nth i 2)
                                          'derived (p107-nth i 4)))
                   (list 'round (p107-epoch *p107-state*) *p107-last*))
            (list 'round (p107-epoch *p107-state*) *p107-last*))))
      ((= (car r) 'idle)
        (set *p107-last* '(waiting agenda-empty))
        (list 'round (p107-epoch *p107-state*) *p107-last*))
      (else (set *p107-last* r) (list 'round (p107-epoch *p107-state*) r)))))

(define-function p107-run (n)
  (let ((i 0) (out ())) (while (< i n) (set out (p107-step-once)) (set i (+ i 1))) out))

(define-function p107-query (scope atom budget)
  (if (not (and (symbol? scope) (p107-ground-atom? atom) (is <long> budget) (> budget 0)))
    '(rejected107 query)
    (let* ((c (p107-closure *p107-state* scope budget)) (table (p107-nth c 1))
           (f (p107-lookup atom table)))
      (if (not f) (list 'no107 scope atom (p107-nth c 0))
        (if (p107-proof-ok? (p107-nth f 3) atom table *p107-rules*)
          (list 'answer107 atom (p107-nth f 3))
          '(rejected107 proof))))))

(define-function p107-help ()
  (print "DLM 0.0104 (minimal native core, reviewed):\n"
    " (dlm 'open \"path.sexp\") / 'save / 'status / 'reset / 'close\n"
    " (dlm 'rules RULES)         install range-restricted background laws\n"
    " (dlm 'observe 'id \"source\" \"record\" 'scope FACTS)\n"
    " (dlm 'step) (dlm 'run N)   one/some agenda actions\n"
    " (dlm 'query 'scope (atom P (\"a\" \"b\")))\n"
    " (dlm 'read 'scope)         certified N1-N3 sentences\n"
    " (dlm 'learn) (dlm 'defs)   learn/revise a definition from the SAME data\n"
    " (dlm 'plan PATTERN) (dlm 'answer 'scope PATTERN) (dlm 'revise ID PATTERN)\n"
    " (dlm 'help)\n")
  (list 'commands-listed))

(define-function p107-valid-budget? (x) (and (is <long> x) (> x 0) (<= x 200000)))
(define-function p107-count? (x) (and (is <long> x) (> x 0) (<= x 1000)))

(define-function dlm args
  (if (not (and (pair? args) (p107-list? args) (symbol? (car args))))
    '(rejected107 command)
    (let ((op (car args)) (rest (cdr args)) (n (p107-len (cdr args))))
      (cond
        ((and (equal op 'status) (= n 0)) (p107-summary))
        ((and (equal op 'help) (= n 0)) (p107-help))
        ((and (equal op 'rules) (= n 1))
          (cond ((not (p107-rules? (car rest))) '(rejected107 rules))
                (*p107-store* '(rejected107 detach-before-rules))
                (else (begin (set *p107-rules* (car rest))
                             (set *p107-state* (p107-new)) (p107-summary)))))
        ((and (equal op 'observe) (= n 5)) (p107-observe rest))
        ((and (equal op 'open) (= n 1) (p107-store? (car rest))) (p107-open (car rest)))
        ((and (equal op 'save) (= n 0))
          (if (not *p107-store*) '(rejected107 no-store)
            (let ((r (p107-save *p107-store* *p107-state* *p107-disk-digest*)))
              (if (= (car r) 'saved107)
                (begin (set *p107-disk-digest* (p107-nth r 1)) (p107-summary))
                (begin (set *p107-last* r) r)))))
        ((and (equal op 'close) (= n 0)) (p107-detach))
        ((and (equal op 'reset) (= n 0))
          (if (p107-publish (p107-new))
            (begin (set *p107-last* '(reset)) (p107-summary)) *p107-last*))
        ((and (equal op 'step) (= n 0)) (p107-step-once))
        ((and (equal op 'step) (= n 1) (p107-valid-budget? (car rest)))
          (set *p107-budget* (car rest)) (p107-step-once))
        ((and (equal op 'learn) (= n 0))
        (let ((r (p107-learn *p107-state*)))
          (if (not (equal (car r) 'learned107)) '(nothing107)
            (let ((tr (p107-transition *p107-state* (list 'def107 (p107-nth r 1)))))
              (if (not (= (car tr) 'applied)) tr
                (if (p107-publish (p107-nth tr 1))
                  (begin (set *p107-last* (list 'learned (p107-def-id (p107-nth r 1))))
                         (p107-summary))
                  *p107-last*))))))
      ((and (equal op 'defs) (= n 0))
        (let ((out ()) (s *p107-state*))
          (list-do d (p107-defs-of s)
            (set out (p107-append out (list (list 'def107 (p107-def-id d)
              'support (p107-support s (p107-def-pattern d))
              'active (>= (p107-support s (p107-def-pattern d)) 2)
              'steps (p107-len (p107-def-body d))
              'pattern (p107-def-pattern d))))))
          (list 'defs107 out)))
      ((and (equal op 'plan) (= n 1))
        (if (not (p107-query-pattern? (car rest))) '(rejected107 pattern)
          (p107-plan *p107-state* (car rest))))
      ((and (equal op 'answer) (= n 2) (symbol? (car rest)))
        (if (not (p107-query-pattern? (p107-nth rest 1))) '(rejected107 pattern)
          (p107-answer *p107-state* (car rest) (p107-nth rest 1) *p107-budget*)))
      ((and (equal op 'revise) (= n 2) (p107-name? (car rest)))
        (if (not (p107-query-pattern? (p107-nth rest 1))) '(rejected107 pattern)
          (let ((tr (p107-transition *p107-state* (list 'revise107 (car rest) (p107-nth rest 1)))))
            (if (not (= (car tr) 'applied)) (begin (set *p107-last* tr) tr)
              (if (p107-publish (p107-nth tr 1))
                (begin (set *p107-last* (list 'revised (car rest))) (p107-summary))
                *p107-last*)))))
      ((and (equal op 'run) (= n 1) (p107-count? (car rest))) (p107-run (car rest)))
        ((and (equal op 'run) (= n 2) (p107-count? (car rest)) (p107-valid-budget? (p107-nth rest 1)))
          (set *p107-budget* (p107-nth rest 1)) (p107-run (car rest)))
        ((and (equal op 'query) (= n 2)) (p107-query (car rest) (p107-nth rest 1) *p107-budget*))
        ((and (equal op 'query) (= n 3) (p107-valid-budget? (p107-nth rest 2)))
          (p107-query (car rest) (p107-nth rest 1) (p107-nth rest 2)))
        ((and (equal op 'read) (= n 1) (symbol? (car rest)))
          (p107-read *p107-state* (car rest) *p107-budget*))
        ((and (equal op 'read) (= n 2) (symbol? (car rest)) (p107-valid-budget? (p107-nth rest 1)))
          (p107-read *p107-state* (car rest) (p107-nth rest 1)))
        ((and (equal op 'retract) (= n 1) (p107-name? (car rest)))
          (let ((r (p107-transition *p107-state* (list 'retract107 (car rest)))))
            (if (not (= (car r) 'applied)) (begin (set *p107-last* r) r)
              (if (p107-publish (p107-nth r 1))
                (begin (set *p107-last* (list 'retracted (car rest))) (p107-summary))
                *p107-last*))))
        (else '(rejected107 command-or-arity))))))

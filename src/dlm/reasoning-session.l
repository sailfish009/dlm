;;; -*- mode: lisp; coding: us-ascii -*-
;;; The v77 store/API remains unchanged. Reasoning uses an explicit separate store.
(define-function r78-new () (list 'state78 () ()))
(define-function r78-transition (state event)
  (let ((lib (dlm-nth state 1)) (m (dlm-nth state 2)))
    (if (not (and (pair? event) (dlm-proper? event 3))) (list 'rejected 'event)
      (let ((op (car event)) (arg (dlm-nth event 1)) (ok true))
        (cond
          ((and (= op 'proof) (= (dlm-length event) 2)) (set m (n78-proof arg lib))
            (if (= (car m) 'rejected) (set ok false)))
          ((and (= op 'program) (= (dlm-length event) 2)) (set m (n78-program arg))
            (if (= (car m) 'rejected) (set ok false)))
          ((and (= op 'run) (= (dlm-length event) 2) m (is <long> arg) (>= arg 0) (<= arg 1000))
            (if (> (+ (dlm-nth m 6) arg) 20000) (set ok false) (set m (n78-run m arg))))
          ((and (= op 'resume) (= (dlm-length event) 1) m) (set m (n78-resume m)))
          ((and (= op 'next) (= (dlm-length event) 1) m) (set m (n78-next m)))
          ((and (= op 'learn) (= (dlm-length event) 1) m (= (car (dlm-nth m 2)) 'proof-input78))
            (list-do a (dlm-nth m 4)
              (if (= (dlm-nth a 2) 'proof)
                  (set lib (p78-admit lib (dlm-nth (dlm-nth m 2) 1) (dlm-nth a 3))))))
          (else (set ok false)))
        (if ok (list 'state78 lib m) (list 'rejected 'transition))))))
(define-function r78-replay (events)
  (if (not (dlm-proper? events 128)) (list 'rejected 'event-limit)
    (let ((s (r78-new)) (total 0))
      (list-do e events
        (if (not (= (car s) 'rejected))
            (begin
              (if (and (sq-shape? e 2) (= (car e) 'run) (is <long> (dlm-nth e 1)))
                  (set total (+ total (dlm-nth e 1))))
              (if (> total 20000) (set s '(rejected replay-budget)) (set s (r78-transition s e)))))) s)))
(define-function r78-snapshot? (x)
  (and (sq-shape? x 4) (= (car x) 'reasoning-session78) (= (dlm-nth x 1) 1)
       (let ((s (r78-replay (dlm-nth x 3))))
         (and (= (car s) 'state78) (equal s (dlm-nth x 2))))))
(define-function r78-read (path)
  (let ((fd (file-open-read path)))
    (if (not fd) (list 'missing)
      (if (is <long> fd) (list 'rejected 'access fd)
        (let* ((stream (file-stream fd)) (x (read stream)) (end (read stream)))
          (file-close fd)
          (if (and (= end +end+) (r78-snapshot? x)) (list 'loaded x) (list 'rejected 'snapshot)))))))
(define-function r78-checkpoint (path snapshot)
  (if (not (r78-snapshot? snapshot)) false
    (let* ((tmp (concat-strings path ".next")) (old (r78-read path)) (ok (not (= (car old) 'rejected))))
      (if ok (set ok (d77-write tmp snapshot)))
      (if ok (let ((readback (r78-read tmp)))
        (set ok (and (= (car readback) 'loaded) (equal (dlm-nth readback 1) snapshot)))))
      (if (and ok (= (car old) 'loaded))
          (let ((previous-tmp (concat-strings path ".previous.next")))
            (set ok (and (d77-write previous-tmp (dlm-nth old 1))
                         (file-replace previous-tmp (concat-strings path ".previous"))))))
      (if ok (set ok (file-replace tmp path))) (if (not ok) (file-remove tmp)) ok)))

(define *r78-state* (r78-new))
(define *r78-events* ())
(define *r78-path* ())
(define *r78-lock* ())
(define-function r78-save ()
  (if (not *r78-path*) '(not-attached)
    (if (r78-checkpoint *r78-path* (list 'reasoning-session78 1 *r78-state* *r78-events*))
        (list 'saved *r78-path*) '(rejected checkpoint))))
(define-function r78-open (path)
  (if (not (and (string? path) (not *r78-path*) (equal *r78-state* (r78-new))))
      '(rejected close-and-clear-reasoning-first)
    (let ((lock (file-lock (concat-strings path ".lock"))))
      (if (not lock) '(rejected lock-or-path)
        (let ((r (r78-read path)))
          (if (= (car r) 'rejected) (begin (file-close lock) r)
            (begin (d77-pause)
              (if (= (car r) 'loaded)
                  (begin (set *r78-state* (dlm-nth (dlm-nth r 1) 2))
                         (set *r78-events* (dlm-nth (dlm-nth r 1) 3))))
              (set *r78-path* path) (set *r78-lock* lock) (list 'reasoning-opened (car r)))))))))
(define-function r78-close ()
  (d77-pause)
  (let ((r (if *r78-path* (r78-save) '(saved))))
    (if (not (= (car r) 'saved)) r
      (begin (if *r78-lock* (file-close *r78-lock*))
        (set *r78-lock* ()) (set *r78-path* ()) (set *r78-state* (r78-new))
        (set *r78-events* ()) '(reasoning-closed)))))
(define-function r78-commit (event)
  (let* ((events (dlm-append *r78-events* (list event))) (next (r78-replay events)))
    (if (= (car next) 'rejected) next
      (if (and *r78-path* (not (r78-checkpoint *r78-path* (list 'reasoning-session78 1 next events))))
          (begin (d77-pause) '(rejected checkpoint))
        (begin (set *r78-state* next) (set *r78-events* events)
          (let ((m (dlm-nth next 2)))
            (if m (n78-summary m) '(reasoning-empty))))))))
(define-function r78-tick ()
  (let ((m (dlm-nth *r78-state* 2)))
    (if (and m (not (dlm-nth m 4)) (n78-ready? m))
        (let ((r (r78-commit '(run 20))))
          (if (= (car r) 'rejected) (begin (d77-pause) (print "Reasoning stopped: " r "\n"))
            (let* ((after (dlm-nth *r78-state* 2)) (count (dlm-length (dlm-nth *r78-state* 1))))
              (if (and (dlm-nth after 4) (= (car (dlm-nth after 2)) 'proof-input78))
                  (begin (r78-commit '(learn))
                    (print "Reasoning answer checked; new proof patterns: "
                      (- (dlm-length (dlm-nth *r78-state* 1)) count) ".\n"))))))
      (d77-pause))))
(define *r78-legacy-dlm* dlm)
(define-function dlm args
  (let ((op (car args)) (rest (cdr args)) (n (dlm-length (cdr args))))
    (cond
      ((and (= op 'save) (= n 0) *r78-path*)
        (let ((r (r78-save))) (if *dlm-store* (list r (d77-save)) r)))
      ((and (= op 'stop) (= n 0) (dlm-nth *r78-state* 2))
        (d77-pause) (if *r78-path* (r78-save) '(paused reasoning-in-memory)))
      ((and (= op 'close) (= n 0) *r78-path*)
        (let ((r (r78-close))) (if *dlm-store* (list r (d77-close)) r)))
      ((and (= op 'think) (= n 1)) (r78-commit (list 'proof (car rest))))
      ((and (= op 'choose-program) (= n 1)) (r78-commit (list 'program (car rest))))
      ((and (= op 'advance) (= n 1)) (r78-commit (list 'run (car rest))))
      ((and (= op 'resume-branches) (= n 0)) (r78-commit '(resume)))
      ((and (= op 'next-branch) (= n 0)) (r78-commit '(next)))
      ((and (= op 'learn-proof) (= n 0)) (r78-commit '(learn)))
      ((and (= op 'branches) (= n 0)) (dlm-nth *r78-state* 2))
      ((and (= op 'proof-library) (= n 0)) (dlm-nth *r78-state* 1))
      ((and (= op 'interpolate) (= n 4))
        (b78-craig (car rest) (dlm-nth rest 1) (dlm-nth rest 2) (dlm-nth rest 3)))
      ((and (= op 'beth) (= n 4))
        (b78-beth (car rest) (dlm-nth rest 1) (dlm-nth rest 2) (dlm-nth rest 3)))
      ((and (= op 'nd-help) (= n 0))
        (print "DLM78: think PROBLEM, choose-program TASKS, advance TICKS, branches, resume-branches, next-branch, learn-proof, proof-library.\n"
          "Stores: nd-open PATH, nd-save, nd-close. Idle: nd-start MS; pause stops either scheduler.\n"
          "Experiments: interpolate SIGNATURE A B BUDGET; beth SIGNATURE THEORY TARGET BUDGET.\n") '(commands-listed))
      ((and (= op 'nd-open) (= n 1)) (r78-open (car rest)))
      ((and (= op 'nd-save) (= n 0)) (r78-save))
      ((and (= op 'nd-close) (= n 0)) (r78-close))
      ((and (= op 'nd-start) (= n 1) (is <long> (car rest)) (>= (car rest) 20) (<= (car rest) 60000)
            (dlm-nth *r78-state* 2))
        (d77-pause) (repl-idle-task '(r78-tick) (car rest))
        (list 'reasoning-scheduled (car rest)))
      (else (apply *r78-legacy-dlm* args)))))

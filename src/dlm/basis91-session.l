;;; Explicit experimental session; no change to dlm step/start or basis90.
;;; Immutable source versions scope readings/witnesses. Atomic publish after save.
(define-function b91-apply (s event)
  (if (not (and (b91-state? s) (pair? event) (dlm-proper? event 5)
                (< (dlm-length (dlm-nth s 6)) 32)
                (or (not *b91-source-event-guard*) (*b91-source-event-guard* s event)))) '(rejected91 state-event-or-capacity)
    (let ((op (car event)) (next s) (valid false) (sig (dlm-nth s 2)))
      (cond
        ((and (= op 'observe91) (sq-shape? event 3) (b91-name? (dlm-nth event 1))
              (< (dlm-length (dlm-nth s 3)) 4) (not (b91-find (dlm-nth s 3) (dlm-nth event 1)))
              (b91-facts? (dlm-nth event 2) sig))
          (set next (s79-field s 3 (dlm-append (dlm-nth s 3) (list (list 'episode91
            (dlm-nth event 1) (+ 1 (dlm-length (dlm-nth s 6))) (dlm-nth event 2) false)))))
          (set valid true))
        ((and (= op 'retract91) (sq-shape? event 2) (b91-name? (dlm-nth event 1))
              (b91-find (dlm-nth s 3) (dlm-nth event 1)))
          (let ((eps ()) (readings ()))
            (list-do ep (dlm-nth s 3) (if (not (equal (dlm-nth ep 1) (dlm-nth event 1)))
              (set eps (dlm-append eps (list ep)))))
            (list-do v (dlm-nth s 5) (if (not (equal (dlm-nth v 1) (dlm-nth event 1)))
              (set readings (dlm-append readings (list v)))))
            (set next (s79-field (s79-field s 3 eps) 5 readings)) (set valid true)))
        ((and (or (and (= op 'interpret91) (sq-shape? event 3))
                  (and (= op 'interpret-controlled91) (sq-shape? event 4) *b91-controlled-interpret*))
              (b91-name? (dlm-nth event 1)) (b91-fuel? (dlm-nth event 2))
              (b91-find (dlm-nth s 3) (dlm-nth event 1))
              (not (dlm-nth (b91-find (dlm-nth s 3) (dlm-nth event 1)) 4)))
          (let* ((ep (b91-find (dlm-nth s 3) (dlm-nth event 1)))
                 (result (if (= op 'interpret91) (b91-interpret s ep (dlm-nth event 2))
                   (*b91-controlled-interpret* s ep (dlm-nth event 2) (dlm-nth event 3)))))
            (if (= (car result) 'interpreted91)
              (let ((eps ()))
                (list-do old (dlm-nth s 3)
                  (set eps (dlm-append eps (list (if (equal (dlm-nth old 1) (dlm-nth ep 1)) (s79-field old 4 true) old)))))
                (set next (s79-field (s79-field s 3 eps) 5 (dlm-append (dlm-nth s 5) (dlm-nth result 1))))
                (set valid true)))))
        ;; Meaning-preserving representation migration in the SAME library.
        ;; Epoch remains the number of definitions; the audit/full core records
        ;; encoding revisions. Existing frozen contexts retain their old body.
        ((and (= op 'encode91) (sq-shape? event 3)
              (is <long> (dlm-nth event 1)) (>= (dlm-nth event 1) 1)
              (<= (dlm-nth event 1) (dlm-length (dlm-nth s 4)))
              (b91-encoded? (dlm-nth event 2)))
          (let ((lib ()))
            (list-do m (dlm-nth s 4)
              (set lib (dlm-append lib (list (if (= (dlm-nth m 1) (dlm-nth event 1))
                (s79-field m 3 (dlm-nth event 2)) m)))))
            (if (b91-library? lib sig) (begin (set next (s79-field s 4 lib)) (set valid true)))))
        ((and (= op 'learn91) (sq-shape? event 3))
          (let ((checked (b91-check-learn s (dlm-nth event 1) (dlm-nth event 2))))
            (if (= (car checked) 'checked91)
              (begin (set next (s79-field (s79-field (s79-field s 4 (dlm-nth checked 1))
                5 (dlm-nth checked 2)) 7 (+ 1 (dlm-nth s 7)))) (set valid true)))))
        (else (if *b91-typed-step*
          (let ((typed (*b91-typed-step* s event)))
            (if (= (car typed) 'basis-state91) (begin (set next typed) (set valid true)))))))
      (if (and valid *b91-typed-refresh*) (set next (*b91-typed-refresh* next)))
      (if (and valid (b91-core? (b91-core next)))
        (s79-field next 6 (dlm-append (dlm-nth s 6) (list event))) '(rejected91 transition)))))
(define-function b91-replay (sig events)
  (if (not (and (b90-names? sig 4) sig (dlm-proper? events 32))) '(rejected91 audit)
    (let ((s (b91-new sig))) (list-do e events
      (if (not (= (car s) 'rejected91)) (set s (b91-apply s e)))) s)))
;;; Executable model and training witnesses are distinct fields. Model execution
;;; evaluates plans on current facts; it never returns a stored training answer.
(define-function b91-evidence (s)
  (let ((out ())) (list-do v (dlm-nth s 5)
    (set out (dlm-append out (list (list 'support91 (dlm-nth v 1) (dlm-nth v 2) (dlm-nth v 3) (dlm-nth v 5)))))) out))
(define-function b91-pack (s) (list 'basis-session91 1 (b91-model s) (b91-evidence s) (dlm-nth s 6)))
(define-function b91-snapshot? (x)
  (and (sq-shape? x 5) (= (car x) 'basis-session91) (= (dlm-nth x 1) 1)
       (b91-model? (dlm-nth x 2))
       (dlm-proper? (dlm-nth x 3) 368) (dlm-proper? (dlm-nth x 4) 32)
    (let ((s (b91-replay (dlm-nth (dlm-nth x 2) 1) (dlm-nth x 4))))
      (and (= (car s) 'basis-state91) (equal (b91-model s) (dlm-nth x 2))
           (equal (b91-evidence s) (dlm-nth x 3))))))
(define *b91-state* (b91-new '(edge)))
(define *b91-path* ())
(define *b91-lock* ())
(define *b91-expected* '(missing))
(define-function b91-checkpoint (path snapshot expected)
  (if (not (and (b91-snapshot? snapshot) (equal (e79-raw-read path) expected))) false
    (let ((tmp (concat-strings path ".next")) (ok true))
      (set ok (and (d77-write tmp snapshot) (equal (e79-raw-read tmp) (list 'data snapshot))))
      (if (and ok (= (car expected) 'data))
        (let ((prior (concat-strings path ".previous.next")))
          (set ok (and (d77-write prior (dlm-nth expected 1)) (equal (e79-raw-read prior) expected)
            (file-replace prior (concat-strings path ".previous"))))))
      (if ok (set ok (and (equal (e79-raw-read path) expected) (file-replace tmp path))))
      (if (not ok) (file-remove tmp)) ok)))
(define-function b91-summary ()
  (let ((s *b91-state*))
    (list 'basis91 'epoch (dlm-nth s 7) 'episodes (dlm-length (dlm-nth s 3))
      'readings (dlm-length (dlm-nth s 5)) 'basis-count (dlm-length (dlm-nth s 4))
      'active-ops (b91-work-size (dlm-nth s 5)) 'events (dlm-length (dlm-nth s 6)) 'store *b91-path*)))
(define-function b91-commit (event)
  (let ((next (b91-apply *b91-state* event)))
    (if (= (car next) 'rejected91) next
      (let ((snapshot (b91-pack next)))
        (if (and *b91-path* (not (b91-checkpoint *b91-path* snapshot *b91-expected*))) '(rejected91 checkpoint)
          (begin (set *b91-state* next) (if *b91-path* (set *b91-expected* (list 'data snapshot)))
            (list 'committed91 (car event) 'epoch (dlm-nth next 7))))))))
(define-function b91-save ()
  (if (not *b91-path*) '(rejected91 not-attached)
    (let ((snapshot (b91-pack *b91-state*)))
      (if (b91-checkpoint *b91-path* snapshot *b91-expected*)
        (begin (set *b91-expected* (list 'data snapshot)) '(saved91)) '(rejected91 checkpoint)))))
(define-function b91-open (path)
  (if (not (and (string? path) (not (equal path "")) (not *b91-path*))) '(rejected91 path-or-close-first)
    (let ((lock (file-lock (concat-strings path ".lock"))))
      (if (not lock) '(rejected91 locked-or-path)
        (let ((old (e79-raw-read path)) (incoming ()) (ok true))
          (cond
            ((= (car old) 'missing) (set incoming *b91-state*))
            ((and (= (car old) 'data) (b91-snapshot? (dlm-nth old 1)))
              (set incoming (b91-replay (dlm-nth (dlm-nth (dlm-nth old 1) 2) 1) (dlm-nth (dlm-nth old 1) 4)))
              (if (and (dlm-nth *b91-state* 6) (not (equal incoming *b91-state*))) (set ok false)))
            (else (set ok false)))
          (if (not ok) (begin (file-close lock) '(rejected91 snapshot-or-reset-first))
            (begin (set *b91-state* incoming) (set *b91-lock* lock) (set *b91-path* path)
              (set *b91-expected* old) (b91-summary))))))))
(define-function b91-close ()
  (if (not *b91-path*) '(closed91)
    (let ((r (b91-save))) (if (not (= (car r) 'saved91)) r
      (begin (file-close *b91-lock*) (set *b91-lock* ()) (set *b91-path* ())
        (set *b91-expected* '(missing)) '(closed91))))))
(define-function b91-coverage (s episode)
  (if (not (and (b91-state? s) (b91-name? episode) (b91-find (dlm-nth s 3) episode))) '(rejected91 episode)
    (let ((ep (b91-find (dlm-nth s 3) episode)) (covered ()) (residual ()) (i 0))
      (list-do v (dlm-nth s 5)
        (if (equal episode (dlm-nth v 1))
          (list-do row (dlm-nth v 5) (set covered (dlm-union covered (dlm-nth row 2))))))
      (list-do fact (dlm-nth ep 3)
        (if (not (dlm-member? i covered)) (set residual (dlm-append residual (list (list i fact)))))
        (set i (+ i 1)))
      (list 'coverage91 episode (dlm-nth ep 2) (if (dlm-nth ep 4) 'interpreted 'uninterpreted) covered residual))))
(define-function basis91 args
  (let ((op (car args)) (rest (cdr args)) (n (dlm-length (cdr args))))
    (cond
      ((and (= op 'init) (= n 1) (not *b91-path*))
        (let ((s (b91-new (car rest)))) (if (= (car s) 'rejected91) s
          (begin (set *b91-state* s) (b91-summary)))))
      ((and (= op 'reset) (= n 0) (not *b91-path*)) (set *b91-state* ()) '(reset91))
      ((and (= op 'restore) (= n 1) (not *b91-path*))
        (if (not (b91-snapshot? (car rest))) '(rejected91 snapshot)
          (begin (set *b91-state* (b91-replay (dlm-nth (dlm-nth (car rest) 2) 1) (dlm-nth (car rest) 4)))
            (b91-summary))))
      ((and (= op 'open) (= n 1)) (b91-open (car rest)))
      ((and (= op 'save) (= n 0)) (b91-save))
      ((and (= op 'close) (= n 0)) (b91-close))
      ((and (= op 'state) (= n 0)) *b91-state*)
      ((and (= op 'model) (= n 0)) (b91-model *b91-state*))
      ((and (= op 'evidence) (= n 0)) (b91-evidence *b91-state*))
      ((and (= op 'status) (= n 0)) (b91-summary))
      ((and (= op 'snapshot) (= n 0)) (b91-pack *b91-state*))
      ((and (= op 'candidates) (= n 0)) (b91-candidates *b91-state*))
      ((and (= op 'proposal) (= n 0)) (b91-propose *b91-state*))
      ((and (= op 'proposal) (= n 2)) (b91-propose-encoded *b91-state* (car rest) (dlm-nth rest 1)))
      ((and (= op 'learn) (or (= n 0) (= n 2)))
        (if (>= (dlm-length (dlm-nth *b91-state* 6)) 32) '(rejected91 event-capacity)
          (let ((p (if (= n 0) (b91-propose *b91-state*)
                     (b91-propose-encoded *b91-state* (car rest) (dlm-nth rest 1)))))
            (if (= (car p) 'learn91) (b91-commit p) p))))
      ((and (= op 'encode) (= n 3) *b91-codec-encode*
            (is <long> (car rest)) (>= (car rest) 1) (<= (car rest) (dlm-length (dlm-nth *b91-state* 4)))
            (b91-relational? (b91-module (dlm-nth *b91-state* 4) (car rest))))
        (let* ((m (b91-module (dlm-nth *b91-state* 4) (car rest)))
               (body (*b91-codec-encode* (b91-body-ops (dlm-nth m 3)) (dlm-nth rest 1) (dlm-nth rest 2))))
          (if body (b91-commit (list 'encode91 (car rest) body)) '(rejected91 encoding))))
      ((and (= op 'observe) (= n 2)) (b91-commit (cons 'observe91 rest)))
      ((and (= op 'retract) (= n 1)) (b91-commit (cons 'retract91 rest)))
      ((and (= op 'interpret) (= n 2)) (b91-commit (cons 'interpret91 rest)))
      ((and (= op 'interpret-controlled) (= n 3)) (b91-commit (cons 'interpret-controlled91 rest)))
      ((and (= op 'inspect) (= n 2) (b91-name? (car rest)) (b91-fuel? (dlm-nth rest 1))
            (b91-find (dlm-nth *b91-state* 3) (car rest)))
        (b91-interpret *b91-state* (b91-find (dlm-nth *b91-state* 3) (car rest)) (dlm-nth rest 1)))
      ((and (= op 'coverage) (= n 1)) (b91-coverage *b91-state* (car rest)))
      ((and (= op 'run) (or (= n 2) (= n 3)))
        (b91-run *b91-state* (car rest) (dlm-nth rest 1) (if (= n 3) (dlm-nth rest 2) 'basis)))
      ((and (= op 'query) (or (= n 3) (= n 4)))
        (b91-query *b91-state* (car rest) (dlm-nth rest 1) (dlm-nth rest 2) (if (= n 4) (dlm-nth rest 3) 'basis)))
      ((and (= op 'infer) (or (= n 4) (= n 5)))
        (b91-infer (car rest) (dlm-nth rest 1) (dlm-nth rest 2) (dlm-nth rest 3) (if (= n 5) (dlm-nth rest 4) 'basis)))
      ((and (= op 'probe) (or (= n 3) (= n 4)))
        (b91-probe *b91-state* (car rest) (dlm-nth rest 1) (dlm-nth rest 2) (if (= n 4) (dlm-nth rest 3) 'basis)))
      (else (if *b91-typed-command* (*b91-typed-command* args) '(rejected91 command-or-arity))))))

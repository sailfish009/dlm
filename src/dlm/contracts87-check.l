;;; Complete finite-state execution plus a separate local-trace checker.
;;; Shared trusted primitives: Boolean evaluation, store operations and IR typing.
(define-function c87-fuel? (n) (and (is <long> n) (>= n 0) (<= n 200000)))
(define-function c87-execute (c lib input fuel)
  (let ((tasks (dlm-nth c 4)) (env input) (trace ()) (used 0) (status 'ok) (reason 'ok))
    (while (and tasks (= status 'ok))
      (if (>= used fuel) (begin (set status 'unknown) (set reason 'budget))
        (let* ((s (car tasks)) (op (car s)))
          (set tasks (cdr tasks)) (set used (+ used 1))
          (cond
            ((= op 'assign)
              (let ((value (c87-eval (dlm-nth s 2) env input)))
                (set env (s79-put env (dlm-nth s 1) value))
                (set trace (cons (list 'assign87 (dlm-nth s 1) value) trace))))
            ((= op 'assert)
              (let ((value (c87-eval (dlm-nth s 1) env input)))
                (set trace (cons (list 'assert87 value) trace))
                (if (= value 0) (begin (set status 'failed) (set reason 'assertion)))))
            ((= op 'if)
              (let ((value (c87-eval (dlm-nth s 1) env input)))
                (set trace (cons (list 'branch87 value) trace))
                (set tasks (dlm-append (dlm-nth s (if (= value 1) 2 3)) tasks))))
            ((= op 'call)
              (let* ((m (c87-module lib (dlm-nth s 1)))
                     (pre (c87-eval (dlm-nth (dlm-nth m 1) 3) env env)))
                (if (= pre 0)
                  (begin (set trace (cons (list 'call87 (dlm-nth s 1) 'blocked) trace))
                    (set status 'failed) (set reason 'call-precondition))
                  (let ((row (c87-row m env)))
                    (if (not row) (begin (set status 'unknown) (set reason 'summary-missing))
                      (begin (set env (dlm-nth row 2))
                        (set trace (cons (list 'call87 (dlm-nth s 1) env) trace))))))))))))
    (list 'execution87 status reason env (s79-reverse trace) used)))
;;; This checker walks the source and verifies recorded steps, never calls execute.
(define-function c87-trace (c lib input trace fuel)
  (let ((todo (dlm-nth c 4)) (env input) (rest trace) (used 0) (status 'ok) (reason 'ok))
    (while (and todo (= status 'ok))
      (cond
        ((>= used fuel) (set status 'unknown) (set reason 'budget))
        ((not rest) (set status 'invalid) (set reason 'missing-step))
        (else
          (let* ((stmt (car todo)) (event (car rest)) (op (car stmt)) (expected ()))
            (set todo (cdr todo)) (set rest (cdr rest)) (set used (+ used 1))
            (cond
              ((= op 'assign)
                (let ((value (c87-eval (dlm-nth stmt 2) env input)))
                  (set expected (list 'assign87 (dlm-nth stmt 1) value))
                  (set env (s79-put env (dlm-nth stmt 1) value))))
              ((= op 'assert)
                (let ((value (c87-eval (dlm-nth stmt 1) env input)))
                  (set expected (list 'assert87 value))
                  (if (= value 0) (begin (set status 'failed) (set reason 'assertion)))))
              ((= op 'if)
                (let ((value (c87-eval (dlm-nth stmt 1) env input)))
                  (set expected (list 'branch87 value))
                  (set todo (dlm-append (dlm-nth stmt (if (= value 1) 2 3)) todo))))
              ((= op 'call)
                (let* ((m (c87-module lib (dlm-nth stmt 1)))
                       (pre (c87-eval (dlm-nth (dlm-nth m 1) 3) env env)))
                  (if (= pre 0)
                    (begin (set expected (list 'call87 (dlm-nth stmt 1) 'blocked))
                      (set status 'failed) (set reason 'call-precondition))
                    (let ((row (c87-row m env)))
                      (if row
                        (begin (set env (dlm-nth row 2)) (set expected (list 'call87 (dlm-nth stmt 1) env)))
                        (begin (set status 'invalid) (set reason 'missing-summary))))))))
            (if (not (equal event expected)) (begin (set status 'invalid) (set reason 'bad-step)))))))
    (if (and (not (= status 'unknown)) rest) (begin (set status 'invalid) (set reason 'extra-step)))
    (list 'trace87 status reason env used)))
(define-function c87-check-one (c lib cert fuel)
  (if (not (and (c87-contract? c lib) (sq-shape? cert 4) (= (car cert) 'certificate87)
                (equal c (dlm-nth cert 1)) (equal (c87-bindings lib) (dlm-nth cert 2))
                (dlm-proper? (dlm-nth cert 3) 64))) '(check87 invalid 0 certificate-header)
    (let ((rows (dlm-nth cert 3)) (used 0) (status 'verified) (reason 'ok) (count 0))
      (list-do input (c87-states (dlm-nth c 2))
        (if (= status 'verified)
          (if (>= used fuel) (begin (set status 'unknown) (set reason 'budget))
            (begin
              (set used (+ used 1))
              (if (= (c87-eval (dlm-nth c 3) input input) 1)
                (let ((row (car rows)))
                  (set count (+ count 1)) (set rows (cdr rows))
                  (if (not (and (sq-shape? row 4) (= (car row) 'case87) (equal input (dlm-nth row 1))
                                (dlm-proper? (dlm-nth row 3) 128)))
                    (begin (set status 'invalid) (set reason 'case-coverage))
                    (let ((checked (c87-trace c lib input (dlm-nth row 3) (- fuel used))))
                      (set used (+ used (dlm-nth checked 4)))
                      (cond
                        ((= (dlm-nth checked 1) 'unknown) (set status 'unknown) (set reason 'budget))
                        ((not (and (= (dlm-nth checked 1) 'ok)
                                   (equal (dlm-nth row 2) (dlm-nth checked 3))
                                   (= (c87-eval (dlm-nth c 5) (dlm-nth checked 3) input) 1)
                                   (c87-frame? c input (dlm-nth checked 3))))
                          (set status 'invalid) (set reason 'case-proof)))))))))))
      (if (= status 'verified)
        (cond ((= count 0) (set status 'invalid) (set reason 'inapplicable))
              (rows (set status 'invalid) (set reason 'extra-case))))
      (list 'check87 status used reason))))
(define-function c87-library-check (lib fuel)
  (if (not (and (sq-shape? lib 2) (= (car lib) 'library87) (dlm-proper? (dlm-nth lib 1) 8)))
    '(check87 invalid 0 library-shape)
    (let ((prefix (c87-empty)) (used 0) (status 'verified) (reason 'ok))
      (list-do m (dlm-nth lib 1)
        (if (= status 'verified)
          (if (not (and (sq-shape? m 3) (= (car m) 'module87)))
            (begin (set status 'invalid) (set reason 'module-shape))
            (let ((r (c87-check-one (dlm-nth m 1) prefix (dlm-nth m 2) (- fuel used))))
              (set used (+ used (dlm-nth r 2))) (set status (dlm-nth r 1)) (set reason (dlm-nth r 3))
              (if (= status 'verified)
                (set prefix (list 'library87 (dlm-append (dlm-nth prefix 1) (list m)))))))))
      (list 'check87 status used reason))))
(define-function c87-counter-one (c lib witness fuel)
  (if (not (and (c87-contract? c lib) (sq-shape? witness 6) (= (car witness) 'counterexample87)
                (equal c (dlm-nth witness 1)) (equal (c87-bindings lib) (dlm-nth witness 2))
                (dlm-member? (dlm-nth witness 3) (c87-states (dlm-nth c 2)))
                (dlm-proper? (dlm-nth witness 4) 128))) '(check87 invalid 0 witness-header)
    (let* ((input (dlm-nth witness 3))
           (r (c87-trace c lib input (dlm-nth witness 4) fuel))
           (why (if (= (dlm-nth r 1) 'failed) (dlm-nth r 2)
                  (if (and (= (dlm-nth r 1) 'ok)
                           (= (c87-eval (dlm-nth c 5) (dlm-nth r 3) input) 0)) 'postcondition ()))))
      (cond
        ((= (dlm-nth r 1) 'unknown) (list 'check87 'unknown (dlm-nth r 4) 'budget))
        ((and (= (c87-eval (dlm-nth c 3) input input) 1) why (equal why (dlm-nth witness 5)))
          (list 'check87 'refuted (dlm-nth r 4) why))
        (else (list 'check87 'invalid (dlm-nth r 4) 'witness-proof))))))
(define-function c87-check (c lib proof fuel)
  (if (not (c87-fuel? fuel)) '(check87 invalid 0 budget)
    (let ((l (c87-library-check lib fuel)))
      (if (not (= (dlm-nth l 1) 'verified)) l
        (let ((r (if (and (pair? proof) (= (car proof) 'counterexample87))
                   (c87-counter-one c lib proof (- fuel (dlm-nth l 2)))
                   (c87-check-one c lib proof (- fuel (dlm-nth l 2))))))
          (s79-field r 2 (+ (dlm-nth l 2) (dlm-nth r 2))))))))
(define-function c87-propose (c lib fuel)
  (let ((l (c87-library-check lib fuel)))
    (if (not (= (dlm-nth l 1) 'verified))
      (list (if (= (dlm-nth l 1) 'unknown) 'unknown87 'invalid87) (dlm-nth l 3) (dlm-nth l 2))
      (if (not (c87-contract? c lib)) '(invalid87 contract 0)
        (let ((rows ()) (used (dlm-nth l 2)) (answer ()) (count 0))
          (list-do input (c87-states (dlm-nth c 2))
            (if (not answer)
              (if (>= used fuel) (set answer (list 'unknown87 'budget used))
                (begin
                  (set used (+ used 1))
                  (if (= (c87-eval (dlm-nth c 3) input input) 1)
                    (let ((r (c87-execute c lib input (- fuel used))))
                      (set count (+ count 1)) (set used (+ used (dlm-nth r 5)))
                      (cond
                        ((= (dlm-nth r 1) 'unknown) (set answer (list 'unknown87 (dlm-nth r 2) used)))
                        ((or (= (dlm-nth r 1) 'failed)
                             (= (c87-eval (dlm-nth c 5) (dlm-nth r 3) input) 0))
                          (set answer (list 'counterexample87
                            (list 'counterexample87 c (c87-bindings lib) input (dlm-nth r 4)
                              (if (= (dlm-nth r 1) 'failed) (dlm-nth r 2) 'postcondition)) used)))
                        (else (set rows (dlm-append rows (list (list 'case87 input (dlm-nth r 3) (dlm-nth r 4)))))))))))))
          (or answer (if (= count 0) (list 'inapplicable87 'inconsistent-precondition used)
            (list 'proposed87 (list 'certificate87 c (c87-bindings lib) rows) used))))))))
(define-function c87-verify (c lib fuel)
  (if (not (c87-fuel? fuel)) '(invalid87 budget 0)
    (let ((p (c87-propose c lib fuel)))
      (if (not (dlm-member? (car p) '(proposed87 counterexample87))) p
        (let* ((r (c87-check c lib (dlm-nth p 1) (- fuel (dlm-nth p 2))))
               (used (+ (dlm-nth p 2) (dlm-nth r 2))))
          (cond
            ((= (dlm-nth r 1) 'verified) (list 'verified87 (dlm-nth p 1) used))
            ((= (dlm-nth r 1) 'refuted) (list 'refuted87 (dlm-nth p 1) used))
            ((= (dlm-nth r 1) 'unknown) (list 'unknown87 'budget used))
            (else (list 'invalid87 'checker-disagreement used))))))))
(define-function c87-admit (lib c fuel)
  (if (and (sq-shape? lib 2) (dlm-proper? (dlm-nth lib 1) 8) (>= (dlm-length (dlm-nth lib 1)) 8))
    '(unknown87 library-capacity 0)
    (let ((r (c87-verify c lib fuel)))
      (if (= (car r) 'verified87)
        (list 'admitted87 (list 'library87 (dlm-append (dlm-nth lib 1)
          (list (list 'module87 c (dlm-nth r 1))))) (dlm-nth r 2)) r))))

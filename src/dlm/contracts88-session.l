;;; One native checkpoint and transaction boundary for both learning domains.
(define *c88-frame* (c88-frame))
(define *c88-pending* ()) ; expected event log, checked next frame
(define-function c88-replayed-frame (r)
  (list 'frame88 (dlm-nth r 1) (dlm-nth r 2) (dlm-nth r 3) (dlm-nth r 4)))
(define-function c88-matches? (events model)
  (and *c88-pending* (equal events (car *c88-pending*))
       (equal model (dlm-nth (dlm-nth *c88-pending* 1) 1))))
(define-function c88-admit (model events)
  (if (not (d88-log? events)) true
    (if (c88-matches? events model) true
      (let ((r (c88-replay events)))
        (if (and (= (car r) 'replayed) (equal model (dlm-nth r 1)))
          (begin (set *c88-pending* (list events (c88-replayed-frame r))) true) false)))))
(define-function c88-pack (model round events)
  (let ((frame (if (c88-matches? events model) (dlm-nth *c88-pending* 1)
                 (c88-replayed-frame (c88-replay events)))))
    (list 'dlm-session88 1 model round events (dlm-nth frame 4))))
(define-function c88-snapshot? (x)
  (and (sq-shape? x 6) (= (car x) 'dlm-session88) (= (dlm-nth x 1) 1)
       (is <long> (dlm-nth x 3)) (>= (dlm-nth x 3) 0)
       (dlm-proper? (dlm-nth x 4) 256) (d88-log? (dlm-nth x 4))
       (a77-valid? (dlm-nth x 2))
       ;; Never use pending or live caches for untrusted disk validation.
       (let ((r (c88-replay (dlm-nth x 4))))
         (and (= (car r) 'replayed) (equal (dlm-nth r 1) (dlm-nth x 2))
              (equal (dlm-nth r 4) (dlm-nth x 5))))))
(define-function c88-sync ()
  (set *c88-frame*
    (if (d88-log? *dlm-events*)
      (if (c88-matches? *dlm-events* *dlm-model*) (dlm-nth *c88-pending* 1)
        (c88-replayed-frame (c88-replay *dlm-events*)))
      ;; Legacy relation-only sessions keep their original fast path. The first
      ;; joint transaction lazily replays this prefix, without publishing it.
      (list 'frame88 *dlm-model* (a84-new) 'ready (c88-new))))
  (set *c88-pending* ())
  (set *c87-library* (dlm-nth (dlm-nth *c88-frame* 4) 3))
  (if (d88-log? *dlm-events*)
    (begin (set *dlm-cursor* (dlm-nth (dlm-nth *c88-frame* 4) 9))
           (set *dlm-saturated* (dlm-member? (dlm-nth *c88-frame* 3) '(saturated capacity))))))
(define-function c88-restored ()
  (if (d88-log? *dlm-events*) (set *dlm-pair-budget* (dlm-nth (dlm-nth *c88-frame* 4) 12))))
(define-function c88-control ()
  (if (d88-log? *dlm-events*)
    (list 'replayed (dlm-nth *c88-frame* 1) (dlm-nth *c88-frame* 2)
                   (dlm-nth *c88-frame* 3) (dlm-nth *c88-frame* 4)) ()))
(define-function c88-can-open (snapshot)
  (or (not (d88-log? *dlm-events*)) (equal (dlm-nth *c88-frame* 4) (c88-new))
      (equal (dlm-nth *c88-frame* 4)
        (if (= (car snapshot) 'dlm-session88) (dlm-nth snapshot 5) (c88-new)))))
(define-function c88-summary ()
  (if (not (d88-log? *dlm-events*)) ()
    (let ((j (dlm-nth *c88-frame* 4)) (goals ()))
      (list-do g (dlm-nth j 4)
        (set goals (dlm-append goals (list (list (c88-name g) (dlm-nth g 2)
          'cursor (dlm-nth g 3) 'attempts (dlm-nth g 5) 'reason (dlm-nth g 6))))))
      (list 'curriculum88 (dlm-nth j 2) 'turn (dlm-nth j 5)
        'contract-budget (list (dlm-nth j 6) (dlm-nth j 7))
        'contract-requests (dlm-nth j 8) 'relation-requests (dlm-nth j 11) 'relation-budget (dlm-nth j 12)
        'procedures (dlm-length (dlm-nth (dlm-nth j 3) 1)) 'goals goals))))
(define-function c88-event (event advance)
  (if (>= (dlm-length *dlm-events*) 256) '(rejected88 event-limit)
    (let* ((base (if (d88-log? *dlm-events*) *c88-frame*
                    (c88-replayed-frame (c88-replay *dlm-events*))))
           (r (c88-apply base event)) (old-round *dlm-round*))
      (if (not (= (car r) 'applied88)) r
        (begin
          (if advance (set *dlm-round* (+ *dlm-round* 1)))
          (set *c88-pending* (list (dlm-append *dlm-events* (list event)) (dlm-nth r 1)))
          (let ((commit (d77-commit (dlm-nth (dlm-nth r 1) 1) event)))
            (set *c88-pending* ())
            (if (= (car commit) 'committed)
              (begin (if (= (car event) 'relation-config88) (c88-restored)) (list 'applied88 (dlm-nth r 2)))
              (begin (set *dlm-round* old-round) commit))))))))
(define-function c88-publish-library (lib)
  (if (equal lib *c87-library*) '(published87)
    (let ((r (c88-event (list 'library88 lib) false)))
      (if (= (car r) 'applied88) '(published87) r))))
(define-function c88-step ()
  (if (not (d88-log? *dlm-events*)) (s84-step)
    (let ((domain (c88-domain *c88-frame*)))
      (if (= domain 'waiting)
        (begin (set *dlm-round* (+ *dlm-round* 1)) (set *dlm-last* '(waiting curriculum))
               (list 'round *dlm-round* *dlm-last*))
        (let ((r (c88-event (if (= domain 'contracts) '(contract-run88)
                               (list 'relation-run88 *dlm-pair-budget*)) true)))
          (if (= (car r) 'applied88) (set *dlm-last* (dlm-nth r 1))
            (begin (d77-pause) (set *dlm-last* r)))
          (list 'round *dlm-round* *dlm-last*))))))
(define-function c88-command (op args)
  (let ((n (dlm-length args)) (r ()))
    (cond
      ((and (= op 'goals) (= n 0)) (dlm-nth (dlm-nth *c88-frame* 4) 4))
      ((and (= op 'curriculum) (= n 0)) (c88-summary))
      ((and (= op 'curriculum) (= n 1))
        (set r (c88-event (list 'curriculum88 (car args)) false))
        (if (= (car r) 'applied88) (c88-summary) r))
      ((and (= op 'goal) (= n 1))
        (set r (c88-event (list 'goal88 (car args)) false))
        (if (= (car r) 'applied88) (list 'queued88 (dlm-nth (car args) 1)) r))
      ((and (= op 'retry-goal) (= n 1)) (c88-event (list 'retry-goal88 (car args)) false))
      ((and (= op 'relation-budget) (= n 1)) (c88-event (cons 'relation-config88 args) false))
      ((and (= op 'contract-budget) (= n 2)) (c88-event (cons 'contract-config88 args) false))
      (else '(rejected88 command-or-arity)))))
(set d88-replay c88-replay)
(set d88-pack c88-pack)
(set d88-snapshot? c88-snapshot?)
(set d88-sync c88-sync)
(set d88-restored c88-restored)
(set d88-control c88-control)
(set d88-step c88-step)
(set d88-command c88-command)
(set d88-can-open c88-can-open)
(set d88-summary c88-summary)
(set d88-admit c88-admit)
(set c88-publish c88-publish-library)

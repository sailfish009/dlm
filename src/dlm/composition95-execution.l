;;; Native typed execution plus separate expanded arithmetic / primitive-join
;;; checking. Outputs never become raw observations. All results stay empirical95.
(define *c95-stats* '(metrics95 0 0 0 0)) ; relation queries, comp calls, numeric calls, worker nodes
(define-function c95-count (i n)
  (set *c95-stats* (s79-field *c95-stats* i (+ (dlm-nth *c95-stats* i) n))))
(define-function c95-proof (assumptions measures ids)
  (list 'proof95 assumptions measures (b91-fact-key ids)))
(define-function c95-merge-proof (a b)
  (c95-proof (dlm-union (dlm-nth a 1) (dlm-nth b 1))
    (dlm-union (dlm-nth a 2) (dlm-nth b 2)) (dlm-union (dlm-nth a 3) (dlm-nth b 3))))
(define-function c95-assumption (scope cell)
  (list 'assumption95 (dlm-nth scope 1) (dlm-nth scope 2) (dlm-nth scope 3) (dlm-nth scope 4) cell))
(define-function c95-scalar (status value proof fuel used)
  (list 'scalar95 status (if (= status 'complete) value ()) proof fuel used))
(define-function c95-num-deps (id lib)
  (let ((out (list id)) (changed true))
    (while changed (set changed false)
      (list-do i out
        (let ((todo (list (dlm-nth (b91-module lib i) 3))))
          (while todo
            (let ((t (car todo))) (set todo (cdr todo))
              (if (pair? t)
                (cond ((= (car t) 'eml93) (set todo (cons (dlm-nth t 1) (cons (dlm-nth t 2) todo))))
                  ((= (car t) 'call93)
                    (if (not (dlm-member? (dlm-nth t 1) out))
                      (begin (set out (cons (dlm-nth t 1) out)) (set changed true)))
                    (set todo (dlm-append (dlm-nth t 2) todo))))))))))
    (b91-fact-key out)))
(define c95-eval-composite ())
(define-function c95-eval-inputs (ports tuple context model raw fuel)
  (let ((inputs ()) (proof (c95-proof () () ())) (status 'complete) (initial fuel))
    (list-do port ports
      (if (= status 'complete)
        (if (= fuel 0) (set status 'unknown)
          (begin
            (set fuel (- fuel 1))
            (if (= (car port) 'measure95)
              (let* ((object (dlm-nth tuple (dlm-nth port 1))) (z (c95-measure (dlm-nth context 4) object)))
                (if (not z) (set status 'unknown)
                  (begin (set inputs (dlm-append inputs (list z)))
                    (set proof (c95-merge-proof proof (c95-proof ()
                      (list (list 'measured95 (dlm-nth context 1) (dlm-nth context 2) object z)) ()))))))
              (let ((v (c95-eval-composite (b91-module (dlm-nth model 3) (dlm-nth port 1)) tuple context model raw fuel true)))
                (set status (dlm-nth v 1)) (set fuel (dlm-nth v 4))
                (set proof (c95-merge-proof proof (dlm-nth v 3)))
                (if (= status 'complete) (set inputs (dlm-append inputs (list (dlm-nth v 2)))))))))))
    (c95-scalar status inputs proof fuel (- initial fuel))))
(set c95-eval-composite (lambda (m tuple context model raw fuel own)
  (if (= fuel 0) (c95-scalar 'unknown () (c95-proof () () ()) fuel 0)
    (let* ((initial fuel) (lib (dlm-nth model 3)) (scopes (dlm-nth (dlm-nth model 6) 2))
           (cs (c95-scope scopes 'composite95 (dlm-nth m 1)))
           (num (b91-module lib (dlm-nth m 3))) (ns (c95-scope scopes 'numeric95 (dlm-nth num 1)))
           (args (c95-eval-inputs (dlm-nth m 4) tuple context model raw (- fuel 1)))
           (status (dlm-nth args 1)) (proof (dlm-nth args 3)) (value ()))
      (if (not raw) (c95-count 2 1))
      (set fuel (dlm-nth args 4))
      (if (= status 'complete)
        (let* ((inputs (dlm-nth args 2)) (cell (e93-cell inputs)))
          (if (not (and ns (dlm-member? cell (dlm-nth ns 5))
                   (or (not own) (and cs (dlm-member? cell (dlm-nth cs 5))))))
            (set status 'unknown)
            (begin
              (set proof (c95-merge-proof proof (c95-proof
                (if own (list (c95-assumption cs cell) (c95-assumption ns cell)) (list (c95-assumption ns cell)))
                () (cons (dlm-nth m 1) (c95-num-deps (dlm-nth num 1) lib)))))
              (if raw
                (let ((units (+ 1 (* 2 (e93-size (dlm-nth num 4))))))
                  (if (< fuel units) (begin (set fuel 0) (set status 'unknown))
                    (begin (set fuel (- fuel units)) (set value (e93-raw (dlm-nth num 4) inputs (dlm-nth num 5)))
                      (if (not (e93-z? value)) (set status 'unknown)))))
                (let ((v (e93-eval (e93-call (dlm-nth num 1) (dlm-nth num 2)) inputs
                            (c95-number-lib lib) (dlm-nth num 5) (e93-runtime fuel))))
                  (set fuel (dlm-nth (dlm-nth v 3) 1)) (set value (dlm-nth v 2))
                  (c95-count 3 (dlm-nth (dlm-nth v 3) 3)) (c95-count 4 (dlm-nth (dlm-nth v 3) 2))
                  (if (not (= (dlm-nth v 1) 'complete)) (set status 'unknown))))))))
      (c95-scalar status value proof fuel (- initial fuel))))))
(define-function c95-bindings (model rel context raw fuel)
  (let ((p (dlm-nth rel 2)) (status 'complete) (rows ()) (initial fuel))
    (if raw
      (let* ((v (b91-eval-plan (b91-primitive p) (dlm-nth context 3) () (b91-runtime fuel) false))
             (r (dlm-nth v 3)))
        (set fuel (dlm-nth r 1)) (set status (dlm-nth v 1))
        (if (= status 'complete)
          (let ((cert (b91-certify p (dlm-nth v 2) (list 'episode91 (dlm-nth context 1) (dlm-nth context 2) (dlm-nth context 3) false))))
            (if (= (car cert) 'certified91) (set rows (dlm-nth cert 1)) (set status 'rejected)))))
      (let* ((m (c95-query-model model context))
             (start (a92-new m (dlm-nth context 1) p 'ordered92 fuel))
             (done (if (= (car start) 'attention-state92) (a92-run start 64) start)))
        (c95-count 1 1)
        (if (not (= (car done) 'attention-state92)) (set status 'rejected)
          (let ((result (a92-result done)))
            (set status (dlm-nth result 1)) (set rows (dlm-nth result 3)) (set fuel (dlm-nth (a92-work done) 8))))))
    (list 'bindings95 status rows fuel (- initial fuel))))
(define-function c95-worker (model m context raw fuel)
  (let* ((rel (b91-module (dlm-nth model 3) (dlm-nth m 2)))
         (bindings (c95-bindings model rel context raw fuel)) (status (dlm-nth bindings 1)) (rows ()))
    (set fuel (dlm-nth bindings 3))
    (list-do row (dlm-nth bindings 2)
      (if (= status 'complete)
        (let ((v (c95-eval-composite m (dlm-nth row 1) context model raw fuel true)))
          (set status (dlm-nth v 1)) (set fuel (dlm-nth v 4))
          (if (= status 'complete)
            (set rows (dlm-append rows (list (list 'result95 (dlm-nth row 1) (dlm-nth v 2)
              (list 'evidence95 (dlm-nth context 1) (dlm-nth context 2) (dlm-nth row 2) (dlm-nth v 3))))))))))
    (list 'work95 status (if (= status 'complete) rows ()) fuel)))
;;; Checker uses raw EML expansion + primitive joins, not the composite worker.
(define-function c95-check-output (model m context proposed fuel)
  (let* ((rel (b91-module (dlm-nth model 3) (dlm-nth m 2)))
         (bindings (c95-bindings model rel context true fuel)) (status (dlm-nth bindings 1)) (expected ()))
    (set fuel (dlm-nth bindings 3))
    (list-do row (dlm-nth bindings 2)
      (if (= status 'complete)
        (let ((v (c95-eval-composite m (dlm-nth row 1) context model true fuel true)))
          (set fuel (dlm-nth v 4)) (set status (dlm-nth v 1))
          (if (= status 'complete)
            (set expected (dlm-append expected (list (list 'result95 (dlm-nth row 1) (dlm-nth v 2)
              (list 'evidence95 (dlm-nth context 1) (dlm-nth context 2) (dlm-nth row 2) (dlm-nth v 3))))))))))
    (list 'checked95 status (and (= status 'complete) (dlm-proper? proposed 512)
      (= (dlm-length expected) (dlm-length proposed))
      (not (dlm-difference expected proposed)) (not (dlm-difference proposed expected))) fuel)))
(define-function c95-infer (model channel context fuel)
  (if (not (and (b91-model? model) (sq-shape? model 7) (b91-name? channel)
       (c95-context? context (dlm-nth model 1)) (b91-fuel? fuel))) '(rejected95 query)
    (let ((choice ()))
      (list-do v (dlm-nth (dlm-nth model 6) 2)
        (if (and (= (dlm-nth v 1) 'composite95) (equal (dlm-nth v 2) channel))
          (set choice (b91-module (dlm-nth model 3) (dlm-nth v 4)))))
      (if (not choice) '(typed-answer95 unknown inactive-scope ())
        (let ((worker (c95-worker model choice context false fuel)))
          (if (= (dlm-nth worker 1) 'rejected) '(rejected95 worker)
          (if (not (= (dlm-nth worker 1) 'complete)) '(typed-answer95 unknown incomplete-worker ())
            (let ((check (c95-check-output model choice context (dlm-nth worker 2) (dlm-nth worker 3))))
              (cond ((not (= (dlm-nth check 1) 'complete)) '(typed-answer95 unknown incomplete-check ()))
                ((not (dlm-nth check 2)) '(rejected95 independent-check))
                (else (list 'typed-answer95 'complete 'empirical95 (dlm-nth worker 2))))))))))))

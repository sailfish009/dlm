;;; Native discrete EML structure search. No supplied target program/template.
;;; A sign-cell is an explicitly restricted empirical applicability hypothesis.
;;; Minimum three DISTINCT input observations; duplicates rejected at ingress.
(define-function e93-pool (arity lib cost)
  (let ((zero (list 'one93)) (levels ()) (n 1) (total 0) (limited false))
    (list-do i (b91-range arity) (set zero (dlm-append zero (list (list 'x93 i)))))
    (set levels (list zero))
    (while (and (<= n cost) (not limited))
      (let ((level ()) (count 0))
        ;; Unary learned constructors precede raw EML at equal grammar cost.
        (list-do b lib (if (= (dlm-nth b 2) 1)
          (list-do a (dlm-nth levels (- n 1))
            (if (< count 5000) (begin (set level (cons (list 'call93 (dlm-nth b 1) (list a)) level))
              (set count (+ count 1))) (set limited true)))))
        (list-do i (b91-range n)
          (list-do a (dlm-nth levels i)
            (list-do b (dlm-nth levels (- (- n 1) i))
              (if (< count 5000) (begin (set level (cons (list 'eml93 a b) level)) (set count (+ count 1)))
                (set limited true))
              (list-do m lib (if (= (dlm-nth m 2) 2)
                (if (< count 5000) (begin (set level (cons (list 'call93 (dlm-nth m 1) (list a b)) level))
                  (set count (+ count 1))) (set limited true)))))))
        (set levels (dlm-append levels (list (s79-reverse level)))) (set total (+ total count)))
      (set n (+ n 1)))
    (list 'pool93 levels limited total)))
(define-function e93-known-expansion? (expanded arity lib)
  (let ((known false)) (list-do b lib
    (if (and (= (dlm-nth b 2) arity) (equal expanded (dlm-nth b 4))) (set known true))) known))
(define-function e93-search (arity rows lib branch cost fuel)
  (let* ((pool (e93-pool arity lib cost)) (r (e93-runtime fuel)) (found ()) (tested 0) (status 'no-fit))
    (list-do level (dlm-nth pool 1)
      (list-do t level
        (if (and (not found) (not (= status 'unknown)) (e93-all-roles? t arity) (> (e93-size t) 0))
          (let ((expanded (e93-expand t lib)))
            (if (and expanded (<= (e93-size expanded) 96) (not (e93-known-expansion? expanded arity lib)))
              (let ((fit (e93-fit t rows lib branch 1000 r)))
                (set r (dlm-nth fit 3)) (set tested (+ tested 1))
                (cond ((= (dlm-nth fit 1) 'matched) (set found (list t expanded (dlm-nth fit 2))) (set status 'found))
                  ((= (dlm-nth fit 1) 'unknown) (set status 'unknown)))))))))
    (if (and (not found) (dlm-nth pool 2)) (set status 'unknown))
    (list 'search93 status found (list 'search-metrics93 tested (dlm-nth pool 3) (dlm-nth r 2)
      (dlm-nth r 3) (dlm-nth pool 2)))))
;;; Independent view admission evaluates expanded primitive EML, never the worker.
(define-function e93-raw-fits? (expanded rows branch)
  (let ((ok true)) (list-do row rows
    (if (not (e93-close? (e93-raw expanded (dlm-nth row 2) branch) (dlm-nth row 3) 1000)) (set ok false))) ok))
(define-function e93-build-views (episodes lib branch)
  (let ((views ())) (list-do ep episodes
    (list-do cell (e93-cells (dlm-nth ep 4))
      (let ((rows (e93-cell-rows (dlm-nth ep 4) cell)) (choice ()))
        (if (>= (dlm-length rows) 3)
          (list-do b lib (if (and (not choice) (= (dlm-nth b 2) (dlm-nth ep 3))
            (e93-raw-fits? (dlm-nth b 4) rows branch)) (set choice b))))
        (if choice (set views (cons (list 'view93 (dlm-nth ep 1) (dlm-nth ep 2)
          (dlm-nth ep 3) cell (e93-call (dlm-nth choice 1) (dlm-nth ep 3))) views))))))
    (s79-reverse views)))
(define-function e93-covered? (views source cell)
  (let ((found false)) (list-do v views
    (if (and (equal source (dlm-nth v 1)) (equal cell (dlm-nth v 4))) (set found true))) found))
(define-function e93-residual (s source)
  (let ((ep (e93-find (dlm-nth s 3) source)) (out ()))
    (if ep (list-do cell (e93-cells (dlm-nth ep 4))
      (if (not (e93-covered? (dlm-nth s 5) source cell))
        (set out (dlm-append out (list (list 'residual93 cell
          (dlm-length (e93-cell-rows (dlm-nth ep 4) cell))))))))) out))
(define-function e93-propose (s source cost fuel)
  (let ((ep (e93-find (dlm-nth s 3) source)) (residual (e93-residual s source)))
    ;; A thin first cell must not block a later cell with adequate observations.
    (let ((ready ())) (list-do item residual
      (if (>= (dlm-nth item 2) 3) (set ready (dlm-append ready (list item)))))
      (if ready (set residual ready)))
    (cond ((not ep) '(rejected93 source))
      ((not residual) '(waiting93 covered))
      ((>= (dlm-length (e93-lib s)) 8) '(waiting93 capacity))
      (else (let* ((cell (dlm-nth (car residual) 1)) (rows (e93-cell-rows (dlm-nth ep 4) cell)))
        (if (< (dlm-length rows) 3) '(waiting93 distinct-observations)
          (let ((search (e93-search (dlm-nth ep 3) rows (e93-lib s) (dlm-nth s 2) cost fuel)))
            (if (not (= (dlm-nth search 1) 'found))
              (list 'waiting93 (dlm-nth search 1) (dlm-nth search 3))
              (let* ((f (dlm-nth search 2))
                     (basis (list 'basis93 (+ 1 (dlm-length (e93-lib s))) (dlm-nth ep 3) (car f) (dlm-nth f 1)))
                     (lib (dlm-append (e93-lib s) (list basis))))
                (list 'learn93 source cell basis (dlm-nth f 2)
                  (e93-build-views (dlm-nth s 3) lib (dlm-nth s 2)) (dlm-nth search 3)))))))))))
(define-function e93-check-learn (s p)
  (and (sq-shape? p 7) (= (car p) 'learn93)
    (let* ((ep (e93-find (dlm-nth s 3) (dlm-nth p 1))) (b (dlm-nth p 3))
           (lib (dlm-append (e93-lib s) (list b))))
      (and ep (e93-library? lib) (e93-cells? (list (dlm-nth p 2)) (dlm-nth ep 3))
        (= (dlm-nth b 2) (dlm-nth ep 3))
        (not (e93-known-expansion? (dlm-nth b 4) (dlm-nth b 2) (e93-lib s)))
        (let ((rows (e93-cell-rows (dlm-nth ep 4) (dlm-nth p 2))))
          (and (>= (dlm-length rows) 3) (dlm-proper? (dlm-nth p 4) 12)
            (e93-check-values (dlm-nth b 4) rows (dlm-nth p 4) (dlm-nth s 2) 1000)))
        (equal (dlm-nth p 5) (e93-build-views (dlm-nth s 3) lib (dlm-nth s 2)))
        (e93-covered? (dlm-nth p 5) (dlm-nth p 1) (dlm-nth p 2))))))

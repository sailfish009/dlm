;;; Independent semantic gate. It never calls propose, cover, plan or execution.
;;; Trusted law: existential binary relation composition is associative.
;;; Equal expanded primitive words certify this restricted grammar, not arbitrary
;;; FOL or real-world truth. Prefix checking prohibits cyclic/forward definitions.
(define-function b90-equivalent? (old new sig lib cert)
  (and (sq-shape? cert 2) (= (car cert) 'same-word90)
       (let ((a (b90-word old sig lib 16)) (b (b90-word new sig lib 16)))
         (and a b (equal a b) (equal a (dlm-nth cert 1))))))
(define-function b90-check-learn (s module rewrites)
  (let* ((sig (dlm-nth s 2)) (lib (dlm-append (dlm-nth s 4) (list module)))
         (tasks (dlm-nth s 5)) (next ()) (ok true) (uses 0))
    (if (not (and (b90-library? lib sig) (sq-shape? (dlm-nth module 2) 3)
                  (= (car (dlm-nth module 2)) 'join90)
                  (>= (b90-support (dlm-nth module 2) tasks) 2)
                  (dlm-proper? rewrites 16) (= (dlm-length tasks) (dlm-length rewrites))))
      '(rejected90 basis-or-support)
      (begin
        (list-do t tasks
          (let ((r (car rewrites)))
            (if (and (sq-shape? r 5) (= (car r) 'rewrite90) (equal (dlm-nth r 1) (dlm-nth t 1))
                     (equal (dlm-nth r 2) (dlm-nth t 3))
                     (b90-equivalent? (dlm-nth r 2) (dlm-nth r 3) sig lib (dlm-nth r 4)))
              (set next (dlm-append next (list (s79-field t 3 (dlm-nth r 3)))))
              (set ok false)))
          (set rewrites (cdr rewrites)))
        (if ok (list-do t next (set uses (+ uses (b90-use-count (dlm-nth t 3) (dlm-nth module 1))))))
        (if (and ok (>= uses 2) (< (b90-work-size next) (b90-work-size tasks)))
          (list 'checked90 lib next) '(rejected90 rewrite-or-no-replacement))))))
;;; The audit is separate from the executable core. Each transition is staged.
(define-function b90-apply (s event)
  (if (or (not (and (pair? event) (dlm-proper? event 3))) (>= (dlm-length (dlm-nth s 6)) 64))
    '(rejected90 event-or-capacity)
    (let ((op (car event)) (sig (dlm-nth s 2)) (next s) (valid false))
      (cond
        ((and (= op 'observe90) (sq-shape? event 3) (b90-name? (dlm-nth event 1))
              (< (dlm-length (dlm-nth s 3)) 4) (not (b90-find (dlm-nth s 3) (dlm-nth event 1)))
              (b90-facts? (dlm-nth event 2) sig))
          (set next (s79-field s 3 (dlm-append (dlm-nth s 3)
            (list (list 'episode90 (dlm-nth event 1) (dlm-nth event 2)))))) (set valid true))
        ((and (= op 'retract90) (sq-shape? event 2) (b90-name? (dlm-nth event 1))
              (b90-find (dlm-nth s 3) (dlm-nth event 1)))
          (let ((eps ())) (list-do ep (dlm-nth s 3)
            (if (not (equal (dlm-nth ep 1) (dlm-nth event 1))) (set eps (dlm-append eps (list ep)))))
            (set next (s79-field s 3 eps))) (set valid true))
        ((and (= op 'task90) (sq-shape? event 3) (b90-name? (dlm-nth event 1))
              (< (dlm-length (dlm-nth s 5)) 16) (not (b90-find (dlm-nth s 5) (dlm-nth event 1)))
              (b90-word (dlm-nth event 2) sig () 8))
          (set next (s79-field s 5 (dlm-append (dlm-nth s 5) (list (list 'task90
            (dlm-nth event 1) (dlm-nth event 2) (b90-plan (dlm-nth event 2) sig (dlm-nth s 4)))))))
          (set valid true))
        ((and (= op 'learn90) (sq-shape? event 3))
          (let ((checked (b90-check-learn s (dlm-nth event 1) (dlm-nth event 2))))
            (if (= (car checked) 'checked90)
              (begin (set next (s79-field (s79-field (s79-field s 4 (dlm-nth checked 1))
                                5 (dlm-nth checked 2)) 7 (+ (dlm-nth s 7) 1))) (set valid true))))))
      ;; Routing is a proposal too: even initial task plans must pass word checks.
      (if (and valid (b90-core? (b90-core next)))
        (s79-field next 6 (dlm-append (dlm-nth s 6) (list event))) '(rejected90 transition)))))
(define-function b90-replay (sig events)
  (if (not (and (b90-signature? sig) (dlm-proper? events 64))) '(rejected90 audit)
    (let ((s (b90-new sig)))
      (list-do e events (if (not (= (car s) 'rejected90)) (set s (b90-apply s e)))) s)))

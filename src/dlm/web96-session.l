;;; Source admission/retraction lives in the SAME Basis91 transition/audit/core.
;;; No web learner, library, checkpoint owner, or global web model exists.
(define-function w96-source (s)
  (if (not (sq-shape? s 9)) ()
    (let ((f (dlm-nth s 8))) (if (and (sq-shape? f 6) (sq-shape? (dlm-nth f 5) 4) (= (car (dlm-nth f 5)) 'web96)) (dlm-nth f 5) ()))))
(define-function w96-token (s)
  (let ((source (w96-source s)))
    (if source (list 'source-token96 (dlm-nth (dlm-nth source 1) 2) (dlm-nth (dlm-nth source 1) 4) (dlm-nth source 2) (dlm-nth source 3)) 'missing96)))
(define-function w96-bindings (p)
  (let ((out ())) (list-do v (list (dlm-nth (dlm-nth p 7) 2) (dlm-nth (dlm-nth p 7) 3))
    (set out (dlm-append out (list (list 'binding96 (dlm-nth v 1) (dlm-nth v 2) (dlm-nth v 3) (dlm-nth v 5)))))) out))
(define-function w96-project (s)
  (let* ((source (w96-source s)) (p (dlm-nth source 1)))
    (list 'web-core96 (dlm-nth p 1) (dlm-nth p 2) (dlm-nth p 3) (dlm-nth p 4) (dlm-nth p 5)
      (dlm-nth source 2) (dlm-nth source 3) (w96-bindings p) (dlm-nth (dlm-nth p 7) 5))))
(define-function w96-proof? (p fno level numbers)
  (let ((i (- fno (* (/ fno level) level))))
    (and (sq-shape? p 11) (= (car p) 'edge96) (equal (dlm-nth p 1) fno)
      (equal (dlm-nth p 2) (dlm-nth numbers (/ fno level)))
      (e93-int? (dlm-nth p 3) 0 262144) (e93-int? (dlm-nth p 4) 1 262144) (< (dlm-nth p 3) (dlm-nth p 4))
      (equal (dlm-nth p 5) (dlm-nth *w96-fields* i)) (equal (dlm-nth p 8) (dlm-nth *w96-fields* (+ i 1)))
      (e93-int? (dlm-nth p 6) (dlm-nth p 3) (dlm-nth p 4))
      (e93-int? (dlm-nth p 7) (dlm-nth p 6) (dlm-nth p 4))
      (e93-int? (dlm-nth p 9) (dlm-nth p 3) (dlm-nth p 4))
      (e93-int? (dlm-nth p 10) (dlm-nth p 9) (dlm-nth p 4)))))
(define-function w96-binding? (binding i)
  (and (sq-shape? binding 5) (= (car binding) 'binding96)
    (equal (dlm-nth binding 1) (if (= i 0) "web-train96" "web-next96"))
    (equal (dlm-nth binding 2) (if (= i 0) 2 3)) (sq-shape? (dlm-nth binding 3) 2)
    (e93-int? (car (dlm-nth binding 3)) 1 511) (e93-int? (dlm-nth (dlm-nth binding 3) 1) 1 511)
    (not (equal (car (dlm-nth binding 3)) (dlm-nth (dlm-nth binding 3) 1)))
    (sq-shape? (dlm-nth binding 4) (* 2 (dlm-nth binding 2)))
    (let ((ok true) (fno 0)) (list-do proof (dlm-nth binding 4)
      (if (not (w96-proof? proof fno (dlm-nth binding 2) (dlm-nth binding 3))) (set ok false)) (set fno (+ fno 1))) ok)))
(define-function w96-core? (x)
  (and (sq-shape? x 10) (= (car x) 'web-core96) (equal (dlm-nth x 1) "country-codes96")
    (w96-url? (dlm-nth x 2)) (string? (dlm-nth x 3)) (= (string-length (dlm-nth x 3)) 20)
    (w96-hex? (dlm-nth x 4) 64) (= (dlm-nth x 5) 'm49-csv96) (e93-int? (dlm-nth x 6) 1 32)
    (or (equal (dlm-nth x 7) true) (not (dlm-nth x 7)))
    (sq-shape? (dlm-nth x 8) 2) (dlm-proper? (dlm-nth x 9) 512)
    (let ((ok true) (i 0)) (list-do binding (dlm-nth x 8)
      (if (not (w96-binding? binding i)) (set ok false)) (set i (+ i 1)))
      (list-do row (dlm-nth x 9)
        (if (not (and (sq-shape? row 5) (= (car row) 'unresolved96) (e93-int? (dlm-nth row 1) 1 511)
          (e93-int? (dlm-nth row 2) 0 262144) (e93-int? (dlm-nth row 3) 1 262144) (< (dlm-nth row 2) (dlm-nth row 3))
          (dlm-nth row 4) (dlm-proper? (dlm-nth row 4) 4) (not (dlm-difference (dlm-nth row 4) *w96-fields*)))) (set ok false))) ok)))
(define-function w96-state? (s)
  (let* ((source (w96-source s)) (p (dlm-nth source 1)) (ok true))
    (and (sq-shape? source 4) (= (car source) 'web96) (w96-packet? p)
      (e93-int? (dlm-nth source 2) 1 32) (or (equal (dlm-nth source 3) true) (not (dlm-nth source 3)))
      (begin
        (list-do view (list (dlm-nth (dlm-nth p 7) 2) (dlm-nth (dlm-nth p 7) 3))
          (let ((ep (b91-find (dlm-nth s 3) (dlm-nth view 1))))
            (if (dlm-nth source 3)
              (if (not (and ep (= (dlm-nth ep 2) (dlm-nth source 2)) (equal (dlm-nth ep 3) (dlm-nth view 4)))) (set ok false))
              (if ep (set ok false))))) ok))))
(define-function w96-managed? (id) (or (equal id "web-train96") (equal id "web-next96")))
(define-function w96-event-guard (s event)
  (not (and (w96-source s) (dlm-member? (car event) '(observe91 retract91)) (w96-managed? (dlm-nth event 1)))))
(define-function w96-remove-views (s)
  (let ((eps ()) (readings ()))
    (list-do ep (dlm-nth s 3) (if (not (w96-managed? (dlm-nth ep 1))) (set eps (dlm-append eps (list ep)))))
    (list-do v (dlm-nth s 5) (if (not (w96-managed? (dlm-nth v 1))) (set readings (dlm-append readings (list v)))))
    (s79-field (s79-field s 3 eps) 5 readings)))
(define-function w96-step (s event)
  (let* ((op (car event)) (source (w96-source s)) (current (w96-token s))
         (version (+ 1 (dlm-length (dlm-nth s 6)))) (next ()))
    (cond
      ((and (= op 'web-import96) (sq-shape? event 3) (equal (dlm-nth event 2) current)
            (not (dlm-difference *w96-predicates* (dlm-nth s 2))) (w96-packet? (dlm-nth event 1))
            (or source (and (not (b91-find (dlm-nth s 3) "web-train96")) (not (b91-find (dlm-nth s 3) "web-next96")))))
        (let* ((p (dlm-nth event 1)) (clean (w96-remove-views s)) (f (dlm-nth clean 8)) (eps (dlm-nth clean 3)))
          (if (not f) (begin (set f '(typed95 principal93 () () ())) (set clean (dlm-append (s79-field clean 1 2) (list f)))))
          (list-do view (list (dlm-nth (dlm-nth p 7) 2) (dlm-nth (dlm-nth p 7) 3))
            (set eps (dlm-append eps (list (list 'episode91 (dlm-nth view 1) version (dlm-nth view 4) false)))))
          (if (<= (dlm-length eps) 4)
            (let ((facet (if (sq-shape? f 5) (dlm-append f (list (list 'web96 p version true))) (s79-field f 5 (list 'web96 p version true)))))
              (set next (s79-field (s79-field clean 3 eps) 8 facet))))))
      ((and (= op 'web-retract96) (sq-shape? event 2) source (dlm-nth source 3) (equal (dlm-nth event 1) current))
        (set next (w96-remove-views s))
        (set next (s79-field next 8 (s79-field (dlm-nth next 8) 5 (s79-field source 3 false))))))
    (if (and next (w96-state? next)) next '(rejected96 source-transition))))
(define-function w96-core-source (model)
  (if (not (sq-shape? model 7)) ()
    (let ((facet (dlm-nth model 6))) (if (and (sq-shape? facet 4) (sq-shape? (dlm-nth facet 3) 10) (= (car (dlm-nth facet 3)) 'web-core96)) (dlm-nth facet 3) ()))))
(define-function w96-find-view (p id)
  (let ((out ())) (list-do v (dlm-append (list (dlm-nth (dlm-nth p 7) 2) (dlm-nth (dlm-nth p 7) 3)) (dlm-nth (dlm-nth p 7) 4))
    (if (equal (dlm-nth v 1) id) (set out v))) out))
(define-function w96-infer (model p id pattern fuel policy)
  (let ((source (w96-core-source model)))
    (cond
      ((not (b91-model? model)) '(rejected96 model))
      ((not source) '(web-answer96 unknown missing-source ()))
      ((not (dlm-nth source 7)) '(web-answer96 unknown inactive-source ()))
      ((not (w96-packet? p)) '(rejected96 independent-extraction-check))
      ((not (and (equal (dlm-nth p 4) (dlm-nth source 4)) (equal (dlm-nth p 2) (dlm-nth source 2)))) '(web-answer96 unknown source-version ()))
      ((not (and (b91-pattern? pattern (dlm-nth model 1)) (b91-fuel? fuel)
             (or (= policy 'raw96) (a92-policy? policy)))) '(rejected96 query-input))
      (else
        (let ((view (w96-find-view p id)))
          (if (not view) '(web-answer96 unknown unresolved-source-row ())
            (let* ((ep (list 'episode91 id (dlm-nth source 6) (dlm-nth view 4) false))
                   (m (s79-field (s79-field model 2 (list ep)) 4 ()))
                   (answer (if (= policy 'raw96) (b91-infer m id pattern fuel 'raw) (a92-query m id pattern policy fuel))))
              (if (not (= (dlm-nth answer 1) 'complete)) '(web-answer96 unknown incomplete-worker ())
                (list 'web-answer96 'complete 'source-claims96 (dlm-nth answer 3)
                  (list 'source-scope96 (dlm-nth source 1) (dlm-nth source 6) (dlm-nth source 4) 'm49-csv96 id
                    (dlm-nth view 3) (dlm-nth view 5)) (dlm-nth answer 4))))))))))
(define-function w96-command (args)
  (let* ((op (car args)) (xs (cdr args)) (n (dlm-length xs)) (s *b91-state*) (source (and s (w96-source s))))
    (cond
      ((and (= op 'web-infer) (= n 6)) (w96-infer (car xs) (dlm-nth xs 1) (dlm-nth xs 2) (dlm-nth xs 3) (dlm-nth xs 4) (dlm-nth xs 5)))
      ((and s (= op 'web-source) (= n 0)) (if source (w96-project s) '(web-source96 missing96)))
      ((and s (= op 'web-token) (= n 0)) (w96-token s))
      ((and s (= op 'web-import) (= n 2))
        (if (and source (dlm-nth source 3) (equal (dlm-nth xs 1) (w96-token s))
                 (w96-packet? (car xs)) (equal (dlm-nth (car xs) 4) (dlm-nth (dlm-nth source 1) 4))
                 (equal (dlm-nth (car xs) 2) (dlm-nth (dlm-nth source 1) 2))) '(unchanged96 content)
          (b91-commit (list 'web-import96 (car xs) (dlm-nth xs 1)))))
      ((and s (= op 'web-retract) (= n 1)) (b91-commit (list 'web-retract96 (car xs))))
      ((and source (= op 'web-query) (= n 4)) (w96-infer (b91-model s) (dlm-nth source 1) (car xs) (dlm-nth xs 1) (dlm-nth xs 2) (dlm-nth xs 3)))
      (else '(rejected96 command-or-arity)))))
(set *c95-source-state-check* w96-state?)
(set *c95-source-core-check* w96-core?)
(set *c95-source-project* w96-project)
(set *c95-source-step* w96-step)
(set *c95-source-command* w96-command)
(set *b91-source-event-guard* w96-event-guard)

;;; Immutable transitions, replay admission, shared native file/lock primitives.
(define-function e93-step (s cmd)
  (if (not (and (dlm-proper? cmd 5) cmd (< (dlm-length (dlm-nth s 6)) 32))) '(rejected93 command-capacity)
    (let ((op (car cmd)) (episodes (dlm-nth s 3)) (lib (e93-lib s)) (next ()))
      (cond
        ((and (= op 'observe93) (sq-shape? cmd 4) (sq-name? (dlm-nth cmd 1))
              (e93-arity? (dlm-nth cmd 2)) (e93-rows? (dlm-nth cmd 3) (dlm-nth cmd 2)))
          (let* ((id (dlm-nth cmd 1)) (old (e93-find episodes id)) (out ())
                 (ep (list 'episode93 id (if old (+ 1 (dlm-nth old 2)) 1) (dlm-nth cmd 2) (dlm-nth cmd 3))))
            (if (or old (< (dlm-length episodes) 6))
              (begin (list-do e episodes (set out (dlm-append out (list (if (equal (dlm-nth e 1) id) ep e)))))
                (if (not old) (set out (dlm-append out (list ep))))
                (set next (s79-field s 3 out))))))
        ((and (= op 'retract93) (sq-shape? cmd 2) (e93-find episodes (dlm-nth cmd 1)))
          (let ((out ())) (list-do ep episodes
            (if (not (equal (dlm-nth ep 1) (dlm-nth cmd 1))) (set out (dlm-append out (list ep)))))
            (set next (s79-field s 3 out))))
        ((and (= op 'learn93) (sq-shape? cmd 4) (sq-name? (dlm-nth cmd 1))
              (e93-int? (dlm-nth cmd 2) 1 3) (b91-fuel? (dlm-nth cmd 3)))
          (let ((p (e93-propose s (dlm-nth cmd 1) (dlm-nth cmd 2) (dlm-nth cmd 3))))
            (if (not (= (car p) 'learn93)) (set next p)
              (if (e93-check-learn s p) (set next (s79-field s 4 (dlm-append lib (list (dlm-nth p 3)))))
                (set next '(rejected93 independent-admission)))))))
      (if (not next) '(rejected93 command)
        (if (not (= (car next) 'eml-state93)) next
          (begin
            (set next (s79-field next 5 (e93-build-views (dlm-nth next 3) (e93-lib next) (dlm-nth next 2))))
            (set next (s79-field next 6 (dlm-append (dlm-nth s 6) (list cmd))))
            (s79-field next 7 (+ 1 (dlm-nth s 7)))))))))
(define-function e93-pack (s) (list 'eml-session93 1 (dlm-nth s 2) (e93-core s) (dlm-nth s 6)))
(define-function e93-replay (branch events)
  (if (not (and (e93-branch? branch) (dlm-proper? events 32))) '(rejected93 snapshot)
    (let ((s (e93-new branch)))
      (list-do cmd events (if (= (car s) 'eml-state93) (set s (e93-step s cmd)))) s)))
(define-function e93-snapshot? (x)
  (and (sq-shape? x 5) (= (car x) 'eml-session93) (= (dlm-nth x 1) 1)
    (e93-branch? (dlm-nth x 2)) (e93-core? (dlm-nth x 3)) (dlm-proper? (dlm-nth x 4) 32)
    (let ((s (e93-replay (dlm-nth x 2) (dlm-nth x 4))))
      (and (= (car s) 'eml-state93) (equal (e93-core s) (dlm-nth x 3))))))
(define-function e93-checkpoint (path snapshot expected)
  (if (not (and (e93-snapshot? snapshot) (equal (e79-raw-read path) expected))) false
    (let ((tmp (concat-strings path ".next")) (ok true))
      (set ok (and (d77-write tmp snapshot) (equal (e79-raw-read tmp) (list 'data snapshot))))
      (if (and ok (= (car expected) 'data))
        (let ((prior (concat-strings path ".previous.next")))
          (set ok (and (d77-write prior (dlm-nth expected 1)) (equal (e79-raw-read prior) expected)
            (file-replace prior (concat-strings path ".previous"))))))
      (if ok (set ok (and (equal (e79-raw-read path) expected) (file-replace tmp path))))
      (if (not ok) (file-remove tmp)) ok)))
(define *e93-state* ())
(define *e93-path* ())
(define *e93-lock* ())
(define *e93-expected* '(missing))
(define-function e93-summary ()
  (if (not *e93-state*) '(eml93 not-started)
    (list 'eml93 'branch (dlm-nth *e93-state* 2) 'bases (dlm-length (e93-lib *e93-state*))
      'active-scopes (dlm-length (dlm-nth *e93-state* 5)) 'epoch (dlm-nth *e93-state* 7) 'store *e93-path*)))
(define-function e93-commit (cmd)
  (if (not *e93-state*) '(rejected93 init-first)
    (let ((next (e93-step *e93-state* cmd)))
      (if (not (= (car next) 'eml-state93)) next
        (if (and *e93-path* (not (e93-checkpoint *e93-path* (e93-pack next) *e93-expected*)))
          '(rejected93 checkpoint)
          (begin (set *e93-state* next)
            (if *e93-path* (set *e93-expected* (list 'data (e93-pack next)))) (e93-summary)))))))
(define-function e93-save ()
  (if (not (and *e93-path* *e93-state*)) '(rejected93 not-attached)
    (let ((snapshot (e93-pack *e93-state*)))
      (if (e93-checkpoint *e93-path* snapshot *e93-expected*)
        (begin (set *e93-expected* (list 'data snapshot)) '(saved93)) '(rejected93 checkpoint)))))
(define-function e93-open (path)
  (if (not (and (string? path) (not (equal path "")) (not *e93-path*))) '(rejected93 path-or-close-first)
    (let ((lock (file-lock (concat-strings path ".lock"))))
      (if (not lock) '(rejected93 locked-or-path)
        (let ((old (e79-raw-read path)) (incoming ()) (ok true))
          (cond ((and (= (car old) 'missing) *e93-state*) (set incoming *e93-state*))
            ((and (= (car old) 'data) (e93-snapshot? (dlm-nth old 1)))
              (set incoming (e93-replay (dlm-nth (dlm-nth old 1) 2) (dlm-nth (dlm-nth old 1) 4)))
              (if (and *e93-state* (not (equal incoming *e93-state*))) (set ok false)))
            (else (set ok false)))
          (if (not ok) (begin (file-close lock) '(rejected93 snapshot-or-init-first))
            (begin (set *e93-state* incoming) (set *e93-lock* lock) (set *e93-path* path)
              (set *e93-expected* old) (e93-summary))))))))
(define-function e93-close ()
  (if (not *e93-path*) '(closed93)
    (let ((r (e93-save))) (if (not (= (car r) 'saved93)) r
      (begin (file-close *e93-lock*) (set *e93-lock* ()) (set *e93-path* ())
        (set *e93-expected* '(missing)) '(closed93))))))
(define-function eml93 args
  (let ((op (car args)) (xs (cdr args)) (n (dlm-length (cdr args))))
    (cond
      ((and (= op 'init) (= n 1) (e93-branch? (car xs)) (not *e93-path*))
        (set *e93-state* (e93-new (car xs))) (e93-summary))
      ((and (= op 'reset) (= n 0) (not *e93-path*)) (set *e93-state* ()) '(reset93))
      ((and (= op 'infer) (= n 4)) (e93-infer (car xs) (dlm-nth xs 1) (dlm-nth xs 2) (dlm-nth xs 3)))
      ((and (= op 'restore) (= n 1) (not *e93-path*) (e93-snapshot? (car xs)))
        (set *e93-state* (e93-replay (dlm-nth (car xs) 2) (dlm-nth (car xs) 4))) (e93-summary))
      ((and (= op 'open) (= n 1)) (e93-open (car xs)))
      ((and (= op 'save) (= n 0)) (e93-save))
      ((and (= op 'close) (= n 0)) (e93-close))
      ((and (= op 'status) (= n 0)) (e93-summary))
      ((and *e93-state* (= op 'observe) (= n 3))
        (e93-commit (list 'observe93 (car xs) (dlm-nth xs 1) (dlm-nth xs 2))))
      ((and *e93-state* (= op 'learn) (= n 3))
        (e93-commit (list 'learn93 (car xs) (dlm-nth xs 1) (dlm-nth xs 2))))
      ((and *e93-state* (= op 'retract) (= n 1)) (e93-commit (list 'retract93 (car xs))))
      ((and *e93-state* (= op 'proposal) (= n 3) (sq-name? (car xs))
            (e93-int? (dlm-nth xs 1) 1 3) (b91-fuel? (dlm-nth xs 2)))
        (e93-propose *e93-state* (car xs) (dlm-nth xs 1) (dlm-nth xs 2)))
      ((and *e93-state* (= op 'coverage) (= n 1)) (e93-residual *e93-state* (car xs)))
      ((and *e93-state* (= op 'model) (= n 0)) (e93-core *e93-state*))
      ((and *e93-state* (= op 'state) (= n 0)) *e93-state*)
      ((and *e93-state* (= op 'snapshot) (= n 0)) (e93-pack *e93-state*))
      ((and *e93-state* (= op 'query) (= n 3))
        (e93-infer (e93-core *e93-state*) (car xs) (dlm-nth xs 1) (dlm-nth xs 2)))
      (else '(rejected93 command-or-arity)))))

;;; assemble.l — minimal fragment combination into templates/programs.
(define-function a-union-atoms (atoms)
  (let ((out ()) (keys ()))
    (list-do a atoms
      (let ((k (l-atom-key a)))
        (if (not (l-member? k keys))
          (begin (set keys (l-append keys (list k)))
                 (set out (l-append out (list a)))))))
    out))
(define-function a-template (id head body) (list 'template id head body))
(define-function a-template? (x)
  (and (l-shape? x 4) (equal (car x) 'template) (l-name? (l-nth x 1))
       (l-atom? (l-nth x 2)) (l-list? (l-nth x 3))))
(define-function a-template-id (x) (l-nth x 1))
(define-function a-template-head (x) (l-nth x 2))
(define-function a-template-body (x) (l-nth x 3))
(define-function a-combine (id f1 f2)
  (a-template id (f-head f1)
    (a-union-atoms (l-append (f-body f1) (f-body f2)))))
(define-function a-map-pred (a mp)
  (let ((h (l-assoc (l-pred a) mp)))
    (if h (l-atom (l-nth h 1) (l-args a)) a)))
(define-function a-instantiate-rule (r mp)
  (l-rule (a-map-pred (l-head r) mp)
          (l-map (lambda (a) (a-map-pred a mp)) (l-body r))))
(define-function a-template-rule (t mp)
  (a-instantiate-rule (l-rule (a-template-head t) (a-template-body t)) mp))
(define-function a-program (id rules) (list 'program id rules))
(define-function a-program? (x)
  (and (l-shape? x 3) (equal (car x) 'program) (l-name? (l-nth x 1))
       (l-list? (l-nth x 2))
       (not (l-any? (lambda (r) (not (l-rule? r))) (l-nth x 2)))))
(define-function a-program-id (x) (l-nth x 1))
(define-function a-program-rules (x) (l-nth x 2))
(define-function a-program-from-templates (id templates)
  (a-program id
    (l-map (lambda (t) (l-rule (a-template-head t) (a-template-body t))) templates)))

;;; -*- mode: lisp; coding: us-ascii -*-
;;; Small native definition space. A definition is a conservative new binary
;;; relation, NOT an empirical law or a new observation. Search is label-free.
;;; (axiom-space77 1 EPISODES DEFINITIONS), (episode77 ID FACTS),
;;; (definition77 NAME PRIMITIVE-PATH (compose LEFT RIGHT)).
(define-function a77-new () (list 'axiom-space77 1 () ()))
(define-function a77-defs (s) (dlm-nth s 3))
(define-function a77-episodes (s) (dlm-nth s 2))
(define-function a77-name? (x) (or (symbol? x) (string? x)))
(define-function a77-fact? (a)
  (and (dlm-atom? a) (= (dlm-length (dlm-args a)) 2) (dlm-ground? a)))
(define-function a77-bases (episodes)
  (let ((out ())) (list-do e episodes (list-do f (dlm-nth e 2)
    (set out (dlm-add out (dlm-pred f))))) out))
(define-function a77-find (name defs)
  (if defs (if (equal name (dlm-nth (car defs) 1)) (car defs)
             (a77-find name (cdr defs))) ()))
(define-function a77-word (name defs)
  (let ((d (a77-find name defs))) (if d (dlm-nth d 2) (list name))))
(define-function a77-words (defs)
  (let ((out ())) (list-do d defs (set out (cons (dlm-nth d 2) out))) out))
(define-function a77-rule (d)
  (let ((x (dlm-var 'x)) (y (dlm-var 'y)) (z (dlm-var 'z)) (op (dlm-nth d 3)))
    (dlm-rule (dlm-atom (dlm-nth d 1) x z)
              (dlm-atom (dlm-nth op 1) x y) (dlm-atom (dlm-nth op 2) y z))))
(define-function a77-rules (s)
  (let ((out ())) (list-do d (a77-defs s) (set out (dlm-append out (list (a77-rule d))))) out))
(define-function a77-valid? (s)
  (and (sq-shape? s 4) (= (car s) 'axiom-space77) (= (dlm-nth s 1) 1)
       (dlm-proper? (a77-episodes s) 8) (dlm-proper? (a77-defs s) 12)
    (let ((ok true) (ids ()) (prior ()) (bases ()))
      (list-do e (a77-episodes s)
        (if (and (sq-shape? e 3) (= (car e) 'episode77) (a77-name? (dlm-nth e 1))
                 (not (dlm-member? (dlm-nth e 1) ids)) (dlm-proper? (dlm-nth e 2) 24))
            (begin (set ids (cons (dlm-nth e 1) ids))
              (list-do f (dlm-nth e 2) (if (not (a77-fact? f)) (set ok false))))
          (set ok false)))
      (if ok
          (begin (set bases (a77-bases (a77-episodes s)))
            (list-do d (a77-defs s)
              (if (and (sq-shape? d 4) (= (car d) 'definition77) (a77-name? (dlm-nth d 1))
                  (not (dlm-member? (dlm-nth d 1) bases)) (not (a77-find (dlm-nth d 1) prior))
                  (dlm-proper? (dlm-nth d 2) 4) (>= (dlm-length (dlm-nth d 2)) 2)
                  (not (dlm-member? (dlm-nth d 2) (a77-words prior)))
                  (sq-shape? (dlm-nth d 3) 3) (= (car (dlm-nth d 3)) 'compose))
                  (let* ((op (dlm-nth d 3)) (l (dlm-nth op 1)) (r (dlm-nth op 2)))
                    ;; Old definitions remain useful after their evidence is retracted.
                    ;; Primitive names are retained in the stored path itself.
                    (if (and (a77-name? l) (a77-name? r)
                             (not (equal l (dlm-nth d 1))) (not (equal r (dlm-nth d 1)))
                             (equal (dlm-nth d 2) (dlm-append (a77-word l prior) (a77-word r prior))))
                        (set prior (dlm-append prior (list d))) (set ok false)))
                (set ok false)))))
      (if ok (list-do d prior (list-do name (dlm-nth d 2)
        (if (or (not (a77-name? name)) (a77-find name prior)) (set ok false))))) ok)))
(define-function a77-observe (s id facts)
  (let ((e (list 'episode77 id facts)) (old ()))
    (list-do p (a77-episodes s) (if (equal id (dlm-nth p 1)) (set old p)))
    (if old (if (equal old e) (list 'observed s) (list 'rejected 'identity-conflict))
      (let ((next (list 'axiom-space77 1 (dlm-append (a77-episodes s) (list e)) (a77-defs s))))
        (if (a77-valid? next) (list 'observed next) (list 'rejected 'schema-or-limit))))))
(define-function a77-retract (s id)
  (let ((eps ())) (list-do e (a77-episodes s)
    (if (not (equal id (dlm-nth e 1))) (set eps (dlm-append eps (list e)))))
    (list 'axiom-space77 1 eps (a77-defs s))))
(define-function a77-close (s facts)
  (dlm-derive-result (dlm-seed-proofs facts) (a77-rules s) 8))
(define-function a77-fresh (s)
  (let ((n 0) (name ()) (used (a77-bases (a77-episodes s))))
    (list-do d (a77-defs s)
      (set used (dlm-union (cons (dlm-nth d 1) used) (dlm-nth d 2))))
    (set name (concat-strings "c77-" (number->string n)))
    (while (dlm-member? name used)
      (set n (+ n 1)) (set name (concat-strings "c77-" (number->string n)))) name))
;;; Independent reference semantics: flatten to primitive path, then relational
;;; joins over ONLY the original episode, not the derived candidate closure.
(define-function a77-path (word facts)
  (if (not word) ()
    (let ((pairs ()))
      (list-do f facts (if (equal (dlm-pred f) (car word))
        (set pairs (dlm-add pairs (dlm-args f)))))
      (let ((tail (cdr word)))
        (while tail
          (let ((next ()))
            (list-do p pairs (list-do f facts
              (if (and (equal (dlm-pred f) (car tail)) (equal (dlm-nth p 1) (car (dlm-args f))))
                  (set next (dlm-add next (list (car p) (dlm-nth (dlm-args f) 1)))))))
            (set pairs next)) (set tail (cdr tail)))) pairs)))
;;; Optional instrumentation counts inspected closure-proof entries, not time.
(define a84-work ())
(define-function a77-certify (s d)
  (let ((next (list 'axiom-space77 1 (a77-episodes s) (dlm-append (a77-defs s) (list d))))
        (hits 0) (ok true))
    (if (not (a77-valid? next)) (list 'rejected 'definition-schema)
      (begin
        (list-do e (a77-episodes s)
          (let* ((facts (dlm-nth e 2)) (reference (a77-path (dlm-nth d 2) facts))
                 (result (a77-close next facts)) (actual ()))
            (if a84-work (a84-work (+ 1 (dlm-length (dlm-nth result 2)))))
            (if (not (= (dlm-nth result 1) 'complete)) (set ok false))
            (list-do p (dlm-nth result 2)
              (if (equal (dlm-pred (dlm-conclusion p)) (dlm-nth d 1))
                  (begin (set actual (dlm-add actual (dlm-args (dlm-conclusion p))))
                    (if (not (dlm-verify-proof p facts (a77-rules next))) (set ok false)))))
            (if (or (dlm-difference actual reference) (dlm-difference reference actual)) (set ok false))
            (set hits (+ hits (dlm-length reference)))))
        (if (and ok (>= hits 2)) (list 'learned next d hits)
          (list 'rejected (if ok 'insufficient-reuse 'verification)))))))
;;; One admission per step. Pair budget is NOT a primitive or wall-clock bound.
;;; Cursor resumes candidate enumeration; reset it after any semantic change.
;;; Optional ordering callback; it must return a permutation, never new facts.
(define a83-order ())
(define-function a77-search-facts (s facts)
  (if (not a83-order) facts
    (let ((ordered (a83-order s facts)))
      (if (and (dlm-proper? ordered 1000) (= (dlm-length ordered) (dlm-length facts))
               (not (dlm-difference ordered facts)) (not (dlm-difference facts ordered)))
          ordered facts))))
(define-function a77-step (s offset budget)
  (if (not (and (a77-valid? s) (is <long> offset) (>= offset 0)
                (is <long> budget) (> budget 0) (<= budget 1000)))
      (list 'invalid-input s 0 0)
    (if (>= (dlm-length (a77-defs s)) 12) (list 'capacity s 0 0)
      (let ((cursor 0) (checks 0) (answer ()) (candidate-keys ()) (complete true))
        (list-do e (a77-episodes s)
          (if (not answer)
              (let* ((closure (a77-close s (dlm-nth e 2)))
                     (facts (a77-search-facts s (dlm-conclusions (dlm-nth closure 2)))))
                (if (not (= (dlm-nth closure 1) 'complete)) (set complete false))
                (list-do left facts (list-do right facts
                  (if (and (not answer) (>= cursor offset))
                      (if (>= checks budget) (set answer (list 'incomplete s cursor checks))
                        (begin (set checks (+ checks 1))
                          (if (equal (dlm-nth (dlm-args left) 1) (car (dlm-args right)))
                              (let ((word (dlm-append (a77-word (dlm-pred left) (a77-defs s))
                                                     (a77-word (dlm-pred right) (a77-defs s)))))
                                (if (and (<= (dlm-length word) 4) (not (dlm-member? word (a77-words (a77-defs s))))
                                         (not (dlm-member? word candidate-keys)))
                                    (begin (set candidate-keys (cons word candidate-keys))
                                      (let ((trial (a77-certify s (list 'definition77 (a77-fresh s) word
                                                        (list 'compose (dlm-pred left) (dlm-pred right))))))
                                        (if (= (car trial) 'learned)
                                            (set answer (list 'learned (dlm-nth trial 1) 0 checks
                                                             (dlm-nth trial 2) (dlm-nth trial 3))))))))))))
                  (set cursor (+ cursor 1)))))))
        (or answer (list (if complete 'saturated 'incomplete) s 0 checks))))))
(define-function a77-query (s episode goal)
  (if (not (and (a77-valid? s) (a77-fact? goal))) (list 'invalid-input)
    (let ((found ()))
      (list-do e (a77-episodes s) (if (equal episode (dlm-nth e 1)) (set found e)))
      (if (not found) (list 'unknown-episode)
        (let* ((result (a77-close s (dlm-nth found 2)))
               (proof (dlm-find-proof goal (dlm-nth result 2))))
          (if proof
              (if (dlm-verify-proof proof (dlm-nth found 2) (a77-rules s)) (list 'proved proof) (list 'invalid-proof))
            (list (if (= (dlm-nth result 1) 'complete) 'not-derived 'incomplete))))))))

;;; Scoped worker: only fetches facts whose ORIGINAL IDs are in the current view.
;;; No partial answer cache; only independently committed binding workspaces live
;;; across scope transitions. Index metadata is immutable for this context.
;;; worker92: fuel used reads attempts calls call-ids.
(define-function a92-worker (fuel) (list 'worker92 fuel 0 0 0 0 ()))
(define-function a92-worker-spend (r)
  (s79-field (s79-field r 1 (- (dlm-nth r 1) 1)) 2 (+ (dlm-nth r 2) 1)))
(define-function a92-worker-inc (r i)
  (s79-field r i (+ (dlm-nth r i) 1)))
(define-function a92-computed (status envs r)
  (list 'computed92 status (if (= status 'complete) envs ()) r))
(define-function a92-map-op (op args)
  (let ((mapped ())) (list-do i (dlm-nth op 2) (set mapped (dlm-append mapped (list (dlm-nth args i)))))
    (list (car op) (dlm-nth op 1) mapped)))
(define a92-execute ())
(set a92-execute (lambda (op ep lib scope envs r)
  (if (= (dlm-nth r 1) 0) (a92-computed 'unknown () r)
    (let ((out ()) (status 'complete))
      (set r (a92-worker-spend r))
      (if (= (car op) 'call91)
        (begin
          (set r (a92-worker-inc r 5)) (set r (s79-field r 6 (dlm-add (dlm-nth r 6) (dlm-nth op 1))))
          (set out envs)
          (list-do child (dlm-nth (b91-module lib (dlm-nth op 1)) 3)
            (if (= status 'complete)
              (let ((v (a92-execute (a92-map-op child (dlm-nth op 2)) ep lib scope out r)))
                (set status (dlm-nth v 1)) (set out (dlm-nth v 2)) (set r (dlm-nth v 3))))))
        (list-do env envs (list-do id (dlm-nth scope 1)
          (if (= status 'complete)
            (if (= (dlm-nth r 1) 0) (set status 'unknown)
              (let ((f (dlm-nth (dlm-nth ep 3) id)))
                (set r (a92-worker-inc (a92-worker-spend r) 3))
                (if (equal (dlm-nth op 1) (dlm-nth f 1))
                  (let ((m (b91-bind env (car (dlm-nth op 2)) (car (dlm-nth f 2)))))
                    (set r (a92-worker-inc r 4))
                    (if m (set m (b91-bind (dlm-nth m 1) (dlm-nth (dlm-nth op 2) 1) (dlm-nth (dlm-nth f 2) 1))))
                    (if m (set out (dlm-add out (a92-normal-env (dlm-nth m 1)))))
                    (if (> (dlm-length out) 512) (set status 'unknown))))))))))
      (a92-computed status out r)))))
;;; Coverage gate independently inspects original source, not policy/index/worker.
;;; A fact is potentially needed if it satisfies an atom's PRE-existing bindings.
(define-function a92-bound-fact? (a f env)
  (and (equal (car a) (dlm-nth f 1))
    (let ((left (dlm-assoc (dlm-nth a 1) env)) (right (dlm-assoc (dlm-nth a 2) env))
          (x (car (dlm-nth f 2))) (y (dlm-nth (dlm-nth f 2) 1)))
      (and (or (not left) (equal (dlm-nth left 1) x))
           (or (not right) (equal (dlm-nth right 1) y))
           (or (not (= (dlm-nth a 1) (dlm-nth a 2))) (equal x y))))))
(define-function a92-check-coverage (atoms envs ep ids fuel)
  (let ((r (b91-runtime fuel)) (ok true) (status 'complete) (i 0))
    (list-do f (dlm-nth ep 3)
      (list-do env envs (list-do a atoms
        (if (= status 'complete)
          (if (= (dlm-nth r 1) 0) (set status 'unknown)
            (begin (set r (b91-spend r))
              (if (and (a92-bound-fact? a f env) (not (dlm-member? i ids))) (set ok false)))))))
      (set i (+ i 1)))
    (list 'coverage92 status ok r)))
;;; Independent complete row check via the PREDECESSOR's primitive full-source
;;; evaluator and join, never the scoped worker/planner/index. Expensive by design;
;;; report its cost separately instead of claiming a free correctness oracle.
(define-function a92-check-rows (atoms before proposed ep fuel)
  (let ((primitive ())) (list-do a atoms
    (set primitive (dlm-append primitive (list (list 'fact91 (car a) (cdr a))))))
    (let ((v (b91-eval-plan primitive (dlm-nth ep 3) () (b91-runtime fuel) false)))
      (if (= (dlm-nth v 1) 'complete)
        (set v (b91-join before (dlm-nth v 2) (dlm-nth v 3))))
      (list 'checked-rows92 (dlm-nth v 1)
        (and (= (dlm-nth v 1) 'complete) (a92-same-rows? proposed (dlm-nth v 2))) (dlm-nth v 3)))))

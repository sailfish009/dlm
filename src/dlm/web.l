;;; web.l — observations acquired from web text; never truth by themselves.
(define-function w-observation (id url snippet subj obj)
  (list 'wobs id url snippet subj obj))
(define-function w-observation? (x)
  (and (l-shape? x 6) (equal (car x) 'wobs)
       (l-name? (l-nth x 1)) (l-name? (l-nth x 2))
       (l-name? (l-nth x 3)) (l-name? (l-nth x 4)) (l-name? (l-nth x 5))))
(define-function w-id (x) (l-nth x 1))
(define-function w-url (x) (l-nth x 2))
(define-function w-quote (x) (l-nth x 3))
(define-function w-subj (x) (l-nth x 4))
(define-function w-obj (x) (l-nth x 5))
(define-function w-to-records (obs)
  (let ((out ()))
    (list-do o obs
      (if (w-observation? o)
        (let ((q (w-quote o)))
          (if (or (nl-prefix? (nl-normalize q) "all ")
                  (>= (nl-find (nl-normalize q) " is a kind of " 0) 0))
            (set out (l-append out (list (nl-parse q))))
            (set out (l-append out (list (list 'nl-fact (w-subj o) (w-obj o) q))))))))
    out))

;;; In-process accumulation across web observations/query turns.
(define *web-store* ())
(define *web-basis* ())
(define-function w-clear ()
  (set *web-store* ()) (set *web-basis* ()))
(define-function w-ingest (obs)
  (set *web-store* (l-append *web-store* obs))
  (set *web-basis* (nl-basis (w-to-records *web-store*)))
  (list (l-len *web-store*) (l-len (b-active-rules *web-basis*))))
(define-function w-facts () (car (nl-build (w-to-records *web-store*))))
(define-function w-rules () (b-active-rules *web-basis*))

;;; Persist/load the in-process web observation and basis store.
(define-function w-save (path)
  (let* ((f (file-open path "w")) (s (file-stream f)))
    (print-all s "(define *web-store* '")
    (dump-all s *web-store*)
    (print-all s ")\n(define *web-basis* '")
    (dump-all s *web-basis*)
    (print-all s ")\n")
    (file-close f)
    path))
(define-function w-load (path)
  (load path)
  (list (l-len *web-store*) (l-len (b-active-rules *web-basis*))))

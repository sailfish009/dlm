;;; Basis91: bounded positive conjunctive patterns, all variable roles exported.
;;; Pattern: ((REL V0 V1) ...), 1..3 distinct connected atoms, variables 0..3.
;;; Plan ops: (fact91 REL (V0 V1)), (call91 PREFIX-ID (ARG ...)).
;;; A basis is a conservative definition, NOT an induced world axiom.
;;; Encoded bodies retain the SAME roles/pattern/library, not a second model.
;;; A codec must validate its executable representation before exposing leaf ops.
(define *b91-codec-read* ())
(define *b91-codec-execute* ())
(define *b91-codec-controlled* ())
(define *b91-codec-encode* ())
(define *b91-codec-check* ())
(define *b91-controlled-interpret* ())
;;; Optional typed source facet and heterogeneous definitions share this owner.
(define *b91-typed-module-check* ())
(define *b91-typed-core-check* ())
(define *b91-typed-state-check* ())
(define *b91-typed-project* ())
(define *b91-typed-refresh* ())
(define *b91-typed-step* ())
(define *b91-typed-command* ())
(define *b91-source-event-guard* ())
(define-function b91-relational? (m) (and (pair? m) (= (car m) 'basis91)))
(define-function b91-relations (lib)
  (let ((out ())) (list-do m lib (if (b91-relational? m) (set out (dlm-append out (list m))))) out))
(define-function b91-encoded? (body)
  (and (pair? body) (= (car body) 'encoded91)))
(define-function b91-body-ops (body)
  (if (b91-encoded? body) (if *b91-codec-read* (*b91-codec-read* body) ()) body))
(define-function b91-body-size (body) (dlm-length (b91-body-ops body)))
(define-function b91-coded-library? (lib)
  (let ((found false)) (list-do m lib
    (if (b91-encoded? (dlm-nth m 3)) (set found true))) found))
(define-function b91-name? (x) (and x (sq-name? x)))
(define-function b91-range (n)
  (let ((out ()) (i 0)) (while (< i n) (set out (dlm-append out (list i))) (set i (+ i 1))) out))
(define-function b91-var? (x) (and (is <long> x) (>= x 0) (< x 4)))
(define-function b91-vars (pattern)
  (let ((out ())) (list-do a pattern (set out (dlm-union out (cdr a)))) out))
(define-function b91-arity (p) (dlm-length (b91-vars p)))
(define-function b91-connected? (p)
  (let ((seen (list (car p))) (vars (cdr (car p))) (changed true))
    (while changed (set changed false)
      (list-do a p
        (if (and (not (dlm-member? a seen)) (dlm-intersection vars (cdr a)))
          (begin (set seen (cons a seen)) (set vars (dlm-union vars (cdr a))) (set changed true)))))
    (= (dlm-length seen) (dlm-length p))))
(define-function b91-pattern? (p sig)
  (and p (dlm-proper? p 3)
    (let ((ok true) (seen ()))
      (list-do a p
        (if (and (sq-shape? a 3) (dlm-member? (car a) sig)
                 (b91-var? (dlm-nth a 1)) (b91-var? (dlm-nth a 2)) (not (dlm-member? a seen)))
          (set seen (cons a seen)) (set ok false)))
      (and ok (not (dlm-difference (b91-range (b91-arity p)) (b91-vars p))) (b91-connected? p)))))
(define-function b91-facts? (facts sig)
  (and (dlm-proper? facts 8)
    (let ((ok true) (seen ()) (nodes ()))
      (list-do f facts
        (if (and (sq-shape? f 3) (= (car f) 'atom) (dlm-member? (dlm-nth f 1) sig)
                 (sq-shape? (dlm-nth f 2) 2) (b91-name? (car (dlm-nth f 2)))
                 (b91-name? (dlm-nth (dlm-nth f 2) 1)) (not (dlm-member? f seen)))
          (begin (set seen (cons f seen)) (set nodes (dlm-union nodes (dlm-nth f 2)))) (set ok false)))
      (and ok (<= (dlm-length nodes) 8)))))
(define-function b91-find (records id) (b90-find records id))
(define-function b91-module (lib id) (b90-module lib id))
(define-function b91-primitive (p)
  (let ((out ())) (list-do a p (set out (dlm-append out (list (list 'fact91 (car a) (cdr a)))))) out))
(define-function b91-rename (p args)
  (let ((out ())) (list-do a p
    (set out (dlm-append out (list (list (car a) (dlm-nth args (dlm-nth a 1)) (dlm-nth args (dlm-nth a 2))))))) out))
;;; Expand against a previously checked prefix; no cyclic/forward references.
(define-function b91-expand (plan sig lib)
  (set plan (b91-body-ops plan))
  (if (not (and plan (dlm-proper? plan 3))) ()
    (let ((out ()) (ok true))
      (list-do op plan
        (if (not (and (sq-shape? op 3) (dlm-proper? (dlm-nth op 2) 4))) (set ok false)
          (cond
            ((and (= (car op) 'fact91) (dlm-member? (dlm-nth op 1) sig)
                  (= (dlm-length (dlm-nth op 2)) 2)
                  (b91-var? (car (dlm-nth op 2))) (b91-var? (dlm-nth (dlm-nth op 2) 1)))
              (set out (dlm-append out (list (cons (dlm-nth op 1) (dlm-nth op 2))))))
            ((and (= (car op) 'call91) (is <long> (dlm-nth op 1)) (b91-module lib (dlm-nth op 1)))
              (let* ((m (b91-module lib (dlm-nth op 1))) (args (dlm-nth op 2)) (valid (b91-relational? m)))
                (list-do v args (if (not (b91-var? v)) (set valid false)))
                (if (and valid (= (dlm-length args) (b91-arity (dlm-nth m 2))))
                  (set out (dlm-append out (b91-rename (dlm-nth m 2) args))) (set ok false))))
            (else (set ok false)))))
      (if (and ok (<= (dlm-length out) 3)) out ()))))
(define-function b91-same-atoms? (a b)
  (and a b (= (dlm-length a) (dlm-length b))
    (let ((left b) (ok true)) (list-do x a
      (if (dlm-member? x left) (set left (dlm-difference left (list x))) (set ok false)))
      (and ok (not left)))))
(define-function b91-plan? (p plan sig lib)
  (b91-same-atoms? p (b91-expand plan sig lib)))
(define-function b91-library? (lib sig)
  (and (dlm-proper? lib 8)
    (let ((prefix ()) (seen ()) (ok true) (id 1))
      (list-do m lib
        (let ((valid false))
          (if (and ok (dlm-proper? m 7) (pair? m) (= (dlm-nth m 1) id))
            (if (b91-relational? m)
              (if (and (sq-shape? m 4) (b91-pattern? (dlm-nth m 2) sig)
                   (>= (dlm-length (dlm-nth m 2)) 2) (not (dlm-member? (dlm-nth m 2) seen))
                   (b91-plan? (dlm-nth m 2) (dlm-nth m 3) sig prefix))
                (begin (set valid true) (set seen (cons (dlm-nth m 2) seen))))
              (if (and *b91-typed-module-check* (*b91-typed-module-check* m prefix sig)) (set valid true))))
          (if valid (begin (set prefix (dlm-append prefix (list m))) (set id (+ id 1))) (set ok false)))) ok)))
;;; Canonicalize small ground/pattern conjunctions by all atom orders and alpha-renaming.
;;; This is structural normalization, NOT inference of a universal world law.
(define-function b91-orders (xs)
  (if (not xs) (list ())
    (let ((out ())) (list-do x xs
      (list-do rest (b91-orders (dlm-difference xs (list x)))
        (set out (dlm-append out (list (cons x rest)))))) out)))
(define-function b91-alpha (p)
  (let ((names ()) (out ()))
    (list-do a p
      (let ((args ())) (list-do term (cdr a)
        (let ((entry (dlm-assoc term names)))
          (if (not entry) (begin (set entry (list term (dlm-length names))) (set names (dlm-append names (list entry)))))
          (set args (dlm-append args (list (dlm-nth entry 1))))))
        (set out (dlm-append out (list (cons (car a) args)))))) out))
(define-function b91-index (x xs)
  (if (equal x (car xs)) 0 (+ 1 (b91-index x (cdr xs)))))
(define-function b91-code (p sig)
  (let ((out ())) (list-do a p
    (set out (dlm-append out (list (+ (* 25 (b91-index (car a) sig))
      (+ (* 5 (dlm-nth a 1)) (dlm-nth a 2))))))) out))
(define-function b91-less? (a b)
  (and a (or (not b) (< (car a) (car b)) (and (= (car a) (car b)) (b91-less? (cdr a) (cdr b))))))
(define-function b91-canonical (p sig)
  (let ((best ()) (code ())) (list-do order (b91-orders p)
    (let* ((a (b91-alpha order)) (c (b91-code a sig)))
      (if (or (not best) (b91-less? c code)) (begin (set best a) (set code c))))) best))
(define-function b91-new (sig)
  (if (and (b90-names? sig 4) sig) (list 'basis-state91 1 sig () () () () 0) '(rejected91 signature)))
(define-function b91-core (s)
  (let ((core (list 'basis-core91 (dlm-nth s 2) (dlm-nth s 3) (dlm-nth s 4) (dlm-nth s 5) (dlm-nth s 7))))
    (if (and (sq-shape? s 9) *b91-typed-project*)
      (dlm-append core (list (*b91-typed-project* s))) core)))
;;; The executable projection contains no training bindings or proof tables.
(define-function b91-model (s)
  (let ((views ())) (list-do v (dlm-nth s 5)
    (set views (dlm-append views (list (list 'reading91 (dlm-nth v 1) (dlm-nth v 2) (dlm-nth v 3) (dlm-nth v 4))))))
    (let ((model (list 'execution-core91 (dlm-nth s 2) (dlm-nth s 3) (dlm-nth s 4) views (dlm-nth s 7))))
      (if (and (sq-shape? s 9) *b91-typed-project*)
        (dlm-append model (list (*b91-typed-project* s))) model))))
(define-function b91-live-shape? (s)
  (and (or (and (sq-shape? s 8) (= (dlm-nth s 1) 1))
           (and (sq-shape? s 9) (= (dlm-nth s 1) 2))) (= (car s) 'basis-state91)
       (dlm-proper? (dlm-nth s 5) 368)
       (let ((ok true)) (list-do v (dlm-nth s 5)
         (if (not (or (sq-shape? v 5) (sq-shape? v 6))) (set ok false))) ok)))
(define-function b91-work-size (readings)
  (let ((n 0)) (list-do v readings (set n (+ n (dlm-length (dlm-nth v 4))))) n))

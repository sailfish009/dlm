;;; Search84: native indexed candidate pool + negative transpositions + bandits.
;;; No MCTS tree, neural policy, or logical pruning by heuristic scores.
;;; Control: tag mode model-key pool rejection-cache family-stats total trials
;;;          cache-hits generated complete? inspected-proof-entries.
(define-function a84-new () (list 'control84 'off () () () () 0 0 0 0 true 0 ()))
(define-function a84-mode (c mode)
  (s79-field (s79-field c 1 mode) 2 ()))
(define-function a84-family (candidate)
  (list (dlm-length (car candidate)) (dlm-nth candidate 2) (dlm-nth candidate 3)))
(define-function a84-pool (model)
  (let ((pool ()) (seen ()) (complete true) (joins 0))
    (list-do ep (a77-episodes model)
      (let* ((closure (a77-close model (dlm-nth ep 2)))
             (facts (dlm-conclusions (dlm-nth closure 2))) (by-start ()))
        (if (not (= (dlm-nth closure 1) 'complete)) (set complete false))
        (list-do f facts
          (let ((start (car (dlm-args f))))
            (set by-start (s79-put by-start start (cons f (s79-at by-start start))))))
        (list-do left facts
          (list-do right (s79-reverse (s79-at by-start (dlm-nth (dlm-args left) 1)))
            (set joins (+ joins 1))
            (let* ((lw (a77-word (dlm-pred left) (a77-defs model)))
                   (rw (a77-word (dlm-pred right) (a77-defs model)))
                   (word (dlm-append lw rw))
                   (op (list 'compose (dlm-pred left) (dlm-pred right)))
                   (key (list word op)))
              (if (and (<= (dlm-length word) 4) (not (dlm-member? word (a77-words (a77-defs model))))
                       (not (dlm-member? key seen)))
                (if (>= (dlm-length pool) 512) (set complete false)
                  (begin (set seen (cons key seen))
                    (set pool (dlm-append pool
                      (list (list word op (dlm-length lw) (dlm-length rw)))))))))))))
    (list pool complete joins)))
(define-function a84-log2 (n)
  (let ((k 0)) (while (> n 1) (set n (/ n 2)) (set k (+ k 1))) k))
(define-function a84-sqrt (n)
  (let ((lo 0) (hi (+ n 1)))
    (while (> (- hi lo) 1)
      (let ((mid (/ (+ lo hi) 2)))
        (if (<= (* mid mid) n) (set lo mid) (set hi mid)))) lo))
(define-function a84-score (c candidate)
  (let* ((entry (s79-at (dlm-nth c 5) (a84-family candidate)))
         (n (if entry (car entry) 0)) (reward (if entry (dlm-nth entry 1) 0))
         (cost (if entry (dlm-nth entry 2) 0))
         (mean (/ (* reward 1024) (+ cost 1))))
    (if (dlm-member? (dlm-nth c 1) '(ucb nd-ucb))
      (if (= n 0) 1000000
        (+ mean (a84-sqrt (/ (* 65536 (a84-log2 (+ (dlm-nth c 6) 2))) n))))
      mean)))
(define-function a84-select (c)
  (let* ((pool (dlm-nth c 3)) (best (car pool)) (score -1))
    (if (not (dlm-member? (dlm-nth c 1) '(indexed cache nd-cache)))
      (list-do candidate pool
        (let ((v (a84-score c candidate)))
          (if (> v score) (begin (set best candidate) (set score v)))))) best))
(define-function a84-remove (item items)
  (if (not items) ()
    (if (equal item (car items)) (cdr items) (cons (car items) (a84-remove item (cdr items))))))
(define *a84-inspected* 0)
(define *a84-counting* false)
(define-function a84-count (n)
  (if *a84-counting* (set *a84-inspected* (+ *a84-inspected* n))))
(set a84-work a84-count)
(define a86-run ())
(define-function a84-plain-run (model ctrl budget)
  (if (not (and (a77-valid? model) (is <long> budget) (> budget 0) (<= budget 1000)
                (dlm-member? (dlm-nth ctrl 1) '(indexed cache rank ucb))))
      (list 'invalid-input model ctrl 0 () 0)
    (let ((c ctrl) (checks 0) (answer ()) (definition ()) (hits 0) (deferred ()))
      (if (not (equal model (dlm-nth c 2)))
        (let ((generated (a84-pool model)))
          (set c (s79-field c 2 model))
          (set c (s79-field c 3 (car generated)))
          (set c (s79-field c 4 ()))
          (set c (s79-field c 9 (+ (dlm-nth c 9) (dlm-nth generated 2))))
          (set c (s79-field c 10 (dlm-nth generated 1)))))
      (if (>= (dlm-length (a77-defs model)) 12) (set answer 'capacity))
      (while (and (not answer) (< checks budget) (dlm-nth c 3))
        (let* ((candidate (a84-select c)) (word (car candidate))
               (cached (if (= (dlm-nth c 1) 'indexed) () (dlm-assoc word (dlm-nth c 4)))))
          (set c (s79-field c 3 (a84-remove candidate (dlm-nth c 3))))
          (set checks (+ checks 1))
          (if cached
            (set c (s79-field c 8 (+ (dlm-nth c 8) 1)))
            (let* ((d (list 'definition77 (a77-fresh model) word (dlm-nth candidate 1)))
                   (trial ()) (reward 0) (family (a84-family candidate))
                   (prior (or (s79-at (dlm-nth c 5) family) '(0 0 0))))
              (set *a84-inspected* 0) (set *a84-counting* true)
              (set trial (a77-certify model d))
              (set *a84-counting* false)
              (set c (s79-field c 7 (+ (dlm-nth c 7) 1)))
              (set c (s79-field c 11 (+ (dlm-nth c 11) *a84-inspected*)))
              (if (= (car trial) 'learned)
                (begin (set answer 'learned) (set definition d) (set hits (dlm-nth trial 3))
                  (set reward (if (> hits 256) 256 hits)) (set model (dlm-nth trial 1)))
                ;; Only complete insufficient-reuse judgments are memoized.
                ;; This is not a claim of logical unprovability.
                (if (= (dlm-nth trial 1) 'insufficient-reuse)
                  (if (not (= (dlm-nth c 1) 'indexed))
                    (set c (s79-field c 4 (s79-put (dlm-nth c 4) word 'insufficient-reuse))))
                  (set deferred (dlm-append deferred (list candidate)))))
              (set c (s79-field c 6 (+ (dlm-nth c 6) 1)))
              (set c (s79-field c 5 (s79-put (dlm-nth c 5) family
                (list (+ (car prior) 1) (+ (dlm-nth prior 1) reward)
                      (+ (dlm-nth prior 2) (+ 1 *a84-inspected*))))))))))
      (if deferred (set c (s79-field c 3 (dlm-append (dlm-nth c 3) deferred))))
      (list (or answer (if (dlm-nth c 3) 'incomplete (if (dlm-nth c 10) 'saturated 'capacity)))
            model c checks definition hits))))
(define-function a84-run (model ctrl budget)
  (if (and a86-run (dlm-member? (dlm-nth ctrl 1) '(nd-cache nd-ucb)))
      (a86-run model ctrl budget) (a84-plain-run model ctrl budget)))

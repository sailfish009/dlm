;;; Finite conjunctive matching. Cache belongs to one batch and immutable source.
;;; All roles are returned, including intermediate witnesses. Missing != negation.
;;; runtime91: fuel used cache scans joins calls hits basis-ids op-visits.
(define-function b91-runtime (fuel) (list 'runtime91 fuel 0 () 0 0 0 0 () 0))
(define-function b91-spend (r) (s79-field (s79-field r 1 (- (dlm-nth r 1) 1)) 2 (+ 1 (dlm-nth r 2))))
(define-function b91-inc (r i) (s79-field r i (+ 1 (dlm-nth r i))))
(define-function b91-value (status rows r) (list 'value91 status rows r))
(define-function b91-cache (v key)
  (if (= (dlm-nth v 1) 'complete)
    (s79-field v 3 (s79-field (dlm-nth v 3) 3 (s79-put (dlm-nth (dlm-nth v 3) 3) key (dlm-nth v 2)))) v))
(define-function b91-scan (name facts r)
  (let ((pairs ()) (status 'complete)) (list-do f facts
    (if (= status 'complete)
      (if (= (dlm-nth r 1) 0) (set status 'unknown)
        (begin (set r (b91-inc (b91-spend r) 4))
          (if (equal (dlm-nth f 1) name) (set pairs (dlm-append pairs (list (dlm-nth f 2)))))))))
    (b91-value status (if (= status 'complete) pairs ()) r)))
(define-function b91-merge (a b)
  (let ((ok (list 'ok a))) (list-do entry b
    (if ok (set ok (b91-bind (dlm-nth ok 1) (car entry) (dlm-nth entry 1))))) ok))
(define-function b91-join (left right r)
  (let ((rows ()) (status 'complete)) (list-do a left (list-do b right
    (if (= status 'complete)
      (if (= (dlm-nth r 1) 0) (set status 'unknown)
        (let ((m (b91-merge a b)))
          (set r (b91-inc (b91-spend r) 5))
          (if m (set rows (dlm-add rows (dlm-nth m 1))))
          (if (> (dlm-length rows) 512) (set status 'unknown)))))))
    (b91-value status (if (= status 'complete) rows ()) r)))
(define-function b91-prefix (xs)
  (if (cdr xs) (cons (car xs) (b91-prefix (cdr xs))) ()))
(define-function b91-last (xs) (if (cdr xs) (b91-last (cdr xs)) (car xs)))
(define b91-eval-plan ())
(define-function b91-eval-op (op facts lib r memo)
  (if (= (dlm-nth r 1) 0) (b91-value 'unknown () r)
    (let ((v ()) (rows ()) (args (dlm-nth op 2)) (status 'complete))
      (set r (b91-inc (b91-spend r) 9))
      (if (= (car op) 'fact91)
        (let* ((key (list 'relation91 (dlm-nth op 1))) (cached (dlm-assoc key (dlm-nth r 3))))
          (set v (if cached (b91-value 'complete (dlm-nth cached 1) (b91-inc r 7))
            (b91-cache (b91-scan (dlm-nth op 1) facts r) key))))
        (let* ((id (dlm-nth op 1)) (key (list 'basis91 id)) (cached ()))
          (set r (s79-field (b91-inc r 6) 8 (dlm-add (dlm-nth r 8) id)))
          (set cached (dlm-assoc key (dlm-nth r 3)))
          (set v (if cached (b91-value 'complete (dlm-nth cached 1) (b91-inc r 7))
            (b91-cache (b91-eval-plan (dlm-nth (b91-module lib id) 3) facts lib r memo) key)))))
      (set r (dlm-nth v 3)) (set status (dlm-nth v 1))
      (if (= status 'complete) (list-do item (dlm-nth v 2)
        (if (= status 'complete)
          (if (= (dlm-nth r 1) 0) (set status 'unknown)
            (let ((values (if (= (car op) 'fact91) item (b91-args item (dlm-length args))))
                  (env (list 'ok ())) (i 0))
              (set r (b91-spend r))
              (list-do variable args
                (if env (set env (b91-bind (dlm-nth env 1) variable (dlm-nth values i))))
                (set i (+ i 1)))
              (if env (set rows (dlm-add rows (dlm-nth env 1)))))))))
      (b91-value status (if (= status 'complete) rows ()) r))))
(set b91-eval-plan (lambda (plan facts lib r memo)
  (if (= (dlm-nth r 1) 0) (b91-value 'unknown () r)
    (let* ((key (list 'plan91 plan)) (cached (if memo (dlm-assoc key (dlm-nth r 3)) ())) (v ()))
      (if cached (b91-value 'complete (dlm-nth cached 1) (b91-inc r 7))
        (begin
          (set v (if (not (cdr plan)) (b91-eval-op (car plan) facts lib r memo)
            (let ((a (b91-eval-plan (b91-prefix plan) facts lib r memo)))
              (if (not (= (dlm-nth a 1) 'complete)) a
                (let ((b (b91-eval-op (b91-last plan) facts lib (dlm-nth a 3) memo)))
                  (if (not (= (dlm-nth b 1) 'complete)) b
                    (b91-join (dlm-nth a 2) (dlm-nth b 2) (dlm-nth b 3))))))))
          (if memo (b91-cache v key) v)))))))
(define-function b91-fact-id (fact facts i)
  (if (not facts) () (if (equal fact (car facts)) i (b91-fact-id fact (cdr facts) (+ i 1)))))
(define-function b91-certify (p envs ep)
  (let ((rows ()) (ok true) (seen ())) (list-do env envs
    (let ((values (b91-args env (b91-arity p))) (ids ()))
      (if (not (dlm-member? values seen))
        (begin
          (list-do a p (set ids (dlm-append ids (list (b91-fact-id
            (list 'atom (car a) (list (dlm-nth values (dlm-nth a 1)) (dlm-nth values (dlm-nth a 2))))
            (dlm-nth ep 3) 0)))))
          (let ((row (list 'match91 values ids)))
            (if (b91-witness? p row ep) (set rows (dlm-append rows (list row))) (set ok false)))
          (set seen (cons values seen))))))
    (if ok (list 'certified91 rows) '(rejected91 witness))))
(define-function b91-metrics (r)
  (list 'metrics91 (dlm-nth r 2) (dlm-nth r 4) (dlm-nth r 5) (dlm-nth r 6)
        (dlm-nth r 7) (dlm-nth r 8) (dlm-nth r 9)))
(define-function b91-fuel? (fuel) (and (is <long> fuel) (>= fuel 0) (<= fuel 200000)))
(define-function b91-arm? (arm) (dlm-member? arm '(raw memo append basis)))
(define-function b91-evaluate-query (ep p plan lib r arm)
  (let ((v (b91-eval-plan plan (dlm-nth ep 3) lib r (= arm 'memo))))
    (if (not (= (dlm-nth v 1) 'complete)) (list 'query-value91 'unknown () (dlm-nth v 3))
      (let ((checked (b91-certify p (dlm-nth v 2) ep)))
        (if (= (car checked) 'certified91) (list 'query-value91 'complete (dlm-nth checked 1) (dlm-nth v 3))
          (list 'query-value91 'rejected () (dlm-nth v 3)))))))
(define-function b91-query-on (s ep p fuel arm)
  (if (not (and (b91-pattern? p (dlm-nth s 2)) (b91-fuel? fuel) (b91-arm? arm))) '(rejected91 query-input)
    (let ((plan (if (= arm 'basis) (b91-plan p (dlm-nth s 2) (dlm-nth s 4)) (b91-primitive p))))
      (if (not (b91-plan? p plan (dlm-nth s 2) (dlm-nth s 4))) '(rejected91 routing)
        (let ((v (b91-evaluate-query ep p plan (dlm-nth s 4) (b91-runtime fuel) arm)))
          (list 'execution91 (dlm-nth v 1) p (dlm-nth v 2) (b91-metrics (dlm-nth v 3))))))))
(define-function b91-query (s episode p fuel arm)
  (if (not (and (b91-live-shape? s) (b91-model? (b91-model s))
                (b91-name? episode) (b91-find (dlm-nth s 3) episode))) '(rejected91 episode)
    (b91-query-on s (b91-find (dlm-nth s 3) episode) p fuel arm)))
(define-function b91-probe (s facts p fuel arm)
  (if (not (and (b91-live-shape? s) (b91-model? (b91-model s))
                (b91-facts? facts (dlm-nth s 2)))) '(rejected91 probe)
    (b91-query-on s (list 'episode91 'probe91 0 facts false) p fuel arm)))
;;; Pure execution from a checked definition/model projection, even when all
;;; training bindings and audit records are unavailable. Does not admit a model.
(define-function b91-infer (model episode p fuel arm)
  (if (not (b91-model? model)) '(rejected91 model)
    (b91-query (list 'basis-state91 1 (dlm-nth model 1) (dlm-nth model 2)
      (dlm-nth model 3) (dlm-nth model 4) () (dlm-nth model 5)) episode p fuel arm)))
(define-function b91-run (s episode fuel arm)
  (if (not (and (b91-live-shape? s) (b91-model? (b91-model s))
                (b91-name? episode) (b91-find (dlm-nth s 3) episode)
                (b91-fuel? fuel) (b91-arm? arm))) '(rejected91 batch-input)
    (let ((ep (b91-find (dlm-nth s 3) episode)) (r (b91-runtime fuel)) (status 'complete) (answers ()))
      (list-do reading (dlm-nth s 5)
        (if (and (= status 'complete) (equal episode (dlm-nth reading 1)))
          (let* ((p (dlm-nth reading 3)) (plan (if (= arm 'basis) (dlm-nth reading 4) (b91-primitive p)))
                 (v (b91-evaluate-query ep p plan (dlm-nth s 4) r arm)))
            (set r (dlm-nth v 3)) (set status (dlm-nth v 1))
            (if (= status 'complete) (set answers (dlm-append answers (list (list 'answer91 p (dlm-nth v 2)))))))))
      (list 'batch91 status answers (b91-metrics r)))))

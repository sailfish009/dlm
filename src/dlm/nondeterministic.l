;;; -*- mode: lisp; coding: us-ascii -*-
;;; Explicit frames, immutable branch contexts, FIFO scheduling. No closures in data.
;;; OR = queue alternatives; AND = all child frames before an assemble frame.
(define-function n78-context (bindings assumptions definitions)
  (list 'context78 bindings assumptions definitions))
(define-function n78-branch (id context frames nodes next policy values status)
  (list 'branch78 id context frames nodes next policy values status))
(define-function n78-machine (input queue answers failed ticks next)
  (list 'machine78 1 input queue answers failed ticks next))
(define-function n78-program? (tasks fuel)
  (and (> fuel 0) (dlm-proper? tasks 256)
    (let ((ok true)) (list-do t tasks
      (if (not (and (pair? t) (dlm-proper? t 4)
          (cond
            ((= (car t) 'choose)
              (and (= (dlm-length t) 2) (dlm-nth t 1) (dlm-proper? (dlm-nth t 1) 16)
                (let ((valid true)) (list-do alt (dlm-nth t 1)
                  (if (not (n78-program? alt (- fuel 1))) (set valid false))) valid)))
            ((or (= (car t) 'assume) (= (car t) 'suspend) (= (car t) 'fail) (= (car t) 'accept))
              (= (dlm-length t) 2))
            ((or (= (car t) 'bind) (= (car t) 'require) (= (car t) 'define-local))
              (and (= (dlm-length t) 3) (sq-name? (dlm-nth t 1))))
            (else false)))) (set ok false))) ok)))
(define-function n78-program (tasks)
  (if (not (n78-program? tasks 16)) (list 'rejected 'program)
    (n78-machine (list 'program-input78 tasks)
      (list (n78-branch 0 (n78-context () () ()) tasks () 0 'program () 'ready)) () 0 0 1)))
(define-function n78-proof (problem library)
  (if (not (and (sq-problem? problem) (p78-library? library))) (list 'rejected 'proof-input)
    (let ((root (dlm-nth problem 3)))
      (n78-machine (list 'proof-input78 problem library)
        (list (n78-branch 0 (n78-context () () ()) (list (list 'reuse root)) () 0 'left-first () 'ready)
              (n78-branch 1 (n78-context () () ()) (list (list 'prove root)) () 0 'right-first () 'ready)) () 0 0 2))))
(define-function n78-action (s policy)
  (let ((initial (sq-find-initial s)) (bot (sq-find-tag (sq-left s) 'bottom))
        (top (sq-find-tag (sq-right s) 'top))
        (lc (sq-compound (sq-left s))) (rc (sq-compound (sq-right s))))
    (if initial (list 'init initial ())
      (if bot (list 'bottom-left (list 'left (car bot)) ())
        (if top (list 'top-right (list 'right (car top)) ())
          (if (and rc (= policy 'right-first)) (sq-expand-right s (car rc))
            (if lc (sq-expand-left s (car lc))
              (if rc (sq-expand-right s (car rc)) ()))))))))
(define-function n78-ready? (m)
  (let ((out false)) (list-do b (dlm-nth m 3)
    (if (= (dlm-nth b 8) 'ready) (set out true))) out))
(define-function n78-summary (m)
  (if (not (= (car m) 'machine78)) m
    (list 'nondeterministic78
      (if (dlm-nth m 4) 'answered (if (n78-ready? m) 'incomplete (if (dlm-nth m 3) 'suspended 'exhausted)))
      'ticks (dlm-nth m 6) 'branches (dlm-length (dlm-nth m 3))
      'answers (dlm-length (dlm-nth m 4)) 'failed (dlm-nth m 5))))
(define-function n78-answer (b kind value)
  (list 'answer78 (dlm-nth b 1) kind value (dlm-nth b 2)))
(define-function n78-step (m)
  (let ((queue ()) (b ()) (rest ()) (answers (dlm-nth m 4)) (failed (dlm-nth m 5))
        (next-id (dlm-nth m 7)) (input (dlm-nth m 2)))
    (list-do entry (dlm-nth m 3)
      (if (and (not b) (= (dlm-nth entry 8) 'ready)) (set b entry)
        (set rest (dlm-append rest (list entry)))))
    (if (not b) m
      (let ((id (dlm-nth b 1)) (ctx (dlm-nth b 2)) (frames (dlm-nth b 3))
            (nodes (dlm-nth b 4)) (node-id (dlm-nth b 5)) (policy (dlm-nth b 6))
            (values (dlm-nth b 7)) (status 'ready) (alive true))
        (if (not frames)
            (begin (set alive false)
              (if (= (car input) 'proof-input78)
                  (let* ((problem (dlm-nth input 1))
                         (cert (list 'certificate 'classical-prop-v1 (car values) nodes)))
                    (if (= (sq-verify cert (dlm-nth problem 3) (dlm-nth problem 2) 10000) 'verified)
                        (set answers (dlm-append answers (list (n78-answer b 'proof cert))))
                      (set failed (+ failed 1))))
                (set answers (dlm-append answers (list (n78-answer b 'provisional values))))))
          (let* ((task (car frames)) (op (car task)) (arg (dlm-nth task 1)))
            (set frames (cdr frames))
            (cond
              ((= op 'choose)
                (if (> (+ (dlm-length rest) (dlm-length arg)) 64)
                    (begin (set frames (cons task frames)) (set status '(suspended branch-capacity)))
                  (begin (set alive false)
                    (list-do alt arg
                      (set queue (dlm-append queue (list
                        (n78-branch next-id ctx (dlm-append alt frames) nodes node-id policy values 'ready))))
                      (set next-id (+ next-id 1))))))
              ((= op 'assume) (set ctx (n78-context (dlm-nth ctx 1) (cons arg (dlm-nth ctx 2)) (dlm-nth ctx 3))))
              ((or (= op 'bind) (= op 'define-local))
                (let* ((index (if (= op 'bind) 1 3)) (old (dlm-assoc arg (dlm-nth ctx index))))
                  (if (and old (not (equal (dlm-nth old 1) (dlm-nth task 2))))
                      (begin (set alive false) (set failed (+ failed 1)))
                    (if (not old)
                        (set ctx (n78-context
                          (if (= index 1) (cons (list arg (dlm-nth task 2)) (dlm-nth ctx 1)) (dlm-nth ctx 1))
                          (dlm-nth ctx 2)
                          (if (= index 3) (cons (list arg (dlm-nth task 2)) (dlm-nth ctx 3)) (dlm-nth ctx 3))))))))
              ((= op 'require)
                (let ((entry (dlm-assoc arg (dlm-nth ctx 1))))
                  (if (not (and entry (equal (dlm-nth entry 1) (dlm-nth task 2))))
                      (begin (set alive false) (set failed (+ failed 1))))))
              ((= op 'suspend) (set status (list 'suspended arg)))
              ((= op 'fail) (set alive false) (set failed (+ failed 1)))
              ((= op 'accept) (set alive false)
                (set answers (dlm-append answers (list (n78-answer
                  (n78-branch id ctx frames nodes node-id policy values status) 'provisional arg)))))
              ((= op 'reuse)
                (let* ((problem (dlm-nth input 1)) (cert (p78-find (dlm-nth input 2) problem)))
                  (if cert
                      (begin (set alive false) (set answers (dlm-append answers (list (n78-answer b 'proof cert)))))
                    (set frames (cons (list 'prove arg) frames)))))
              ((= op 'prove)
                (let ((action (n78-action arg policy)))
                  (if action
                      (let ((children (dlm-nth action 2)) (work ()) (bounded true))
                        (list-do child children
                          (if (not (and (dlm-proper? (sq-left child) 256) (dlm-proper? (sq-right child) 256)))
                              (set bounded false))
                          (set work (dlm-append work (list (list 'prove child)))))
                        (if bounded
                            (set frames (dlm-append work (cons
                              (list 'assemble arg (car action) (dlm-nth action 1) (dlm-length children)) frames)))
                          (begin (set frames (cons task frames)) (set status '(suspended context-capacity)))))
                    (let* ((problem (dlm-nth input 1)) (root (dlm-nth problem 3))
                           (atoms (dlm-union (sq-context-atoms (sq-left root)) (sq-context-atoms (sq-right root))))
                           (assignment ()))
                      (list-do a atoms (set assignment (dlm-append assignment
                        (list (list a (if (dlm-member? a (sq-left arg)) 'yes 'no))))))
                      (set alive false)
                      (if (sq-check-countermodel problem (list 'model assignment))
                          (set answers (dlm-append answers (list (n78-answer b 'countermodel (list 'model assignment)))))
                        (set failed (+ failed 1)))))))
              ((= op 'assemble)
                (let ((ids ()) (count (dlm-nth task 4)))
                  (while (> count 0)
                    (set ids (cons (car values) ids)) (set values (cdr values)) (set count (- count 1)))
                  (set nodes (dlm-append nodes (list
                    (list 'proof-node node-id arg (dlm-nth task 2) (dlm-nth task 3) () ids))))
                  (set values (cons node-id values)) (set node-id (+ node-id 1))))
              (else (set alive false) (set failed (+ failed 1))))))
        (if alive (set queue (dlm-append queue
          (list (n78-branch id ctx frames nodes node-id policy values status)))))
        (n78-machine input (dlm-append rest queue) answers failed (+ (dlm-nth m 6) 1) next-id)))))
(define-function n78-run (m budget)
  (if (not (and (= (car m) 'machine78) (is <long> budget) (>= budget 0) (<= budget 10000)))
      (list 'rejected 'budget-or-machine)
    (begin (while (and (> budget 0) (n78-ready? m) (not (dlm-nth m 4)))
      (set m (n78-step m)) (set budget (- budget 1))) m)))
(define-function n78-next (m)
  (n78-machine (dlm-nth m 2) (dlm-nth m 3) () (dlm-nth m 5) (dlm-nth m 6) (dlm-nth m 7)))
(define-function n78-resume (m)
  (let ((queue ())) (list-do b (dlm-nth m 3)
    (set queue (dlm-append queue (list (n78-branch (dlm-nth b 1) (dlm-nth b 2)
      (dlm-nth b 3) (dlm-nth b 4) (dlm-nth b 5) (dlm-nth b 6) (dlm-nth b 7) 'ready)))))
    (n78-machine (dlm-nth m 2) queue (dlm-nth m 4) (dlm-nth m 5) (dlm-nth m 6) (dlm-nth m 7))))

;;; Data-led interpretation: enumerate connected 2/3-fact structures, apply their
;;; logical patterns, and retain all successful alternative readings. No labels,
;;; user task programs, or hidden expected basis bodies feed discovery.
(define-function b91-choose (xs n)
  (if (= n 0) (list ())
    (if (not xs) ()
      (let ((out ()))
        (list-do rest (b91-choose (cdr xs) (- n 1)) (set out (dlm-append out (list (cons (car xs) rest)))))
        (dlm-append out (b91-choose (cdr xs) n))))))
(define-function b91-data-patterns (facts sig)
  (let ((atoms ()) (out ()))
    (list-do f facts (set atoms (dlm-append atoms (list (cons (dlm-nth f 1) (dlm-nth f 2))))))
    (list-do n '(2 3)
      (list-do group (b91-choose atoms n)
        (if (b91-connected? group)
          (let ((p (b91-canonical group sig)))
            (if (b91-pattern? p sig) (set out (dlm-add out p))))))) out))
(define-function b91-interpret (s ep fuel)
  (let ((readings ()) (attempts ()) (pool ()) (status 'complete) (r (b91-runtime fuel)))
    ;; Try existing internal logic first, even when it fails on this source.
    (list-do m (dlm-nth s 4) (set pool (dlm-add pool (dlm-nth m 2))))
    (set pool (dlm-union pool (b91-data-patterns (dlm-nth ep 3) (dlm-nth s 2))))
    (list-do p pool
      (if (= status 'complete)
        (let ((plan (b91-plan p (dlm-nth s 2) (dlm-nth s 4))))
          (if (not (b91-plan? p plan (dlm-nth s 2) (dlm-nth s 4))) (set status 'rejected)
            (let ((v (b91-evaluate-query ep p plan (dlm-nth s 4) r 'basis)))
              (set r (dlm-nth v 3)) (set status (dlm-nth v 1))
              (set attempts (dlm-append attempts (list (list 'attempt91 p status (dlm-length (dlm-nth v 2)) plan))))
              (if (and (= status 'complete) (dlm-nth v 2))
                (set readings (dlm-append readings (list (list 'reading91 (dlm-nth ep 1)
                  (dlm-nth ep 2) p plan (dlm-nth v 2)))))))))))
    (if (= status 'complete) (list 'interpreted91 readings (b91-metrics r) attempts)
      (list 'rejected91 status (b91-metrics r) attempts))))
(define-function b91-candidates (s)
  (let ((out ()) (seen ()) (lib (dlm-nth s 4)))
    (list-do v (dlm-nth s 5)
      (let ((p (dlm-nth v 3)) (plan (dlm-nth v 4)) (known false))
        (list-do m lib (if (equal p (dlm-nth m 2)) (set known true)))
        (if (and (not known) (not (dlm-member? p seen)) (= (dlm-length plan) 2))
          (let ((support (b91-support p (dlm-nth s 5))))
            (set seen (cons p seen))
            (if (>= support 2)
              (set out (dlm-append out (list (list 'candidate91 p plan support
                (- (* support (- (dlm-length p) 1)) 1)))))))))) out))
(define-function b91-propose (s)
  (if (>= (dlm-length (dlm-nth s 4)) 8) '(waiting91 basis-capacity)
    (let ((best ()) (score -1))
      (list-do c (b91-candidates s)
        (if (> (dlm-nth c 4) score) (begin (set best c) (set score (dlm-nth c 4)))))
      (if (not best) '(waiting91 no-supported-application)
        (let* ((m (list 'basis91 (+ 1 (dlm-length (dlm-nth s 4))) (dlm-nth best 1) (dlm-nth best 2)))
               (lib (dlm-append (dlm-nth s 4) (list m))))
          (list 'learn91 m (b91-rewrites (dlm-nth s 5) (dlm-nth s 2) lib)))))))

;;; infer.l — exhaustive positive Datalog closure over the minimal core.
(define *steps* 0)
(define *budget* 20000)
(define *exhausted* false)
(define-function l-spend ()
  (if (>= *steps* *budget*)
    (begin (set *exhausted* true) false)
    (begin (set *steps* (+ *steps* 1)) true)))

(define-function l-solve-pos (body facts sub)
  (if (not body) (list sub)
    (if (not (l-spend)) ()
      (let ((out ()))
        (list-do f facts
          (let ((s2 (l-unify-atom (car body) (l-fact-atom f) sub)))
            (if s2 (set out (l-append out (l-solve-pos (cdr body) facts s2))))))
        out))))
(define-function l-solve (body facts sub)
  (l-solve-pos body facts sub))
(define-function l-fact-in? (key facts)
  (l-any? (lambda (f) (equal key (l-atom-key (l-fact-atom f)))) facts))
(define-function l-lookup (atom table)
  (let ((out ()) (key (l-atom-key atom)))
    (list-do f table (if (equal key (l-atom-key (l-fact-atom f))) (set out (l-append out (list f))))) out))

(define-function l-derive (table rules next-id)
  (let ((new ()) (id next-id) (n 0))
    (list-do r rules
      (if (not *exhausted*)
        (list-do sub (l-solve (l-body r) table (l-subst ()))
          (let ((head (l-subst-atom (l-head r) sub)))
            (if (and (l-ground-atom? head)
                     (not (l-fact-in? (l-atom-key head) table))
                     (not (l-fact-in? (l-atom-key head) new)))
              (begin
                (set new (l-append new (list (l-fact (concat-strings "d" (number->string id)) head))))
                (set id (+ id 1)))))))
      (set n (+ n 1)))
    (list new id)))
(define-function l-close (facts rules budget)
  (set *steps* 0) (set *exhausted* false) (set *budget* budget)
  (let ((table facts) (id 0) (changed true))
    (while (and changed (not *exhausted*))
      (let* ((r (l-derive table rules id)) (new (car r)))
        (set id (l-nth r 1))
        (if new (set table (l-append table new)) (set changed false))))
    (list (if *exhausted* 'unknown 'complete) table *steps*)))

;;; synth.l — frontier-driven composition rule synthesis with checked admission.
(define-function s-synth (rule support) (list 'synth107 rule support))
(define-function s-synth? (x)
  (and (l-shape? x 3) (equal (car x) 'synth107) (l-rule? (l-nth x 1))
       (l-list? (l-nth x 2))))
(define-function s-rule (x) (l-nth x 1))
(define-function s-support (x) (l-nth x 2))

(define-function s-candidates (facts goal)
  (let ((a (l-nth (l-args goal) 0))
        (c (l-nth (l-args goal) 1))
        (out ()) (keys ()))
    (list-do f facts
      (let ((fa (l-fact-atom f)))
        (if (and (= 2 (l-len (l-args fa)))
                 (equal a (l-nth (l-args fa) 0))
                 (not (equal (l-pred fa) (l-pred goal))))
          (list-do g facts
            (let ((ga (l-fact-atom g)))
              (if (and (= 2 (l-len (l-args ga)))
                       (equal (l-nth (l-args fa) 1) (l-nth (l-args ga) 0))
                       (equal c (l-nth (l-args ga) 1))
                       (not (equal (l-pred ga) (l-pred goal))))
                (let* ((x (l-var 'x)) (y (l-var 'y)) (z (l-var 'z))
                       (r (l-rule (l-atom (l-pred goal) (list x z))
                            (list (l-atom (l-pred fa) (list x y))
                                  (l-atom (l-pred ga) (list y z)))))
                       (k (list (l-pred fa) (l-pred ga))))
                  (if (not (l-member? k keys))
                    (begin (set keys (l-append keys (list k)))
                           (set out (l-append out (list (s-synth r
                             (list (l-fact-id f) (l-fact-id g)))))))))))))))
    out))

(define-function s-conflict? (facts rules neg budget)
  (let ((table (p-close facts rules budget)))
    (l-any? (lambda (a) (l-lookup a table)) neg)))

(define-function s-synthesize (facts goal rules neg budget)
  (let ((cs (s-candidates facts goal)) (out ()))
    (list-do c cs
      (if (not out)
        (let ((rules2 (l-append rules (list (s-rule c)))))
          (let ((table (p-close facts rules2 budget)))
            (if (and (l-lookup goal table)
                     (not (s-conflict? facts rules2 neg budget)))
              (set out c))))))
    (if out out '(none))))

;;; Rank candidates by coverage of all training positives, then support.
(define-function s-coverage (facts rules positives budget)
  (let ((table (p-close facts rules budget)) (n 0))
    (list-do g positives (if (l-lookup g table) (set n (+ n 1))))
    n))
(define-function s-ranked-synthesize (facts positives neg rules budget)
  (let ((cs (s-candidates facts (car positives))) (best ()) (best-c -1) (best-s -1))
    (list-do c cs
      (let ((rules2 (l-append rules (list (s-rule c)))))
        (if (not (s-conflict? facts rules2 neg budget))
          (let ((cov (s-coverage facts rules2 positives budget))
                (sup (l-len (s-support c))))
            (if (or (> cov best-c) (and (= cov best-c) (> sup best-s)))
              (begin (set best c) (set best-c cov) (set best-s sup)))))))
    (if best best '(none))))

;;; Three-fact chain candidates: R(x,w) :- P(x,y), Q(y,z), S(z,w).
(define-function s-chain3-candidates (facts goal)
  (let ((a (l-nth (l-args goal) 0))
        (c (l-nth (l-args goal) 1))
        (out ()) (keys ()))
    (list-do f1 facts
      (let ((a1 (l-fact-atom f1)))
        (if (and (= 2 (l-len (l-args a1))) (equal a (l-nth (l-args a1) 0))
                 (not (equal (l-pred a1) (l-pred goal))))
          (list-do f2 facts
            (let ((a2 (l-fact-atom f2)))
              (if (and (= 2 (l-len (l-args a2)))
                       (equal (l-nth (l-args a1) 1) (l-nth (l-args a2) 0))
                       (not (equal (l-pred a2) (l-pred goal))))
                (list-do f3 facts
                  (let ((a3 (l-fact-atom f3)))
                    (if (and (= 2 (l-len (l-args a3)))
                             (equal (l-nth (l-args a2) 1) (l-nth (l-args a3) 0))
                             (equal c (l-nth (l-args a3) 1))
                             (not (equal (l-pred a3) (l-pred goal))))
                      (let* ((x (l-var 'x)) (y (l-var 'y)) (z (l-var 'z)) (w (l-var 'w))
                             (r (l-rule (l-atom (l-pred goal) (list x w))
                                  (list (l-atom (l-pred a1) (list x y))
                                        (l-atom (l-pred a2) (list y z))
                                        (l-atom (l-pred a3) (list z w)))))
                             (k (list (l-pred a1) (l-pred a2) (l-pred a3))))
                        (if (not (l-member? k keys))
                          (begin (set keys (l-append keys (list k)))
                                 (set out (l-append out (list (s-synth r
                                   (list (l-fact-id f1) (l-fact-id f2) (l-fact-id f3))))))))))))))))))
    out))
(define-function s-chain-synthesize (facts positives neg rules budget)
  (let ((cs (s-chain3-candidates facts (car positives))) (best ()) (best-c -1))
    (list-do c cs
      (let ((rules2 (l-append rules (list (s-rule c)))))
        (if (not (s-conflict? facts rules2 neg budget))
          (let ((cov (s-coverage facts rules2 positives budget)))
            (if (> cov best-c) (begin (set best c) (set best-c cov)))))))
    (if best best '(none))))

;;; Four-fact chain candidates: R(x,v) :- P(x,y), Q(y,z), S(z,w), T(w,v).
(define-function l-rev (xs)
  (if (not xs) () (l-append (l-rev (cdr xs)) (list (car xs)))))
(define-function s-chain4-candidates (facts goal)
  (let ((c3s (s-chain3-candidates facts goal)) (out ()) (keys ()))
    (list-do c3 c3s
      (let* ((r3 (s-rule c3))
             (body3 (l-body r3))
             (last (car (l-rev body3)))
             (mid (l-nth (l-args last) 1))
             (end (l-nth (l-args goal) 1))
             (x (l-nth (l-args (l-head r3)) 0))
             (v (l-var 'v)))
        (list-do f facts
          (let ((a (l-fact-atom f)))
            (if (and (= 2 (l-len (l-args a)))
                     (equal mid (l-nth (l-args a) 0))
                     (equal end (l-nth (l-args a) 1))
                     (not (equal (l-pred a) (l-pred goal))))
              (let* ((body4 (l-append body3 (list (l-atom (l-pred a) (list mid v)))))
                     (r4 (l-rule (l-atom (l-pred goal) (list x v)) body4))
                     (k (l-map (lambda (a) (l-pred a)) body4)))
                (if (not (l-member? k keys))
                  (begin (set keys (l-append keys (list k)))
                         (set out (l-append out (list (s-synth r4
                           (l-append (s-support c3) (list (l-fact-id f)))))))))))))))
    out))

;;; Generic bounded chain walker (length 2..max).
(define-function s-chainn-from (facts goal current vars i max body support)
  (let ((out ()))
    (if (and (>= i 2) (equal current (l-nth (l-args goal) 1)))
      (let ((r (l-rule (l-atom (l-pred goal) (list (l-nth vars 0) (l-nth vars i))) body)))
        (set out (list (s-synth r support)))))
    (if (< i max)
      (let ((next-var (l-nth vars (+ i 1))))
        (list-do f facts
          (let ((a (l-fact-atom f)))
            (if (and (= 2 (l-len (l-args a)))
                     (equal current (l-nth (l-args a) 0))
                     (not (equal (l-pred a) (l-pred goal))))
              (let ((r (s-chainn-from facts goal (l-nth (l-args a) 1) vars (+ i 1) max
                         (l-append body (list (l-atom (l-pred a) (list (l-nth vars i) next-var))))
                         (l-append support (list (l-fact-id f))))))
                (set out (l-append out r)))))))
    out))
(define-function l-arguments-key (c)
  (l-map (lambda (a) (l-pred a)) (l-body (s-rule c))))
(define-function s-chainn-candidates (facts goal max)
  (let ((vars (list (l-var 'x) (l-var 'y) (l-var 'z) (l-var 'w) (l-var 'v)))
        (out ()) (keys ()))
    (list-do c (s-chainn-from facts goal (l-nth (l-args goal) 0) vars 0 max () ())
      (let ((k (l-arguments-key c)))
        (if (not (l-member? k keys))
          (begin (set keys (l-append keys (list k))) (set out (l-append out (list c)))))))
    out))
)

;;; Simple bounded chain walker using module-local state.
(define *s-facts* ())
(define *s-goal* ())
(define *s-vars* ())
(define *s-max* 4)
(define *s-end* ())
(define *s-out* ())
(define *s-keys* ())
(define-function s-walk (current i body support)
  (begin
    (if (and (>= i 2) (equal current *s-end*))
      (let ((r (l-rule (l-atom (l-pred *s-goal*) (list (l-nth *s-vars* 0) (l-nth *s-vars* i))) body))
            (k (l-map (lambda (a) (l-pred a)) body)))
        (if (not (l-member? k *s-keys*))
          (begin (set *s-keys* (l-append *s-keys* (list k)))
                 (set *s-out* (l-append *s-out* (list (s-synth r support))))))))
    (if (< i *s-max*)
      (list-do f *s-facts*
        (let ((a (l-fact-atom f)))
          (if (and (= 2 (l-len (l-args a)))
                   (equal current (l-nth (l-args a) 0))
                   (not (equal (l-pred a) (l-pred *s-goal*))))
            (s-walk (l-nth (l-args a) 1) (+ i 1)
              (l-append body (list (l-atom (l-pred a)
                (list (l-nth *s-vars* i) (l-nth *s-vars* (+ i 1))))))
              (l-append support (list (l-fact-id f))))))))
    *s-out*))
(define-function s-walk-candidates (facts goal max)
  (begin
    (set *s-facts* facts) (set *s-goal* goal) (set *s-max* max)
    (set *s-vars* (list (l-var 'x) (l-var 'y) (l-var 'z) (l-var 'w) (l-var 'v)))
    (set *s-end* (l-nth (l-args goal) 1))
    (set *s-out* ()) (set *s-keys* ())
    (s-walk (l-nth (l-args goal) 0) 0 () ())
    *s-out*))

(define-function s-long-synthesize (facts positives neg rules budget)
  (let ((cs (l-append (s-candidates facts (car positives))
            (l-append (s-chain3-candidates facts (car positives))
                      (s-walk-candidates facts (car positives) 4))))
        (best ()) (best-c -1) (best-len 99))
    (list-do c cs
      (let ((rules2 (l-append rules (list (s-rule c)))))
        (if (not (s-conflict? facts rules2 neg budget))
          (let ((cov (s-coverage facts rules2 positives budget))
                (len (l-len (l-body (s-rule c)))))
            (if (or (> cov best-c) (and (= cov best-c) (< len best-len)))
              (begin (set best c) (set best-c cov) (set best-len len)))))))
    (if best best '(none))))

;;; Recursive program synthesis from direct target examples.
(define-function s-no-target (facts target)
  (l-filter (lambda (f) (not (equal (l-pred (l-fact-atom f)) target))) facts))
(define-function s-target-facts (facts target)
  (l-filter (lambda (f) (equal (l-pred (l-fact-atom f)) target)) facts))
(define-function s-uniq (xs)
  (let ((out ()))
    (list-do x xs (if (not (l-member? x out)) (set out (l-append out (list x)))))
    out))
(define *s-seeds* ())
(define *s-recs* ())
(define-function s-seed-try (f facts goal)
  (let* ((target (l-pred goal)) (a (l-fact-atom f)))
    (if (and (= 2 (l-len (l-args a))) (not (equal (l-pred a) target)))
      (let* ((u (l-nth (l-args a) 0)) (v (l-nth (l-args a) 1))
             (hit (l-lookup (l-atom target (list u v)) facts)))
        (if hit
          (let* ((x (l-var 'x)) (z (l-var 'z))
                 (r (l-rule (l-atom target (list x z))
                      (list (l-atom (l-pred a) (list x z)))))
                 (k (l-pred a)))
            (if (not (l-any? (lambda (c) (equal k (l-pred (l-nth (s-rule c) 2)))) *s-seeds*))
              (set *s-seeds* (l-append *s-seeds*
                (list (s-synth r (list (l-fact-id f)))))))))))))
(define-function s-rec-try (f g goal)
  (let* ((target (l-pred goal)) (a (l-fact-atom f)) (b (l-fact-atom g)))
    (if (and (= 2 (l-len (l-args a))) (= 2 (l-len (l-args b)))
             (not (equal (l-pred a) target))
             (equal (l-nth (l-args a) 1) (l-nth (l-args b) 0)))
      (let* ((x (l-var 'x)) (y (l-var 'y)) (z (l-var 'z))
             (r (l-rule (l-atom target (list x z))
                  (list (l-atom (l-pred a) (list x y))
                        (l-atom target (list y z)))))
             (k (l-pred a)))
        (if (not (l-any? (lambda (c) (equal k (l-pred (l-nth (s-rule c) 2)))) *s-recs*))
          (set *s-recs* (l-append *s-recs*
            (list (s-synth r (list (l-fact-id f) (l-fact-id g)))))))))))
(define-function s-seed-candidates (facts goal)
  (begin (set *s-seeds* ())
    (list-do f facts (s-seed-try f facts goal))
    *s-seeds*))
(define-function s-rec-candidates (facts goal)
  (begin (set *s-recs* ())
    (list-do f facts
      (list-do g (s-target-facts facts (l-pred goal)) (s-rec-try f g goal)))
    *s-recs*))
(define-function s-rec-program (rules support) (list 'recprogram107 rules support))
(define-function s-rec-program? (x)
  (and (l-shape? x 3) (equal (car x) 'recprogram107)
       (l-list? (l-nth x 1))
       (not (l-any? (lambda (r) (not (l-rule? r))) (l-nth x 1)))
       (l-list? (l-nth x 2))))
(define-function s-rec-rules (x) (l-nth x 1))
(define-function s-rec-support (x) (l-nth x 2))
(define-function s-rec-synthesize (facts positives neg budget)
  (let ((base (s-no-target facts (l-pred (car positives))))
        (seeds (s-seed-candidates facts (car positives)))
        (recs (s-rec-candidates facts (car positives)))
        (best ()) (best-c -1) (best-s 0))
    (list-do sd seeds
      (list-do rec recs
        (let ((rules (list (s-rule sd) (s-rule rec)))
              (support (s-uniq (l-append (s-support sd) (s-support rec)))))
          (if (not (s-conflict? base rules neg budget))
            (let ((cov (s-coverage base rules positives budget)))
              (if (or (> cov best-c) (and (= cov best-c) (> (l-len support) best-s)))
                (begin (set best (s-rec-program rules support))
                       (set best-c cov) (set best-s (l-len support)))))))))
    (if best best '(none))))

;;; Recursive program synthesis from one long positive and base edges only.
(define *s-tseeds* ())
(define *s-trecs* ())
(define-function s-seed-base-try (f goal)
  (let* ((target (l-pred goal)) (a (l-fact-atom f)))
    (if (and (= 2 (l-len (l-args a))) (not (equal (l-pred a) target)))
      (let* ((x (l-var 'x)) (z (l-var 'z))
             (r (l-rule (l-atom target (list x z))
                  (list (l-atom (l-pred a) (list x z)))))
             (k (l-pred a)))
        (if (not (l-any? (lambda (c) (equal k (l-pred (l-nth (s-rule c) 2)))) *s-tseeds*))
          (set *s-tseeds* (l-append *s-tseeds*
            (list (s-synth r (list (l-fact-id f)))))))))))
(define-function s-rec-goal-try (f goal)
  (let* ((target (l-pred goal)) (a (l-fact-atom f)))
    (if (and (= 2 (l-len (l-args a))) (not (equal (l-pred a) target)))
      (let* ((x (l-var 'x)) (y (l-var 'y)) (z (l-var 'z))
             (r (l-rule (l-atom target (list x z))
                  (list (l-atom (l-pred a) (list x y))
                        (l-atom target (list y z)))))
             (k (l-pred a)))
        (if (not (l-any? (lambda (c) (equal k (l-pred (l-nth (s-rule c) 2)))) *s-trecs*))
          (set *s-trecs* (l-append *s-trecs*
            (list (s-synth r (list (l-fact-id f)))))))))))
(define-function s-seed-base-candidates (facts goal)
  (begin (set *s-tseeds* ())
    (list-do f facts (s-seed-base-try f goal)) *s-tseeds*))
(define-function s-rec-goal-candidates (facts goal)
  (begin (set *s-trecs* ())
    (list-do f facts (s-rec-goal-try f goal)) *s-trecs*))
(define-function s-template-synthesize (facts positives neg budget)
  (let ((seeds (s-seed-base-candidates facts (car positives)))
        (recs (s-rec-goal-candidates facts (car positives)))
        (best ()) (best-c -1) (best-n 999))
    (list-do sd seeds
      (list-do rec recs
        (let ((rules (list (s-rule sd) (s-rule rec)))
              (support (s-uniq (l-append (s-support sd) (s-support rec)))))
          (if (not (s-conflict? facts rules neg budget))
            (let ((cov (s-coverage facts rules positives budget)))
              (if (or (> cov best-c)
                      (and (= cov best-c) (< (l-len rules) best-n)))
                (begin (set best (s-rec-program rules support))
                       (set best-c cov) (set best-n (l-len rules)))))))))
    (if best best '(none))))

;;; Counterexample-driven stride-2 recursive template.
;;; A one-step closure over-generalizes on a negative; a two-base-step
;;; seed and recursive step preserve parity and avoid it.
(define *s-s2seeds* ())
(define *s-s2recs* ())
(define-function s-seed2-try (f goal)
  (let* ((target (l-pred goal)) (a (l-fact-atom f)))
    (if (and (= 2 (l-len (l-args a))) (not (equal (l-pred a) target)))
      (let* ((x (l-var 'x)) (y (l-var 'y)) (z (l-var 'z))
             (r (l-rule (l-atom target (list x z))
                  (list (l-atom (l-pred a) (list x y))
                        (l-atom (l-pred a) (list y z)))))
             (k (l-pred a)))
        (if (not (l-any? (lambda (c) (equal k (l-pred (l-nth (s-rule c) 2)))) *s-s2seeds*))
          (set *s-s2seeds* (l-append *s-s2seeds*
            (list (s-synth r (list (l-fact-id f)))))))))))
(define-function s-rec2-try (f goal)
  (let* ((target (l-pred goal)) (a (l-fact-atom f)))
    (if (and (= 2 (l-len (l-args a))) (not (equal (l-pred a) target)))
      (let* ((x (l-var 'x)) (y (l-var 'y)) (w (l-var 'w)) (z (l-var 'z))
             (r (l-rule (l-atom target (list x z))
                  (list (l-atom (l-pred a) (list x y))
                        (l-atom (l-pred a) (list y w))
                        (l-atom target (list w z)))))
             (k (l-pred a)))
        (if (not (l-any? (lambda (c) (equal k (l-pred (l-nth (s-rule c) 2)))) *s-s2recs*))
          (set *s-s2recs* (l-append *s-s2recs*
            (list (s-synth r (list (l-fact-id f)))))))))))
(define-function s-seed2-candidates (facts goal)
  (begin (set *s-s2seeds* ())
    (list-do f facts (s-seed2-try f goal)) *s-s2seeds*))
(define-function s-rec2-candidates (facts goal)
  (begin (set *s-s2recs* ())
    (list-do f facts (s-rec2-try f goal)) *s-s2recs*))
(define-function s-stride2-synthesize (facts positives neg budget)
  (let ((seeds (s-seed2-candidates facts (car positives)))
        (recs (s-rec2-candidates facts (car positives)))
        (best ()) (best-c -1) (best-n 999))
    (list-do sd seeds
      (list-do rec recs
        (let ((rules (list (s-rule sd) (s-rule rec)))
              (support (s-uniq (l-append (s-support sd) (s-support rec)))))
          (if (not (s-conflict? facts rules neg budget))
            (let ((cov (s-coverage facts rules positives budget)))
              (if (or (> cov best-c)
                      (and (= cov best-c) (< (l-len rules) best-n)))
                (begin (set best (s-rec-program rules support))
                       (set best-c cov) (set best-n (l-len rules)))))))))
    (if best best '(none))))
(define-function s-revise-synthesize (facts positives neg budget)
  (let ((p1 (s-template-synthesize facts positives neg budget)))
    (if (s-rec-program? p1) p1 (s-stride2-synthesize facts positives neg budget))))

;;; General stride search: seed and step consume k base edges.
(define s-var-names '(x y z w v u t s r q p o n m))
(define-function s-vars (i n)
  (if (> i n) ()
    (l-append (list (l-var (l-nth s-var-names i))) (s-vars (+ i 1) n))))
(define-function s-path-atoms (pred vars i k)
  (if (>= i k) ()
    (l-append (list (l-atom pred (list (l-nth vars i) (l-nth vars (+ i 1)))))
              (s-path-atoms pred vars (+ i 1) k))))
(define-function s-seedk-rule (pred target k)
  (let ((vs (s-vars 0 k)))
    (l-rule (l-atom target (list (l-nth vs 0) (l-nth vs k)))
            (s-path-atoms pred vs 0 k))))
(define-function s-reck-rule (pred target k)
  (let* ((vs (s-vars 0 k))
         (zz (l-var (l-nth s-var-names (+ k 1)))))
    (l-rule (l-atom target (list (l-nth vs 0) zz))
            (l-append (s-path-atoms pred vs 0 k)
                      (list (l-atom target (list (l-nth vs k) zz)))))))
(define *s-kseeds* ())
(define *s-krecs* ())
(define-function s-seedk-try (f goal k)
  (let* ((target (l-pred goal)) (a (l-fact-atom f)))
    (if (and (= 2 (l-len (l-args a))) (not (equal (l-pred a) target)))
      (let ((p (l-pred a)))
        (if (not (l-any? (lambda (c) (equal p (l-pred (l-nth (s-rule c) 2)))) *s-kseeds*))
          (set *s-kseeds* (l-append *s-kseeds*
            (list (s-synth (s-seedk-rule p target k) (list (l-fact-id f)))))))))))
(define-function s-reck-try (f goal k)
  (let* ((target (l-pred goal)) (a (l-fact-atom f)))
    (if (and (= 2 (l-len (l-args a))) (not (equal (l-pred a) target)))
      (let ((p (l-pred a)))
        (if (not (l-any? (lambda (c) (equal p (l-pred (l-nth (s-rule c) 2)))) *s-krecs*))
          (set *s-krecs* (l-append *s-krecs*
            (list (s-synth (s-reck-rule p target k) (list (l-fact-id f)))))))))))
(define-function s-seedk-candidates (facts goal k)
  (begin (set *s-kseeds* ())
    (list-do f facts (s-seedk-try f goal k)) *s-kseeds*))
(define-function s-reck-candidates (facts goal k)
  (begin (set *s-krecs* ())
    (list-do f facts (s-reck-try f goal k)) *s-krecs*))
(define-function s-stride-synthesize (facts positives neg maxk budget)
  (let ((best ()) (best-c -1) (best-k 999))
    (let ((k 1))
      (while (<= k maxk)
        (let ((seeds (s-seedk-candidates facts (car positives) k))
              (recs (s-reck-candidates facts (car positives) k)))
          (list-do sd seeds
            (list-do rec recs
              (let ((rules (list (s-rule sd) (s-rule rec)))
                    (support (s-uniq (l-append (s-support sd) (s-support rec)))))
                (if (not (s-conflict? facts rules neg budget))
                  (let ((cov (s-coverage facts rules positives budget)))
                    (if (or (> cov best-c)
                            (and (= cov best-c) (< k best-k)))
                      (begin (set best (s-rec-program rules support))
                             (set best-c cov) (set best-k k)))))))))
        (set k (+ k 1))))
    (if best best '(none))))

;;; Two-predicate block synthesis: R(x,z) :- P(x,y), Q(y,z), and a
;;; recursive extension over the same ordered predicate pair.
(define *s-pair-seeds* ())
(define *s-pair-recs* ())
(define-function s-pair-key (p q) (list p q))
(define-function s-pair-known? (key xs)
  (l-any? (lambda (c) (equal key (l-nth c 2))) xs))
(define-function s-pair-seed-try (f g goal)
  (let* ((target (l-pred goal)) (a (l-fact-atom f)) (b (l-fact-atom g)))
    (if (and (= 2 (l-len (l-args a))) (= 2 (l-len (l-args b)))
             (not (equal (l-pred a) target))
             (not (equal (l-pred b) target))
             (equal (l-nth (l-args a) 1) (l-nth (l-args b) 0)))
      (let* ((p (l-pred a)) (q (l-pred b)) (key (s-pair-key p q))
             (x (l-var 'x)) (y (l-var 'y)) (z (l-var 'z))
             (r (l-rule (l-atom target (list x z))
                  (list (l-atom p (list x y)) (l-atom q (list y z))))))
        (if (not (s-pair-known? key *s-pair-seeds*))
          (set *s-pair-seeds* (l-append *s-pair-seeds*
            (list (s-synth r (list (l-fact-id f) (l-fact-id g)))))))))))
(define-function s-pair-rec-try (f g goal)
  (let* ((target (l-pred goal)) (a (l-fact-atom f)) (b (l-fact-atom g)))
    (if (and (= 2 (l-len (l-args a))) (= 2 (l-len (l-args b)))
             (not (equal (l-pred a) target))
             (not (equal (l-pred b) target))
             (equal (l-nth (l-args a) 1) (l-nth (l-args b) 0)))
      (let* ((p (l-pred a)) (q (l-pred b)) (key (s-pair-key p q))
             (x (l-var 'x)) (y (l-var 'y)) (w (l-var 'w)) (z (l-var 'z))
             (r (l-rule (l-atom target (list x z))
                  (list (l-atom p (list x y))
                        (l-atom q (list y w))
                        (l-atom target (list w z))))))
        (if (not (s-pair-known? key *s-pair-recs*))
          (set *s-pair-recs* (l-append *s-pair-recs*
            (list (s-synth r (list (l-fact-id f) (l-fact-id g)))))))))))
(define-function s-pair-seed-candidates (facts goal)
  (begin (set *s-pair-seeds* ())
    (list-do f facts
      (list-do g facts (s-pair-seed-try f g goal)))
    *s-pair-seeds*))
(define-function s-pair-rec-candidates (facts goal)
  (begin (set *s-pair-recs* ())
    (list-do f facts
      (list-do g facts (s-pair-rec-try f g goal)))
    *s-pair-recs*))
(define-function s-pair-synthesize (facts positives neg budget)
  (let ((seeds (s-pair-seed-candidates facts (car positives)))
        (recs (s-pair-rec-candidates facts (car positives)))
        (best ()) (best-c -1))
    (list-do sd seeds
      (list-do rec recs
        (let ((rules (list (s-rule sd) (s-rule rec)))
              (support (s-uniq (l-append (s-support sd) (s-support rec)))))
          (if (not (s-conflict? facts rules neg budget))
            (let ((cov (s-coverage facts rules positives budget)))
              (if (> cov best-c)
                (begin (set best (s-rec-program rules support))
                       (set best-c cov))))))))
    (if best best '(none))))

;;; Same-predicate transitivity candidates. The original generators require
;;; body predicates != head predicate; this is the missing single-predicate case.
(define-function s-trans-candidates (facts goal)
  (let ((a (l-nth (l-args goal) 0))
        (c (l-nth (l-args goal) 1))
        (p (l-pred goal))
        (out ()) (keys ()))
    (list-do f facts
      (let ((fa (l-fact-atom f)))
        (if (and (= 2 (l-len (l-args fa)))
                 (equal p (l-pred fa))
                 (equal a (l-nth (l-args fa) 0)))
          (list-do g facts
            (let ((ga (l-fact-atom g)))
              (if (and (= 2 (l-len (l-args ga)))
                       (equal p (l-pred ga))
                       (equal (l-nth (l-args fa) 1) (l-nth (l-args ga) 0))
                       (equal c (l-nth (l-args ga) 1)))
                (let* ((x (l-var 'x)) (y (l-var 'y)) (z (l-var 'z))
                       (r (l-rule (l-atom p (list x z))
                            (list (l-atom p (list x y))
                                  (l-atom p (list y z)))))
                       (k (list p p)))
                  (if (not (l-member? k keys))
                    (begin (set keys (l-append keys (list k)))
                           (set out (l-append out (list (s-synth r
                             (list (l-fact-id f) (l-fact-id g)))))))))))))))
    out))

(define-function s-trans-synthesize (facts goal rules neg budget)
  (let ((out ()))
    (list-do c (s-trans-candidates facts goal)
      (if (not out)
        (let ((rules2 (l-append rules (list (s-rule c)))))
          (let ((table (p-close facts rules2 budget)))
            (if (and (l-lookup goal table)
                     (not (s-conflict? facts rules2 neg budget)))
              (set out c))))))
    (if out out '(none))))

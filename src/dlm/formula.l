;;; P1: ground quantifier-free formulas only. No implicit universal closure.
;;; Every list spine and recursion depth is bounded before traversal.
(define-function sq-shape? (x n)
  (and (pair? x) (dlm-proper? x (+ n 1)) (= (dlm-length x) n)))
(define-function sq-name? (x) (or (symbol? x) (string? x)))
(define-function sq-constants? (xs)
  (or (not xs) (and (sq-shape? (car xs) 2) (= (car (car xs)) 'const)
    (sq-name? (dlm-nth (car xs) 1)) (sq-constants? (cdr xs)))))
(define-function sq-signature? (sig)
  (and (dlm-proper? sig 1000)
    (let ((seen ()) (ok true))
      (list-do entry sig
        (if (and (sq-shape? entry 2) (sq-name? (car entry))
                 (is <long> (dlm-nth entry 1)) (>= (dlm-nth entry 1) 0)
                 (<= (dlm-nth entry 1) 32) (not (dlm-member? (car entry) seen)))
            (set seen (cons (car entry) seen)) (set ok false))) ok)))
(define-function sq-formula-depth? (f sig fuel)
  (and (> fuel 0) (pair? f) (dlm-proper? f 5)
    (let ((tag (car f)) (n (dlm-length f)))
      (or (and (or (= tag 'top) (= tag 'bottom)) (= n 1))
          (and (= tag 'pred) (= n 3) (sq-name? (dlm-nth f 1))
               (dlm-proper? (dlm-nth f 2) 33) (sq-constants? (dlm-nth f 2))
               (let ((entry (dlm-assoc (dlm-nth f 1) sig)))
                 (and entry (= (dlm-nth entry 1) (dlm-length (dlm-nth f 2))))))
          (and (= tag 'not) (= n 2) (sq-formula-depth? (dlm-nth f 1) sig (- fuel 1)))
          (and (or (= tag 'and) (= tag 'or) (= tag 'imp)) (= n 3)
               (sq-formula-depth? (dlm-nth f 1) sig (- fuel 1))
               (sq-formula-depth? (dlm-nth f 2) sig (- fuel 1)))))))
(define-function sq-formula? (profile f sig)
  (and (= profile 'classical-prop-v1) (sq-signature? sig) (sq-formula-depth? f sig 64)))
(define-function sq-formulas? (xs sig)
  (and (dlm-proper? xs 256)
    (let ((ok true)) (list-do f xs (if (not (sq-formula-depth? f sig 64)) (set ok false))) ok)))
(define-function sq-atoms (f)
  (let ((tag (car f)))
    (if (= tag 'pred) (list f)
      (if (= tag 'not) (sq-atoms (dlm-nth f 1))
        (if (or (= tag 'and) (= tag 'or) (= tag 'imp))
            (dlm-union (sq-atoms (dlm-nth f 1)) (sq-atoms (dlm-nth f 2))) ())))))
(define-function sq-context-atoms (xs)
  (let ((out ())) (list-do f xs (set out (dlm-union out (sq-atoms f)))) out))

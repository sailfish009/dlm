;;; -*- mode: lisp; coding: us-ascii -*-
;;; Normal execution applies only the new transition. Restore checks the full log.
;;; Saving validates an immutable captured prefix cooperatively, then replaces data.
(define-function e79-transition (s e)
  (if (not (and (pair? e) (dlm-proper? e 6))) '(rejected event)
    (let ((op (car e)) (n (dlm-length e)))
      (cond
        ((and (= op 'prove) (= n 3)) (s79-proof-job s (dlm-nth e 1) (dlm-nth e 2)))
        ((and (= op 'study) (= n 3))
          (let ((next (s79-proof-job s (dlm-nth e 1) (dlm-nth e 2))))
            (if (= (car next) 'rejected) next
              (s79-job-put next (s79-field (s79-job next (dlm-nth e 1)) 8 true)))))
        ((and (= op 'program) (= n 3)) (s79-program-job s (dlm-nth e 1) (dlm-nth e 2)))
        ((and (= op 'run) (= n 2) (is <long> (dlm-nth e 1)) (>= (dlm-nth e 1) 0) (<= (dlm-nth e 1) s79-command-budget))
          (s79-run s (dlm-nth e 1)))
        ((and (= op 'resume) (= n 2)) (s79-program-resume s (dlm-nth e 1) false))
        ((and (= op 'next) (= n 2)) (s79-program-resume s (dlm-nth e 1) true))
        ((and (= op 'learn) (= n 3)) (i79-learn s (dlm-nth e 1) (dlm-nth e 2)))
        ((and (= op 'interpolate) (= n 5)) (i79-interpolate s (dlm-nth e 1) (dlm-nth e 2) (dlm-nth e 3) (dlm-nth e 4)))
        ((and (= op 'beth) (= n 5)) (i79-beth s (dlm-nth e 1) (dlm-nth e 2) (dlm-nth e 3) (dlm-nth e 4)))
        ((and (= op 'place) (= n 3) (is <long> (dlm-nth e 1)) (s79-unit s (dlm-nth e 1))
              (sq-shape? (dlm-nth e 2) 3)
              (let ((ok true)) (list-do x (dlm-nth e 2)
                (if (not (and (is <long> x) (>= x -100000) (<= x 100000))) (set ok false))) ok))
          (s79-unit-field s (dlm-nth e 1) 9 (dlm-nth e 2)))
        ((and (= op 'define) (= n 4)) (d79-define s (dlm-nth e 1) (dlm-nth e 2) (dlm-nth e 3)))
        ((and (= op 'use) (= n 4)) (d79-use s (dlm-nth e 1) (dlm-nth e 2) (dlm-nth e 3)))
        (else '(rejected event))))))
(define-function e79-replay (events)
  (if (not (dlm-proper? events s79-event-limit)) '(rejected event-limit)
    (let ((s (s79-new)) (budget 0))
      (list-do e events
        (if (not (= (car s) 'rejected))
            (begin
              (if (and (sq-shape? e 2) (= (car e) 'run) (is <long> (dlm-nth e 1)))
                  (set budget (+ budget (dlm-nth e 1))))
              (set s (if (> budget s79-replay-limit) '(rejected replay-budget) (e79-transition s e)))))) s)))
(define-function e79-snapshot? (x)
  (and (sq-shape? x 4) (= (car x) 'space-session79) (= (dlm-nth x 1) 1)
       (let ((s (e79-replay (dlm-nth x 3))))
         (and (= (car s) 'space79) (equal s (dlm-nth x 2))))))
(define-function e79-raw-read (path)
  (let ((fd (file-open-read path)))
    (if (not fd) '(missing)
      (if (is <long> fd) '(rejected access)
        (let* ((stream (file-stream fd)) (x (read stream)) (end (read stream)))
          (file-close fd)
          (if (= end +end+) (list 'data x) '(rejected trailing-data)))))))
(define *s79-space* (s79-new))
(define *s79-events* ())
(define *s79-requested* 0)
(define *s79-path* ())
(define *s79-lock* ())
(define *s79-expected* '(missing))
(define *s79-save-task* ())
(define *s79-save-result* '(not-saved))
(define-function e79-summary ()
  (let ((jobs ())) (list-do entry (dlm-nth *s79-space* 7)
    (let ((j (dlm-nth entry 1)))
      (set jobs (cons (list (dlm-nth j 1) (dlm-nth j 2) (dlm-nth j 3)) jobs))))
    (list 'space79 'epoch (dlm-nth *s79-space* 2) 'ticks (dlm-nth *s79-space* 10)
      'units (dlm-nth *s79-space* 9) 'queued (+ (dlm-length (dlm-nth *s79-space* 5)) (dlm-length (dlm-nth *s79-space* 6)))
      'patterns (dlm-length (dlm-nth *s79-space* 8)) 'definitions (dlm-length (dlm-nth *s79-space* 12))
      'stats (dlm-nth *s79-space* 11) 'jobs (s79-reverse jobs)
      'save (if *s79-save-task* 'validating *s79-save-result*))))
(define-function e79-commit (event)
  (let ((n (if (and (sq-shape? event 2) (= (car event) 'run)) (dlm-nth event 1) 0)))
    (if (or (>= (dlm-length *s79-events*) s79-event-limit) (not (is <long> n))
            (< n 0) (> (+ *s79-requested* n) s79-replay-limit)) '(rejected log-capacity)
      (let ((next (e79-transition *s79-space* event)))
        (if (= (car next) 'rejected) next
          (begin
            (set *s79-space* next) (set *s79-events* (dlm-append *s79-events* (list event)))
            (set *s79-requested* (+ *s79-requested* n)) (e79-summary)))))))
(define-function e79-open (path)
  (if (not (and (string? path) (not *s79-path*) (equal *s79-space* (s79-new)))) '(rejected close-first)
    (let ((lock (file-lock (concat-strings path ".lock"))))
      (if (not lock) '(rejected locked-or-path)
        (let ((old (e79-raw-read path)))
          (if (or (= (car old) 'rejected)
                  (and (= (car old) 'data) (not (e79-snapshot? (dlm-nth old 1)))))
              (begin (file-close lock) '(rejected space-snapshot))
            (begin
              (if (= (car old) 'data)
                  (begin (set *s79-space* (dlm-nth (dlm-nth old 1) 2))
                         (set *s79-events* (dlm-nth (dlm-nth old 1) 3))))
              (set *s79-requested* 0)
              (list-do e *s79-events*
                (if (= (car e) 'run) (set *s79-requested* (+ *s79-requested* (dlm-nth e 1)))))
              (set *s79-lock* lock) (set *s79-path* path) (set *s79-expected* old)
              (list 'space-opened (if (= (car old) 'data) 'restored 'empty)))))))))
(define-function e79-save-begin ()
  (if (not *s79-path*) '(not-attached)
    (if *s79-save-task* '(save-already-pending)
      (begin
        (set *s79-save-task* (list (list 'space-session79 1 *s79-space* *s79-events*) *s79-events* (s79-new)))
        (set *s79-save-result* '(validating)) '(save-pending)))))
(define-function e79-write-verified (snapshot)
  (let ((tmp (concat-strings *s79-path* ".next")) (ok true))
    (set ok (equal (e79-raw-read *s79-path*) *s79-expected*))
    (if ok (set ok (d77-write tmp snapshot)))
    (if ok (set ok (equal (e79-raw-read tmp) (list 'data snapshot))))
    (if (and ok (= (car *s79-expected*) 'data))
        (let ((prev (concat-strings *s79-path* ".previous.next")))
          (set ok (and (d77-write prev (dlm-nth *s79-expected* 1))
                       (file-replace prev (concat-strings *s79-path* ".previous"))))))
    (if ok (set ok (file-replace tmp *s79-path*)))
    (if ok (begin (set *s79-expected* (list 'data snapshot)) (list 'saved *s79-path* 'prefix-events (dlm-length (dlm-nth snapshot 3))))
      (begin (file-remove tmp) '(rejected checkpoint-changed-or-write)))))
(define-function e79-save-step ()
  (if *s79-save-task*
      (let ((snapshot (car *s79-save-task*)) (todo (dlm-nth *s79-save-task* 1)) (replay (dlm-nth *s79-save-task* 2)))
        (if todo
            (let ((next (e79-transition replay (car todo))))
              (if (= (car next) 'rejected)
                  (begin (set *s79-save-task* ()) (set *s79-save-result* '(rejected replay)))
                (set *s79-save-task* (list snapshot (cdr todo) next))))
          (begin
            (set *s79-save-result* (if (equal replay (dlm-nth snapshot 2))
              (e79-write-verified snapshot) '(rejected replay-mismatch)))
            (set *s79-save-task* ())))))
  *s79-save-result*)
(define-function e79-save ()
  (if (not *s79-path*) '(not-attached)
    (begin
      (while *s79-save-task* (e79-save-step))
      (e79-save-begin)
      (while *s79-save-task* (e79-save-step)) *s79-save-result*)))
(define-function e79-close ()
  (repl-idle-task ())
  (let ((r (if *s79-path* (e79-save) '(saved))))
    (if (not (= (car r) 'saved)) r
      (begin (if *s79-lock* (file-close *s79-lock*))
        (set *s79-lock* ()) (set *s79-path* ()) (set *s79-space* (s79-new))
        (set *s79-events* ()) (set *s79-requested* 0) (set *s79-expected* '(missing))
        (set *s79-save-task* ()) '(space-closed)))))
(define-function e79-tick ()
  (if (>= (dlm-nth *s79-space* 9) s79-unit-reserve-start)
      (begin (repl-idle-task ()) (print "Space capacity reached; obligations remain incomplete.\n"))
  (if (or (dlm-nth *s79-space* 5) (dlm-nth *s79-space* 6))
      (let ((r (e79-commit '(run 8))))
        (if (= (car r) 'rejected) (begin (repl-idle-task ()) (print r "\n"))))))
  (if *s79-save-task* (e79-save-step))
  (if (and (not (dlm-nth *s79-space* 5)) (not (dlm-nth *s79-space* 6)) (not *s79-save-task*))
      (begin (repl-idle-task ()) (print "Space quiescent: " (e79-summary) "\n"))))
(define-function space args
  (let ((op (car args)) (rest (cdr args)) (n (dlm-length (cdr args))))
    (cond
      ((and (= op 'status) (= n 0)) (e79-summary))
      ((and (= op 'inspect) (= n 0)) *s79-space*)
      ((and (= op 'job) (= n 1)) (s79-job *s79-space* (car rest)))
      ((and (= op 'unit) (= n 1)) (s79-unit *s79-space* (car rest)))
      ((and (= op 'library) (= n 0)) (dlm-nth *s79-space* 8))
      ((and (= op 'definitions) (= n 0)) (dlm-nth *s79-space* 12))
      ((and (= op 'open) (= n 1)) (e79-open (car rest)))
      ((and (= op 'save) (= n 0)) (e79-save))
      ((and (= op 'save-async) (= n 0)) (e79-save-begin))
      ((and (= op 'save-step) (= n 0)) (e79-save-step))
      ((and (= op 'close) (= n 0)) (e79-close))
      ((and (= op 'pause) (= n 0)) (repl-idle-task ()) '(paused))
      ((and (= op 'start) (= n 1) (is <long> (car rest)) (>= (car rest) 20) (<= (car rest) 60000))
        (d77-pause) (repl-idle-task '(e79-tick) (car rest)) '(space-scheduled))
      ((and (= op 'step) (= n 1)) (e79-commit (cons 'run rest)))
      ((and (or (= op 'prove) (= op 'study) (= op 'program) (= op 'learn)) (= n 2)) (e79-commit args))
      ((and (or (= op 'interpolate) (= op 'beth)) (= n 4)) (e79-commit args))
      ((and (or (= op 'define) (= op 'use)) (= n 3)) (e79-commit args))
      ((and (= op 'place) (= n 2)) (e79-commit args))
      ((and (or (= op 'resume) (= op 'next)) (= n 1)) (e79-commit args))
      ((and (= op 'help) (= n 0))
        (print "space79: prove/study NAME PROBLEM; program NAME TASKS; learn NAME PROOF-JOB; step EVENTS; start MS; pause\n"
          "interpolate NAME SIGNATURE A B; beth NAME SIGNATURE THEORY TARGET; define NAME SIGNATURE BODY; use NAME DEFINITION PREMISES\n"
          "status; job NAME; unit ID; inspect; library; definitions; open PATH; save; save-async; save-step; close\n") '(commands-listed))
      (else '(rejected space-command)))))

;;; One candidate/admission lifecycle over the shared library. Existing numeric
;;; and composite definitions guide typed candidate construction. Search is the
;;; bounded native EML93 grammar generator, not its independent learner/state.
(define *c95-output-reuse* true) ; explicit ablation policy, not learned knowledge
(define-function c95-port-pool (s rel)
  (let ((out ()))
    (if *c95-output-reuse*
      (list-do m (dlm-nth s 4)
        (if (and (c95-composite? m) (= (dlm-nth m 2) (dlm-nth rel 1))
              (c95-scope (dlm-nth (dlm-nth s 8) 4) 'composite95 (dlm-nth m 1)))
          (set out (dlm-append out (list (list 'output95 (dlm-nth m 1))))))))
    (list-do role (b91-range (b91-arity (dlm-nth rel 2)))
      (set out (dlm-append out (list (list 'measure95 role))))) out))
(define-function c95-port-tuples (pool arity)
  (let ((out ()))
    (if (= arity 1) (list-do a pool (set out (dlm-append out (list (list a)))))
      (list-do a pool (list-do b pool (if (not (equal a b)) (set out (dlm-append out (list (list a b)))))))) out))
(define-function c95-active-channel (s channel)
  (let ((found false)) (list-do v (dlm-nth (dlm-nth s 8) 4)
    (if (and (= (dlm-nth v 1) 'composite95) (equal (dlm-nth v 2) channel)) (set found true))) found))
(define-function c95-proposal (source defs rel ports ready examples values trials searches fuel)
  (list 'proposal95 source defs
    (list 'claim95 (dlm-nth rel 1) ports ready (dlm-nth examples 2) (dlm-nth examples 3) values)
    (list 'formation-metrics95 trials searches fuel (if *c95-output-reuse* 'reuse95 'no-output-reuse95))))
(define-function c95-propose (s source cost fuel)
  (let* ((f (dlm-nth s 8)) (channel (e93-find (dlm-nth f 3) source)) (lib (dlm-nth s 4))
         (nlib (c95-number-lib lib)) (scopes (dlm-nth f 4)) (found ()) (trials 0) (searches 0) (unknown false))
    (cond ((not channel) '(rejected95 source)) ((c95-active-channel s source) '(waiting95 covered))
      ((>= (dlm-length lib) 8) '(waiting95 capacity))
      (else
        (list-do rel (b91-relations lib)
          (if (and (not found) (not unknown) (= (b91-arity (dlm-nth rel 2)) (dlm-length (dlm-nth (car (dlm-nth channel 6)) 2))))
            (let ((pool (c95-port-pool s rel)))
              ;; Prefer reuse of an admitted numeric definition, then formation.
              (list-do num lib
                (if (and (not found) (not unknown) (c95-numeric? num))
                  (list-do ports (c95-port-tuples pool (dlm-nth num 2))
                    (if (and (not found) (not unknown))
                      (let ((examples (c95-paired s channel rel ports scopes false fuel)))
                        (set fuel (dlm-nth examples 4)) (set trials (+ trials 1))
                        (if (= (dlm-nth examples 1) 'unknown) (if (= fuel 0) (set unknown true)))
                        (if (= (dlm-nth examples 1) 'complete)
                          (let* ((ready (c95-ready-cell (dlm-nth examples 2))) (ns (c95-scope scopes 'numeric95 (dlm-nth num 1))))
                            (if (and ready ns (dlm-member? ready (dlm-nth ns 5)))
                              (let ((fit (e93-fit (e93-call (dlm-nth num 1) (dlm-nth num 2))
                                           (e93-cell-rows (dlm-nth examples 2) ready) nlib (dlm-nth f 1) 1000 (e93-runtime fuel))))
                                (set fuel (dlm-nth (dlm-nth fit 3) 1))
                                (if (= (dlm-nth fit 1) 'unknown) (set unknown true))
                                (if (= (dlm-nth fit 1) 'matched)
                                  (set found (c95-proposal source
                                    (list (list 'composite95 (+ 1 (dlm-length lib)) (dlm-nth rel 1) (dlm-nth num 1) ports source))
                                    rel ports ready examples (dlm-nth fit 2) trials searches fuel))))))))))))
              (list-do arity '(1 2)
                (list-do ports (c95-port-tuples pool arity)
                  (if (and (not found) (not unknown) (<= (+ 2 (dlm-length lib)) 8))
                    (let ((examples (c95-paired s channel rel ports scopes false fuel)))
                      (set fuel (dlm-nth examples 4)) (set trials (+ trials 1))
                      (if (= (dlm-nth examples 1) 'unknown) (if (= fuel 0) (set unknown true)))
                      (if (= (dlm-nth examples 1) 'complete)
                        (let ((ready (c95-ready-cell (dlm-nth examples 2))))
                          (if ready
                            (let ((search (e93-search arity (e93-cell-rows (dlm-nth examples 2) ready)
                                             nlib (dlm-nth f 1) cost fuel)))
                              (set searches (+ searches 1)) (set fuel (- fuel (dlm-nth (dlm-nth search 3) 3)))
                              (if (= (dlm-nth search 1) 'unknown) (set unknown true))
                              (if (= (dlm-nth search 1) 'found)
                                (let* ((fit (dlm-nth search 2)) (id (+ 1 (dlm-length lib)))
                                       (num (list 'numeric95 id arity (car fit) (dlm-nth fit 1) (dlm-nth f 1)
                                               (list 'paired95 source (dlm-nth rel 1) ports)))
                                       (composite (list 'composite95 (+ 1 id) (dlm-nth rel 1) id ports source)))
                                  (set found (c95-proposal source (list num composite) rel ports ready examples
                                               (dlm-nth fit 2) trials searches fuel)))))))))))))))
        (if found found (list 'waiting95 (if unknown 'unknown 'no-supported-candidate)
          (list 'formation-metrics95 trials searches fuel)))))))
(define-function c95-check-proposal (s p)
  (and (sq-shape? p 5) (= (car p) 'proposal95) (not (c95-active-channel s (dlm-nth p 1)))
    (let* ((defs (dlm-nth p 2)) (claim (dlm-nth p 3)) (lib (dlm-nth s 4))
           (channel (e93-find (dlm-nth (dlm-nth s 8) 3) (dlm-nth p 1))))
      (and channel defs (dlm-proper? defs 2) (sq-shape? claim 7) (= (car claim) 'claim95)
        (b91-library? (dlm-append lib defs) (dlm-nth s 2))
        (let* ((comp (car (s79-reverse defs))) (rel (b91-module lib (dlm-nth claim 1)))
               (num (b91-module (dlm-append lib defs) (dlm-nth comp 3))))
          (and (c95-composite? comp) (b91-relational? rel) (c95-numeric? num)
            (= (dlm-nth num 5) (dlm-nth (dlm-nth s 8) 1))
            (= (dlm-nth comp 2) (dlm-nth rel 1)) (equal (dlm-nth comp 4) (dlm-nth claim 2))
            (equal (dlm-nth comp 5) (dlm-nth p 1))
            (if (= (dlm-length defs) 2)
              (and (c95-numeric? (car defs)) (= (dlm-nth num 1) (dlm-nth (car defs) 1))
                (equal (dlm-nth num 6) (list 'paired95 (dlm-nth p 1) (dlm-nth rel 1) (dlm-nth claim 2)))
                (not (e93-known-expansion? (dlm-nth num 4) (dlm-nth num 2) (c95-number-lib lib))))
              (and (b91-module lib (dlm-nth num 1))
                (let ((ns (c95-scope (dlm-nth (dlm-nth s 8) 4) 'numeric95 (dlm-nth num 1))))
                  (and ns (dlm-member? (dlm-nth claim 3) (dlm-nth ns 5))))))
            (e93-cells? (list (dlm-nth claim 3)) (dlm-nth num 2))
            (let ((examples (c95-paired s channel rel (dlm-nth claim 2) (dlm-nth (dlm-nth s 8) 4) true 200000)))
              (and (= (dlm-nth examples 1) 'complete) (equal (dlm-nth examples 2) (dlm-nth claim 4))
                (equal (dlm-nth examples 3) (dlm-nth claim 5))
                (let ((rows (e93-cell-rows (dlm-nth examples 2) (dlm-nth claim 3))))
                  (and (>= (dlm-length rows) 3) (dlm-proper? (dlm-nth claim 6) 12)
                    (e93-check-values (dlm-nth num 4) rows (dlm-nth claim 6) (dlm-nth num 5) 1000)))))))))))

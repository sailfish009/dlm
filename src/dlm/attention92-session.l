;;; Replay-admitted pause/resume, atomic checkpoint-before-publication.
;;; Standalone immutable model context: historical snapshots are not revocation
;;; services. Start a new context from a current model after source changes.
(define-function a92-pack (s)
  (list 'attention-session92 1 (dlm-nth s 2) (a92-work s) (dlm-nth s 5)))
(define-function a92-replay (ctx events)
  (if (not (and (a92-context? ctx) (dlm-proper? events 64))) '(rejected92 snapshot)
    (let ((s (a92-new (dlm-nth ctx 1) (dlm-nth ctx 2) (dlm-nth ctx 3) (dlm-nth ctx 4) (dlm-nth ctx 5))))
      (list-do cmd events (if (= (car s) 'attention-state92) (set s (a92-step s cmd)))) s)))
(define-function a92-snapshot? (x)
  (and (sq-shape? x 5) (= (car x) 'attention-session92) (= (dlm-nth x 1) 1)
       (a92-context? (dlm-nth x 2)) (dlm-proper? (dlm-nth x 4) 64)
    (let ((s (a92-replay (dlm-nth x 2) (dlm-nth x 4))))
      (and (= (car s) 'attention-state92) (equal (a92-work s) (dlm-nth x 3))))))
(define-function a92-checkpoint (path snapshot expected)
  (if (not (and (a92-snapshot? snapshot) (equal (e79-raw-read path) expected))) false
    (let ((tmp (concat-strings path ".next")) (ok true))
      (set ok (and (d77-write tmp snapshot) (equal (e79-raw-read tmp) (list 'data snapshot))))
      (if (and ok (= (car expected) 'data))
        (let ((prior (concat-strings path ".previous.next")))
          (set ok (and (d77-write prior (dlm-nth expected 1)) (equal (e79-raw-read prior) expected)
            (file-replace prior (concat-strings path ".previous"))))))
      (if ok (set ok (and (equal (e79-raw-read path) expected) (file-replace tmp path))))
      (if (not ok) (file-remove tmp)) ok)))
(define *a92-state* ())
(define *a92-path* ())
(define *a92-lock* ())
(define *a92-expected* '(missing))
(define-function a92-summary ()
  (if (not *a92-state*) '(attention92 not-started)
    (let ((ctx (dlm-nth *a92-state* 2)) (w (a92-work *a92-state*)))
      (list 'attention92 'phase (dlm-nth w 7) 'episode (dlm-nth ctx 2)
        'version (dlm-nth (a92-episode ctx) 2) 'epoch (dlm-nth (dlm-nth ctx 1) 5)
        'remaining (dlm-length (dlm-nth w 1)) 'steps (dlm-length (dlm-nth *a92-state* 5))
        'fuel (dlm-nth w 8) 'store *a92-path*))))
(define-function a92-commit (cmd)
  (if (not *a92-state*) '(rejected92 start-first)
    (let ((next (a92-step *a92-state* cmd)))
      (if (= (car next) 'rejected92) next
        (let ((snapshot (a92-pack next)))
          (if (and *a92-path* (not (a92-checkpoint *a92-path* snapshot *a92-expected*))) '(rejected92 checkpoint)
            (begin (set *a92-state* next)
              (if *a92-path* (set *a92-expected* (list 'data snapshot))) (a92-summary))))))))
(define-function a92-save ()
  (if (not (and *a92-path* *a92-state*)) '(rejected92 not-attached)
    (let ((snapshot (a92-pack *a92-state*)))
      (if (a92-checkpoint *a92-path* snapshot *a92-expected*)
        (begin (set *a92-expected* (list 'data snapshot)) '(saved92)) '(rejected92 checkpoint)))))
(define-function a92-open (path)
  (if (not (and (string? path) (not (equal path "")) (not *a92-path*))) '(rejected92 path-or-close-first)
    (let ((lock (file-lock (concat-strings path ".lock"))))
      (if (not lock) '(rejected92 locked-or-path)
        (let ((old (e79-raw-read path)) (incoming ()) (ok true))
          (cond
            ((and (= (car old) 'missing) *a92-state*) (set incoming *a92-state*))
            ((and (= (car old) 'data) (a92-snapshot? (dlm-nth old 1)))
              (set incoming (a92-replay (dlm-nth (dlm-nth old 1) 2) (dlm-nth (dlm-nth old 1) 4)))
              (if (and *a92-state* (not (equal incoming *a92-state*))) (set ok false)))
            (else (set ok false)))
          (if (not ok) (begin (file-close lock) '(rejected92 snapshot-or-start-first))
            (begin (set *a92-state* incoming) (set *a92-lock* lock) (set *a92-path* path)
              (set *a92-expected* old) (a92-summary))))))))
(define-function a92-close ()
  (if (not *a92-path*) '(closed92)
    (let ((r (a92-save))) (if (not (= (car r) 'saved92)) r
      (begin (file-close *a92-lock*) (set *a92-lock* ()) (set *a92-path* ())
        (set *a92-expected* '(missing)) '(closed92))))))
(define-function attention92 args
  (let ((op (car args)) (rest (cdr args)) (n (dlm-length (cdr args))))
    (cond
      ((and (= op 'reset) (= n 0) (not *a92-path*)) (set *a92-state* ()) '(reset92))
      ((and (= op 'start) (= n 5) (not *a92-path*))
        (let ((s (a92-new (car rest) (dlm-nth rest 1) (dlm-nth rest 2) (dlm-nth rest 3) (dlm-nth rest 4))))
          (if (= (car s) 'rejected92) s (begin (set *a92-state* s) (a92-summary)))))
      ((and (= op 'query) (= n 5))
        (a92-query (car rest) (dlm-nth rest 1) (dlm-nth rest 2) (dlm-nth rest 3) (dlm-nth rest 4)))
      ((and (= op 'open) (= n 1)) (a92-open (car rest)))
      ((and (= op 'save) (= n 0)) (a92-save))
      ((and (= op 'close) (= n 0)) (a92-close))
      ((and (= op 'status) (= n 0)) (a92-summary))
      ((and (= op 'state) (= n 0)) *a92-state*)
      ((and (= op 'restore) (= n 1) (not *a92-path*) (a92-snapshot? (car rest)))
        (set *a92-state* (a92-replay (dlm-nth (car rest) 2) (dlm-nth (car rest) 4))) (a92-summary))
      ((and *a92-state* (= n 0) (= op 'snapshot)) (a92-pack *a92-state*))
      ((and *a92-state* (= n 0) (= op 'result)) (a92-result *a92-state*))
      ((and *a92-state* (= n 0) (= op 'proposal))
        (if (and (= (dlm-nth (a92-work *a92-state*) 7) 'ready) (dlm-nth (a92-work *a92-state*) 1))
          (dlm-nth (a92-choice *a92-state*) 1) (a92-next *a92-state*)))
      ((and *a92-state* (= op 'step) (= n 1)) (a92-commit (car rest)))
      ((and *a92-state* (= op 'tick) (= n 0))
        (if (= (car (a92-next *a92-state*)) 'halt92) (a92-result *a92-state*) (a92-commit (a92-next *a92-state*))))
      ((and *a92-state* (= op 'run) (= n 1) (is <long> (car rest)) (> (car rest) 0) (<= (car rest) 64))
        (let ((i 0) (r ()))
          (while (and (< i (car rest)) (not (= (car (a92-next *a92-state*)) 'halt92)) (not (= (car r) 'rejected92)))
            (set r (a92-commit (a92-next *a92-state*))) (set i (+ i 1)))
          (if (= (car r) 'rejected92) r (a92-result *a92-state*))))
      (else '(rejected92 command-or-arity)))))

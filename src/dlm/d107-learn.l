;;; d107-learn.l — the data stays; the logical basis moves.
;;; Candidates come from residual structure in the observations. Support counts
;;; distinct records (one observation = one record), never repetitions inside a
;;; record. Admission is a checked expansion equality, not a score.

(define *p107-max-record-facts* 24)

(define-function p107-sort-pairs (ps)
  (if (not ps) ()
    (let ((head (car ps)) (less ()) (more ()))
      (list-do p (cdr ps)
        (if (> (string-compare (car p) (car head)) 0)
          (set more (p107-append more (list p)))
          (set less (p107-append less (list p)))))
      (p107-append (p107-sort-pairs less) (p107-append (list head) (p107-sort-pairs more))))))
(define-function p107-sort-atoms (atoms)
  (let ((pairs (p107-map (lambda (a) (cons (p107-serialize a) a)) atoms)))
    (p107-map cdr (p107-sort-pairs pairs))))

;;; structure, not content: each distinct constant in a record becomes a variable
(define-function p107-abstract-atoms (atoms)
  (let ((map ()) (i 0))
    (list-do a atoms
      (list-do c (p107-args a)
        (if (and (not (p107-var? c)) (not (p107-assoc c map)))
          (begin (set map (p107-append map (list (list c (p107-var (string->symbol
                   (concat-strings "v" (number->string i))))))))
                 (set i (+ i 1))))))
    (p107-map (lambda (a) (p107-atom (p107-pred a)
      (p107-map (lambda (c) (let ((h (p107-assoc c map))) (if h (p107-nth h 1) c))) (p107-args a)))) atoms)))

(define-function p107-patterns2 (facts)
  (let ((out ()) (i 0) (n (p107-len facts)))
    (while (< i n)
      (let ((j 0))
        (while (< j n)
          (if (< i j)
            (let* ((a (p107-nth facts i)) (b (p107-nth facts j))
                   (aa (p107-abstract-atoms (list (p107-nth a 2) (p107-nth b 2))))
                   (p (p107-sort-atoms aa))
                   (k (p107-conj-key p)))
              (if (and (p107-connected? p)
                       (not (p107-any? (lambda (x) (equal k (p107-conj-key x))) out)))
                (set out (p107-append out (list p))))))
          (set j (+ j 1))))
      (set i (+ i 1)))
    out))

(define-function p107-patterns3 (facts)
  (let ((out ()) (i 0) (n (p107-len facts)))
    (while (< i n)
      (let ((j 0))
        (while (< j n)
          (let ((k 0))
            (while (< k n)
              (if (and (< i j) (< j k))
                (let* ((a (p107-nth facts i)) (b (p107-nth facts j)) (c (p107-nth facts k))
                       (aa (p107-abstract-atoms (list (p107-nth a 2) (p107-nth b 2) (p107-nth c 2))))
                       (p (p107-sort-atoms aa))
                       (key (p107-conj-key p)))
                  (if (and (p107-connected? p)
                           (not (p107-any? (lambda (x) (equal key (p107-conj-key x))) out)))
                    (set out (p107-append out (list p))))))
              (set k (+ k 1))))
          (set j (+ j 1))))
      (set i (+ i 1)))
    out))

(define-function p107-align-args (a b map)
  (cond ((not a) map) ((not b) 'align-failed)
        ((and (p107-var? (car a)) (p107-var? (car b)))
          (let ((old (p107-assoc (car a) map)))
            (if old (if (equal (p107-nth old 1) (car b)) (p107-align-args (cdr a) (cdr b) map) 'align-failed)
              (p107-align-args (cdr a) (cdr b) (p107-append map (list (list (car a) (car b))))))))
        ((equal (car a) (car b)) (p107-align-args (cdr a) (cdr b) map))
        (else 'align-failed)))
(define-function p107-align-atoms (p s map)
  (if (not p) (list 'ok map)
    (if (not s) 'align-failed
      (let ((o (p107-align-args (p107-args (car p)) (p107-args (car s)) map)))
        (if (equal o 'align-failed) 'align-failed (p107-align-atoms (cdr p) (cdr s) o))))))
(define-function p107-align-subset (p d)
  (if (not (equal (p107-conj-key p) (p107-conj-key (p107-def-pattern d)))) 'align-failed
    (let ((r (p107-align-atoms (p107-sort-atoms (p107-def-pattern d)) (p107-sort-atoms p) ())))
      (if (equal r 'align-failed) 'align-failed (p107-nth r 1)))))

(define-function p107-pairs-of (atoms)
  (let ((out ()) (i 0) (n (p107-len atoms)))
    (while (< i n)
      (let ((j 0))
        (while (< j n)
          (if (< i j)
            (let ((rest ()) (k 0))
              (while (< k n)
                (if (and (not (= k i)) (not (= k j))) (set rest (p107-append rest (list (p107-nth atoms k)))))
                (set k (+ k 1)))
              (set out (p107-append out (list (list (p107-sort-atoms (list (p107-nth atoms i) (p107-nth atoms j)))
                                                  rest))))))
          (set j (+ j 1))))
      (set i (+ i 1)))
    out))

(define-function p107-3-decomposition (pattern s)
  (let ((out ()))
    (list-do d (p107-active-defs s)
      (if (and (not out) (= (p107-len (p107-def-pattern d)) 2))
        (let ((pairs (p107-pairs-of pattern)) (i 0))
          (while (and (< i (p107-len pairs)) (not out))
            (let* ((pair (p107-nth pairs i)) (bind (p107-align-subset (p107-nth pair 0) d)))
              (if (and (not (equal bind 'align-failed)) (= (p107-len (p107-nth pair 1)) 1))
                (set out (list d (p107-nth (p107-nth pair 1) 0) bind))))
            (set i (+ i 1))))))
    out))

(define-function p107-try3 (s)
  (let ((best ()) (best-support 0) (obs (p107-obs-list s)) (i 0))
    (while (< i (p107-len obs))
      (let ((o (p107-nth obs i)))
        (if (<= (p107-len (p107-nth o 5)) *p107-max-record-facts*)
          (let ((cands (p107-patterns3 (p107-facts-of o))) (j 0))
            (while (< j (p107-len cands))
              (let* ((p (p107-nth cands j)) (dec (p107-3-decomposition p s)))
                (if (and dec (not (p107-cover s p)))
                  (let ((support (p107-support s p)))
                    (if (and (>= support 2) (> support best-support))
                      (begin (set best (list p (p107-nth dec 0) (p107-nth dec 1) (p107-nth dec 2)))
                             (set best-support support))))))
              (set j (+ j 1))))))
      (set i (+ i 1)))
    (if best (list best best-support) ())))

(define-function p107-try2 (s)
  (let ((best ()) (best-support 0) (obs (p107-obs-list s)) (i 0))
    (while (< i (p107-len obs))
      (let ((o (p107-nth obs i)))
        (if (<= (p107-len (p107-nth o 5)) *p107-max-record-facts*)
          (let ((cands (p107-patterns2 (p107-facts-of o))) (j 0))
            (while (< j (p107-len cands))
              (let* ((p (p107-nth cands j)) (support (p107-support s p)))
                (if (and (>= support 2) (> support best-support) (not (p107-cover s p)))
                  (begin (set best p) (set best-support support))))
              (set j (+ j 1))))))
      (set i (+ i 1)))
    (if best (list best best-support) ())))

(define-function p107-next-id (defs)
  (string->symbol (concat-strings "b" (number->string (+ 1 (p107-len defs))))))
(define-function p107-admit2 (s pattern)
  (let* ((defs (p107-defs-of s)) (d (p107-def (p107-next-id defs) (p107-vars-of pattern) pattern pattern)))
    (if (p107-def-ok? d defs) (list 'learned107 d) '(none))))
(define-function p107-admit3 (s pattern d atom bind)
  (if (equal bind 'align-failed) '(none)
  (let* ((defs (p107-defs-of s))
         (terms (p107-map (lambda (v) (let ((h (p107-assoc v bind))) (if h (p107-nth h 1) v)))
                          (p107-def-vars d)))
         (body (list (p107-call (p107-def-id d) terms) atom))
         (cand (p107-def (p107-next-id defs) (p107-vars-of pattern) pattern body)))
    (if (p107-def-ok? cand defs) (list 'learned107 cand) '(none)))))

(define-function p107-learn (s)
  (let ((three (p107-try3 s)) (two (p107-try2 s)))
    (cond
      (three
        (let ((p (p107-nth (p107-nth three 0) 0)) (d (p107-nth (p107-nth three 0) 1))
              (atom (p107-nth (p107-nth three 0) 2)) (bind (p107-nth (p107-nth three 0) 3)))
          (p107-admit3 s p d atom bind)))
      (two (p107-admit2 s (car two)))
      (else '(none)))))

(define-function p107-revise (s id pattern)
  (let* ((defs (p107-defs-of s)) (d (p107-find-def defs id)))
    (if (not d) '(rejected107 unknown-definition)
      (if (not (= (p107-len (p107-def-vars d)) (p107-len (p107-vars-of pattern))))
        '(rejected107 arity)
        (let ((new (p107-def id (p107-def-vars d) pattern pattern)))
          (if (not (p107-def-ok? new (p107-filter (lambda (x) (not (equal (p107-def-id x) id))) defs)))
            '(rejected107 definition)
            (list 'revised107 new (p107-len (p107-def-pattern d)) (p107-len pattern))))))))
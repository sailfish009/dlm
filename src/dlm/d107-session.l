;;; d107-session.l — one state, one event log, replay-checked snapshots.
;;; Fixes from the 0.0103 review: every public transition validates its input
;;; before touching lists; `missing` is distinguished from `corrupt`; a session
;;; holds an advisory lock; a save must match the epoch we last saw on disk.

(define *p107-rules* ())
(define-function p107-rules-check () (p107-digest *p107-rules*))
(define-function p107-new () (list 'state107 1 (p107-rules-check) () () () () 0))
(define-function p107-state? (s)
  (and (p107-shape? s 8) (= (car s) 'state107) (= (p107-nth s 1) 1)
       (p107-list? (p107-nth s 3)) (p107-list? (p107-nth s 4)) (p107-list? (p107-nth s 5))
       (p107-list? (p107-nth s 6)) (is <long> (p107-nth s 7))))
(define-function p107-obs-list (s) (if (not (p107-state? s)) () (p107-nth s 3)))
(define-function p107-int-list (s) (if (not (p107-state? s)) () (p107-nth s 4)))
(define-function p107-defs-of (s) (if (not (p107-state? s)) () (p107-nth s 5)))
(define-function p107-events (s) (if (not (p107-state? s)) () (p107-nth s 6)))
(define-function p107-epoch (s) (if (not (p107-state? s)) 0 (p107-nth s 7)))
(define-function p107-obs (s id)
  (if (not (and (p107-state? s) (p107-name? id))) () (let ((out ())) (list-do o (p107-obs-list s) (if (equal (p107-nth o 1) id) (set out o))) out)))
(define-function p107-int (s id)
  (if (not (and (p107-state? s) (p107-name? id))) () (let ((out ())) (list-do i (p107-int-list s) (if (equal (p107-nth i 1) id) (set out i))) out)))

(define-function p107-facts-of (o)
  (let ((out ()) (i 0))
    (list-do a (p107-nth o 5)
      (set out (p107-append out (list (p107-given-id
        (concat-strings (concat-strings (p107-str (p107-nth o 1)) "#") (number->string i)) a))))
      (set i (+ i 1)))
    out))
(define-function p107-scope-facts (s scope)
  (let ((out ()))
    (list-do o (p107-obs-list s)
      (if (equal (p107-nth o 4) scope) (set out (p107-append out (p107-facts-of o)))))
    out))
(define-function p107-closure (s scope budget)
  (let* ((facts (p107-scope-facts s scope)) (r (p107-close facts *p107-rules* budget)))
    (list (p107-nth r 1) (p107-nth r 2) (p107-nth r 3) (p107-len facts))))

;;; ---------------- pure event application (validates everything) ----------------
(define-function p107-observation? (a)
  (and (p107-atom? a) (p107-ground-atom? a)))
(define-function p107-apply (s event)
  (if (not (and (p107-state? s) (pair? event) (symbol? (car event)))) '(rejected107 event)
    (let ((op (car event)) (args (cdr event)))
      (cond
        ((equal op 'obs107)
          (if (not (and (p107-shape? args 5) (p107-list? args))) '(rejected107 observation)
            (let* ((id (p107-nth args 0)) (src (p107-nth args 1)) (rec (p107-nth args 2))
                   (scope (p107-nth args 3)) (facts (p107-nth args 4)))
              (if (not (and (p107-name? id) (p107-name? src) (p107-name? rec) (symbol? scope)
                            (p107-list? facts)
                            (not (p107-any? (lambda (a) (not (p107-observation? a))) facts))
                            (<= (p107-len facts) 4096)
                            (not (p107-obs s id))))
                '(rejected107 observation)
                (list 'applied (p107-set s 3 (p107-append (p107-obs-list s)
                  (list (list 'obs107 id src rec scope facts (p107-digest facts))))))))))
        ((equal op 'interpret107)
          (if (not (and (p107-shape? args 2) (is <long> (p107-nth args 1))
                        (> (p107-nth args 1) 0) (<= (p107-nth args 1) 200000)))
            '(rejected107 interpret)
            (let* ((id (p107-nth args 0)) (o (p107-obs s id)))
              (if (not o) '(rejected107 unknown-observation)
                (if (p107-int s id) '(rejected107 already-interpreted)
                  (let* ((scope (p107-nth o 4)) (c (p107-closure s scope (p107-nth args 1))))
                    (list 'applied (p107-set s 4 (p107-append (p107-int-list s)
                      (list (list 'int107 id (p107-nth c 0) (p107-nth c 2) (p107-len (p107-nth c 1)))))))))))))
        ((equal op 'retract107)
          (if (not (p107-shape? args 1)) '(rejected107 retract)
            (if (not (p107-obs s (p107-nth args 0))) '(rejected107 unknown-observation)
              (list 'applied
                (p107-set (p107-set s 3 (p107-filter (lambda (o) (not (equal (p107-nth o 1) (p107-nth args 0))))
                                                     (p107-obs-list s)))
                          4 (p107-filter (lambda (i) (not (equal (p107-nth i 1) (p107-nth args 0))))
                                         (p107-int-list s)))))))
        ((equal op 'def107)
          (if (not (and (p107-shape? args 1) (p107-def? (p107-nth args 0))))
            '(rejected107 definition)
            (let* ((d (p107-nth args 0)) (defs (p107-defs-of s)))
              (if (or (p107-find-def defs (p107-def-id d))
                      (not (p107-def-ok? d defs)))
                '(rejected107 definition)
                (list 'applied (p107-set s 5 (p107-append defs (list d))))))))
        ((equal op 'revise107)
          (if (not (and (p107-shape? args 2) (p107-name? (p107-nth args 0))
                        (p107-list? (p107-nth args 1))))
            '(rejected107 revision)
            (let* ((id (p107-nth args 0)) (pattern (p107-nth args 1))
                   (defs (p107-defs-of s)) (d (p107-find-def defs id)))
              (if (not d) '(rejected107 unknown-definition)
                (let* ((cand (p107-def id (p107-def-vars d) pattern pattern))
                       (prefix (p107-filter (lambda (x) (not (equal (p107-def-id x) id))) defs)))
                  (if (or (not (= (p107-len (p107-def-vars d)) (p107-len (p107-vars-of pattern))))
                          (not (p107-def-ok? cand prefix)))
                    '(rejected107 revision)
                    (let* ((replaced (p107-map (lambda (x) (if (equal (p107-def-id x) id) cand x)) defs))
                           (r (p107-revalidate replaced)))
                      (list 'applied (p107-set s 5 (p107-nth r 0))))))))))
        ((equal op 'reset107)
          (if (not (= (p107-len args) 0)) '(rejected107 reset) (list 'applied (p107-new))))
        (else '(rejected107 event))))))

(define-function p107-transition (s event)
  (if (not (p107-state? s)) '(rejected107 state)
    (if (>= (p107-len (p107-events s)) 256) '(rejected107 event-limit)
      (let ((r (p107-apply s event)))
        (if (not (= (car r) 'applied)) r
          (let ((n (p107-nth r 1)))
            (list 'applied (p107-set (p107-set n 6 (p107-append (p107-events n) (list event)))
                                    7 (+ 1 (p107-epoch n))))))))))

(define-function p107-replay (events)
  (if (not (p107-list? events)) '(rejected107 replay)
    (let ((s (p107-new)) (ok true))
      (list-do e events
        (if ok (let ((r (p107-transition s e)))
                 (if (= (car r) 'applied) (set s (p107-nth r 1)) (set ok false)))))
      (if ok (list 'replayed s) '(rejected107 replay)))))

;;; ---------------- snapshot / storage ----------------
(define-function p107-snapshot (s) (list 'dlm-session107 1 s))
(define-function p107-snapshot? (x)
  (and (p107-shape? x 3) (= (car x) 'dlm-session107) (= (p107-nth x 1) 1)
       (p107-state? (p107-nth x 2))
       (= (p107-nth (p107-nth x 2) 2) (p107-rules-check))
       (let ((r (p107-replay (p107-events (p107-nth x 2)))))
         (and (= (car r) 'replayed) (equal (p107-nth r 1) (p107-nth x 2))))))

(define-function p107-write (path data)
  (let ((fd (file-open path "w")))
    (if (not fd) false
      (let ((stream (file-stream fd))) (dump-all stream data) (print-all stream "\n")
        (file-close fd) true))))
(define-function p107-read-data (path)
  ;; (missing) only when the path does not exist; every other failure is an error
  (let ((fd (file-open-read path)))
    (if (not fd) '(missing)
      (if (is <long> fd) '(rejected107 access)
        (let* ((stream (file-stream fd)) (x (read stream)) (end (read stream)))
          (file-close fd)
          (cond ((not (= end +end+)) '(rejected107 trailing-data))
                ((not (pair? x)) '(rejected107 not-a-snapshot))
                (else (list 'data x))))))))

(define-function p107-store? (p) (and (string? p) (> (string-length p) 0)))

(define-function p107-snapshot-digest (snap) (p107-digest snap))

(define-function p107-save (path s expected)
  ;; expected: 'missing for a new file, or the epoch we last saw
  (if (not (p107-store? path)) '(rejected107 path)
    (let* ((lock (file-lock (concat-strings path ".lock")))
           (data (p107-snapshot s)) (old (p107-read-data path))
           (tmp (concat-strings path ".next"))
           (ok (and lock (p107-snapshot? data))))
      (if (not lock) '(rejected107 locked-or-path)
        (begin
          (if ok
            (set ok (cond ((equal (car old) 'missing) (equal expected 'missing))
                          ((not (= (car old) 'data)) false)
                          (else (equal (p107-snapshot-digest (p107-nth old 1)) expected)))))
          (if ok (set ok (and (p107-write tmp data) (equal (p107-read-data tmp) (list 'data data)))))
          (if (and ok (= (car old) 'data))
            (let ((prev (concat-strings path ".previous.next")))
              (set ok (and (p107-write prev (p107-nth old 1))
                           (file-replace prev (concat-strings path ".previous"))))))
          (if ok (set ok (and (equal old (p107-read-data path)) (file-replace tmp path))))
          (if (not ok) (file-remove tmp))
          (file-close lock)
          (if ok (list 'saved107 (p107-snapshot-digest data)) '(rejected107 checkpoint)))))))

(define-function p107-load (path)
  (if (not (p107-store? path)) '(rejected107 path)
    (let ((lock (file-lock (concat-strings path ".lock"))))
      (if (not lock) '(rejected107 locked-or-path)
        (let ((data (p107-read-data path)) (res ()))
          (set res (cond ((equal (car data) 'missing) '(missing))
                         ((not (= (car data) 'data)) '(rejected107 corrupt))
                         ((p107-snapshot? (p107-nth data 1))
                          (list 'loaded (p107-nth (p107-nth data 1) 2)
                                (p107-snapshot-digest (p107-nth data 1))))
                         (else '(rejected107 snapshot))))
          (file-close lock) res)))))
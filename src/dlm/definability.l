;;; -*- mode: lisp; coding: us-ascii -*-
;;; Bounded propositional semantic projection, followed by independent G3 checks.
;;; These operators are experiments, not general FOL Beth/interpolation procedures.
(define-function b78-valuations (atoms)
  (if (not atoms) (list ())
    (let ((out ())) (list-do rest (b78-valuations (cdr atoms))
      (set out (cons (cons (list (car atoms) 'yes) rest)
                     (cons (cons (list (car atoms) 'no) rest) out)))) out)))
(define-function b78-fold (tag xs identity)
  (if (not xs) (list identity)
    (let ((out (car xs))) (list-do x (cdr xs) (set out (list tag out x))) out)))
(define-function b78-cube (atoms valuation)
  (let ((xs ())) (list-do a atoms
    (set xs (dlm-append xs (list (if (sq-eval a valuation) a (list 'not a))))))
    (b78-fold 'and xs 'top)))
(define-function b78-project (formula atoms shared)
  (let ((cubes ())) (list-do v (b78-valuations atoms)
    (if (sq-eval formula v)
        (let ((cube (b78-cube shared v)))
          (if (not (dlm-member? cube cubes)) (set cubes (dlm-append cubes (list cube)))))))
    (b78-fold 'or cubes 'bottom)))
(define-function b78-satisfiable? (f atoms)
  (let ((ok false)) (list-do v (b78-valuations atoms)
    (if (sq-eval f v) (set ok true))) ok))
(define-function b78-small? (sig fs)
  (and (sq-signature? sig) (sq-formulas? fs sig)
       (<= (dlm-length (sq-context-atoms fs)) 4)
       (let ((ok true)) (list-do a (sq-context-atoms fs)
         (if (dlm-nth a 2) (set ok false))) ok)))
(define-function b78-prove (sig left right budget)
  (sq-search (list 'problem 'classical-prop-v1 sig (sq-sequent left right)) budget 'fixed))
(define-function b78-craig (sig a b budget)
  (if (not (and (b78-small? sig (list a b)) (is <long> budget) (>= budget 0) (<= budget 9000)))
      '(unsupported bounded-nullary-propositional)
    (let* ((aa (sq-atoms a)) (ba (sq-atoms b)) (shared (dlm-difference aa (dlm-difference aa ba)))
           (candidate (b78-project a aa shared))
           (first (b78-prove sig (list a) (list candidate) budget))
           (second (b78-prove sig (list candidate) (list b) budget)))
      (if (and (= (dlm-nth first 1) 'proved) (= (dlm-nth second 1) 'proved))
          (list 'interpolant78 'verified candidate shared first second
            (if (b78-satisfiable? a aa) 'nonvacuous 'inconsistent-antecedent))
        (list 'interpolant78 'not-certified candidate first second)))))
(define-function b78-beth (sig theory target budget)
  (if (not (and (b78-small? sig (list theory target)) (= (car target) 'pred)
                (not (dlm-nth target 2)) (is <long> budget) (>= budget 0) (<= budget 9000)))
      '(unsupported bounded-nullary-propositional)
    (let* ((atoms (dlm-union (sq-atoms theory) (list target))) (name "beth78-fresh") (i 0))
      (while (dlm-assoc name sig)
        (set i (+ i 1)) (set name (concat-strings "beth78-fresh-" (number->string i))))
      (if (not (b78-satisfiable? theory atoms)) '(beth78 rejected inconsistent-theory)
        (let* ((fresh (list 'pred name ())) (extended (dlm-append sig (list (list name 0))))
               (renamed (p78-replace theory (list (list target fresh))))
               (equiv (list 'and (list 'imp target fresh) (list 'imp fresh target)))
               (unique (b78-prove extended (list theory renamed) (list equiv) budget)))
          (if (not (= (dlm-nth unique 1) 'proved)) (list 'beth78 'not-certified 'uniqueness unique)
            (let* ((shared (dlm-difference atoms (list target)))
                   (candidate (b78-project (list 'and theory target) atoms shared))
                   (forward (b78-prove sig (list theory target) (list candidate) budget))
                   (backward (b78-prove sig (list theory candidate) (list target) budget)))
              (if (and (= (dlm-nth forward 1) 'proved) (= (dlm-nth backward 1) 'proved))
                  (list 'beth78 'verified target candidate unique forward backward)
                (list 'beth78 'not-certified 'definition candidate forward backward)))))))))

;;; -*- mode: lisp; coding: us-ascii -*-
;;; Data-only native session snapshots. No derived facts or executable hooks.
(define d84-replay ())
(define-function d84-log? (events)
  (let ((found false))
    (list-do e events
      (if (and (pair? e) (dlm-member? (car e) '(search84 search84-run search85 search86))) (set found true))) found))
(define-function d77-replay-legacy (events)
  (if (not (dlm-proper? events 256)) (list 'rejected 'event-limit)
    (let ((s (a77-new)) (ok true))
      (list-do event events
        (if ok
            (if (and (sq-shape? event 3) (= (car event) 'observe))
                (let ((r (a77-observe s (dlm-nth event 1) (dlm-nth event 2))))
                  (if (= (car r) 'observed) (set s (dlm-nth r 1)) (set ok false)))
              (if (and (sq-shape? event 2) (= (car event) 'define))
                  (let ((r (a77-certify s (dlm-nth event 1))))
                    (if (= (car r) 'learned) (set s (dlm-nth r 1)) (set ok false)))
                (if (and (sq-shape? event 2) (= (car event) 'retract) (a77-name? (dlm-nth event 1)))
                    (set s (a77-retract s (dlm-nth event 1)))
                  (if (not (and (sq-shape? event 2) (= (car event) 'routing83)
                                (dlm-member? (dlm-nth event 1) '(on off)))) (set ok false)))))))
      (if ok (list 'replayed s) (list 'rejected 'event)))))
(define-function d77-replay (events)
  (if (not (dlm-proper? events 256)) '(rejected event-limit)
    (if (d84-log? events)
      (if d84-replay (d84-replay events) '(rejected missing-search-controller))
      (d77-replay-legacy events))))
(define-function d77-routing-log? (events)
  (let ((found false)) (list-do e events (if (= (car e) 'routing83) (set found true))) found))
(define-function d85-log? (events)
  (let ((found false))
    (list-do e events (if (and (pair? e) (= (car e) 'search85)) (set found true))) found))
(define-function d86-log? (events)
  (let ((found false))
    (list-do e events (if (and (pair? e) (= (car e) 'search86)) (set found true))) found))
(define-function d77-pack (model round events)
  (list (if (d86-log? events) 'dlm-session86
          (if (d85-log? events) 'dlm-session85
            (if (d84-log? events) 'dlm-session84
              (if (d77-routing-log? events) 'dlm-session83 'dlm-session77)))) 1 model round events))
(define-function d77-snapshot? (x)
  (and (sq-shape? x 5) (dlm-member? (car x) '(dlm-session77 dlm-session83 dlm-session84 dlm-session85 dlm-session86)) (= (dlm-nth x 1) 1)
       (a77-valid? (dlm-nth x 2)) (is <long> (dlm-nth x 3)) (>= (dlm-nth x 3) 0)
       (let ((replay (d77-replay (dlm-nth x 4))))
         (and (= (car replay) 'replayed)
              (or (= (car x) 'dlm-session86) (not (d86-log? (dlm-nth x 4))))
              (or (dlm-member? (car x) '(dlm-session85 dlm-session86)) (not (d85-log? (dlm-nth x 4))))
              (or (dlm-member? (car x) '(dlm-session84 dlm-session85 dlm-session86)) (not (d84-log? (dlm-nth x 4))))
              (or (dlm-member? (car x) '(dlm-session83 dlm-session84 dlm-session85 dlm-session86))
                  (not (d77-routing-log? (dlm-nth x 4))))
              (equal (dlm-nth replay 1) (dlm-nth x 2))))))
(define-function d77-read (path)
  (let ((fd (file-open-read path)))
    (if (not fd) (list 'missing)
      (if (is <long> fd) (list 'rejected 'file-access fd)
        (let* ((stream (file-stream fd)) (x (read stream)) (end (read stream)))
          (file-close fd)
          (if (and (= end +end+) (d77-snapshot? x)) (list 'loaded x) (list 'rejected 'snapshot)))))))
(define-function d77-write (path data)
  (let ((fd (file-open path "w")))
    (if (not fd) false
      (let ((stream (file-stream fd)))
        (dump-all stream data) (print-all stream "\n") (file-close fd) true))))
(define-function d77-checkpoint (path snapshot)
  (if (not (d77-snapshot? snapshot)) false
    (let* ((tmp (concat-strings path ".next")) (old (d77-read path)) (ok true))
      (if (= (car old) 'rejected) (set ok false))
      (if ok (set ok (d77-write tmp snapshot)))
      (if ok
          (let ((r (d77-read tmp)))
            (set ok (and (= (car r) 'loaded) (equal (dlm-nth r 1) snapshot)))))
      (if (and ok (= (car old) 'loaded))
          (let ((previous-tmp (concat-strings path ".previous.next"))
                (previous (concat-strings path ".previous")))
            (set ok (and (d77-write previous-tmp (dlm-nth old 1))
                         (file-replace previous-tmp previous)))))
      (if ok (set ok (file-replace tmp path)))
      (if (not ok) (file-remove tmp)) ok)))

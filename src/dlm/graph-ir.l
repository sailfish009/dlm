;;; graph-ir.l — explicit MLIR-shaped value/node/edge graph.
;;; Structural verification and topological lowering; truth stays with proof.l.

(define-function mg-value (id type producer) (list 'mgvalue id type producer))
(define-function mg-value? (x)
  (and (l-shape? x 4) (equal (car x) 'mgvalue) (l-name? (l-nth x 1))
       (l-name? (l-nth x 2)) (l-name? (l-nth x 3))))
(define-function mg-value-id (x) (l-nth x 1))
(define-function mg-value-type (x) (l-nth x 2))
(define-function mg-value-producer (x) (l-nth x 3))

(define-function mg-node (id kind inputs outputs attrs)
  (list 'mgnode id kind inputs outputs attrs))
(define-function mg-node? (x)
  (and (l-shape? x 6) (equal (car x) 'mgnode) (l-name? (l-nth x 1))
       (l-name? (l-nth x 2)) (l-list? (l-nth x 3))
       (l-list? (l-nth x 4)) (l-list? (l-nth x 5))))
(define-function mg-node-id (x) (l-nth x 1))
(define-function mg-node-kind (x) (l-nth x 2))
(define-function mg-node-inputs (x) (l-nth x 3))
(define-function mg-node-outputs (x) (l-nth x 4))
(define-function mg-node-attrs (x) (l-nth x 5))

(define-function mg-edge (value node port) (list 'mgedge value node port))
(define-function mg-edge? (x)
  (and (l-shape? x 4) (equal (car x) 'mgedge)
       (l-name? (l-nth x 1)) (l-name? (l-nth x 2))))
(define-function mg-edge-value (x) (l-nth x 1))
(define-function mg-edge-node (x) (l-nth x 2))
(define-function mg-edge-port (x) (l-nth x 3))

(define-function mg-graph (values nodes edges) (list 'mggraph values nodes edges))
(define-function mg-graph? (g)
  (and (l-shape? g 4) (equal (car g) 'mggraph)
       (l-list? (l-nth g 1)) (l-list? (l-nth g 2)) (l-list? (l-nth g 3))
       (not (l-any? (lambda (v) (not (mg-value? v))) (l-nth g 1)))
       (not (l-any? (lambda (n) (not (mg-node? n))) (l-nth g 2)))
       (not (l-any? (lambda (e) (not (mg-edge? e))) (l-nth g 3)))))
(define-function mg-values (g) (l-nth g 1))
(define-function mg-nodes (g) (l-nth g 2))
(define-function mg-edges (g) (l-nth g 3))

(define-function mg-find (id xs)
  (let ((hit (l-filter (lambda (x) (equal id (car x))) xs)))
    (if hit (car hit) ())))
(define-function mg-value-by-id (id g)
  (let ((hit (l-filter (lambda (v) (equal id (mg-value-id v))) (mg-values g))))
    (if hit (car hit) ())))
(define-function mg-node-by-id (id g)
  (let ((hit (l-filter (lambda (n) (equal id (mg-node-id n))) (mg-nodes g))))
    (if hit (car hit) ())))

(define-function mg-ids-unique? (xs)
  (if (not xs) (not ())
    (and (not (l-member? (car xs) (cdr xs)))
         (mg-ids-unique? (cdr xs)))))
(define-function mg-value-in? (id xs)
  (l-any? (lambda (v) (equal id (mg-value-id v))) xs))
(define-function mg-output-member? (id n)
  (l-member? id (mg-node-outputs n)))

(define-function mg-check-values (g)
  (if (not (mg-ids-unique? (l-map mg-value-id (mg-values g))))
    '(rejected107 mg-value-id)
    'ok))
(define-function mg-check-nodes (g)
  (if (not (mg-ids-unique? (l-map mg-node-id (mg-nodes g)))) '(rejected107 mg-node-id)
    (if (not (l-any? (lambda (n) (l-any? (lambda (v) (not (mg-value-in? v (mg-values g))))
                                          (l-nth n 3)))
                     (mg-nodes g)))
      'ok
      '(rejected107 mg-input-ref))))
(define-function mg-check-edge (e g)
  (let* ((v (mg-edge-value e)) (n (mg-edge-node e)) (p (mg-edge-port e))
         (node (mg-node-by-id n g)) (val (mg-value-by-id v g)))
    (if (not val) '(rejected107 mg-edge-value)
      (if (not node) '(rejected107 mg-edge-node)
        (if (>= p (l-len (mg-node-inputs node))) '(rejected107 mg-edge-port)
          (if (not (equal v (l-nth (mg-node-inputs node) p))) '(rejected107 mg-edge-input)
            'ok))))))
(define-function mg-check-edges (es g)
  (if (not es) 'ok
    (let ((r (mg-check-edge (car es) g)))
      (if (not (equal r 'ok)) r (mg-check-edges (cdr es) g)))))
(define-function mg-check-producers (vs g)
  (if (not vs) 'ok
    (let* ((v (car vs)) (n (mg-node-by-id (mg-value-producer v) g)))
      (if (not n) '(rejected107 mg-producer)
        (if (not (mg-output-member? (mg-value-id v) n)) '(rejected107 mg-output)
          (mg-check-producers (cdr vs) g))))))

(define-function mg-check (g)
  (if (not (mg-graph? g)) '(rejected107 mg-shape)
    (let ((a (mg-check-values g)) (b (mg-check-nodes g))
          (c (mg-check-edges (mg-edges g) g)) (d (mg-check-producers (mg-values g) g)))
      (if (not (equal a 'ok)) a
        (if (not (equal b 'ok)) b
          (if (not (equal c 'ok)) c
            (if (not (equal d 'ok)) d 'ok)))))))

(define-function mg-deps (n g)
  (let ((out ()))
    (list-do v (mg-node-inputs n)
      (let ((p (mg-value-producer (mg-value-by-id v g))))
        (if (and p (not (l-member? p out))) (set out (l-append out (list p))))))
    out))
(define-function mg-all-visited? (ids seen)
  (l-any? (lambda (id) (not (l-member? id seen))) ids))
(define-function mg-ready (nodes seen g)
  (let ((out ()))
    (list-do n nodes
      (if (and (not (l-member? (mg-node-id n) seen))
               (not (mg-all-visited? (mg-deps n g) seen)))
        (set out (l-append out (list (mg-node-id n))))))
    out))
(define-function mg-topo (g)
  (if (not (mg-graph? g)) '(rejected107 mg-topo-shape)
    (let ((seen ()) (order ()) (done false))
      (while (not done)
        (let ((r (mg-ready (mg-nodes g) seen g)))
          (if (not r) (set done true)
            (begin
              (set order (l-append order (list (car r))))
              (set seen (l-append seen (list (car r))))))))
      (if (< (l-len order) (l-len (mg-nodes g)))
        '(rejected107 mg-cycle)
        order))))

(define-function mg-node-to-op (n)
  (ml-op (mg-node-kind n) (cons (mg-node-id n) (mg-node-attrs n))))
(define-function mg-to-module (name g)
  (let ((topo (mg-topo g)) (ops ()))
    (if (or (not (l-list? topo)) (equal (car topo) 'rejected107))
      (ml-module name ())
      (begin
        (list-do id topo
          (let ((n (mg-node-by-id id g)))
            (if n (set ops (l-append ops (list (mg-node-to-op n)))))))
        (ml-module name ops)))))

(define *mg-build-values* ())
(define *mg-build-nodes* ())
(define *mg-build-edges* ())
(define *mg-build-ids* ())
(define-function mg-id-value (id)
  (let ((hit (l-assoc id *mg-build-ids*))) (if hit (l-nth hit 1) ())))
(define-function mg-op-inputs (kind args)
  (cond
    ((equal kind 'combine)
     (list (mg-id-value (l-nth args 1)) (mg-id-value (l-nth args 2))))
    ((equal kind 'program)
     (l-map (lambda (id) (mg-id-value id)) (l-nth args 1)))
    (else ())))
(define-function mg-build-op (op idx)
  (let* ((kind (ml-kind op)) (args (ml-args op))
         (nid (l-nth args 0))
         (vid (concat-strings "v" (number->string idx)))
         (ins (mg-op-inputs kind args))
         (port 0))
    (set *mg-build-nodes*
      (l-append *mg-build-nodes*
        (list (mg-node nid kind ins (list vid) (cdr args)))))
    (set *mg-build-values*
      (l-append *mg-build-values* (list (mg-value vid kind nid))))
    (list-do v ins
      (set *mg-build-edges*
        (l-append *mg-build-edges* (list (mg-edge v nid port))))
      (set port (+ port 1)))
    (set *mg-build-ids* (cons (list (l-nth args 0) vid) *mg-build-ids*))))
(define-function mg-from-module (m)
  (set *mg-build-values* ()) (set *mg-build-nodes* ())
  (set *mg-build-edges* ()) (set *mg-build-ids* ())
  (let ((i 0))
    (list-do op (ml-ops m)
      (mg-build-op op i)
      (set i (+ i 1))))
  (mg-graph *mg-build-values* *mg-build-nodes* *mg-build-edges*))

;;; Constraints attached to an explicit graph. Hard constraints reject;
;;; soft constraints are reported but never admit/reject truth.
(define-function mc-constraint (id kind expr scope status prov)
  (list 'mgconstraint id kind expr scope status prov))
(define-function mc-constraint? (x)
  (and (l-shape? x 7) (equal (car x) 'mgconstraint)
       (l-name? (l-nth x 1))
       (l-member? (l-nth x 2) '(hard soft structural))
       (l-list? (l-nth x 3))
       (l-name? (l-nth x 4))
       (l-member? (l-nth x 5) '(active inactive))
       (l-list? (l-nth x 6))))
(define-function mc-id (x) (l-nth x 1))
(define-function mc-kind (x) (l-nth x 2))
(define-function mc-expr (x) (l-nth x 3))
(define-function mc-scope (x) (l-nth x 4))
(define-function mc-status (x) (l-nth x 5))
(define-function mc-prov (x) (l-nth x 6))

(define-function mg-attach (g cs) (list 'mgcgraph g cs))
(define-function mg-cgraph? (x)
  (and (l-shape? x 3) (equal (car x) 'mgcgraph)
       (mg-graph? (l-nth x 1)) (l-list? (l-nth x 2))
       (not (l-any? (lambda (c) (not (mc-constraint? c))) (l-nth x 2)))))
(define-function mg-cgraph-graph (x) (l-nth x 1))
(define-function mg-cgraph-constraints (x) (l-nth x 2))

(define-function mc-eval (mode x g)
  (if (equal mode 'all)
    (if (not x) 'true
      (let ((r (mc-eval 'one (car x) g)))
        (if (equal r 'true) (mc-eval 'all (cdr x) g) r)))
    (if (equal mode 'any)
      (if (not x) 'false
        (let ((r (mc-eval 'one (car x) g)))
          (if (equal r 'true) 'true (mc-eval 'any (cdr x) g))))
      (if (not (l-list? x)) 'bad
        (let ((op (car x)))
          (cond
            ((equal op 'and) (mc-eval 'all (cdr x) g))
            ((equal op 'or) (mc-eval 'any (cdr x) g))
            ((equal op 'not)
             (let ((r (mc-eval 'one (l-nth x 1) g)))
               (if (equal r 'true) 'false (if (equal r 'false) 'true 'bad))))
            ((equal op 'node-exists)
             (if (mg-node-by-id (l-nth x 1) g) 'true 'false))
            ((equal op 'node-kind)
             (let ((n (mg-node-by-id (l-nth x 1) g)))
               (if (and n (equal (mg-node-kind n) (l-nth x 2))) 'true 'false)))
            ((equal op 'edge-exists)
             (if (l-any? (lambda (e) (and (equal (mg-edge-value e) (l-nth x 1))
                                          (equal (mg-edge-node e) (l-nth x 2))
                                          (= (mg-edge-port e) (l-nth x 3))))
                         (mg-edges g)) 'true 'false))
            ((equal op 'acyclic)
             (if (equal (mg-check g) 'ok) 'true 'false))
            (else 'bad)))))))
(define-function mc-eval-constraint (c g)
  (if (not (equal (mc-status c) 'active)) 'inactive
    (mc-eval 'one (mc-expr c) g)))
(define-function mg-check-constraints (g cs)
  (if (not cs) 'ok
    (let* ((c (car cs)) (r (mc-eval-constraint c g)))
      (if (equal (mc-kind c) 'hard)
        (if (equal r 'false) (list 'rejected107 'mg-constraint (mc-id c))
          (if (equal r 'bad) (list 'rejected107 'mg-constraint-expr (mc-id c))
            (mg-check-constraints g (cdr cs))))
        (mg-check-constraints g (cdr cs))))))
(define-function mg-check-cgraph (cg)
  (if (not (mg-cgraph? cg)) '(rejected107 mgcgraph-shape)
    (let ((b (mg-check (mg-cgraph-graph cg))))
      (if (not (equal b 'ok)) b
        (mg-check-constraints (mg-cgraph-graph cg) (mg-cgraph-constraints cg))))))
(define-function mg-constraint-report (cg)
  (let ((g (mg-cgraph-graph cg)) (out ()))
    (list-do c (mg-cgraph-constraints cg)
      (set out (l-append out (list (list (mc-id c) (mc-kind c)
        (mc-status c) (mc-eval-constraint c g))))))
    out))

;;; Advisory graph embeddings. These are never used for truth/admission.
(define-function mg-embedding (id dim vec hash)
  (list 'mgembedding id dim vec hash))
(define-function mg-embedding? (x)
  (and (l-shape? x 5) (equal (car x) 'mgembedding)
       (l-name? (l-nth x 1)) (= (l-nth x 2) (l-len (l-nth x 3)))
       (l-list? (l-nth x 3)) (l-name? (l-nth x 4))))
(define-function mg-embedding-id (x) (l-nth x 1))
(define-function mg-embedding-dim (x) (l-nth x 2))
(define-function mg-embedding-vec (x) (l-nth x 3))
(define-function mg-embedding-hash (x) (l-nth x 4))
(define-function mg-embedding-graph (g es)
  (list 'mgegraph g es))
(define-function mg-embedding-graph? (x)
  (and (l-shape? x 3) (equal (car x) 'mgegraph)
       (mg-graph? (l-nth x 1)) (l-list? (l-nth x 2))
       (not (l-any? (lambda (e) (not (mg-embedding? e))) (l-nth x 2)))))
(define-function mg-embedding-node (id es)
  (let ((hit (l-filter (lambda (e) (equal id (mg-embedding-id e))) es)))
    (if hit (car hit) ())))
(define-function mg-dot (a b)
  (if (not a) 0
    (+ (* (car a) (car b)) (mg-dot (cdr a) (cdr b)))))
(define-function mg-embedding-score (a b)
  (mg-dot (mg-embedding-vec a) (mg-embedding-vec b)))
(define-function mg-insert-pair (x xs)
  (if (not xs) (list x)
    (if (> (l-nth x 1) (l-nth (car xs) 1)) (cons x xs)
      (cons (car xs) (mg-insert-pair x (cdr xs))))))
(define-function mg-sort-pairs (xs)
  (if (not xs) () (mg-insert-pair (car xs) (mg-sort-pairs (cdr xs)))))
(define-function mg-rank-query (g es query-id)
  (let ((q (mg-embedding-node query-id es)) (out ()))
    (if q
      (begin
        (list-do e es
          (set out (l-append out (list (list (mg-embedding-id e)
                                             (mg-embedding-score q e))))))
        (mg-sort-pairs out))
      ())))
(define-function mg-check-embeddings (g es)
  (if (not (mg-ids-unique? (l-map mg-embedding-id es))) '(rejected107 mg-embedding-id)
    (if (l-any? (lambda (e) (not (mg-node-by-id (mg-embedding-id e) g))) es)
      '(rejected107 mg-embedding-node)
      (if (l-any? (lambda (e) (not (= (mg-embedding-dim e) (l-len (mg-embedding-vec e))))) es)
        '(rejected107 mg-embedding-dim)
        (if (l-any? (lambda (e) (equal (mg-embedding-hash e) "")) es)
          '(rejected107 mg-embedding-hash)
          'ok)))))

;;; Embedding-prioritized topological schedule. Scores only choose among
;;; currently-ready nodes; they never change graph truth or proof results.
(define-function mg-node-score (id es query-id)
  (let ((e (mg-embedding-node id es)) (q (mg-embedding-node query-id es)))
    (if (and e q) (mg-embedding-score q e) -1)))
(define-function mg-ready-best (nodes seen g es query-id)
  (let ((ready (mg-ready nodes seen g)) (best ()) (best-s -1))
    (list-do id ready
      (let ((s (mg-node-score id es query-id)))
        (if (or (not best) (> s best-s))
          (begin (set best id) (set best-s s)))))
    (if best (list best) ())))
(define-function mg-topo-ranked (g es query-id)
  (if (not (mg-graph? g)) '(rejected107 mg-topo-shape)
    (let ((seen ()) (order ()) (done false))
      (while (not done)
        (let ((r (mg-ready-best (mg-nodes g) seen g es query-id)))
          (if (not r) (set done true)
            (begin
              (set order (l-append order r))
              (set seen (l-append seen r))))))
      (if (< (l-len order) (l-len (mg-nodes g)))
        '(rejected107 mg-cycle)
        order))))
(define-function mg-to-module-ranked (name g es query-id)
  (let ((topo (mg-topo-ranked g es query-id)) (ops ()))
    (if (or (not (l-list? topo)) (equal (car topo) 'rejected107))
      (ml-module name ())
      (begin
        (list-do id topo
          (let ((n (mg-node-by-id id g)))
            (if n (set ops (l-append ops (list (mg-node-to-op n)))))))
        (ml-module name ops)))))

;;; Dead-node elimination: keep nodes reachable backward from explicit roots.
(define-function mg-reach (ids seen g)
  (if (not ids) seen
    (let ((id (car ids)))
      (if (l-member? id seen)
        (mg-reach (cdr ids) seen g)
        (let ((n (mg-node-by-id id g)))
          (if n
            (mg-reach (l-append (cdr ids) (mg-deps n g))
                      (l-append seen (list id)) g)
            (mg-reach (cdr ids) seen g)))))))
(define-function mg-keep-node? (n keep)
  (l-member? (mg-node-id n) keep))
(define-function mg-keep-value? (v keep)
  (l-member? (mg-value-producer v) keep))
(define-function mg-keep-edge? (e keep g)
  (let ((v (mg-value-by-id (mg-edge-value e) g)))
    (and (l-member? (mg-edge-node e) keep)
         v (mg-keep-value? v keep))))
(define-function mg-dce (g roots)
  (if (not (mg-graph? g)) '(rejected107 mg-dce-shape)
    (let* ((keep (mg-reach roots () g))
           (vs (l-filter (lambda (v) (mg-keep-value? v keep)) (mg-values g)))
           (ns (l-filter (lambda (n) (mg-keep-node? n keep)) (mg-nodes g)))
           (es (l-filter (lambda (e) (mg-keep-edge? e keep g)) (mg-edges g))))
      (mg-graph vs ns es))))

;;; Constraint-guided candidate selection. Hard constraints filter; soft
;;; constraints rank. Selection never changes proof/run truth by itself.
(define-function mg-soft-score (cg)
  (if (not (mg-cgraph? cg)) -1
    (let ((n 0))
      (list-do c (mg-cgraph-constraints cg)
        (if (and (equal (mc-kind c) 'soft)
                 (equal (mc-status c) 'active)
                 (equal (mc-eval-constraint c (mg-cgraph-graph cg)) 'true))
          (set n (+ n 1))))
      n)))
(define-function mg-candidate (id cg) (list 'mgcandidate id cg))
(define-function mg-candidate? (c)
  (and (l-shape? c 3) (equal (car c) 'mgcandidate)
       (l-name? (l-nth c 1)) (mg-cgraph? (l-nth c 2))))
(define-function mg-candidate-id (c) (l-nth c 1))
(define-function mg-candidate-cg (c) (l-nth c 2))
(define-function mg-select-candidates (cs)
  (let ((best ()) (best-s -1))
    (list-do c cs
      (if (and (mg-candidate? c)
               (equal (mg-check-cgraph (mg-candidate-cg c)) 'ok))
        (let ((s (mg-soft-score (mg-candidate-cg c))))
          (if (or (not best) (> s best-s))
            (begin (set best c) (set best-s s))))))
    (if best best '(none))))

;;; Common-subexpression elimination for duplicate fragment/template nodes.
;;; Only nodes with the same kind, attrs, and inputs are merged.
(define-function mg-cse-key (n)
  (list (mg-node-kind n) (mg-node-attrs n) (mg-node-inputs n)))
(define-function mg-cse-eligible? (n)
  (or (equal (mg-node-kind n) 'fragment)
      (equal (mg-node-kind n) 'template)))
(define-function mg-cse-maps (nodes)
  (let ((seen ()) (idmap ()) (vmap ()))
    (list-do n nodes
      (if (mg-cse-eligible? n)
        (let* ((key (mg-cse-key n))
               (hs (l-filter (lambda (e) (equal key (car e))) seen))
               (hit (if hs (l-nth (car hs) 1) ())))
          (if hit
            (begin
              (set idmap (cons (list (mg-node-id n) (mg-node-id hit)) idmap))
              (set vmap (cons (list (l-nth (mg-node-outputs n) 0)
                                    (l-nth (mg-node-outputs hit) 0)) vmap)))
            (set seen (l-append seen (list (list key n))))))))
    (list idmap vmap)))
(define-function mg-rewrite (x map)
  (if (not (l-list? x))
    (let ((hit (l-assoc x map))) (if hit (l-nth hit 1) x))
    (let ((hit (l-assoc x map)))
      (if hit (l-nth hit 1)
        (l-map (lambda (y) (mg-rewrite y map)) x)))))
(define-function mg-cse (g)
  (if (not (mg-graph? g)) '(rejected107 mg-cse-shape)
    (let* ((maps (mg-cse-maps (mg-nodes g)))
           (idmap (car maps)) (vmap (l-nth maps 1)) (map (l-append idmap vmap))
           (drop-ids (l-map car idmap)) (drop-vals (l-map car vmap))
           (ns ()) (vs ()) (es ()))
      (list-do n (mg-nodes g)
        (if (not (l-member? (mg-node-id n) drop-ids))
          (set ns (l-append ns (list (mg-node (mg-rewrite (mg-node-id n) map)
            (mg-node-kind n)
            (l-map (lambda (v) (mg-rewrite v map)) (mg-node-inputs n))
            (l-map (lambda (v) (mg-rewrite v map)) (mg-node-outputs n))
            (mg-rewrite (mg-node-attrs n) map)))))))
      (list-do v (mg-values g)
        (if (not (l-member? (mg-value-id v) drop-vals))
          (set vs (l-append vs (list (mg-value (mg-value-id v) (mg-value-type v)
            (mg-rewrite (mg-value-producer v) map)))))))
      (list-do e (mg-edges g)
        (let ((ev (mg-rewrite (mg-edge-value e) map))
              (en (mg-rewrite (mg-edge-node e) map)))
          (if (and (not (l-member? en drop-ids))
                   (not (l-member? ev drop-vals)))
            (set es (l-append es (list (mg-edge ev en (mg-edge-port e))))))))
      (mg-graph vs ns es))))

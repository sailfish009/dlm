;;; Numeric worker and a separate primitive-expansion checker.
;;; Same bounded arithmetic implementation, separate dispatch/control paths.
;;; Python cmath/mpmath oracles independently assess arithmetic in experiments.
(define-function e93-runtime (fuel) (list 'runtime93 fuel 0 0 ()))
(define-function e93-spend (r)
  (s79-field (s79-field r 1 (- (dlm-nth r 1) 1)) 2 (+ 1 (dlm-nth r 2))))
(define-function e93-value (status z r) (list 'value93 status z r))
(define e93-eval ())
(define-function e93-eval-args (args inputs lib branch r)
  (let ((out ()) (status 'complete))
    (list-do a args (if (= status 'complete)
      (let ((v (e93-eval a inputs lib branch r)))
        (set r (dlm-nth v 3)) (set status (dlm-nth v 1))
        (if (= status 'complete) (set out (dlm-append out (list (dlm-nth v 2))))))))
    (e93-value status (if (= status 'complete) out ()) r)))
(set e93-eval (lambda (t inputs lib branch r)
  (if (<= (dlm-nth r 1) 0) (e93-value 'unknown () r)
    (begin (set r (e93-spend r))
      (cond ((= t 'one93) (e93-value 'complete '(z93 1000000 0) r))
        ((= (car t) 'x93) (e93-value 'complete (dlm-nth inputs (dlm-nth t 1)) r))
        ((= (car t) 'eml93)
          (let ((a (e93-eval (dlm-nth t 1) inputs lib branch r)))
            (if (not (= (dlm-nth a 1) 'complete)) a
              (let ((b (e93-eval (dlm-nth t 2) inputs lib branch (dlm-nth a 3))))
                (if (not (= (dlm-nth b 1) 'complete)) b
                  (let ((z (e93-eml (dlm-nth a 2) (dlm-nth b 2) branch)))
                    (e93-value (if (e93-z? z) 'complete 'undefined) z (dlm-nth b 3))))))))
        (else
          (let* ((id (dlm-nth t 1)) (b (e93-find lib id))
                 (args (e93-eval-args (dlm-nth t 2) inputs lib branch r)))
            (if (not (= (dlm-nth args 1) 'complete)) args
              (begin (set r (dlm-nth args 3))
                (set r (s79-field (s79-field r 3 (+ (dlm-nth r 3) 1)) 4 (cons id (dlm-nth r 4))))
                (e93-eval (dlm-nth b 3) (dlm-nth args 2) lib branch r))))))))))
(define-function e93-raw (t inputs branch)
  (cond ((= t 'one93) '(z93 1000000 0)) ((= (car t) 'x93) (dlm-nth inputs (dlm-nth t 1)))
    (else (let ((a (e93-raw (dlm-nth t 1) inputs branch)) (b (e93-raw (dlm-nth t 2) inputs branch)))
      (if (and (e93-z? a) (e93-z? b)) (e93-eml a b branch) '(undefined93 child))))))
(define-function e93-fit (t rows lib branch tolerance r)
  (let ((status 'matched) (values ()))
    (list-do row rows (if (= status 'matched)
      (let ((v (e93-eval t (dlm-nth row 2) lib branch r)))
        (set r (dlm-nth v 3))
        (cond ((= (dlm-nth v 1) 'unknown) (set status 'unknown))
          ((not (and (= (dlm-nth v 1) 'complete) (e93-close? (dlm-nth v 2) (dlm-nth row 3) tolerance)))
            (set status 'failed))
          (else (set values (dlm-append values (list (dlm-nth v 2)))))))))
    (list 'fit93 status (if (= status 'matched) values ()) r)))
(define-function e93-check-values (expanded rows values branch tolerance)
  (and (= (dlm-length rows) (dlm-length values))
    (let ((ok true) (i 0)) (list-do row rows
      (let ((z (e93-raw expanded (dlm-nth row 2) branch)))
        (if (not (and (e93-z? z) (equal z (dlm-nth values i))
          (e93-close? z (dlm-nth row 3) tolerance))) (set ok false))) (set i (+ i 1))) ok)))
(define-function e93-infer (m source inputs fuel)
  (if (not (and (e93-core? m) (sq-name? source) (dlm-proper? inputs 2)
    (e93-arity? (dlm-length inputs)) (e93-inputs? inputs (dlm-length inputs)) (b91-fuel? fuel)))
    '(rejected93 query)
    (let ((view ()) (cell (e93-cell inputs)))
      (list-do v (dlm-nth m 4) (if (and (equal source (dlm-nth v 1))
        (equal cell (dlm-nth v 4)) (= (dlm-length inputs) (dlm-nth v 3))) (set view v)))
      (if (not view) (list 'answer93 'unknown 'uncovered-scope cell)
        (let* ((plan (dlm-nth view 5)) (lib (dlm-nth m 3))
               (v (e93-eval plan inputs lib (dlm-nth m 2) (e93-runtime fuel))))
          (cond ((not (= (dlm-nth v 1) 'complete)) (list 'answer93 'unknown (dlm-nth v 1) (dlm-nth v 2)))
            ((not (equal (dlm-nth v 2) (e93-raw (e93-expand plan lib) inputs (dlm-nth m 2))))
              '(rejected93 worker-check))
            (else (list 'answer93 'complete (dlm-nth v 2) 'empirical93 plan
              (dlm-nth v 3) (list 'scope93 source (dlm-nth view 2) cell (dlm-nth m 2))))))))))

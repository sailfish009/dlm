;;; selfssl.l — multi-round self-supervised theory expansion in one process.
;;; Labels are generated from the current proof closure, then re-induced.
(define-function ssl-atom-in? (a xs)
  (l-any? (lambda (x) (equal a x)) xs))
(define-function ssl-uniq-atoms (xs)
  (if (not xs) ()
    (cons (car xs) (ssl-uniq-atoms (l-filter (lambda (x) (not (equal x (car xs)))) (cdr xs))))))
(define-function ssl-new-pos (facts rules pos)
  (let* ((t (p-close facts rules 20000))
         (self (l-filter (lambda (f) (equal (l-pred (l-fact-atom f)) 'isa)) t))
         (atoms (l-map l-fact-atom self)))
    (l-filter (lambda (a) (not (ssl-atom-in? a pos))) atoms)))
(define-function ssl-round (facts pos neg basis i)
  (let* ((p (s-template-synthesize facts pos neg 20000))
         (prog? (s-rec-program? p))
         (rules (if prog? (s-rec-rules p) ()))
         (id (concat-strings "SSL-" (number->string i)))
         (b2 (if prog? (b-cse (b-activate (b-add basis id rules (list "web:selfsup") (s-rec-support p)) id)) basis))
         (new (if prog? (ssl-new-pos facts (b-active-rules b2) pos) ())))
    (list b2 (ssl-uniq-atoms (l-append pos new)) new (l-len rules))))

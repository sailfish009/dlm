;;; d107-util.l — shared helpers. Definition order matters in Maru: no forward
;;; references. Integers are 63-bit and wrap, so digests stay additive over text.

(define-function p107-nth (xs n) (if (= n 0) (car xs) (p107-nth (cdr xs) (- n 1))))
(define-function p107-len (xs) (if xs (+ 1 (p107-len (cdr xs))) 0))
(define-function p107-append (xs ys) (if xs (cons (car xs) (p107-append (cdr xs) ys)) ys))
(define-function p107-rev (xs) (if xs (p107-append (p107-rev (cdr xs)) (list (car xs))) ()))
(define-function p107-member? (x xs) (and xs (or (equal x (car xs)) (p107-member? x (cdr xs)))))
(define-function p107-add (xs x) (if (p107-member? x xs) xs (p107-append xs (list x))))
(define-function p107-union (xs ys) (if ys (p107-union (p107-add xs (car ys)) (cdr ys)) xs))
(define-function p107-diff (xs ys)
  (if xs (if (p107-member? (car xs) ys) (p107-diff (cdr xs) ys)
           (cons (car xs) (p107-diff (cdr xs) ys))) ()))
(define-function p107-assoc (k xs) (if xs (if (equal k (car (car xs))) (car xs) (p107-assoc k (cdr xs))) ()))
(define-function p107-take (xs n) (if (or (not xs) (= n 0)) () (cons (car xs) (p107-take (cdr xs) (- n 1)))))
(define-function p107-drop (xs n) (if (or (not xs) (= n 0)) xs (p107-drop (cdr xs) (- n 1))))
(define-function p107-map (f xs) (if xs (cons (f (car xs)) (p107-map f (cdr xs))) ()))
(define-function p107-filter (f xs)
  (if xs (if (f (car xs)) (cons (car xs) (p107-filter f (cdr xs))) (p107-filter f (cdr xs))) ()))
(define-function p107-intersection (xs ys)
  (p107-filter (lambda (x) (p107-member? x ys)) xs))
(define-function p107-range (n) (let ((out ()) (i 0)) (while (< i n) (set out (p107-append out (list i))) (set i (+ i 1))) out))
(define-function p107-proper? (x n)
  (cond ((= n 0) (not x)) ((not (pair? x)) false) (else (p107-proper? (cdr x) (- n 1)))))
(define-function p107-shape? (x n) (and (pair? x) (p107-proper? x n)))
(define-function p107-any? (f xs) (if xs (or (f (car xs)) (p107-any? f (cdr xs))) false))

;;; A proper-list test that never calls cdr on a non-pair (guards malformed input).
(define-function p107-list? (x) (if (not (pair? x)) (not x) (p107-list? (cdr x))))

(define-function p107-set (xs i v)
  (if (= i 0) (cons v (cdr xs)) (cons (car xs) (p107-set (cdr xs) (- i 1) v))))
(define-function p107-str (x) (if (string? x) x (symbol->string x)))

;;; Strings. Maru exposes string-length/string-at/concat-strings/string-compare.
(define-function p107-chars (cs)
  (let ((r (string (p107-len cs))) (j 0))
    (list-do c cs (set (string-at r j) c) (set j (+ j 1))) r))
(define-function p107-slice (s a b)
  (let ((end (if (> b (string-length s)) (string-length s) b)) (out ()) (i a))
    (while (< i end) (set out (p107-append out (list (string-at s i)))) (set i (+ i 1)))
    (p107-chars out)))
(define-function p107-join-strings (xs sep)
  (if (not xs) "" (if (not (cdr xs)) (car xs)
    (concat-strings (car xs) (concat-strings sep (p107-join-strings (cdr xs) sep))))))
(define-function p107-has-char (s c)
  (let ((i 0) (found false)) (while (< i (string-length s))
    (if (= (string-at s i) c) (set found true)) (set i (+ i 1))) found))
(define-function p107-prefix? (s p)
  (and (>= (string-length s) (string-length p)) (equal (p107-slice s 0 (string-length p)) p)))
(define-function p107-hash32 (s)
  ;; FNV-1a (32 bit). Order-sensitive; a change detector, not a cryptographic hash.
  (let ((h 2166136261) (i 0))
    (while (< i (string-length s))
      (set h (bitwise-and (bitwise-xor h (string-at s i)) 0xffffffff))
      (set h (bitwise-and (* h 16777619) 0xffffffff))
      (set i (+ i 1)))
    h))
(define-function p107-escape (s)
  (let ((out ()) (i 0))
    (while (< i (string-length s))
      (let ((c (string-at s i)))
        (if (or (= c 34) (= c 92)) (set out (p107-append out (list 92 c)))
          (set out (p107-append out (list c)))))
      (set i (+ i 1)))
    (p107-chars out)))
(define-function p107-serialize (x)
  (cond ((string? x) (concat-strings "\"" (concat-strings (p107-escape x) "\"")))
        ((symbol? x) (symbol->string x))
        ((is <long> x) (number->string x))
        ((and (pair? x) (p107-list? x))
         (concat-strings "(" (concat-strings (p107-join-strings (p107-map p107-serialize x) " ") ")")))
        ((pair? x) "#dotted")
        (else "?")))
(define-function p107-digest (x) (p107-hash32 (p107-serialize x)))
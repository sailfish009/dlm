;;; match.l — assemble programs and match them to fixed tasks.
(define-function m-task (name facts pos neg align) (list 'task name facts pos neg align))
(define-function m-task? (t)
  (and (l-shape? t 6) (equal (car t) 'task) (l-name? (l-nth t 1))
       (l-list? (l-nth t 2)) (l-list? (l-nth t 3)) (l-list? (l-nth t 4))
       (l-list? (l-nth t 5))))
(define-function m-name (t) (l-nth t 1))
(define-function m-facts (t) (l-nth t 2))
(define-function m-pos (t) (l-nth t 3))
(define-function m-neg (t) (l-nth t 4))
(define-function m-align (t) (l-nth t 5))
(define-function m-fact-records (t)
  (let ((out ()) (i 0))
    (list-do a (m-facts t)
      (set out (l-append out (list (l-fact (concat-strings "t" (number->string i)) a))))
      (set i (+ i 1)))
    out))
(define-function m-covered (atoms table)
  (let ((n 0)) (list-do a atoms (if (l-lookup a table) (set n (+ n 1)))) n))
(define-function m-eval (t rules)
  (let* ((c (l-close (m-fact-records t) rules 20000)) (table (l-nth c 1)))
    (list (m-covered (m-pos t) table) (l-len (m-pos t))
          (m-covered (m-neg t) table))))
(define-function m-active-rules (t programs active)
  (let ((out ()))
    (list-do id active
      (let ((p (let ((hit ())) (list-do q programs (if (equal id (a-program-id q)) (set hit q))) hit)))
        (if p
          (list-do r (a-program-rules p)
            (set out (l-append out (list (a-instantiate-rule r (m-align t)))))))))
    out))
(define-function m-select (t programs active)
  (let* ((base (m-eval t (m-active-rules t programs active)))
         (bc (l-nth base 0)) (bt (l-nth base 1)) (bf (l-nth base 2)))
    (if (and (= bc bt) (= bf 0))
      (list 'kept active bc bt bf)
      (let ((best ()) (best-c bc) (best-f bf))
        (list-do p programs
          (let ((id (a-program-id p)))
            (if (not (l-member? id active))
              (let ((e (m-eval t (m-active-rules t programs (l-append active (list id))))))
                (if (and (= (l-nth e 2) 0) (> (l-nth e 0) best-c))
                  (begin (set best id) (set best-c (l-nth e 0)) (set best-f (l-nth e 2))))))))
        (if best
          (list 'selected (l-append active (list best)) best-c bt best-f)
          (list 'failed active bc bt bf))))))
(define-function m-run (tasks programs)
  (let ((active ()) (solved 0))
    (list-do t tasks
      (let* ((r (m-select t programs active))
             (na (l-nth r 1)) (c (l-nth r 2)) (tot (l-nth r 3)) (f (l-nth r 4)))
        (set active na)
        (if (and (= c tot) (= f 0)) (set solved (+ solved 1)))
        (print "MATCH " (m-name t) " active=" (l-len active)
               " covered=" c "/" tot " conflict=" f " result=" (car r) "\n")))
    (list 'summary 'tasks (l-len tasks) 'solved solved 'active active)))

;;; logic.l — minimal terms, atoms, rules, facts and unification.
;;; This is a fresh CPU-only core; it does not import the d107 modules.

(define-function l-nth (xs n)
  (if (= n 0) (car xs) (l-nth (cdr xs) (- n 1))))
(define-function l-len (xs) (if xs (+ 1 (l-len (cdr xs))) 0))
(define-function l-append (xs ys)
  (if xs (cons (car xs) (l-append (cdr xs) ys)) ys))
(define-function l-map (f xs) (if xs (cons (f (car xs)) (l-map f (cdr xs))) ()))
(define-function l-filter (f xs)
  (if xs (if (f (car xs)) (cons (car xs) (l-filter f (cdr xs))) (l-filter f (cdr xs))) ()))
(define-function l-member? (x xs) (and xs (or (equal x (car xs)) (l-member? x (cdr xs)))))
(define-function l-assoc (k xs) (if xs (if (equal k (car (car xs))) (car xs) (l-assoc k (cdr xs))) ()))
(define-function l-list? (x) (if (not (pair? x)) (not x) (l-list? (cdr x))))
(define-function l-proper? (x n)
  (cond ((= n 0) (not x)) ((not (pair? x)) false) (else (l-proper? (cdr x) (- n 1)))))
(define-function l-shape? (x n) (and (pair? x) (l-proper? x n)))

(define-function l-var (name) (list 'var name))
(define-function l-var? (x)
  (and (l-shape? x 2) (equal (car x) 'var) (symbol? (l-nth x 1))))
(define-function l-constant? (x)
  (or (string? x) (and (symbol? x) (not (equal x ())))))
(define-function l-term? (x) (or (l-constant? x) (l-var? x)))
(define-function l-any? (f xs) (if xs (or (f (car xs)) (l-any? f (cdr xs))) false))
(define-function l-atom? (a)
  (and (l-shape? a 3) (equal (car a) 'atom)
       (symbol? (l-nth a 1)) (l-list? (l-nth a 2))
       (not (l-any? (lambda (x) (not (l-term? x))) (l-nth a 2)))))
(define-function l-pred (a) (l-nth a 1))
(define-function l-args (a) (l-nth a 2))
(define-function l-atom (p args) (list 'atom p args))
(define-function l-ground-atom? (a)
  (and (l-atom? a) (not (l-any? l-var? (l-args a)))))
(define-function l-atom-key (a) (cons (l-pred a) (l-args a)))

(define-function l-rule (head body) (list 'rule head body))
(define-function l-rule? (r)
  (and (l-shape? r 3) (equal (car r) 'rule)
       (l-atom? (l-nth r 1)) (l-list? (l-nth r 2))
       (not (l-any? (lambda (a) (not (l-atom? a))) (l-nth r 2)))))
(define-function l-head (r) (l-nth r 1))
(define-function l-body (r) (l-nth r 2))

(define-function l-name? (x)
  (or (string? x) (and (symbol? x) (not (equal x ())))))
(define-function l-fact (id atom) (list 'fact id atom))
(define-function l-fact? (f)
  (and (l-shape? f 3) (equal (car f) 'fact)
       (l-name? (l-nth f 1)) (l-ground-atom? (l-nth f 2))))
(define-function l-fact-id (f) (l-nth f 1))
(define-function l-fact-atom (f) (l-nth f 2))

(define-function l-subst (pairs) (cons 'subst pairs))
(define-function l-pairs (s) (cdr s))
(define-function l-subst? (s) (and (pair? s) (equal (car s) 'subst) (l-list? (cdr s))))
(define-function l-walk (t s)
  (if (l-var? t)
    (let ((h (l-assoc t (l-pairs s)))) (if h (l-walk (l-nth h 1) s) t))
    t))
(define-function l-bind (v val s)
  (let ((old (l-assoc v (l-pairs s))))
    (cond (old (if (equal (l-nth old 1) val) s false))
          ((and (l-var? val) (equal v val)) s)
          (else (l-subst (cons (list v val) (l-pairs s)))))))
(define-function l-unify (a b s)
  (if (equal s false) false
    (let ((a (l-walk a s)) (b (l-walk b s)))
      (cond ((equal a b) s)
            ((l-var? a) (l-bind a b s))
            ((l-var? b) (l-bind b a s))
            (else false)))))
(define-function l-unify-args (as bs s)
  (cond ((equal s false) false)
        ((not as) (if bs false s))
        ((not bs) false)
        (else (l-unify-args (cdr as) (cdr bs) (l-unify (car as) (car bs) s)))))
(define-function l-unify-atom (a b s)
  (if (not (and (l-atom? a) (l-atom? b)
                (equal (l-pred a) (l-pred b))
                (= (l-len (l-args a)) (l-len (l-args b)))))
    false
    (l-unify-args (l-args a) (l-args b) s)))
(define-function l-subst-args (args s) (l-map (lambda (x) (l-walk x s)) args))
(define-function l-subst-atom (a s) (l-atom (l-pred a) (l-subst-args (l-args a) s)))
(define-function l-done? (a s) (l-ground-atom? (l-subst-atom a s)))


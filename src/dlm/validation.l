;;; -*- mode: lisp; coding: us-ascii -*-
;;; Bounded shape checks reject improper/cyclic list spines.
(define-function dlm-proper? (xs fuel)
  (or (not xs) (and (> fuel 0) (pair? xs) (dlm-proper? (cdr xs) (- fuel 1)))))
(define-function dlm-term? (x)
  (or (symbol? x) (string? x) (is <long> x)
      (and (pair? x) (dlm-proper? x 3) (= (dlm-length x) 2)
           (= (car x) 'var) (or (symbol? (dlm-nth x 1)) (string? (dlm-nth x 1))))))
(define-function dlm-terms? (xs)
  (or (not xs) (and (dlm-term? (car xs)) (dlm-terms? (cdr xs)))))
(define-function dlm-atom? (a)
  (and (pair? a) (dlm-proper? a 4) (= (dlm-length a) 3)
       (= (car a) 'atom) (or (symbol? (dlm-nth a 1)) (string? (dlm-nth a 1)))
       (dlm-proper? (dlm-nth a 2) 1000) (dlm-terms? (dlm-nth a 2))))
(define-function dlm-atoms? (xs)
  (or (not xs) (and (dlm-atom? (car xs)) (dlm-atoms? (cdr xs)))))
(define-function dlm-rule? (r)
  (and (pair? r) (dlm-proper? r 4) (= (dlm-length r) 3)
       (= (car r) 'rule) (dlm-atom? (dlm-nth r 1))
       (dlm-proper? (dlm-nth r 2) 1000) (dlm-atoms? (dlm-nth r 2))))

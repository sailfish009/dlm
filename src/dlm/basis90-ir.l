;;; CPU-only relational basis experiment. Data, never executable Maru source.
;;; Grammar: (rel90 NAME), (join90 LEFT RIGHT), (use90 POSITIVE-ID).
;;; Meaning: binary relations and existential relational composition only.
;;; State: tag version signature episodes library tasks audit epoch.
;;; A task stores its immutable public expression and current execution plan.
(define-function b90-name? (x) (and x (sq-name? x)))
(define-function b90-names? (xs maximum)
  (and (dlm-proper? xs maximum)
    (let ((seen ()) (ok true)) (list-do x xs
      (if (and (b90-name? x) (not (dlm-member? x seen)))
        (set seen (cons x seen)) (set ok false))) ok)))
(define-function b90-signature? (sig) (and sig (b90-names? sig 8)))
(define-function b90-module (lib id)
  (let ((out ())) (list-do m lib (if (= id (dlm-nth m 1)) (set out m))) out))
(define-function b90-find (records id)
  (let ((out ())) (list-do r records (if (equal id (dlm-nth r 1)) (set out r))) out))
;;; This walk computes semantics from bodies, not from a module's claimed word.
(define-function b90-word (e sig lib depth)
  (if (not (and (> depth 0) (dlm-proper? e 3) (pair? e))) ()
    (cond
      ((and (sq-shape? e 2) (= (car e) 'rel90) (dlm-member? (dlm-nth e 1) sig))
        (list (dlm-nth e 1)))
      ((and (sq-shape? e 2) (= (car e) 'use90) (is <long> (dlm-nth e 1))
            (> (dlm-nth e 1) 0))
        (let ((m (b90-module lib (dlm-nth e 1))))
          (if m (b90-word (dlm-nth m 2) sig lib (- depth 1)) ())))
      ((and (sq-shape? e 3) (= (car e) 'join90))
        (let ((a (b90-word (dlm-nth e 1) sig lib (- depth 1)))
              (b (b90-word (dlm-nth e 2) sig lib (- depth 1))))
          (if (and a b (<= (+ (dlm-length a) (dlm-length b)) 4)) (dlm-append a b) ())))
      (else ()))))
(define-function b90-word? (word sig)
  (and word (dlm-proper? word 4)
    (let ((ok true)) (list-do p word (if (not (dlm-member? p sig)) (set ok false))) ok)))
(define-function b90-library? (lib sig)
  (and (dlm-proper? lib 8)
    (let ((prefix ()) (words ()) (ok true) (id 1))
      (list-do m lib
        (if ok
          (if (and (sq-shape? m 4) (= (car m) 'basis90) (= (dlm-nth m 1) id)
                   (b90-word? (dlm-nth m 3) sig) (>= (dlm-length (dlm-nth m 3)) 2)
                   (equal (b90-word (dlm-nth m 2) sig prefix 16) (dlm-nth m 3))
                   (not (dlm-member? (dlm-nth m 3) words)))
            (begin (set prefix (dlm-append prefix (list m)))
                   (set words (cons (dlm-nth m 3) words)) (set id (+ id 1)))
            (set ok false)))) ok)))
(define-function b90-size (e)
  (if (= (car e) 'join90) (+ 1 (+ (b90-size (dlm-nth e 1)) (b90-size (dlm-nth e 2)))) 1))
;;; Tokens retain use90 as an atomic execution unit; they do NOT unfold it.
(define-function b90-tokens (e)
  (if (= (car e) 'join90) (dlm-append (b90-tokens (dlm-nth e 1)) (b90-tokens (dlm-nth e 2))) (list e)))
(define-function b90-expression (tokens)
  (if (cdr tokens) (list 'join90 (car tokens) (b90-expression (cdr tokens))) (car tokens)))
(define-function b90-use-count (e id)
  (cond ((= (car e) 'join90) (+ (b90-use-count (dlm-nth e 1) id) (b90-use-count (dlm-nth e 2) id)))
        ((and (= (car e) 'use90) (= (dlm-nth e 1) id)) 1) (else 0)))
(define-function b90-facts? (facts sig)
  (and (dlm-proper? facts 24)
    (let ((ok true) (nodes ())) (list-do f facts
      (if (and (sq-shape? f 3) (= (car f) 'atom) (dlm-member? (dlm-nth f 1) sig)
               (sq-shape? (dlm-nth f 2) 2) (b90-name? (car (dlm-nth f 2)))
               (b90-name? (dlm-nth (dlm-nth f 2) 1)))
        (set nodes (dlm-union nodes (dlm-nth f 2))) (set ok false)))
      (and ok (<= (dlm-length nodes) 12)))))
(define-function b90-new (sig)
  (if (b90-signature? sig) (list 'basis-state90 1 sig () () () () 0) '(rejected90 signature)))
(define-function b90-core (s)
  (list 'basis-core90 (dlm-nth s 2) (dlm-nth s 3) (dlm-nth s 4) (dlm-nth s 5) (dlm-nth s 7)))
(define-function b90-core? (core)
  (and (sq-shape? core 6) (= (car core) 'basis-core90) (b90-signature? (dlm-nth core 1))
       (b90-library? (dlm-nth core 3) (dlm-nth core 1))
       (is <long> (dlm-nth core 5)) (= (dlm-nth core 5) (dlm-length (dlm-nth core 3)))
       (dlm-proper? (dlm-nth core 2) 4) (dlm-proper? (dlm-nth core 4) 16)
       (let ((ok true) (ids ()))
         (list-do ep (dlm-nth core 2)
           (if (and (sq-shape? ep 3) (= (car ep) 'episode90) (b90-name? (dlm-nth ep 1))
                    (not (dlm-member? (dlm-nth ep 1) ids)) (b90-facts? (dlm-nth ep 2) (dlm-nth core 1)))
             (set ids (cons (dlm-nth ep 1) ids)) (set ok false)))
         (set ids ())
         (list-do task (dlm-nth core 4)
           (if (and (sq-shape? task 4) (= (car task) 'task90) (b90-name? (dlm-nth task 1))
                    (not (dlm-member? (dlm-nth task 1) ids))
                    (b90-word (dlm-nth task 2) (dlm-nth core 1) () 8)
                    (equal (b90-word (dlm-nth task 2) (dlm-nth core 1) () 8)
                           (b90-word (dlm-nth task 3) (dlm-nth core 1) (dlm-nth core 3) 16)))
             (set ids (cons (dlm-nth task 1) ids)) (set ok false))) ok)))
(define-function b90-state? (s)
  (and (sq-shape? s 8) (= (car s) 'basis-state90) (= (dlm-nth s 1) 1)
       (dlm-proper? (dlm-nth s 6) 64) (b90-core? (b90-core s))))

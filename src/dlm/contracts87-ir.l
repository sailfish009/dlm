;;; Finite Boolean contract IR. No Scala/SMT runtime or imported Silicon code.
;;; (contract87 NAME VARIABLES PRE BODY POST WRITES)
;;; Expressions: (bool 0|1), (var NAME), (old NAME), not/and/or/eq.
;;; Statements: assign/assert/if/call; calls use a checked exact finite table.
(define-function c87-empty () '(library87 ()))
(define-function c87-module (lib name)
  (let ((out ())) (list-do m (dlm-nth lib 1)
    (if (equal name (dlm-nth (dlm-nth m 1) 1)) (set out m))) out))
(define-function c87-bindings (lib)
  (let ((out ())) (list-do m (dlm-nth lib 1)
    (set out (dlm-append out (list (dlm-nth m 1))))) out))
(define-function c87-names? (xs limit)
  (and (dlm-proper? xs limit)
    (let ((seen ()) (ok true)) (list-do x xs
      (if (and (sq-name? x) (not (dlm-member? x seen))) (set seen (cons x seen)) (set ok false))) ok)))
(define-function c87-expr? (e vars old? depth)
  (and (> depth 0) (pair? e) (dlm-proper? e 4)
    (let ((tag (car e)))
      (or (and (= tag 'bool) (sq-shape? e 2) (dlm-member? (dlm-nth e 1) '(0 1)))
          (and (or (= tag 'var) (and old? (= tag 'old))) (sq-shape? e 2) (dlm-member? (dlm-nth e 1) vars))
          (and (= tag 'not) (sq-shape? e 2) (c87-expr? (dlm-nth e 1) vars old? (- depth 1)))
          (and (dlm-member? tag '(and or eq)) (sq-shape? e 3)
               (c87-expr? (dlm-nth e 1) vars old? (- depth 1))
               (c87-expr? (dlm-nth e 2) vars old? (- depth 1)))))))
;;; Short circuit the AST node-count walk when the global limit is exceeded.
(define-function c87-size (body depth)
  (if (not (and (> depth 0) (dlm-proper? body 32))) 129
    (let ((n 0)) (list-do s body
      (if (<= n 128)
        (begin (set n (+ n 1))
          (if (and (sq-shape? s 4) (= (car s) 'if))
            (set n (+ n (+ (c87-size (dlm-nth s 2) (- depth 1))
                          (c87-size (dlm-nth s 3) (- depth 1))))))))) n)))
(define-function c87-body? (body vars writes lib depth)
  (and (> depth 0) (dlm-proper? body 32)
    (let ((ok true)) (list-do s body
      (if (not (and (pair? s) (dlm-proper? s 4)
        (cond
          ((= (car s) 'assign) (and (sq-shape? s 3) (dlm-member? (dlm-nth s 1) writes)
                                   (c87-expr? (dlm-nth s 2) vars false 16)))
          ((= (car s) 'assert) (and (sq-shape? s 2) (c87-expr? (dlm-nth s 1) vars false 16)))
          ((= (car s) 'if) (and (sq-shape? s 4) (c87-expr? (dlm-nth s 1) vars false 16)
              (c87-body? (dlm-nth s 2) vars writes lib (- depth 1))
              (c87-body? (dlm-nth s 3) vars writes lib (- depth 1))))
          ((= (car s) 'call) (and (sq-shape? s 2) (sq-name? (dlm-nth s 1))
            (let ((m (c87-module lib (dlm-nth s 1))))
              (and m (equal vars (dlm-nth (dlm-nth m 1) 2))
                   (not (dlm-difference (dlm-nth (dlm-nth m 1) 6) writes))))))
          (else false)))) (set ok false))) ok)))
(define-function c87-contract? (c lib)
  (and (sq-shape? c 7) (= (car c) 'contract87) (sq-name? (dlm-nth c 1))
       (not (c87-module lib (dlm-nth c 1)))
       (c87-names? (dlm-nth c 2) 6) (c87-names? (dlm-nth c 6) 6)
       (not (dlm-difference (dlm-nth c 6) (dlm-nth c 2)))
       (c87-expr? (dlm-nth c 3) (dlm-nth c 2) false 16)
       (c87-expr? (dlm-nth c 5) (dlm-nth c 2) true 16)
       (<= (c87-size (dlm-nth c 4) 8) 128)
       (c87-body? (dlm-nth c 4) (dlm-nth c 2) (dlm-nth c 6) lib 8)))
(define-function c87-eval (e env old)
  (let ((op (car e)))
    (cond
      ((= op 'bool) (dlm-nth e 1))
      ((= op 'var) (s79-at env (dlm-nth e 1)))
      ((= op 'old) (s79-at old (dlm-nth e 1)))
      ((= op 'not) (- 1 (c87-eval (dlm-nth e 1) env old)))
      (else (let ((a (c87-eval (dlm-nth e 1) env old)) (b (c87-eval (dlm-nth e 2) env old)))
        (if (cond ((= op 'and) (and (= a 1) (= b 1)))
                  ((= op 'or) (or (= a 1) (= b 1)))
                  (else (= a b))) 1 0))))))
(define-function c87-states (vars)
  (if (not vars) (list ())
    (let ((out ())) (list-do tail (c87-states (cdr vars))
      (set out (dlm-append out (list (cons (list (car vars) 0) tail) (cons (list (car vars) 1) tail))))) out)))
(define-function c87-frame? (c before after)
  (let ((ok true)) (list-do name (dlm-nth c 2)
    (if (and (not (dlm-member? name (dlm-nth c 6)))
             (not (= (s79-at before name) (s79-at after name)))) (set ok false))) ok))
(define-function c87-row (module input)
  (let ((out ())) (list-do r (dlm-nth (dlm-nth module 2) 3)
    (if (equal input (dlm-nth r 1)) (set out r))) out))

;;; proof.l — proof-carrying closure and counterfactual credit.
(define-function p-remove-nth (xs n)
  (if (not xs) ()
    (if (= n 0) (cdr xs) (cons (car xs) (p-remove-nth (cdr xs) (- n 1))))))
(define-function p-child-ids (body table sub)
  (let ((out ()) (ok true))
    (list-do a body
      (if ok
        (let* ((g (l-subst-atom a sub)) (f (l-lookup g table)))
          (if f (set out (l-append out (list (l-fact-id (car f)))))
            (set ok false)))))
    (if ok out false)))
(define-function p-derive (table rules next-id)
  (let ((new ()) (id next-id) (i 0))
    (list-do r rules
      (list-do sub (l-solve (l-body r) table (l-subst ()))
        (let* ((head (l-subst-atom (l-head r) sub))
               (kids (p-child-ids (l-body r) table sub)))
          (if (and (l-ground-atom? head) kids
                   (not (l-fact-in? (l-atom-key head) table))
                   (not (l-fact-in? (l-atom-key head) new)))
            (begin
              (set new (l-append new (list (list 'fact
                (concat-strings "p" (number->string id)) head
                (list 'pr i (l-pairs sub) kids)))))
              (set id (+ id 1))))))
      (set i (+ i 1)))
    (list new id)))
(define-function p-close (facts rules budget)
  (set *steps* 0) (set *exhausted* false) (set *budget* budget)
  (let ((table facts) (id 0) (changed true))
    (while (and changed (not *exhausted*))
      (let* ((r (p-derive table rules id)) (new (car r)))
        (set id (l-nth r 1))
        (if new (set table (l-append table new)) (set changed false))))
    table))
(define-function p-proof (facts rules goal budget)
  (let ((table (p-close facts rules budget)) (f (l-lookup goal (p-close facts rules budget))))
    (if f (l-nth (car f) 3) ())))
(define-function p-fact-by-id (id table)
  (let ((out ())) (list-do f table (if (equal id (l-fact-id f)) (set out f))) out))
(define-function p-proof-rule-indices (proof table)
  (if (or (not proof) (and (l-shape? proof 2) (equal (car proof) 'given))) ()
    (let ((out (list (l-nth proof 1))))
      (list-do kid (l-nth proof 3)
        (let ((f (p-fact-by-id kid table)))
          (if f
            (set out (l-append out
              (p-proof-rule-indices (l-nth (car f) 3) table))))))
      out)))
(define-function p-distinct (xs)
  (if (not xs) () (cons (car xs) (p-distinct (l-filter (lambda (x) (not (equal x (car xs)))) (cdr xs))))))
(define-function p-essential-rules (facts rules goal budget)
  (let ((out ()) (i 0))
    (while (< i (l-len rules))
      (let ((table (p-close facts (p-remove-nth rules i) budget)))
        (if (not (l-lookup goal table))
          (set out (l-append out (list i)))))
      (set i (+ i 1)))
    out))

(define-function p-frontier (facts rules goal budget)
  (let ((table (p-close facts rules budget)))
    (if (l-lookup goal table) ()
      (let ((out ()) (i 0))
        (while (and (< i (l-len rules)) (not out))
          (let* ((r (l-nth rules i)) (sub (l-unify-atom (l-head r) goal (l-subst ()))))
            (if sub
              (list-do a (l-body r)
                (let ((g (l-subst-atom a sub)))
                  (if (and (not out) (l-ground-atom? g)
                           (not (l-lookup g table)))
                    (set out (list 'missing107 g)))))))
          (set i (+ i 1)))
        (if out out (list 'missing107 goal))))))

;;; Goal-directed ground proof with rule-head indexing and memoization.
;;; This expands only goals/rules relevant to the query; it does not claim
;;; completeness for non-ground or negative goals.
(define *p-goal-table* ())
(define *p-goal-active* ())
(define *p-prove-probes* 0)
(define *p-rule-scans* 0)

(define-function p-remove-val (x xs)
  (if (not xs) () (if (equal x (car xs)) (cdr xs)
    (cons (car xs) (p-remove-val x (cdr xs))))))
(define-function p-goal-key (a) (l-atom-key a))
(define-function p-goal-cached (goal)
  (let ((hit (l-assoc (list (p-goal-key goal)) *p-goal-table*)))
    (if hit (l-nth hit 1) ())))
(define-function p-goal-put (goal proof)
  (set *p-goal-table* (cons (list (list (p-goal-key goal)) proof) *p-goal-table*)))
(define-function p-rule-head-key (r)
  (list (l-pred (l-head r)) (l-len (l-args (l-head r)))))
(define-function p-index-put (key entry xs)
  (let ((hit (l-assoc key xs)))
    (if hit
      (cons (list key (l-append (l-nth hit 1) (list entry)))
            (l-filter (lambda (e) (not (equal key (car e)))) xs))
      (cons (list key (list entry)) xs))))
(define-function p-build-rule-index (rules)
  (let ((out ()) (i 0))
    (list-do r rules
      (set out (p-index-put (p-rule-head-key r) (list i r) out))
      (set i (+ i 1)))
    out))
(define-function p-rule-candidates (index goal)
  (let ((hit (l-assoc (p-rule-head-key (l-rule goal ())) index)))
    (if hit (l-nth hit 1) ())))
(define-function p-zip-goals (body sub kids)
  (if (not body) ()
    (if (not kids) ()
      (cons (list (l-subst-atom (car body) sub) (car kids))
            (p-zip-goals (cdr body) sub (cdr kids))))))
(define-function p-check-plan (facts rules pending)
  (if (not pending) (not ())
    (let* ((item (car pending)) (goal (car item)) (proof (l-nth item 1)))
      (if (not proof) false
        (if (equal (car proof) 'given)
          (let ((f (p-fact-by-id (l-nth proof 1) facts)))
            (and f (equal goal (l-fact-atom f))
                 (p-check-plan facts rules (cdr pending))))
          (if (equal (car proof) 'pr)
            (let* ((i (l-nth proof 1)) (sub (l-subst (l-nth proof 2)))
                   (kids (l-nth proof 3)) (r (l-nth rules i)))
              (and (equal goal (l-subst-atom (l-head r) sub))
                   (p-check-plan facts rules
                     (l-append (p-zip-goals (l-body r) sub kids) (cdr pending)))))
            false))))))
(define-function p-proof-check (facts rules goal proof)
  (p-check-plan facts rules (list (list goal proof))))

(define-function p-sld (mode x facts rules index sub budget)
  (if (equal mode 'goal)
      (let ((goal x) (cached (p-goal-cached x)))
        (if cached cached
            (if (l-member? (p-goal-key goal) *p-goal-active*) ()
                (let ((fact (l-lookup goal facts)))
                  (if fact
                      (let ((pr (list 'given (l-fact-id (car fact)))))
                        (p-goal-put goal pr) pr)
                      (begin
                        (set *p-goal-active* (l-append *p-goal-active* (list (p-goal-key goal))))
                        (let ((cands (p-rule-candidates index goal)) (result ()))
                          (list-do cr cands
                            (if (not result)
                                (begin
                                  (set *p-prove-probes* (+ *p-prove-probes* 1))
                                  (set *p-rule-scans* (+ *p-rule-scans* 1))
                                  (if (l-spend)
                                      (let* ((i (l-nth cr 0)) (r (l-nth cr 1))
                                             (s0 (l-unify-atom (l-head r) goal (l-subst ()))))
                                        (if s0
                                            (let ((br (p-sld 'body (l-body r) facts rules index s0 budget)))
                                              (if br
                                                  (set result (list 'pr i (l-pairs (l-nth br 2))
                                                                    (l-nth br 1)))))))))))
                          (set *p-goal-active* (p-remove-val (p-goal-key goal) *p-goal-active*))
                          (if result (p-goal-put goal result))
                          result)))))))
      (let ((body x))
        (if (not body) (list 'ok () sub)
            (let ((g (l-subst-atom (car body) sub)))
              (if (l-ground-atom? g)
                  (let ((proof (p-sld 'goal g facts rules index sub budget)))
                    (if proof
                        (let ((rest (p-sld 'body (cdr body) facts rules index sub budget)))
                          (if rest (list 'ok (cons proof (l-nth rest 1)) (l-nth rest 2)) ()))
                        ()))
                  (let ((out ()))
                    (list-do f facts
                      (if (not out)
                          (begin
                            (set *p-prove-probes* (+ *p-prove-probes* 1))
                            (if (l-spend)
                                (let ((s2 (l-unify-atom g (l-fact-atom f) sub)))
                                  (if s2
                                      (let ((rest (p-sld 'body (cdr body) facts rules index s2 budget)))
                                        (if rest
                                            (set out (list 'ok
                                                           (cons (list 'given (l-fact-id f)) (l-nth rest 1))
                                                           (l-nth rest 2)))))))))))
                    out)))))))

(define *p-proof-cache* ())
(define-function p-proof-givens (proof)
  (if (not proof) ()
    (if (equal (car proof) 'given) (list (l-nth proof 1))
      (let ((out ()))
        (list-do k (l-nth proof 3)
          (set out (l-append out (p-proof-givens k))))
        out))))
(define-function p-used-facts (proof facts)
  (let ((out ()))
    (list-do id (p-proof-givens proof)
      (let ((f (p-fact-by-id id facts)))
        (if f (set out (l-append out (list f))))))
    out))
(define-function p-cache-live? (entry facts)
  (not (l-any? (lambda (f) (not (l-member? f facts))) (l-nth entry 2))))
(define-function p-cache-get (goal rules facts)
  (let ((out ()))
    (list-do e *p-proof-cache*
      (if (and (not out) (equal goal (car e)) (equal rules (l-nth e 1))
               (p-cache-live? e facts))
        (set out (l-nth e 3))))
    out))
(define-function p-cache-put (goal rules facts proof)
  (let ((used (p-used-facts proof facts)))
    (if (not (p-cache-get goal rules facts))
      (set *p-proof-cache*
        (l-append *p-proof-cache* (list (list goal rules used proof)))))))
(define-function p-clear-proof-cache () (set *p-proof-cache* ()))

(define-function p-prove (facts rules goal budget)
  (let ((cached (p-cache-get goal rules facts)))
    (if cached
      (begin
        (set *p-prove-probes* 0) (set *p-rule-scans* 0)
        (list 'presult 'proof cached 0 0))
      (begin
        (set *steps* 0) (set *exhausted* false) (set *budget* budget)
        (set *p-goal-table* ()) (set *p-goal-active* ())
        (set *p-prove-probes* 0) (set *p-rule-scans* 0)
        (let* ((index (p-build-rule-index rules))
               (proof (p-sld 'goal goal facts rules index (l-subst ()) budget)))
          (if proof (p-cache-put goal rules facts proof))
          (list 'presult (if proof 'proof 'fail) proof
                *p-prove-probes* *p-rule-scans*))))))

;;; Independent checker. Never calls the searcher's action/successor functions.
;;; Certificates are topologically serialized DAGs (references must precede use).
;;; This deliberately rejects forward refs, including all cycles.
(define-function sq-node? (n sig)
  (and (sq-shape? n 7) (= (car n) 'proof-node)
    (is <long> (dlm-nth n 1)) (>= (dlm-nth n 1) 0)
    (sq-sequent? (dlm-nth n 2) sig) (symbol? (dlm-nth n 3))
    (dlm-proper? (dlm-nth n 4) 4) (not (dlm-nth n 5))
    (dlm-proper? (dlm-nth n 6) 3)))
(define-function sq-check-step (n prior)
  (let ((s (dlm-nth n 2)) (rule (dlm-nth n 3)) (pos (dlm-nth n 4))
        (ids (dlm-nth n 6)) (children ()) (refs-ok true) (expected ()) (legal false))
    (list-do id ids
      (let ((entry (and (is <long> id) (dlm-assoc id prior))))
        (if entry (set children (dlm-append children (list (dlm-nth entry 1))))
          (set refs-ok false))))
    (if (= rule 'init)
        (if (and (= (dlm-length pos) 3) (= (car pos) 'both)
                 (sq-index? (dlm-nth pos 1) (sq-left s))
                 (sq-index? (dlm-nth pos 2) (sq-right s)))
            (let ((a (dlm-nth (sq-left s) (dlm-nth pos 1)))
                  (b (dlm-nth (sq-right s) (dlm-nth pos 2))))
              (set legal (and (= (car a) 'pred) (equal a b)))))
      (if (and (= (dlm-length pos) 2) (or (= (car pos) 'left) (= (car pos) 'right)))
          (let ((left? (= (car pos) 'left)) (i (dlm-nth pos 1)))
            (if (sq-index? i (if left? (sq-left s) (sq-right s)))
                (let ((f (dlm-nth (if left? (sq-left s) (sq-right s)) i))
                      (g (if left? (sq-remove (sq-left s) i) (sq-left s)))
                      (d (if left? (sq-right s) (sq-remove (sq-right s) i))))
                  (let ((tag (car f)) (a (dlm-nth f 1)) (b (dlm-nth f 2)))
                    (if (and left? (= tag 'bottom) (= rule 'bottom-left)) (set legal true))
                    (if (and (not left?) (= tag 'top) (= rule 'top-right)) (set legal true))
                    (if (and left? (= tag 'top) (= rule 'top-left))
                        (begin (set legal true) (set expected (list (sq-sequent g d)))))
                    (if (and (not left?) (= tag 'bottom) (= rule 'bottom-right))
                        (begin (set legal true) (set expected (list (sq-sequent g d)))))
                    (if (and left? (= tag 'not) (= rule 'not-left))
                        (begin (set legal true) (set expected (list (sq-sequent g (dlm-append d (list a)))))))
                    (if (and (not left?) (= tag 'not) (= rule 'not-right))
                        (begin (set legal true) (set expected (list (sq-sequent (dlm-append g (list a)) d)))))
                    (if (and left? (= tag 'and) (= rule 'and-left))
                        (begin (set legal true) (set expected (list (sq-sequent (dlm-append g (list a b)) d)))))
                    (if (and (not left?) (= tag 'and) (= rule 'and-right))
                        (begin (set legal true) (set expected (list
                          (sq-sequent g (dlm-append d (list a))) (sq-sequent g (dlm-append d (list b)))))))
                    (if (and left? (= tag 'or) (= rule 'or-left))
                        (begin (set legal true) (set expected (list
                          (sq-sequent (dlm-append g (list a)) d) (sq-sequent (dlm-append g (list b)) d)))))
                    (if (and (not left?) (= tag 'or) (= rule 'or-right))
                        (begin (set legal true) (set expected (list (sq-sequent g (dlm-append d (list a b)))))))
                    (if (and left? (= tag 'imp) (= rule 'imp-left))
                        (begin (set legal true) (set expected (list
                          (sq-sequent g (dlm-append d (list a))) (sq-sequent (dlm-append g (list b)) d)))))
                    (if (and (not left?) (= tag 'imp) (= rule 'imp-right))
                        (begin (set legal true) (set expected (list
                          (sq-sequent (dlm-append g (list a)) (dlm-append d (list b)))))))))))))
    (and legal refs-ok (equal children expected))))
(define-function sq-verify (cert root sig budget)
  (if (not (and (sq-signature? sig) (sq-sequent? root sig)
      (is <long> budget) (>= budget 0) (sq-shape? cert 4)
      (= (car cert) 'certificate) (= (dlm-nth cert 1) 'classical-prop-v1)
      (is <long> (dlm-nth cert 2)) (dlm-proper? (dlm-nth cert 3) 10000))) 'invalid-input
    (let ((prior ()) (status 'verified))
      (list-do node (dlm-nth cert 3)
        (if (= status 'verified)
            (if (<= budget 0) (set status 'incomplete)
              (begin (set budget (- budget 1))
                (if (and (sq-node? node sig) (not (dlm-assoc (dlm-nth node 1) prior))
                         (sq-check-step node prior))
                    (set prior (cons (list (dlm-nth node 1) (dlm-nth node 2)) prior))
                  (set status 'invalid-input))))))
      (if (= status 'verified)
          (let ((entry (dlm-assoc (dlm-nth cert 2) prior)))
            (if (and entry (equal (dlm-nth entry 1) root)) 'verified 'invalid-input)) status))))

;;; Native candidate-program synthesis and original-REPL contract library.
(define-function c87-action? (arg)
  (and (sq-shape? arg 3) (sq-shape? (car arg) 7) (= (car (car arg)) 'contract87)
       (sq-shape? (dlm-nth arg 1) 2) (= (car (dlm-nth arg 1)) 'library87)
       (c87-fuel? (dlm-nth arg 2))))
(define-function c87-action (arg)
  (if (c87-action? arg) (c87-verify (car arg) (dlm-nth arg 1) (dlm-nth arg 2)) '(invalid87 action 0)))
(set s87-action? c87-action?)
(set s87-verify c87-action)
;;; Rule grammar: skip, prior checked calls, assignments, short sequences, ifs.
;;; Truncation is a generation bound, NEVER proof of no possible program.
(define-function c87-generate (template lib)
  (let ((bodies (list ())) (actions ()))
    (list-do m (dlm-nth lib 1)
      (if (and (equal (dlm-nth template 2) (dlm-nth (dlm-nth m 1) 2))
               (not (dlm-difference (dlm-nth (dlm-nth m 1) 6) (dlm-nth template 6))))
        (set actions (dlm-append actions (list (list 'call (dlm-nth (dlm-nth m 1) 1)))))))
    (list-do target (dlm-nth template 6)
      (list-do value '((bool 0) (bool 1))
        (set actions (dlm-append actions (list (list 'assign target value)))))
      (list-do source (dlm-nth template 2)
        (set actions (dlm-append actions (list (list 'assign target (list 'var source)))))))
    (list-do action actions
      (if (< (dlm-length bodies) 16) (set bodies (dlm-append bodies (list (list action))))))
    (list-do a actions (list-do b actions
      (if (< (dlm-length bodies) 16) (set bodies (dlm-append bodies (list (list a b)))))))
    (list-do guard (dlm-nth template 2) (list-do a actions (list-do b actions
      (if (< (dlm-length bodies) 16)
        (set bodies (dlm-append bodies
          (list (list (list 'if (list 'var guard) (list a) (list b))))))))))
    (let ((out ())) (list-do body bodies (set out (dlm-append out (list (s79-field template 4 body))))) out)))
(define-function c87-search (candidates lib fuel)
          (let ((alternatives ()) (records ()) (chosen ()) (proof ()))
            (list-do c candidates
              (set alternatives (dlm-append alternatives
                (list (list (list 'verify87 (list c lib fuel)) (list 'accept c))))))
            (let* ((start (s79-program-job (s79-new) 'contract87 (list (list 'choose alternatives))))
                   (engine (s79-run start 256)) (job (s79-job engine 'contract87)))
              (list-do e (dlm-nth engine 3)
                (let* ((ctx (dlm-nth (dlm-nth (dlm-nth e 1) 5) 2))
                       (candidate (s79-at (dlm-nth ctx 1) 'candidate87))
                       (result (s79-at (dlm-nth ctx 1) 'checked87)))
                  (if result
                    (begin (set records (cons (list (dlm-nth candidate 4) (car result)
                        (if (= (car result) 'verified87) 'checked (dlm-nth result 1))) records))
                      (if (and (= (car result) 'verified87) (= (dlm-nth job 3) 'done)
                               (equal candidate (dlm-nth (dlm-nth job 5) 1)))
                        (begin (set chosen candidate) (set proof (dlm-nth result 1))))))))
              (let ((trace (list 'search87 'branches (dlm-length candidates) 'events (dlm-nth engine 10)
                                  'outcomes (s79-reverse records))))
                (if (not chosen) (list 'unknown87 'bounded-generation trace)
                  (let ((gate (c87-check chosen lib proof fuel)))
                    (if (= (dlm-nth gate 1) 'verified) (list 'synthesized87 chosen proof trace)
                      (list 'unknown87 'admission-check trace))))))))
(define-function c87-synth (template lib fuel)
  (if (not (c87-fuel? fuel)) '(invalid87 budget 0)
    (let ((checked (c87-library-check lib fuel)))
      (if (not (= (dlm-nth checked 1) 'verified))
          (list (if (= (dlm-nth checked 1) 'unknown) 'unknown87 'invalid87) 'library 0)
        (if (not (and (c87-contract? template lib) (not (dlm-nth template 4)))) '(invalid87 template 0)
          (c87-search (c87-generate template lib) lib fuel))))))
(define *c87-library* (c87-empty))
;;; Publication is transactional when the unified session88 module is loaded.
(define c88-publish (lambda (lib) (set *c87-library* lib) '(published87)))
(define-function c87-learn (template fuel)
  (if (>= (dlm-length (dlm-nth *c87-library* 1)) 8) '(unknown87 library-capacity 0)
    (let ((r (c87-synth template *c87-library* fuel)))
      (if (not (= (car r) 'synthesized87)) r
        (let ((published (c88-publish (list 'library87 (dlm-append (dlm-nth *c87-library* 1)
            (list (list 'module87 (dlm-nth r 1) (dlm-nth r 2))))))))
          (if (= (car published) 'published87)
            (list 'learned87 (dlm-nth (dlm-nth r 1) 1) (dlm-nth (dlm-nth r 1) 4) (dlm-nth r 3)) published))))))
(define-function c87-snapshot? (data)
  (and (sq-shape? data 3) (= (car data) 'contract-store87) (= (dlm-nth data 1) 1)
       (= (dlm-nth (c87-library-check (dlm-nth data 2) 200000) 1) 'verified)))
(define-function c87-restore (data)
  (if (not (c87-snapshot? data)) '(rejected87 snapshot)
    (if (not (or (equal *c87-library* (c87-empty)) (equal *c87-library* (dlm-nth data 2))))
      '(rejected87 reset-before-restore)
      (let ((published (c88-publish (dlm-nth data 2))))
        (if (= (car published) 'published87) '(restored87) published)))))
(define-function c87-load (path)
  (if (not (and (string? path) (not (equal path "")))) '(rejected87 path)
    (let ((lock (file-lock (concat-strings path ".lock"))))
      (if (not lock) '(rejected87 locked-or-path)
        (let ((data (e79-raw-read path)) (result ()))
          (set result (if (= (car data) 'data) (c87-restore (dlm-nth data 1)) '(rejected87 read)))
          (file-close lock) result)))))
(define-function c87-save (path)
  (if (not (and (string? path) (not (equal path "")))) '(rejected87 path)
    (let ((lock (file-lock (concat-strings path ".lock"))))
      (if (not lock) '(rejected87 locked-or-path)
        (let* ((data (list 'contract-store87 1 *c87-library*)) (old (e79-raw-read path))
               (tmp (concat-strings path ".next"))
               (ok (and (c87-snapshot? data)
                        (or (= (car old) 'missing)
                            (and (= (car old) 'data) (c87-snapshot? (dlm-nth old 1)))))))
          (if ok (set ok (and (d77-write tmp data) (equal (e79-raw-read tmp) (list 'data data)))))
          (if (and ok (= (car old) 'data))
            (let ((previous (concat-strings path ".previous.next")))
              (set ok (and (d77-write previous (dlm-nth old 1))
                           (file-replace previous (concat-strings path ".previous"))))))
          (if ok (set ok (and (equal old (e79-raw-read path)) (file-replace tmp path))))
          (if (not ok) (file-remove tmp))
          (file-close lock)
          (if ok '(saved87) '(rejected87 checkpoint)))))))
(define-function contracts args
  (let ((op (car args)) (rest (cdr args)) (n (dlm-length (cdr args))))
    (cond
      ((and (= op 'library) (= n 0)) *c87-library*)
      ((and (= op 'check-library) (= n 0)) (c87-library-check *c87-library* 200000))
      ((and (= op 'reset) (= n 0))
        (let ((r (c88-publish (c87-empty)))) (if (= (car r) 'published87) '(reset87) r)))
      ((and (= op 'snapshot) (= n 0)) (list 'contract-store87 1 *c87-library*))
      ((and (= op 'restore) (= n 1)) (c87-restore (car rest)))
      ((and (= op 'save) (= n 1)) (c87-save (car rest)))
      ((and (= op 'load) (= n 1)) (c87-load (car rest)))
      ((and (dlm-member? op '(verify admit synth learn)) (or (= n 1) (= n 2)))
        (let ((fuel (if (= n 2) (dlm-nth rest 1) 20000)))
          (cond
            ((= op 'verify) (c87-verify (car rest) *c87-library* fuel))
            ((= op 'synth) (c87-synth (car rest) *c87-library* fuel))
            ((= op 'learn) (c87-learn (car rest) fuel))
            (else (let ((r (c87-admit *c87-library* (car rest) fuel)))
              (if (= (car r) 'admitted87)
                (let ((published (c88-publish (dlm-nth r 1))))
                  (if (= (car published) 'published87) (list 'admitted87 (dlm-nth (car rest) 1)) published)) r))))))
      (else '(rejected87 command-or-arity)))))

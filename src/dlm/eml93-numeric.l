;;; CPU-native bounded complex fixed-point EML. No compiler changes or Python VM.
;;; Units = 10^-6. This is APPROXIMATE arithmetic, not a symbolic identity prover.
;;; exp accepts real parts [-6,6]; all complex components bounded by 1000.
;;; Undefined/overflow are explicit, never numerical training labels or falsehood.
(define *e93-scale* 1000000)
(define *e93-pi* 3141593)
(define-function e93-abs (x) (if (< x 0) (- 0 x) x))
(define-function e93-int? (x lo hi)
  (and (is <long> x) (>= x lo) (<= x hi)))
(define-function e93-z? (z)
  (and (sq-shape? z 3) (= (car z) 'z93)
    (e93-int? (dlm-nth z 1) -1000000000 1000000000)
    (e93-int? (dlm-nth z 2) -1000000000 1000000000)))
(define-function e93-z (a b)
  (if (and (<= (e93-abs a) 1000000000) (<= (e93-abs b) 1000000000))
    (list 'z93 a b) '(undefined93 range)))
(define-function e93-mul (a b) (/ (* a b) 1000000))
(define-function e93-div (a b) (/ (* a 1000000) b))
(define-function e93-exp-real (x)
  (let ((a (e93-abs x)) (term 1000000) (sum 1000000) (i 1))
    (while (<= i 32)
      (set term (/ (e93-mul term a) i)) (set sum (+ sum term)) (set i (+ i 1)))
    (if (< x 0) (e93-div 1000000 sum) sum)))
(define-function e93-ln-real (x)
  (let ((a x) (k 0))
    (while (< a 1000000) (set a (* a 2)) (set k (- k 1)))
    (while (>= a 2000000) (set a (/ a 2)) (set k (+ k 1)))
    (let* ((y (e93-div (- a 1000000) (+ a 1000000)))
           (yy (e93-mul y y)) (term y) (sum y) (i 3))
      (while (<= i 41) (set term (e93-mul term yy))
        (set sum (+ sum (/ term i))) (set i (+ i 2)))
      (+ (* 2 sum) (* k 693147)))))
(define-function e93-atan-small (x)
  (let ((term x) (sum x) (xx (e93-mul x x)) (i 3) (sign -1))
    (while (<= i 51) (set term (e93-mul term xx))
      (set sum (+ sum (* sign (/ term i)))) (set sign (- 0 sign)) (set i (+ i 2))) sum))
(define-function e93-atan-positive (x)
  (let ((a x) (invert false) (shift false))
    (if (> a 1000000) (begin (set invert true) (set a (e93-div 1000000 a))))
    (if (> a 414213) (begin (set shift true) (set a (e93-div (- a 1000000) (+ a 1000000)))))
    (let ((v (e93-atan-small a)))
      (if shift (set v (+ 785398 v)))
      (if invert (- 1570796 v) v))))
(define-function e93-angle (re im branch)
  (cond
    ((= im 0) (if (< re 0) (if (= branch 'lower93) -3141593 3141593) 0))
    ((= re 0) (if (> im 0) 1570796 -1570796))
    (else (let ((v (e93-atan-positive (e93-div (e93-abs im) (e93-abs re)))))
      (if (< re 0) (set v (- 3141593 v))) (if (< im 0) (- 0 v) v)))))
(define-function e93-sincos (angle)
  (let ((a (- angle (* (/ angle 6283186) 6283186))))
    (if (> a 3141593) (set a (- a 6283186)))
    (if (< a -3141593) (set a (+ a 6283186)))
    (cond
      ((= a 0) '(0 1000000))
      ((= (e93-abs a) 3141593) '(0 -1000000))
      ((= (e93-abs a) 1570796) (list (if (> a 0) 1000000 -1000000) 0))
      (else (let ((st a) (ss a) (ct 1000000) (cs 1000000) (i 1))
        (while (<= i 16)
          (set st (- 0 (/ (e93-mul (e93-mul st a) a) (* (* 2 i) (+ (* 2 i) 1)))))
          (set ct (- 0 (/ (e93-mul (e93-mul ct a) a) (* (- (* 2 i) 1) (* 2 i)))))
          (set ss (+ ss st)) (set cs (+ cs ct)) (set i (+ i 1))) (list ss cs))))))
(define-function e93-eml (a b branch)
  (if (not (and (e93-z? a) (e93-z? b) (or (= branch 'principal93) (= branch 'lower93)))) '(undefined93 operand-or-branch)
    (let ((ar (dlm-nth a 1)) (ai (dlm-nth a 2)) (br (dlm-nth b 1)) (bi (dlm-nth b 2)))
      (cond
        ((and (= br 0) (= bi 0)) '(undefined93 logarithm-zero))
        ((> (e93-abs ar) 6000000) '(undefined93 exponential-range))
        (else (let* ((logmag
                      (cond ((= bi 0) (e93-ln-real (e93-abs br)))
                        ((= br 0) (e93-ln-real (e93-abs bi)))
                        ;; Avoid rounding sqrt(re^2+im^2) to a whole grid unit
                        ;; BEFORE taking log: that badly distorts tiny inputs.
                        (else (/ (- (e93-ln-real (+ (* br br) (* bi bi)))
                          (e93-ln-real 1000000000000)) 2))))
                    (ex (e93-exp-real ar)) (sc (e93-sincos ai)))
          (e93-z (- (e93-mul ex (dlm-nth sc 1)) logmag)
            (- (e93-mul ex (car sc)) (e93-angle br bi branch)))))))))
(define-function e93-close? (a b tolerance)
  (and (e93-z? a) (e93-z? b)
    (<= (e93-abs (- (dlm-nth a 1) (dlm-nth b 1))) tolerance)
    (<= (e93-abs (- (dlm-nth a 2) (dlm-nth b 2))) tolerance)))

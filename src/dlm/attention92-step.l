;;; Pure transitions over owned states. External snapshots enter through replay.
;;; Rejected commands do not publish state; provisional rows are never answers.
(define-function a92-command? (s cmd)
  (let ((w (a92-work s)))
    (and (pair? cmd) (dlm-proper? cmd 7)
      (or (a92-focus? cmd s)
        (and (sq-shape? cmd 1)
          (cond
            ((= (car cmd) 'choose92) (and (= (dlm-nth w 7) 'ready) (dlm-nth w 1) (< (dlm-length (dlm-nth w 5)) 4)))
            ((= (car cmd) 'apply92) (= (dlm-nth w 7) 'focused))
            ((= (car cmd) 'local92) (= (dlm-nth w 7) 'applied))
            ((= (car cmd) 'widen92) (dlm-member? (dlm-nth w 7) '(focused need-widen)))
            ((= (car cmd) 'global92) (dlm-member? (dlm-nth w 7) '(ready focused)))
            ((= (car cmd) 'restore92) (and (dlm-nth w 5) (dlm-member? (dlm-nth w 7) '(ready focused applied local need-widen))))
            ((= (car cmd) 'finish92) (and (= (dlm-nth w 7) 'ready) (not (dlm-nth w 1)) (not (dlm-nth w 5))))
            (else false)))))))
(define-function a92-step (s cmd)
  (if (not (and (< (dlm-length (dlm-nth s 5)) 64) (a92-command? s cmd))) '(rejected92 command-phase-version-or-capacity)
    (let* ((ctx (dlm-nth s 2)) (model (dlm-nth ctx 1)) (lib (dlm-nth model 3))
           (ep (a92-episode ctx)) (old (a92-work s)) (w (a92-consume old 1)) (ok true))
      (set w (a92-metric w 1 1))
      (if (not (= (dlm-nth w 7) 'unknown))
        (cond
          ((= (car cmd) 'focus92) (set w (a92-focus-work w cmd lib)))
          ((= (car cmd) 'choose92)
            (let ((choice (a92-choice s)))
              (set w (a92-metric w 3 (dlm-nth choice 2)))
              (set w (a92-consume w (dlm-nth choice 2)))
              (if (not (= (dlm-nth w 7) 'unknown))
                (if (a92-focus? (dlm-nth choice 1) s)
                  (set w (a92-focus-work w (dlm-nth choice 1) lib)) (set ok false)))))
          ((= (car cmd) 'apply92)
            (let* ((op (a92-pending-op w))
                   (v (a92-execute op ep lib (dlm-nth w 4) (dlm-nth w 3) (a92-worker (dlm-nth w 8))))
                   (r (dlm-nth v 3)))
              (set w (s79-field w 8 (dlm-nth r 1)))
              (set w (a92-metric w 4 (dlm-nth r 2))) (set w (a92-metric w 5 (dlm-nth r 3)))
              (set w (a92-metric w 6 (dlm-nth r 4))) (set w (a92-metric w 7 (dlm-nth r 5)))
              (set w (s79-field w 9 (s79-field (dlm-nth w 9) 12 (dlm-union (dlm-nth (dlm-nth w 9) 12) (dlm-nth r 6)))))
              (set w (s79-field w 6 (list 'pending92 op (dlm-nth v 1) (dlm-nth v 2))))
              (set w (a92-phase w (if (= (dlm-nth v 1) 'complete) 'applied 'unknown)))))
          ((= (car cmd) 'local92)
            (let* ((op (a92-pending-op w)) (atoms (a92-op-atoms op ctx))
                   (coverage (a92-check-coverage atoms (dlm-nth w 3) ep (dlm-nth (dlm-nth w 4) 1) (dlm-nth w 8))))
              (set w (s79-field w 8 (dlm-nth (dlm-nth coverage 3) 1)))
              (set w (a92-metric w 8 (dlm-nth (dlm-nth coverage 3) 2)))
              (cond
                ((not (= (dlm-nth coverage 1) 'complete)) (set w (a92-phase w 'unknown)))
                ((not (dlm-nth coverage 2))
                  (set w (s79-field w 6 (list 'intent92 op))) (set w (a92-phase w 'need-widen)))
                (else
                  (let ((check (a92-check-rows atoms (dlm-nth w 3) (dlm-nth (dlm-nth w 6) 3) ep (dlm-nth w 8))))
                    (set w (s79-field w 8 (dlm-nth (dlm-nth check 3) 1)))
                    (set w (a92-metric w 8 (dlm-nth (dlm-nth check 3) 2)))
                    (cond
                      ((not (= (dlm-nth check 1) 'complete)) (set w (a92-phase w 'unknown)))
                      ((not (dlm-nth check 2)) (set ok false))
                      (else
                        (let ((plan (dlm-append (dlm-nth w 2) (list op))) (remaining (dlm-difference (dlm-nth w 1) atoms)))
                          (if (not (b91-plan? (dlm-nth ctx 3) (dlm-append plan (b91-primitive remaining)) (dlm-nth model 1) lib))
                            (set ok false)
                            (begin
                              (set w (s79-field w 1 remaining)) (set w (s79-field w 2 plan))
                              (set w (s79-field w 3 (dlm-nth (dlm-nth w 6) 3)))
                              (set w (s79-field w 6 ())) (set w (a92-phase w 'local))
                              (set w (a92-metric w 10 1))))))))))))
          ((or (= (car cmd) 'widen92) (= (car cmd) 'global92))
            (set w (s79-field w 4 (list 'scope92 (b91-range (dlm-length (dlm-nth ep 3))) (a92-basis-ids lib))))
            (if (= (car cmd) 'widen92) (begin (set w (a92-phase w 'focused)) (set w (a92-metric w 9 1)))))
          ((= (car cmd) 'restore92)
            (let ((frame (car (dlm-nth w 5))))
              (set w (s79-field w 4 (dlm-nth frame 1))) (set w (s79-field w 5 (cdr (dlm-nth w 5))))
              (set w (s79-field w 6 ())) (set w (a92-phase w 'ready))
              (if (and (= (dlm-nth frame 3) 'focused)
                       (a92-op-eligible? (dlm-nth (dlm-nth frame 2) 1) (dlm-nth w 1) ctx))
                (begin (set w (s79-field w 6 (dlm-nth frame 2))) (set w (a92-phase w 'focused))))
              (set w (a92-metric w 11 1))))
          ((= (car cmd) 'finish92)
            (let ((n (* (dlm-length (dlm-nth w 3)) (dlm-length (dlm-nth ctx 3)))))
              (set w (a92-consume w n)) (set w (a92-metric w 8 n))
              (if (not (= (dlm-nth w 7) 'unknown))
                (let ((cert (b91-certify (dlm-nth ctx 3) (dlm-nth w 3) ep)))
                  (if (and (= (car cert) 'certified91)
                           (b91-plan? (dlm-nth ctx 3) (dlm-nth w 2) (dlm-nth model 1) lib))
                    (begin (set w (s79-field w 11 (dlm-nth cert 1))) (set w (a92-phase w 'complete)))
                    (set ok false))))))))
      (if (not ok) '(rejected92 independent-check)
        (let ((trace (list 'transition92 cmd (dlm-nth old 7) (dlm-nth w 7)
                 (if (dlm-nth w 6) (a92-pending-op w) (if (dlm-nth old 6) (a92-pending-op old) ()))
                 (dlm-nth w 4) (dlm-length (dlm-nth w 3)) (dlm-nth w 8))))
          (set w (s79-field w 10 (dlm-append (dlm-nth w 10) (list trace))))
          (s79-field (s79-field s 4 w) 5 (dlm-append (dlm-nth s 5) (list cmd))))))))
(define-function a92-result (s)
  (let ((w (a92-work s)))
    (list 'attention-result92 (if (dlm-member? (dlm-nth w 7) '(complete unknown)) (dlm-nth w 7) 'pending)
      (dlm-nth (dlm-nth s 2) 3) (if (= (dlm-nth w 7) 'complete) (dlm-nth w 11) ())
      (dlm-nth w 9) (dlm-nth w 2) (dlm-nth w 10))))
(define-function a92-run (s steps)
  (let ((i 0)) (while (and (< i steps) (= (car s) 'attention-state92)
                          (not (dlm-member? (dlm-nth (a92-work s) 7) '(complete unknown))))
    (set s (a92-step s (a92-next s))) (set i (+ i 1))) s))
(define-function a92-query (model episode p policy fuel)
  (let ((s (a92-new model episode p policy fuel)))
    (if (= (car s) 'rejected92) s
      (let ((done (a92-run s 64))) (if (= (car done) 'rejected92) done (a92-result done))))))

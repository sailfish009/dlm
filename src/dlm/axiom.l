;;; axiom.l — minimal atomic axioms decomposed from learned rule programs.
;;; Each axiom carries one rule, evidence, support, and dependencies.
(define-function a-axiom (id rule evidence support deps version status history)
  (list 'aaxiom id rule evidence support deps version status history))
(define-function a-axiom? (x)
  (and (l-shape? x 9) (equal (car x) 'aaxiom) (l-name? (l-nth x 1))
       (l-rule? (l-nth x 2)) (l-list? (l-nth x 3)) (l-list? (l-nth x 4))
       (l-list? (l-nth x 5)) (l-member? (l-nth x 7) '(active inactive))
       (l-list? (l-nth x 8))))
(define-function a-id (x) (l-nth x 1))
(define-function a-rule (x) (l-nth x 2))
(define-function a-evidence (x) (l-nth x 3))
(define-function a-support (x) (l-nth x 4))
(define-function a-deps (x) (l-nth x 5))
(define-function a-version (x) (l-nth x 6))
(define-function a-status (x) (l-nth x 7))
(define-function a-history (x) (l-nth x 8))
(define-function a-find (id xs)
  (let ((hit (l-filter (lambda (x) (equal id (a-id x))) xs)))
    (if hit (car hit) ())))
(define-function a-put (ax xs)
  (cons ax (l-filter (lambda (x) (not (equal (a-id ax) (a-id x)))) xs)))
(define-function a-add (axs id rule evidence support deps)
  (if (a-find id axs) axs
    (l-append axs (list (a-axiom id rule evidence support deps 0 'inactive ())))))
(define-function a-set-status (axs id status)
  (let ((ax (a-find id axs)))
    (if (not ax) axs
      (a-put (a-axiom id (a-rule ax) (a-evidence ax) (a-support ax)
                      (a-deps ax) (+ (a-version ax) 1) status
                      (l-append (a-history ax) (list (list (a-status ax) (a-version ax))))) axs))))
(define-function a-activate (axs id) (a-set-status axs id 'active))
(define-function a-deactivate (axs id) (a-set-status axs id 'inactive))
(define-function a-active-rules (axs)
  (let ((out ()))
    (list-do ax axs (if (equal (a-status ax) 'active) (set out (l-append out (list (a-rule ax))))))
    out))

;;; Decompose a learned program into one axiom per rule.
(define-function a-head-pred (r) (l-pred (l-head r)))
(define-function a-body-preds (r) (l-map (lambda (a) (l-pred a)) (l-body r)))
(define-function a-deps-for (i rules id-base)
  (let ((r (l-nth rules i)) (out ()) (j 0))
    (list-do r2 rules
      (if (and (< j i) (l-member? (a-head-pred r2) (a-body-preds r)))
        (set out (l-append out (list (concat-strings id-base "-" (number->string j))))))
      (set j (+ j 1)))
    out))
(define-function a-from-program (id-base program evidence support)
  (let ((rules (s-rec-rules program)) (out ()) (i 0))
    (list-do r rules
      (set out (a-add out (concat-strings id-base "-" (number->string i))
                      r evidence support (a-deps-for i rules id-base)))
      (set i (+ i 1)))
    out))

;;; Subset enumeration and closed-subset selection.
(define-function a-subsets (ids)
  (if (not ids) (list ())
    (let ((rest (a-subsets (cdr ids))) (out ()))
      (list-do s rest
        (set out (l-append out (list s)))
        (set out (l-append out (list (cons (car ids) s)))))
      out)))
(define-function a-closed? (ids axs)
  (not (l-any? (lambda (id)
                 (let ((ax (a-find id axs)))
                   (if (not ax) (not ())
                     (l-any? (lambda (d) (not (l-member? d ids))) (a-deps ax)))))
               ids)))
(define-function a-rules-for (ids axs)
  (let ((out ()))
    (list-do id ids
      (let ((ax (a-find id axs))) (if ax (set out (l-append out (list (a-rule ax)))))))
    out))
(define-function a-select (axs facts pos neg budget)
  (let ((ids (l-map a-id axs)) (best ()) (best-c -1) (best-n 999))
    (list-do s (a-subsets ids)
      (if (not (a-closed? s axs))
        ()
        (let* ((rules (a-rules-for s axs))
               (cov (s-coverage facts rules pos budget))
               (conf (s-conflict? facts rules neg budget)))
          (if (and (not conf)
                   (or (> cov best-c)
                       (and (= cov best-c) (< (l-len s) best-n))))
            (begin (set best s) (set best-c cov) (set best-n (l-len s)))))))
    (if best (list 'asel best best-c) '(none))))

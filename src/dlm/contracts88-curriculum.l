;;; Joint curriculum state is replayed data, never a cache of trusted outcomes.
;;; fields: version/mode/library/goals/turn/batch/fuel/contract-requests/
;;;         relation-cursor/relation-stop/relation-requests/relation-budget.
(define-function c88-new ()
  (list 'curriculum88 1 'relations (c87-empty) () 'contracts 4 2000 0 0 'ready 0 200))
(define-function c88-request? (n maximum) (and (is <long> n) (> n 0) (<= n maximum)))
(define-function c88-context (j)
  (list 'context88 (c87-bindings (dlm-nth j 3)) (dlm-nth j 7)))
(define-function c88-name (g) (dlm-nth (dlm-nth g 1) 1))
(define-function c88-goal (j name)
  (let ((out ())) (list-do g (dlm-nth j 4) (if (= (c88-name g) name) (set out g))) out))
(define-function c88-put (j goal)
  (let ((out ()))
    (list-do g (dlm-nth j 4)
      (set out (dlm-append out (list (if (= (c88-name g) (c88-name goal)) goal g)))))
    (s79-field j 4 out)))
(define-function c88-reconcile (j lib)
  (let ((out ()) (next (s79-field j 3 lib)))
    (list-do g (dlm-nth j 4)
      (let ((m (c87-module lib (c88-name g))))
        (cond
          (m (if (equal (dlm-nth g 1) (s79-field (dlm-nth m 1) 4 ()))
               (set g (s79-field (s79-field g 2 'solved) 6 'checked-summary))
               (begin (set g (s79-field (s79-field g 2 'blocked) 6 'name-conflict))
                      (set g (s79-field g 4 (c88-context next))))))
          ((= (dlm-nth g 2) 'solved)
            (set g (list 'goal88 (dlm-nth g 1) 'pending 0 () (dlm-nth g 5) 'summary-removed ())))))
      (set out (dlm-append out (list g))))
    (s79-field next 4 out)))
(define-function c88-runnable? (g j)
  (or (= (dlm-nth g 2) 'pending)
      (and (= (dlm-nth g 2) 'blocked) (not (equal (dlm-nth g 4) (c88-context j))))))
(define-function c88-next-goal (j)
  (let ((out ())) (list-do g (dlm-nth j 4)
    (if (and (not out) (c88-runnable? g j)) (set out g))) out))
(define-function c88-domain (frame)
  (let* ((j (dlm-nth frame 4)) (mode (dlm-nth j 2))
         (contract (c88-next-goal j)) (relation (not (dlm-member? (dlm-nth frame 3) '(saturated capacity)))))
    (cond
      ((= mode 'contracts) (if contract 'contracts 'waiting))
      ((= mode 'relations) (if relation 'relations 'waiting))
      (else (if (= (dlm-nth j 5) 'contracts)
        (if contract 'contracts (if relation 'relations 'waiting))
        (if relation 'relations (if contract 'contracts 'waiting)))))))
(define-function c88-applicable? (template)
  (let ((found false))
    (list-do input (c87-states (dlm-nth template 2))
      (if (= (c87-eval (dlm-nth template 3) input input) 1) (set found true))) found))
(define-function c88-contract-step (j)
  (let* ((g (c88-next-goal j)) (template (dlm-nth g 1)) (name (c88-name g))
         (lib (dlm-nth j 3)) (context (c88-context j)) (cursor (if (equal (dlm-nth g 4) context) (dlm-nth g 3) 0))
         (fuel (dlm-nth j 7)) (batch (dlm-nth j 6)) (result ()) (records ()) (why ()) (status ()) (selected ()))
    (set g (s79-field (s79-field g 4 context) 5 (+ (dlm-nth g 5) 1)))
    (cond
      ((not (c88-applicable? template)) (set status 'inapplicable) (set why 'empty-precondition))
      ((>= (dlm-length (dlm-nth lib 1)) 8) (set status 'blocked) (set why 'library-capacity))
      ((c87-module lib name) (set status 'blocked) (set why 'name-conflict))
      (else
        (let ((candidates (c87-generate template lib)) (page ()) (i 0))
          (list-do c candidates
            (if (and (>= i cursor) (< i (+ cursor batch))) (set page (dlm-append page (list c))))
            (set i (+ i 1)))
          (let ((cost (* fuel (dlm-length page))))
            (if (> (+ (dlm-nth j 8) cost) 20000000) (set result '(rejected88 contract-request-limit))
              (begin
                (set j (s79-field j 8 (+ (dlm-nth j 8) cost)))
                (if page
                  (begin
                    (set result (c87-search page lib fuel))
                    (set records (dlm-nth (if (= (car result) 'synthesized87) (dlm-nth result 3) (dlm-nth result 2)) 6)))
                  (set result '(unknown87 bounded-generation)))
                (set cursor (+ cursor (dlm-length page)))
                ;; Do not trust a search success label or a theorem about another goal.
                (if (and (= (car result) 'synthesized87)
                         (equal template (s79-field (dlm-nth result 1) 4 ()))
                         (= (dlm-nth (c87-check (dlm-nth result 1) lib (dlm-nth result 2) fuel) 1) 'verified))
                  (begin
                    (set selected (dlm-nth result 1))
                    (set lib (list 'library87 (dlm-append (dlm-nth lib 1)
                      (list (list 'module87 selected (dlm-nth result 2))))))
                    (set status 'solved) (set why 'checked-summary))
                  (begin (set status (if (< cursor (dlm-length candidates)) 'pending 'blocked))
                         (set why (if (= status 'pending) 'candidate-frontier 'generation-bound))))))))))
    (if (= (car result) 'rejected88) result
      (begin
        (set g (s79-field (s79-field (s79-field (s79-field g 2 status) 3 cursor) 6 why) 7 records))
        (set j (s79-field (c88-reconcile (c88-put j g) lib) 5 'relations))
        (list 'worked88 j
          (if selected (list 'contract-learned name (dlm-nth selected 4))
            (list (if (= status 'pending) 'contract-pending
                    (if (= status 'inapplicable) 'contract-inapplicable 'contract-blocked))
              name why cursor)))))))
;;; Frames carry the existing checked native model and search controller too.
(define-function c88-frame () (list 'frame88 (a77-new) (a84-new) 'ready (c88-new)))
(define-function c88-with (frame model control stop j)
  (list 'frame88 model control stop (s79-field j 10 stop)))
(define-function c88-relation-step (frame budget legacy)
  (let* ((m (dlm-nth frame 1)) (c (dlm-nth frame 2)) (j (dlm-nth frame 4))
         (plain (and (not legacy) (= (dlm-nth c 1) 'off))) (r ()) (last ()))
    (if (> (+ (dlm-nth j 11) budget) 100000) '(rejected88 relation-request-limit)
      (begin
        (set j (s79-field (s79-field j 11 (+ (dlm-nth j 11) budget)) 12 budget))
        (if plain
          (begin (set r (a77-step-canonical m (dlm-nth j 9) budget))
                 (set j (s79-field j 9 (dlm-nth r 2)))
                 (set last (if (= (car r) 'learned)
                   (list 'learned (dlm-nth r 4) 'instances (dlm-nth r 5) 'pair-checks (dlm-nth r 3))
                   (list (car r) (dlm-nth r 2)))))
          (begin (set r (a84-run m c budget)) (set c (dlm-nth r 2))
                 (set j (s79-field j 9 0))
                 (set last (if (= (car r) 'learned)
                   (list 'learned (dlm-nth r 4) 'instances (dlm-nth r 5) 'pair-checks (dlm-nth r 3))
                   (list (car r) (dlm-nth r 3))))))
        (list 'applied88 (c88-with frame (dlm-nth r 1) c (car r) (s79-field j 5 'contracts)) last)))))
(define-function c88-apply (frame event)
  (if (not (and (dlm-proper? event 3) event)) '(rejected88 event)
    (let* ((op (car event)) (m (dlm-nth frame 1)) (c (dlm-nth frame 2))
           (stop (dlm-nth frame 3)) (j (dlm-nth frame 4)) (r ()) (last (list op)))
      (cond
        ((and (sq-shape? event 3) (= op 'observe))
          (set r (a77-observe m (dlm-nth event 1) (dlm-nth event 2)))
          (if (= (car r) 'observed)
            (list 'applied88 (c88-with frame (dlm-nth r 1) c 'ready (s79-field j 9 0)) last)
            '(rejected88 source-event)))
        ((and (sq-shape? event 2) (= op 'define))
          (set r (a77-certify m (dlm-nth event 1)))
          (if (= (car r) 'learned)
            (list 'applied88 (c88-with frame (dlm-nth r 1) c 'ready (s79-field j 9 0)) last)
            '(rejected88 definition)))
        ((and (sq-shape? event 2) (= op 'retract) (a77-name? (dlm-nth event 1)))
          (list 'applied88 (c88-with frame (a77-retract m (dlm-nth event 1)) c 'ready (s79-field j 9 0)) last))
        ((and (sq-shape? event 2) (= op 'routing83) (dlm-member? (dlm-nth event 1) '(on off)))
          (list 'applied88 frame last))
        ((and (sq-shape? event 2) (dlm-member? op '(search84 search85 search86))
              (dlm-member? (dlm-nth event 1) (if (= op 'search86) '(off indexed cache rank ucb nd-cache nd-ucb)
                (if (= op 'search85) '(off indexed cache rank ucb) '(off cache rank ucb)))))
          (list 'applied88 (c88-with frame m (a84-mode c (dlm-nth event 1)) 'ready (s79-field j 9 0)) last))
        ((and (= op 'curriculum88) (sq-shape? event 2) (dlm-member? (dlm-nth event 1) '(relations contracts mixed)))
          (list 'applied88 (s79-field frame 4 (s79-field (s79-field j 2 (dlm-nth event 1)) 5 'contracts)) last))
        ((and (= op 'relation-config88) (sq-shape? event 2) (c88-request? (dlm-nth event 1) 1000))
          (list 'applied88 (s79-field frame 4 (s79-field j 12 (dlm-nth event 1))) last))
        ((and (= op 'contract-config88) (sq-shape? event 3)
              (c88-request? (dlm-nth event 1) 16) (c88-request? (dlm-nth event 2) 200000))
          (list 'applied88 (s79-field frame 4 (s79-field (s79-field j 6 (dlm-nth event 1)) 7 (dlm-nth event 2))) last))
        ((and (= op 'goal88) (sq-shape? event 2) (< (dlm-length (dlm-nth j 4)) 16)
              (c87-contract? (dlm-nth event 1) (c87-empty)) (not (dlm-nth (dlm-nth event 1) 4))
              (not (c88-goal j (dlm-nth (dlm-nth event 1) 1))))
          (let ((g (list 'goal88 (dlm-nth event 1) 'pending 0 () 0 'queued ())))
            (set j (s79-field j 4 (dlm-append (dlm-nth j 4) (list g)))))
          (list 'applied88 (s79-field frame 4 (c88-reconcile j (dlm-nth j 3))) last))
        ((and (= op 'retry-goal88) (sq-shape? event 2) (c88-goal j (dlm-nth event 1)))
          (let* ((g (c88-goal j (dlm-nth event 1)))
                 (fresh (list 'goal88 (dlm-nth g 1) 'pending 0 () (dlm-nth g 5) 'explicit-retry ())))
            (list 'applied88 (s79-field frame 4 (c88-reconcile (c88-put j fresh) (dlm-nth j 3))) last)))
        ((and (= op 'library88) (sq-shape? event 2)
              (= (dlm-nth (c87-library-check (dlm-nth event 1) 200000) 1) 'verified))
          (list 'applied88 (s79-field frame 4 (c88-reconcile j (dlm-nth event 1))) last))
        ((and (= op 'contract-run88) (sq-shape? event 1) (= (c88-domain frame) 'contracts))
          (set r (c88-contract-step j))
          (if (= (car r) 'worked88) (list 'applied88 (s79-field frame 4 (dlm-nth r 1)) (dlm-nth r 2)) r))
        ((and (dlm-member? op '(relation-run88 search84-run)) (sq-shape? event 2)
              (c88-request? (dlm-nth event 1) 1000)
              (or (= op 'search84-run) (= (c88-domain frame) 'relations)))
          (c88-relation-step frame (dlm-nth event 1) (= op 'search84-run)))
        (else '(rejected88 event-or-bound))))))
(define-function c88-replay (events)
  (if (not (dlm-proper? events 256)) '(rejected88 event-limit)
    (let ((frame (c88-frame)) (valid true))
      (list-do e events
        (if valid (let ((r (c88-apply frame e)))
          (if (= (car r) 'applied88) (set frame (dlm-nth r 1)) (set valid false)))))
      (if valid (list 'replayed (dlm-nth frame 1) (dlm-nth frame 2) (dlm-nth frame 3) (dlm-nth frame 4))
        '(rejected88 replay)))))

;;; EML is the ONLY computation constructor. Calls expand to EML, 1, inputs.
;;; A basis defines a partial numeric function; matching a source is empirical.
;;; (basis93 ID ARITY BODY EXPANSION), prefix-only dependencies.
;;; (eml-state93 1 BRANCH EPISODES LIBRARY VIEWS EVENTS EPOCH)
;;; (eml-core93 1 BRANCH LIBRARY VIEWS EPOCH) -- no observed output table.
(define-function e93-branch? (x) (or (= x 'principal93) (= x 'lower93)))
(define-function e93-arity? (x) (e93-int? x 1 2))
(define-function e93-find (xs id) (b90-find xs id))
(define-function e93-lib (s) (dlm-nth s 4))
(define-function e93-size (t)
  (cond ((= t 'one93) 0) ((= (car t) 'x93) 0)
    ((= (car t) 'eml93) (+ 1 (+ (e93-size (dlm-nth t 1)) (e93-size (dlm-nth t 2)))))
    (else (let ((n 1)) (list-do a (dlm-nth t 2) (set n (+ n (e93-size a)))) n))))
(define-function e93-vars (t)
  (cond ((= t 'one93) ()) ((= (car t) 'x93) (list (dlm-nth t 1)))
    ((= (car t) 'eml93) (dlm-union (e93-vars (dlm-nth t 1)) (e93-vars (dlm-nth t 2))))
    (else (let ((out ())) (list-do a (dlm-nth t 2) (set out (dlm-union out (e93-vars a)))) out))))
(define-function e93-term? (t arity lib depth)
  (and (> depth 0)
    (or (= t 'one93)
      (and (sq-shape? t 2) (= (car t) 'x93) (e93-int? (dlm-nth t 1) 0 (- arity 1)))
      (and (sq-shape? t 3)
        (or (and (= (car t) 'eml93)
                 (e93-term? (dlm-nth t 1) arity lib (- depth 1))
                 (e93-term? (dlm-nth t 2) arity lib (- depth 1)))
          (and (= (car t) 'call93) (e93-int? (dlm-nth t 1) 1 8)
            (let ((b (e93-find lib (dlm-nth t 1))) (args (dlm-nth t 2)))
              (and b (dlm-proper? args 2) (= (dlm-length args) (dlm-nth b 2))
                (let ((ok true)) (list-do a args
                  (if (not (e93-term? a arity lib (- depth 1))) (set ok false))) ok)))))))))
(define-function e93-node (a b)
  (and a b (<= (+ 1 (+ (e93-size a) (e93-size b))) 96) (list 'eml93 a b)))
(define-function e93-subst (t args)
  (cond ((= t 'one93) t) ((= (car t) 'x93) (dlm-nth args (dlm-nth t 1)))
    (else (e93-node (e93-subst (dlm-nth t 1) args) (e93-subst (dlm-nth t 2) args)))))
(define-function e93-expand (t lib)
  (cond ((= t 'one93) t) ((= (car t) 'x93) t)
    ((= (car t) 'eml93) (e93-node (e93-expand (dlm-nth t 1) lib) (e93-expand (dlm-nth t 2) lib)))
    (else (let ((args ()) (ok true)) (list-do a (dlm-nth t 2)
      (let ((expanded (e93-expand a lib))) (if (not expanded) (set ok false))
        (set args (dlm-append args (list expanded)))))
      (and ok (e93-subst (dlm-nth (e93-find lib (dlm-nth t 1)) 4) args))))))
(define-function e93-all-roles? (t arity)
  (not (dlm-difference (b91-range arity) (e93-vars t))))
(define-function e93-library? (lib)
  (and (dlm-proper? lib 8)
    (let ((prefix ()) (id 1) (ok true))
      (list-do b lib
        (if (and ok (sq-shape? b 5) (= (car b) 'basis93) (= (dlm-nth b 1) id)
                 (e93-arity? (dlm-nth b 2)) (e93-term? (dlm-nth b 3) (dlm-nth b 2) prefix 12)
                 (<= (e93-size (dlm-nth b 3)) 3) (e93-all-roles? (dlm-nth b 3) (dlm-nth b 2))
                 (e93-term? (dlm-nth b 4) (dlm-nth b 2) () 12)
                 (<= (e93-size (dlm-nth b 4)) 96)
                 (equal (e93-expand (dlm-nth b 3) prefix) (dlm-nth b 4)))
          (begin (set prefix (dlm-append prefix (list b))) (set id (+ id 1))) (set ok false))) ok)))
(define-function e93-inputs? (xs arity)
  (and (dlm-proper? xs 2) (= (dlm-length xs) arity)
    (let ((ok true)) (list-do z xs (if (not (e93-z? z)) (set ok false))) ok)))
(define-function e93-rows? (rows arity)
  (and rows (dlm-proper? rows 12)
    (let ((ids ()) (inputs ()) (ok true))
      (list-do r rows
        (if (and (sq-shape? r 4) (= (car r) 'row93) (sq-name? (dlm-nth r 1))
                 (e93-inputs? (dlm-nth r 2) arity) (e93-z? (dlm-nth r 3))
                 (not (dlm-member? (dlm-nth r 1) ids)) (not (dlm-member? (dlm-nth r 2) inputs)))
          (begin (set ids (cons (dlm-nth r 1) ids)) (set inputs (cons (dlm-nth r 2) inputs)))
          (set ok false))) ok)))
(define-function e93-cell (inputs)
  (let ((out ())) (list-do z inputs
    (set out (dlm-append out (list
      (cond ((> (dlm-nth z 2) 0) 'upper93) ((< (dlm-nth z 2) 0) 'lower93)
        ((> (dlm-nth z 1) 0) 'positive93) ((< (dlm-nth z 1) 0) 'negative93) (else 'zero93)))))) out))
(define-function e93-cells (rows)
  (let ((out ())) (list-do r rows (set out (dlm-add out (e93-cell (dlm-nth r 2))))) out))
(define-function e93-cell-rows (rows cell)
  (let ((out ())) (list-do r rows (if (equal cell (e93-cell (dlm-nth r 2))) (set out (cons r out))))
    (s79-reverse out)))
(define-function e93-call (id arity)
  (let ((args ())) (list-do i (b91-range arity) (set args (dlm-append args (list (list 'x93 i)))))
    (list 'call93 id args)))
(define-function e93-new (branch)
  (if (e93-branch? branch) (list 'eml-state93 1 branch () () () () 0) '(rejected93 branch)))
(define-function e93-core (s)
  (list 'eml-core93 1 (dlm-nth s 2) (e93-lib s) (dlm-nth s 5) (dlm-nth s 7)))
(define-function e93-cells? (cells arity)
  (and (dlm-proper? cells 12)
    (let ((ok true) (seen ())) (list-do c cells
      (if (and (dlm-proper? c 2) (= (dlm-length c) arity) (not (dlm-member? c seen))
            (let ((good true)) (list-do v c
              (if (not (dlm-member? v '(positive93 negative93 zero93 upper93 lower93))) (set good false))) good))
        (set seen (cons c seen)) (set ok false))) ok)))
(define-function e93-core? (m)
  (and (sq-shape? m 6) (= (car m) 'eml-core93) (= (dlm-nth m 1) 1)
    (e93-branch? (dlm-nth m 2)) (e93-library? (dlm-nth m 3))
    (e93-int? (dlm-nth m 5) 0 32) (dlm-proper? (dlm-nth m 4) 60)
    (let ((ok true) (seen ()) (sources ())) (list-do v (dlm-nth m 4)
      (if (and (sq-shape? v 6) (= (car v) 'view93) (sq-name? (dlm-nth v 1))
               (e93-int? (dlm-nth v 2) 1 32) (e93-arity? (dlm-nth v 3))
               (e93-cells? (list (dlm-nth v 4)) (dlm-nth v 3))
               (not (dlm-member? (list (dlm-nth v 1) (dlm-nth v 4)) seen))
               (e93-term? (dlm-nth v 5) (dlm-nth v 3) (dlm-nth m 3) 12)
               (e93-all-roles? (dlm-nth v 5) (dlm-nth v 3))
               (let ((prior (dlm-assoc (dlm-nth v 1) sources)))
                 (or (not prior) (equal (cdr prior) (list (dlm-nth v 2) (dlm-nth v 3))))))
        (begin (set seen (cons (list (dlm-nth v 1) (dlm-nth v 4)) seen))
          (set sources (cons (list (dlm-nth v 1) (dlm-nth v 2) (dlm-nth v 3)) sources)))
        (set ok false))) ok)))

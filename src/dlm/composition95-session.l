;;; Same Basis91 audit, immutable transition, native lock and checkpoint owner.
;;; No independent state wrapper or dispatcher to the standalone EML93 learner.
(define-function c95-put (xs x)
  (let ((out ()) (seen false)) (list-do old xs
    (if (equal (dlm-nth old 1) (dlm-nth x 1)) (begin (set out (dlm-append out (list x))) (set seen true))
      (set out (dlm-append out (list old)))))
    (if seen out (dlm-append out (list x)))))
(define-function c95-step (s event)
  (let ((op (car event)) (f (dlm-nth s 8)) (next ()) (version (+ 1 (dlm-length (dlm-nth s 6)))))
    (cond
      ((and (= op 'types-init95) (sq-shape? event 2) (e93-branch? (dlm-nth event 1)) (sq-shape? s 8))
        (set next (dlm-append (s79-field s 1 2) (list (list 'typed95 (dlm-nth event 1) () () ())))))
      ((and (sq-shape? s 9) (= op 'calibrate95) (sq-shape? event 4))
        (let ((cal (list 'calibration95 (dlm-nth event 1) version (dlm-nth event 2) (dlm-nth event 3))))
          (if (and (c95-calibration? cal) (or (e93-find (dlm-nth f 2) (dlm-nth event 1)) (< (dlm-length (dlm-nth f 2)) 4)))
            (set next (s79-field s 8 (s79-field f 2 (c95-put (dlm-nth f 2) cal)))))))
      ((and (sq-shape? s 9) (= op 'observe-values95) (sq-shape? event 5))
        (let ((ep (b91-find (dlm-nth s 3) (dlm-nth event 2))))
          (if ep
            (let ((channel (list 'channel95 (dlm-nth event 1) version (dlm-nth ep 1) (dlm-nth ep 2) (dlm-nth event 3) (dlm-nth event 4))))
              (if (and (c95-channel? channel) (or (e93-find (dlm-nth f 3) (dlm-nth event 1)) (< (dlm-length (dlm-nth f 3)) 3)))
                (set next (s79-field s 8 (s79-field f 3 (c95-put (dlm-nth f 3) channel)))))))))
      ((and (sq-shape? s 9) (= op 'retract-values95) (sq-shape? event 3)
            (dlm-member? (dlm-nth event 1) '(calibration95 channel95)))
        (let* ((index (if (= (dlm-nth event 1) 'calibration95) 2 3)) (xs (dlm-nth f index)) (out ()))
          (if (e93-find xs (dlm-nth event 2))
            (begin (list-do x xs (if (not (equal (dlm-nth x 1) (dlm-nth event 2))) (set out (dlm-append out (list x)))))
              (set next (s79-field s 8 (s79-field f index out)))))))
      ((and (sq-shape? s 9) (= op 'learn-number95) (sq-shape? event 2) (c95-check-number s (dlm-nth event 1)))
        (set next (s79-field s 4 (dlm-append (dlm-nth s 4) (list (dlm-nth (dlm-nth event 1) 3)))))
        (set next (s79-field next 7 (dlm-length (dlm-nth next 4)))))
      ((and (sq-shape? s 9) (= op 'compose95) (sq-shape? event 2) (c95-check-proposal s (dlm-nth event 1)))
        (set next (s79-field s 4 (dlm-append (dlm-nth s 4) (dlm-nth (dlm-nth event 1) 2))))
        (set next (s79-field next 7 (dlm-length (dlm-nth next 4))))))
    (if next next '(rejected95 transition))))
(define-function c95-profile (s)
  (let ((rel 0) (num 0) (comp 0)) (list-do m (dlm-nth s 4)
    (cond ((b91-relational? m) (set rel (+ rel 1))) ((c95-numeric? m) (set num (+ num 1)))
      ((c95-composite? m) (set comp (+ comp 1)))))
    (list 'profile95 rel num comp (if (sq-shape? s 9) (dlm-nth (dlm-nth s 8) 4) ()))))
(define-function c95-command (args)
  (let ((op (car args)) (xs (cdr args)) (n (dlm-length (cdr args))) (s *b91-state*))
    (cond
      ((and (= op 'typed-infer) (= n 4)) (c95-infer (car xs) (dlm-nth xs 1) (dlm-nth xs 2) (dlm-nth xs 3)))
      ((and s (= op 'types) (= n 1)) (b91-commit (list 'types-init95 (car xs))))
      ((and s (sq-shape? s 9))
        (cond
          ((and (= op 'calibrate) (= n 3)) (b91-commit (list 'calibrate95 (car xs) (dlm-nth xs 1) (dlm-nth xs 2))))
          ((and (= op 'observe-values) (= n 4))
            (b91-commit (list 'observe-values95 (car xs) (dlm-nth xs 1) (dlm-nth xs 2) (dlm-nth xs 3))))
          ((and (= op 'retract-values) (= n 2)) (b91-commit (list 'retract-values95 (car xs) (dlm-nth xs 1))))
          ((and (dlm-member? op '(learn-numeric number-proposal compose typed-proposal)) (= n 3)
                (b91-name? (car xs)) (e93-int? (dlm-nth xs 1) 1 3) (b91-fuel? (dlm-nth xs 2)))
            (let ((p (if (dlm-member? op '(learn-numeric number-proposal))
                     (c95-propose-number s (car xs) (dlm-nth xs 1) (dlm-nth xs 2))
                     (c95-propose s (car xs) (dlm-nth xs 1) (dlm-nth xs 2)))))
              (cond ((and (= op 'learn-numeric) (= (car p) 'number-proposal95)) (b91-commit (list 'learn-number95 p)))
                ((and (= op 'compose) (= (car p) 'proposal95)) (b91-commit (list 'compose95 p))) (else p))))
          ((and (= op 'typed-query) (= n 3)) (c95-infer (b91-model s) (car xs) (dlm-nth xs 1) (dlm-nth xs 2)))
          ((and (= op 'typed-profile) (= n 0)) (c95-profile s))
          ((and (= op 'typed-evidence) (= n 0)) (dlm-nth s 8))
          (else '(rejected91 command-or-arity))))
      (else '(rejected91 command-or-arity)))))
(set *b91-typed-refresh* c95-refresh)
(set *b91-typed-step* c95-step)
(set *b91-typed-command* c95-command)

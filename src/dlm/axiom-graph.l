;;; axiom-graph.l — MLIR-shaped dependency graph for minimal atomic axioms.
;;; Structural selection only; proof remains the truth gate.
(define-function ag-node (id rule evidence support deps)
  (list 'agnode id rule evidence support deps))
(define-function ag-node? (x)
  (and (l-shape? x 6) (equal (car x) 'agnode) (l-name? (l-nth x 1))
       (l-rule? (l-nth x 2)) (l-list? (l-nth x 3))
       (l-list? (l-nth x 4)) (l-list? (l-nth x 5))))
(define-function ag-id (x) (l-nth x 1))
(define-function ag-rule (x) (l-nth x 2))
(define-function ag-evidence (x) (l-nth x 3))
(define-function ag-support (x) (l-nth x 4))
(define-function ag-deps (x) (l-nth x 5))
(define-function ag-graph (nodes) (list 'mlaxiomgraph nodes))
(define-function ag-graph? (g)
  (and (l-shape? g 2) (equal (car g) 'mlaxiomgraph)
       (l-list? (l-nth g 1))
       (not (l-any? (lambda (n) (not (ag-node? n))) (l-nth g 1)))))
(define-function ag-nodes (g) (l-nth g 1))
(define-function ag-find (id xs)
  (let ((hit (l-filter (lambda (n) (equal id (ag-id n))) xs)))
    (if hit (car hit) ())))
(define-function ag-from-axioms (axs)
  (let ((out ()))
    (list-do ax axs
      (set out (l-append out (list (ag-node (a-id ax) (a-rule ax)
        (a-evidence ax) (a-support ax) (a-deps ax))))))
    (ag-graph out)))
(define-function ag-check (g)
  (if (not (ag-graph? g)) '(rejected107 ag-shape)
    (let ((ids (l-map ag-id (ag-nodes g))))
      (if (not (l-any? (lambda (id) (not (l-member? id ids))) ids))
        'ok
        '(rejected107 ag-id)))))
(define-function ag-deps-ok? (g)
  (not (l-any? (lambda (n) (l-any? (lambda (d) (not (ag-find d (ag-nodes g)))) (ag-deps n)))
               (ag-nodes g))))
(define-function ag-check-deps (g)
  (if (ag-deps-ok? g) 'ok '(rejected107 ag-deps)))
(define-function ag-closed? (ids g)
  (not (l-any? (lambda (id)
                 (let ((n (ag-find id (ag-nodes g))))
                   (if (not n) (not ())
                     (l-any? (lambda (d) (not (l-member? d ids))) (ag-deps n)))))
               ids)))
(define-function ag-subsets (ids)
  (if (not ids) (list ())
    (let ((rest (ag-subsets (cdr ids))) (out ()))
      (list-do s rest
        (set out (l-append out (list s)))
        (set out (l-append out (list (cons (car ids) s)))))
      out)))
(define-function ag-rules-for (ids g)
  (let ((out ()))
    (list-do id ids
      (let ((n (ag-find id (ag-nodes g)))) (if n (set out (l-append out (list (ag-rule n)))))))
    out))
(define-function ag-select (g facts pos neg budget)
  (let ((ids (l-map ag-id (ag-nodes g))) (best ()) (best-c -1) (best-n 999))
    (list-do s (ag-subsets ids)
      (if (ag-closed? s g)
        (let* ((rules (ag-rules-for s g))
               (cov (s-coverage facts rules pos budget))
               (conf (s-conflict? facts rules neg budget)))
          (if (and (not conf)
                   (or (> cov best-c)
                       (and (= cov best-c) (< (l-len s) best-n))))
            (begin (set best s) (set best-c cov) (set best-n (l-len s)))))))
    (if best (list 'agsel best best-c) '(none))))
(define-function ag-to-axioms (g)
  (let ((out ()))
    (list-do n (ag-nodes g)
      (set out (l-append out (list (a-axiom (ag-id n) (ag-rule n)
        (ag-evidence n) (ag-support n) (ag-deps n) 0 'inactive ())))))
    out))

;;; Backward dependency reachability and DCE for axiom graphs.
(define-function ag-reach (ids seen g)
  (if (not ids) seen
    (let ((id (car ids)))
      (if (l-member? id seen)
        (ag-reach (cdr ids) seen g)
        (let ((n (ag-find id (ag-nodes g))))
          (if n
            (ag-reach (l-append (cdr ids) (ag-deps n))
                      (l-append seen (list id)) g)
            (ag-reach (cdr ids) seen g)))))))
(define-function ag-dce (g roots)
  (if (not (ag-graph? g)) '(rejected107 ag-dce-shape)
    (let ((keep (ag-reach roots () g)))
      (ag-graph (l-filter (lambda (n) (l-member? (ag-id n) keep)) (ag-nodes g))))))

;;; CSE for duplicate atomic axiom nodes.
(define-function ag-key (n)
  (list (ag-rule n) (ag-evidence n) (ag-support n) (ag-deps n)))
(define-function ag-cse-hit (key seen)
  (let ((hit (l-filter (lambda (e) (equal key (car e))) seen)))
    (if hit (l-nth (car hit) 1) ())))
(define-function ag-cse-maps (nodes)
  (let ((seen ()) (map ()))
    (list-do n nodes
      (let* ((key (ag-key n))
             (hs (l-filter (lambda (e) (equal key (car e))) seen))
             (hit (if hs (l-nth (car hs) 1) ())))
        (if hit
          (set map (cons (list (ag-id n) (ag-id hit)) map))
          (set seen (l-append seen (list (list key n)))))))
    map))
(define-function ag-rewrite-id (x map)
  (let ((hit (l-assoc x map))) (if hit (l-nth hit 1) x)))
(define-function ag-rewrite-deps (deps map)
  (l-map (lambda (d) (ag-rewrite-id d map)) deps))
(define-function ag-cse (g)
  (if (not (ag-graph? g)) '(rejected107 ag-cse-shape)
    (let* ((map (ag-cse-maps (ag-nodes g))) (drop (l-map car map)) (out ()))
      (list-do n (ag-nodes g)
        (if (not (l-member? (ag-id n) drop))
          (set out (l-append out (list (ag-node (ag-id n) (ag-rule n)
            (ag-evidence n) (ag-support n) (ag-rewrite-deps (ag-deps n) map)))))))
      (ag-graph out))))

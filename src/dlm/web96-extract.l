;;; Fixed declared M49 CSV schema, not learned natural-language semantics.
;;; Claims preserve byte offsets; no supplied programs, patterns or answers.
(define *w96-fields* '("M49" "Sub-region Code" "Region Code" "Global Code"))
(define *w96-predicates* '(country-subregion96 subregion-region96 region-global96))
(define *w96-namespaces* '("country:" "subregion:" "region:" "global:"))
(define-function w96-prefix? (s prefix)
  (and (string? s) (>= (string-length s) (string-length prefix)) (equal (w96-slice s 0 (string-length prefix)) prefix)))
(define-function w96-url? (s)
  (let ((prefix "https://raw.githubusercontent.com/datasets/country-codes/") (suffix "/data/country-codes.csv"))
    (and (string? s) (= (string-length s) (+ (+ (string-length prefix) 40) (string-length suffix)))
      (w96-prefix? s prefix)
      (w96-hex? (w96-slice s (string-length prefix) (+ (string-length prefix) 40)) 40)
      (equal (w96-slice s (+ (string-length prefix) 40) (string-length s)) suffix))))
(define-function w96-code (s)
  (if (not (and (> (string-length s) 0) (<= (string-length s) 3))) ()
    (let ((n 0) (ok true) (i 0))
      (while (< i (string-length s))
        (let ((c (string-at s i))) (if (or (< c 48) (> c 57)) (set ok false) (set n (+ (* n 10) (- c 48))))) (set i (+ i 1)))
      (and ok (> n 0) (cond ((= (string-length s) 1) (concat-strings "00" s))
        ((= (string-length s) 2) (concat-strings "0" s)) (else s))))))
(define-function w96-header (raw row)
  (let ((names ()) (indexes ()) (ok true) (i 0))
    (list-do span (dlm-nth row 4)
      (let ((name (w96-cell raw span)))
        (if (dlm-member? name names) (set ok false)) (set names (dlm-append names (list name)))))
    (list-do field *w96-fields*
      (let ((found ()) (j 0)) (list-do name names (if (equal name field) (set found j)) (set j (+ j 1)))
        (if (not found) (set ok false)) (set indexes (dlm-append indexes (list found)))))
    (and ok indexes)))
(define w96-insert ())
(set w96-insert (lambda (row rows)
  (if (or (not rows) (< (string-compare (car (dlm-nth row 4)) (car (dlm-nth (car rows) 4))) 0)) (cons row rows)
    (cons (car rows) (w96-insert row (cdr rows))))))
(define-function w96-table (raw)
  (let* ((rows (w96-csv raw)) (header (car rows)) (indexes (and rows (w96-header raw header)))
         (valid ()) (unresolved ()) (seen ()) (ok indexes))
    (if indexes
      (list-do row (cdr rows)
        (if (not (= (dlm-length (dlm-nth row 4)) (dlm-length (dlm-nth header 4)))) (set ok false)
          (let ((codes ()) (spans ()) (missing ()) (i 0))
            (list-do index indexes
              (let* ((span (dlm-nth (dlm-nth row 4) index)) (code (w96-code (w96-cell raw span))))
                (set spans (dlm-append spans (list span))) (set codes (dlm-append codes (list code)))
                (if (not code) (set missing (dlm-append missing (list (dlm-nth *w96-fields* i)))))) (set i (+ i 1)))
            (if missing
              (set unresolved (dlm-append unresolved (list (list 'unresolved96 (dlm-nth row 1) (dlm-nth row 2) (dlm-nth row 3) missing))))
              (if (dlm-member? (car codes) seen) (set ok false)
                (begin (set seen (cons (car codes) seen))
                  (set valid (w96-insert (list 'record96 (dlm-nth row 1) (dlm-nth row 2) (dlm-nth row 3) codes spans) valid)))))))))
    (and ok (list 'table96 valid unresolved (dlm-length (cdr rows))))))
(define-function w96-selected (rows excluded)
  (let ((selected ()) (regions ())) (list-do row rows
    (if (and (< (dlm-length selected) 2) (not (dlm-member? (car (dlm-nth row 4)) excluded))
             (not (dlm-member? (dlm-nth (dlm-nth row 4) 2) regions)))
      (begin (set selected (dlm-append selected (list row))) (set regions (cons (dlm-nth (dlm-nth row 4) 2) regions))))) selected))
(define-function w96-country-ids (rows)
  (let ((ids ())) (list-do row rows (set ids (cons (car (dlm-nth row 4)) ids))) ids))
(define-function w96-view (id level rows)
  (let ((numbers ()) (facts ()) (proofs ()) (fno 0))
    (list-do row rows
      (set numbers (dlm-append numbers (list (dlm-nth row 1))))
      (let ((codes (dlm-nth row 4)) (spans (dlm-nth row 5)) (i 0))
        (while (< i level)
          (let* ((left (concat-strings (dlm-nth *w96-namespaces* i) (dlm-nth codes i)))
                 (right (concat-strings (dlm-nth *w96-namespaces* (+ i 1)) (dlm-nth codes (+ i 1))))
                 (a (dlm-nth spans i)) (b (dlm-nth spans (+ i 1))))
            (set facts (dlm-append facts (list (list 'atom (dlm-nth *w96-predicates* i) (list left right)))))
            (set proofs (dlm-append proofs (list (list 'edge96 fno (dlm-nth row 1) (dlm-nth row 2) (dlm-nth row 3)
              (dlm-nth *w96-fields* i) (car a) (dlm-nth a 1) (dlm-nth *w96-fields* (+ i 1)) (car b) (dlm-nth b 1)))))
            (set fno (+ fno 1))) (set i (+ i 1)))))
    (list 'view96 id level numbers facts proofs)))
(define-function w96-extract (raw)
  (let ((table (w96-table raw)))
    (if (not table) '(unresolved96 invalid-csv-or-schema)
      (let* ((rows (dlm-nth table 1)) (train (w96-selected rows ()))
             (next (w96-selected rows (w96-country-ids train))) (held ())
             (used (dlm-append (w96-country-ids train) (w96-country-ids next))))
        (if (or (not (= (dlm-length train) 2)) (not (= (dlm-length next) 2))) '(unresolved96 insufficient-distinct-region-rows)
          (begin
            (list-do row rows (if (not (dlm-member? (car (dlm-nth row 4)) used))
              (set held (dlm-append held (list (w96-view (concat-strings "web-row96:" (car (dlm-nth row 4))) 3 (list row)))))))
            (list 'extraction96 'm49-csv96 (w96-view "web-train96" 2 train) (w96-view "web-next96" 3 next)
              held (dlm-nth table 2) (dlm-nth table 3))))))))
;;; Full-byte content cache, capped at two entries. Keys are copied, not digest-only
;;; or shared worker strings. This is a runtime cache, never learned state.
(define *w96-verified* ())
(define-function w96-verified-extraction (hex digest)
  (let ((out ()))
    (list-do entry *w96-verified*
      (if (and (equal (car entry) hex) (equal (dlm-nth entry 1) digest)) (set out (dlm-nth entry 2))))
    (if out out
      (let ((raw (w96-unhex hex)))
        (if (and raw (equal (w96-sha256 raw) digest))
          (let ((parsed (w96-extract raw)))
            (set *w96-verified* (cons (list (w96-slice hex 0 (string-length hex)) (w96-slice digest 0 64) parsed)
              (if *w96-verified* (list (car *w96-verified*)) ()))) parsed) ())))))
(define-function w96-packet? (p)
  (and (sq-shape? p 8) (= (car p) 'web-document96) (equal (dlm-nth p 1) "country-codes96")
    (w96-url? (dlm-nth p 2)) (string? (dlm-nth p 3)) (= (string-length (dlm-nth p 3)) 20)
    (w96-hex? (dlm-nth p 4) 64) (= (dlm-nth p 5) 'm49-csv96)
    (string? (dlm-nth p 6)) (> (string-length (dlm-nth p 6)) 0) (<= (string-length (dlm-nth p 6)) 524288)
    (let ((expected (w96-verified-extraction (dlm-nth p 6) (dlm-nth p 4))))
      (and expected (= (car expected) 'extraction96) (equal expected (dlm-nth p 7))))))

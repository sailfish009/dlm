      (while (and ok (< i (string-length s)))
        (let ((a (w96-hex-digit (string-at s i))) (b (w96-hex-digit (string-at s (+ i 1)))))
          (if (or (< a 0) (< b 0)) (set ok false) (set (string-at out (/ i 2)) (+ (* a 16) b))))
        (set i (+ i 2))) (and ok out))))
(define-function w96-hex? (s n)
  (and (string? s) (= (string-length s) n)
    (let ((ok true) (i 0)) (while (< i n) (if (< (w96-hex-digit (string-at s i)) 0) (set ok false)) (set i (+ i 1))) ok)))

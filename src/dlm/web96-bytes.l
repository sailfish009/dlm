;;; Bounded native bytes, SHA-256 and RFC4180-style CSV spans. No eval/network.
(define-function w96-slice (s start end)
  (let ((out (string (- end start))) (i start))
    (while (< i end) (set (string-at out (- i start)) (string-at s i)) (set i (+ i 1))) out))
(define-function w96-hex-digit (c)

;;; Rows contain record number, whole-record byte range, and raw cell spans.
(define-function w96-csv (raw)
  (let ((n (string-length raw)) (i 0) (start 0) (row-start 0) (mode 0) (cells ()) (rows ()) (no 0) (ok true))
    (while (and ok (< i n))
      (let ((c (string-at raw i)))
        (cond
          ((= mode 1)
            (if (= c 34)
              (if (and (< (+ i 1) n) (= (string-at raw (+ i 1)) 34)) (set i (+ i 1)) (set mode 2))))
          ((or (= c 44) (= c 10) (= c 13))
            (set cells (cons (list start i) cells))
            (if (or (> (- i start) 8192) (> (dlm-length cells) 80)) (set ok false))
            (if (not (= c 44))
              (begin
                (if (= c 13) (if (and (< (+ i 1) n) (= (string-at raw (+ i 1)) 10)) (set i (+ i 1)) (set ok false)))
                (set rows (cons (list 'csv-row96 no row-start (+ i 1) (s79-reverse cells)) rows))
                (set no (+ no 1)) (if (> no 512) (set ok false)) (set row-start (+ i 1)) (set cells ())))
            (set start (+ i 1)) (set mode 0))
          ((= c 34) (if (= i start) (set mode 1) (set ok false)))
          ((= mode 2) (set ok false))))
      (set i (+ i 1)))
    (if (= mode 1) (set ok false))
    (if (and ok (< row-start n))
      (begin (set cells (cons (list start n) cells))
        (if (or (>= no 512) (> (- n start) 8192) (> (dlm-length cells) 80)) (set ok false))
        (set rows (cons (list 'csv-row96 no row-start n (s79-reverse cells)) rows))))
    (and ok (s79-reverse rows))))
(define-function w96-cell (raw span)
  (let* ((start (car span)) (end (dlm-nth span 1)) (quoted (and (< start end) (= (string-at raw start) 34))))
    (if (not quoted) (w96-slice raw start end)
      (let ((out (string (- end start))) (i (+ start 1)) (j 0))
        (while (< i (- end 1))
          (let ((c (string-at raw i))) (set (string-at out j) c) (set j (+ j 1))
            (if (= c 34) (set i (+ i 1)))) (set i (+ i 1)))
        (w96-slice out 0 j)))))

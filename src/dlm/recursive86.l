;;; One generated-program -> nondeterministic execution -> native gate loop.
;;; Accept is provisional. The chosen definition is rechecked at admission.
(define-function n86-action? (arg)
  (and (sq-shape? arg 2) (a77-valid? (car arg))
       (sq-shape? (dlm-nth arg 1) 4) (= (car (dlm-nth arg 1)) 'definition77)))
(define-function n86-certify (arg)
  (if (not (n86-action? arg)) (list '(rejected malformed86) 0)
    (let ((old *a84-inspected*) (counting *a84-counting*) (trial ()) (work 0))
      (set *a84-inspected* 0) (set *a84-counting* true)
      (set trial (a77-certify (car arg) (dlm-nth arg 1)))
      (set work *a84-inspected*)
      (set *a84-inspected* (if counting (+ old work) old)) (set *a84-counting* counting)
      (list trial work))))
(set s86-action? n86-action?)
(set s86-certify n86-certify)
(define-function n86-program (model definitions)
  (let ((alternatives ()))
    (list-do d definitions
      (set alternatives (dlm-append alternatives
        (list (list (list 'certify86 (list model d)) (list 'accept d))))))
    (list (list 'choose alternatives))))
(define-function n86-records (engine)
  (let ((records ()))
    (list-do entry (dlm-nth engine 3)
      (let* ((u (dlm-nth entry 1)) (ctx (dlm-nth (dlm-nth u 5) 2))
             (d (s79-at (dlm-nth ctx 1) 'candidate86))
             (ticket (s79-at (dlm-nth ctx 1) 'trial86)))
        (if (and d ticket)
          (set records (s79-put records d (list (car ticket) (dlm-nth ticket 1) (dlm-nth u 4))))))) records))
(define-function n86-stat (c candidate trial work)
  (let* ((family (a84-family candidate))
         (prior (or (s79-at (dlm-nth c 5) family) '(0 0 0)))
         (hits (if (= (car trial) 'learned) (dlm-nth trial 3) 0))
         (reward (if (> hits 256) 256 hits)))
    (set c (s79-field c 6 (+ (dlm-nth c 6) 1)))
    (set c (s79-field c 7 (+ (dlm-nth c 7) 1)))
    (set c (s79-field c 11 (+ (dlm-nth c 11) work)))
    (set c (s79-field c 5 (s79-put (dlm-nth c 5) family
      (list (+ (car prior) 1) (+ (dlm-nth prior 1) reward) (+ (dlm-nth prior 2) (+ 1 work))))))
    (if (and (= (car trial) 'rejected) (= (dlm-nth trial 1) 'insufficient-reuse))
      (set c (s79-field c 4 (s79-put (dlm-nth c 4) (car candidate) 'insufficient-reuse)))) c))
(define-function n86-run (model ctrl budget)
  (if (not (and (a77-valid? model) (is <long> budget) (> budget 0) (<= budget 1000)
                (dlm-member? (dlm-nth ctrl 1) '(nd-cache nd-ucb))))
      (list 'invalid-input model ctrl 0 () 0)
    (let ((c ctrl) (checks 0) (proposals ()) (definitions ()) (deferred ())
          (engine ()) (records ()) (summary ()) (accepted ()) (admitted ())
          (hits 0) (status ()) (events 0))
      (if (>= (dlm-length (a77-defs model)) 12) (set status 'capacity))
      (if (and (not status) (not (equal model (dlm-nth c 2))))
        (let ((p (a84-pool model)))
          (set c (s79-field c 2 model)) (set c (s79-field c 3 (car p)))
          (set c (s79-field c 4 ())) (set c (s79-field c 10 (dlm-nth p 1)))
          (set c (s79-field c 9 (+ (dlm-nth c 9) (dlm-nth p 2))))))
      ;; Freeze one batch's proposal order; subsequent labels guide later batches.
      (while (and (not status) (< checks budget) (< checks 16) (dlm-nth c 3))
        (let* ((candidate (a84-select c))
               (d (list 'definition77 (a77-fresh model) (car candidate) (dlm-nth candidate 1))))
          (set c (s79-field c 3 (a84-remove candidate (dlm-nth c 3))))
          (set checks (+ checks 1))
          (if (dlm-assoc (car candidate) (dlm-nth c 4))
            (set c (s79-field c 8 (+ (dlm-nth c 8) 1)))
            (begin (set proposals (s79-put proposals d candidate))
              (set definitions (dlm-append definitions (list d)))))))
      (if definitions
        (begin
          (set engine (s79-program-job (s79-new) 'learn86 (n86-program model definitions)))
          (set engine (s79-run engine 256))
          (set events (dlm-nth engine 10))
          (set records (n86-records engine))
          (let ((job (s79-job engine 'learn86)))
            (if (and (= (dlm-nth job 3) 'done) (= (car (dlm-nth job 5)) 'provisional))
              (set accepted (dlm-nth (dlm-nth job 5) 1))))
          (list-do entry proposals
            (let* ((d (car entry)) (candidate (dlm-nth entry 1)) (record (s79-at records d)))
              (if (not record) (set deferred (dlm-append deferred (list candidate)))
                (let ((trial (car record)) (work (dlm-nth record 1)))
                  (set c (n86-stat c candidate trial work))
                  (set summary (dlm-append summary
                    (list (list (car candidate) (dlm-nth candidate 1) (car trial)
                      (if (= (car trial) 'learned) (dlm-nth trial 3) (dlm-nth trial 1)) work))))
                  (if (not (and (= (car trial) 'rejected) (= (dlm-nth trial 1) 'insufficient-reuse)))
                    (set deferred (dlm-append deferred (list candidate))))))))
          (if (and accepted (dlm-assoc accepted proposals) (s79-at records accepted)
                   (= (car (car (s79-at records accepted))) 'learned))
            (let* ((ticket (n86-certify (list model accepted)))
                   (trial (car ticket)) (work (dlm-nth ticket 1))
                   (candidate (s79-at proposals accepted)) (family (a84-family candidate))
                   (prior (s79-at (dlm-nth c 5) family)))
              ;; Extra admission check is cost, not a second training label.
              (set c (s79-field c 7 (+ (dlm-nth c 7) 1)))
              (set c (s79-field c 11 (+ (dlm-nth c 11) work)))
              (set c (s79-field c 5 (s79-put (dlm-nth c 5) family
                (list (car prior) (dlm-nth prior 1) (+ (dlm-nth prior 2) work)))))
              (if (= (car trial) 'learned)
                (begin (set admitted accepted) (set model (dlm-nth trial 1))
                  (set hits (dlm-nth trial 3)) (set status 'learned)))))
          (set c (s79-field c 12 (list 'nd86 'branches (dlm-length definitions)
            'events events 'admitted (if admitted true false) 'records summary)))))
      (if deferred (set c (s79-field c 3 (dlm-append (dlm-nth c 3) deferred))))
      (list (or status (if (dlm-nth c 3) 'incomplete (if (dlm-nth c 10) 'saturated 'capacity)))
            model c checks admitted hits))))
(set a86-run n86-run)

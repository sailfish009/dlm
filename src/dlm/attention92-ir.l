;;; Declarative deductive control, CPU/native only. All source IDs remain original.
;;; context92: model episode pattern policy initial-fuel (immutable query universe).
;;; work92: remaining plan envs scope stack pending phase fuel metrics trace matches.
;;; scope92: fact-ids effective-basis-ids. Search visibility, NOT logical premises.
;;; state92: version context immutable-index work events.
;;; metrics92: actions index-facts index-probes worker-units reads bind-attempts
;;;            calls checker-units widenings local-commits restores call-ids.
(define-function a92-policy? (x) (dlm-member? x '(ordered92 indexed92 adaptive92 narrow92)))
(define-function a92-episode (ctx) (b91-find (dlm-nth (dlm-nth ctx 1) 2) (dlm-nth ctx 2)))
(define-function a92-context? (ctx)
  (and (sq-shape? ctx 6) (= (car ctx) 'context92) (b91-model? (dlm-nth ctx 1))
       (b91-name? (dlm-nth ctx 2)) (a92-episode ctx)
       (b91-pattern? (dlm-nth ctx 3) (dlm-nth (dlm-nth ctx 1) 1))
       (a92-policy? (dlm-nth ctx 4)) (b91-fuel? (dlm-nth ctx 5))))
(define-function a92-basis-ids (lib)
  (let ((ids ())) (list-do m lib (set ids (dlm-append ids (list (dlm-nth m 1))))) ids))
(define-function a92-ids? (ids allowed limit)
  (and (dlm-proper? ids limit)
    (let ((ok true) (seen ())) (list-do i ids
      (if (and (is <long> i) (dlm-member? i allowed) (not (dlm-member? i seen)))
        (set seen (cons i seen)) (set ok false))) ok)))
(define-function a92-dependencies (ids lib)
  (let ((out ids) (changed true))
    (while changed (set changed false)
      (list-do id out (list-do op (dlm-nth (b91-module lib id) 3)
        (if (and (= (car op) 'call91) (not (dlm-member? (dlm-nth op 1) out)))
          (begin (set out (dlm-append out (list (dlm-nth op 1)))) (set changed true))))))
    (b91-fact-key out)))
(define-function a92-normal-env (env)
  (let ((out ())) (list-do i '(0 1 2 3)
    (let ((entry (dlm-assoc i env))) (if entry (set out (dlm-append out (list entry)))))) out))
(define-function a92-normal-rows (rows)
  (let ((out ())) (list-do env rows (set out (dlm-add out (a92-normal-env env)))) out))
;;; Do not silently normalize away foreign or conflicting variable entries.
(define-function a92-envs? (rows)
  (and (dlm-proper? rows 512)
    (let ((ok true)) (list-do env rows
      (if (not (dlm-proper? env 4)) (set ok false)
        (let ((seen ())) (list-do entry env
          (if (and (sq-shape? entry 2) (b91-var? (car entry)) (b91-name? (dlm-nth entry 1))
                   (not (dlm-member? (car entry) seen)))
            (set seen (cons (car entry) seen)) (set ok false)))))) ok)))
(define-function a92-same-rows? (a b)
  (and (a92-envs? a) (a92-envs? b) (= (dlm-length a) (dlm-length b))
    (not (dlm-difference (a92-normal-rows a) (a92-normal-rows b)))
    (not (dlm-difference (a92-normal-rows b) (a92-normal-rows a)))))
;;; Index has original IDs under predicate, left/right value, pair and loop keys.
;;; Index lookup is metadata access; it does not execute a conjunction.
(define-function a92-index-add (index key id)
  (s79-put index key (dlm-append (s79-at index key) (list id))))
(define-function a92-index (facts)
  (let ((out ()) (i 0)) (list-do f facts
    (let ((p (dlm-nth f 1)) (a (car (dlm-nth f 2))) (b (dlm-nth (dlm-nth f 2) 1)))
      (list-do key (list (list p) (list p 'left a) (list p 'right b) (list p 'pair a b))
        (set out (a92-index-add out key i)))
      (if (equal a b) (set out (a92-index-add out (list p 'loop) i))))
    (set i (+ i 1))) out))
(define-function a92-lookup (index atom env)
  (let ((p (car atom)) (a (dlm-assoc (dlm-nth atom 1) env)) (b (dlm-assoc (dlm-nth atom 2) env)))
    (cond
      ((and a b) (s79-at index (list p 'pair (dlm-nth a 1) (dlm-nth b 1))))
      (a (s79-at index (list p 'left (dlm-nth a 1))))
      (b (s79-at index (list p 'right (dlm-nth b 1))))
      ((= (dlm-nth atom 1) (dlm-nth atom 2)) (s79-at index (list p 'loop)))
      (else (s79-at index (list p))))))
(define-function a92-visible-ids (atoms envs index)
  (let ((out ())) (list-do env envs (list-do a atoms
    (set out (dlm-union out (a92-lookup index a env))))) (b91-fact-key out)))
(define-function a92-new (model episode pattern policy fuel)
  (let ((ctx (list 'context92 model episode pattern policy fuel)))
    (if (not (a92-context? ctx)) '(rejected92 context)
      (let* ((ep (a92-episode ctx)) (facts (dlm-nth ep 3)) (n (dlm-length facts))
             (scope (list 'scope92 (b91-range n) (a92-basis-ids (dlm-nth model 3))))
             (m (list 'metrics92 0 n 0 0 0 0 0 0 0 0 0 ()))
             (work (list 'work92 pattern () (list ()) scope () ()
               (if (< fuel n) 'unknown 'ready) (if (< fuel n) 0 (- fuel n)) m () ())))
        (list 'attention-state92 1 ctx (a92-index facts) work ())))))
(define-function a92-work (s) (dlm-nth s 4))
(define-function a92-metric (w i n)
  (s79-field w 9 (s79-field (dlm-nth w 9) i (+ (dlm-nth (dlm-nth w 9) i) n))))
(define-function a92-phase (w phase) (s79-field w 7 phase))
(define-function a92-pending-op (w) (dlm-nth (dlm-nth w 6) 1))
(define-function a92-consume (w n)
  (if (< (dlm-nth w 8) n) (a92-phase (s79-field w 8 0) 'unknown)
    (s79-field w 8 (- (dlm-nth w 8) n))))
(define-function a92-op-atoms (op ctx)
  (b91-expand (list op) (dlm-nth (dlm-nth ctx 1) 1) (dlm-nth (dlm-nth ctx 1) 3)))
;;; No duplicate conjunct can be consumed twice, even if bindings coincide.
(define-function a92-distinct-atoms (atoms)
  (let ((out ())) (list-do a atoms (set out (dlm-add out a))) out))
(define-function a92-op-eligible? (op remaining ctx)
  (let ((atoms (a92-op-atoms op ctx)))
    (and atoms (not (dlm-difference atoms remaining))
      (= (dlm-length atoms) (dlm-length (a92-distinct-atoms atoms))))))

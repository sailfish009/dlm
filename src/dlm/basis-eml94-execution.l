;;; Shared Basis91/Attention92 worker for EML bodies. Anchor + domain extension
;;; produces CANDIDATES, not solved goal rows. EML decides their conjunction.
;;; Independent predecessor primitive checks authorize publication, never repair.
(define e94-ground-op ())
(define-function e94-ground-value (status bit r) (list 'ground94 status bit r))
(define-function e94-ground-body (body args ep lib scope env r)
  (let ((ops (if (b91-encoded? body) (dlm-nth body 3) body))
        (inputs ()) (status 'complete) (bit true))
    (list-do child ops
      (if (= status 'complete)
        (let ((v (e94-ground-op (a92-map-op child args) ep lib scope env r)))
          (set status (dlm-nth v 1)) (set r (dlm-nth v 3))
          (if (not (dlm-nth v 2)) (set bit false))
          (set inputs (dlm-append inputs (list (list 'z93 (if (dlm-nth v 2) 2000000 1000000) 0)))))))
    (if (and (= status 'complete) (b91-encoded? body))
      (let ((v (e94-eval-code (dlm-nth body 4) inputs (dlm-nth body 2) (dlm-nth r 1) true)))
        (set status (dlm-nth v 1)) (set bit (dlm-nth v 2))
        (set r (s79-field (s79-field r 1 (dlm-nth v 4)) 2 (+ (dlm-nth r 2) (dlm-nth v 5))))))
    (e94-ground-value status bit r)))
(set e94-ground-op (lambda (op ep lib scope env r)
  (if (= (dlm-nth r 1) 0) (e94-ground-value 'unknown false r)
    (begin
      (set r (a92-worker-spend r))
      (if (= (car op) 'call91)
        (if (not (dlm-member? (dlm-nth op 1) (dlm-nth scope 2))) (e94-ground-value 'unknown false r)
          (begin
            (e94-count 5 1)
            (set r (s79-field (a92-worker-inc r 5) 6 (dlm-add (dlm-nth r 6) (dlm-nth op 1))))
            (e94-ground-body (dlm-nth (b91-module lib (dlm-nth op 1)) 3)
              (dlm-nth op 2) ep lib scope env r)))
        (let ((values ()) (status 'complete) (found false))
          (list-do variable (dlm-nth op 2)
            (let ((entry (dlm-assoc variable env)))
              (if entry (set values (dlm-append values (list (dlm-nth entry 1)))) (set status 'unknown))))
          (list-do id (dlm-nth scope 1)
            (if (= status 'complete)
              (if (= (dlm-nth r 1) 0) (set status 'unknown)
                (begin
                  (set r (a92-worker-inc (a92-worker-spend r) 3))
                  (if (equal (dlm-nth (dlm-nth ep 3) id) (list 'atom (dlm-nth op 1) values)) (set found true))))))
          (e94-ground-value status found r)))))))
(define-function e94-domain (ep scope)
  (let ((nodes ())) (list-do id (dlm-nth scope 1)
    (set nodes (dlm-union nodes (dlm-nth (dlm-nth (dlm-nth ep 3) id) 2)))) nodes))
(define-function e94-fill-roles (envs roles domain r)
  (let ((status 'complete))
    (list-do role roles
      (let ((out ()))
        (list-do env envs
          (if (= status 'complete)
            (if (dlm-assoc role env) (set out (dlm-add out env))
              (list-do value domain
                (if (= status 'complete)
                  (if (= (dlm-nth r 1) 0) (set status 'unknown)
                    (begin
                      (set r (a92-worker-inc (a92-worker-spend r) 4))
                      (set out (dlm-add out (dlm-nth (b91-bind env role value) 1)))
                      (if (> (dlm-length out) 512) (set status 'unknown)))))))))
        (set envs (if (= status 'complete) out ()))))
    (a92-computed status envs r)))
(define-function e94-controlled-execute (body args ep lib scope envs r)
  (let* ((ops (dlm-nth body 3))
         (anchor (a92-execute (a92-map-op (car ops) args) ep lib scope envs r))
         (filled (if (= (dlm-nth anchor 1) 'complete)
           (e94-fill-roles (dlm-nth anchor 2) args (e94-domain ep scope) (dlm-nth anchor 3)) anchor))
         (status (dlm-nth filled 1)) (out ()))
    (set r (dlm-nth filled 3))
    (list-do env (dlm-nth filled 2)
      (if (= status 'complete)
        (let ((v (e94-ground-body body args ep lib scope env r)))
          (e94-count 6 1)
          (set status (dlm-nth v 1)) (set r (dlm-nth v 3))
          (if (and (= status 'complete) (dlm-nth v 2)) (set out (dlm-add out (a92-normal-env env)))))))
    (a92-computed status out r)))
(define-function e94-merge-runtime (r worker)
  (set r (s79-field r 1 (dlm-nth worker 1)))
  (list-do pair '((2 2) (4 3) (5 4) (6 5))
    (set r (s79-field r (car pair) (+ (dlm-nth r (car pair)) (dlm-nth worker (dlm-nth pair 1))))))
  (s79-field r 8 (dlm-union (dlm-nth r 8) (dlm-nth worker 6))))
(define-function e94-body-arity (body)
  (let ((roles ())) (list-do op (dlm-nth body 3)
    (set roles (dlm-union roles (dlm-nth op 2)))) (dlm-length roles)))
(define-function e94-execute (body facts lib r memo)
  (let* ((arity (e94-body-arity body))
         (ep (list 'episode91 'worker94 0 facts false))
         (scope (list 'scope92 (b91-range (dlm-length facts)) (a92-basis-ids lib)))
         (v (e94-controlled-execute body (b91-range arity) ep lib scope (list ()) (a92-worker (dlm-nth r 1)))))
    (b91-value (dlm-nth v 1) (dlm-nth v 2) (e94-merge-runtime r (dlm-nth v 3)))))
;;; No silent filling with reference rows. Compare, reject, or withhold.
(define-function e94-check-result (p v ep)
  (let* ((r (dlm-nth v 3))
         (check (a92-check-rows p (list ()) (dlm-nth v 2) ep (dlm-nth r 1)))
         (cr (dlm-nth check 3)))
    (set r (s79-field r 1 (dlm-nth cr 1)))
    (list-do i '(2 4 5) (set r (s79-field r i (+ (dlm-nth r i) (dlm-nth cr i)))))
    (b91-value (if (not (= (dlm-nth check 1) 'complete)) 'unknown
                  (if (dlm-nth check 2) 'complete 'rejected))
      (if (and (= (dlm-nth check 1) 'complete) (dlm-nth check 2)) (dlm-nth v 2) ()) r)))
;;; Feedback enters existing reading/support/formation state, via one replayable
;;; interpretation event. Query contexts are frozen; only completed checked rows
;;; become readings. No source observation, witness, or new basis is fabricated.
(define-function e94-interpret-controlled (s ep fuel policy)
  (if (not (a92-policy? policy)) '(rejected91 policy)
    (let ((model (b91-model s)) (readings ()) (attempts ()) (status 'complete) (initial fuel))
      (list-do p (b91-interpret-pool s ep)
        (if (= status 'complete)
          (let* ((start (a92-new model (dlm-nth ep 1) p policy fuel))
                 (done (if (= (car start) 'attention-state92) (a92-run start 64) start)))
            (if (not (= (car done) 'attention-state92)) (set status 'rejected)
              (let ((v (a92-result done)))
                (set fuel (dlm-nth (a92-work done) 8)) (set status (dlm-nth v 1))
                (set attempts (dlm-append attempts (list (list 'attempt91 p status (dlm-length (dlm-nth v 3)) (dlm-nth v 5)))))
                (if (and (= status 'complete) (dlm-nth v 3))
                  (set readings (dlm-append readings (list (list 'reading91 (dlm-nth ep 1)
                    (dlm-nth ep 2) p (dlm-nth v 5) (dlm-nth v 3)))))))))))
      (if (= status 'complete)
        (list 'interpreted91 readings (list 'controlled-metrics94 (- initial fuel)) attempts)
        (list 'rejected91 status (list 'controlled-metrics94 (- initial fuel)) attempts)))))
(set *b91-codec-controlled* e94-controlled-execute)
(set *b91-codec-execute* e94-execute)
(set *b91-codec-check* e94-check-result)
(set *b91-controlled-interpret* e94-interpret-controlled)

;;; DLM77 <-> Ground82 bridge. Derived native Horn proofs NEVER become evidence.
;;; Private cache rebuilt from replay-verified model; not a Ground82 event store.
(define *g83-enabled* false)
(define *g83-model* ())
(define *g83-space* (g82-new ()))
(define *g83-map* ()) ; (unit-id episode-id native-proof)
(define *g83-status* 'disabled)
(define *g83-orders* 0)
(define *g83-hits* 0)
(define *g83-query-hits* 0)
(define-function g83-formula (atom)
  (let ((args ()) (ok true))
    (list-do x (dlm-args atom)
      (if (sq-name? x) (set args (dlm-append args (list (list 'const x)))) (set ok false)))
    (if ok (list 'pred (dlm-pred atom) args) ())))
(define-function g83-id (mapping episode atom)
  (let ((out ())) (list-do e mapping
    (if (and (equal episode (dlm-nth e 1)) (equal atom (dlm-conclusion (dlm-nth e 2))))
      (set out (car e)))) out))
(define-function g83-mod (n)
  (while (>= n 64) (set n (- n 64))) n)
(define-function g83-build (model)
  (let ((sig ()) (mapping ()) (ok true) (g ()) (n 0))
    (list-do name (a77-bases (a77-episodes model)) (set sig (dlm-add sig (list name 2))))
    (list-do d (a77-defs model) (set sig (dlm-add sig (list (dlm-nth d 1) 2))))
    (set g (g82-new sig))
    (list-do ep (a77-episodes model)
      (let ((closure (a77-close model (dlm-nth ep 2))))
        (if (not (= (dlm-nth closure 1) 'complete)) (set ok false))
        (list-do p (dlm-nth closure 2)
          (if (or (>= n 256) (not (g83-formula (dlm-conclusion p)))) (set ok false)
            (let ((id (concat-strings "unit83-" (number->string n))))
              (set mapping (dlm-append mapping (list (list id (dlm-nth ep 1) p))))
              (set g (s79-field g 3 (s79-put (dlm-nth g 3) id
                (list id (g83-formula (dlm-conclusion p)) () () false))))
              (set n (+ n 1)))))))
    (if (not ok) '(unavailable capacity-or-unsupported-input)
      (begin
        (list-do ep (a77-episodes model)
          (set g (g82-evidence g (dlm-nth ep 1) (dlm-nth ep 1)
            'explicit-native-observation "unhashed-native-event" "replay-order")))
        (list-do e mapping
          (let ((facts ()) (p (dlm-nth e 2)) (id (car e)))
            (list-do ep (a77-episodes model)
              (if (equal (dlm-nth ep 1) (dlm-nth e 1)) (set facts (dlm-nth ep 2))))
            (if (not (dlm-verify-proof p facts (a77-rules model))) (set ok false)
              (if (= (dlm-nth p 2) 'fact)
                  (set g (g82-observe g id (g83-formula (dlm-conclusion p)) (dlm-nth e 1)))
                (let ((deps ()) (u (g82-unit g id)))
                  (list-do child (dlm-nth p 4)
                    (let ((dep (g83-id mapping (dlm-nth e 1) (dlm-conclusion child))))
                      (if dep (set deps (dlm-append deps (list dep))) (set ok false))))
                  ;; Admission is through dlm-verify-proof above, NOT a G3c claim.
                  (set u (s79-field u 3 (list (list deps (list 'native83 p)))))
                  (set g (s79-field g 3 (s79-put (dlm-nth g 3) id u))))))))
        (if (not ok) '(unavailable invalid-native-proof)
          (begin
            (set g (g82-refresh g)) (set n 0)
            (list-do e mapping
              (set g (g82-place g (car e)
                (list (g83-mod (* n 11)) (g83-mod (* n 7)) (g83-mod (* n 3)))))
              (set n (+ n 1)))
            (list-do e mapping
              (if (= (dlm-nth (dlm-nth e 2) 2) 'rule)
                (set g (g82-relax g (car e) 2))))
            (list 'ready g mapping)))))))
(define-function g83-sync ()
  (set *g83-enabled* false)
  (list-do e *dlm-events*
    (if (= (car e) 'routing83) (set *g83-enabled* (= (dlm-nth e 1) 'on))))
  (set *g83-model* *dlm-model*)
  (set *g83-map* ()) (set *g83-space* (g82-new ())) (set *g83-status* 'disabled)
  (if *g83-enabled*
    (let ((built (g83-build *dlm-model*)))
      (set *g83-status* (car built))
      (if (= (car built) 'ready)
        (begin (set *g83-space* (dlm-nth built 1)) (set *g83-map* (dlm-nth built 2)))))))
(define-function g83-score (atom)
  (let* ((formula (g83-formula atom))
         (local (if formula (dlm-nth (g82-query *g83-space* formula '(0 0 0) 16 false) 2) ()))
         (score 1000000))
    (list-do e *g83-map*
      (if (equal atom (dlm-conclusion (dlm-nth e 2)))
        (let* ((p (s79-at (dlm-nth *g83-space* 4) (car e)))
               (d (+ (if (dlm-member? (car e) local) 0 16384) (g82-distance '(0 0 0) p))))
          (if (< d score) (set score d))))) score))
(define-function g83-insert (item items)
  (if (not items) (list item)
    (if (< (car item) (car (car items))) (cons item items)
      (cons (car items) (g83-insert item (cdr items))))))
(define-function g83-order (model facts)
  (if (not (and *g83-enabled* (= *g83-status* 'ready) (equal model *g83-model*))) facts
    (let ((ranked ()) (ordered ()))
      (set *g83-orders* (+ *g83-orders* 1))
      (list-do f facts
        (let ((score (g83-score f)))
          (if (< score 1000000) (set *g83-hits* (+ *g83-hits* 1)))
          (set ranked (g83-insert (list score f) ranked))))
      (list-do item ranked (set ordered (dlm-append ordered (list (dlm-nth item 1))))) ordered)))
(define-function g83-summary ()
  (list 'ground83 *g83-status* 'routing *g83-enabled*
    'units (dlm-length (dlm-nth *g83-space* 3))
    'evidence (dlm-length (dlm-nth *g83-space* 2))
    'order-calls *g83-orders* 'candidate-cache-hits *g83-hits* 'query-proof-hits *g83-query-hits*))
(define-function g83-command (args)
  (if (not args) (g83-summary)
    (if (not (dlm-member? (car args) '(on off))) '(rejected routing-mode)
      (let ((r (d77-commit *dlm-model* (list 'routing83 (car args)))))
        (if (= (car r) 'committed) (g83-summary) r)))))
(define-function g83-query (episode goal)
  (if (not (and *g83-enabled* (= *g83-status* 'ready) (equal *g83-model* *dlm-model*)
                (a77-fact? goal) (g83-formula goal)))
      (a77-query *dlm-model* episode goal)
    (let* ((candidates (g82-query *g83-space* (g83-formula goal) '(0 0 0) 16 true))
           (answer ()) (facts ()))
      (list-do ep (a77-episodes *dlm-model*)
        (if (equal episode (dlm-nth ep 1)) (set facts (dlm-nth ep 2))))
      (list-do id (dlm-nth candidates 2)
        (list-do e *g83-map*
          (if (and (not answer) (equal id (car e)) (equal episode (dlm-nth e 1))
                   (equal goal (dlm-conclusion (dlm-nth e 2)))
                   (dlm-verify-proof (dlm-nth e 2) facts (a77-rules *dlm-model*)))
            (set answer (list 'proved (dlm-nth e 2))))))
      (if answer (begin (set *g83-query-hits* (+ *g83-query-hits* 1)) answer)
        (a77-query *dlm-model* episode goal)))))
(set d83-query g83-query)
(set a83-order g83-order)
(set d83-sync g83-sync)
(set d83-command g83-command)

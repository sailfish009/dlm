;;; Relationally grounded numeric examples, independent applicability rebuild.
;;; Only observed95 targets count as support; derived outputs are INPUTS only.
(define-function c95-with-scopes (s scopes)
  (s79-field (b91-model s) 6 (list 'typed-core95 (dlm-nth (dlm-nth s 8) 1) scopes)))
(define-function c95-ep (s channel)
  (let ((ep (b91-find (dlm-nth s 3) (dlm-nth channel 3))))
    (and ep (= (dlm-nth ep 2) (dlm-nth channel 4)) ep)))
(define-function c95-paired (s channel rel ports scopes raw fuel)
  (let ((ep (c95-ep s channel)) (rows ()) (proofs ()) (status 'complete))
    (if (not ep) (set status 'inactive)
      (let* ((context (c95-context channel ep)) (model (c95-with-scopes s scopes))
             (bindings (c95-bindings model rel context raw fuel)))
        (set status (dlm-nth bindings 1)) (set fuel (dlm-nth bindings 3))
        (list-do target (dlm-nth channel 6)
          (if (= status 'complete)
            (let ((match ()))
              (list-do row (dlm-nth bindings 2) (if (equal (dlm-nth row 1) (dlm-nth target 2)) (set match row)))
              (if (not match) (set status 'unmatched)
                (let ((v (c95-eval-inputs ports (dlm-nth target 2) context model raw fuel)))
                  (set status (dlm-nth v 1)) (set fuel (dlm-nth v 4))
                  (if (= status 'complete)
                    (begin
                      (set rows (dlm-append rows (list (list 'row93 (dlm-nth target 1) (dlm-nth v 2) (dlm-nth target 3)))))
                      (set proofs (dlm-append proofs (list (list 'support95 (dlm-nth channel 1) (dlm-nth channel 2)
                        (dlm-nth target 1) (dlm-nth target 2) (dlm-nth match 2) (dlm-nth v 3))))))))))))
        (if (and (= status 'complete) (not (e93-rows? rows (dlm-length ports)))) (set status 'non-distinct))))
    (list 'examples95 status (if (= status 'complete) rows ()) (if (= status 'complete) proofs ()) fuel)))
(define-function c95-fitted-cells (rows num required)
  (let ((cells ()))
    (list-do cell (e93-cells rows)
      (let ((part (e93-cell-rows rows cell)))
        (if (and (>= (dlm-length part) 3) (or (not required) (dlm-member? cell (dlm-nth required 5)))
             (e93-raw-fits? (dlm-nth num 4) part (dlm-nth num 5)))
          (set cells (dlm-append cells (list cell)))))) cells))
(define-function c95-build-scopes (s)
  (let* ((facet (dlm-nth s 8)) (calibrations (dlm-nth facet 2)) (channels (dlm-nth facet 3)) (scopes ()))
    (list-do m (dlm-nth s 4)
      (cond
        ((c95-numeric? m)
          (let* ((origin (dlm-nth m 6)) (rows ()) (version 0))
            (if (= (car origin) 'raw95)
              (let ((source (e93-find calibrations (dlm-nth origin 1))))
                (if (and source (= (dlm-nth source 3) (dlm-nth m 2)))
                  (begin (set rows (dlm-nth source 4)) (set version (dlm-nth source 2)))))
              (let ((channel (e93-find channels (dlm-nth origin 1))))
                (if channel
                  (let ((examples (c95-paired s channel (b91-module (dlm-nth s 4) (dlm-nth origin 2))
                                    (dlm-nth origin 3) scopes true 200000)))
                    (if (= (dlm-nth examples 1) 'complete)
                      (begin (set rows (dlm-nth examples 2)) (set version (dlm-nth channel 2))))))))
            (if rows
              (let ((cells (c95-fitted-cells rows m ())))
                (if cells (set scopes (dlm-append scopes (list (list 'scope95 'numeric95
                  (dlm-nth origin 1) version (dlm-nth m 1) cells)))))))))
        ((c95-composite? m)
          (let ((channel (e93-find channels (dlm-nth m 5))) (required (c95-scope scopes 'numeric95 (dlm-nth m 3))))
            (if (and channel required)
              (let ((examples (c95-paired s channel (b91-module (dlm-nth s 4) (dlm-nth m 2))
                               (dlm-nth m 4) scopes true 200000)))
                (if (= (dlm-nth examples 1) 'complete)
                  (let ((cells (c95-fitted-cells (dlm-nth examples 2) (b91-module (dlm-nth s 4) (dlm-nth m 3)) required)))
                    (if cells (set scopes (dlm-append scopes (list (list 'scope95 'composite95
                      (dlm-nth channel 1) (dlm-nth channel 2) (dlm-nth m 1) cells))))))))))))) scopes))
(define-function c95-refresh (s)
  (if (not (sq-shape? s 9)) s
    (s79-field s 8 (s79-field (dlm-nth s 8) 4 (c95-build-scopes s)))))
(define-function c95-ready-cell (rows)
  (let ((ready ())) (list-do cell (e93-cells rows)
    (if (and (not ready) (>= (dlm-length (e93-cell-rows rows cell)) 3)) (set ready (list cell))))
    (if ready (car ready) ())))
(define-function c95-propose-number (s source cost fuel)
  (let* ((f (dlm-nth s 8)) (cal (e93-find (dlm-nth f 2) source))
         (lib (c95-number-lib (dlm-nth s 4))) (ready (if cal (c95-ready-cell (dlm-nth cal 4)) ())))
    (cond ((not cal) '(rejected95 source)) ((not ready) '(waiting95 insufficient-distinct-observations))
      ((>= (dlm-length (dlm-nth s 4)) 8) '(waiting95 capacity))
      (else (let ((search (e93-search (dlm-nth cal 3) (e93-cell-rows (dlm-nth cal 4) ready)
                             lib (dlm-nth f 1) cost fuel)))
        (if (not (= (dlm-nth search 1) 'found)) (list 'waiting95 (dlm-nth search 1) (dlm-nth search 3))
          (let* ((found (dlm-nth search 2))
                 (m (list 'numeric95 (+ 1 (dlm-length (dlm-nth s 4))) (dlm-nth cal 3)
                      (car found) (dlm-nth found 1) (dlm-nth f 1) (list 'raw95 source))))
            (list 'number-proposal95 source ready m (dlm-nth found 2) (dlm-nth search 3)))))))))
(define-function c95-check-number (s p)
  (and (sq-shape? p 6) (= (car p) 'number-proposal95)
    (let* ((source (e93-find (dlm-nth (dlm-nth s 8) 2) (dlm-nth p 1))) (m (dlm-nth p 3)))
      (and source (b91-library? (dlm-append (dlm-nth s 4) (list m)) (dlm-nth s 2))
        (c95-numeric? m) (equal (dlm-nth m 6) (list 'raw95 (dlm-nth p 1)))
        (= (dlm-nth m 5) (dlm-nth (dlm-nth s 8) 1)) (= (dlm-nth m 2) (dlm-nth source 3))
        (e93-cells? (list (dlm-nth p 2)) (dlm-nth m 2))
        (not (e93-known-expansion? (dlm-nth m 4) (dlm-nth m 2) (c95-number-lib (dlm-nth s 4))))
        (let ((rows (e93-cell-rows (dlm-nth source 4) (dlm-nth p 2))))
          (and (>= (dlm-length rows) 3) (dlm-proper? (dlm-nth p 4) 12)
            (e93-check-values (dlm-nth m 4) rows (dlm-nth p 4) (dlm-nth m 5) 1000)))))))

;;; typed.l — typed ports + provenance for fragment composition.
(define-function pt-port (v role) (list 'port v role))
(define-function pt-port? (x)
  (and (l-shape? x 3) (equal (car x) 'port)
       (l-var? (l-nth x 1)) (l-member? (l-nth x 2) '(in out link))))
(define-function pt-port-var (x) (l-nth x 1))
(define-function pt-port-role (x) (l-nth x 2))

(define-function pt-fragment (id head body ports prov)
  (list 'tfragment id head body ports prov))
(define-function pt-fragment? (x)
  (and (l-shape? x 6) (equal (car x) 'tfragment) (l-name? (l-nth x 1))
       (l-atom? (l-nth x 2)) (l-list? (l-nth x 3))
       (l-list? (l-nth x 4)) (l-list? (l-nth x 5))
       (not (l-any? (lambda (p) (not (pt-port? p))) (l-nth x 4)))
       (not (l-any? (lambda (a) (not (l-atom? a))) (l-nth x 3)))))
(define-function pt-id (x) (l-nth x 1))
(define-function pt-head (x) (l-nth x 2))
(define-function pt-body (x) (l-nth x 3))
(define-function pt-ports (x) (l-nth x 4))
(define-function pt-prov (x) (l-nth x 5))
(define-function pt-vars (atoms) (f-vars-of-atoms atoms))
(define-function pt-fragment-ok? (x)
  (and (pt-fragment? x) (pt-prov x) (pt-ports x)
       (f-subset? (l-map pt-port-var (pt-ports x)) (pt-vars (pt-body x)))))
(define-function pt-port-conflict? (p q)
  (and (equal (pt-port-var p) (pt-port-var q))
       (equal (pt-port-role p) (pt-port-role q))))
(define-function pt-conflict? (a b)
  (l-any? (lambda (p)
    (l-any? (lambda (q) (pt-port-conflict? p q)) b)) a))
(define-function pt-merge-prov (a b)
  (let ((out a))
    (list-do x b (if (not (l-member? x out)) (set out (l-append out (list x)))))
    out))
(define-function pt-template (id head body ports prov)
  (list 'ttemplate id head body ports prov))
(define-function pt-template? (x)
  (and (l-shape? x 6) (equal (car x) 'ttemplate) (l-name? (l-nth x 1))
       (l-atom? (l-nth x 2)) (l-list? (l-nth x 3))
       (l-list? (l-nth x 4)) (l-list? (l-nth x 5))))
(define-function pt-template-id (x) (l-nth x 1))
(define-function pt-template-head (x) (l-nth x 2))
(define-function pt-template-body (x) (l-nth x 3))
(define-function pt-template-ports (x) (l-nth x 4))
(define-function pt-template-prov (x) (l-nth x 5))
(define-function pt-combine (id a b)
  (if (or (not (pt-fragment-ok? a)) (not (pt-fragment-ok? b)))
    '(rejected107 fragment)
    (if (pt-conflict? (pt-ports a) (pt-ports b))
      '(rejected107 port)
      (let ((body (a-union-atoms (l-append (pt-body a) (pt-body b)))))
        (if (not (f-subset? (pt-vars (list (pt-head a)))
                            (pt-vars body)))
          '(rejected107 unsafe)
          (pt-template id (pt-head a) body
            (l-append (pt-ports a) (pt-ports b))
            (pt-merge-prov (pt-prov a) (pt-prov b))))))))
(define-function pt-program (id templates)
  (let ((rules ()) (prov ()))
    (list-do t templates
      (set rules (l-append rules (list (l-rule (pt-template-head t) (pt-template-body t)))))
      (set prov (pt-merge-prov prov (pt-template-prov t))))
    (list 'tprogram id (a-program id rules) prov)))

(define-function pt-op (kind args) (list 'ptop kind args))
(define-function pt-op? (x)
  (and (l-shape? x 3) (equal (car x) 'ptop) (l-name? (l-nth x 1)) (l-list? (l-nth x 2))))
(define-function pt-kind (x) (l-nth x 1))
(define-function pt-args (x) (l-nth x 2))
(define-function pt-module (name ops) (list 'ptmodule name ops))
(define-function pt-module? (x)
  (and (l-shape? x 3) (equal (car x) 'ptmodule) (l-name? (l-nth x 1))
       (l-list? (l-nth x 2))))
(define-function pt-find (id xs) (let ((h (l-assoc id xs))) (if h (l-nth h 1) ())))
(define-function pt-put (id v xs) (cons (list id v) (l-filter (lambda (e) (not (equal id (car e)))) xs)))
(define *pt-frags* ())
(define *pt-templates* ())
(define *pt-programs* ())
(define *pt-tasks* ())
(define-function pt-apply-op (op)
  (let* ((k (pt-kind op)) (a (pt-args op)))
    (cond
      ((equal k 'fragment)
       (set *pt-frags* (pt-put (l-nth a 0)
         (pt-fragment (l-nth a 0) (l-nth a 1) (l-nth a 2) (l-nth a 3) (l-nth a 4))
         *pt-frags*)))
      ((equal k 'template)
       (set *pt-templates* (pt-put (l-nth a 0)
         (pt-template (l-nth a 0) (l-nth a 1) (l-nth a 2) (l-nth a 3) (l-nth a 4))
         *pt-templates*)))
      ((equal k 'combine)
       (let ((x (pt-find (l-nth a 1) *pt-frags*))
             (y (pt-find (l-nth a 2) *pt-frags*)))
         (if (and x y)
           (let ((t (pt-combine (l-nth a 0) x y)))
             (if (not (equal (car t) 'rejected107))
               (set *pt-templates* (pt-put (l-nth a 0) t *pt-templates*)))))))
      ((equal k 'program)
       (let ((ts ()))
         (list-do id (l-nth a 1)
           (let ((t (pt-find id *pt-templates*)))
             (if t (set ts (l-append ts (list t))))))
         (if ts (set *pt-programs* (pt-put (l-nth a 0) (pt-program (l-nth a 0) ts) *pt-programs*)))))
      ((equal k 'task)
       (set *pt-tasks* (l-append *pt-tasks* (list (m-task (l-nth a 0) (l-nth a 1) (l-nth a 2) (l-nth a 3) (l-nth a 4))))))
      (else ()))))
(define-function pt-run (m)
  (if (not (pt-module? m)) '(rejected107 module)
    (begin
      (set *pt-frags* ()) (set *pt-templates* ())
      (set *pt-programs* ()) (set *pt-tasks* ())
      (list-do op (l-nth m 2) (pt-apply-op op))
      (list 'typed-result 'module (l-nth m 1)
            'fragments (l-len *pt-frags*) 'templates (l-len *pt-templates*)
            'programs (l-len *pt-programs*) 'tasks (l-len *pt-tasks*)
            'programs-list (l-map (lambda (e) (l-nth e 0)) *pt-programs*)
            'run (m-run *pt-tasks*
                        (l-map (lambda (e) (l-nth (l-nth e 1) 2)) *pt-programs*))))))

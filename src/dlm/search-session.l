;;; Search85 retains explicit terminal reasons and preflights scarce log resources.
;;; Replay accepts old84 control events; new configuration uses a version85 tag.
(define-function a84-replay (events)
  (if (not (dlm-proper? events 256)) '(rejected event-limit)
    (let ((model (a77-new)) (c (a84-new)) (ok true) (requested 0) (stop 'ready))
      (list-do e events
        (if ok
          (if (not (and (pair? e) (dlm-proper? e 4))) (set ok false)
            (let ((op (car e)) (n (dlm-length e)))
              (cond
                ((and (= n 2)
                   (or (and (= op 'search84) (dlm-member? (dlm-nth e 1) '(off cache rank ucb)))
                       (and (= op 'search85) (dlm-member? (dlm-nth e 1) '(off indexed cache rank ucb)))
                       (and (= op 'search86) (dlm-member? (dlm-nth e 1) '(off indexed cache rank ucb nd-cache nd-ucb)))))
                  (set c (a84-mode c (dlm-nth e 1))) (set stop 'ready))
                ((and (= op 'search84-run) (= n 2) (is <long> (dlm-nth e 1))
                      (> (dlm-nth e 1) 0) (<= (dlm-nth e 1) 1000))
                  (set requested (+ requested (dlm-nth e 1)))
                  (if (> requested 100000) (set ok false)
                    (let ((r (a84-run model c (dlm-nth e 1))))
                      (if (= (car r) 'invalid-input) (set ok false)
                        (begin (set model (dlm-nth r 1)) (set c (dlm-nth r 2)) (set stop (car r)))))))
                ((and (= op 'observe) (= n 3))
                  (let ((r (a77-observe model (dlm-nth e 1) (dlm-nth e 2))))
                    (if (= (car r) 'observed)
                      (begin (set model (dlm-nth r 1)) (set stop 'ready)) (set ok false))))
                ((and (= op 'define) (= n 2))
                  (let ((r (a77-certify model (dlm-nth e 1))))
                    (if (= (car r) 'learned)
                      (begin (set model (dlm-nth r 1)) (set stop 'ready)) (set ok false))))
                ((and (= op 'retract) (= n 2) (a77-name? (dlm-nth e 1)))
                  (set model (a77-retract model (dlm-nth e 1))) (set stop 'ready))
                ((and (= op 'routing83) (= n 2) (dlm-member? (dlm-nth e 1) '(on off))) ())
                (else (set ok false)))))))
      (if ok (list 'replayed model c stop) '(rejected search-event)))))
(define *s84-control* (a84-new))
(define *s84-pending* ()) ; (expected-events expected-model controller stop-reason)
(define *s84-events* ())
(define *s85-stop* 'ready)
(define-function s84-sync ()
  (if (and *s84-pending* (equal (car *s84-pending*) *dlm-events*)
           (equal (dlm-nth *s84-pending* 1) *dlm-model*))
      (begin (set *s84-control* (dlm-nth *s84-pending* 2)) (set *s85-stop* (dlm-nth *s84-pending* 3)))
    (if (not (d84-log? *dlm-events*))
      (begin (set *s84-control* (a84-new)) (set *s85-stop* 'ready))
      (let ((r (a84-replay *dlm-events*)))
        (set *s84-control* (if (= (car r) 'replayed) (dlm-nth r 2) (a84-new)))
        (set *s85-stop* (if (= (car r) 'replayed) (dlm-nth r 3) 'invalid-replay)))))
  (set *s84-events* *dlm-events*)
  (if (not (= (dlm-nth *s84-control* 1) 'off))
    (set *dlm-saturated* (dlm-member? *s85-stop* '(saturated capacity)))))
(define-function s84-summary ()
  (list 'search84 (dlm-nth *s84-control* 1)
    'certify-calls (dlm-nth *s84-control* 7) 'negative-cache-hits (dlm-nth *s84-control* 8)
    'joined-pairs (dlm-nth *s84-control* 9) 'proof-entries (dlm-nth *s84-control* 11)
    'pending-candidates (dlm-length (dlm-nth *s84-control* 3))
    'family-stats (dlm-nth *s84-control* 5) 'stop-reason *s85-stop*
    'generated-program (dlm-nth *s84-control* 12)))
(define-function s84-command (args)
  (if (not args) (s84-summary)
    (if (not (dlm-member? (car args) '(off indexed cache rank ucb nd-cache nd-ucb))) '(rejected search-mode)
      (let ((r (d77-commit *dlm-model* (list 'search86 (car args)))))
        (if (= (car r) 'committed) (s84-summary) r)))))
(define-function s84-admit (event events)
  (if (not (= (car event) 'search84-run)) true
    (let ((requested (dlm-nth event 1)))
      (list-do e events
        (if (= (car e) 'search84-run) (set requested (+ requested (dlm-nth e 1)))))
      (<= requested 100000))))
(define-function s85-preflight (budget)
  (cond
    ((not (and (is <long> budget) (> budget 0) (<= budget 1000))) 'invalid-budget)
    ((>= (dlm-length *dlm-events*) 256) 'event-limit)
    ((not (s84-admit (list 'search84-run budget) *dlm-events*)) 'request-limit)
    (else ())))
(define-function s85-resource-pause (reason)
  (d77-pause)
  (set *s85-stop* (list 'resource-limit reason))
  (set *dlm-last* (list 'paused 'resource-limit reason))
  (list 'round *dlm-round* *dlm-last*))
(define-function s85-run-step (budget)
  (let* ((r (a84-run *dlm-model* *s84-control* budget))
         (event (list 'search84-run budget)) (commit ()))
    (set *dlm-round* (+ *dlm-round* 1))
    (if (= (car r) 'invalid-input) (set *dlm-last* '(rejected search-input))
      (begin
        (set *s84-pending* (list (dlm-append *dlm-events* (list event)) (dlm-nth r 1) (dlm-nth r 2) (car r)))
        (set commit (d77-commit (dlm-nth r 1) event))
        (set *s84-pending* ())
        (if (not (= (car commit) 'committed)) (set *dlm-last* commit)
          (begin
            (set *dlm-saturated* (or (= (car r) 'saturated) (= (car r) 'capacity)))
            (set *dlm-last* (if (= (car r) 'learned)
              (list 'learned (dlm-nth r 4) 'instances (dlm-nth r 5) 'pair-checks (dlm-nth r 3))
              (list (car r) 'pair-checks (dlm-nth r 3))))))))
    (list 'round *dlm-round* *dlm-last*)))
(define-function s84-step ()
  (if (or (= (dlm-nth *s84-control* 1) 'off) *dlm-saturated*) (d77-plain-step)
    (let ((reason (s85-preflight *dlm-pair-budget*)))
      (if reason (s85-resource-pause reason) (s85-run-step *dlm-pair-budget*)))))
(set d84-admit s84-admit)
(set d84-replay a84-replay)
(set d84-sync s84-sync)
(set d84-command s84-command)
(set d84-step s84-step)

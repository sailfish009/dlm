;;; mlir.l — a Maru-native MLIR-shaped IR for fragment assembly/matching.
;;; It is deliberately not upstream MLIR: it preserves Maru self-host and
;;; lowers declarative module operations to the existing fragment/match core.

(define-function ml-op (kind args) (list 'mlop kind args))
(define-function ml-op? (x)
  (and (l-shape? x 3) (equal (car x) 'mlop) (l-name? (l-nth x 1))
       (l-list? (l-nth x 2))))
(define-function ml-kind (x) (l-nth x 1))
(define-function ml-args (x) (l-nth x 2))
(define-function ml-module (name ops) (list 'mlmodule name ops))
(define-function ml-module? (m)
  (and (l-shape? m 3) (equal (car m) 'mlmodule) (l-name? (l-nth m 1))
       (l-list? (l-nth m 2))
       (not (l-any? (lambda (o) (not (ml-op? o))) (l-nth m 2)))))
(define-function ml-name (m) (l-nth m 1))
(define-function ml-ops (m) (l-nth m 2))

(define-function ml-lookup (id xs)
  (let ((h (l-assoc id xs))) (if h (l-nth h 1) ())))
(define-function ml-put (id value xs)
  (cons (list id value) (l-filter (lambda (e) (not (equal id (car e)))) xs)))

(define *ml-frags* ())
(define *ml-templates* ())
(define *ml-programs* ())
(define *ml-tasks* ())

;;; MLIR-shaped synthesis ops. These are lowered to the synth core; the
;;; proof checker remains the truth gate.
(define *ml-synths* ())
(define *ml-synth-results* ())
(define *ml-proof-results* ())

(define-function ml-proof-result (id)
  (let ((hit (l-filter (lambda (e) (equal id (car e))) *ml-proof-results*)))
    (if hit (car hit) ())))

(define-function ml-synth-mode (r)
  (if (and r (>= (l-len r) 5)) (l-nth r 4) 'explicit))

(define-function ml-synth-quality (prog facts pos neg budget)
  (if (s-rec-program? prog)
    (list (s-coverage facts (s-rec-rules prog) pos budget)
          (if (s-conflict? facts (s-rec-rules prog) neg budget) 0 1))
    (list -1 0)))

(define-function ml-synth-result (id)
  (let ((hit (l-filter (lambda (e) (equal id (car e))) *ml-synth-results*)))
    (if hit (car hit) ())))

(define-function ml-synth-seed-op (a)
  (let* ((id (l-nth a 0)) (pred (l-nth a 1)) (target (l-nth a 2))
         (k (l-nth a 3)) (support (l-nth a 4))
         (r (s-seedk-rule pred target k)))
    (set *ml-synths* (ml-put id (s-synth r support) *ml-synths*))))

(define-function ml-synth-step-op (a)
  (let* ((id (l-nth a 0)) (pred (l-nth a 1)) (target (l-nth a 2))
         (k (l-nth a 3)) (support (l-nth a 4))
         (r (s-reck-rule pred target k)))
    (set *ml-synths* (ml-put id (s-synth r support) *ml-synths*))))

(define-function ml-synth-pair-seed-op (a)
  (let* ((id (l-nth a 0)) (p (l-nth a 1)) (q (l-nth a 2))
         (target (l-nth a 3)) (support (l-nth a 4))
         (x (l-var 'x)) (y (l-var 'y)) (z (l-var 'z))
         (r (l-rule (l-atom target (list x z))
              (list (l-atom p (list x y)) (l-atom q (list y z))))))
    (set *ml-synths* (ml-put id (s-synth r support) *ml-synths*))))

(define-function ml-synth-pair-step-op (a)
  (let* ((id (l-nth a 0)) (p (l-nth a 1)) (q (l-nth a 2))
         (target (l-nth a 3)) (support (l-nth a 4))
         (x (l-var 'x)) (y (l-var 'y)) (w (l-var 'w)) (z (l-var 'z))
         (r (l-rule (l-atom target (list x z))
              (list (l-atom p (list x y))
                    (l-atom q (list y w))
                    (l-atom target (list w z))))))
    (set *ml-synths* (ml-put id (s-synth r support) *ml-synths*))))

(define-function ml-synth-program-op (a)
  (let* ((id (l-nth a 0)) (sid (l-nth a 1)) (tid (l-nth a 2))
         (facts (l-nth a 3)) (pos (l-nth a 4)) (neg (l-nth a 5))
         (budget (l-nth a 6))
         (sd (ml-lookup sid *ml-synths*)) (st (ml-lookup tid *ml-synths*)))
    (if (and sd st)
      (let* ((rules (list (s-rule sd) (s-rule st)))
             (support (s-uniq (l-append (s-support sd) (s-support st))))
             (prog (s-rec-program rules support))
             (cov (s-coverage facts rules pos budget))
             (conf (s-conflict? facts rules neg budget)))
        (set *ml-synth-results* (l-append *ml-synth-results*
          (list (list id prog cov (if conf 'conflict 'clean) 'explicit))))))))

(define-function ml-synth-search-op (a)
  (let* ((id (l-nth a 0)) (mode (l-nth a 1))
         (facts (l-nth a 2)) (pos (l-nth a 3)) (neg (l-nth a 4))
         (maxk (l-nth a 5)) (budget (l-nth a 6))
         (sp (if (or (equal mode 'stride) (equal mode 'auto))
               (s-stride-synthesize facts pos neg maxk budget) '(none)))
         (pp (if (or (equal mode 'pair) (equal mode 'auto))
               (s-pair-synthesize facts pos neg budget) '(none)))
         (sq (ml-synth-quality sp facts pos neg budget))
         (pq (ml-synth-quality pp facts pos neg budget))
         (use-pair (and (equal mode 'auto)
                        (or (> (car pq) (car sq))
                            (and (= (car pq) (car sq))
                                 (> (l-nth pq 1) (l-nth sq 1))))))
         (pick-pair (if (equal mode 'pair) (not ())
                        (and (equal mode 'auto) use-pair)))
         (prog (if pick-pair pp sp))
         (qm (if pick-pair pq sq))
         (chosen (if (equal mode 'auto)
                   (if use-pair 'pair 'stride)
                   mode))
         (cov (car qm))
         (conf (if (= (l-nth qm 1) 0) 'conflict 'clean)))
    (set *ml-synth-results* (l-append *ml-synth-results*
      (list (list id prog cov conf chosen))))))

(define-function ml-synth-proof-op (a)
  (let* ((id (l-nth a 0)) (pid (l-nth a 1))
         (facts (l-nth a 2)) (goal (l-nth a 3)) (budget (l-nth a 4))
         (sr (ml-synth-result pid)))
    (if (and sr (s-rec-program? (l-nth sr 1)))
      (let* ((rules (s-rec-rules (l-nth sr 1)))
             (hit (l-lookup goal (p-close facts rules budget))))
        (set *ml-proof-results* (l-append *ml-proof-results*
          (list (list id (if hit 'proof 'fail)))))))))

(define-function ml-apply-synth-op (op)
  (let ((kind (ml-kind op)) (a (ml-args op)))
    (cond
      ((equal kind 'synth-seed) (ml-synth-seed-op a))
      ((equal kind 'synth-step) (ml-synth-step-op a))
      ((equal kind 'synth-pair-seed) (ml-synth-pair-seed-op a))
      ((equal kind 'synth-pair-step) (ml-synth-pair-step-op a))
      ((equal kind 'synth-program) (ml-synth-program-op a))
      ((equal kind 'synth-search) (ml-synth-search-op a))
      ((equal kind 'synth-proof) (ml-synth-proof-op a))
      (else ()))))

(define-function ml-apply-op (op)
  (let* ((kind (ml-kind op)) (a (ml-args op)))
    (cond
      ((equal kind 'fragment)
       (set *ml-frags* (ml-put (l-nth a 0)
         (f-fragment (l-nth a 0) (l-nth a 1) (l-nth a 2)) *ml-frags*)))
      ((equal kind 'combine)
       (let ((left (ml-lookup (l-nth a 1) *ml-frags*))
             (right (ml-lookup (l-nth a 2) *ml-frags*)))
         (if (and left right)
           (set *ml-templates* (ml-put (l-nth a 0)
             (a-combine (l-nth a 0) left right) *ml-templates*)))))
      ((equal kind 'template)
       (set *ml-templates* (ml-put (l-nth a 0)
         (a-template (l-nth a 0) (l-nth a 1) (l-nth a 2)) *ml-templates*)))
      ((equal kind 'program)
       (let ((ts ()))
         (list-do id (l-nth a 1)
           (let ((t (ml-lookup id *ml-templates*)))
             (if t (set ts (l-append ts (list t))))))
         (if ts (set *ml-programs* (ml-put (l-nth a 0)
           (a-program-from-templates (l-nth a 0) ts) *ml-programs*)))))
      ((equal kind 'task)
       (set *ml-tasks* (l-append *ml-tasks* (list
         (m-task (l-nth a 0) (l-nth a 1) (l-nth a 2)
                 (l-nth a 3) (l-nth a 4))))))
      (else (ml-apply-synth-op op)))))

(define-function ml-run (m)
  (if (not (ml-module? m)) '(rejected107 mlir)
    (begin
      (set *ml-frags* ()) (set *ml-templates* ())
      (set *ml-programs* ()) (set *ml-tasks* ())
      (set *ml-synths* ()) (set *ml-synth-results* ())
      (set *ml-proof-results* ())
      (list-do op (ml-ops m) (ml-apply-op op))
      (list 'mlir-result 'module (ml-name m)
            'fragments (l-len *ml-frags*) 'templates (l-len *ml-templates*)
            'programs (l-len *ml-programs*) 'tasks (l-len *ml-tasks*)
            'run (m-run *ml-tasks*
                        (l-map (lambda (e) (l-nth e 1)) *ml-programs*))
            'synth (l-len *ml-synth-results*)
            'proof (l-len *ml-proof-results*)))))

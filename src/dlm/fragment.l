;;; fragment.l — reusable axiom fragments with head/body slots and variables.
(define-function f-fragment (id head body)
  (list 'fragment id head body))
(define-function f-fragment? (x)
  (and (l-shape? x 4) (equal (car x) 'fragment)
       (l-name? (l-nth x 1)) (l-atom? (l-nth x 2))
       (l-list? (l-nth x 3)) (l-nth x 3)
       (not (l-any? (lambda (a) (not (l-atom? a))) (l-nth x 3)))))
(define-function f-id (x) (l-nth x 1))
(define-function f-head (x) (l-nth x 2))
(define-function f-body (x) (l-nth x 3))
(define-function f-vars-of-atoms (atoms)
  (let ((out ()))
    (list-do a atoms
      (list-do t (l-args a)
        (if (and (l-var? t) (not (l-member? t out)))
          (set out (l-append out (list t))))))
    out))
(define-function f-vars (x) (f-vars-of-atoms (l-append (list (f-head x)) (f-body x))))
(define-function f-subset? (a b)
  (not (l-any? (lambda (x) (not (l-member? x b))) a)))
(define-function f-safe? (x)
  (and (f-fragment? x)
       (f-subset? (f-vars-of-atoms (list (f-head x))) (f-vars-of-atoms (f-body x)))))

;;; nl.l — controlled English natural language → facts/rules → proof → answer.
;;; The NL layer is untrusted; the proof checker remains the truth gate.

(define *nl-lex*
  (list
    (list "cat" 'cat) (list "dog" 'dog) (list "bird" 'bird)
    (list "mammal" 'mammal) (list "animal" 'animal)
    (list "living thing" 'living-thing) (list "plant" 'plant)))

(define-function nl-list->string (xs)
  (let ((out (string (l-len xs))) (i 0))
    (while xs
      (set-string-at out i (car xs))
      (set i (+ i 1))
      (set xs (cdr xs)))
    out))

(define-function nl-slice (s start end)
  (let ((out ()) (i start))
    (while (< i end)
      (set out (l-append out (list (string-at s i))))
      (set i (+ i 1)))
    (nl-list->string out)))

(define-function nl-lower (s)
  (let ((out (string (string-length s))) (i 0) (c 0))
    (while (< i (string-length s))
      (set c (string-at s i))
      (if (and (>= c 65) (<= c 90)) (set c (+ c 32)))
      (set-string-at out i c)
      (set i (+ i 1)))
    out))

(define-function nl-match-at? (s pat start i)
  (if (>= i (string-length pat)) (not ())
    (and (< (+ start i) (string-length s))
         (= (string-at s (+ start i)) (string-at pat i))
         (nl-match-at? s pat start (+ i 1)))))
(define-function nl-prefix? (s p)
  (and (>= (string-length s) (string-length p)) (nl-match-at? s p 0 0)))
(define-function nl-suffix? (s p)
  (and (>= (string-length s) (string-length p))
       (nl-match-at? s p (- (string-length s) (string-length p)) 0)))
(define-function nl-find (s p start)
  (if (> (+ start (string-length p)) (string-length s)) -1
    (if (nl-match-at? s p start 0) start (nl-find s p (+ start 1)))))
(define-function nl-remove-suffix (s p)
  (if (nl-suffix? s p) (nl-slice s 0 (- (string-length s) (string-length p))) s))
(define-function nl-split (s sep)
  (let ((i (nl-find s sep 0)))
    (if (< i 0) (list s "")
      (list (nl-slice s 0 i)
            (nl-slice s (+ i (string-length sep)) (string-length s))))))
(define-function nl-normalize (s)
  (let ((t (nl-lower s)))
    (if (nl-suffix? t ".") (set t (nl-remove-suffix t ".")))
    (if (nl-suffix? t "?") (set t (nl-remove-suffix t "?")))
    t))

(define-function nl-slug (s i out)
  (if (>= i (string-length s)) (nl-list->string out)
    (let ((c (string-at s i)))
      (nl-slug s (+ i 1)
        (if (= c 32) (l-append out (list 45)) (l-append out (list c)))))))
(define-function nl-singular (s)
  (if (nl-suffix? s "s") (nl-slice s 0 (- (string-length s) 1)) s))
(define-function nl-symbol (s)
  (let ((hit (l-assoc s *nl-lex*)))
    (if hit (l-nth hit 1)
      (let ((h2 (l-assoc (nl-singular s) *nl-lex*)))
        (if h2 (l-nth h2 1) (string->symbol (nl-slug (nl-singular s) 0 ())))))))
(define-function nl-word (sym)
  (let ((hit (l-filter (lambda (e) (equal sym (l-nth e 1))) *nl-lex*)))
    (if hit (l-nth (car hit) 0) (symbol->string sym))))

(define-function nl-split-article (s)
  (let ((p (nl-split s " a ")))
    (if (not (equal (l-nth p 1) "")) p (nl-split s " an "))))
(define-function nl-make (kind subj obj text)
  (list kind (nl-symbol subj) (nl-symbol obj) text))
(define-function nl-fact-parse (t text)
  (let* ((u (if (nl-prefix? t "a ") (nl-slice t 2 (string-length t))
              (if (nl-prefix? t "an ") (nl-slice t 3 (string-length t)) t)))
         (k (nl-find u " is a kind of " 0)))
    (if (>= k 0)
      (nl-make 'nl-subclass
        (nl-slice u 0 k)
        (nl-slice u (+ k (string-length " is a kind of ")) (string-length u))
        text)
      (let* ((p (nl-split u " is a ")) (sub (car p))
             (obj (if (>= (list-length p) 2) (l-nth p 1) "")))
        (if (or (= 0 (string-length sub)) (= 0 (string-length obj)))
            (list 'nl-unknown text)
            (nl-make 'nl-fact sub obj text))))))
(define-function nl-article (w)
  (let ((c (if (> (string-length w) 1) (string-at w 0) 0)))
    (if (or (= c 97) (= c 101) (= c 105) (= c 111) (= c 117))
      (concat-strings "an " w)
      (concat-strings "a " w))))
(define-function nl-parse (text)
  (let ((t (nl-normalize text)))
    (cond
      ((nl-prefix? t "all ")
       (let* ((u (nl-slice t (string-length "all ") (string-length t)))
              (p (nl-split u " are ")))
         (nl-make 'nl-rule (car p) (l-nth p 1) text)))
      ((or (nl-prefix? t "a ") (nl-prefix? t "an "))
       (nl-fact-parse t text))
      ((nl-prefix? t "is a ")
       (let* ((u (nl-slice t (string-length "is a ") (string-length t)))
              (p (nl-split-article u)))
         (nl-make 'nl-query (car p) (l-nth p 1) text)))
      (else (list 'nl-unknown text)))))

(define-function nl-kind (r) (l-nth r 0))
(define-function nl-subj (r) (l-nth r 1))
(define-function nl-obj (r) (l-nth r 2))
(define-function nl-text (r) (l-nth r 3))

(define-function nl-build (records)
  (let ((facts ()) (rules ()) (fsrc ()) (rsrc ()) (fi 0))
    (list-do r records
      (if (or (equal (nl-kind r) 'nl-fact) (equal (nl-kind r) 'nl-subclass))
        (begin
          (set facts (l-append facts (list (l-fact
            (concat-strings "f" (number->string fi))
            (l-atom (if (equal (nl-kind r) 'nl-subclass) 'subclass 'isa)
                    (list (nl-subj r) (nl-obj r)))))))
          (set fsrc (l-append fsrc (list (list (concat-strings "f" (number->string fi))
                                                (nl-text r)))))
          (set fi (+ fi 1)))
        (if (equal (nl-kind r) 'nl-rule)
          (begin
            (set rules (l-append rules (list (l-rule
              (l-atom 'isa (list (l-var 'x) (nl-obj r)))
              (list (l-atom 'isa (list (l-var 'x) (nl-subj r))))))))
            (set rsrc (l-append rsrc (list (nl-text r))))))))
    (list facts rules fsrc rsrc)))

(define-function nl-source-of (id fsrc)
  (let ((hit (l-assoc id fsrc))) (if hit (l-nth hit 1) "")))
(define-function nl-uniq (xs)
  (if (not xs) () (cons (car xs) (nl-uniq (l-filter (lambda (x) (not (equal x (car xs)))) (cdr xs))))))
(define-function nl-join (xs sep)
  (if (not xs) ""
    (if (not (cdr xs)) (car xs)
      (concat-strings (car xs) (concat-strings sep (nl-join (cdr xs) sep))))))
(define-function nl-rule-indices (mode x)
  (if (equal mode 'all)
    (if (not x) ()
      (l-append (nl-rule-indices 'one (car x))
                (nl-rule-indices 'all (cdr x))))
    (if (not x) ()
      (if (equal (car x) 'given) ()
        (l-append (list (l-nth x 1))
                  (nl-rule-indices 'all (l-nth x 3)))))))
(define-function nl-why (proof facts rules fsrc rsrc)
  (if (not proof) ""
    (let ((ids (nl-uniq (p-proof-givens proof)))
          (idx (nl-uniq (nl-rule-indices 'one proof)))
          (out ()))
      (list-do id ids
        (let ((s (nl-source-of id fsrc))) (if (not (equal s "")) (set out (l-append out (list s))))))
      (list-do i idx
        (let ((s (l-nth rsrc i))) (if s (set out (l-append out (list s))))))
      (nl-join (nl-uniq out) " "))))

(define-function nl-basis (records)
  (let ((b ()) (i 0))
    (list-do r records
      (if (equal (nl-kind r) 'nl-rule)
        (let ((id (concat-strings "nl-rule-" (number->string i)))
              (rule (l-rule (l-atom 'isa (list (l-var 'x) (nl-obj r)))
                            (list (l-atom 'isa (list (l-var 'x) (nl-subj r)))))))
          (set b (b-add b id (list rule) (list (nl-text r)) ()))
          (set b (b-activate b id))
          (set i (+ i 1)))))
    b))

(define-function nl-run (texts query-text)
  (let* ((records (l-append (l-map nl-parse texts) (list (nl-parse query-text))))
         (kb (nl-build records))
         (facts (car kb)) (fsrc (l-nth kb 2)) (rsrc (l-nth kb 3))
         (basis (nl-basis records))
         (rules (b-active-rules basis))
         (q (car (l-filter (lambda (r) (equal (nl-kind r) 'nl-query)) records))))
    (if (not q)
      (list 'nl-result 'fail "" "" "query not understood")
      (let* ((goal (l-atom 'isa (list (nl-subj q) (nl-obj q))))
             (pr (p-prove facts rules goal 20000))
             (proof (l-nth pr 2))
             (ok (equal (l-nth pr 1) 'proof))
             (subj (nl-word (nl-subj q))) (obj (nl-word (nl-obj q)))
             (yes (concat-strings "Yes, " (concat-strings (nl-article subj)
                    (concat-strings " is " (concat-strings (nl-article obj) ".")))))
             (no (concat-strings "I cannot prove that " (concat-strings (nl-article subj)
                    (concat-strings " is " (concat-strings (nl-article obj) ".")))))
             (why (if ok (nl-why proof facts rules fsrc rsrc) "")))
        (list 'nl-result (if ok 'proved 'unknown) goal
              (if ok yes no) why (nl-text q))))))

;;; Boundary query over an existing fact set + active basis rules.
(define-function nl-answer-with (facts rules query-text)
  (let ((q (nl-parse query-text)))
    (if (not (equal (nl-kind q) 'nl-query))
      (list 'nl-result 'fail "" "" "query not understood")
      (let* ((goal (l-atom 'isa (list (nl-subj q) (nl-obj q))))
             (pr (p-prove facts rules goal 20000))
             (proof (l-nth pr 2))
             (ok (equal (l-nth pr 1) 'proof))
             (subj (nl-word (nl-subj q))) (obj (nl-word (nl-obj q)))
             (yes (concat-strings "Yes, " (concat-strings (nl-article subj)
                    (concat-strings " is " (concat-strings (nl-article obj) ".")))))
             (no (concat-strings "I cannot prove that " (concat-strings (nl-article subj)
                    (concat-strings " is " (concat-strings (nl-article obj) "."))))))
        (list 'nl-result (if ok 'proved 'unknown) goal
              (if ok yes no) "" (nl-text q))))))

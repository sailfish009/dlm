;;; Typed facets and heterogeneous definitions extend Basis91's existing owner.
;;; No *c95-state*, second library, or checkpoint owner. Global prefix IDs.
;;; numeric95 ID ARITY BODY EXPANSION BRANCH ORIGIN
;;; composite95 ID REL-ID NUM-ID INPUT-PORTS ORIGIN-CHANNEL
;;; Ports: (measure95 OBJECT-ROLE), (output95 PREFIX-COMPOSITE-ID).
(define-function c95-numeric? (m) (and (pair? m) (= (car m) 'numeric95)))
(define-function c95-composite? (m) (and (pair? m) (= (car m) 'composite95)))
(define-function c95-number-lib (lib)
  (let ((out ())) (list-do m lib (if (c95-numeric? m)
    (set out (dlm-append out (list (list 'basis93 (dlm-nth m 1) (dlm-nth m 2) (dlm-nth m 3) (dlm-nth m 4))))))) out))
(define-function c95-id? (id) (e93-int? id 1 8))
(define-function c95-inputs? (inputs arity rel prefix)
  (and (dlm-proper? inputs 2) (= (dlm-length inputs) arity)
    (let ((ok true)) (list-do port inputs
      (if (not (and (sq-shape? port 2)
        (or (and (= (car port) 'measure95) (e93-int? (dlm-nth port 1) 0 (- (b91-arity (dlm-nth rel 2)) 1)))
            (and (= (car port) 'output95) (c95-id? (dlm-nth port 1))
              (let ((prior (b91-module prefix (dlm-nth port 1))))
                (and (c95-composite? prior) (= (dlm-nth prior 2) (dlm-nth rel 1)))))))) (set ok false))) ok)))
(define-function c95-module? (m prefix sig)
  (cond
    ((and (sq-shape? m 7) (c95-numeric? m) (e93-arity? (dlm-nth m 2)) (e93-branch? (dlm-nth m 5)))
      (let ((lib (c95-number-lib prefix)) (origin (dlm-nth m 6)))
        (and (e93-term? (dlm-nth m 3) (dlm-nth m 2) lib 12)
          (<= (e93-size (dlm-nth m 3)) 3) (e93-all-roles? (dlm-nth m 3) (dlm-nth m 2))
          (e93-term? (dlm-nth m 4) (dlm-nth m 2) () 12) (<= (e93-size (dlm-nth m 4)) 96)
          (equal (e93-expand (dlm-nth m 3) lib) (dlm-nth m 4))
          (or (and (sq-shape? origin 2) (= (car origin) 'raw95) (b91-name? (dlm-nth origin 1)))
              (and (sq-shape? origin 4) (= (car origin) 'paired95) (b91-name? (dlm-nth origin 1))
                (c95-id? (dlm-nth origin 2))
                (let ((rel (b91-module prefix (dlm-nth origin 2))))
                  (and (b91-relational? rel) (c95-inputs? (dlm-nth origin 3) (dlm-nth m 2) rel prefix))))))))
    ((and (sq-shape? m 6) (c95-composite? m) (c95-id? (dlm-nth m 2))
          (c95-id? (dlm-nth m 3)) (b91-name? (dlm-nth m 5)))
      (let ((rel (b91-module prefix (dlm-nth m 2))) (num (b91-module prefix (dlm-nth m 3))))
        (and (b91-relational? rel) (c95-numeric? num) (c95-inputs? (dlm-nth m 4) (dlm-nth num 2) rel prefix))))
    (else false)))
(define-function c95-measures? (xs)
  (and (dlm-proper? xs 8)
    (let ((seen ()) (ok true)) (list-do m xs
      (if (and (sq-shape? m 3) (= (car m) 'measure95) (b91-name? (dlm-nth m 1))
               (e93-z? (dlm-nth m 2)) (not (dlm-member? (dlm-nth m 1) seen)))
        (set seen (cons (dlm-nth m 1) seen)) (set ok false))) ok)))
(define-function c95-measure (xs object)
  (let ((out ())) (list-do m xs (if (equal (dlm-nth m 1) object) (set out (dlm-nth m 2)))) out))
(define-function c95-targets? (xs)
  (and xs (dlm-proper? xs 12)
    (let ((ids ()) (tuples ()) (arity ()) (ok true)) (list-do t xs
      (if (and (sq-shape? t 4) (= (car t) 'observed95) (b91-name? (dlm-nth t 1))
          (dlm-nth t 2) (dlm-proper? (dlm-nth t 2) 4) (e93-z? (dlm-nth t 3))
          (or (not arity) (= arity (dlm-length (dlm-nth t 2))))
          (not (dlm-member? (dlm-nth t 1) ids)) (not (dlm-member? (dlm-nth t 2) tuples))
          (let ((good true)) (list-do v (dlm-nth t 2) (if (not (b91-name? v)) (set good false))) good))
        (begin (set arity (dlm-length (dlm-nth t 2))) (set ids (cons (dlm-nth t 1) ids)) (set tuples (cons (dlm-nth t 2) tuples)))
        (set ok false))) ok)))
(define-function c95-calibration? (x)
  (and (sq-shape? x 5) (= (car x) 'calibration95) (b91-name? (dlm-nth x 1))
    (e93-int? (dlm-nth x 2) 1 32) (e93-arity? (dlm-nth x 3)) (e93-rows? (dlm-nth x 4) (dlm-nth x 3))))
(define-function c95-channel? (x)
  (and (sq-shape? x 7) (= (car x) 'channel95) (b91-name? (dlm-nth x 1))
    (e93-int? (dlm-nth x 2) 1 32) (b91-name? (dlm-nth x 3)) (e93-int? (dlm-nth x 4) 1 32)
    (c95-measures? (dlm-nth x 5)) (c95-targets? (dlm-nth x 6))))
(define-function c95-scope (scopes kind id)
  (let ((out ())) (list-do v scopes
    (if (and (= (dlm-nth v 1) kind) (= (dlm-nth v 4) id)) (set out v))) out))
(define-function c95-live-ports? (ports scopes)
  (let ((ok true)) (list-do port ports
    (if (and (= (car port) 'output95) (not (c95-scope scopes 'composite95 (dlm-nth port 1)))) (set ok false))) ok))
(define-function c95-scope? (v facet lib)
  (and (sq-shape? v 6) (= (car v) 'scope95) (c95-id? (dlm-nth v 4))
    (b91-name? (dlm-nth v 2)) (e93-int? (dlm-nth v 3) 1 32) (dlm-nth v 5)
    (let ((m (b91-module lib (dlm-nth v 4))) (scopes (dlm-nth facet 2)))
      (cond
        ((c95-numeric? m)
          (and (= (dlm-nth v 1) 'numeric95) (= (dlm-nth m 5) (dlm-nth facet 1))
            (equal (dlm-nth v 2) (dlm-nth (dlm-nth m 6) 1)) (e93-cells? (dlm-nth v 5) (dlm-nth m 2))
            (or (= (car (dlm-nth m 6)) 'raw95) (c95-live-ports? (dlm-nth (dlm-nth m 6) 3) scopes))))
        ((c95-composite? m)
          (and (= (dlm-nth v 1) 'composite95) (equal (dlm-nth v 2) (dlm-nth m 5))
            (e93-cells? (dlm-nth v 5) (dlm-nth (b91-module lib (dlm-nth m 3)) 2))
            (c95-scope scopes 'numeric95 (dlm-nth m 3)) (c95-live-ports? (dlm-nth m 4) scopes)))
        (else false)))))
(define-function c95-core? (facet lib)
  (and (sq-shape? facet 3) (= (car facet) 'typed-core95) (e93-branch? (dlm-nth facet 1))
    (dlm-proper? (dlm-nth facet 2) 8)
    (let ((seen ()) (ok true))
      (list-do m lib (if (and (c95-numeric? m) (not (= (dlm-nth m 5) (dlm-nth facet 1)))) (set ok false)))
      (list-do v (dlm-nth facet 2)
        (if (and (c95-scope? v facet lib) (not (dlm-member? (dlm-nth v 4) seen)))
          (set seen (cons (dlm-nth v 4) seen)) (set ok false))) ok)))
(define-function c95-state? (s)
  (let ((f (dlm-nth s 8)))
    (and (sq-shape? f 5) (= (car f) 'typed95) (e93-branch? (dlm-nth f 1))
      (dlm-proper? (dlm-nth f 2) 4) (dlm-proper? (dlm-nth f 3) 3)
      (let ((ok true) (ids ()))
        (list-do x (dlm-nth f 2) (if (and (c95-calibration? x) (not (dlm-member? (dlm-nth x 1) ids)))
          (set ids (cons (dlm-nth x 1) ids)) (set ok false)))
        (set ids ()) (list-do x (dlm-nth f 3) (if (and (c95-channel? x) (not (dlm-member? (dlm-nth x 1) ids)))
          (set ids (cons (dlm-nth x 1) ids)) (set ok false))) ok))))
(define-function c95-project (s)
  (let ((f (dlm-nth s 8)))
    (if (= (car f) 'typed-core95) f (list 'typed-core95 (dlm-nth f 1) (dlm-nth f 4)))))
(define-function c95-context? (x sig)
  (and (sq-shape? x 5) (= (car x) 'context95) (b91-name? (dlm-nth x 1)) (e93-int? (dlm-nth x 2) 1 32)
    (b91-facts? (dlm-nth x 3) sig) (c95-measures? (dlm-nth x 4))))
(define-function c95-context (channel ep)
  (list 'context95 (dlm-nth ep 1) (dlm-nth ep 2) (dlm-nth ep 3) (dlm-nth channel 5)))
(define-function c95-query-model (model context)
  (s79-field (s79-field model 2 (list (list 'episode91 (dlm-nth context 1) (dlm-nth context 2) (dlm-nth context 3) false))) 4 ()))
(set *b91-typed-module-check* c95-module?)
(set *b91-typed-core-check* c95-core?)
(set *b91-typed-state-check* c95-state?)
(set *b91-typed-project* c95-project)

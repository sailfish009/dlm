;;; -*- mode: lisp; coding: us-ascii -*-
;;; Fresh definitions name formulas, not new empirical facts. Original and
;;; unfolded requests both retain explicit definition/theory conditions.
(define-function d79-define (s name sig body)
  (if (not (and (sq-name? name) (not (s79-job s name)) (not (dlm-assoc name (dlm-nth s 12)))
                (sq-signature? sig) (< (dlm-length sig) 999)
                (< (dlm-length (dlm-nth s 12)) s79-definition-limit)
                (sq-formula? 'classical-prop-v1 body sig))) '(rejected definition)
    (let ((head (concat-strings "defined79-" (number->string (dlm-nth s 9)) "-" (number->string (dlm-length (dlm-nth s 12))))))
      (while (dlm-assoc head sig) (set head (concat-strings head "-fresh")))
      (s79-field s 12 (s79-put (dlm-nth s 12) name
        (list 'definition79 name (dlm-append sig (list (list head 0)))
          (list 'pred head ()) body '(top) 'fresh '(naming-only)))))))
(define-function d79-use (s name definition premises)
  (let ((d (s79-at (dlm-nth s 12) definition)))
    (if (not (and d (sq-formulas? premises (dlm-nth d 2)))) '(rejected definition-or-premises)
      (i79-create s name 'definition (list d premises)))))
(define-function d79-step (s id)
  (let* ((d (dlm-nth (s79-unit s id) 5)) (stage (dlm-nth d 1)) (config (dlm-nth d 2))
         (definition (car config)) (premises (dlm-nth config 1)) (sig (dlm-nth definition 2))
         (target (dlm-nth definition 3)) (body (dlm-nth definition 4)) (guard (dlm-nth definition 5))
         (subs (dlm-nth d 3)))
    (if (= stage 'start)
        (let* ((condition (if (= (dlm-nth definition 6) 'fresh)
                  (list 'and (list 'imp target body) (list 'imp body target)) guard))
               (unfolded (p78-replace premises (list (list target body))))
               (r1 (i79-child-job s id sig (cons condition premises) (list target))))
          (if (not (dlm-nth r1 1)) (car r1)
            (let ((r2 (i79-child-job (car r1) id sig (cons guard unfolded) (list body))))
              (if (not (dlm-nth r2 1)) (car r2)
                (i79-stage (car r2) id 'verify (list (dlm-nth r1 1) (dlm-nth r2 1)) condition)))))
      (if (and (= stage 'verify) (i79-subdone? s subs))
          (i79-done s id (list 'definition-use79 (if (i79-all-proved? s subs) 'proved 'not-proved)
            definition (i79-subresult s (car subs)) (i79-subresult s (dlm-nth subs 1)))) s))))
(define-function d79-auto-name (s sig root)
  (let ((goal (and (= (dlm-length (sq-right root)) 1) (car (sq-right root)))) (seen false))
    (if (and goal (not (= (car goal) 'pred)) (not (= (car goal) 'top)) (not (= (car goal) 'bottom)))
        (begin
          (list-do entry (dlm-nth s 12)
            (if (equal goal (dlm-nth (dlm-nth entry 1) 4)) (set seen true)))
          (if (not seen)
              (let ((next (d79-define s (concat-strings "motif79-" (number->string (dlm-length (dlm-nth s 12)))) sig goal)))
                (if (not (= (car next) 'rejected)) (set s next)))))) s))
(set s79-on-job-done (lambda (s name)
  (let ((j (s79-job s name)))
    (if (and (= (dlm-nth j 2) 'proof) (dlm-nth j 8)
             (= (dlm-nth (dlm-nth j 5) 1) 'proved))
        (let ((next (i79-learn s (s79-free-name s (concat-strings "study79-" (number->string (dlm-nth s 9)))) name)))
          (if (= (car next) 'rejected) s next)) s))))
(define *d79-prior-meta* s79-meta-step)
(set s79-meta-step (lambda (s id)
  (if (= (dlm-nth (s79-unit s id) 2) 'definition)
      (if (= (dlm-nth (s79-unit s id) 4) 'done) s (d79-step s id))
    (*d79-prior-meta* s id))))

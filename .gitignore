__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
reports/
output.json

# Publish only the promoted runtime, including its manifest-referenced LLVM files.
/runtime/releases/*
!/runtime/releases/20261113T120607Z-976/

# Rebuildable diagnostics and machine-local rollback state.
/runtime/safety2/
/runtime/previous

# Research datasets / checkpoints / generated weights are not release artifacts.
experiments/**/data/*.npz
experiments/**/data/*.json
experiments/**/*.pt
experiments/**/checkpoint.*
experiments/**/__pycache__/
experiments/**/cache/
experiments/**/debug*.l
experiments/**/all.l
experiments/**/probe*.l
experiments/**/re/
experiments/**/iterations/

# Large generated experiment outputs; keep only the final summary files.
experiments/**/*.out
experiments/**/*.log

# structure_discovery generated artifacts
experiments/structure_discovery/sd_*.json
experiments/structure_discovery/qualify.json
experiments/structure_discovery/direction_summary.json

# integral_learning generated artifacts
experiments/integral_learning/integrability.json
experiments/integral_learning/integral_*.json
